<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="synth.dx7~">
        <title>synth.dx7~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">FAUST dx7 implementation</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>dx7 synth fm</keywords>
            <since>0.6</since>
        </meta>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1" access="readwrite">@active</property>
            <!-- @algorithm -->
            <property name="@algorithm" type="int" minvalue="0" maxvalue="31" default="0"
            access="readwrite">FM algorithm number (0-based)</property>
            <!-- @feedback -->
            <property name="@feedback" type="float" minvalue="0.0" maxvalue="99.0" default="0.0"
            access="readwrite">@feedback</property>
            <!-- @freq -->
            <property name="@freq" type="float" default="130.8127899169922" units="hertz"
            access="readwrite">synth frequency</property>
            <!-- @gain -->
            <property name="@gain" type="float" minvalue="0.0" maxvalue="1.0"
            default="0.800000011920929" access="readwrite">output gain</property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0.0" maxvalue="1.0" default="0.0"
            access="readwrite">note on/off signal</property>
            <!-- @op0:L1 -->
            <property name="@op0:L1" type="float" minvalue="0.0" maxvalue="99.0" default="0.0"
            access="readwrite">op0: Envelope Generator Level 1</property>
            <!-- @op0:L2 -->
            <property name="@op0:L2" type="float" minvalue="0.0" maxvalue="99.0" default="90.0"
            access="readwrite">op0: Envelope Generator Level 2</property>
            <!-- @op0:L3 -->
            <property name="@op0:L3" type="float" minvalue="0.0" maxvalue="99.0" default="90.0"
            access="readwrite">op0: Envelope Generator Level 3</property>
            <!-- @op0:L4 -->
