            <!-- @active -->
            <property name="@active" type="bool" default="1" access="readwrite">@active</property>
            <!-- @algorithm -->
            <property name="@algorithm" type="int" minvalue="0" maxvalue="15" default="0"
            access="readwrite">@algorithm</property>
            <!-- @feedback -->
            <property name="@feedback" type="float" minvalue="0.0" maxvalue="99.0" default="0.0"
            access="readwrite">@feedback</property>
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="0" maxvalue="480" default="130.8128"
            units="hertz">maximum speed of whistles</property>
            <!-- @gain -->
            <property name="@gain" type="float" minvalue="0.0" maxvalue="1.0"
            default="0.800000011920929" access="readwrite">@gain</property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">synth gate
            (&gt;0 - play)</property>
