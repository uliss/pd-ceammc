            <property name="@op4:vel" type="float" minvalue="0.0" maxvalue="8.0" default="1.0"
            access="readwrite">
                <tr lang="en">op4: keyboard velocity sensivity</tr>
                <tr lang="ru" finished="false">op4: чувствительность к скорости клавиатуры</tr>
            </property>
            <!-- @op5:L1 -->
            <property name="@op5:L1" type="float" minvalue="0.0" maxvalue="99.0" default="0.0"
            access="readwrite">
                <tr lang="en">op5: Envelope Generator Level 1</tr>
                <tr lang="ru" finished="false">op5: Генератор контуров Уровень 1</tr>
            </property>
            <!-- @op5:L2 -->
            <property name="@op5:L2" type="float" minvalue="0.0" maxvalue="99.0" default="90.0"
            access="readwrite">
                <tr lang="en">op5: Envelope Generator Level 2</tr>
                <tr lang="ru" finished="false">op5: Envelope Generator Level 2</tr>
            </property>
            <!-- @op5:L3 -->
            <property name="@op5:L3" type="float" minvalue="0.0" maxvalue="99.0" default="90.0"
            access="readwrite">
                <tr lang="en">op5: Envelope Generator Level 3</tr>
                <tr lang="ru" finished="false">op5: Envelope Generator Level 3</tr>
            </property>
            <!-- @op5:L4 -->
            <property name="@op5:L4" type="float" minvalue="0.0" maxvalue="99.0" default="0.0"
            access="readwrite">
                <tr lang="en">op5: Envelope Generator Level 4</tr>
                <tr lang="ru" finished="false">op5: Envelope Generator Level 4</tr>
            </property>
            <!-- @op5:R1 -->
            <property name="@op5:R1" type="float" minvalue="0.0" maxvalue="99.0" default="90.0"
            access="readwrite">
                <tr lang="en">op5: Envelope Generator Rate 1</tr>
                <tr lang="ru" finished="false">op5: Коэффициент мощности генератора</tr>
            </property>
            <!-- @op5:R2 -->
            <property name="@op5:R2" type="float" minvalue="0.0" maxvalue="99.0" default="90.0"
            access="readwrite">
                <tr lang="en">op5: Envelope Generator Rate 2</tr>
                <tr lang="ru" finished="false">op5: Envelope Generator Rate 2</tr>
            </property>
            <!-- @op5:R3 -->
            <property name="@op5:R3" type="float" minvalue="0.0" maxvalue="99.0" default="90.0"
            access="readwrite">
                <tr lang="en">op5: Envelope Generator Rate 3</tr>
                <tr lang="ru" finished="false">op5: Envelope Generator Rate 3</tr>
            </property>
            <!-- @op5:R4 -->
            <property name="@op5:R4" type="float" minvalue="0.0" maxvalue="99.0" default="90.0"
            access="readwrite">
                <tr lang="en">op5: Envelope Generator Rate 4</tr>
                <tr lang="ru" finished="false">op5: Envelope Generator Rate 4</tr>
            </property>
            <!-- @op5:detune -->
            <property name="@op5:detune" type="float" minvalue="-10.0" maxvalue="10.0"
            default="1.0" access="readwrite">
                <tr lang="en">op5: detune</tr>
                <tr lang="ru" finished="false">op5: разъем</tr>
            </property>
            <!-- @op5:freq -->
            <property name="@op5:freq" type="float" minvalue="0.0" maxvalue="32.0" default="1.0"
            units="hertz" access="readwrite">
                <tr lang="en">op5: frequency</tr>
                <tr lang="ru" finished="false">op5: частота</tr>
            </property>
            <!-- @op5:level -->
            <property name="@op5:level" type="float" minvalue="0.0" maxvalue="99.0" default="95.0"
            access="readwrite">
                <tr lang="en">op5: outut level</tr>
                <tr lang="ru" finished="false">op5: внешний уровень</tr>
            </property>
            <!-- @op5:opMode -->
            <property name="@op5:opMode" type="float" minvalue="0.0" maxvalue="1.0" default="0.0"
            access="readwrite">
                <tr lang="en">op5: FreqRatio or FreqFixed mode</tr>
                <tr lang="ru" finished="false">op5: FreqRatio или FreqFixed</tr>
            </property>
            <!-- @op5:rate -->
            <property name="@op5:rate" type="float" minvalue="0.0" maxvalue="10.0" default="0.0"
            access="readwrite">
                <tr lang="en">op5: rate</tr>
                <tr lang="ru" finished="false">op5: ставка</tr>
            </property>
            <!-- @op5:vel -->
            <property name="@op5:vel" type="float" minvalue="0.0" maxvalue="8.0" default="1.0"
            access="readwrite">
                <tr lang="en">op5: keyboard velocity sensivity</tr>
                <tr lang="ru" finished="false">op5: чувствительность к скорости клавиатуры</tr>
            </property>
            <!-- @pitch -->
            <property name="@pitch" type="float" minvalue="24" maxvalue="84" default="48">
                <tr lang="en">midi pitch</tr>
                <tr lang="ru" finished="false">миди-питч</tr>
            </property>
        </properties>
        <methods>
            <!-- load -->
            <method name="load">
                <info>
                    <tr lang="en">load the preset from a previously loaded sysex file</tr>
                    <tr lang="ru" finished="false">Загрузить предустановленное из ранее
                    загруженного файла sysex</tr>
                </info>
                <param name="IDX" type="int" minvalue="0" maxvalue="31">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
            <!-- note -->
            <method name="note">
                <info>
                    <tr lang="en">note on/off message</tr>
                    <tr lang="ru" finished="false">примечание/выключение сообщения</tr>
                </info>
                <param name="NOTE" type="float" required="true">
                    <tr lang="en">midi note</tr>
                    <tr lang="ru" finished="false">нота миди</tr>
                </param>
                <param name="VEL" type="float" minvalue="0" maxvalue="127" required="true">
                    <tr lang="en">velocity</tr>
                    <tr lang="ru" finished="false">скорость</tr>
                </param>
            </method>
            <!-- read -->
            <method name="read">
                <info>
                    <tr lang="en">reads the DX7 sysex preset file</tr>
                    <tr lang="ru" finished="false">DX7 sysex предустановленный файл</tr>
                </info>
                <param name="PATH" type="symbol">
                    <tr lang="en">relative or absolute path to the DX sysex preset file</tr>
                    <tr lang="ru" finished="false">относительный или абсолютный путь к заданному
                    файлу DX sysex</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">NOTE VEL</tr>
                    <tr lang="ru" finished="false">Примечание VEL</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">synth output</tr>
                    <tr lang="ru" finished="false">синтетический выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
|             [B]
|             |
[note $1 $2(  [openpanel] [ui.hrd]
|             |           |
|   [dump(    [read $1(   [load $1 #a(
|   |         |
|   |         |
[synth.dx7~   #x]
|
[ui.gain~ @size 120 16]  [ui.dsp~]
| \
[dac~]
[X a->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
