<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="rhythm.euclid">
        <title>rhythm.euclid</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">euclid pattern generator</tr>
                <tr lang="ru">генератор эвклидовых паттернов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>music</category>
            <keywords>conv rhythm euclid bresenham</keywords>
            <since>0.9.7</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: fast Bresenham algorithm is used</tr>
                <tr lang="ru" finished="false">Примечание: используется быстрый алгоритм
                Брезенхэма</tr>
            </par>
        </info>
        <arguments>
            <argument name="BEATS" type="int" minvalue="0" maxvalue="8192">
                <tr lang="en">number of beats inside the sequence</tr>
                <tr lang="ru" finished="false">Количество ударов внутри последовательности</tr>
            </argument>
            <argument name="N" type="int" minvalue="1" maxvalue="8192">
                <tr lang="en">the whole sequence length</tr>
                <tr lang="ru" finished="false">Вся длина последовательности</tr>
            </argument>
            <argument name="OFFSET" type="int">
                <tr lang="en">sequence offset</tr>
                <tr lang="ru" finished="false">последовательность смещения</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @beats -->
            <property name="@beats" type="int" default="3" minvalue="0" maxvalue="8192">
                <tr lang="en">number of beats inside the sequence</tr>
                <tr lang="ru" finished="false">Количество ударов внутри последовательности</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" default="8" minvalue="1" maxvalue="8192">
                <tr lang="en">the whole sequence length</tr>
                <tr lang="ru" finished="false">Вся длина последовательности</tr>
            </property>
            <!-- @offset -->
            <property name="@offset" type="int" default="0">
                <tr lang="en">sequence offset</tr>
                <tr lang="ru" finished="false">последовательность смещения</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">output generated sequence</tr>
                    <tr lang="ru" finished="false">генерируемая последовательность</tr>
                </in>
                <in on="int">
                    <tr lang="en">set number of beats in the sequence</tr>
                    <tr lang="ru" finished="false">установленное количество ударов в
                    последовательности</tr>
                </in>
                <in on="list">
                    <tr lang="en">list: BEATS LENGTH OFFSET?</tr>
                    <tr lang="ru" finished="false">Оригинальное название: Beats Length Offset?</tr>
                </in>
            </inlet>
            <inlet>
                <in on="int">
                    <tr lang="en">set sequence lenghth</tr>
                    <tr lang="ru" finished="false">установленная последовательность</tr>
                </in>
            </inlet>
            <inlet>
                <in on="int">
                    <tr lang="en">set sequence offset</tr>
                    <tr lang="ru" finished="false">Смещение последовательности</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">converted value</tr>
                    <tr lang="ru" finished="false">преобразованная стоимость</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B] [3 5 1(  [L]
|   |        |
|   [msg.after bang]
|   |
[rhythm.euclid 3 7]
|
[t l l]
|   ^|
|   [list.size]
|   |
|   [@nitems $1, @size 150 15(
|   |
[ui.hrd* @nosave 1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
