<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="flt.c_bpf~">
        <title>flt.c_bpf~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">BPF coefficients calculator for [flt.biquad~]</tr>
                <tr lang="ru">калькулятор коэффициентов полосового фильтра для [flt.biquad~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter biquad bpf</keywords>
            <since>0.1</since>
            <also>
                <see>flt.biquad~</see>
                <see>flt.bpf12~</see>
                <see>flt.c_notch~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Calculates coefficients for transfer function: H(z)=(b0 + b1*z⁻¹ +
                b2*z⁻²)/(1 + a1*z⁻¹ + a2*z⁻²)</tr>
            </par>
        </info>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="20" maxvalue="20000">
                <tr lang="en">center frequency</tr>
            </argument>
            <argument name="Q" type="float" minvalue="0.01" maxvalue="100">
                <tr lang="en">quality factory</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="20" maxvalue="20000" default="1000"
            units="hertz">
                <tr lang="en">center frequency</tr>
            </property>
            <!-- @q -->
            <property name="@q" type="float" minvalue="0.01" maxvalue="100" default="0.1">
                <tr lang="en">quality factor: @freq/BANDWIDTH</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>control signal</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">b0</outlet>
            <outlet type="audio">b1</outlet>
            <outlet type="audio">b2</outlet>
            <outlet type="audio">a1</outlet>
            <outlet type="audio">a2</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[noise.pink~] [T] [F]        [F]
|        .____/   |          |
[*~      ]        [@freq $1( [@q $1(
|                 |          |
|                 [flt.c_bpf~ 1000 100]
|                 | ^| ^^| ^^^| ^^^^|
|                 |  |   |    |     |
|                 |  |   |    |     |
|                 |. |.. |... |.... |.....
[flt.biquad~                              ]
|
[ui.gain~ @size 120 16]
|\
[dac~]

[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
