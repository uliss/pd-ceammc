<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env.tshift">
    <title>env.tshift</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">envelope time-shift (horizontal)</tr>
        <tr lang="ru">сдвиг огибающей по времени (по горизонтали)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>time shift</keywords>
      <since>0.5</since>
      <also>
        <see>env.tscale</see>
        <see>envelope</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Shifts an envelope horizontally in time: adds the given time-shift value (in
        milliseconds) to all time values of the envelope. A positive shift delays the envelope,
        a negative shift moves it earlier. The shape of the envelope is not affected — only its
        position in time.</tr>
        <tr lang="ru">Сдвигает огибающую по горизонтали во времени: прибавляет заданное значение
        сдвига (в миллисекундах) ко всем временным значениям огибающей. Положительный сдвиг
        задерживает огибающую, отрицательный — сдвигает её раньше. Форма огибающей не
        изменяется — меняется только её положение во времени.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Aligning an envelope to a specific moment — moving an envelope forward or
        backward in time so that its key points (for example, its peak) coincide with the desired
        moment in a sequence or a recorded performance.</tr>
        <tr lang="ru">• Выравнивание огибающей по нужному моменту — сдвиг огибающей вперёд или
        назад во времени так, чтобы её ключевые точки (например, пик) совпали с нужным моментом
        в секвенции или записанном исполнении.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Layering delayed envelopes — creating rhythmic or spatial effects by
        combining the same envelope with a shifted copy of itself, for example a short delay
        between two notes or between two amplitude shapes.</tr>
        <tr lang="ru">• Наложение сдвинутых огибающих — создание ритмических или пространственных
        эффектов путём комбинирования одной и той же огибающей с её сдвинутой копией, например
        короткой задержки между двумя нотами или двумя амплитудными формами.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Real-time timing control — changing the offset of an envelope in real time
        by linking the shift to a knob, an LFO, or a performance parameter such as key velocity or
        mod wheel, to obtain groovy or expressive timing variations.</tr>
        <tr lang="ru">• Управление таймингом в реальном времени — изменение смещения огибающей
        на лету путём привязки сдвига к крутилке, LFO или параметру исполнения, например к
        скорости нажатия клавиши или колесу модуляции, для получения грувовых или выразительных
        вариаций тайминга.</tr>
      </par>
    </info>
    <arguments>
      <argument name="SHIFT" type="float" units="millisecond">
        <tr lang="en">time-shift</tr>
        <tr lang="ru">сдвиг по времени</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @shift -->
      <property name="@shift" type="float" units="millisecond" default="0">
        <tr lang="en">time-shift</tr>
        <tr lang="ru">сдвиг по времени</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="data">
          <tr lang="en">input envelope</tr>
          <tr lang="ru">входная огибающая</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="data">
          <tr lang="en">shifted output envelope</tr>
          <tr lang="ru">сдвинутая огибающая</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ar 100 200, bang(
|
[envelope] [@shift 0( [@shift 50(
|          |          |
|          |          |
|          |          |
[env.tshift         10]
|
[env->array tshift_array @resize]


[array tshift_array size=100 w=300 h=100 yr=0..1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
