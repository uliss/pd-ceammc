<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="env.tshift">
        <title>env.tshift</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">envelope time-shift (horizontal)</tr>
                <tr lang="ru">сдвиг огибающей по времени (по горизонтали)</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>env</category>
            <keywords>time shift</keywords>
            <since>0.5</since>
            <also>
                <see>env.tscale</see>
                <see>envelope</see>
            </also>
        </meta>
        <arguments>
            <argument name="SHIFT" type="float" units="millisecond">
                <tr lang="en">time-shift</tr>
                <tr lang="ru" finished="false">смена времени</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @shift -->
            <property name="@shift" type="float" units="millisecond" default="0">
                <tr lang="en">time-shift</tr>
                <tr lang="ru" finished="false">смена времени</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="data">
                    <tr lang="en">input envelope</tr>
                    <tr lang="ru" finished="false">входной конверт</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">shifted output envelope</tr>
                    <tr lang="ru" finished="false">сдвинутый выпускной конверт</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ar 100 200, bang(
|
[envelope] [@shift 0( [@shift 50(
|          |          |
|          |          |
|          |          |
[env.tshift         10]
|
[env->array tshift_array @resize]


[array tshift_array size=100 w=300 h=100 yr=0..1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
