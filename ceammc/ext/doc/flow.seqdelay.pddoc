<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.seqdelay">
    <title>flow.seqdelay</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">sequential delay/router for the input stream</tr>
        <tr lang="ru">последовательный маршрутизатор с задержками для входного потока</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow seq delay</keywords>
      <since>0.9.5</since>
      <aliases>
        <alias>flow.seqdel</alias>
      </aliases>
      <also>
        <see>flow.delay</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Delay any route incoming message by specified relative time list. If @block=0
        if new message has arrived while delay time is not expired, old message is discarded and
        new delay time is set from current moment.</tr>
        <!-- old: Задержка любого входящего сообщения маршрута по
                указанному относительному списку времени. Если @block = 0, если новое сообщение
                пришло, а время задержки не истекло, старое сообщение отбрасывается и новое время
                задержки устанавливается с текущего момента. -->
        <tr lang="ru" finished="false">Задержка любого входящего сообщения маршрута по указанному
        относительному списку времени. Если @block = 0, если новое сообщение пришло, а время
        задержки не истекло, старое сообщение отбрасывается и новое время задержки устанавливается
        с текущего момента.</tr>
      </par>
      <par>
        <tr lang="en">Zero delay time means output message on next Pd runloop iteration (as soon as
        possible)</tr>
        <!-- old: Нулевое время задержки означает выходное сообщение
                на следующей итерации рулона Pd (как можно скорее). -->
        <tr lang="ru" finished="false">Нулевое время задержки означает выходное сообщение на
        следующей итерации рулона Pd (как можно скорее).</tr>
      </par>
      <par>
        <tr lang="en">Note: @t and @block property can be set only via right inlet or with
        [prop.set] object</tr>
        <!-- old: Примечание: свойство @t и @block может быть
                установлено только через правый вход или с объектом [prop.set] -->
        <tr lang="ru" finished="false">Примечание: свойство @t и @block может быть установлено
        только через правый вход или с объектом [prop.set]</tr>
      </par>
    </info>
    <arguments>
      <argument name="T" type="list" units="millisecond">
        <tr lang="en">List of delay times. See @t property.</tr>
        <tr lang="ru" finished="false">Список времен задержки. См. @t Property.</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @block -->
      <property name="@block" type="bool" default="0">
        <tr lang="en">blocking mode. If true, discards incoming messages until scheduled message
        will output, after that is ready to accept the new one.</tr>
        <!-- old: Режим блокировки. Если это правда, отбрасывает
                входящие сообщения до выхода запланированного сообщения, после чего готов принять
                новое. -->
        <tr lang="ru" finished="false">Режим блокировки. Если это правда, отбрасывает входящие
        сообщения до выхода запланированного сообщения, после чего готов принять новое.</tr>
      </property>
      <!-- @t -->
      <property name="@t" type="list" minvalue="0" units="millisecond" default="">
        <tr lang="en">delay time list</tr>
        <tr lang="ru" finished="false">Перечень сроков задержки</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset all scheduled delays</tr>
          <tr lang="ru" finished="false">Сбросить все запланированные задержки</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">incoming message</tr>
          <tr lang="ru" finished="false">Входящее сообщение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="list">
          <tr lang="en">set delay times</tr>
          <tr lang="ru" finished="false">Установить время задержки</tr>
        </in>
        <in on="any">
          <tr lang="en">'reset' - reset all scheduled delays, '@t' - set @t property, '@block' -
          set @block property, 'dump' - dump object info to Pd window.</tr>
          <!-- old: "reset" - сброс всех запланированных задержек,
                    "@t" - set @t property, "@block" - set @block property, "dump" - dump object
                    info to Pd window. -->
          <tr lang="ru" finished="false">"reset" - сброс всех запланированных задержек, "@t" - set
          @t property, "@block" - set @block property, "dump" - dump object info to Pd window.</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="any">
          <tr lang="en">first delayed output</tr>
          <tr lang="ru" finished="false">Первый отсроченный выпуск</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="any">
          <tr lang="en">...-th delayed output</tr>
          <tr lang="ru" finished="false">... отсроченного выпуска</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="any">
          <tr lang="en">n-th delayed output</tr>
          <tr lang="ru" finished="false">n-е замедленное производство</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang( [note 60 120(
|      |
[flow.seqdelay 0 1000 500 1000 #i]
|
[ui.dt]       [ui.dt #k]

       [ui.dt #j]    [ui.dt #l]

[X i:1->j] [X i:2->k] [X i:3->l]

[bang(              [list 0 500 120 110( /*- change pattern*/
|                   |
|       [T]         |  [list 0 400 100 300(
|       |           |  |
|       [@block $1( |  |
|       |.          |. |.
[flow.seqdel 0 0 0 0 {i=2,o=4}]
|   ^|   ^^| ^^^|
|    |     |    [synth.church_bell~ #d]
|    |     |
|    |     [synth.german_bell~ #c]
|    |
|    [synth.english_bell~ #b]
|
[synth.russian_bell~ #a] [ui.dsp~]
|
[pan.spread~ 4 {w=21} #x]
*|*
[ui.hgain2~ @size 15 151]
*|*
[dac~ 1 2 {w=21}]
[X b->x:1] [X c->x:2] [X d->x:3]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
