<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.seqdelay">
    <title>flow.seqdelay</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">sequential delay/router for the input stream</tr>
        <tr lang="ru">последовательный маршрутизатор с задержками для входного потока</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow seq delay</keywords>
      <since>0.9.5</since>
      <aliases>
        <alias>flow.seqdel</alias>
      </aliases>
      <also>
        <see>flow.delay</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object delays each incoming message by a corresponding delay time from the @t list and outputs it from the corresponding outlet</tr>
        <tr lang="ru">объект задерживает каждое входящее сообщение на соответствующее время из списка @t и выводит его с соответствующего выхода</tr>
      </par>
      <par>
        <tr lang="en">if @block is 0 and a new message arrives before the delay time of the previous one has expired, the old message is discarded and the new delay time starts from the current moment</tr>
        <tr lang="ru">если @block равен 0 и новое сообщение приходит до истечения времени задержки предыдущего, старое сообщение отбрасывается, а новое время задержки отсчитывается с текущего момента</tr>
      </par>
      <par>
        <tr lang="en">a zero delay time means the message is output on the next Pd runloop iteration (as soon as possible)</tr>
        <tr lang="ru">нулевое время задержки означает, что сообщение выводится на следующей итерации runloop Pd (как можно скорее)</tr>
      </par>
      <par>
        <tr lang="en">note: @t and @block can be set only via the right inlet or with the [prop.set] object</tr>
        <tr lang="ru">примечание: @t и @block можно задать только через правый вход или объектом [prop.set]</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to create rhythmic delays and canonical patterns, for example to trigger a series of events with different delays</tr>
        <tr lang="ru">объект можно использовать для создания ритмических задержек и канонических паттернов, например чтобы запускать серию событий с разными задержками</tr>
      </par>
    </info>
    <arguments>
      <argument name="T" type="list" units="millisecond">
        <tr lang="en">list of delay times. See the @t property</tr>
        <tr lang="ru">список времён задержки. См. свойство @t</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @block -->
      <property name="@block" type="bool" default="0">
        <tr lang="en">blocking mode. If true, discards incoming messages until the scheduled message is output, after which it is ready to accept a new one</tr>
        <tr lang="ru">режим блокировки. Если true, отбрасывает входящие сообщения до вывода запланированного сообщения, после чего готов принять новое</tr>
      </property>
      <!-- @t -->
      <property name="@t" type="list" minvalue="0" units="millisecond" default="">
        <tr lang="en">delay time list</tr>
        <tr lang="ru">список времён задержки</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset all scheduled delays</tr>
          <tr lang="ru">сбросить все запланированные задержки</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">incoming message</tr>
          <tr lang="ru">входящее сообщение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="list">
          <tr lang="en">set delay times</tr>
          <tr lang="ru">задать времена задержки</tr>
        </in>
        <in on="any">
          <tr lang="en">'reset' — reset all scheduled delays, '@t' — set the @t property, '@block' — set the @block property, 'dump' — dump object info to the Pd window</tr>
          <tr lang="ru">'reset' — сбросить все запланированные задержки, '@t' — задать свойство @t, '@block' — задать свойство @block, 'dump' — вывести информацию об объекте в окно Pd</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="any">
          <tr lang="en">first delayed output</tr>
          <tr lang="ru">первый задержанный выход</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="any">
          <tr lang="en">... delayed output</tr>
          <tr lang="ru">... задержанный выход</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="any">
          <tr lang="en">n-th delayed output</tr>
          <tr lang="ru">N-й задержанный выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang( [note 60 120(
|      |
[flow.seqdelay 0 1000 500 1000 #i]
|
[ui.dt]       [ui.dt #k]

       [ui.dt #j]    [ui.dt #l]

[X i:1->j] [X i:2->k] [X i:3->l]

[bang(              [list 0 500 120 110( /*- change pattern*/
|                   |
|       [T]         |  [list 0 400 100 300(
|       |           |  |
|       [@block $1( |  |
|       |.          |. |.
[flow.seqdel 0 0 0 0 {i=2,o=4}]
|   ^|   ^^| ^^^|
|    |     |    [synth.church_bell~ #d]
|    |     |
|    |     [synth.german_bell~ #c]
|    |
|    [synth.english_bell~ #b]
|
[synth.russian_bell~ #a] [ui.dsp~]
|
[pan.spread~ 4 {w=21} #x]
*|*
[ui.hgain2~ @size 15 151]
*|*
[dac~ 1 2 {w=21}]
[X b->x:1] [X c->x:2] [X d->x:3]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
