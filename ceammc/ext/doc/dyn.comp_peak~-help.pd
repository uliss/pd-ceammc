#X msg 110 755 @id;
#X text 245 755 (initonly) Get/Set OSC address id. If specified \,
bind all properties to /ID/dyn_comp_peak/PROP_NAME osc address \, if
empty bind to /dyn_comp_peak/PROP_NAME. Type: symbol.;
#X msg 110 812 @osc;
#X text 245 812 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 110 842 @active;
#X text 245 842 Turn on/off dsp processing. Type: bool. Default value:
1\.;
#X msg 110 872 @attack;
#X text 245 872 Get/Set time constant when level & compression going
up. Type: float. Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 110 929 @bypass;
#X text 245 929 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 110 971 @gain;
#X text 245 971 Get/Set make up gain: applied to the signal after the
compression takes place. Type: float. Units: 'db'. Default value: 0\.
Range: -18\...18\.;
#X msg 110 1028 @knee;
#X text 245 1028 Get/Set a gradual increase in gain reduction around
the threshold: below thresh-(knee/2) there is no gain reduction \,
above thresh+(knee/2) there is the same gain reduction as without a
knee \, and in between there is a gradual increase in gain reduction.
Type: float. Units: 'db'. Default value: 3\. Range: 0\...24\.;
#X msg 110 1131 @refresh;
#X text 245 1131 Get/Set compression level output time interval. If
0 - no output. Type: int. Units: 'ms'. Default value: 100\. Range:
0\...1000\.;
#X msg 110 1188 @release;
#X text 245 1188 Get/Set release time = time constant coming out of
compression. Type: float. Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 110 1245 @strength;
#X text 245 1245 Get/Set compression ratio (0: no compression \, 1:
hard limiting \, >1: overcompression). Type: float. Default value:
0\. Range: 0\...2\.;
#X msg 110 1302 @threshold;
#X text 245 1302 Get/Set level threshold above which compression kicks
in (100 dB = max level). Type: float. Units: 'db'. Default value: -10\.
Range: -60\...0\.;
#X msg 110 1359 @level?;
#X text 245 1359 (readonly) Get current level of compression. Type:
float. Default value: 0\. Range: 0\...1\.;
