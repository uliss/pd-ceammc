#X msg 110 800 @id;
#X text 245 800 (initonly) Get/Set OSC address id. If specified \,
bind all properties to /ID/dyn_comp_peak/PROP_NAME osc address \, if
empty bind to /dyn_comp_peak/PROP_NAME. Type: symbol.;
#X msg 110 857 @osc;
#X text 245 857 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 110 887 @active;
#X text 245 887 Turn on/off dsp processing. Type: bool. Default value:
1\.;
#X msg 110 917 @attack;
#X text 245 917 Get/Set time constant when level & compression going
up. Type: float. Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 110 974 @bypass;
#X text 245 974 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 110 1016 @gain;
#X text 245 1016 Get/Set make up gain: applied to the signal after
the compression takes place. Type: float. Units: 'db'. Default value:
0\. Range: -18\...18\.;
#X msg 110 1073 @knee;
#X text 245 1073 Get/Set a gradual increase in gain reduction around
the threshold: below thresh-(knee/2) there is no gain reduction \,
above thresh+(knee/2) there is the same gain reduction as without a
knee \, and in between there is a gradual increase in gain reduction.
Type: float. Units: 'db'. Default value: 3\. Range: 0\...24\.;
#X msg 110 1176 @refresh;
#X text 245 1176 Get/Set compression level output time interval. If
0 - no output. Type: int. Units: 'ms'. Default value: 100\. Range:
0\...1000\.;
#X msg 110 1233 @release;
#X text 245 1233 Get/Set release time = time constant coming out of
compression. Type: float. Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 110 1290 @strength;
#X text 245 1290 Get/Set compression ratio (0: no compression \, 1:
hard limiting \, >1: overcompression). Type: float. Default value:
0\. Range: 0\...2\.;
#X msg 110 1347 @threshold;
#X text 245 1347 Get/Set level threshold above which compression kicks
in (100 dB = max level). Type: float. Units: 'db'. Default value: -10\.
Range: -60\...0\.;
#X msg 110 1404 @level?;
#X text 245 1404 (readonly) Get current level of compression. Type:
float. Default value: 0\. Range: 0\...1\.;
