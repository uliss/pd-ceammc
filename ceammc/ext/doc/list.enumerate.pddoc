<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.10">
    <object name="list.enumerate">
        <title>list.enumerate</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">enumerates list elements</tr>
                <tr lang="ru">нумерует элементы списка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list enumerate</keywords>
            <since>0.3</since>
        </meta>
        <arguments>
            <argument name="FROM" type="int">
                <tr lang="en">enumeration start index</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @append -->
            <property name="@append" type="flag" default="0" access="initonly">put element index
            after element value</property>
            <!-- @from -->
            <property name="@from" type="int" default="0">enumeration start index</property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">input list</xinfo>
                <xinfo on="data:mlist">input mlist</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output list</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[list A B C D E(
|
|    [T]          [\(a b c d \(e\)\), bang(
|    |            |
|    [@from $1(   [mlist]
|    |            |
[list.enumerate   ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
