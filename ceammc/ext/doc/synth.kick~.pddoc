<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="synth.kick~">
        <title>synth.kick~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">low-kick synth from Guitarix project</tr>
                <tr lang="ru">синтезатор бочки из проекта Guitarix</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>synth kick</keywords>
            <since>0.9.4</since>
        </meta>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @attack -->
            <property name="@attack" type="float" minvalue="1" maxvalue="50" default="10"
            units="millisecond">
                <tr lang="en">attack time</tr>
            </property>
            <!-- @envwait -->
            <property name="@envwait" type="bool" default="0">
                <tr lang="en">ignore new notes until previous note is not finished release
                time</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" default="50" minvalue="10" maxvalue="5000"
            units="hertz">
                <tr lang="en">start frequency</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">play trigger &gt;0: on, 0: off. To set output gain to 0.5 you can 0.5
                as trigger value</tr>
            </property>
            <!-- @release -->
            <property name="@release" type="float" minvalue="10" maxvalue="8000" default="1000"
            units="millisecond">
                <tr lang="en">release time</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset synth</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">play with default duration and full gain</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">play with default duration and specified gain</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">GAIN(0..1) DUR(ms) pair expected</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">synth output</tr>
                </out>
            </outlet>
            <outlet type="control">
                <out type="any">
                    <tr lang="en">bang after release finished</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]                 [ui.k #a]  [ui.k #b]
|                   |          |
[metro 100]         |          |
|                   |          |
[random.f 0.3 0.95] [@freq $1( [@attack $1(
|                   |          |
[synth.kick~                   ]
|
[ui.hgain~]     [ui.dsp~]
| \
[dac~]

#a 20 2000 @show_value 1
#b 1 50 @show_value 1
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
