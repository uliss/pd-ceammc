<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="data.int">
        <title>data.int</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">a multi-functional integer object</tr>
                <tr lang="ru">многофункциональный объект целого числа</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data int</keywords>
            <since>0.6</since>
            <also>
                <see>data.float</see>
            </also>
            <aliases>
                <alias>.int</alias>
                <alias>.i</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="VALUE" type="int">
                <tr lang="en">set initial value</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @value -->
            <property name="@value" type="int" access="readonly" default="0">
                <tr lang="en">current value</tr>
            </property>
        </properties>
        <methods>
            <!-- * -->
            <method name="*">
                <info>
                    <tr lang="en">multiply to, no output</tr>
                </info>
            </method>
            <!-- + -->
            <method name="+">
                <info>
                    <tr lang="en">add to int, no output</tr>
                </info>
            </method>
            <method name="-">
                <info>
                    <tr lang="en">subtract from int, no output</tr>
                </info>
            </method>
            <!-- / -->
            <method name="/">
                <info>
                    <tr lang="en">divide by, no output</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">sets new value without output</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">output value</xinfo>
                <xinfo on="float">set new value and outputs</xinfo>
            </inlet>
            <inlet>
                <xinfo>set new value without output</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>set output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
| [+ 1, bang(   [- 10, bang(
| |             |
| | [* 2, bang( | [/ 3(
| | |           | |
| | | [bang(    | |  [F]
| | | |         | |  |.
[.int              100]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
