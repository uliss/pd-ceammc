<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="data.int">
    <title>data.int</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">a multi-functional integer object</tr>
        <tr lang="ru">многофункциональный объект для работы с целыми числами</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data int</keywords>
      <since>0.6</since>
      <also>
        <see>data.float</see>
      </also>
      <aliases>
        <alias>.int</alias>
        <alias>.i</alias>
      </aliases>
    </meta>
    <arguments>
      <argument name="VALUE" type="int">
        <tr lang="en">set the initial value</tr>
        <tr lang="ru">задать начальное значение</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @value -->
      <property name="@value" type="int" access="readonly" default="0">
        <tr lang="en">current value</tr>
        <tr lang="ru">текущее значение</tr>
      </property>
    </properties>
    <methods>
      <!-- * -->
      <method name="*">
        <info>
          <tr lang="en">multiply the stored value by the given number, no output</tr>
          <tr lang="ru">умножить хранимое значение на заданное число, без вывода</tr>
        </info>
        <param type="int" name="X">
          <tr lang="en">multiplier</tr>
          <tr lang="ru">множитель</tr>
        </param>
      </method>
      <!-- + -->
      <method name="+">
        <info>
          <tr lang="en">add the given number to the stored value, no output</tr>
          <tr lang="ru">прибавить заданное число к хранимому значению, без вывода</tr>
        </info>
        <param type="int" name="X">
          <tr lang="en">addend</tr>
          <tr lang="ru">слагаемое</tr>
        </param>
      </method>
      <!-- - -->
      <method name="-">
        <info>
          <tr lang="en">subtract the given number from the stored value, no output</tr>
          <tr lang="ru">вычесть заданное число из хранимого значения, без вывода</tr>
        </info>
        <param type="int" name="X">
          <tr lang="en">subtrahend</tr>
          <tr lang="ru">вычитаемое</tr>
        </param>
      </method>
      <!-- / -->
      <method name="/">
        <info>
          <tr lang="en">divide the stored value by the given number, no output</tr>
          <tr lang="ru">разделить хранимое значение на заданное число, без вывода</tr>
        </info>
        <param type="int" name="X">
          <tr lang="en">divisor</tr>
          <tr lang="ru">делитель</tr>
        </param>
      </method>
      <!-- set -->
      <method name="set">
        <info>
          <tr lang="en">set a new value without output</tr>
          <tr lang="ru">установить новое значение без вывода</tr>
        </info>
        <param type="int" name="X">
          <tr lang="en">new value</tr>
          <tr lang="ru">новое значение</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output the stored value</tr>
          <tr lang="ru">вывести хранимое значение</tr>
        </in>
        <in on="float">
          <tr lang="en">set a new value and output it</tr>
          <tr lang="ru">установить новое значение и вывести его</tr>
        </in>
      </inlet>
      <inlet>
        <in>
          <tr lang="en">set a new value without output</tr>
          <tr lang="ru">установить новое значение без вывода</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">value output</tr>
          <tr lang="ru">вывод значения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]
|
| [+ 1, bang(   [- 10, bang(
| |             |
| | [* 2, bang( | [/ 3(
| | |           | |
| | | [bang(    | |  [F]
| | | |         | |  |.
[.int              100]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
