<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="msg.onclose">
    <title>msg.onclose</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">send a message when closing a patch</tr>
        <tr lang="ru">отправить сообщение при закрытии патча</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>msg</category>
      <keywords>message close</keywords>
      <since>0.9.7</since>
      <also>
        <!--                <see>msg.oninit</see>-->
        <see>msg.onload</see>
      </also>
    </meta>
    <arguments>
      <argument name="ARGS" type="list">
        <tr lang="en">message. Comma separated messages are supported</tr>
        <!-- old: Сообщение. Поддерживаются сообщения, разделенные
                Comma -->
        <tr lang="ru" finished="false">Сообщение. Поддерживаются сообщения, разделенные Comma</tr>
      </argument>
    </arguments>
    <inlets />
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">message output</tr>
          <tr lang="ru" finished="false">сообщение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[msg.onclose MESSAGE]
|
[print onclose]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
