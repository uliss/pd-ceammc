<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="net.freesound">
    <title>net.freesound</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Freesound API v2 client</tr>
        <tr lang="ru">клиент Freesound API v2</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>net</category>
      <keywords>net freesound</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">1) create Freesound API credentials at:</tr>
        <tr lang="ru">1) создайте учётные данные Freesound API по адресу:</tr>
      </par>
      <a href="https://freesound.org/apiv2/apply">https://freesound.org/apiv2/apply</a>
      <par>
        <tr lang="en">2) save the id/secret pair to a file when using @oauth_file, or set
        @oauth_id/@oauth_secret explicitly, or enter them in the editor</tr>
        <tr lang="ru">2) сохраните пару id/secret в файл при использовании @oauth_file, либо
        задайте @oauth_id/@oauth_secret явно, либо введите их в редакторе</tr>
      </par>
      <par>
        <tr lang="en">3) [access auth( — get a temporary application code from the Freesound
        website (valid for ~24 hours)</tr>
        <tr lang="ru">3) [access auth( — получить временный код приложения с сайта Freesound
        (действителен ~24 часа)</tr>
      </par>
      <par>
        <tr lang="en">4) [access code CODE( — exchange the application code for the internal secret
        access token</tr>
        <tr lang="ru">4) [access code CODE( — обменять код приложения на внутренний секретный токен
        доступа</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">open id/secret editor</event>
    </mouse>
    <properties>
      <!-- @oauth_file -->
      <property name="@oauth_file" type="symbol" default="" access="initonly">
        <tr lang="en">path to file with OAuth2 ID/secret, one per line</tr>
        <tr lang="ru">путь к файлу с OAuth2 ID/secret, по одному на строку</tr>
      </property>
      <!-- @oauth_id -->
      <property name="@oauth_id" type="symbol" default="" access="initonly">
        <tr lang="en">Freesound OAuth2 ID</tr>
        <tr lang="ru">Freesound OAuth2 ID</tr>
      </property>
      <!-- @oauth_secret -->
      <property name="@oauth_secret" type="symbol" default="" access="initonly">
        <tr lang="en">Freesound OAuth2 secret</tr>
        <tr lang="ru">Freesound OAuth2 secret</tr>
      </property>
    </properties>
    <methods>
      <!-- access auth -->
      <method name="access auth">
        <info>
          <tr lang="en">get an application authorization code (valid ~24 hours) from the Freesound
          page, which should open in a web browser</tr>
          <tr lang="ru">получить код авторизации приложения (действителен ~24 часа) со страницы
          Freesound, которая должна открыться в веб-браузере</tr>
        </info>
      </method>
      <!-- access code -->
      <method name="access code">
        <info>
          <tr lang="en">exchange the application authorization code for a temp *access* token used
          for every request. Note: this can be done only once, otherwise you need to get another
          application authorization code from the Freesound site.</tr>
          <tr lang="ru">обменять код авторизации приложения на временный токен *access*,
          используемый для каждого запроса. Примечание: это можно сделать только один раз, иначе
          потребуется получить новый код авторизации приложения с сайта Freesound.</tr>
        </info>
        <param name="CODE" type="symbol" required="true">
          <tr lang="en">application auth code. Copy it from the Freesound webpage</tr>
          <tr lang="ru">код авторизации приложения. Скопируйте его с веб-страницы Freesound</tr>
        </param>
      </method>
      <!-- access load -->
      <method name="access load">
        <info>
          <tr lang="en">load the temp *access* token (not OAuth id/secret) from a special file in
          the current patch directory</tr>
          <tr lang="ru">загрузить временный токен *access* (не OAuth id/secret) из специального
          файла в текущем каталоге патча</tr>
        </info>
      </method>
      <!-- access store -->
      <method name="access store">
        <info>
          <tr lang="en">store the temp *access* token (not OAuth id/secret) into a special file in
          the current patch directory</tr>
          <tr lang="ru">сохранить временный токен *access* (не OAuth id/secret) в специальный файл
          в текущем каталоге патча</tr>
        </info>
      </method>
      <!-- download -->
      <method name="download">
        <info>
          <tr lang="en">download a Freesound file</tr>
          <tr lang="ru">скачать файл с Freesound</tr>
        </info>
        <param name="ID" type="int" required="true">
          <tr lang="en">Freesound soundfile ID (get it from a search result, for example)</tr>
          <tr lang="ru">ID звукового файла Freesound (например, из результатов поиска)</tr>
        </param>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">load a Freesound file into Pd arrays</tr>
          <tr lang="ru">загрузить файл с Freesound в массивы Pd</tr>
        </info>
        <param name="ID" type="int" required="true">
          <tr lang="en">Freesound soundfile ID (get it from a search result, for example)</tr>
          <tr lang="ru">ID звукового файла Freesound (например, из результатов поиска)</tr>
        </param>
        <param name="@array" type="symbol" required="true">
          <tr lang="en">array name</tr>
          <tr lang="ru">имя массива</tr>
        </param>
        <param name="@norm" type="bool" required="false">
          <tr lang="en">normalize sound</tr>
          <tr lang="ru">нормализовать звук</tr>
        </param>
      </method>
      <!-- me -->
      <method name="me">
        <info>
          <tr lang="en">get and output user information</tr>
          <tr lang="ru">получить и вывести информацию о пользователе</tr>
        </info>
      </method>
      <!-- search -->
      <method name="search">
        <info>
          <tr lang="en">perform a search</tr>
          <tr lang="ru">выполнить поиск</tr>
        </info>
        <param name="@p" type="int" required="false" minvalue="1">
          <tr lang="en">search page number</tr>
          <tr lang="ru">номер страницы поиска</tr>
        </param>
        <param name="@n" type="int" required="false" minvalue="1">
          <tr lang="en">number of results</tr>
          <tr lang="ru">количество результатов</tr>
        </param>
        <param name="@fields" type="symbol" required="false">
          <tr lang="en">requested fields</tr>
          <tr lang="ru">запрошенные поля</tr>
        </param>
        <param name="@sort" type="symbol" required="false">
          <tr lang="en">sort methods: "score", "duration_desc", "duration_asc", "created_desc",
          "created_asc", "downloads_desc", "downloads_asc", "rating_desc", "rating_asc"</tr>
          <tr lang="ru">методы сортировки: "score", "duration_desc", "duration_asc",
          "created_desc", "created_asc", "downloads_desc", "downloads_asc", "rating_desc",
          "rating_asc"</tr>
        </param>
        <param name="@filter" type="symbol" required="false">
          <tr lang="en">filter expression, for example @filter type mp3. See
          https://freesound.org/docs/api/resources_apiv2.html</tr>
          <tr lang="ru">выражение фильтра, например @filter type mp3. См.
          https://freesound.org/docs/api/resources_apiv2.html</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input</tr>
          <tr lang="ru">вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">messages: [user DICT( — user info, [progress VALUE( — download progress,
          [loaded( — when loading is finished, [downloaded( — when file download is finished,
          [results DICT( — search result</tr>
          <tr lang="ru">сообщения: [user DICT( — информация о пользователе, [progress VALUE( —
          прогресс загрузки, [loaded( — загрузка завершена, [downloaded( — скачивание файла
          завершено, [results DICT( — результат поиска</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[search puredata @n 5 @fields id name @filter type mp3 #a(

  [access #b(  [L digits=30]                [array AFS h=100]
               |
   [me(        [access code $1 #c(
   |
   | [F digits=16] [F digits=16]
   | |             |
   | [download $1( [load $1 @array AFS 0 @norm 1 #f(
   | |
   | | [access store(                       [bang(
   | | |                                    |
   | | | [access load(                      [array.play~ AFS]
   | | | |                                  |
[net.freesound #z]                          [ui.hgain~]
|                                           |\
|                                           [dac~]
[route results progress #x]
|
|       [ui.hsl 0 100 #e] [print OTHER #d]  [ui.dsp~]
|
[dict.get /*/*/id? /*/*/name?]
|
[print ID]

[X a->z] [X b->z] [X c->z] [X x:2->d] [X x:1->e] [X f->z]
#b auth
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
