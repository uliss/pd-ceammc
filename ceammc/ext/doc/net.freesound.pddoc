<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="net.freesound">
        <title>net.freesound</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Freesound API v2 client</tr>
                <tr lang="ru">клиент для Freesound API v2</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>net</category>
            <keywords>net freesound</keywords>
            <since>0.9.8</since>
        </meta>
        <info>
            <par>
                <tr lang="en">1) create Freesound API credentials at:</tr>
            </par>
            <a href="https://freesound.org/apiv2/apply">https://freesound.org/apiv2/apply</a>
            <par>
                <tr lang="en">2) save this id/secret pair into the file if using @oauth_file
                property or set @oauth_id/@oauth_secret properties explicitly or enter it with the
                editor</tr>
            </par>
            <par>
                <tr lang="en">3) [access auth( get a temporal application code from the Freesound
                website (valid for ~24 hours)</tr>
            </par>
            <par>
                <tr lang="en">4) [access code CODE( exchange this application code to the internal
                secret access token</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">open id/secret editor</event>
        </mouse>
        <properties>
            <!-- @oauth_file -->
            <property name="@oauth_file" type="symbol" default="" access="initonly">
                <tr lang="en">path to file with OAuth2 ID/secret, one per line</tr>
                <tr lang="ru" finished="false">путь к файлу с OAuth2 ID/secret, один на строку</tr>
            </property>
            <!-- @oauth_id -->
            <property name="@oauth_id" type="symbol" default="" access="initonly">
                <tr lang="en">Freesound OAuth2 ID</tr>
                <tr lang="ru" finished="false">Фризунд OAuth2 ID</tr>
            </property>
            <!-- @oauth_secret -->
            <property name="@oauth_secret" type="symbol" default="" access="initonly">
                <tr lang="en">Freesound OAuth2 secret</tr>
                <tr lang="ru" finished="false">Тайна Freesound OAuth2</tr>
            </property>
        </properties>
        <methods>
            <!-- access auth -->
            <method name="access auth">
                <info>
                    <tr lang="en">get application authorization code (valid ~24 hours) from
                    Freesound page: should open in web browser.</tr>
                </info>
            </method>
            <!-- access code -->
            <method name="access code">
                <info>
                    <tr lang="en">exchange application authorization code to temp *access* token
                    that will be used for every request. Note: you can do it only once, otherwise
                    you need to get another application authorization code from Freesite site.</tr>
                </info>
                <param name="CODE" type="symbol" required="true">
                    <tr lang="en">application auth code. Copy it from from Freesound webpage!</tr>
                </param>
            </method>
            <!-- access load -->
            <method name="access load">
                <info>
                    <tr lang="en">load temp *access* token (not OAuth id/secret!) from the special
                    file from the current patch directory</tr>
                </info>
            </method>
            <!-- access store -->
            <method name="access store">
                <info>
                    <tr lang="en">store temp *access* token (not OAuth id/secret!) into the special
                    file in the current patch directory</tr>
                </info>
            </method>
            <!-- download -->
            <method name="download">
                <info>
                    <tr lang="en">download Freesound file</tr>
                </info>
                <param name="ID" type="int" required="true">
                    <tr lang="en">Freesound soundfile ID (get it from search result, for
                    examples)</tr>
                </param>
            </method>
            <!-- load -->
            <method name="load">
                <info>
                    <tr lang="en">load Freesound file into Pd arrays</tr>
                </info>
                <param name="ID" type="int" required="true">
                    <tr lang="en">Freesound soundfile ID (get it from search result, for
                    examples)</tr>
                </param>
                <param name="@array" type="symbol" required="true">
                    <tr lang="en">array name</tr>
                </param>
                <param name="@norm" type="bool" required="false">
                    <tr lang="en">normalize sound</tr>
                </param>
            </method>
            <!-- me -->
            <method name="me">
                <info>
                    <tr lang="en">get and output user information</tr>
                </info>
            </method>
            <!-- search -->
            <method name="search">
                <info>
                    <tr lang="en">perform search</tr>
                </info>
                <param name="@p" type="int" required="false" minvalue="1">
                    <tr lang="en">search page number</tr>
                </param>
                <param name="@n" type="int" required="false" minvalue="1">
                    <tr lang="en">number of results</tr>
                </param>
                <param name="@fields" type="symbol" required="false">
                    <tr lang="en">requested fields</tr>
                </param>
                <param name="@sort" type="symbol" required="false">
                    <tr lang="en">sort methods: "score", "duration_desc", "duration_asc",
                    "created_desc", "created_asc", "downloads_desc", "downloads_asc",
                    "rating_desc", "rating_asc"</tr>
                </param>
                <param name="@filter" type="symbol" required="false">
                    <tr lang="en">filter expression, for example: @filter type mp3. See
                    https://freesound.org/docs/api/resources_apiv2.html</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">input</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>messages: [user DICT( - user info, [progress VALUE( - download process
            information, [loaded( - when finished loading, [downloaded( - when file download is
            finished, [results DICT( - search result.</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[search puredata @n 5 @fields id name @filter type mp3 #a(

  [access #b(  [L digits=30]                [array AFS h=100]
               |
   [me(        [access code $1 #c(
   |
   | [F digits=16] [F digits=16]
   | |             |
   | [download $1( [load $1 @array AFS 0 @norm 1 #f(
   | |
   | | [access store(                       [bang(
   | | |                                    |
   | | | [access load(                      [array.play~ AFS]
   | | | |                                  |
[net.freesound #z]                          [ui.hgain~]
|                                           |\
|                                           [dac~]
[route results progress #x]
|
|       [ui.hsl 0 100 #e] [print OTHER #d]  [ui.dsp~]
|
[dict.get /*/*/id? /*/*/name?]
|
[print ID]

[X a->z] [X b->z] [X c->z] [X x:2->d] [X x:1->e] [X f->z]
#b auth
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
