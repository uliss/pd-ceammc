<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="hw.gamepad">
        <title>hw.gamepad</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">gamepad controller</tr>
                <tr lang="ru">геймпад контроллеры</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>gamepad</keywords>
            <since>0.9.8</since>
        </meta>
        <info>
            <par>
                <tr lang="en">button names: south, east, north, west, ltrig, ltrig2, rtrig, rtrig2,
                select, start, mode, lthumb, rthumb, up, down, left, right, unknown.</tr>
                <tr lang="ru" finished="false">Названия кнопок: юг, восток, север, запад, ltrig,
                ltrig2, rtrig, rtrig2, выберите, запустите, режим, lthumb, rthumb, вверх, вниз,
                слева, справа, неизвестно.</tr>
            </par>
            <par>
                <tr lang="en">button events: pressed, released, repeated, changed</tr>
                <tr lang="ru" finished="false">события кнопки: нажаты, выпущены, повторены,
                изменены</tr>
            </par>
            <par>
                <tr lang="en">axis names: lstickx, lsticky, rstickx, rsticky, leftz, rightz</tr>
                <tr lang="ru" finished="false">названия осей: lstickx, lsticky, rstickx, rsticky,
                leftz, rightz</tr>
            </par>
        </info>
        <methods>
            <!-- devices -->
            <method name="devices">
                <info>
                    <tr lang="en">output devices info as data:Dict into third outlet</tr>
                    <tr lang="ru" finished="false">выводить информацию об устройствах в виде
                    данных: Дикт в третью точку</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">input</tr>
                    <tr lang="ru" finished="false">ввод</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">button output: list GAMEPAD_ID BUTTON_NAME BUTTON_EVENT
                    VALUE</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">axis output: list GAMEPAD_ID AXIS_NAME VALUE</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">[device DICT( - connected device information, [connected ID( -
                    when device connected, [disconnected ID( - when device disconnected</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[devices(
|
[hw.gamepad #x {w=20}]

     [print AXIS #f]  [ui.dt #b @pinned 1]

[print BUTTON #c]

[route 0 #n]
|
[route lsticky lstickx rsticky rstickx #m]
|
[flow.pack' 2 #k] [flow.pack' 2 #l]
|                 |
[cartesian $1 $2( [cartesian $1 $2(
|                 |
[ui.polar #y]     [ui.polar #z]




/* ... */
[X x:2->b] [X x:0->c]   [X x:1->f]
[X x:1->n] [X m:1->k:1] [X m:2->l:0] [X m:3->l:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
