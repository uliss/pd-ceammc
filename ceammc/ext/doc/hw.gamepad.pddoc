<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.gamepad">
    <title>hw.gamepad</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">gamepad controller</tr>
        <tr lang="ru">контроллер геймпада</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>gamepad</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Reads the state of a connected gamepad and outputs events for buttons, axes,
        and connections and disconnections of devices. Button events are output from the first
        outlet, axis events from the second, and device-related messages (connection,
        disconnection, device info) from the third.</tr>
        <tr lang="ru">Считывает состояние подключённого геймпада и выводит события кнопок, осей, а
        также подключений и отключений устройств. События кнопок выводятся из первого выхода,
        события осей — из второго, а сообщения, связанные с устройством (подключение, отключение,
        информация об устройстве), — из третьего.</tr>
      </par>
      <par>
        <tr lang="en">Button names: south, east, north, west, ltrig, ltrig2, rtrig, rtrig2, select,
        start, mode, lthumb, rthumb, up, down, left, right, unknown.</tr>
        <tr lang="ru">Названия кнопок: south, east, north, west, ltrig, ltrig2, rtrig, rtrig2,
        select, start, mode, lthumb, rthumb, up, down, left, right, unknown.</tr>
      </par>
      <par>
        <tr lang="en">Button events: pressed, released, repeated, changed.</tr>
        <tr lang="ru">События кнопок: pressed, released, repeated, changed.</tr>
      </par>
      <par>
        <tr lang="en">Axis names: lstickx, lsticky, rstickx, rsticky, leftz, rightz.</tr>
        <tr lang="ru">Названия осей: lstickx, lsticky, rstickx, rsticky, leftz, rightz.</tr>
      </par>
    </info>
    <methods>
      <!-- devices -->
      <method name="devices">
        <info>
          <tr lang="en">outputs the list of devices as a data:Dict through the third outlet</tr>
          <tr lang="ru">выводит список устройств в виде data:Dict через третий выход</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input</tr>
          <tr lang="ru">вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">button output: list GAMEPAD_ID BUTTON_NAME BUTTON_EVENT VALUE</tr>
          <tr lang="ru">вывод кнопки: список GAMEPAD_ID BUTTON_NAME BUTTON_EVENT VALUE</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">axis output: list GAMEPAD_ID AXIS_NAME VALUE</tr>
          <tr lang="ru">вывод оси: список GAMEPAD_ID AXIS_NAME VALUE</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">[device DICT( — connected device information, [connected ID( — when a
          device is connected, [disconnected ID( — when a device is disconnected</tr>
          <tr lang="ru">[device DICT( — информация о подключённом устройстве, [connected ID( — при
          подключении устройства, [disconnected ID( — при отключении устройства</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[devices(
|
[hw.gamepad #x {w=20}]

     [print AXIS #f]  [ui.dt #b @pinned 1]

[print BUTTON #c]

[route 0 #n]
|
[route lsticky lstickx rsticky rstickx #m]
|
[flow.pack' 2 #k] [flow.pack' 2 #l]
|                 |
[cartesian $1 $2( [cartesian $1 $2(
|                 |
[ui.polar #y]     [ui.polar #z]




/* ... */
[X x:2->b] [X x:0->c]   [X x:1->f]
[X x:1->n] [X m:1->k:1] [X m:2->l:0] [X m:3->l:1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
