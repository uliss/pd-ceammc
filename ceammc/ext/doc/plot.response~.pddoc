<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="plot.response~">
        <title>plot.response~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">produces the amplitude, phase, and frequency responses to the input
                signal</tr>
                <tr lang="ru">выводит амплитудный, фазовый и частотный отклики на входной
                сигнал</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array histogram</keywords>
            <also>
                <see>plot.linspace~</see>
                <see>plot.geomspace~</see>
            </also>
            <since>0.9</since>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="32" maxvalue="8192">
                <tr lang="en">@n property</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @db -->
            <property name="@db" type="bool" default="0">
                <tr lang="en">decibel mode. It true outputs amplitude in decibels</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" minvalue="32" maxvalue="8192" default="512">
                <tr lang="en">number of processed samples</tr>
            </property>
            <!-- @sr -->
            <property name="@sr" type="bool" default="0">
                <tr lang="en">using samplerate. If true output in [0..SR/2] instead of [0..pi]</tr>
            </property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">starts response calculation</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">frequency response</outlet>
            <outlet type="audio">phase response</outlet>
            <outlet>output to [array.plot~] or [ui.plot~]</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang #a(
|
[click~]
|
[rzero~ -1]
|
[plot.response~ 512 #b {i=2,o=3}]
*|*
*|*
[ui.plot~ {i=3} #z]














[ui.dsp~]
[X a->b:1]
#z @size 400 200 @xlabels 1 @ylabels 1 @xmin_grid 1 @ymin_ticks 0 @ymaj_ticks 0 @xmin_ticks 0 @ymin -2 @ymax 2 @n 2
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
