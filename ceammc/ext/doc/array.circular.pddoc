<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="array.circular">
        <title>array.circular</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">read/write to the array as circular buffer</tr>
                <tr lang="ru">чтение/запись в массив, как в кольцевой буфер</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array circular</keywords>
            <since>0.9.5</since>
            <also>
                <see>array.circular~</see>
            </also>
        </meta>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
            </property>
            <!-- @redraw -->
            <property name="@redraw" type="bool" default="1">
                <tr lang="en">array redraw after change</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">push back new float</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>float: popped front element</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]                     [array A-CIRC size=100 w=180 h=130 yr=0..1]
|
[metro 200] [ui.knob]
|           |
[random.f]  |
|           |
[array.circular A-CIRC]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
