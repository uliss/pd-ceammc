<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.circular">
    <title>array.circular</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">read/write to the array as a circular buffer</tr>
        <tr lang="ru">чтение/запись в массив как в кольцевой буфер</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array circular</keywords>
      <since>0.9.5</since>
      <also>
        <see>array.circular~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">The object treats the specified array as a circular (ring) buffer. When a
        float is received on the inlet, it is pushed to the end of the buffer, and the oldest
        (front) element is popped and output. The buffer size is determined by the size of the
        array.</tr>
        <tr lang="ru">Объект рассматривает указанный массив как кольцевой (циклический) буфер.
        Когда на вход поступает число, оно добавляется в конец буфера, а самый старый (передний)
        элемент извлекается и выводится. Размер буфера определяется размером массива.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array used as a circular buffer</tr>
        <tr lang="ru">имя массива, используемого как кольцевой буфер</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array used as a circular buffer</tr>
        <tr lang="ru">имя массива, используемого как кольцевой буфер</tr>
      </property>
      <!-- @redraw -->
      <property name="@redraw" type="bool" default="1">
        <tr lang="en">redraw the array after each change</tr>
        <tr lang="ru">перерисовывать массив после каждого изменения</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">push a new float to the back of the buffer. The oldest element is shifted
          out and sent to the outlet</tr>
          <tr lang="ru">добавить новое число в конец буфера. Самый старый элемент при этом
          вытесняется и отправляется на выход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">popped front element</tr>
          <tr lang="ru">вытесненный передний элемент</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]                     [array A-CIRC size=100 w=180 h=130 yr=0..1]
|
[metro 200] [ui.knob]
|           |
[random.f]  |
|           |
[array.circular A-CIRC]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
