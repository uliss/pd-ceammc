<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.less">
    <title>flow.less</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">numeric stream router by 'less' condition</tr>
        <tr lang="ru">маршрутизатор числового потока по условию «меньше»</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>gate</keywords>
      <since>0.4</since>
      <aliases>
        <alias>flow.&lt;</alias>
      </aliases>
      <also>
        <see>flow.greater</see>
        <see>flow.less_eq</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes the incoming numbers to the outlets according to the
        threshold values: a number that is less than the first value goes to the first outlet, a
        number less than the N-th value goes to the N-th outlet</tr>
        <tr lang="ru">объект направляет входящие числа на выходы согласно пороговым значениям:
        число, меньшее первого значения, идёт на первый выход, число, меньшее N-го значения, идёт
        на N-й выход</tr>
      </par>
      <par>
        <tr lang="en">numbers greater than or equal to the last threshold value are sent to the
        last outlet</tr>
        <tr lang="ru">числа, большие или равные последнему пороговому значению, отправляются на
        последний выход</tr>
      </par>
      <par>
        <tr lang="en">the threshold values must be in ascending order</tr>
        <tr lang="ru">пороговые значения должны идти по возрастанию</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to split a numeric stream into ranges, for example to
        map note pitches to different instruments or to divide a sensor range into zones</tr>
        <tr lang="ru">объект можно использовать для разбиения числового потока на диапазоны,
        например для распределения нот по разным инструментам или деления диапазона датчика на
        зоны</tr>
      </par>
    </info>
    <arguments>
      <argument name="VALUES" type="list">
        <tr lang="en">threshold values: list of floats in ascending order</tr>
        <tr lang="ru">пороговые значения: список чисел в порядке возрастания</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @values -->
      <property name="@values" type="list" access="initonly" default="">
        <tr lang="en">threshold values: list of floats in ascending order</tr>
        <tr lang="ru">пороговые значения: список чисел в порядке возрастания</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input flow</tr>
          <tr lang="ru">входной поток</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="float">
          <tr lang="en">numbers that are less than the 1st argument</tr>
          <tr lang="ru">числа, меньшие 1-го аргумента</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="float">
          <tr lang="en">numbers that are less than the ... argument</tr>
          <tr lang="ru">числа, меньшие ... аргумента</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="float">
          <tr lang="en">numbers that are less than the N-th argument</tr>
          <tr lang="ru">числа, меньшие N-го аргумента</tr>
        </out>
      </outlet>
      <outlet number="n+1">
        <out type="float">
          <tr lang="en">numbers that are greater than or equal to the last argument</tr>
          <tr lang="ru">числа, большие или равные последнему аргументу</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]
|
|
|
[flow.less 0 10 20 30      ]
|     ^|   ^^|   ^^^|  ^^^^|
[F]   [F]   [F]   [F]    [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
