<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flow.less">
        <title>flow.less</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">numeric stream router by 'less' condition</tr>
                <tr lang="ru">маршрутизатор числового потока по условию 'меньше'</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>gate</keywords>
            <since>0.4</since>
            <aliases>
                <alias>flow.&lt;</alias>
            </aliases>
            <also>
                <see>flow.greater</see>
                <see>flow.less_eq</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Numbers thar are *less* then N-th argument are passed to N-th
                inlet</tr>
                <tr lang="ru" finished="false">Номера thar *less *, затем N-й аргумент передается
                на N-й вход</tr>
            </par>
        </info>
        <arguments>
            <argument name="VALUES" type="list">
                <tr lang="en">compare values: list of floats in ascending order</tr>
                <tr lang="ru" finished="false">Сравнительные значения: список поплавков в порядке
                возрастания</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @values -->
            <property name="@values" type="list" access="initonly" default="">
                <tr lang="en">compare values: list of floats in ascending order</tr>
                <tr lang="ru" finished="false">Сравнительные значения: список поплавков в порядке
                возрастания</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input flow</tr>
                    <tr lang="ru" finished="false">входной поток</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="any">
                    <tr lang="en">numbers that are less then 1st argument</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">numbers that are less than ... argument</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">numbers that are less than N-th argument</tr>
                </out>
            </outlet>
            <outlet number="n+1">
                <out type="any">
                    <tr lang="en">numbers that are greater or equal than last argument</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
|
|
[flow.less 0 10 20 30      ]
|     ^|   ^^|   ^^^|  ^^^^|
[F]   [F]   [F]   [F]    [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
