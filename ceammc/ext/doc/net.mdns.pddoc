<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="net.mdns">
    <title>net.mdns</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">MDNS service discovery</tr>
        <tr lang="ru">обнаружение служб MDNS</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>net</category>
      <keywords>net zeroconf bonjour avahi mdns service discovery</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">mDNS (Multicast DNS) is a protocol that resolves host names to IP addresses
        on a local network without a dedicated DNS server. It operates over UDP port 5353 and uses
        the '.local.' domain suffix</tr>
        <tr lang="ru">mDNS (Multicast DNS) — протокол, который разрешает имена хостов в IP-адреса в
        локальной сети без выделенного DNS-сервера. Работает по UDP-порту 5353 и использует суффикс
        домена «.local.»</tr>
      </par>
      <par>
        <tr lang="en">Service discovery in this object is based on DNS-SD (DNS-Based Service
        Discovery), which uses standard DNS PTR, SRV and TXT records to advertise and find
        services</tr>
        <tr lang="ru">обнаружение служб в этом объекте основано на DNS-SD (DNS-Based Service
        Discovery), который использует стандартные DNS-записи PTR, SRV и TXT для анонсирования и
        поиска служб</tr>
      </par>
      <par>
        <tr lang="en">Service '.local.' domain suffix is optional and can be omitted</tr>
        <tr lang="ru">суффикс домена «.local.» необязателен и может быть опущен</tr>
      </par>
      <par>
        <tr lang="en">There are service aliases: #osc - instead of '_osc._udp.local', #http -
        '_http._tcp.local', #all - to subscribe to all available services on the network</tr>
        <tr lang="ru">есть псевдонимы служб: #osc — вместо '_osc._udp.local', #http —
        '_http._tcp.local', #all — для подписки на все доступные службы в сети</tr>
      </par>
      <par>
        <tr lang="en">Note: on close the object will automatically unregister any previously
        registered services</tr>
        <tr lang="ru">примечание: при закрытии объекта автоматически снимается регистрация всех
        ранее зарегистрированных служб</tr>
      </par>
      <par>
        <tr lang="en">Note: the #all service is a special case — it outputs all available network
        service names with the format [service SERVICE(</tr>
        <tr lang="ru">примечание: #all — особый случай, он выводит все доступные имена сетевых
        служб в формате [service SERVICE(</tr>
      </par>
    </info>
    <properties>
      <!-- @fullname -->
      <property name="@fullname" type="bool" default="1">
        <tr lang="en">if true: output the full instance name (with service and domain suffix), for
        ex.: 'THE_SERVICE._xx.local.' format</tr>
        <tr lang="ru">если true: выводить полное имя экземпляра (с суффиксом службы и домена),
        например: 'THE_SERVICE._xx.local.'</tr>
      </property>
      <!-- @ip -->
      <property name="@ip" type="symbol" default="v4" enum="v4 v6 any">
        <tr lang="en">restrict addresses by type</tr>
        <tr lang="ru">ограничить адреса по типу</tr>
      </property>
    </properties>
    <methods>
      <!-- ifaces -->
      <method name="ifaces">
        <info>
          <tr lang="en">output available network interfaces and their info</tr>
          <tr lang="ru">вывести доступные сетевые интерфейсы и информацию о них</tr>
        </info>
      </method>
      <!-- register -->
      <method name="register">
        <info>
          <tr lang="en">register an MDNS service instance. The instance will be available with the
          DNS name NAME.local</tr>
          <tr lang="ru">зарегистрировать экземпляр службы MDNS. Экземпляр будет доступен по
          DNS-имени NAME.local</tr>
        </info>
        <param name="SERVICE" type="symbol" required="true">
          <tr lang="en">service name, for example: _osc._tcp, or alias: #osc</tr>
          <tr lang="ru">имя службы, например: _osc._tcp, или псевдоним: #osc</tr>
        </param>
        <param name="NAME" type="symbol" required="true">
          <tr lang="en">instance name, for example: MY_SUPER_SERVER</tr>
          <tr lang="ru">имя экземпляра, например: MY_SUPER_SERVER</tr>
        </param>
        <param name="PORT" type="int" minvalue="0" required="true">
          <tr lang="en">instance port</tr>
          <tr lang="ru">порт экземпляра</tr>
        </param>
        <param name="PROPS" type="list" required="false">
          <tr lang="en">list of text props (TXT record), for example: @prop1 FOO @prop2 BAR will
          have TXT records prop1=FOO prop2=BAR</tr>
          <tr lang="ru">список текстовых свойств (запись TXT), например: @prop1 FOO @prop2 BAR даст
          записи TXT prop1=FOO prop2=BAR</tr>
        </param>
      </method>
      <!-- resolve -->
      <method name="resolve">
        <info>
          <tr lang="en">does mDNS name resolving: get service information (host, ip, port, etc.) by
          SERVICE type and INSTANCE name</tr>
          <tr lang="ru">выполняет разрешение имён mDNS: получает информацию о службе (хост, IP,
          порт и т.д.) по типу SERVICE и имени INSTANCE</tr>
        </info>
        <param name="SERVICE" type="symbol" required="true">
          <tr lang="en">service name, for example: _osc._tcp, or alias: #osc or #http</tr>
          <tr lang="ru">имя службы, например: _osc._tcp, или псевдоним: #osc или #http</tr>
        </param>
        <param name="NAME" type="symbol" required="true">
          <tr lang="en">instance name, for example: MY_SUPER_SERVER</tr>
          <tr lang="ru">имя экземпляра, например: MY_SUPER_SERVER</tr>
        </param>
      </method>
      <!-- subscribe -->
      <method name="subscribe">
        <info>
          <tr lang="en">subscribe to service events: add, remove and resolve</tr>
          <tr lang="ru">подписаться на события службы: добавление, удаление и разрешение</tr>
        </info>
        <param name="SERVICE" type="symbol" required="true">
          <tr lang="en">service name, for example: _osc._tcp, or alias: #osc or #all</tr>
          <tr lang="ru">имя службы, например: _osc._tcp, или псевдоним: #osc или #all</tr>
        </param>
        <param name="ON" type="bool" required="false" default="true">
          <tr lang="en">if true: subscribe, false: unsubscribe</tr>
          <tr lang="ru">если true: подписаться, если false: отписаться</tr>
        </param>
      </method>
      <!-- unregister -->
      <method name="unregister">
        <info>
          <tr lang="en">manually unregister a service instance</tr>
          <tr lang="ru">вручную снять регистрацию экземпляра службы</tr>
        </info>
        <param name="SERVICE" type="symbol" required="true">
          <tr lang="en">service name, for example: _osc._tcp, or alias: #osc</tr>
          <tr lang="ru">имя службы, например: _osc._tcp, или псевдоним: #osc</tr>
        </param>
        <param name="NAME" type="symbol" required="true">
          <tr lang="en">instance name, for example: MY_SUPER_SERVER</tr>
          <tr lang="ru">имя экземпляра, например: MY_SUPER_SERVER</tr>
        </param>
      </method>
      <!-- unsubscribe -->
      <method name="unsubscribe">
        <info>
          <tr lang="en">unsubscribe from specified service events</tr>
          <tr lang="ru">отписаться от указанных событий службы</tr>
        </info>
        <param name="SERVICE" type="symbol" required="true">
          <tr lang="en">service name, for example: _osc._tcp, or alias: #osc or #all</tr>
          <tr lang="ru">имя службы, например: _osc._tcp, или псевдоним: #osc или #all</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input</tr>
          <tr lang="ru">вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">add SERVICE NAME, remove SERVICE NAME, service add|remove SERVICE, resolve
          SERVICE NAME HOST PORT IP PROPERTIES</tr>
          <tr lang="ru">add SERVICE NAME, remove SERVICE NAME, service add|remove SERVICE, resolve
          SERVICE NAME HOST PORT IP PROPERTIES</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[subscribe _http._tcp #a(     [subscribe \#all #h(

  [unsubscribe \#http #b(     [unsubscribe \#all #i(

[subscribe _osc._udp #c(

  [unsubscribe \#osc #d(           [register \#osc CEAM 9000 @prop 1 2 3 #f(

      [unsubscribe \#http #e(        [unregister \#osc CEAM #g(

        [resolve \#osc CEAM #j(


      [T]                          [net.mdns #y]
      |
      [@fullname $1(
      |
[net.mdns #x]
| |
| [print]
|
[route resolve]
|
[msg.unpack 5 #z]

     [F #k]    [S digits=16 #l]


[net.mdns-ifaces]

[X a->x] [X b->x] [X c->x] [X d->x] [X e->x]
[X f->y] [X g->y] [X h->x] [X i->x] [X j->x]
[X z:3->k] [X z:4->l]
]]>
      </pdascii>
      <pdascii id="ifaces">
<![CDATA[
[ifaces(
|
[net.mdns]
|
[msg.unpack 3 #x]/*Dict output*/
^|
[print IFACE]    [print INFO #y]
[X x:2->y]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
