<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.rslider" type="gui">
    <title>ui.rslider</title>
    <meta>
      <authors>
        <author>Pierre Guillot</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">two range slider</tr>
        <tr lang="ru">двухдиапазонный слайдер</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui range slider</keywords>
      <since>0.1</since>
      <aliases>
        <alias view="link">ui.rsl</alias>
      </aliases>
      <also>
        <see view="link">ui.slider</see>
        <see view="link">ui.sliders</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">By default outputs messages on mouse click, mouse up and dragging</tr>
        <tr lang="ru" finished="false">По умолчанию выводит сообщения на щелчок мыши, мышь вверх и
        перетаскивание</tr>
      </par>
      <par>
        <tr lang="en">To output messages only on specified event use: @mouse_events=1 and
        [ui.mouse_filter]</tr>
        <tr lang="ru" finished="false">Для вывода сообщений только при указанном использовании
        события: @mouse_events=1 и [ui.mouse_filter]</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">jump both ends to coord under mouse pointer</event>
      <event type="left-click" editmode="false" keys="Cmd">outputs current slider value</event>
      <event type="left-click" editmode="false" keys="Alt">jump nearest border to coord under mouse
      pointer</event>
      <event type="drag" editmode="false">increase slider range</event>
      <event type="drag" editmode="false" keys="Alt">change nearest border coord</event>
      <event type="drag" editmode="false" keys="Shift">move slider range</event>
      <event type="right-click" editmode="false" keys="Shift">open object help</event>
      <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
      <event type="right-click" editmode="true" keys="Shift">open object help</event>
      <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
    </mouse>
    <properties>
      <xi:include href="props_background_color.xml" />
      <xi:include href="props_border_color.xml" />
      <xi:include href="props_fontname.xml" />
      <xi:include href="props_fontsize.xml" />
      <xi:include href="props_fontslant.xml" />
      <xi:include href="props_fontweight.xml" />
      <xi:include href="props_label.xml" />
      <xi:include href="props_label_align.xml" />
      <xi:include href="props_label_inner.xml" />
      <xi:include href="props_label_margins.xml" />
      <xi:include href="props_label_side.xml" />
      <xi:include href="props_label_valign.xml" />
      <xi:include href="props_pinned.xml" />
      <xi:include href="props_ui_receive.xml" />
      <xi:include href="props_ui_send.xml" />
      <xi:include href="props_preset.xml" />
      <!-- @high -->
      <property name="@high" type="float" default="0.6">
        <tr lang="en">max (right) selection value</tr>
        <tr lang="ru" finished="false">max (справа) значение выбора</tr>
      </property>
      <!-- @knob_color -->
      <property name="@knob_color" type="list" default="0 0.75 1 1">
        <tr lang="en">knob color (list of red, green, blue values in 0-1 range)</tr>
        <tr lang="ru" finished="false">цвет ручки (список красных, зеленых, синих значений в
        диапазоне 0-1)</tr>
      </property>
      <!-- @low -->
      <property name="@low" type="float" default="0.4">
        <tr lang="en">low (left) selection value</tr>
        <tr lang="ru" finished="false">Низкое (слева) значение выбора</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="float" default="1">
        <tr lang="en">maximum allowed slider value</tr>
        <tr lang="ru" finished="false">максимально допустимое значение скольжения</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="float" default="0">
        <tr lang="en">minimum allowed slider value</tr>
        <tr lang="ru" finished="false">Минимальное допустимое значение слайдера</tr>
      </property>
      <!-- @mouse_events -->
      <property name="@mouse_events" type="bool" default="0">
        <tr lang="en">mouse events output mode. If on outputs @mouse_down, @mouse_up and
        @mouse_drag events</tr>
        <tr lang="ru" finished="false">Режим вывода событий мыши. Если на выходе @mouse_down,
        @mouse_up и @mouse_drag события</tr>
      </property>
      <!-- @range -->
      <property name="@range" type="float" minvalue="0" default="0.2" access="readonly">
        <tr lang="en">selected slider value</tr>
        <tr lang="ru" finished="false">выбранное значение слайдера</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="120 15">
        <tr lang="en">object size (width, height pair)</tr>
        <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
      </property>
      <!-- @value -->
      <property name="@value" type="list" default="">
        <tr lang="en">current slider value</tr>
      </property>
    </properties>
    <methods>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clears specified preset</tr>
          <tr lang="ru" finished="false">заданный заранее</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru" finished="false">предустановленный индекс</tr>
        </param>
      </method>
      <!-- interp -->
      <method name="interp">
        <info>
          <tr lang="en">interplolates between presets</tr>
          <tr lang="ru" finished="false">Интерплолаты между предустановленными</tr>
        </info>
        <param name="IDX" type="float" required="true">
          <tr lang="en">preset fraction index</tr>
          <tr lang="ru" finished="false">предустановленный дробный индекс</tr>
        </param>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">loads specified preset</tr>
          <tr lang="ru" finished="false">заданный заранее заданный</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru" finished="false">предустановленный индекс</tr>
        </param>
      </method>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set UI element position</tr>
          <tr lang="ru" finished="false">Установите положение элемента UI</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top left x-coord</tr>
          <tr lang="ru" finished="false">верхний левый x-coord</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top right y-coord</tr>
          <tr lang="ru" finished="false">верхняя правая y-coord</tr>
        </param>
      </method>
      <!-- set -->
      <method name="set">
        <info>
          <tr lang="en">sets slider value without output</tr>
          <tr lang="ru" finished="false">устанавливает значение скольжения без вывода</tr>
        </info>
        <param name="V" type="float" required="true">
          <tr lang="en">new value</tr>
          <tr lang="ru" finished="false">Новая стоимость</tr>
        </param>
      </method>
      <!-- store -->
      <method name="store">
        <info>
          <tr lang="en">stores specified preset</tr>
          <tr lang="ru" finished="false">магазины, указанные Preset</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru" finished="false">предустановленный индекс</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs current slider state</tr>
          <tr lang="ru" finished="false">выходы текущего состояния слайдера</tr>
        </in>
        <in on="list">
          <tr lang="en">set range value without output</tr>
          <tr lang="ru" finished="false">значение диапазона без выхода</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output slider range as pair of values</tr>
          <tr lang="ru" finished="false">Диапазон выходных слайдеров как пара значений</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[20 80(      [60 90(
|            |
| [@range?(  | [@low?( [@high?(
| |          | |       |
| |          | |       |
| |          | |       |
[ui.rslider  @min 0 @max 100]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
