<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="is_bang">
        <title>is_bang</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks if the input is a *bang*</tr>
                <tr lang="ru">проверяет, является ли входное сообщение *bang*</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>predicates</category>
            <keywords>predicate bang</keywords>
            <also>
                <see>is_any</see>
                <see>is_float</see>
                <see>is_symbol</see>
                <see>is_list</see>
            </also>
            <since>0.1</since>
        </meta>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">outputs '1' to 1st outlet, otherwise '0'</tr>
                    <tr lang="ru" finished="false">выходы "1" - 1-й выход, иначе "0"</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">0 or 1</tr>
                    <tr lang="ru" finished="false">0 или 1</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">passes *bang* message</tr>
                    <tr lang="ru" finished="false">Сообщение *Bang*</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang( [1( [symbol a( [list a b c(
|      |   |        ___/
[is_bang            ]
|     ^|
[tgl]  [print passed]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
