<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="gain~">
        <title>gain~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">multichannel signal gain</tr>
                <tr lang="ru">многоканальное усиление сигнала</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>gain amplitude decibel</keywords>
            <since>0.6</since>
            <aliases>
                <alias>ceammc/gain~</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="1" maxvalue="16">
                <tr lang="en">number of inputs/outputs</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @db -->
            <property name="@db" type="list" minvalue="-144" default="-144">
                <tr lang="en">gain decibel (dbfs) values</tr>
            </property>
            <!-- @smooth_time -->
            <property name="@smooth_time" type="float" minvalue="1" default="20"
            units="millisecond">
                <tr lang="en">gain change smooth time</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="list" minvalue="0" default="0">
                <tr lang="en">gain amplitude values</tr>
            </property>
        </properties>
        <methods>
            <!-- + -->
            <method name="+">increase gain amplitude 
            <param name="VALS" type="list">
                <tr lang="en">values for each input channel</tr>
            </param></method>
            <!-- +all -->
            <method name="+all">increase gain amplitude for all inputs 
            <param name="V" type="float" required="true">
                <tr lang="en">single value for each input channel</tr>
            </param></method>
            <!-- +db -->
            <method name="+db">increase gain in db 
            <param name="VALS" type="list">
                <tr lang="en">values for each input channel</tr>
            </param></method>
            <method name="-">decrease gain amplitude 
            <param name="VALS" type="list">
                <tr lang="en">values for each input channel</tr>
            </param></method>
            <!-- -all -->
            <method name="-all">decrease gain amplitude for all inputs 
            <param name="V" type="float" required="true">
                <tr lang="en">single value for each input channel</tr>
            </param></method>
            <!-- -db -->
            <method name="-db">decrease gain in db 
            <param name="VALS" type="list">
                <tr lang="en">values for each input channel</tr>
            </param></method>
            <!-- set -->
            <method name="set">set gain amplitude for all inputs 
            <param name="V" type="float" required="true" minvalue="0">
                <tr lang="en">new gain value</tr>
            </param></method>
            <!-- set_db -->
            <method name="set_db">set gain in db for all inputs 
            <param name="V" type="float" required="true" minvalue="-144">
                <tr lang="en">new gain value</tr>
            </param></method>
        </methods>
        <inlets dynamic="true">
            <inlet type="audio" number="1">
                <xinfo>input signal</xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>input signal</xinfo>
            </inlet>
            <inlet type="control" number="n">
                <xinfo on="float">set gain for all inputs</xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio" number="1">output signal</outlet>
            <outlet type="audio" number="...">output signal</outlet>
            <outlet type="audio" number="n">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.sliders @count 4]     [ui.dsp~]
|
|
|
|
|
|
|
| [sig~ 1 #a] [+all 0.1( [-db 6 3(
|             |          |
|             |          | [ui.knob]
|             |          | |
|             |          | |
|             |          | |....
[gain~ 4 . . . . . . .         #b]
|      ^|     ^^|    ^^^|
[env~] [env~] [env~] [env~]
|      |      |      |
[F]    [F]    [F]    [F]

[X a->b] [X a->b:1] [X a->b:2] [X a->b:3]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
