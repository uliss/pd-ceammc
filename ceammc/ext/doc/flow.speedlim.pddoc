<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="flow.speedlim">
        <title>flow.speedlim</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">control stream speed limiter</tr>
                <tr lang="ru">ограничитель скорости потока</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>speelim drop</keywords>
            <since>0.5</since>
            <aliases>
                <alias>ceammc/speedlim</alias>
                <alias>speedlim</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Passthru all control data not often then specified limit in ms. Can
                be used for button debouncing. In initial state is opened, on first message pass it
                and then became closed within specified time interval. All incoming messages in
                that time are dropped. After this interval expiried goes to opened state</tr>
            </par>
        </info>
        <arguments>
            <argument name="LIMIT" type="int" minvalue="0" units="millisecond">
                <tr lang="en">limit time</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @limit -->
            <property name="@limit" type="int" minvalue="0" units="millisecond" default="0">
                <tr lang="en">speed limit. If set to zero there is no flow limitations</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">input flow</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">reset internal timer and goes to opened state</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">set speed limit</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">reset: reset internal timer and goes to opened state</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output flow</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.hsl]         [F]
|                |.
[flow.speedlim 500]
|
[ui.hsl]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
