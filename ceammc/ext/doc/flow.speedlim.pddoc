<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.speedlim">
    <title>flow.speedlim</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">control stream speed limiter</tr>
        <tr lang="ru">ограничитель скорости потока управления</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>speelim drop</keywords>
      <since>0.5</since>
      <aliases>
        <alias>ceammc/speedlim</alias>
        <alias>speedlim</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object passes through all control data no more often than the specified
        limit in milliseconds, and drops all messages that arrive within that interval</tr>
        <tr lang="ru">объект пропускает все управляющие данные не чаще заданного предела в
        миллисекундах и отбрасывает все сообщения, пришедшие в течение этого интервала</tr>
      </par>
      <par>
        <tr lang="en">initially the object is open, on the first message it passes it and then
        becomes closed for the specified time interval, after which it goes back to the open
        state</tr>
        <tr lang="ru">изначально объект открыт, по первому сообщению он пропускает его и затем
        становится закрытым на заданный временной интервал, после чего возвращается в открытое
        состояние</tr>
      </par>
      <par>
        <tr lang="en">@limit sets the time limit, a value of 0 means no limitations</tr>
        <tr lang="ru">@limit задаёт предел времени, значение 0 означает отсутствие ограничений</tr>
      </par>
      <par>
        <tr lang="en">the object can be used for button debouncing or to throttle a stream of
        control messages, for example to limit the rate of a slider output</tr>
        <tr lang="ru">объект можно использовать для подавления дребезга кнопок или для ограничения
        частоты потока управляющих сообщений, например для ограничения частоты выхода слайдера</tr>
      </par>
    </info>
    <arguments>
      <argument name="LIMIT" type="int" minvalue="0" units="millisecond">
        <tr lang="en">limit time</tr>
        <tr lang="ru">предельное время</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @limit -->
      <property name="@limit" type="int" minvalue="0" units="millisecond" default="0">
        <tr lang="en">speed limit. If set to zero there are no flow limitations</tr>
        <tr lang="ru">ограничение скорости. При нулевом значении ограничений потока нет</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input flow</tr>
          <tr lang="ru">входной поток</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">reset internal timer and go to the open state</tr>
          <tr lang="ru">сбросить внутренний таймер и перейти в открытое состояние</tr>
        </in>
        <in on="float">
          <tr lang="en">set speed limit</tr>
          <tr lang="ru">задать ограничение скорости</tr>
        </in>
        <in>
          <tr lang="en">reset: reset internal timer and go to the open state</tr>
          <tr lang="ru">reset: сбросить внутренний таймер и перейти в открытое состояние</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output flow</tr>
          <tr lang="ru">выходной поток</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.hsl]         [F]
|                |.
[flow.speedlim 500]
|
[ui.hsl]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
