<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.ltcplay~">
    <title>array.ltcplay~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">array player controlled by LTC</tr>
        <tr lang="ru">проигрывание звуковой таблицы с управлением по LTC</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array ltc play</keywords>
      <since>0.9.7</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object plays back the specified array, synchronizing the playback
        position with an incoming LTC (Linear Timecode) signal. The LTC stream is received on the
        audio inlet, and the array is played from the position encoded in the timecode. This allows
        the array playback to be synchronized with an external timecode source.</tr>
        <tr lang="ru">Объект воспроизводит указанный массив, синхронизируя позицию воспроизведения
        с входящим сигналом LTC (Linear Timecode). Поток LTC принимается на звуковой вход, и массив
        воспроизводится с позиции, закодированной во временном коде. Это позволяет синхронизировать
        воспроизведение массива с внешним источником временного кода.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array to play back</tr>
        <tr lang="ru">имя массива для воспроизведения</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array to play back</tr>
        <tr lang="ru">имя массива для воспроизведения</tr>
      </property>
      <!-- @fps -->
      <property name="@fps" type="atom" enum="auto 24 25 29.97 30" default="auto">
        <tr lang="en">expected LTC stream frame rate. Use 'auto' to detect the frame rate
        automatically</tr>
        <tr lang="ru">ожидаемая частота кадров потока LTC. Используйте 'auto' для автоматического
        определения частоты кадров</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">LTC input signal that controls playback position</tr>
          <tr lang="ru">входной сигнал LTC, управляющий позицией воспроизведения</tr>
        </in>
      </inlet>
      <inlet>
        <in on="symbol">
          <tr lang="en">sets the source array to play back</tr>
          <tr lang="ru">устанавливает исходный массив для воспроизведения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">playback output</tr>
          <tr lang="ru">выход воспроизведения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]         [msg.onload symbol %CEAMMC%/guitar1.wav]
|           |
[openpanel] [expand_env]
|           |
[load $1 to  altc @resize @resample(
|
[snd.file]


[T] [time 0 0 0(          [array altc 100]
|   |
|   |   [seek -2s(
|   |   |
[ltc.out~]
|
|
|
[array.ltcplay~ altc]
|
[ui.hgain~]
|\
[dac~]                    [ui.dsp~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
