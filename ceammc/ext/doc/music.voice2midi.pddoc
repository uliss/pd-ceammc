<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="music.voice2midi">
        <title>music.voice2midi</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert single voice music to list of MIDI pitches</tr>
                <tr lang="ru">конвертирует одноголосную музыкальную нотацию в список нот MIDI</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv music voice</keywords>
            <since>0.9.4</since>
            <aliases>
                <alias>music.v-&gt;m</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Basic syntax:</tr>
                <tr lang="ru" finished="false">Основной синтаксис:</tr>
            </par>
            <par>
                <tr lang="en">- pitch: C, D, E, F, G, A, B</tr>
                <tr lang="ru" finished="false">- шаг: C, D, E, F, G, A, B</tr>
            </par>
            <par>
                <tr lang="en">- alteration: #, ##, b or bb</tr>
                <tr lang="ru" finished="false">- изменение: #, ##, b или b</tr>
            </par>
            <par>
                <tr lang="en">- octave: -1..9 or ^, _</tr>
                <tr lang="ru" finished="false">- октава: -1,9 или ^, _</tr>
            </par>
            <par>
                <tr lang="en">- deviation in cents: (+-NUMc)</tr>
                <tr lang="ru" finished="false">- отклонение в центах: (+-NUMc)</tr>
            </par>
            <par>
                <tr lang="en">- duration: |8, |4. or |3/8</tr>
                <tr lang="ru" finished="false">- продолжительность: |8, |4. или |3/8</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <in>
                    <tr lang="en">note list</tr>
                    <tr lang="ru" finished="false">примечание</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">MIDI values</tr>
                    <tr lang="ru" finished="false">Значения MIDI</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii id="main">
<![CDATA[
[list C|4 D R Eb F# G\(-25c) A|8(
|
|
|
[music.v->m]
|
[ui.dt]

[music.voice2midi-notes] [music.voice2midi-oct]   [music.voice2midi-dur]

[music.voice2midi-alt]   [music.voice2midi-micro]
]]>
            </pdascii>
            <pdascii id="notes">
<![CDATA[
[list C D E F G A B(
|
[music.v->m]
|
[ui.dt]
]]>
            </pdascii>
            <pdascii id="alt">
<![CDATA[
[list C C# C## Eb Fbb(
|
[music.v->m]
|
[ui.dt]
]]>
            </pdascii>
            <pdascii id="dur">
<![CDATA[
/*duration as denominator*/

[list C|1 C|2 C|4 C|8 C|16 C|32 C|64 C|128 C|256(
|
[music.v->m]
|
[ui.dt]

/*duration as ratio*/

[list C|2/3 D|1/16(
|
[music.v->m]
|
[ui.dt]

/*duration relative*/

[list C|1 D|/2 E F|*2(
|
[music.v->m]
|
[ui.dt]
]]>
            </pdascii>
            <pdascii id="micro">
<![CDATA[
/*deviation in cents: -99..+99 range*/

[list C4\(-10c) C^\(+99c)(
|
[music.v->m]
|
[ui.dt]
]]>
            </pdascii>
            <pdascii id="oct">
<![CDATA[
/*asbolute octave number in -1..9 range, C4=60*/

[list C4 D5 E2 F-1 G9(
|
[music.v->m]
|
[ui.dt]

/*if octave is omitted, previous note octave is used*/

[list C2 B E F G A7 C D(
|
[music.v->m]
|
[ui.dt]

/*relative octave changes: ^(up) and _(down)*/

[list C4 E G C^ C_ C__ G^^^(
|
[music.v->m]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
