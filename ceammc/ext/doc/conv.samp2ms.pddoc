<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.samp2ms">
    <title>conv.samp2ms</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts samples to millisecond according sample rate</tr>
        <tr lang="ru">преобразует количество семплов в миллисекунды в соответствии с частотой
        дискретизации</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv samp</keywords>
      <since>0.8</since>
      <aliases>
        <alias>ceammc/samp-&gt;ms</alias>
        <alias>samp-&gt;ms</alias>
      </aliases>
      <also>
        <see>conv.sec2samp</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts a number of samples to a time in milliseconds, based on
        the current sample rate of the patch. This is the inverse operation of [conv.ms2samp].</tr>
        <tr lang="ru">Объект преобразует количество семплов во время в миллисекундах, исходя из
        текущей частоты дискретизации патча. Это операция, обратная [conv.ms2samp].</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="int">
          <tr lang="en">number of samples</tr>
          <tr lang="ru">количество семплов</tr>
        </in>
        <in on="list">
          <tr lang="en">list of numbers of samples</tr>
          <tr lang="ru">список значений количества семплов</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">converted value (float or list)</tr>
          <tr lang="ru">преобразованное значение (число или список)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[44100(  [20 1000 5000 20000(
|        |
[samp->ms]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
