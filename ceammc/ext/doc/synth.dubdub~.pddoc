<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="synth.dubdub~">
        <title>synth.dubdub~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">simple synth based on a sawtooth wave filtered by a resonant
                lowpass</tr>
                <tr lang="ru">простой синтезатор на основе пилообразной волны, фильтруемой
                резонансным фильтром нижних частот</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>dubdub saw</keywords>
            <since>0.6</since>
        </meta>
        <properties>
            <xi:include href="props_osc.xml"/>
            <xi:include href="props_id.xml"/>
            <xi:include href="props_active.xml"/>
            <!-- @cutoff -->
            <property name="@cutoff" type="float" minvalue="20" maxvalue="20000" default="3000">
                <tr lang="en">cutoff frequency</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" units="hertz" default="130.8128">
                <tr lang="en">frequency</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">play trigger &gt;0: on, 0: off. Values greater then zero set output
                amplitude.</tr>
            </property>
            <!-- @pitch -->
            <property name="@pitch" type="float" minvalue="24" maxvalue="84" default="48">
                <tr lang="en">midi pitch</tr>
            </property>
            <!-- @q -->
            <property name="@q" type="float" minvalue="0.01" maxvalue="100" default="0.1">
                <tr lang="en">quality factor</tr>
            </property>
        </properties>
        <methods>
            <!-- note -->
            <method name="note">
                <info>
                    <tr lang="en">note on/off message</tr>
                </info>
                <param name="NOTE" type="float" required="true">
                    <tr lang="en">midi note</tr>
                </param>
                <param name="VEL" type="float" minvalue="0" maxvalue="127" required="true">
                    <tr lang="en">velocity</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">NOTE VEL</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en"/>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
[msg note]
|
| [T]                        [ui.knob]  [ui.knob]
| |                          |          |
| [metro.pattern 200 150 50] |          |
| |                          [@q $1 #b( [lin->lin 0 1 100 8000]
| [next(                                |
| |                                     |
| [list.walk C2 D3 G3 C4 Bb2 C2 @loop]  [@cutoff $1 #c(
| |
| [pitch->midi]
| |
| [@pitch $1, @gate 0(
| |
| [msg.after 10 @gate 1]
| |
[synth.dubdub~ #a]
|
[ui.gain~ @size 120 16]
|\
[dac~]

[ui.dsp~]
[X b->a] [X c->a]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
