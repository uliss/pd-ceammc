<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="random.linear">
    <title>random.linear</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">random linear distribution</tr>
        <tr lang="ru">случайное линейное распределение</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>random</category>
      <keywords>linear random</keywords>
      <also>
        <see>random.float</see>
        <see>random.int</see>
      </also>
      <since>0.4</since>
    </meta>
    <info>
      <par>
        <tr lang="en">generates a random number in the interval [@v0, @v1) with a linear
        distribution [@p0, @p1)</tr>
        <tr lang="ru">генерирует случайное число на интервале [@v0, @v1) с линейным распределением
        [@p0, @p1)</tr>
      </par>
      <par>
        <tr lang="en">use the @seed property to get reproducible sequences. If @seed is not set
        explicitly, a generator initialized with the current time is used</tr>
        <tr lang="ru">используйте свойство @seed для получения воспроизводимых последовательностей.
        Если @seed не задан явно, используется генератор, инициализированный текущим временем</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to bias random values toward one end of a range, for
        example to make low notes more likely than high notes or to create a gradual fade-in
        effect</tr>
        <tr lang="ru">объект можно использовать для смещения случайных значений к одному краю
        диапазона, например чтобы низкие ноты выпадали чаще высоких или чтобы создать эффект
        постепенного нарастания</tr>
      </par>
    </info>
    <properties>
      <!-- @p0 -->
      <property name="@p0" type="float" default="1">
        <tr lang="en">probability at the beginning</tr>
        <tr lang="ru">вероятность в начале</tr>
      </property>
      <!-- @p1 -->
      <property name="@p1" type="float" default="0">
        <tr lang="en">probability at the end</tr>
        <tr lang="ru">вероятность в конце</tr>
      </property>
      <!-- @seed -->
      <property name="@seed" type="int" minvalue="0" default="0">
        <tr lang="en">generator seed</tr>
        <tr lang="ru">начальное значение генератора</tr>
      </property>
      <!-- @v0 -->
      <property name="@v0" type="float" default="0">
        <tr lang="en">beginning of the value interval</tr>
        <tr lang="ru">начало интервала значений</tr>
      </property>
      <!-- @v1 -->
      <property name="@v1" type="float" default="1">
        <tr lang="en">end of the value interval</tr>
        <tr lang="ru">конец интервала значений</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">generates a random number</tr>
          <tr lang="ru">генерирует случайное число</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">result value</tr>
          <tr lang="ru">значение результата</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[list.gen 100]          [array array1 size=100 yr=0..1]
^|
[random.linear]
|
[* 100]
|
[math.floor]
|
[t f f]
|    ^|
|    [tabread array1]
|    |
|    [+ 0.01]
|    |.
[swap ]                 [const 0( [normalize(
|    ^|.                |         |
[tabwrite array1]       [s array1 ]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
