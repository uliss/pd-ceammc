<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.reciprocal">
        <title>math.reciprocal</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">calculate reciprocal number</tr>
                <tr lang="ru">вычислить обратное значение</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math reciprocal</keywords>
            <since>0.1</since>
            <aliases>
                <alias>ceammc/1/x</alias>
                <alias>1/x</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Symbols are ignored, 0 gives NAN value</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input value</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">on list input outputs a list of reciprocal values</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]  [1 2 3 4 5(      [F]
|    |                |
[1/x ]                [1 $1(
|                     |
[ui.dt]               [/]
                      |
                      [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
