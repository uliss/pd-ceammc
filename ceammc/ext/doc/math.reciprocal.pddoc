<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="math.reciprocal">
    <title>math.reciprocal</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">calculate reciprocal number</tr>
        <tr lang="ru">вычислить обратное значение</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>math</category>
      <keywords>math reciprocal</keywords>
      <since>0.1</since>
      <aliases>
        <alias>ceammc/1/x</alias>
        <alias>1/x</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Symbols are ignored, 0 gives NAN value</tr>
        <tr lang="ru">Символы игнорируются, 0 дает значение NAN</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input number</tr>
          <tr lang="ru">входное число</tr>
        </in>
        <in on="list">
          <tr lang="en">input list of numbers</tr>
          <tr lang="ru">входной список чисел</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">the result</tr>
          <tr lang="ru">результат</tr>
        </out>
        <out type="list">
          <tr lang="en">the result</tr>
          <tr lang="ru">результат</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]  [1 2 3 4 5(      [array \$0-recip #a]    [F]  /*vanilla analogue*/
|    |                                        |
[1/x ]                                        [1 $1(
|                                             |
[ui.dt]                                       [/]
                                              |
                                              [F]

[bang(
|
[list.seq -5 5 0.025]
|
[math.reciprocal]
|
[list->array \$0-recip]
#a yr=-5..5 w=200 h=200
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
