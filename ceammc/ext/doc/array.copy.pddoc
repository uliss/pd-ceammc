<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="array.copy">
        <title>array.copy</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">copy samples from the one array to another</tr>
                <tr lang="ru">копирование семплов из одного массива в другой</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array copy</keywords>
            <also>
                <see>array.each</see>
            </also>
            <since>0.3</since>
        </meta>
        <properties>
            <!-- @resize -->
            <property name="@resize" type="bool" default="0">
                <tr lang="en">resize the destination array on overflow</tr>
                <tr lang="ru">изменять размера массива назначения при переполнении</tr>
            </property>
        </properties>
        <methods>
            <!-- copy SRC DEST -->
            <method name="copy SRC DEST">
                <info>
                    <tr lang="en">copy the whole array content</tr>
                    <tr lang="ru">копирует все содержимое массива</tr>
                </info>
                <param name="SRC" type="symbol" required="true">
                    <tr lang="en">the source array</tr>
                    <tr lang="ru">имя исходного массива</tr>
                </param>
                <param name="DST" type="symbol" required="true">
                    <tr lang="en">the destination array</tr>
                    <tr lang="ru">массив назначения</tr>
                </param>
            </method>
            <!-- copy SRC FROM DEST -->
            <method name="copy SRC FROM DEST">
                <info>
                    <tr lang="en">copy the array content from the specified position till the
                    end</tr>
                    <tr lang="ru">копирует содержимое массива из указанной позиции до конца</tr>
                </info>
                <param name="SRC" type="symbol" required="true">
                    <tr lang="en">the source array</tr>
                    <tr lang="ru">исходный массив</tr>
                </param>
                <param name="FROM" type="int" required="true">
                    <tr lang="en">the source array start position</tr>
                    <tr lang="ru">начальная позиция в исходном массиве</tr>
                </param>
                <param name="DEST" type="symbol" required="true">
                    <tr lang="en">the destination array</tr>
                    <tr lang="ru">массив назначения</tr>
                </param>
            </method>
            <!-- copy SRC FROM TO DEST -->
            <method name="copy SRC FROM TO DEST">
                <info>
                    <tr lang="en">copy the array content from the specified range</tr>
                    <tr lang="ru">копирует содержимое массива из указанного диапазона</tr>
                </info>
                <param name="SRC" type="symbol" required="true">
                    <tr lang="en">the source array</tr>
                    <tr lang="ru">исходный массив</tr>
                </param>
                <param name="FROM" type="int" required="true">
                    <tr lang="en">the source start range</tr>
                    <tr lang="ru">начало диапазона в исходном массиве</tr>
                </param>
                <param name="TO" type="int" required="true">
                    <tr lang="en">the source end range</tr>
                    <tr lang="ru">конец диапазона в исходном массиве</tr>
                </param>
                <param name="DEST" type="symbol" required="true">
                    <tr lang="en">the destination array</tr>
                    <tr lang="ru">массив назначения</tr>
                </param>
            </method>
            <!-- copy SRC FROM TO DEST DEST_START -->
            <method name="copy SRC FROM TO DEST DEST_START">
                <info>
                    <tr lang="en">copy the array content from the specified range and to the
                    specified destination position</tr>
                    <tr lang="ru">копировать содержимое массива из указанного диапазона и в
                    указанное место назначения</tr>
                </info>
                <param name="SRC" type="symbol" required="true">
                    <tr lang="en">the source array</tr>
                    <tr lang="ru">исходный массив</tr>
                </param>
                <param name="FROM" type="int" required="true">
                    <tr lang="en">the source start range</tr>
                    <tr lang="ru">начало диапазона в исходном массиве</tr>
                </param>
                <param name="TO" type="int" required="true">
                    <tr lang="en">the source end range</tr>
                    <tr lang="ru">конец диапазона в исходном массиве</tr>
                </param>
                <param name="DEST" type="symbol" required="true">
                    <tr lang="en">the destination array</tr>
                    <tr lang="ru">массив назначения</tr>
                </param>
                <param name="DEST_FROM" type="int" required="true">
                    <tr lang="en">the destination start position</tr>
                    <tr lang="ru">начальная позиция в массиве назначения</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">FROM TO - copy data from the one array to another</tr>
                    <tr lang="ru">FROM TO - копирование данных из одного массива в другой</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="bang">
                    <tr lang="en">on done</tr>
                    <tr lang="ru">при завершении операции</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[array A1 size=100 w=130 h=100] [array A2 size=20 w=130 h=100]







              [copy A1 10 20 A2( [copy A1 5 20 A2 15(
              |                  |
[copy A1 A2(  |  [copy A1 40 A2( |
|             |  |               |
[array.copy                      ]
|
[B]

[loadbang]
|
[sinesum 100 0.5 0.2 0 0.1 0.4(
|
[s A1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
