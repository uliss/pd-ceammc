<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fx.dattorro~">
    <title>fx.dattorro~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Dattorro reverb</tr>
        <tr lang="ru">ревербератор Dattorro</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>fx</category>
      <keywords>fx reverb</keywords>
      <since>0.9.6</since>
    </meta>
    <info>
      <par>
        <tr lang="en">a reverberator based on the Dattorro reverb topology with the default reverb parameters from the original paper</tr>
        <tr lang="ru">ревербератор на основе топологии реверберации Dattorro с параметрами по умолчанию из оригинальной статьи</tr>
      </par>
      <par>
        <tr lang="en">Dattorro is Jon Dattorro, whose 1997 paper "Effect Design, Part 1" became a classic reference for digital reverb design</tr>
        <tr lang="ru">Dattorro — это Jon Dattorro, чья статья «Effect Design, Part 1» (1997) стала классическим справочником по проектированию цифровых ревербераторов</tr>
      </par>
      <par>
        <tr lang="en">@decay sets the decay rate, a value of 1.0 gives infinite decay, @damp controls the high-frequency damping</tr>
        <tr lang="ru">@decay задаёт скорость затухания, значение 1.0 даёт бесконечное затухание, @damp управляет демпфированием высоких частот</tr>
      </par>
      <par>
        <tr lang="en">@bw, @idiff1, @idiff2 and @ddiff1, @ddiff2 control the bandwidth filter and the diffusion stages</tr>
        <tr lang="ru">@bw, @idiff1, @idiff2 и @ddiff1, @ddiff2 управляют полосовым фильтром и каскадами диффузии</tr>
      </par>
      <par>
        <tr lang="en">@predelay sets the delay before the processed signal, @drywet mixes the original (dry) and processed signals</tr>
        <tr lang="ru">@predelay задаёт задержку перед обработанным сигналом, @drywet смешивает исходный (сухой) и обработанный сигналы</tr>
      </par>
      <a href="https://ccrma.stanford.edu/~dattorro/EffectDesignPart1.pdf">
      https://ccrma.stanford.edu/~dattorro/EffectDesignPart1.pdf</a>
    </info>
    <arguments>
      <argument name="DECAY" type="float" minvalue="0" maxvalue="1">
        <tr lang="en">decay rate, infinite decay = 1.0</tr>
        <tr lang="ru">скорость затухания, бесконечное затухание = 1.0</tr>
      </argument>
      <argument name="DRYWET" type="float" minvalue="0" maxvalue="1">
        <tr lang="en">proportion of mix between the original (dry) and processed signals</tr>
        <tr lang="ru">пропорция смеси между исходным (сухим) и обработанным сигналами</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @bw -->
      <property name="@bw" type="float" minvalue="0" maxvalue="1" default="0.9995">
        <tr lang="en">bandwidth filter (pre-filtering)</tr>
        <tr lang="ru">полосовой фильтр (предфильтрация)</tr>
      </property>
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypass the processed signal</tr>
        <tr lang="ru">флаг обхода. Если true: пропускать обработанный сигнал без изменений</tr>
      </property>
      <!-- @damp -->
      <property name="@damp" type="float" minvalue="0" maxvalue="1" default="0.0005">
        <tr lang="en">high-frequency damping. No damping = 0.0</tr>
        <tr lang="ru">демпфирование высоких частот. Без демпфирования = 0.0</tr>
      </property>
      <!-- @ddiff1 -->
      <property name="@ddiff1" type="float" minvalue="0" maxvalue="1" default="0.5">
        <tr lang="en">decay diffusion factor 1</tr>
        <tr lang="ru">коэффициент диффузии затухания 1</tr>
      </property>
      <!-- @ddiff2 -->
      <property name="@ddiff2" type="float" minvalue="0" maxvalue="1" default="0.7">
        <tr lang="en">decay diffusion factor 2</tr>
        <tr lang="ru">коэффициент диффузии затухания 2</tr>
      </property>
      <!-- @decay -->
      <property name="@decay" type="float" minvalue="0" maxvalue="1" default="0.5">
        <tr lang="en">decay rate. Infinite decay = 1.0</tr>
        <tr lang="ru">скорость затухания. Бесконечное затухание = 1.0</tr>
      </property>
      <!-- @drywet -->
      <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.33">
        <tr lang="en">proportion of mix between the original (dry) and processed signals. 0 — dry signal, 1 — processed</tr>
        <tr lang="ru">пропорция смеси между исходным (сухим) и обработанным сигналами. 0 — сухой сигнал, 1 — обработанный</tr>
      </property>
      <!-- @idiff1 -->
      <property name="@idiff1" type="float" minvalue="0" maxvalue="1" default="0.625">
        <tr lang="en">input diffusion factor 1</tr>
        <tr lang="ru">коэффициент входной диффузии 1</tr>
      </property>
      <!-- @idiff2 -->
      <property name="@idiff2" type="float" minvalue="0" maxvalue="1" default="0.75">
        <tr lang="en">input diffusion factor 2</tr>
        <tr lang="ru">коэффициент входной диффузии 2</tr>
      </property>
      <!-- @predelay -->
      <property name="@predelay" type="float" minvalue="0" maxvalue="100" default="40"
      units="millisecond">
        <tr lang="en">a delay operating on the processed signal. Large values give the impression of a larger room</tr>
        <tr lang="ru">задержка, действующая на обработанный сигнал. Большие значения дают ощущение большего помещения</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset reverb</tr>
          <tr lang="ru">сбросить реверберацию</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">left channel</tr>
          <tr lang="ru">левый канал</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">right channel</tr>
          <tr lang="ru">правый канал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output left</tr>
          <tr lang="ru">выход левого канала</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output right</tr>
          <tr lang="ru">выход правого канала</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env #a]
|
|            [ui.knob]   [ui.knob]  [ui.knob]
|            |           |          |
[readsf~ #b] |           |          |
|            |           |          |
|            [@decay $1( [@damp $1( [@drywet $1(
|            |           |          |
|            |           |          | [T]
|            |           |          | |
|            |           |          | [@bypass $1(
|            |           |          | |
[fx.dattorro~  0.5                    ]
|
[ui.gain~ @size 120 16] [ui.dsp~]
| \
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
