<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="fx.dattorro~">
        <title>fx.dattorro~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Dattorro reverb</tr>
                <tr lang="ru">реверберация Dattorro</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx reverb</keywords>
            <since>0.9.6</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Reverberator based on the Dattorro reverb topology with default
                reverb parameters from the original paper</tr>
                <!-- old: Ревербератор на основе топологии реверберации
                Dattorro с параметрами реверберации по умолчанию из оригинальной бумаги -->
                <tr lang="ru" finished="false">Ревербератор на основе топологии реверберации
                Dattorro с параметрами реверберации по умолчанию из оригинальной бумаги</tr>
            </par>
            <a href="https://ccrma.stanford.edu/~dattorro/EffectDesignPart1.pdf">
            https://ccrma.stanford.edu/~dattorro/EffectDesignPart1.pdf</a>
        </info>
        <arguments>
            <argument name="DECAY" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">decay rate, infinite decay = 1.0</tr>
                <tr lang="ru" finished="false">скорость распада, бесконечный распад = 1,0</tr>
            </argument>
            <argument name="DRYWET" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals</tr>
                <!-- old: Пропорция смеси между исходными (сухими) и
                «вредными» (мокрыми) сигналами -->
                <tr lang="ru" finished="false">Пропорция смеси между исходными (сухими) и
                «вредными» (мокрыми) сигналами</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bw -->
            <property name="@bw" type="float" minvalue="0" maxvalue="1" default="0.9995">
                <tr lang="en">band-width filter (pre filtering)</tr>
                <tr lang="ru" finished="false">Широкополосный фильтр (pre filtering)</tr>
            </property>
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
                <!-- old: Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал. -->
                <tr lang="ru" finished="false">Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал.</tr>
            </property>
            <!-- @damp -->
            <property name="@damp" type="float" minvalue="0" maxvalue="1" default="0.0005">
                <tr lang="en">high-frequency damping. No damping = 0.0</tr>
                <!-- old: высокочастотное демпфирование. Нет демпфирования =
                0,0 -->
                <tr lang="ru" finished="false">высокочастотное демпфирование. Нет демпфирования =
                0,0</tr>
            </property>
            <!-- @ddiff1 -->
            <property name="@ddiff1" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">decay diffusion factor 1</tr>
                <tr lang="ru" finished="false">коэффициент диффузии распада 1</tr>
            </property>
            <!-- @ddiff2 -->
            <property name="@ddiff2" type="float" minvalue="0" maxvalue="1" default="0.7">
                <tr lang="en">decay diffusion factor 2</tr>
                <tr lang="ru" finished="false">коэффициент диффузии распада 2</tr>
            </property>
            <!-- @decay -->
            <property name="@decay" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">decay rate. Infinite decay = 1.0</tr>
                <tr lang="ru" finished="false">Скорость распада. Бесконечный распад = 1,0</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.33">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet</tr>
                <!-- old: пропорция смеси между исходными (сухими) и
                "влажными" сигналами. 0 - сухой сигнал, 1 - влажный -->
                <tr lang="ru" finished="false">пропорция смеси между исходными (сухими) и
                "влажными" сигналами. 0 - сухой сигнал, 1 - влажный</tr>
            </property>
            <!-- @idiff1 -->
            <property name="@idiff1" type="float" minvalue="0" maxvalue="1" default="0.625">
                <tr lang="en">input diffusion factor 1</tr>
                <tr lang="ru" finished="false">входной коэффициент диффузии 1</tr>
            </property>
            <!-- @idiff2 -->
            <property name="@idiff2" type="float" minvalue="0" maxvalue="1" default="0.75">
                <tr lang="en">input diffusion factor 2</tr>
                <tr lang="ru" finished="false">входной коэффициент диффузии 2</tr>
            </property>
            <!-- @predelay -->
            <property name="@predelay" type="float" minvalue="0" maxvalue="100" default="40"
            units="millisecond">
                <tr lang="en">a delay operating on the 'wet' signal. Large values will provide the
                impression of a larger room</tr>
                <!-- old: Задержка работы по сигналу «мокрый». Большие
                значения обеспечат впечатление большой комнаты -->
                <tr lang="ru" finished="false">Задержка работы по сигналу «мокрый». Большие
                значения обеспечат впечатление большой комнаты</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset reverb</tr>
                    <tr lang="ru" finished="false">реверберация</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">left channel</tr>
                    <tr lang="ru" finished="false">левый канал</tr>
                </in>
            </inlet>
            <inlet type="audio">
                <in>
                    <tr lang="en">right channel</tr>
                    <tr lang="ru" finished="false">Правый канал</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output left</tr>
                    <tr lang="ru" finished="false">выходной остаток</tr>
                </out>
            </outlet>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output right</tr>
                    <tr lang="ru" finished="false">выходное право</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env #a]
|
|            [ui.knob]   [ui.knob]  [ui.knob]
|            |           |          |
[readsf~ #b] |           |          |
|            |           |          |
|            [@decay $1( [@damp $1( [@drywet $1(
|            |           |          |
|            |           |          | [T]
|            |           |          | |
|            |           |          | [@bypass $1(
|            |           |          | |
[fx.dattorro~  0.5                    ]
|
[ui.gain~ @size 120 16] [ui.dsp~]
| \
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
