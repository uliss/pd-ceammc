<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="fx.dattorro~">
        <title>fx.dattorro~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Dattorro reverb</tr>
                <tr lang="ru">реверберация Dattorro</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx reverb</keywords>
            <since>0.9.6</since>
        </meta>
        <info>
            <par>Reverberator based on the Dattorro reverb topology with default reverb parameters
            from the original paper</par>
            <a href="https://ccrma.stanford.edu/~dattorro/EffectDesignPart1.pdf">
            https://ccrma.stanford.edu/~dattorro/EffectDesignPart1.pdf</a>
        </info>
        <arguments>
            <argument name="DECAY" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">decay rate, infinite decay = 1.0</tr>
            </argument>
            <argument name="DRYWET" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1">
                <tr lang="en">on/off dsp processing</tr>
            </property>
            <!-- @bw -->
            <property name="@bw" type="float" minvalue="0" maxvalue="1" default="0.9995">
                <tr lang="en">band-width filter (pre filtering)</tr>
            </property>
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
            </property>
            <!-- @damp -->
            <property name="@damp" type="float" minvalue="0" maxvalue="1" default="0.0005">
                <tr lang="en">high-frequency damping. No damping = 0.0</tr>
            </property>
            <!-- @ddiff1 -->
            <property name="@ddiff1" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">decay diffusion factor 1</tr>
            </property>
            <!-- @ddiff2 -->
            <property name="@ddiff2" type="float" minvalue="0" maxvalue="1" default="0.7">
                <tr lang="en">decay diffusion factor 2</tr>
            </property>
            <!-- @decay -->
            <property name="@decay" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">decay rate. Infinite decay = 1.0</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.33">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet</tr>
            </property>
            <!-- @idiff1 -->
            <property name="@idiff1" type="float" minvalue="0" maxvalue="1" default="0.625">
                <tr lang="en">input diffusion factor 1</tr>
            </property>
            <!-- @idiff2 -->
            <property name="@idiff2" type="float" minvalue="0" maxvalue="1" default="0.75">
                <tr lang="en">input diffusion factor 2</tr>
            </property>
            <!-- @predelay -->
            <property name="@predelay" type="float" minvalue="0" maxvalue="100" default="40"
            units="millisecond">
                <tr lang="en">a delay operating on the 'wet' signal. Large values will provide the
                impression of a larger room</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">reset reverb</method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>left channel</xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo>right channel</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output left</outlet>
            <outlet type="audio">output right</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env #a]
|
|            [ui.knob]   [ui.knob]  [ui.knob]
|            |           |          |
[readsf~ #b] |           |          |
|            |           |          |
|            [@decay $1( [@damp $1( [@drywet $1(
|            |           |          |
|            |           |          | [T]
|            |           |          | |
|            |           |          | [@bypass $1(
|            |           |          | |
[fx.dattorro~  0.5                    ]
|
[ui.gain~ @size 120 16] [ui.dsp~]
| \
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
