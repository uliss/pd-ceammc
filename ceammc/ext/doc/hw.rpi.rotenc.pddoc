<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.rotenc">
    <title>hw.rpi.rotenc</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">rotary encoder for Raspberry Pi</tr>
        <tr lang="ru">поворотный энкодер для Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>display gpio raspberry rotary encoder</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par style="important">
        <tr lang="en">When created, the object takes exclusive ownership of the GPIO pins @btn,
        @clk and @dt — it is *impossible* to use them in other objects simultaneously with this
        one.</tr>
        <tr lang="ru">При создании объект забирает в эксклюзивное владение контакты GPIO @btn,
        @clk и @dt — использовать их в других объектах одновременно с этим *невозможно*.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Hardware parameter control — using a physical rotary encoder to adjust
        values in a patch (volume, filter cutoff, tempo, preset number) with a natural
        continuous-rotation feel and press-button confirmation.</tr>
        <tr lang="ru">• Управление параметрами с аппаратного энкодера — использование физического
        поворотного энкодера для настройки значений в патче (громкость, срез фильтра, темп,
        номер пресета) с естественным «бесконечным» вращением и подтверждением нажатием
        кнопки.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Standalone instruments and installations — building a self-contained
        Raspberry Pi device where the encoder serves as the main control element for menus,
        navigation or parameter editing, without needing a keyboard or mouse.</tr>
        <tr lang="ru">• Автономные инструменты и инсталляции — сборка самостоятельного устройства
        на Raspberry Pi, где энкодер служит основным элементом управления для меню, навигации или
        редактирования параметров, без клавиатуры и мыши.</tr>
      </par>
    </info>
    <properties>
      <!-- @btn -->
      <property name="@btn" type="int" default="-1" access="initonly" minvalue="-1" maxvalue="127">
        <tr lang="en">BTN GPIO pin</tr>
        <tr lang="ru">контакт GPIO BTN</tr>
      </property>
      <!-- @clk -->
      <property name="@clk" type="int" default="-1" access="initonly" minvalue="-1" maxvalue="127">
        <tr lang="en">CLK GPIO pin</tr>
        <tr lang="ru">контакт GPIO CLK</tr>
      </property>
      <!-- @connect -->
      <property name="@connect" type="bool" default="0" access="readwrite">
        <tr lang="en">When set to 1: tries to connect to the device. When set to 0: disconnects
        from the device.</tr>
        <tr lang="ru">при значении 1: пытается подключиться к устройству. При значении 0:
        отключается от устройства</tr>
      </property>
      <!-- @dt -->
      <property name="@dt" type="int" default="-1" access="initonly" minvalue="-1" maxvalue="127">
        <tr lang="en">DT GPIO pin</tr>
        <tr lang="ru">контакт GPIO DT</tr>
      </property>
      <!-- @init -->
      <property name="@init" type="float" default="0" access="initonly">
        <tr lang="en">initial encoder value</tr>
        <tr lang="ru">начальное значение энкодера</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="float" default="100">
        <tr lang="en">maximum encoder value</tr>
        <tr lang="ru">максимальное значение энкодера</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="float" default="-100">
        <tr lang="en">minimum encoder value</tr>
        <tr lang="ru">минимальное значение энкодера</tr>
      </property>
      <!-- @step -->
      <property name="@step" type="float" default="1">
        <tr lang="en">encoder step</tr>
        <tr lang="ru">шаг энкодера</tr>
      </property>
    </properties>
    <methods>
      <!-- get -->
      <method name="get">
        <info>
          <tr lang="en">requests the current value to be output</tr>
          <tr lang="ru">запрашивает вывод текущего значения</tr>
        </info>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the current value to @init</tr>
          <tr lang="ru">сбрасывает текущее значение на @init</tr>
        </info>
      </method>
      <!-- set -->
      <method name="set">
        <info>
          <tr lang="en">sets the current value without output</tr>
          <tr lang="ru">устанавливает новое текущее значение без его вывода</tr>
        </info>
        <param name="VAL" type="float" required="true">
          <tr lang="en">new value</tr>
          <tr lang="ru">новое значение</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the current value</tr>
          <tr lang="ru">выводит текущее значение</tr>
        </in>
        <in on="float">
          <tr lang="en">sets the current value and outputs it</tr>
          <tr lang="ru">устанавливает новое текущее значение и выводит его</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">resets the value to @init</tr>
          <tr lang="ru">сбрасывает значение на @init</tr>
        </in>
        <in on="float">
          <tr lang="en">sets the current value without output</tr>
          <tr lang="ru">устанавливает новое текущее значение без его вывода</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">current encoder value</tr>
          <tr lang="ru">текущее значение энкодера</tr>
        </out>
      </outlet>
      <outlet>
        <out name="dir" type="any">
          <tr lang="en">rotation direction: -1 or 1</tr>
          <tr lang="ru">направление вращения: -1 или 1</tr>
        </out>
        <out name="btn" type="any">
          <tr lang="en">button state: 0 or 1</tr>
          <tr lang="ru">состояние кнопки: 0 или 1</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[@connect $1(
|
| [@step 0.5 #a(
|
|  [B]  [set 50( [reset(
|  |    |        |
[hw.rpi.rotenc @dt 22 @clk 23 @btn 27 #x]
|                         ^|
|                         [route btn dir ]
|                         |             ^|
[F digit=4]               [T]          [F]


[ui.link @url=ceammc://img/conn_rotenc.png @title='Connection_scheme']
[X a->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
