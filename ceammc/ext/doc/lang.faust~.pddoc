<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="lang.faust~" type="gui">
        <title>lang.faust~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">real-time compilation of Faust DSP Language code</tr>
                <tr lang="ru">компиляция кода Faust DSP Language в реальном времени</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">lang</category>
            <keywords>faust</keywords>
            <since>0.9.2</since>
        </meta>
        <info>
            <a href="https://faust.grame.fr/">https://faust.grame.fr/</a>
        </info>
        <mouse>
            <event type="left-click" editmode="0" keys="Alt">open Faust code editor</event>
        </mouse>
        <arguments>
            <argument name="LOAD" type="symbol">
                <tr lang="en">initial file to load after object creation</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @active -->
            <property name="@active" type="bool" default="1">
                <tr lang="en">on/off dsp processing</tr>
            </property>
            <!-- @include -->
            <property name="@include" type="list" default="">
                <tr lang="en">list of faust include directories</tr>
            </property>
            <!-- @load -->
            <property name="@load" type="symbol" default="" access="initonly">
                <tr lang="en">initial file to load after object creation</tr>
            </property>
        </properties>
        <methods>
            <!-- open -->
            <method name="open">
                <info>
                    <tr lang="en">open editor window</tr>
                </info>
            </method>
            <!-- read -->
            <method name="read">
                <info>
                    <tr lang="en">read Faust code from file and compile it.</tr>
                </info>
                <param name="FILE" type="symbol" required="true">
                    <tr lang="en">file path, absolute or relative to patch, include
                    directories</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset object state</tr>
                </info>
            </method>
            <!-- write -->
            <method name="write">
                <info>
                    <tr lang="en">write Faust code to file.</tr>
                </info>
                <param name="FILE" type="symbol" required="true">
                    <tr lang="en">file path, absolute or relative to patch</tr>
                </param>
                <param name="@force" type="property" required="false">
                    <tr lang="en">overwrite existing files</tr>
                </param>
            </method>
        </methods>
        <inlets dynamic="true">
            <inlet number="1">
                <xinfo>control input</xinfo>
            </inlet>
            <inlet type="audio" number="2">
                <xinfo>first faust input</xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>... faust input</xinfo>
            </inlet>
            <inlet type="audio" number="n+1">
                <xinfo>n-th faust input</xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio" number="1">first faust output</outlet>
            <outlet type="audio" number="...">... faust output</outlet>
            <outlet type="audio" number="n">n-th faust output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open(  [ui.knob #x] [ui.knob #y]
|       |            |
|       |            |
|       [@amp $1 #a( [@freq $1 #f(
|
| [read faust/ex2.dsp(   [osc.square~ 300]
| |                      |
| |                      |
| |                      |.
[lang.faust~ faust/ex0.dsp #z]
|
[ui.hgain~]       [ui.dsp~]
|\
[dac~]
[X a->z]
[X f->z]
#x @min 0 @max 0.5
#y @min 0 @max 10
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
