<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="lang.faust~" type="gui">
    <title>lang.faust~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">real-time compilation of Faust DSP Language code</tr>
        <tr lang="ru">компиляция кода на языке Faust DSP в реальном времени</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">lang</category>
      <keywords>faust</keywords>
      <since>0.9.2</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Compiles Faust DSP code on the fly and turns it into a Pd audio object. Faust
        is a functional programming language for real-time signal processing, developed by GRAME.
        See the official website for the language reference and examples.</tr>
        <tr lang="ru">Компилирует код Faust DSP «на лету» и превращает его в аудиообъект Pd. Faust
        — это функциональный язык программирования для обработки сигналов в реальном времени,
        разработанный GRAME. Справочник по языку и примеры — на официальном сайте.</tr>
      </par>
      <a href="https://faust.grame.fr/">https://faust.grame.fr/</a>
    </info>
    <mouse>
      <event type="left-click" editmode="0" keys="Alt">open Faust code editor</event>
    </mouse>
    <arguments>
      <argument name="LOAD" type="symbol">
        <tr lang="en">initial file to load after object creation</tr>
        <tr lang="ru">исходный файл для загрузки после создания объекта</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @active -->
      <property name="@active" type="bool" default="1">
        <tr lang="en">turns DSP processing on or off</tr>
        <tr lang="ru">включает или выключает обработку DSP</tr>
      </property>
      <!-- @include -->
      <property name="@include" type="list" default="">
        <tr lang="en">list of Faust include directories</tr>
        <tr lang="ru">список каталогов подключаемых файлов Faust</tr>
      </property>
      <!-- @load -->
      <property name="@load" type="symbol" default="" access="initonly">
        <tr lang="en">initial file to load after object creation</tr>
        <tr lang="ru">исходный файл для загрузки после создания объекта</tr>
      </property>
    </properties>
    <methods>
      <!-- open -->
      <method name="open">
        <info>
          <tr lang="en">opens the editor window</tr>
          <tr lang="ru">открывает окно редактора</tr>
        </info>
      </method>
      <!-- read -->
      <method name="read">
        <info>
          <tr lang="en">reads Faust code from a file and compiles it</tr>
          <tr lang="ru">читает код Faust из файла и компилирует его</tr>
        </info>
        <param name="FILE" type="symbol" required="true">
          <tr lang="en">file path, absolute or relative to the patch, with include directories</tr>
          <tr lang="ru">путь к файлу, абсолютный или относительный к патчу, с каталогами
          подключаемых файлов</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the object state</tr>
          <tr lang="ru">сбрасывает состояние объекта</tr>
        </info>
      </method>
      <!-- write -->
      <method name="write">
        <info>
          <tr lang="en">writes the Faust code to a file</tr>
          <tr lang="ru">записывает код Faust в файл</tr>
        </info>
        <param name="FILE" type="symbol" required="true">
          <tr lang="en">file path, absolute or relative to the patch</tr>
          <tr lang="ru">путь к файлу, абсолютный или относительный к патчу</tr>
        </param>
        <param name="@force" type="property" required="false">
          <tr lang="en">overwrite existing files</tr>
          <tr lang="ru">перезаписывать существующие файлы</tr>
        </param>
      </method>
    </methods>
    <inlets dynamic="true">
      <inlet number="1">
        <in>
          <tr lang="en">control input</tr>
          <tr lang="ru">вход управления</tr>
        </in>
      </inlet>
      <inlet type="audio" number="2">
        <in>
          <tr lang="en">first Faust input</tr>
          <tr lang="ru">первый вход Faust</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... Faust input</tr>
          <tr lang="ru">... вход Faust</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n+1">
        <in>
          <tr lang="en">n-th Faust input</tr>
          <tr lang="ru">n-й вход Faust</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet type="audio" number="1">
        <out type="any">
          <tr lang="en">first Faust output</tr>
          <tr lang="ru">первый выход Faust</tr>
        </out>
      </outlet>
      <outlet type="audio" number="...">
        <out type="any">
          <tr lang="en">... Faust output</tr>
          <tr lang="ru">... выход Faust</tr>
        </out>
      </outlet>
      <outlet type="audio" number="n">
        <out type="any">
          <tr lang="en">n-th Faust output</tr>
          <tr lang="ru">n-й выход Faust</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[open(  [ui.knob #x] [ui.knob #y]
|       |            |
|       |            |
|       [@amp $1 #a( [@freq $1 #f(
|
| [read faust/ex2.dsp(   [osc.square~ 300]
| |                      |
| |                      |
| |                      |.
[lang.faust~ faust/ex0.dsp #z]
|
[ui.hgain~]       [ui.dsp~]
|\
[dac~]
[X a->z]
[X f->z]
#x @min 0 @max 0.5
#y @min 0 @max 10
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
