<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.pipe">
    <title>flow.pipe</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">enhanced version of the vanilla [pipe] object</tr>
        <tr lang="ru">расширенная версия стандартного объекта [pipe]</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow pipe</keywords>
      <since>0.9.1</since>
      <also>
        <see>flow.delay</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">acts like the vanilla [pipe] but for any messages: bangs, floats, symbols etc.</tr>
        <tr lang="ru">работает как стандартный [pipe], но для любых сообщений: bang, чисел, символов и т.д.</tr>
      </par>
      <par>
        <tr lang="en">the object delays the incoming messages by @delay milliseconds</tr>
        <tr lang="ru">объект задерживает входящие сообщения на @delay миллисекунд</tr>
      </par>
      <par>
        <tr lang="en">note: @delay property can be set only via the right inlet or the [prop.set] object</tr>
        <tr lang="ru">примечание: свойство @delay можно задать только через правый вход или объект [prop.set]</tr>
      </par>
    </info>
    <arguments>
      <argument name="DELAY" type="float" minvalue="0" units="millisecond">
        <tr lang="en">initial @delay value</tr>
        <tr lang="ru">начальное значение @delay</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @delay -->
      <property name="@delay" type="float" minvalue="0" default="0" units="millisecond">
        <tr lang="en">delay time</tr>
        <tr lang="ru">время задержки</tr>
      </property>
      <!-- @empty -->
      <property name="@empty" type="bool" default="1" access="readonly">
        <tr lang="en">1 if buffer is empty, otherwise 0</tr>
        <tr lang="ru">1, если буфер пуст, иначе 0</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="int" default="0" access="readonly">
        <tr lang="en">buffer size</tr>
        <tr lang="ru">размер буфера</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">incoming message</tr>
          <tr lang="ru">входящее сообщение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">clear buffer</tr>
          <tr lang="ru">очистить буфер</tr>
        </in>
        <in>
          <tr lang="en">reset: clear buffer</tr>
          <tr lang="ru">reset: очистить буфер</tr>
        </in>
        <in>
          <tr lang="en">flush: output and clear</tr>
          <tr lang="ru">flush: вывести и очистить</tr>
        </in>
        <in on="float" minvalue="0">
          <tr lang="en">set delay time</tr>
          <tr lang="ru">задать время задержки</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">buffer output</tr>
          <tr lang="ru">выход буфера</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii id="main">
<![CDATA[
[ui.keyboard]
| |
| |
| |
| |
| [flow.pipe 1000]
| |
[poly 3    ]
| ^|. ^^|..
[pack f f f]
|
[clone -s 1 flow.pipe-osc~ 3 {i=1,o=1}]
|
[ui.hgain~]    [ui.dsp~]
|\
[dac~]

[flow.pipe-superdirt]
]]>
      </pdascii>
      <pdascii id="osc~">
<![CDATA[
[inlet]
|
[unpack f f]
|       ^|
[mtof]  [> 0]
|       |
[osc~]  [$1 50(
|       |
|       [line~]
|       |.
[*~      ]
|
[outlet~]
]]>
      </pdascii>
      <pdascii id="superdirt">
<![CDATA[
/* start SuperCollider SuperDirt synth first */

[T]
|
[metro 300]
|
[choose(      [append moog( [append hh:4( [pop(
|             |             |             |
[mlist ((bd pan 0) (sn pan 0.5) (bd speed 5 pan 1))]
|
[data.list]
|
[list.prepend sound]   [F]
|  |                   |.
|  [flow.pipe @delay 180 {w=27}]
|  |
[oscformat play2 {i=1,o=1}]
|
[msg send]  [connect localhost 57120(
|           |
[netsend -u -b]
|
[T]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
