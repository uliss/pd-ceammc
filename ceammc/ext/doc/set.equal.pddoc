<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="set.equal">
    <title>set.equal</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">checks if two sets are equal (contains same elements)</tr>
        <tr lang="ru">проверяет, равны ли два множества (содержат одинаковые элементы)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data equal set</keywords>
      <since>0.3</since>
      <also>
        <see>data.set</see>
      </also>
    </meta>
    <arguments>
      <argument name="SUBJ" type="list">
        <tr lang="en">right set elements</tr>
        <tr lang="ru" finished="false">Правильный набор элементов</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @subj -->
      <property name="@subj" type="list" default="Set()">
        <tr lang="en">right set elements of data:Set</tr>
        <tr lang="ru" finished="false">Правильный набор элементов данных:Set</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">set or list, other values are ignored.</tr>
          <tr lang="ru" finished="false">Набор или список, другие ценности игнорируются.</tr>
        </in>
      </inlet>
      <inlet>
        <in on="list">
          <tr lang="en">set right set elements</tr>
          <tr lang="ru" finished="false">Настройка правильного набора элементов</tr>
        </in>
        <in on="data:set">
          <tr lang="en">set right set</tr>
          <tr lang="ru" finished="false">Установить правильно</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output 1 if sets are equal, 0 otherwise</tr>
          <tr lang="ru" finished="false">выход 1 если множества равны, 0 иначе</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]              [B]
|                |
[data.set 1 3 5] [data.set 1 3] [1 3 5( [1 2 3(
|                |              |       |
|                |              |       |
|                |              |       |
[set.equal 1 3 5                        ]
|
[T]

[set.equal-data]
]]>
      </pdascii>
      <pdascii id="data">
<![CDATA[
[B]              [B]              [B]
|                |                |
[data.set 1 3 5] [data.set 2 4 6] [data.set 2 4 6]
|                |                |
|                |                |
|                |                |.
[set.equal Set(1 3 5)              ]
|
[T]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
