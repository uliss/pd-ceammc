<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="set.equal">
        <title>set.equal</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks if two sets are equal (contains same elements)</tr>
                <tr lang="ru">проверяет, равны ли два множества (содержат одинаковые элементы)</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data equal set</keywords>
            <since>0.3</since>
            <also>
                <see>data.set</see>
            </also>
        </meta>
        <arguments>
            <argument name="SUBJ" type="list">
                <tr lang="en">right set elements</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @subj -->
            <property name="@subj" type="list" default="Set()">
                <tr lang="en">right set elements of data:Set</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">set or list, other values are ignored.</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">set right set elements</tr>
                </xinfo>
                <xinfo on="data:set">
                    <tr lang="en">set right set</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output 1 if sets are equal, 0 otherwise</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]              [B]
|                |
[data.set 1 3 5] [data.set 1 3] [1 3 5( [1 2 3(
|                |              |       |
|                |              |       |
|                |              |       |
[set.equal 1 3 5                        ]
|
[T]

[set.equal-data]
]]>
            </pdascii>
            <pdascii id="data">
<![CDATA[
[B]              [B]              [B]
|                |                |
[data.set 1 3 5] [data.set 2 4 6] [data.set 2 4 6]
|                |                |
|                |                |
|                |                |.
[set.equal Set(1 3 5)              ]
|
[T]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
