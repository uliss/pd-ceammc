<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="set.equal">
    <title>set.equal</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">checks if two sets are equal (contain the same elements)</tr>
        <tr lang="ru">проверяет, равны ли два множества (содержат одни и те же элементы)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data equal set</keywords>
      <since>0.3</since>
      <also>
        <see>data.set</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Compares the two incoming sets (or lists converted to sets) and outputs 1 if
        they contain exactly the same elements, and 0 otherwise. The order of elements does not
        matter.</tr>
        <tr lang="ru">Сравнивает два входящих множества (или списка, преобразованных во множества)
        и выводит 1, если они содержат ровно одни и те же элементы, и 0 в противном случае.
        Порядок элементов не важен.</tr>
      </par>
    </info>
    <arguments>
      <argument name="SUBJ" type="list">
        <tr lang="en">elements of the right set</tr>
        <tr lang="ru">элементы правого множества</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @subj -->
      <property name="@subj" type="list" default="Set()">
        <tr lang="en">elements of the right set as data:Set</tr>
        <tr lang="ru">элементы правого множества в виде data:Set</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">set or list; other values are ignored</tr>
          <tr lang="ru">множество или список; остальные значения игнорируются</tr>
        </in>
      </inlet>
      <inlet>
        <in on="list">
          <tr lang="en">sets the right set elements</tr>
          <tr lang="ru">задаёт элементы правого множества</tr>
        </in>
        <in on="data:set">
          <tr lang="en">sets the right set</tr>
          <tr lang="ru">задаёт правое множество</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">outputs 1 if the sets are equal, 0 otherwise</tr>
          <tr lang="ru">выводит 1, если множества равны, иначе 0</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]              [B]
|                |
[data.set 1 3 5] [data.set 1 3] [1 3 5( [1 2 3(
|                |              |       |
|                |              |       |
|                |              |       |
[set.equal 1 3 5                        ]
|
[T]

[set.equal-data]
]]>
      </pdascii>
      <pdascii id="data">
<![CDATA[
[B]              [B]              [B]
|                |                |
[data.set 1 3 5] [data.set 2 4 6] [data.set 2 4 6]
|                |                |
|                |                |
|                |                |.
[set.equal Set(1 3 5)              ]
|
[T]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
