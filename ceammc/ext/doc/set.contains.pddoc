<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="set.contains">
        <title>set.contains</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks whether the predefined element is present in the input
                set</tr>
                <tr lang="ru">проверяет, присутстует ли предварительно заданный элемент во входном
                множестве</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data predicate contains</keywords>
            <since>0.3</since>
            <also>
                <see>data.set</see>
            </also>
        </meta>
        <arguments>
            <argument name="SUBJ" type="atom">
                <tr lang="en">searched element</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @subj -->
            <property name="@subj" type="atom" default="null">
                <tr lang="en">searched element</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">input set. Other values are ignored</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="atom">
                    <tr lang="en">set searched element</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">1 if element exists in set, otherwise 0</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[data.set 1 2 3 4]
|
|           [F]
|           |.
[set.contains 2]
|
[T]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
