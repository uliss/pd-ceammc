<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="qrcode">
    <title>qrcode</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">QR code generator</tr>
        <tr lang="ru">генератор QR кода</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>misc</category>
      <keywords>qrcode</keywords>
      <since>0.9.7</since>
      <aliases>
        <alias>ceammc/qrcode</alias>
      </aliases>
    </meta>
    <arguments>
      <argument name="VALUE" type="symbol">
        <tr lang="en">initial string value</tr>
        <tr lang="ru" finished="false">начальное значение строки</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @high -->
      <property name="@high" type="alias">
        <tr lang="en">alias to @quality high</tr>
        <tr lang="ru" finished="false">Исполнитель: @quality high</tr>
      </property>
      <!-- @low -->
      <property name="@low" type="alias">
        <tr lang="en">alias to @quality low</tr>
        <tr lang="ru" finished="false">Оригинальное название: Quality Low</tr>
      </property>
      <!-- @medium -->
      <property name="@medium" type="alias">
        <tr lang="en">alias to @quality medium</tr>
        <tr lang="ru" finished="false">Источник: @quality medium</tr>
      </property>
      <!-- @quality -->
      <property name="@quality" type="symbol" enum="low medium quartile high" default="low">
        <tr lang="en">encoding quality</tr>
        <tr lang="ru" finished="false">качество кодирования</tr>
      </property>
      <!-- @quartile -->
      <property name="@quartile" type="alias">
        <tr lang="en">alias to @quality quartile</tr>
        <tr lang="ru" finished="false">Исполнитель: @quality quartile</tr>
      </property>
      <!-- @value -->
      <property name="@value" type="symbol" default="">
        <tr lang="en">string value</tr>
        <tr lang="ru" finished="false">струнное значение</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output encoded data</tr>
          <tr lang="ru" finished="false">выходные кодированные данные</tr>
        </in>
        <in on="symbol">
          <tr lang="en">set new value and output encoded data</tr>
          <tr lang="ru" finished="false">установить новое значение и вывести закодированные
          данные</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">list of 1 and 0</tr>
          <tr lang="ru" finished="false">Список 1 и 0</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">int: qr code size</tr>
          <tr lang="ru" finished="false">Int: размер кода qr</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[S digits=15 #a]

[symbol https://github.com/uliss/pure-data/releases(
|
[qrcode #x]                            [ui.lcd @receive qrcode @size 125 125 @nosave 1]
|      ^|
|     [@cols $1, @rows $1, @size 125 125(
|                |
[msg set list]   |
|                |
[s         qrcode]

[X a->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
