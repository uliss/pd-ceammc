<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="dict.get">
    <title>dict.get</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">output the dictionary values by a pre-defined key list</tr>
        <tr lang="ru">выводит значения словаря по заранее заданному списку ключей</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>get dictionary</keywords>
      <since>0.6</since>
      <also>
        <see>data.dict</see>
        <see>flow.route</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">You can use path-like expressions to access nested keys: /x/y/foo.</tr>
        <tr lang="ru">Для доступа к вложенным ключам можно использовать выражения в стиле пути:
        /x/y/foo.</tr>
      </par>
    </info>
    <arguments>
      <argument name="KEYS" type="list">
        <tr lang="en">list of keys whose values should be extracted from the dictionary. Each key
        corresponds to one outlet, so the number of outlets equals the number of keys</tr>
        <tr lang="ru">список ключей, значения которых нужно извлечь из словаря. Каждому ключу
        соответствует отдельный выход, поэтому число выходов равно числу ключей</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @default -->
      <property name="@default" type="atom" default="null">
        <tr lang="en">default value returned when the key is not found in the dictionary. If not
        specified, no output is performed for missing keys</tr>
        <tr lang="ru">значение по умолчанию, возвращаемое, когда ключ не найден в словаре. Если не
        указано, для отсутствующих ключей вывод не выполняется</tr>
      </property>
      <!-- @keys -->
      <property name="@keys" type="list" access="initonly" default="">
        <tr lang="en">extracted keys</tr>
        <tr lang="ru">извлекаемые ключи</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="data:dict">
          <tr lang="en">input dictionary. When received, the object extracts values for all
          pre-defined keys and outputs them through the corresponding outlets</tr>
          <tr lang="ru">входной словарь. При получении объект извлекает значения для всех заданных
          ключей и выводит их через соответствующие выходы</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="any">
          <tr lang="en">value for the first key</tr>
          <tr lang="ru">значение для первого ключа</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="any">
          <tr lang="en">value for the next key</tr>
          <tr lang="ru">значение для следующего ключа</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="any">
          <tr lang="en">value for the n-th key</tr>
          <tr lang="ru">значение для n-го ключа</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[\[a: b @prop: val 1: 100\], bang(
|
|
|
[data.dict]
|
[dict.get "@prop" "1" a /*]
|     ^|    ^^|   ^^^|
|      |      |      |
|      |      |      |
[S]    [F]    [S]    [ui.dt]


[dict.get-paths]
]]>
      </pdascii>
      <pdascii id="paths">
<![CDATA[
[\[users: [name: Alice age: 23 levels: 1 2 3 4] [name: Bob age: 25 levels: 1 2 3]], bang(
|
|
|
[data.dict]
|
[dict.get /users/*/name /users/*/age /users/*/levels/2:3 #z]
|
[print NAMES #a]

            [print AGE #b]

                        [print LEVELS #c]

[X z:0->a] [X z:1->b] [X z:2->c]

/*path segment can be:*/

    /* * - match to all dict keys or all list elements*/

    /* key - match to the dict key*/

    /* POS - match to the element in the list at specified position*/

    /* POS: - match to the elements in the list from specified position until the end of the list*/


    /* POS:LENGTH - match to the number of elements in the list from specified position*/
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
