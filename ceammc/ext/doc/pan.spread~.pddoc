<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="pan.spread~">
        <title>pan.spread~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">spreads input channels across the stereo field</tr>
                <tr lang="ru">распределяет входные каналы по стереополю</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>pan spread</keywords>
            <since>0.5</since>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="2" maxvalue="16">
                <tr lang="en">number of input channels</tr>
                <tr lang="ru" finished="false">Количество входных каналов</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @center -->
            <property name="@center" type="float" minvalue="-0.5" maxvalue="0.5" default="0">
                <tr lang="en">shift the centre of the distribution</tr>
                <tr lang="ru" finished="false">Смещение центра распределения</tr>
            </property>
            <!-- @coeffs -->
            <property name="@coeffs" type="list" access="readonly" default="">
                <tr lang="en">list of gain pairs</tr>
                <tr lang="ru" finished="false">Список пар усиления</tr>
            </property>
            <!-- @compensate -->
            <property name="@compensate" type="bool" default="0">
                <tr lang="en">compensate output level: divide amplitude to number of input
                channels</tr>
                <!-- old: компенсировать выходной уровень: разделить амплитуду
                на количество входных каналов -->
                <tr lang="ru" finished="false">компенсировать выходной уровень: разделить амплитуду
                на количество входных каналов</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" minvalue="2" maxvalue="16" default="2"
            access="initonly">
                <tr lang="en">number of input channels</tr>
                <tr lang="ru" finished="false">Количество входных каналов</tr>
            </property>
            <!-- @spread -->
            <property name="@spread" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">for @spread = 0, all channels are in the centre, for 1, they have
                maximum distribution</tr>
                <!-- old: для @spread = 0, все каналы находятся в центре, для
                1, они имеют максимальное распределение -->
                <tr lang="ru" finished="false">для @spread = 0, все каналы находятся в центре, для
                1, они имеют максимальное распределение</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet type="audio" number="1">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="n">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">left output channel</tr>
                    <tr lang="ru" finished="false">левый выходной канал</tr>
                </out>
            </outlet>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">right output channel</tr>
                    <tr lang="ru" finished="false">правильный выходной канал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 160]
|
[flow.count]
|
[% 4]
|
[sel 0 1 2 3                      ]
|        ^|       ^^|      ^^^|
[click~] [click~] [click~] [click~]
|        |        |        |
|        |        |        [flt.resonbp~ 1600 30 #d]
|        |        |
|        |        [flt.resonbp~ 1200 40 #c]
|        |
|        [flt.resonbp~ 800 40 #b]
|
[flt.resonbp~ 500 60 #a]

                      [@spread 0( [@spread 1(
                      |           |
[pan.spread~                     4 #e]
| ^|.
[dac~]

[X a->e:0] [X b->e:1] [X c->e:2] [X d->e:3]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
