<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="fx.freqshift~">
        <title>fx.freqshift~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">frequency shifter or the single-sideband ring modulation</tr>
                <tr lang="ru">сдвиг частоты или однополосный кольцевой модулятор</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx freqshift</keywords>
            <since>0.1</since>
        </meta>
        <properties>
            <xi:include href="props_active.xml" />
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset object</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo minvalue="-10000" maxvalue="10000">
                    <tr lang="en">frequency shift in Hertz</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal (freq + shift)</outlet>
            <outlet type="audio">output signal (freq - shift)</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[osc.tri~ 440] [F]   /* frequency shift */
|              |
|              [sig~]
|              |
|              [lop~ 10]
|              |.
[fx.freqshift~   ]
|
[ui.gain~ @size 120 16]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
