<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hoa.2d.wider~">
    <title>hoa.2d.wider~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
        <author>Pierre Guillot</author>
        <author>Eliott Paris</author>
        <author>Thomas Le Meur</author>
      </authors>
      <description>
        <tr lang="en">a 2D fractional ambisonic order simulator</tr>
        <tr lang="ru">симулятор дробного порядка амбисоников для 2D</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>spat</category>
      <keywords>hoa wider</keywords>
      <since>0.8</since>
      <aliases>
        <alias>hoa.wider~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">hoa.2d.wider~ can be used to widen the diffusion of a localized sound. The
        order-dependent signals are weighted and follow a logarithmic curve, so that changes in the
        widening parameter sound linear to the listener.</tr>
        <tr lang="ru">hoa.2d.wider~ позволяет расширить диффузию локализованного звука. Сигналы,
        зависящие от порядка гармоник, взвешиваются по логарифмической кривой, благодаря чему
        изменения параметра расширения воспринимаются на слух как линейные.</tr>
      </par>
      <a href="hoa/hoa.2d.wider~-help.pd">CICM documentation</a>
    </info>
    <arguments>
      <argument name="ORDER" type="int" minvalue="1" maxvalue="63">
        <tr lang="en">the order of decomposition</tr>
        <tr lang="ru">порядок декомпозиции</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @order -->
      <property name="@order" type="int" minvalue="1" maxvalue="63" default="1" access="initonly">
        <tr lang="en">the order of decomposition</tr>
        <tr lang="ru">порядок декомпозиции</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet type="audio">
        <in>
          <tr lang="en">first input signal</tr>
          <tr lang="ru">первый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... input signal</tr>
          <tr lang="ru">... входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">n-th input signal</tr>
          <tr lang="ru">n-й входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n+1">
        <in>
          <tr lang="en">widening signal in the [0, 1] range</tr>
          <tr lang="ru">сигнал расширения в диапазоне [0, 1]</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet type="audio">
        <out type="any">
          <tr lang="en">first circular harmonics output</tr>
          <tr lang="ru">выход первой круговой гармоники</tr>
        </out>
      </outlet>
      <outlet type="audio" number="...">
        <out type="any">
          <tr lang="en">... circular harmonics output</tr>
          <tr lang="ru">... выход круговой гармоники</tr>
        </out>
      </outlet>
      <outlet type="audio" number="n">
        <out type="any">
          <tr lang="en">n-th circular harmonics output</tr>
          <tr lang="ru">выход n-й круговой гармоники</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[lfo.square~ 1]
|
[ui.gain~ @size 120 14] [ui.knob #a]
|
[hoa.encoder~ 5 {w=24,i=11,o=11}]
*|*
[hoa.wider~ 5 {w=24,i=12,o=11} #b]
*|*
[hoa.scope~ @order 5 {i=11} @size 171 171]












[ui.dsp~]
[X a->b:11]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
