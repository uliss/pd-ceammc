<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.spi.max7219">
    <title>hw.rpi.spi.max7219</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">LED matrix driver based on the MAX7219 chip for Raspberry Pi</tr>
        <tr lang="ru">драйвер светодиодной матрицы на чипе MAX7219 для Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>led display max7219 spi rpi arduino</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Handles communication with the MAX7219 chip for 7-segment or 8×8 LED dot
        matrix displays. Each display can be connected in series with another and controlled via a
        single connection.</tr>
        <tr lang="ru">Обеспечивает связь с чипом MAX7219 для 7-сегментных или 8×8 светодиодных
        матричных дисплеев. Каждый дисплей может быть подключён последовательно с другим и
        управляться через одно соединение.</tr>
      </par>
      <par style="warning">
        <tr lang="en">Note: for LED dot matrix displays, only the write_bits and write_reg
        commands will work as expected.</tr>
        <tr lang="ru">Примечание: для светодиодной матрицы ожидаемым образом работают только
        команды write_bits и write_reg.</tr>
      </par>
      <par style="warning">
        <tr lang="en">Note: the 7-segment LED display supports only this character set:
        -_0123456789ABCDEFGHIJLOPSUbcdhnoqrtu</tr>
        <tr lang="ru">Примечание: 7-сегментный светодиодный дисплей поддерживает только следующий
        набор символов: -_0123456789ABCDEFGHIJLOPSUbcdhnoqrtu</tr>
      </par>
      <par>
        <tr lang="en">Note: if the device address argument is -1 or omitted, the requested action
        is applied to all devices in the chain.</tr>
        <tr lang="ru">Примечание: если аргумент адреса устройства равен -1 или не указан,
        запрашиваемое действие применяется ко всем устройствам в цепи.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Status display for a patch — showing tempo, mode, numeric values or short
        text on a 7-segment or matrix display, so that the state of the patch can be read without
        a computer screen.</tr>
        <tr lang="ru">• Индикация состояния патча — отображение темпа, режима, числовых значений
        или короткого текста на 7-сегментном или матричном дисплее, чтобы состояние патча можно
        было прочитать без экрана компьютера.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• LED matrix animations — drawing custom patterns, scrolling text or simple
        animations on the 8×8 matrix, for example to build a step sequencer display or a small
        visualizer.</tr>
        <tr lang="ru">• Анимации на светодиодной матрице — отрисовка пользовательских паттернов,
        бегущего текста или простых анимаций на матрице 8×8, например для отображения пошагового
        секвенсора или небольшого визуализатора.</tr>
      </par>
    </info>
    <arguments>
      <argument name="DISPLAYS" type="int" minvalue="1" maxvalue="4">
        <tr lang="en">the number of displays connected in a daisy chain</tr>
        <tr lang="ru">число дисплеев, подключённых по цепочке</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @displays -->
      <property name="@displays" type="int" default="1" minvalue="1" maxvalue="4"
      access="initonly">
        <tr lang="en">the number of displays connected in a daisy chain</tr>
        <tr lang="ru">число дисплеев, подключённых по цепочке</tr>
      </property>
      <!-- @spi_bus -->
      <property name="@spi_bus" type="int" minvalue="-1" maxvalue="6" default="-1"
      access="initonly">
        <tr lang="en">SPI bus number</tr>
        <tr lang="ru">номер шины SPI</tr>
      </property>
      <!-- @spi_cs -->
      <property name="@spi_cs" type="int" minvalue="0" maxvalue="3" default="0" access="initonly">
        <tr lang="en">CS (Chip Select, Slave Select, or Chip Enable) index</tr>
        <tr lang="ru">индекс CS (Chip Select, Slave Select или Chip Enable)</tr>
      </property>
    </properties>
    <methods>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clears the display</tr>
          <tr lang="ru">очищает дисплей</tr>
        </info>
        <param name="ADDR" type="int" minvalue="-1" maxvalue="7" default="0">
          <tr lang="en">display address in the chain</tr>
          <tr lang="ru">адрес дисплея в цепи</tr>
        </param>
      </method>
      <!-- intensity -->
      <method name="intensity">
        <info>
          <tr lang="en">sets the intensity level of the display</tr>
          <tr lang="ru">устанавливает уровень интенсивности дисплея</tr>
        </info>
        <param name="LEVEL" type="int" minvalue="0" maxvalue="15" required="true">
          <tr lang="en">intensity level</tr>
          <tr lang="ru">уровень интенсивности</tr>
        </param>
        <param name="ADDR" type="int" minvalue="-1" maxvalue="7" default="-1">
          <tr lang="en">target display address in the chain</tr>
          <tr lang="ru">адрес целевого дисплея в цепи</tr>
        </param>
      </method>
      <!-- power -->
      <method name="power">
        <info>
          <tr lang="en">turns the display on or off</tr>
          <tr lang="ru">включает или выключает дисплей</tr>
        </info>
        <param name="STATE" type="bool" required="true">
          <tr lang="en">on/off state</tr>
          <tr lang="ru">состояние вкл/выкл</tr>
        </param>
      </method>
      <!-- test -->
      <method name="test">
        <info>
          <tr lang="en">tests the display by turning all LEDs on</tr>
          <tr lang="ru">проверяет дисплей, включая все светодиоды</tr>
        </info>
        <param name="ADDR" type="int" minvalue="-1" maxvalue="7" default="-1">
          <tr lang="en">target display address in the chain</tr>
          <tr lang="ru">адрес целевого дисплея в цепи</tr>
        </param>
      </method>
      <!-- write bits -->
      <method name="write bits">
        <info>
          <tr lang="en">writes raw bits to the display</tr>
          <tr lang="ru">записывает низкоуровневые битовые данные в дисплей</tr>
        </info>
        <param name="ADDR" type="int" minvalue="-1" maxvalue="7" required="true" default="0">
          <tr lang="en">target display address in the chain</tr>
          <tr lang="ru">адрес целевого дисплея в цепи</tr>
        </param>
        <param name="BITS" type="list" required="true">
          <tr lang="en">list of bits. Maximum length: 256</tr>
          <tr lang="ru">список битов. Максимальная длина: 256</tr>
        </param>
      </method>
      <!-- write bytes -->
      <method name="write bytes">
        <info>
          <tr lang="en">writes raw bytes to the display</tr>
          <tr lang="ru">записывает низкоуровневые байты в дисплей</tr>
        </info>
        <param name="ADDR" type="int" minvalue="-1" maxvalue="7" required="true" default="0">
          <tr lang="en">target display address in the chain</tr>
          <tr lang="ru">адрес целевого дисплея в цепи</tr>
        </param>
        <param name="DATA" type="list" required="true">
          <tr lang="en">list of bytes. Maximum length: 8</tr>
          <tr lang="ru">список байтов. Максимальная длина: 8</tr>
        </param>
      </method>
      <!-- write float -->
      <method name="write float">
        <info>
          <tr lang="en">writes a float value to the 7-segment display (not supported for the LED
          matrix!)</tr>
          <tr lang="ru">выводит значение с плавающей точкой на 7-сегментный дисплей (не
          поддерживается для светодиодной матрицы!)</tr>
        </info>
        <param name="VAL" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
        <param name="PRECISION" type="int" minvalue="0" maxvalue="7">
          <tr lang="en">precision (digits after the decimal point)</tr>
          <tr lang="ru">точность (число знаков после запятой)</tr>
        </param>
        <param name="ADDR" type="int" minvalue="-1" maxvalue="7">
          <tr lang="en">display address in the chain. If omitted or -1: writes to all
          displays.</tr>
          <tr lang="ru">адрес дисплея в цепи. Если не указан или равен -1 — вывод на все
          дисплеи</tr>
        </param>
      </method>
      <!-- write hex -->
      <method name="write hex">
        <info>
          <tr lang="en">writes a hexadecimal unsigned integer value (7-segment display only!)</tr>
          <tr lang="ru">выводит шестнадцатеричное беззнаковое целое число (только для
          7-сегментного дисплея!)</tr>
        </info>
        <param name="INT" type="int" minvalue="0" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
        <param name="ADDR" type="int" minvalue="-1" maxvalue="7">
          <tr lang="en">display address in the chain. If omitted or -1: writes to all
          displays.</tr>
          <tr lang="ru">адрес дисплея в цепи. Если не указан или равен -1 — вывод на все
          дисплеи</tr>
        </param>
      </method>
      <!-- write int -->
      <method name="write int">
        <info>
          <tr lang="en">writes a signed integer value (7-segment display only!)</tr>
          <tr lang="ru">выводит знаковое целое значение (только для 7-сегментного дисплея!)</tr>
        </info>
        <param name="INT" type="int" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
        <param name="ADDR" type="int" minvalue="-1" maxvalue="7">
          <tr lang="en">display address in the chain. If omitted or -1: writes to all
          displays.</tr>
          <tr lang="ru">адрес дисплея в цепи. Если не указан или равен -1 — вывод на все
          дисплеи</tr>
        </param>
      </method>
      <!-- write reg -->
      <method name="write reg">
        <info>
          <tr lang="en">writes data to a MAX7219 register. The lowest level of communication.</tr>
          <tr lang="ru">записывает данные в регистр MAX7219. Самый низкоуровневый способ
          связи.</tr>
        </info>
        <param name="REG" type="int" minvalue="0" maxvalue="15" required="true">
          <tr lang="en">MAX7219 register index</tr>
          <tr lang="ru">индекс регистра MAX7219</tr>
        </param>
        <param name="DATA" type="int" minvalue="0" maxvalue="255" required="true">
          <tr lang="en">register value</tr>
          <tr lang="ru">значение регистра</tr>
        </param>
        <param name="ADDR" type="int" minvalue="-1" maxvalue="7" default="0">
          <tr lang="en">target display address in the chain</tr>
          <tr lang="ru">адрес целевого дисплея в цепи</tr>
        </param>
      </method>
      <!-- write str -->
      <method name="write str">
        <info>
          <tr lang="en">writes a string (7-segment display only!)</tr>
          <tr lang="ru">выводит строку (только для 7-сегментного дисплея!)</tr>
        </info>
        <param name="STR" type="symbol" required="true">
          <tr lang="en">string. Maximum length: 8 characters</tr>
          <tr lang="ru">строка. Максимальная длина: 8 символов</tr>
        </param>
        <param name="DOTS" type="int" minvalue="0" maxvalue="255">
          <tr lang="en">dots as a bit value. For example: 0b00000011 turns on the two leftmost
          dots.</tr>
          <tr lang="ru">точки в виде битового значения. Например: 0b00000011 включает две крайние
          левые точки.</tr>
        </param>
        <param name="ALIGN" type="symbol" enum="left center right" default="right">
          <tr lang="en">string alignment</tr>
          <tr lang="ru">выравнивание строки</tr>
        </param>
        <param name="ADDR" type="int" minvalue="-1" maxvalue="7" default="0">
          <tr lang="en">display address in the chain</tr>
          <tr lang="ru">адрес дисплея в цепи</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control input</tr>
          <tr lang="ru">вход управляющих сообщений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets />
    <example>
      <pdascii>
<![CDATA[
[T]                                 [get matrix(
|                                   |
[@connect $1(                       [ui.matrix 8 8 #o]
|
| [T]           [write bytes -1 255 0 255 #g(
| |
| [power $1 #e( [write reg 2 15 0 #h(
|
| [T]
| |
| [test $1 #f 0( [F min=0 max=15]   [route matrix #p0]
|                |                  |
| [clear #a(     [intensity $1 #m(  [msg write matrix #p]
|
|                [font FONT_4x6, text 1 6 ЦЭАМ, get matrix(
|                |
|                [bitmap 32 8]
|                |
|                [msg write #q]
|
[hw.rpi.spi.max7219 4 #x]

[ui.link @url=ceammc://img/conn_max7219.png @title='Connection_Matrix']

[hw.rpi.spi.max7219-7segm]

[hw.rpi.spi.max7219-spi]
[X a->x] [X e->x] [X f->x]  [X g->x] [X h->x]
[X m->x] [X o->p0] [X p->x] [X q->x] [X r->x]
#x @spi_bus 0
]]>
      </pdascii>
      <pdascii id="7segm">
<![CDATA[
/*#7-segment display*/

[T]
|
[@connect $1 #r(   [T]            [T]
|                  |              |
| [F]              [power $1 #e(  [test $1 #f 0(
| |
| [write int $1 #b(
|
| [write float -10.25 3 #c(
|
| [write hex 355 #d(
|
| [write str DSP 0 left #j(      [F min=0 max=15]
|                                |
| [write str DSP 255 center #k(  [intensity $1 #m(
|
| [write str DSP 1 right #l(
|
| [clear #a(
|
[hw.rpi.spi.max7219 1 #x]

[ui.link @url=ceammc://img/conn_max7219b.png @title='Connection_Digits']

[X a->x] [X b->x] [X c->x] [X d->x] [X e->x] [X f->x]
[X m->x] [X r->x] [X j->x] [X k->x] [X l->x]
#x @spi_bus 0
]]>
      </pdascii>
      <pdascii id="spi">
<![CDATA[
/*SPI buses*/

/*The Raspberry Pi's GPIO header exposes several SPI buses. SPI0 is available on all Raspberry Pi models. SPI1 is available on models with a 40-pin header. SPI2 is only available on the Compute and Compute 3. SPI3 through SPI6 are only available on the Raspberry Pi 4B, 400 and 5.*/






    /*SPI0 is disabled by default. You can enable it by running sudo raspi-config, or by manually adding dtparam=spi=on to \/boot\/firmware\/config.txt.The associated pins are listed below:*/





        /*MOSI: BCM GPIO 10 (physical pin 19) SCLK: BCM GPIO 11 (physical pin 23) SS: Ss0 BCM GPIO 8 (physical pin 24), Ss1 BCM GPIO 7 (physical pin 26) */





    [ui.link @title=More_information @url="https://docs.rs/rppal/latest/rppal/spi/index.html"]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
