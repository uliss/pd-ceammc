<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.stretch">
    <title>array.stretch</title>
    <meta>
      <authors>
        <author>Olli Parviainen</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">the array time-stretch, pitch-shift or rate-change</tr>
        <tr lang="ru">растяжение во времени, изменение высоты тона или скорости у массива</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array stretch</keywords>
      <since>0.4</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Based on the SoundTouch library for changing the tempo, pitch and playback
        rate of arrays. Copies time-stretched data from the source array to the destination
        array.</tr>
        <tr lang="ru">Основано на библиотеке SoundTouch для изменения темпа, высоты тона и скорости
        воспроизведения массивов. Копирует растянутые во времени данные из исходного массива в
        массив назначения.</tr>
      </par>
    </info>
    <arguments>
      <argument name="SRC" type="symbol">
        <tr lang="en">name of the source array</tr>
        <tr lang="ru">имя исходного массива</tr>
      </argument>
      <argument name="DEST" type="symbol">
        <tr lang="en">name of the destination array</tr>
        <tr lang="ru">имя массива назначения</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @aalength -->
      <property name="@aalength" type="int" minvalue="8" maxvalue="128" default="64">
        <tr lang="en">pitch transposer anti-alias filter length</tr>
        <tr lang="ru">длина антиалиасингового фильтра транспонирования высоты тона</tr>
      </property>
      <!-- @antialias -->
      <property name="@antialias" type="bool" default="0">
        <tr lang="en">use of the anti-alias filter. The anti-alias filter is used to prevent
        folding of high frequencies when transposing the sample rate with interpolation.</tr>
        <tr lang="ru">использовать антиалиасинговый фильтр. Этот фильтр используется для
        предотвращения наложения высоких частот при транспонировании частоты семплирования с
        интерполяцией.</tr>
      </property>
      <!-- @dest -->
      <property name="@dest" type="symbol" default="">
        <tr lang="en">name of the destination array</tr>
        <tr lang="ru">имя массива назначения</tr>
      </property>
      <!-- @overlap -->
      <property name="@overlap" type="int" units="millisecond" minvalue="0" maxvalue="100"
      default="8">
        <tr lang="en">overlap length. When the chopped sound sequences are mixed back together to
        form a continuous sound stream, this parameter defines over how long a period the two
        consecutive sequences are allowed to overlap each other. Increasing this value increases
        the computational burden and vice versa.</tr>
        <tr lang="ru">длительность перекрытия. Когда отдельные небольшие куски звуковых
        последовательностей смешиваются вместе, образуя непрерывный звуковой поток, этот параметр
        определяет, в течение какого периода два последовательных фрагмента могут перекрывать друг
        друга. Увеличение этого значения увеличивает вычислительную нагрузку и наоборот.</tr>
      </property>
      <!-- @pitch -->
      <property name="@pitch" type="float" default="0" units="semitone">
        <tr lang="en">relative pitch change while keeping the original tempo</tr>
        <tr lang="ru">относительное изменение высоты тона при сохранении исходного темпа</tr>
      </property>
      <!-- @rate -->
      <property name="@rate" type="float" minvalue="0.1" maxvalue="2" default="1">
        <tr lang="en">playback rate — changes both tempo and pitch together, as if a vinyl disc
        were played at a different RPM</tr>
        <tr lang="ru">скорость воспроизведения — изменяет и темп, и высоту тона одновременно, как
        если бы виниловый диск воспроизводился с другой скоростью вращения</tr>
      </property>
      <!-- @seekwindow -->
      <property name="@seekwindow" type="int" units="millisecond" minvalue="0" maxvalue="100"
      default="0">
        <tr lang="en">seeking window default length for the algorithm that finds the best possible
        overlapping location. This determines how wide a window the algorithm may use to look for
        an optimal joining location when mixing the sound sequences back together. The bigger this
        window setting is, the higher the possibility of finding a better mixing position becomes,
        but at the same time large values may cause a "drifting" artifact because consecutive
        sequences will be taken at more uneven intervals. If there is a disturbing artifact that
        sounds as if a constant frequency were drifting around, try reducing this setting.
        Increasing this value increases the computational burden and vice versa. Setting the value
        to *0* for the seek window length makes the parameter automatic, based on the tempo setting
        (recommended).</tr>
        <tr lang="ru">длина окна поиска по умолчанию для алгоритма, который находит наилучшее
        положение перекрытия. Определяет, в насколько широком окне алгоритм может искать
        оптимальное место соединения при смешивании звуковых последовательностей вместе. Чем больше
        это окно, тем выше вероятность найти лучшее положение смешивания, но в то же время большие
        значения могут вызвать «дрейфующий» артефакт, потому что последующие последовательности
        будут браться через всё более неравные интервалы. Если есть нежелательный артефакт,
        звучащий так, как будто постоянная частота дрейфует, попробуйте уменьшить эту настройку.
        Увеличение этого значения увеличивает вычислительную нагрузку и наоборот. Установка
        значения *0* для длины окна поиска включает автоматический режим — параметр подбирается по
        настройке темпа (рекомендуется).</tr>
      </property>
      <!-- @sequence -->
      <property name="@sequence" type="int" units="millisecond" default="0" minvalue="0"
      maxvalue="100">
        <tr lang="en">default length of a single processing sequence, in milliseconds. This
        determines into how long sequences the original sound is chopped in the time-stretch
        algorithm. The larger this value is, the fewer sequences are used in processing. In
        principle, a bigger value sounds better when slowing down the tempo but worse when
        increasing the tempo and vice versa. Increasing this value reduces the computational burden
        and vice versa. Setting the value to *0* for the sequence length makes the parameter
        automatic, based on the tempo setting (recommended).</tr>
        <tr lang="ru">длина по умолчанию одной последовательности обработки в миллисекундах.
        Определяет, на последовательности какой длины разбивается исходный звук в алгоритме
        растяжения времени. Чем больше это значение, тем меньше последовательностей используется
        при обработке. В принципе, большее значение звучит лучше при замедлении темпа, но хуже при
        ускорении, и наоборот. Увеличение этого значения снижает вычислительную нагрузку и
        наоборот. Установка значения *0* для длины последовательности включает автоматический режим
        — параметр подбирается по настройке темпа (рекомендуется).</tr>
      </property>
      <!-- @speech -->
      <property name="@speech" type="bool" default="0">
        <tr lang="en">optimize for a speech sound source</tr>
        <tr lang="ru">оптимизация под речевой источник</tr>
      </property>
      <!-- @src -->
      <property name="@src" type="symbol" default="">
        <tr lang="en">name of the source array</tr>
        <tr lang="ru">имя исходного массива</tr>
      </property>
      <!-- @tempo -->
      <property name="@tempo" type="float" units="percent" minvalue="-50" maxvalue="100"
      default="0">
        <tr lang="en">relative tempo change without affecting the sound pitch</tr>
        <tr lang="ru">относительное изменение темпа без влияния на высоту тона</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">starts processing</tr>
          <tr lang="ru">запускает обработку</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">number of samples in the result</tr>
          <tr lang="ru">число семплов в результате</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[loadbang]
|
[symbol voice.wav( [symbol bell.aiff( [array A1 w=150] [array A2 w=150]
|                  |
[load %DOC%/sound/$1 @to A1 @resize(
|
[expand_env]
|
[snd.file]

[bng] /*lower pitch*/
|
[array.stretch A1 A2 @pitch -5]

[bng] /*speed up and high*/     [bng]/*timestretch*/
|                               |
[array.stretch A1 A2 @rate 1.5] [array.stretch A1 A2 @tempo -30 @speech 1]

/* Play */

[ui.tab @items A1 A2]
|
[set $2, bang( [stop(
|              |
[tabplay~    A2]
|
[ui.gain~ @size 120 16]    [ui.dsp~]
| \
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
