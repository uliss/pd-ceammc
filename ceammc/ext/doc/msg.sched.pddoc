<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="msg.sched">
    <title>msg.sched</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">message dispatch scheduler</tr>
        <tr lang="ru">планировщик отправки сообщений</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>msg</category>
      <keywords>message scheduler</keywords>
      <since>0.9.4</since>
      <also>
        <see>msg.after</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">First element of input list considered as delay time in milliseconds.</tr>
        <!-- old: Первый элемент входного списка рассматривается как
                время задержки в миллисекундах. -->
        <tr lang="ru" finished="false">Первый элемент входного списка рассматривается как время
        задержки в миллисекундах.</tr>
      </par>
      <par>
        <tr lang="en">Other messages passed 'as is' immediately.</tr>
        <!-- old: Другие сообщения были переданы «как есть»
                немедленно. -->
        <tr lang="ru" finished="false">Другие сообщения были переданы «как есть» немедленно.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">immediately output bang</tr>
          <tr lang="ru" finished="false">Немедленно произвести взрыв</tr>
        </in>
        <in on="float">
          <tr lang="en">immediately output float</tr>
          <tr lang="ru" finished="false">немедленно выпустить поплавок</tr>
        </in>
        <in on="symbol">
          <tr lang="en">immediately output symbol</tr>
          <tr lang="ru" finished="false">Немедленный вывод символа</tr>
        </in>
        <in on="list">
          <tr lang="en">If first element is a float it considered as delay time in millisecond. If
          this delay time is &gt;0: output left elements after this delay time. If delay time is
          &lt;0, output left elements immediately. If delay time is ==0, output left elements with
          shortest possible delay (on next scheduler block). If first element not a float, output
          whole list immediately.</tr>
          <!-- old: Если первый элемент является поплавком, он
                    считается временем задержки в миллисекунде. Если это время задержки > 0:
                    выход оставил элементы после этого времени задержки. Если время задержки <0,
                    то выход сразу же оставляет элементы. Если время задержки ==0, на выходе
                    остаются элементы с наименьшей возможной задержкой (на следующем блоке
                    планировщика). Если первый элемент не плавает, немедленно выведите весь
                    список. -->
          <tr lang="ru" finished="false">Если первый элемент является поплавком, он считается
          временем задержки в миллисекунде. Если это время задержки &gt; 0: выход оставил элементы
          после этого времени задержки. Если время задержки &lt;0, то выход сразу же оставляет
          элементы. Если время задержки ==0, на выходе остаются элементы с наименьшей возможной
          задержкой (на следующем блоке планировщика). Если первый элемент не плавает, немедленно
          выведите весь список.</tr>
        </in>
        <in on="any">
          <tr lang="en">immediately output any</tr>
          <tr lang="ru" finished="false">немедленно вывести любой</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">clear scheduled messages</tr>
          <tr lang="ru" finished="false">четкие запланированные сообщения</tr>
        </in>
        <in on="any">
          <tr lang="en">reset: clear scheduled messages, flush: output and clear</tr>
          <!-- old: Сброс: четкие запланированные сообщения, смыв:
                    вывод и ясность -->
          <tr lang="ru" finished="false">Сброс: четкие запланированные сообщения, смыв: вывод и
          ясность</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">message output</tr>
          <tr lang="ru" finished="false">сообщение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[@freq 100, @gate 1, 400 @freq 800, 600 @freq 200, 750 @gate 0(
|
|
|
[msg.sched]
|
[synth.dubdub~]
|
[ui.hgain~]     [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
