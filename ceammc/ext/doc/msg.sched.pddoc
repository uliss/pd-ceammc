<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="msg.sched">
    <title>msg.sched</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">message dispatch scheduler</tr>
        <tr lang="ru">планировщик отправки сообщений</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>msg</category>
      <keywords>message scheduler</keywords>
      <since>0.9.4</since>
      <also>
        <see>msg.after</see>
      </also>
    </meta>
    <info>
      <par style="important">
        <tr lang="en">If the first element of the input list is a number, it is considered as the message sending delay time in milliseconds.</tr>
        <tr lang="ru">Если первый элемент входного списка - число, он рассматривается как время
        задержки отправки сообщения в миллисекундах.</tr>
      </par>
      <par>
        <tr lang="en">Other messages are immediately passed to the output.</tr>
        <tr lang="ru">Другие сообщения немедленно передаются на выход.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">immediately output bang</tr>
          <tr lang="ru">немедленно выводит bang</tr>
        </in>
        <in on="float">
          <tr lang="en">immediately output float</tr>
          <tr lang="ru">немедленно выводит float</tr>
        </in>
        <in on="symbol">
          <tr lang="en">immediately output symbol</tr>
          <tr lang="ru">немедленно выводит symbol</tr>
        </in>
        <in on="list">
          <tr lang="en">If the first element is a number, it is considered
          the message sending delay time in milliseconds.
          If this delay time &gt;0: it outputs the remaining elements of the list
          after this delay time. If the delay time &lt;0, it immediately outputs the remaining
          elements of the list. If the delay time == 0, it outputs the remaining elements of the list with the smallest possible
          delay (in the next scheduler tick). If the first element is not a number, immediately
          output the entire(!) list.</tr>
          <tr lang="ru">Если первый элемент является числом, он рассматривается
          временем задержки отправки сообщения в миллисекундах.
          Если это время задержки &gt;0: выводит остальные элементы списка
          после этого времени задержки. Если время задержки &lt;0, сразу же выводит остальные
          элементы списка. Если время задержки ==0, выводит остальные элементы списка с наименьшей возможной
          задержкой (на следующем блоке планировщика). Если первый элемент не число: немедленно
          выводит весь(!) список.</tr>
        </in>
        <in on="any">
          <tr lang="en">immediately output message</tr>
          <tr lang="ru">немедленно выводит сообщение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">clear the list of messages scheduled for sending</tr>
          <tr lang="ru">очистить список запланированных к отправке сообщений</tr>
        </in>
        <in on="any" selector="reset">
          <tr lang="en">clear the list of messages scheduled for sending</tr>
          <tr lang="ru">очистить список запланированных к отправке сообщений</tr>
        </in>
        <in on="any" selector="flush">
          <tr lang="en">immediately output scheduled messages and clear their list</tr>
          <tr lang="ru">немедленно вывести запланированные сообщения и очистить их список</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">message output</tr>
          <tr lang="ru">вывод сообщений</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[@freq 100, @gate 1, 400 @freq 800, 600 @freq 200, 750 @gate 0(
|
|
|
[msg.sched]
|
[synth.dubdub~]
|
[ui.hgain~]     [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
