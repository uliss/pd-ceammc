<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="msg.sched">
        <title>msg.sched</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">message dispatch scheduler</tr>
                <tr lang="ru">планировщик отправки сообщений</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>msg</category>
            <keywords>message scheduler</keywords>
            <since>0.9.4</since>
            <also>
                <see>msg.after</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">First element of input list considered as delay time in
                milliseconds.</tr>
            </par>
            <par>
                <tr lang="en">Other messages passed 'as is' immediately.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">immediately output bang</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">immediately output float</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">immediately output symbol</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">If first element is a float it considered as delay time in
                    millisecond. If this delay time is &gt;0: output left elements after this delay
                    time. If delay time is &lt;0, output left elements immediately. If delay time
                    is ==0, output left elements with shortest possible delay (on next scheduler
                    block). If first element not a float, output whole list immediately.</tr>
                </xinfo>
                <xinfo on="any">
                    <tr lang="en">immediately output any</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">clear scheduled messages</tr>
                </xinfo>
                <xinfo on="any">
                    <tr lang="en">reset: clear scheduled messages, flush: output and clear</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>message output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[@freq 100, @gate 1, 400 @freq 800, 600 @freq 200, 750 @gate 0(
|
|
|
[msg.sched]
|
[synth.dubdub~]
|
[ui.hgain~]     [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
