<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.gamma~">
        <title>math.gamma~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">gamma function for signals</tr>
                <tr lang="ru">гамма-функция для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math gamma factorial</keywords>
            <also>
                <see>math.gamma</see>
                <see>math.lgamma~</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Extension of factorial function to real numbers</tr>
                <!-- old: Расширение факториальной функции на реальные
                числа -->
                <tr lang="ru" finished="false">Расширение факториальной функции на реальные
                числа</tr>
            </par>
            <par>
                <tr lang="en">For any positive integer n, Γ(n) = (n−1)!</tr>
                <!-- old: Для любого положительного целого числа n, Γ(n) =
                (n−1)! -->
                <tr lang="ru" finished="false">Для любого положительного целого числа n, Γ(n) =
                (n−1)!</tr>
            </par>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal</tr>
                    <tr lang="ru" finished="false">выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(
|
[plot.linspace~ -4 8 400 #a]
|
[math.gamma~]
|
[ui.plot~ @xlabels 1 @ylabels 1 @ymin -20 @ymax 40 @size 400 170 @ymin_ticks 0 #b]












[ui.dsp~]
[X a:1->b:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
