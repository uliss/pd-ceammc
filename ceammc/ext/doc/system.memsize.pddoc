<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="system.memsize">
        <title>system.memsize</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">returns the size of physical memory (RAM) in bytes</tr>
                <tr lang="ru">возвращает размер физической памяти (ОЗУ) в байтах</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>system</category>
            <keywords>system memory</keywords>
            <also>
                <see>system.memused</see>
            </also>
            <since>0.1</since>
        </meta>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">outputs memory size</tr>
                    <tr lang="ru" finished="false">выходной размер памяти</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">physical memory (RAM) size in bytes</tr>
                    <tr lang="ru" finished="false">Размер физической памяти (RAM) в байтах</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bng]
|
[system.memsize]
|
[/ 1024]
|
[/ 1024] /* in Mbytes */
|
[floatatom digits=12]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
