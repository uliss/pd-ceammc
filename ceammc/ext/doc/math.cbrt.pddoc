<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="math.cbrt">
        <title>math.cbrt</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">cube root function</tr>
                <tr lang="ru">кубический корень</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math cbrt</keywords>
            <also>
                <see>math.sqrt</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The cbrt() function computes the cube root of input value.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
            </par>
            <par>
                <tr lang="en">cbrt(+-0) returns +-0.</tr>
            </par>
            <par>
                <tr lang="en">cbrt(+-infinity) returns +-infinity.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">input value</xinfo>
                <xinfo on="list">apply to all numeric values</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[math.cbrt]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
