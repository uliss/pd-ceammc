<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.cbrt">
        <title>math.cbrt</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">cube root function</tr>
                <tr lang="ru">кубический корень</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math cbrt</keywords>
            <also>
                <see>math.sqrt</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The cbrt() function computes the cube root of input value.</tr>
                <!-- old: Функция cbrt() вычисляет кубический корень входного
                значения. -->
                <tr lang="ru" finished="false">Функция cbrt() вычисляет кубический корень входного
                значения.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
                <tr lang="ru" finished="false">Особые ценности:</tr>
            </par>
            <par>
                <tr lang="en">cbrt(+-0) returns +-0.</tr>
                <tr lang="ru" finished="false">cbrt(+-0) возвращается +-0.</tr>
            </par>
            <par>
                <tr lang="en">cbrt(+-infinity) returns +-infinity.</tr>
                <!-- old: cbrt (+-бесконечность) возвращает
                +-бесконечность. -->
                <tr lang="ru" finished="false">cbrt (+-бесконечность) возвращает
                +-бесконечность.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">input value</tr>
                    <tr lang="ru" finished="false">входная стоимость</tr>
                </in>
                <in on="list">
                    <tr lang="en">apply to all numeric values</tr>
                    <tr lang="ru" finished="false">применяется ко всем числовым значениям</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result value</tr>
                    <tr lang="ru" finished="false">значение результата</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[math.cbrt]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
