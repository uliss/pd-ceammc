<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="list.sort">
    <title>list.sort</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">sorts the list in ascending order</tr>
        <tr lang="ru">сортирует список по возрастанию</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>list</category>
      <keywords>list sort</keywords>
      <since>0.1</since>
      <also>
        <see>list.sort_with</see>
        <see>list.reverse</see>
        <see>list.shuffle</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object sorts the incoming list in ascending order and outputs a new sorted list</tr>
        <tr lang="ru">объект сортирует входящий список по возрастанию и выводит новый отсортированный список</tr>
      </par>
      <par>
        <tr lang="en">numbers are sorted numerically, symbols are sorted alphabetically, numbers come before symbols</tr>
        <tr lang="ru">числа сортируются численно, символы — в алфавитном порядке, числа идут перед символами</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to order a list of values before further processing, for example to sort note numbers or to arrange file names alphabetically</tr>
        <tr lang="ru">объект можно использовать для упорядочивания списка значений перед дальнейшей обработкой, например чтобы отсортировать номера нот или расположить имена файлов по алфавиту</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">input list</tr>
          <tr lang="ru">входной список</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">new sorted list</tr>
          <tr lang="ru">новый отсортированный список</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[2 -2 4 1 2.0( [1 a -2 b 4 1 2.0(
|              |
[list.sort     ]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
