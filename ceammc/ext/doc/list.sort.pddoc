<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.sort">
        <title>list.sort</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sorts the list in ascending orderr</tr>
                <tr lang="ru">сортирует список в порядке возрастания</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list sort</keywords>
            <since>0.1</since>
            <also>
                <see>list.sort_with</see>
                <see>list.reverse</see>
                <see>list.shuffle</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">input list.</tr>
                    <tr lang="ru" finished="false">Список входов.</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">new sorted list</tr>
                    <tr lang="ru" finished="false">Новый сортированный список</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[2 -2 4 1 2.0( [1 a -2 b 4 1 2.0(
|              |
[list.sort     ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
