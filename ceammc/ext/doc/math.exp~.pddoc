<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="math.exp~">
        <title>math.exp~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">base-e exponential function for signals</tr>
                <tr lang="ru">экспоненциальная функция для сигналов на основе числа e</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math exp2</keywords>
            <also>
                <see>math.log~</see>
                <see>math.exp2~</see>
            </also>
            <since>0.9</since>
        </meta>
        <inlets>
            <inlet type="audio">
                <in on="float">
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal</tr>
                    <tr lang="ru" finished="false">выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[plot.linspace~ -2 4]
|                 ^|
[math.exp~]        |
|                  |.
[ui.plot~ @xlabels 1 @ylabels 1 @ymin 0 @ymax 60 @size 400 200]














[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
