<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.histogram">
        <title>list.histogram</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs a list distribution histogram</tr>
                <tr lang="ru">выводит гистограмму распределений списка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list histogram</keywords>
            <since>0.3</since>
            <also>
                <see>array.hist</see>
            </also>
            <aliases>
                <alias>list.hist</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Histogram outputted as list of probabilities in specified number of
                bins</tr>
            </par>
        </info>
        <arguments>
            <argument name="BINS" type="int" minvalue="2" maxvalue="1024">
                <tr lang="en">number of histogram bins</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @bins -->
            <property name="@bins" type="int" minvalue="2" default="100" maxvalue="1024">
                <tr lang="en">number of histogram bins</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="int">
                    <tr lang="en">set number of bins</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output list - length of @bins</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]                                [A array1 yr=0..1]
|
[list.gen 512]X[random.gauss 50 10]
|
[list.histogram]
|
[list.normalize @range]
|
[list.enumerate @append]
|
[list.repack 2]
|
[tabwrite array1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
