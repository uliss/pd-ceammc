<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.10">
    <object name="ui.aview" type="gui">
        <title>ui.aview</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">array view with cursor and range selection</tr>
                <tr lang="ru">отображение массива с курсором и выбором диапазона</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui array view</keywords>
            <since>0.6</since>
        </meta>
        <mouse>
            <event type="left-click" editmode="false">move view cursor under mouse pointer</event>
            <event type="left-click" editmode="false" keys="Ctrl">starts range selection</event>
            <event type="left-click" editmode="false" keys="Alt">edit selection nearest
            border</event>
            <event type="left-click" editmode="false" keys="Shift">starts moving selection</event>
            <event type="drag" editmode="false">move view cursor</event>
            <event type="drag" editmode="false" keys="Alt">change nearest selection border</event>
            <event type="drag" editmode="false" keys="Shift">move selection</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
        </mouse>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">array name</property>
            <!-- @background_color -->
            <property name="@background_color" type="list" default="0.93 0.93 0.93 1">element
            background color (list of red, green, blue values in 0-1 range)</property>
            <!-- @border_color -->
            <property name="@border_color" type="list" default="0.6 0.6 0.6 1">border color (list
            of red, green, blue values in 0-1 range)</property>
            <!-- @cursor_color -->
            <property name="@cursor_color" type="list" default="0 0.75 1 1">cursor color (list of
            red, green, blue values in 0-1 range)</property>
            <!-- @cursor_ms -->
            <property name="@cursor_ms" type="float" units="millisecond" default="0">cursor
            position in milliseconds</property>
            <!-- @cursor_phase -->
            <property name="@cursor_phase" type="float" minvalue="0" maxvalue="1" default="0">
            cursor position in 0-1 range</property>
            <!-- @cursor_samp -->
            <property name="@cursor_samp" type="int" default="0" units="sample">cursor position in
            samples</property>
            <!-- @cursor_sec -->
            <property name="@cursor_sec" type="float" units="second" default="0">cursor position in
            seconds</property>
            <!-- @fontname -->
            <property name="@fontname" type="symbol" default="Helvetica"
            enum="Courier DejaVu Helvetica Monaco Times">fontname</property>
            <!-- @fontsize -->
            <property name="@fontsize" type="int" minvalue="4" maxvalue="100" default="11">
            fontsize</property>
            <!-- @fontslant -->
            <property name="@fontslant" type="symbol" enum="roman italic" default="roman">font
            slant</property>
            <!-- @fontweight -->
            <property name="@fontweight" type="symbol" enum="normal bold" default="normal">font
            weight</property>
            <!-- @label_bottom -->
            <property name="@label_bottom" type="symbol" default="">bottom right label if
            @show_labels is on</property>
            <!-- @label_top -->
            <property name="@label_top" type="symbol" default="">top right label if @show_labels is
            on</property>
            <!-- @mouse_events -->
            <property name="@mouse_events" type="bool" default="1">mouse events output mode. If on
            outputs @mouse_down, @mouse_up and @mouse_drag events</property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="0">pin mode. if 1 - put element to the
            lowest level</property>
            <!-- @receive -->
            <property name="@receive" type="symbol" default="(null)">receive source</property>
            <!-- @select_ms -->
            <property name="@select_ms" type="list" units="millisecond" default="">selection range
            in milliseconds, pair of values: begin, end</property>
            <!-- @select_phase -->
            <property name="@select_phase" type="list" default="">selection range noramlized to 0-1
            range, pair of values: begin, end</property>
            <!-- @select_samp -->
            <property name="@select_samp" type="list" units="sample" default="">selection range in
            samples, pair of values: begin, end</property>
            <!-- @select_sec -->
            <property name="@select_sec" type="list" units="second" default="">selection range in
            seconds, pair of values: begin, end</property>
            <!-- @selection_color -->
            <property name="@selection_color" type="list" default="0 0.75 1 1">selection color
            (list of red, green, blue values in 0-1 range)</property>
            <!-- @send -->
            <property name="@send" type="symbol" default="(null)">send destination</property>
            <!-- @show_labels -->
            <property name="@show_labels" type="bool" default="0">if show corner labels</property>
            <!-- @show_rms -->
            <property name="@show_rms" type="bool" default="0">show RMS graph</property>
            <!-- @size -->
            <property name="@size" type="list" default="300 100">element size (width, height
            pair)</property>
            <!-- @size_ms -->
            <property name="@size_ms" type="float" minvalue="0" access="readonly"
            units="millisecond" default="0">array size in milliseconds</property>
            <!-- @size_samp -->
            <property name="@size_samp" type="int" minvalue="0" access="readonly" units="sample"
            default="0">array size in samples</property>
            <!-- @size_sec -->
            <property name="@size_sec" type="float" minvalue="0" access="readonly" units="second"
            default="0">array size in seconds</property>
            <!-- @wave_color -->
            <property name="@wave_color" type="list" default="0.3 0.3 0.3 1">wave color (list of
            red, green, blue values in 0-1 range)</property>
        </properties>
        <methods>
            <!-- dump -->
            <method name="dump">dumps all object info to Pd console window.</method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
            <!-- select -->
            <method name="select">set selection 
            <param name="BEGIN" type="int" required="true">selection start in samples</param>
            <param name="END" type="int" required="true">selection end in samples</param></method>
            <!-- update -->
            <method name="update">redraws view</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">output current cursor positions: @cursor_samp, @cursor_phase,
                @cursor_ms, @cursor_sec and selection (if selected): @select_samp, @select_phase,
                @select_ms, @select_sec, @begin, @end</xinfo>
                <xinfo on="float">move cursor to specified sample position</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[loadbang] [table array_view]
|
[load %DOC%/sound/voice.wav @to array_view @resize(
|
[expand_env]
|
[snd.file]
|
[update(  /*Ctrl+drag - select region to play*/
|
[ui.aview @array=array_view @show_labels=1 @size=300x80]
|
|
|
|
|
[ui.mf @up]
|
[route @select_samp]
|
[flow.change #a]        [loadbang]
|                       |
[expr $f1\; $f2 - $f1]  [1(
|           ^|          |
|    [b #b]  |          [F]    /*speed*/
|    |       |.         |
|    [loop~             ]
|    |  ^|.
|    [*~  ]
|    |.
[+~   ]
|
[tabread4~ array_view]
|
[ui.gain~ @size 120 16]  [ui.dsp~]
|\
[dac~]

[X a->b]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
