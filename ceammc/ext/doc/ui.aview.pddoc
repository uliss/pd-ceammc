<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.aview" type="gui">
        <title>ui.aview</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">array view with cursor and range selection</tr>
                <tr lang="ru">отображение массива с курсором и выбором диапазона</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui array view</keywords>
            <since>0.6</since>
        </meta>
        <mouse>
            <event type="move" editmode="false" empty="true"/>
            <event type="left-click" editmode="false">move view cursor under mouse pointer</event>
            <event type="left-click" editmode="false" keys="Ctrl">starts range selection</event>
            <event type="left-click" editmode="false" keys="Alt">edit selection nearest
            border</event>
            <event type="left-click" editmode="false" keys="Shift">starts moving selection</event>
            <event type="drag" editmode="false">move view cursor</event>
            <event type="drag" editmode="false" keys="Alt">change nearest selection border</event>
            <event type="drag" editmode="false" keys="Shift">move selection</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
        </mouse>
        <properties>
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_pinned.xml" />
            <xi:include href="props_ui_receive.xml" />
            <xi:include href="props_ui_send.xml" />
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
            </property>
            <!-- @cursor_color -->
            <property name="@cursor_color" type="list" default="0 0.75 1 1">
                <tr lang="en">cursor color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @cursor_ms -->
            <property name="@cursor_ms" type="float" units="millisecond" default="0">
                <tr lang="en">cursor position in milliseconds</tr>
            </property>
            <!-- @cursor_phase -->
            <property name="@cursor_phase" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">cursor position in 0-1 range</tr>
            </property>
            <!-- @cursor_samp -->
            <property name="@cursor_samp" type="int" default="0" units="sample">
                <tr lang="en">cursor position in samples</tr>
            </property>
            <!-- @cursor_sec -->
            <property name="@cursor_sec" type="float" units="second" default="0">
                <tr lang="en">cursor position in seconds</tr>
            </property>
            <!-- @label_bottom -->
            <property name="@label_bottom" type="symbol" default="">
                <tr lang="en">bottom right label if @show_labels is on</tr>
            </property>
            <!-- @label_top -->
            <property name="@label_top" type="symbol" default="">
                <tr lang="en">top right label if @show_labels is on</tr>
            </property>
            <!-- @mouse_events -->
            <property name="@mouse_events" type="bool" default="1">
                <tr lang="en">mouse events output mode. If on outputs @mouse_down, @mouse_up and
                @mouse_drag events</tr>
            </property>
            <!-- @select_ms -->
            <property name="@select_ms" type="list" units="millisecond" default="">
                <tr lang="en">selection range in milliseconds, pair of values: begin, end</tr>
            </property>
            <!-- @select_phase -->
            <property name="@select_phase" type="list" default="">
                <tr lang="en">selection range noramlized to 0-1 range, pair of values: begin,
                end</tr>
            </property>
            <!-- @select_samp -->
            <property name="@select_samp" type="list" units="sample" default="">
                <tr lang="en">selection range in samples, pair of values: begin, end</tr>
            </property>
            <!-- @select_sec -->
            <property name="@select_sec" type="list" units="second" default="">
                <tr lang="en">selection range in seconds, pair of values: begin, end</tr>
            </property>
            <!-- @selection_color -->
            <property name="@selection_color" type="list" default="0 0.75 1 1">
                <tr lang="en">selection color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @show_labels -->
            <property name="@show_labels" type="bool" default="0">
                <tr lang="en">if show corner labels</tr>
            </property>
            <!-- @show_rms -->
            <property name="@show_rms" type="bool" default="0">
                <tr lang="en">show RMS graph</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="300 100">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
            <!-- @size_ms -->
            <property name="@size_ms" type="float" minvalue="0" access="readonly"
            units="millisecond" default="0">
                <tr lang="en">array size in milliseconds</tr>
            </property>
            <!-- @size_samp -->
            <property name="@size_samp" type="int" minvalue="0" access="readonly" units="sample"
            default="0">
                <tr lang="en">array size in samples</tr>
            </property>
            <!-- @size_sec -->
            <property name="@size_sec" type="float" minvalue="0" access="readonly" units="second"
            default="0">
                <tr lang="en">array size in seconds</tr>
            </property>
            <!-- @wave_color -->
            <property name="@wave_color" type="list" default="0.3 0.3 0.3 1">
                <tr lang="en">wave color (list of red, green, blue values in 0-1 range)</tr>
            </property>
        </properties>
        <methods>
            <!-- dump -->
            <method name="dump">dumps all object info to Pd console window.</method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
            <!-- select -->
            <method name="select">set selection 
            <param name="BEGIN" type="int" required="true">selection start in samples</param>
            <param name="END" type="int" required="true">selection end in samples</param></method>
            <!-- update -->
            <method name="update">redraws view</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">output current cursor positions: @cursor_samp, @cursor_phase,
                @cursor_ms, @cursor_sec and selection (if selected): @select_samp, @select_phase,
                @select_ms, @select_sec, @begin, @end</xinfo>
                <xinfo on="float">move cursor to specified sample position</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[loadbang] [table array_view]
|
[load %DOC%/sound/voice.wav @to array_view @resize(
|
[expand_env]
|
[snd.file]
|
[update(  /*Ctrl+drag - select region to play*/
|
[ui.aview @array=array_view @show_labels=1 @size=300x80]
|
|
|
|
|
[ui.mf @up]
|
[route @select_samp]
|
[flow.change #a]        [loadbang]
|                       |
[expr $f1\; $f2 - $f1]  [1(
|           ^|          |
|    [b #b]  |          [F]    /*speed*/
|    |       |.         |
|    [loop~             ]
|    |  ^|.
|    [*~  ]
|    |.
[+~   ]
|
[tabread4~ array_view]
|
[ui.gain~ @size 120 16]  [ui.dsp~]
|\
[dac~]

[X a->b]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
