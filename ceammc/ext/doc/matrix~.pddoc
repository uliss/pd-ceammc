<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="matrix~">
        <title>matrix~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">signal routing matrix</tr>
                <tr lang="ru">матрица маршрутизации сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>matrix</keywords>
            <since>0.6</since>
            <aliases>
                <alias>ceammc/matrix~</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="INPUTS" type="int" minvalue="2" maxvalue="16">
                <tr lang="en">number of matrix inputs (columns)</tr>
                <tr lang="ru" finished="false">Количество входов матрицы (колонн)</tr>
            </argument>
            <argument name="OUTPUTS" type="int" minvalue="2" maxvalue="16">
                <tr lang="en">number of matrix outputs (rows)</tr>
                <tr lang="ru" finished="false">Количество выходов матрицы (рядов)</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @inputs -->
            <property name="@inputs" type="int" minvalue="2" maxvalue="16" default="2" access="initonly">
                <tr lang="en">number of matrix inputs</tr>
                <tr lang="ru" finished="false">Количество входов матрицы</tr>
            </property>
            <!-- @outputs -->
            <property name="@outputs" type="int" minvalue="2" maxvalue="16" default="2" access="initonly">
                <tr lang="en">number of matrix outputs</tr>
                <tr lang="ru" finished="false">Количество выходов матрицы</tr>
            </property>
        </properties>
        <methods>
            <!-- cell -->
            <method name="cell">
                <info>
                    <tr lang="en">on/off matrix cell. Note argument order: row, cols.</tr>
                    <!-- old: Матричная ячейка in/off. Порядок аргументации:
                    ряд, cols. -->
                    <tr lang="ru" finished="false">Матричная ячейка in/off. Порядок аргументации:
                    ряд, cols.</tr>
                </info>
                <param name="ROW" type="int" minvalue="0" maxvalue="15" required="true">
                    <tr lang="en">row (output) index</tr>
                    <tr lang="ru" finished="false">Индекс строки (output)</tr>
                </param>
                <param name="COL" type="int" minvalue="0" maxvalue="15" required="true">
                    <tr lang="en">column (input) index</tr>
                    <tr lang="ru" finished="false">столбец (входной индекс)</tr>
                </param>
            </method>
        </methods>
        <inlets dynamic="true">
            <inlet type="audio" number="1">
                <in>
                    <tr lang="en">first input signal</tr>
                    <tr lang="ru" finished="false">Первый входной сигнал</tr>
                </in>
            </inlet>
            <inlet type="audio" number="...">
                <in>
                    <tr lang="en">... input signal</tr>
                    <tr lang="ru" finished="false">... входной сигнал</tr>
                </in>
            </inlet>
            <inlet type="audio" number="n">
                <in>
                    <tr lang="en">n-th input signal</tr>
                    <tr lang="ru" finished="false">n-й входной сигнал</tr>
                </in>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio" number="1">
                <out type="any">
                    <tr lang="en">first output signal</tr>
                    <tr lang="ru" finished="false">Первый выходной сигнал</tr>
                </out>
            </outlet>
            <outlet type="audio" number="...">
                <out type="any">
                    <tr lang="en">... output signal</tr>
                    <tr lang="ru" finished="false">... выходной сигнал</tr>
                </out>
            </outlet>
            <outlet type="audio" number="n">
                <out type="any">
                    <tr lang="en">n-th output signal</tr>
                    <tr lang="ru" finished="false">n-й выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[sig~ 0.25] [sig~ 0.5]   [ui.matrix @size 37 69 @cols 2 @rows 4]
|           |            |
|           |            |
|           |.           |
[matrix~ 2 4              ]
|      ^|      ^^|     ^^^|
|       |        |        |
[env~] [env~]  [env~]  [env~] [ui.dsp~]
|      |       |       |
[F]    [F]     [F]     [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
