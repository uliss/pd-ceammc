<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="matrix~">
    <title>matrix~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">signal routing matrix</tr>
        <tr lang="ru">матрица маршрутизации сигналов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>matrix</keywords>
      <since>0.6</since>
      <aliases>
        <alias>ceammc/matrix~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes audio signals from N inputs to M outputs, the state of each input-to-output connection is controlled by the *cell* method</tr>
        <tr lang="ru">объект маршрутизирует аудиосигналы с N входов на M выходов, состояние каждого соединения вход-выход управляется методом *cell*</tr>
      </par>
      <par>
        <tr lang="en">the number of inputs and outputs is set at creation and cannot be changed later</tr>
        <tr lang="ru">количество входов и выходов задаётся при создании и не может быть изменено позже</tr>
      </par>
    </info>
    <arguments>
      <argument name="INPUTS" type="int" minvalue="2" maxvalue="16">
        <tr lang="en">number of matrix inputs (columns)</tr>
        <tr lang="ru">количество входов матрицы (столбцов)</tr>
      </argument>
      <argument name="OUTPUTS" type="int" minvalue="2" maxvalue="16">
        <tr lang="en">number of matrix outputs (rows)</tr>
        <tr lang="ru">количество выходов матрицы (строк)</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @inputs -->
      <property name="@inputs" type="int" minvalue="2" maxvalue="16" default="2" access="initonly">
        <tr lang="en">number of matrix inputs</tr>
        <tr lang="ru">количество входов матрицы</tr>
      </property>
      <!-- @outputs -->
      <property name="@outputs" type="int" minvalue="2" maxvalue="16" default="2"
      access="initonly">
        <tr lang="en">number of matrix outputs</tr>
        <tr lang="ru">количество выходов матрицы</tr>
      </property>
    </properties>
    <methods>
      <!-- cell -->
      <method name="cell">
        <info>
          <tr lang="en">on/off matrix cell. Note the argument order: row, column.</tr>
          <tr lang="ru">включить/выключить ячейку матрицы. Обратите внимание на порядок аргументов: строка, столбец.</tr>
        </info>
        <param name="ROW" type="int" minvalue="0" maxvalue="15" required="true">
          <tr lang="en">row (output) index</tr>
          <tr lang="ru">индекс строки (выход)</tr>
        </param>
        <param name="COL" type="int" minvalue="0" maxvalue="15" required="true">
          <tr lang="en">column (input) index</tr>
          <tr lang="ru">индекс столбца (вход)</tr>
        </param>
      </method>
    </methods>
    <inlets dynamic="true">
      <inlet type="audio" number="1">
        <in>
          <tr lang="en">first input signal</tr>
          <tr lang="ru">первый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... input signal</tr>
          <tr lang="ru">... входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">n-th input signal</tr>
          <tr lang="ru">n-й входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet type="audio" number="1">
        <out type="any">
          <tr lang="en">first output signal</tr>
          <tr lang="ru">первый выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio" number="...">
        <out type="any">
          <tr lang="en">... output signal</tr>
          <tr lang="ru">... выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio" number="n">
        <out type="any">
          <tr lang="en">n-th output signal</tr>
          <tr lang="ru">n-й выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[sig~ 0.25] [sig~ 0.5]   [ui.matrix @size 37 69 @cols 2 @rows 4]
|           |            |
|           |            |
|           |.           |
[matrix~ 2 4              ]
|      ^|      ^^|     ^^^|
|       |        |        |
[env~] [env~]  [env~]  [env~] [ui.dsp~]
|      |       |       |
[F]    [F]     [F]     [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
