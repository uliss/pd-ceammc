<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="midi.file">
    <title>midi.file</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">standard MIDI file (SMF) reader and writer</tr>
        <tr lang="ru">чтение и запись стандартных MIDI-файлов (SMF)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>midi</category>
      <keywords>midi file</keywords>
      <since>0.4</since>
    </meta>
    <arguments>
      <argument name="FILENAME" type="symbol">
        <tr lang="en">initial MIDI filename</tr>
        <tr lang="ru">начальное имя MIDI-файла</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @filename -->
      <property name="@filename" type="symbol" default="">
        <tr lang="en">current filename</tr>
        <tr lang="ru">текущее имя файла</tr>
      </property>
      <!-- @length_beat -->
      <property name="@length_beat" type="float" access="readonly" default="0">
        <tr lang="en">file length in quarters</tr>
        <tr lang="ru">длина файла в четвертях</tr>
      </property>
      <!-- @length_sec -->
      <property name="@length_sec" type="float" access="readonly" units="second" default="0">
        <tr lang="en">file length</tr>
        <tr lang="ru">длина файла</tr>
      </property>
      <!-- @length_tick -->
      <property name="@length_tick" type="int" access="readonly" default="0">
        <tr lang="en">file length in ticks</tr>
        <tr lang="ru">длина файла в тиках</tr>
      </property>
      <!-- @tempo -->
      <property name="@tempo" type="int" access="readonly" default="120">
        <tr lang="en">MIDI tempo in ticks per quarter</tr>
        <tr lang="ru">темп MIDI в тиках на четверть</tr>
      </property>
      <!-- @tracks -->
      <property name="@tracks" type="int" access="readonly" default="1">
        <tr lang="en">number of tracks</tr>
        <tr lang="ru">количество дорожек</tr>
      </property>
    </properties>
    <methods>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">removes all MIDI file content</tr>
          <tr lang="ru">удаляет всё содержимое MIDI-файла</tr>
        </info>
      </method>
      <!-- read -->
      <method name="read">
        <info>
          <tr lang="en">read specified MIDI file, no output</tr>
          <tr lang="ru">читает указанный MIDI-файл, без вывода</tr>
        </info>
      </method>
      <!-- write -->
      <method name="write">
        <info>
          <tr lang="en">write to specified MIDI file</tr>
          <tr lang="ru">записывает в указанный MIDI-файл</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output MidiFile data type</tr>
          <tr lang="ru">вывести данные типа MidiFile</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">MidiStream data type</tr>
          <tr lang="ru">данные типа MidiStream</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[openpanel]
|
[read $1, bang(
|
[midi.file]
|
|  [play( [stop(
|  |      |
[midi.track @join]
|
[midi.ev->note]
|
[unpack f f]
|      ^|
[mtof] [/ 100]
|      |
[osc~] |
|      |.
[*~     ]
| \
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
