<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env.asr~">
    <title>env.asr~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Attack/Sustain/Release envelope generator</tr>
        <tr lang="ru">генератор огибающей Attack/Sustain/Release (атака/удержание/восстановление)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>envelope asr</keywords>
      <since>0.6</since>
      <also>
        <see>env.adsr~</see>
        <see>env.ar~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">An ASR (Attack / Sustain / Release) envelope generator with three stages:
        attack (rise from 0 to 1), sustain (hold at the sustain level while the gate is on) and
        release (fall back to 0 after the gate is turned off). Unlike [env.adsr~], it has no decay
        stage — the signal goes directly from attack to sustain. The envelope multiplies the
        incoming audio signal by its current value.</tr>
        <tr lang="ru">Генератор огибающей ASR (атака / удержание / восстановление) с тремя фазами:
        атакой (рост от 0 до 1), удержанием (уровень удержания сохраняется, пока открыт gate) и
        восстановлением (спад обратно к 0 после закрытия gate). В отличие от [env.adsr~], здесь
        нет фазы спада — сигнал переходит от атаки сразу к удержанию. Огибающая умножает входящий
        аудиосигнал на своё текущее значение.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Sustained notes — shaping the amplitude of a sound that is held for as
        long as the key or gate is pressed, with a smooth attack and release and no artificial
        decay.</tr>
        <tr lang="ru">• Протяжные ноты — формирование амплитуды звука, который держится столько,
        сколько нажата клавиша или открыт gate, с плавной атакой и восстановлением без
        искусственного спада.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Pad and drone sounds — applying a slow attack and long release to
        continuous textures, so that they fade in and out smoothly.</tr>
        <tr lang="ru">• Пэды и дроун-текстуры — применение медленной атаки и длинного
        восстановления к непрерывным текстурам для плавного появления и исчезновения звука.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ATTACK" type="float" units="millisecond" minvalue="0" maxvalue="100000">
        <tr lang="en">attack time</tr>
        <tr lang="ru">время атаки</tr>
      </argument>
      <argument name="SUSTAIN" type="float" units="percent" minvalue="0" maxvalue="100">
        <tr lang="en">sustain level (percentage of trigger)</tr>
        <tr lang="ru">уровень удержания (в процентах от триггера)</tr>
      </argument>
      <argument name="RELEASE" type="float" units="millisecond" minvalue="0" maxvalue="100000">
        <tr lang="en">release time</tr>
        <tr lang="ru">время восстановления</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @asr -->
      <property name="@asr" type="list" access="readonly">
        <tr lang="en">attack, sustain, release triplet</tr>
        <tr lang="ru">тройка значений «атака, удержание, восстановление»</tr>
      </property>
      <!-- @attack -->
      <property name="@attack" type="float" units="millisecond" minvalue="0" maxvalue="100000"
      default="10">
        <tr lang="en">attack time</tr>
        <tr lang="ru">время атаки</tr>
      </property>
      <!-- @gate -->
      <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
        <tr lang="en">trigger. If &gt; 0 — starts the envelope</tr>
        <tr lang="ru">триггер. Если &gt; 0 — запускает огибающую</tr>
      </property>
      <!-- @release -->
      <property name="@release" type="float" units="millisecond" minvalue="0" maxvalue="100000"
      default="300">
        <tr lang="en">release time</tr>
        <tr lang="ru">время восстановления</tr>
      </property>
      <!-- @sustain -->
      <property name="@sustain" type="float" units="percent" minvalue="0" maxvalue="100"
      default="100">
        <tr lang="en">sustain level — percentage of the trigger signal</tr>
        <tr lang="ru">уровень удержания — процент от триггерного сигнала</tr>
      </property>
    </properties>
    <methods>
      <!-- play -->
      <method name="play">
        <info>
          <tr lang="en">starts the envelope and releases it after the specified time</tr>
          <tr lang="ru">запускает огибающую и снимает её через заданное время</tr>
        </info>
        <param name="DUR" type="float" minvalue="0">
          <tr lang="en">duration</tr>
          <tr lang="ru">длительность</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the envelope to its initial state</tr>
          <tr lang="ru">возвращает огибающую в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
        <in on="list">
          <tr lang="en">expects ATTACK, SUSTAIN, RELEASE values</tr>
          <tr lang="ru">ожидаются значения ATTACK, SUSTAIN, RELEASE</tr>
        </in>
        <in on="data">
          <tr lang="en">envelope data type</tr>
          <tr lang="ru">тип данных огибающей</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">float: 1 = start the envelope, 0 = stop</tr>
          <tr lang="ru">число: 1 — запустить огибающую, 0 — остановить</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal with the envelope applied</tr>
          <tr lang="ru">выходной сигнал с применённой огибающей</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">outputs 1 when the attack phase finishes, 0 when the release phase
          finishes</tr>
          <tr lang="ru">выводит 1 по завершении фазы атаки, 0 — по завершении фазы
          восстановления</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
[unpack ]               [msg.onload asr 600 60]
|      ^|               |
[mtof]  [cc->amp]       [ui.env @size 200 60]
|       |               |
[osc~]  [@gate $1(      |
|       |               |
|       |     [T]       |
|       |     |.        |
[env.asr~ 2 100 2000    ]
|             ^|
|             [T]
|
[ui.gain~ @size 140 16] [ui.dsp~]
|\
[dac~ ]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
