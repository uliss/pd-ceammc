<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="env.asr~">
        <title>env.asr~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Attack/Sustain/Release envelope generator</tr>
                <tr lang="ru">генератор огибающей Attack/Sustain/Release</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>env</category>
            <keywords>envelope asr</keywords>
            <since>0.6</since>
            <also>
                <see>env.adsr~</see>
                <see>env.ar~</see>
            </also>
        </meta>
        <arguments>
            <argument name="ATTACK" type="float" units="millisecond" minvalue="0"
            maxvalue="100000">
                <tr lang="en">attack time</tr>
                <tr lang="ru" finished="false">Время атаки</tr>
            </argument>
            <argument name="SUSTAIN" type="float" units="percent" minvalue="0" maxvalue="100">
                <tr lang="en">sustain level (percentage of trigger)</tr>
                <tr lang="ru" finished="false">Устойчивый уровень (процент триггера)</tr>
            </argument>
            <argument name="RELEASE" type="float" units="millisecond" minvalue="0"
            maxvalue="100000">
                <tr lang="en">release time</tr>
                <tr lang="ru" finished="false">Время освобождения</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @asr -->
            <property name="@asr" type="list" access="readonly">
                <tr lang="en">attack sustain release triplet</tr>
                <tr lang="ru" finished="false">Обсуждение Attack sustain Release Triple</tr>
            </property>
            <!-- @attack -->
            <property name="@attack" type="float" units="millisecond" minvalue="0"
            maxvalue="100000" default="10">
                <tr lang="en">attack time</tr>
                <tr lang="ru" finished="false">Время атаки</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">trigger. If &gt; 0 - starts envelope.</tr>
                <tr lang="ru" finished="false">триггер. Если &gt; 0 - начинается конверт.</tr>
            </property>
            <!-- @release -->
            <property name="@release" type="float" units="millisecond" minvalue="0"
            maxvalue="100000" default="300">
                <tr lang="en">release time</tr>
                <tr lang="ru" finished="false">Время освобождения</tr>
            </property>
            <!-- @sustain -->
            <property name="@sustain" type="float" units="percent" minvalue="0" maxvalue="100"
            default="100">
                <tr lang="en">sustain level - percent from trigger signal</tr>
                <tr lang="ru" finished="false">Устойчивый уровень - процент от триггерного
                сигнала</tr>
            </property>
        </properties>
        <methods>
            <!-- play -->
            <method name="play">
                <info>
                    <tr lang="en">runs envelope and release it after specified time</tr>
                    <tr lang="ru" finished="false">запускает конверт и выпускает его по истечении
                    определенного времени</tr>
                </info>
                <param name="DUR" type="float" minvalue="0">
                    <tr lang="en">duration</tr>
                    <tr lang="ru" finished="false">продолжительность</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset envelope to initial state</tr>
                    <tr lang="ru" finished="false">Перезагрузить конверт в начальное состояние</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">ATTACK, SUSTAIN, RELEASE values are expected</tr>
                    <tr lang="ru" finished="false">Ожидаются значения ATTACK, SUSTAIN, RELEASE</tr>
                </xinfo>
                <xinfo on="data">
                    <tr lang="en">Envelope data type</tr>
                    <tr lang="ru" finished="false">Тип конверта данных</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">float: 1 - start envelope, 0 - stop</tr>
                    <tr lang="ru" finished="false">Поплавок: 1 - стартовый конверт, 0 - стоп</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal with applied envelope</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">outputs 1 when attack phase finished, 0 - when release phase
                    finished</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
[unpack ]               [msg.onload asr 600 60]
|      ^|               |
[mtof]  [cc->amp]       [ui.env @size 200 60]
|       |               |
[osc~]  [@gate $1(      |
|       |               |
|       |     [T]       |
|       |     |.        |
[env.asr~ 2 100 2000    ]
|             ^|
|             [T]
|
[ui.gain~ @size 140 16] [ui.dsp~]
|\
[dac~ ]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
