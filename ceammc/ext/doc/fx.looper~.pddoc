<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fx.looper~">
    <title>fx.looper~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">a single track looper</tr>
        <tr lang="ru">однодорожечный лупер</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>fx</category>
      <keywords>fx looper</keywords>
      <since>0.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">A single-track audio looper. The object records the incoming signal into an
        internal buffer (or into an array specified with the @array property) and then plays it
        back in a loop. The loop can be overdubbed, paused, stopped and cleared. The maximum loop
        length is set with the CAPACITY argument or the @capacity property. Various fade-in and
        fade-out times control smooth transitions between the internal states: record, play,
        overdub and stop.</tr>
        <tr lang="ru">Однодорожечный аудиолупер. Объект записывает входящий сигнал во внутренний
        буфер (или в массив, заданный свойством @array) и затем воспроизводит его в цикле. Цикл
        можно перезаписывать поверх (overdub), ставить на паузу, останавливать и очищать.
        Максимальная длина цикла задаётся аргументом CAPACITY или свойством @capacity. Различные
        времена fade-in и fade-out управляют плавными переходами между внутренними состояниями:
        запись, воспроизведение, overdub и остановка.</tr>
      </par>
    </info>
    <arguments>
      <argument name="CAPACITY" type="float" units="second" minvalue="0" maxvalue="120">
        <tr lang="en">max loop time</tr>
        <tr lang="ru">максимальная длительность цикла</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">use the specified array for recording instead of the internal buffer</tr>
        <tr lang="ru">использовать заданный массив для записи вместо внутреннего буфера</tr>
      </property>
      <!-- @capacity -->
      <property name="@capacity" type="float" minvalue="0" maxvalue="120" default="5"
      units="second">
        <tr lang="en">max loop time</tr>
        <tr lang="ru">максимальная длительность цикла</tr>
      </property>
      <!-- @dub_to_play_time -->
      <property name="@dub_to_play_time" type="float" units="millisecond" default="20"
      minvalue="0">
        <tr lang="en">record fade-out time while transitioning from overdub to play</tr>
        <tr lang="ru">время затухания записи при переходе из overdub в воспроизведение</tr>
      </property>
      <!-- @dub_to_stop_time -->
      <property name="@dub_to_stop_time" type="float" units="millisecond" default="20"
      minvalue="0">
        <tr lang="en">fade-out time while transitioning from overdub to stop</tr>
        <tr lang="ru">время затухания при переходе из overdub в остановку</tr>
      </property>
      <!-- @length -->
      <property name="@length" type="float" units="second" minvalue="0" default="0"
      access="readonly">
        <tr lang="en">recorded loop length</tr>
        <tr lang="ru">длина записанного цикла</tr>
      </property>
      <!-- @loop_bang -->
      <property name="@loop_bang" type="bool" default="1">
        <tr lang="en">output a bang on each loop start</tr>
        <tr lang="ru">выводить bang в начале каждого цикла</tr>
      </property>
      <!-- @loop_smooth -->
      <property name="@loop_smooth" type="float" units="millisecond" default="10" minvalue="0">
        <tr lang="en">duration of the linear fade-in/fade-out applied to the recorded loop for
        smooth playback</tr>
        <tr lang="ru">длительность линейного fade-in/fade-out, применяемого к записанному циклу
        для плавного воспроизведения</tr>
      </property>
      <!-- @play_phase -->
      <property name="@play_phase" type="float" minvalue="0" maxvalue="1" default="0"
      access="readonly">
        <tr lang="en">current playback phase position</tr>
        <tr lang="ru">текущая фазовая позиция воспроизведения</tr>
      </property>
      <!-- @play_pos -->
      <property name="@play_pos" type="float" units="second" minvalue="0" default="0"
      access="readonly">
        <tr lang="en">current playback position</tr>
        <tr lang="ru">текущая позиция воспроизведения</tr>
      </property>
      <!-- @play_to_dub_time -->
      <property name="@play_to_dub_time" type="float" units="millisecond" default="10"
      minvalue="0">
        <tr lang="en">fade-in time of the overdub input signal while transitioning from play
        mode</tr>
        <tr lang="ru">время нарастания входного сигнала overdub при переходе из режима
        воспроизведения</tr>
      </property>
      <!-- @play_to_stop_time -->
      <property name="@play_to_stop_time" type="float" units="millisecond" default="10"
      minvalue="0">
        <tr lang="en">fade-out time while transitioning from play to stop</tr>
        <tr lang="ru">время затухания при переходе из воспроизведения в остановку</tr>
      </property>
      <!-- @rec_to_play_time -->
      <property name="@rec_to_play_time" type="float" units="millisecond" default="30"
      minvalue="0">
        <tr lang="en">crossfade between the recorded and the input signal while transitioning from
        record to play</tr>
        <tr lang="ru">кроссфейд между записанным и входным сигналом при переходе из записи в
        воспроизведение</tr>
      </property>
      <!-- @round -->
      <property name="@round" type="int" units="sample" default="0" minvalue="0">
        <tr lang="en">increase the loop length to be a multiple of the specified value. If *0* — no
        rounding is performed</tr>
        <tr lang="ru">увеличить длину цикла до кратной заданному значению. Если *0* — округление
        не выполняется</tr>
      </property>
      <!-- @state -->
      <property name="@state" type="symbol" enum="init stop record play overdub" access="readonly"
      default="init">
        <tr lang="en">current state</tr>
        <tr lang="ru">текущее состояние</tr>
      </property>
      <!-- @stop_to_play_time -->
      <property name="@stop_to_play_time" type="float" units="millisecond" default="10"
      minvalue="0">
        <tr lang="en">fade-in time of playback while transitioning from stop</tr>
        <tr lang="ru">время нарастания воспроизведения при переходе из остановки</tr>
      </property>
    </properties>
    <methods>
      <!-- adjust -->
      <method name="adjust">
        <info>
          <tr lang="en">increases the loop length by the given delta</tr>
          <tr lang="ru">увеличивает длину цикла на заданное значение</tr>
        </info>
        <param name="DELTA" type="float" units="sample">
          <tr lang="en">loop length delta</tr>
          <tr lang="ru">приращение длины цикла</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clears the loop data and stops playback</tr>
          <tr lang="ru">очищает данные цикла и останавливает воспроизведение</tr>
        </info>
      </method>
      <!-- overdub -->
      <method name="overdub">
        <info>
          <tr lang="en">starts loop overdubbing while keeping it playing</tr>
          <tr lang="ru">запускает перезапись поверх (overdub), не прерывая воспроизведение
          цикла</tr>
        </info>
      </method>
      <!-- pause -->
      <method name="pause">
        <info>
          <tr lang="en">pauses the loop</tr>
          <tr lang="ru">ставит цикл на паузу</tr>
        </info>
      </method>
      <!-- play -->
      <method name="play">
        <info>
          <tr lang="en">plays the recorded or stopped loop</tr>
          <tr lang="ru">воспроизводит записанный или остановленный цикл</tr>
        </info>
      </method>
      <!-- rec -->
      <method name="rec">
        <info>
          <tr lang="en">same as record</tr>
          <tr lang="ru">то же, что record</tr>
        </info>
      </method>
      <!-- record -->
      <method name="record">
        <info>
          <tr lang="en">starts loop recording</tr>
          <tr lang="ru">запускает запись цикла</tr>
        </info>
      </method>
      <!-- smooth -->
      <method name="smooth">
        <param name="TIME" type="float" units="millisecond">
          <tr lang="en">applies a linear fade-in/fade-out to the loop</tr>
          <tr lang="ru">применяет линейный fade-in/fade-out к циклу</tr>
        </param>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stops the played loop</tr>
          <tr lang="ru">останавливает воспроизводимый цикл</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru">выходной сигнал</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">bang on each loop start if the @loop_bang property is true</tr>
          <tr lang="ru">bang в начале каждого цикла, если свойство @loop_bang истинно</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[adc~ 1]
|
| [record( [play( [overdub( [stop( [clear(
| |        |      |         |      |
| |        |      |         |      |
| |        |      |         |      |
[fx.looper~ @loop_bang 1           ]
|                        ^|
[ui.gain~ @size 120 14]  [B]  [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
