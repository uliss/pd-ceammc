<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="tl.bang">
    <title>tl.bang</title>
    <meta>
      <authors>
        <author>Alex Nadzharov</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">outputs a timeline bang</tr>
        <tr lang="ru">выводит событие bang временной шкалы</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>tl</category>
      <keywords>timeline bang</keywords>
      <since>0.1</since>
      <also>
        <see>tl.toggle</see>
        <see view="link">tl.cue</see>
      </also>
      <aliases>
        <alias>tl.b</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Outputs a bang only when the nearest left [tl.cue] is activated. If another
        cue is activated and the bang was scheduled via the @delay property, it is cancelled.</tr>
        <tr lang="ru">Выводит bang только тогда, когда активируется ближайший слева [tl.cue]. Если
        активируется другая метка, а bang был запланирован через свойство @delay, он
        отменяется.</tr>
      </par>
    </info>
    <arguments>
      <argument name="DELAY" type="float" minvalue="0" units="millisecond">
        <tr lang="en">bang delay after cue activation</tr>
        <tr lang="ru">задержка bang после активации метки</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @cue -->
      <property name="@cue" type="symbol" access="readonly" default="">
        <tr lang="en">related cue</tr>
        <tr lang="ru">связанная метка</tr>
      </property>
      <!-- @delay -->
      <property name="@delay" type="float" minvalue="0" default="0" units="millisecond">
        <tr lang="en">bang delay after cue activation</tr>
        <tr lang="ru">задержка bang после активации метки</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control inlet</tr>
          <tr lang="ru">управляющий вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="bang">
          <tr lang="en">bang output</tr>
          <tr lang="ru">вывод bang</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
        [tl.cue]           [tl.cue]

[HR number=2]    [tl.bang]                [tl.bang @delay 500]
|                |                        |
[cue $1(         [B]                      [B]
|
[tl.transport]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
