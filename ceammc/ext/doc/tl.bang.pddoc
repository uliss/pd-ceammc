<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="tl.bang">
        <title>tl.bang</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs a timeline bang</tr>
                <tr lang="ru">выводит пустое событие временной шкалы</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>tl</category>
            <keywords>timeline bang</keywords>
            <since>0.1</since>
            <also>
                <see>tl.toggle</see>
                <see view="link">tl.cue</see>
            </also>
            <aliases>
                <alias>tl.b</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Bang only when nearest left tl.cue was activated. If other cue is
                activated and bang was scheduled by @delay property - it canceled</tr>
            </par>
        </info>
        <arguments>
            <argument name="DELAY" type="float" minvalue="0" units="millisecond">
                <tr lang="en">timeline length</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @cue -->
            <property name="@cue" type="symbol" access="readonly" default="">
                <tr lang="en">related cue</tr>
            </property>
            <!-- @delay -->
            <property name="@delay" type="float" minvalue="0" default="0" units="millisecond">
                <tr lang="en">bang delay after cue activation</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">control inlet</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">bang output</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
        [tl.cue]           [tl.cue]

[HR number=3]    [tl.bang]                [tl.bang @delay 500]
|                |                        |
[cue $1(         [B]                      [B]
|
[tl.transport]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
