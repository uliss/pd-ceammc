<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="math.squared">
    <title>math.squared</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">value square</tr>
        <tr lang="ru">возведение в квадрат</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>math</category>
      <keywords>math square</keywords>
      <since>0.1</since>
      <aliases>
        <alias>math.^2</alias>
        <alias>ceammc/^2</alias>
        <alias>^2</alias>
      </aliases>
    </meta>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input number</tr>
          <tr lang="ru">входное число</tr>
        </in>
        <in on="list">
          <tr lang="en">list of numbers</tr>
          <tr lang="ru">список чисел</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">result</tr>
          <tr lang="ru">результат</tr>
        </out>
        <out type="list">
          <tr lang="en">result</tr>
          <tr lang="ru">результат</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]  [-2 -1 0 1 2(    [array \$0-pow2 yr=0..1 w=140]
|    |
[math.squared]
|
[ui.dt]

[bang(
|
[list.seq -1 1 0.025]
|
[math.squared]
|
[list->array \$0-pow2]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
