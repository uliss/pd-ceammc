<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="math.squared">
        <title>math.squared</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">value square</tr>
                <tr lang="ru">возведение в квадрат</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math square</keywords>
            <since>0.1</since>
            <aliases>
                <alias>math.^2</alias>
                <alias>ceammc/^2</alias>
                <alias>^2</alias>
            </aliases>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input value</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">list of numbers</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]  [-2 -1 0 1 2(
|    |
[math.squared]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
