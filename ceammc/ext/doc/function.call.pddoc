<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="function.call">
        <title>function.call</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">calls the named function</tr>
                <tr lang="ru">вызывает именованную функцию</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>function call</keywords>
            <aliases>
                <alias>func.call</alias>
            </aliases>
            <also>
                <see view="link">function</see>
            </also>
            <since>0.3</since>
        </meta>
        <arguments>
            <argument name="NAME" type="symbol">
                <tr lang="en">function name</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @name -->
            <property name="@name" type="symbol" default="">
                <tr lang="en">function name</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>input value</xinfo>
            </inlet>
            <inlet>
                <xinfo on="symbol">change function name</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>function result</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[function f1]X[sin]

[function f2]X[sqrt]

[F]   [symbol f1( [symbol f2(
|     |.             |.
[func.call          f1]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
