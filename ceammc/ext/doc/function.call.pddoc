<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="function.call">
    <title>function.call</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">calls the named function</tr>
        <tr lang="ru">вызывает именованную функцию</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>function call</keywords>
      <aliases>
        <alias>func.call</alias>
      </aliases>
      <also>
        <see view="link">function</see>
      </also>
      <since>0.3</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object calls a function previously defined by the [function] object and outputs its result</tr>
        <tr lang="ru">объект вызывает функцию, ранее определённую объектом [function], и выводит её результат</tr>
      </par>
    </info>
    <arguments>
      <argument name="NAME" type="symbol">
        <tr lang="en">function name</tr>
        <tr lang="ru">имя функции</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @name -->
      <property name="@name" type="symbol" default="">
        <tr lang="en">function name</tr>
        <tr lang="ru">имя функции</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input value</tr>
          <tr lang="ru">входное значение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="symbol">
          <tr lang="en">change function name</tr>
          <tr lang="ru">изменить имя функции</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">function result</tr>
          <tr lang="ru">результат функции</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[function f1]X[sin]

[function f2]X[sqrt]

[F]   [symbol f1( [symbol f2(
|     |.             |.
[func.call          f1]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
