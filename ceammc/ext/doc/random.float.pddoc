<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="random.float">
        <title>random.float</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">uniform random generator of floats in the specified range</tr>
                <tr lang="ru">равномерный генератор случайных чисел с плавающей точкой в заданном
                диапазоне</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>random</category>
            <keywords>random float</keywords>
            <since>0.1</since>
            <also>
                <see>random.int</see>
                <see>random.gauss</see>
            </also>
            <aliases>
                <alias>random.f</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">generates a random floating-point value uniformly distributed in the
                range [min..max)</tr>
            </par>
            <par>
                <tr lang="en">Use @seed property to get reproducible sequences. If @seed property
                was not explicitly set or specified, uses generator initialized with current
                time.</tr>
            </par>
            <par>
                <tr lang="en">Algorithm: 32-bit Mersenne Twister by Matsumoto and Nishimura,
                1998</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Mersenne_Twister">wiki: Mersenne Twister</a>
        </info>
        <arguments>
            <argument name="ARG" type="list">
                <tr lang="en">@min=ARG[0], @max=ARG[1], in case of signle arg: @min=0,
                @max=ARG[0]</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @max -->
            <property name="@max" type="float" default="1">
                <tr lang="en">random range upper bound</tr>
            </property>
            <!-- @min -->
            <property name="@min" type="float" default="0">
                <tr lang="en">random range lower bound</tr>
            </property>
            <!-- @seed -->
            <property name="@seed" type="int" minvalue="0" default="0">
                <tr lang="en">generator seed</tr>
            </property>
        </properties>
        <methods>
            <!-- gen -->
            <method name="gen">generate list of random floats with specified length 
            <param name="N" type="int" required="true" minvalue="1">
                <tr lang="en">list length</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">generate new number</xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">set @min property</xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">set @max property</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>float ot list: result value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]  [@seed 0( [gen 5(
|    |         |
|    |         |
|    |         |
[random.float 1 3]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
