<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="speech.flite~">
    <title>speech.flite~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Flite text-to-speech synthesis</tr>
        <tr lang="ru">синтезатор речи Flite</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>misc</category>
      <keywords>speak speech flite</keywords>
      <since>0.9.2</since>
      <also>
        <see>speech.flite</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Speaks floats, symbols, and lists as audio using the Flite TTS engine.</tr>
        <tr lang="ru">Озвучивает числа, символы и списки с помощью движка синтеза речи Flite.</tr>
      </par>
    </info>
    <properties>
      <!-- @pitch -->
      <property name="@pitch" type="float" default="-1">
        <tr lang="en">voice pitch (-1 means default value)</tr>
        <tr lang="ru">высота голоса (-1 означает значение по умолчанию)</tr>
      </property>
      <!-- @speed -->
      <property name="@speed" type="float" minvalue="0.5" maxvalue="4" default="1">
        <tr lang="en">speaking speed</tr>
        <tr lang="ru">скорость речи</tr>
      </property>
      <!-- @voice -->
      <property name="@voice" type="symbol" default="kal16" enum="kal16 slt rms awb">
        <tr lang="en">default voice</tr>
        <tr lang="ru">голос по умолчанию</tr>
      </property>
    </properties>
    <methods>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stops speech and clears the speech queue</tr>
          <tr lang="ru">останавливает речь и очищает очередь произнесения</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">speak a number</tr>
          <tr lang="ru">произнести число</tr>
        </in>
        <in on="symbol">
          <tr lang="en">speak text</tr>
          <tr lang="ru">произнести текст</tr>
        </in>
        <in on="list">
          <tr lang="en">speak text as a list of words</tr>
          <tr lang="ru">произнести текст из списка слов</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output audio signal</tr>
          <tr lang="ru">выходной аудиосигнал</tr>
        </out>
      </outlet>
      <outlet>
        <out type="int">
          <tr lang="en">number of sentences remaining in the queue</tr>
          <tr lang="ru">количество предложений, оставшихся в очереди</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[metro 1000]  [ui.menu kal16 slt rms awb] [ui.knob @min 1 @max 4]
|             |                           |
[flow.count]  [@voice $2( [F]             |
|             |           |               |
|             |           [@pitch $1(     [@speed $1(
|             |           |               |
[speech.flite~                            ]
|        ^|
|        [ui.dt]
|
[ui.gain~ @size 120 16]   [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
