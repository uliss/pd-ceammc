#X declare -lib ceammc;
#X obj 310 50 cnv 1 455 23 empty empty empty 17 7 0 10 -245760 -1 0;
#X text 315 50 simple formant/vocal synthesizer with FOF-cycle filterbank.;
#X obj 1 1 cnv 5 765 40 empty empty synth.voice_fofc~ 20 20 0 20
-104026 -4096 0;
#X obj 616 11 synth.voice_fofc~;
#X obj 230 78 cnv 1 535 230 empty empty empty 17 7 0 10 -257983 -1 0;
#X text 240 83 Simple formant/vocal synthesizer based on a source/filter
model. The source is just a periodic impulse and the "filter" is a
bank of FOF filters.;
#X text 240 138 Formant parameters are linearly interpolated allowing
to go smoothly from one vowel to another. Voice type can be selected
but must correspond to the frequency range of the synthesized voice
to be realistic.;
#X text 240 208 A cycle of 12 FOF filters with sample-and-hold is used
so that the fof filter parameters can be varied in realtime.;
#X text 240 263 This technique is more robust but more computationally
expensive than FofSmooth;
