<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="osc.blit~">
        <title>osc.blit~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">bandlimited oscillator with controllable harmonics</tr>
                <tr lang="ru">генератор с ограниченным спектром и управлением гармониками</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>osc</category>
            <keywords>oscillator band-limited</keywords>
            <since>0.6</since>
            <also>
                <see>osc.saw~</see>
                <see>osc.square~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="0">
                <tr lang="en">default frequency (440hz if not specified)</tr>
            </argument>
            <argument name="HARMONICS" type="int" minvalue="0">
                <tr lang="en">number of harmonics. Missing or 0 means all available harmonics until
                SR/2</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @harmonics -->
            <property name="@harmonics" type="int" minvalue="0" default="0">
                <tr lang="en">number of harmonics. 0 means all available harmonics until SR/2</tr>
            </property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">frequency in Hz</tr>
                </xinfo>
            </inlet>
            <inlet type="control">
                <xinfo on="bang">
                    <tr lang="en">reset phase</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F digits=10]    [F]    [3(  [6( [0(
|                |      |    |   |
[sig~]           [@harmonics     $1(
|                |
|                |
[osc.blit~ 2000 4]
|
|
|
[ui.spectroscope~ @size 150 100]






[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
