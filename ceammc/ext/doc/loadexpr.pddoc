<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="loadexpr">
    <title>loadexpr</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">sends the message when the patch loads</tr>
        <tr lang="ru">отправляет сообщение при загрузке патча</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>msg</category>
      <keywords>message loadbang onload</keywords>
      <since>0.9.2</since>
      <also>
        <see>loadmsg</see>
      </also>
      <aliases>
        <alias>ceammc/loadexpr</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">like [loadmsg], but supports expression calls and data types</tr>
        <tr lang="ru">как [loadmsg], но поддерживает вызовы выражений и типы данных</tr>
      </par>
      <par>
        <tr lang="en">click on the object to send the message again</tr>
        <tr lang="ru">клик по объекту повторно отправляет сообщение</tr>
      </par>
      <par>
        <tr lang="en">the message is sent once when the patch is loaded and again on each
        click</tr>
        <tr lang="ru">сообщение отправляется один раз при загрузке патча и повторно при каждом
        клике</tr>
      </par>
      <par>
        <tr lang="en">comma-separated messages are supported</tr>
        <tr lang="ru">поддерживаются сообщения, разделённые запятыми</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">output again</event>
    </mouse>
    <arguments>
      <argument name="ARGS" type="list">
        <tr lang="en">message. Comma-separated messages are supported</tr>
        <tr lang="ru">сообщение. Поддерживаются сообщения, разделённые запятыми</tr>
      </argument>
    </arguments>
    <inlets />
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">message output</tr>
          <tr lang="ru">выход сообщения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*click me!*/

[loadexpr symbol "with space" \, pi() \, mtof(60 61) \, \[a: 1 2 3 b: 4 5 6\]]
|       |
|       |
|       |
|       [flow.space 50]
|       |
[print] [ui.dt @auto_size 0]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
