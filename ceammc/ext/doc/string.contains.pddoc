<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="string.contains">
        <title>string.contains</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks if the string contains specified substring</tr>
                <tr lang="ru">проверяет, содержит ли строка указанную подстроку</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>string</category>
            <keywords>contains search</keywords>
            <since>0.3</since>
            <aliases>
                <alias>str.contains</alias>
            </aliases>
            <also>
                <see>str.ends_with</see>
            </also>
        </meta>
        <arguments>
            <argument name="SUBJ" type="symbol">
                <tr lang="en">searched substring</tr>
                <tr lang="ru" finished="false">Поисковая строка</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @subj -->
            <property name="@subj" type="symbol" default="">
                <tr lang="en">searched substring</tr>
                <tr lang="ru" finished="false">Поисковая строка</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">input string or symbol</tr>
                    <tr lang="ru" finished="false">входная строка или символ</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">search substring (string or symbol)</tr>
                    <tr lang="ru" finished="false">Поисковая строка (строка или символ)</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output 1 if input string contains specified substring, otherwise
                    0</tr>
                    <tr lang="ru" finished="false">выход 1 если входная строка содержит указанную
                    подстроку, иначе 0</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[string test] [symbol message(  [symbol simple(
|             |                 |
|             |                 |
|             |                 |
[str.contains                 es]
|
[T]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
