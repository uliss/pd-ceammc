<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="midi.clock">
    <title>midi.clock</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">MIDI clock</tr>
        <tr lang="ru">MIDI-клок</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>midi</category>
      <keywords>midi clock</keywords>
      <since>0.9.2</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Note: because Pd messages are processed between DSP blocks, the measured bpm
        is not exact.</tr>
        <tr lang="ru">Примечание: поскольку сообщения Pd обрабатываются между блоками DSP,
        измеренный BPM неточен.</tr>
      </par>
    </info>
    <arguments>
      <argument name="DIV" type="int" enum="0 4 8 16 32">
        <tr lang="en">clock subdivision</tr>
        <tr lang="ru">деление MIDI-клока</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @div -->
      <property name="@div" type="int" enum="0 4 8 16 32" default="0">
        <tr lang="en">clock subdivision: 0 — bang on every incoming MIDI clock message, 4 — every
        quarter note, 8 — every eighth note, etc.</tr>
        <tr lang="ru">деление MIDI-клока: 0 — bang на каждое входящее MIDI-сообщение клока, 4 —
        каждая четверть, 8 — каждая восьмая и т.д.</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset beat counter</tr>
          <tr lang="ru">сбросить счётчик долей</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control input</tr>
          <tr lang="ru">вход управления</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="bang">
          <tr lang="en">bang: on the specified beat</tr>
          <tr lang="ru">bang: на указанной доле</tr>
        </out>
      </outlet>
      <outlet>
        <out type="float">
          <tr lang="en">measured bpm (output on every beat)</tr>
          <tr lang="ru">измеренный BPM (выводится на каждой доле)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[midi.clock 8] /*bang every eight note*/
|        ^|
[click~]  [F]              [T]    [F] /*24 pulses per quoter note*/
|                          |      |.
[flt.resonbp~ 1440 40]     [metro 10]
|                          |
[ui.hgain~]                [\\\; \#midirealtimein 1 248(  [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
