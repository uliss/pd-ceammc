<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="radio">
        <title>radio</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">upon receiving the index, the state of individual outputs is
                established as a radio switch</tr>
                <tr lang="ru">при поступлении индекса устанавлиет состояние отдельных выходов как
                радиопереключатель</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>radio</keywords>
            <since>0.6</since>
            <also>
                <see>hradio</see>
            </also>
            <aliases>
                <alias>ceammc/radio</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="2" maxvalue="24">
                <tr lang="en">number of outlets</tr>
                <tr lang="ru" finished="false">количество торговых точек</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @n -->
            <property name="@n" type="int" minvalue="2" maxvalue="24" default="2"
            access="initonly">
                <tr lang="en">number of outlets</tr>
                <tr lang="ru" finished="false">количество торговых точек</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">output zeroes to all outlets</tr>
                    <tr lang="ru" finished="false">нулевой выход для всех точек</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">index</tr>
                    <tr lang="ru" finished="false">индекс</tr>
                </in>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet>
                <out type="any">
                    <tr lang="en">first output</tr>
                    <tr lang="ru" finished="false">первый выход</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">first output</tr>
                    <tr lang="ru" finished="false">первый выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.radio @nitems 4]
|
|
|
|  [reset(
|  |
[radio           4]
|   ^|   ^^|   ^^^|
[T]  [T]   [T]    [T]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
