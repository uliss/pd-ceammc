<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="conv.int2bits">
        <title>conv.int2bits</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert integer to list of bits</tr>
                <tr lang="ru">конвертировать целое число в список битов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv bits int</keywords>
            <since>0.9.1</since>
            <aliases>
                <alias>ceammc/int-&gt;bits</alias>
                <alias>int-&gt;bits</alias>
            </aliases>
            <also>
                <see>conv.bits2int</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: negative numbers converted using machine architecture, commonly
                two's complement</tr>
                <tr lang="ru" finished="false">Примечание: отрицательные числа, преобразованные с
                использованием машинной архитектуры, обычно два дополнения</tr>
            </par>
            <wiki name="Two%27s_complement">Two's complement</wiki>
        </info>
        <arguments>
            <argument name="SIZE" type="int" minvalue="1" maxvalue="32">
                <tr lang="en">output bit-length</tr>
                <tr lang="ru">выходная длина в битах</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @rev -->
            <property name="@rev" type="bool" default="0">
                <tr lang="en">reversed bit order</tr>
                <tr lang="ru" finished="false">Обратный порядок битов</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="int" minvalue="1" maxvalue="32" default="32">
                <tr lang="en">output bit-length</tr>
                <tr lang="ru" finished="false">выходная битовая длина</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input value</tr>
                    <tr lang="ru" finished="false">входная стоимость</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">list of bits</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[int->bits 16]
|
[ui.hrd* 16]

[F]
|
[1 $1(
|
[<< {i=2,o=1}]
|
[int->bits 32 @rev 1]
|
[ui.hrd* 32]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
