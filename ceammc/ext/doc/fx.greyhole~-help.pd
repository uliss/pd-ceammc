#N canvas 0 0 785 555 12;
#X declare -lib ceammc;
#X obj 560 50 cnv 1 205 23 empty empty empty 17 7 0 10 -245760 -1 0;
#X text 565 50 a complex echo-like effect;
#X obj 1 1 cnv 5 765 40 empty empty fx.greyhole~ 20 20 0 20 -104026
-4096 0;
#X obj 652 11 fx.greyhole~;
#X obj 230 78 cnv 1 535 305 empty empty empty 17 7 0 10 -237178 -1 0;
#X text 240 83 a complex echo-like effect inspired by the classic Eventide
effect of a similar name \, which consists of a diffuser (like a mini-reverb
\, structurally similar to the one used in JPverb) connected in a feedback
system with a long modulated delay line;
#X text 240 168 the effect excels at producing spacey washes of sound;
#X text 240 193 @feedback sets the amount of feedback in the delay
line \, @delaytime sets the approximate delay time;
#X text 240 233 @size \, @diffusion and @damping shape the diffusion
unit \, @moddepth and @modfreq control the modulation of the delay
line;
#X text 240 288 @drywet controls the balance between the original (dry)
and processed signal \, @bypass disables processing entirely;
#X text 240 343 developed as part of the DEIND project;
#X msg 50 431 1000 1000 0 \, 300 300 1000 \, 3000 500 1300 \, 0 100 1400;
#X obj 50 460 vline~;
#X obj 50 489 osc.saw~;
#X obj 50 518 fx.greyhole~;
#X obj 213 518 ui.hsl;
#X obj 50 561 *~;
#X obj 126 561 *~;
#X obj 50 604 dac~;
