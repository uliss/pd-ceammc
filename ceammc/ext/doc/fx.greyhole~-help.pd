0\. Range: [0\..0.99].;
#X obj 250 717 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 717 @delaytime;
#X text 270 717 Approximate delay time in seconds. Type: float. Units:
