#X obj 735 493 ui.link @background_color 0.98039 0.98039 0.98039
@title [?] @url ceammc.props-info.pd;
#X msg 110 525 @id;
#X text 245 525 (initonly) Get/Set OSC address id. If specified \,
bind all properties to /ID/fx_greyhole/PROP_NAME osc address \, if
empty bind to /fx_greyhole/PROP_NAME. Type: symbol.;
#X msg 110 582 @osc;
#X text 245 582 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 110 612 @active;
#X text 245 612 Turn on/off object dsp processing. Type: bool. Default
value: 1\.;
#X msg 110 654 @bypass;
#X text 245 654 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 110 696 @damping;
#X text 245 696 Get/Set controls damping of high-frequencies as the
delay decays. 0 is no damping \, 1 is very strong damping. Type: float.
Default value: 0\. Range: 0\...0.99\.;
#X msg 110 753 @delaytime;
#X text 245 753 Get/Set approximate delay time in seconds. Type: float.
Units: 'sec'. Default value: 0.2\. Range: 0.001\...1.45\.;
#X msg 110 795 @diffusion;
#X text 245 795 Get/Set shape of the diffusion unit. Values greater
than 0.707 produce smooth exponential decay. Lower values produce a
slower build-up of echoes. Type: float. Default value: 0.5\. Range:
0\...0.99\.;
#X msg 110 882 @drywet;
#X text 245 882 Get/Set proportion of mix between the original (dry)
and 'effected' (wet) signals. 0 - dry signal \, 1 - wet. Type: float.
Default value: 1\. Range: 0\...1\.;
#X msg 110 939 @feedback;
#X text 245 939 Get/Set amount of feedback for the delay line. Type:
float. Default value: 0.9\. Range: 0\...1\.;
#X msg 110 981 @moddepth;
#X text 245 981 Get/Set depth of delay-line modulation. Use in combination
with *@modfreq* to set amount of chorusing within the structure. Type:
float. Default value: 0.1\. Range: 0\...1\.;
#X msg 110 1038 @modfreq;
#X text 245 1038 Get/Set frequency of delay-line modulation. Use in
combination with *@moddepth* to set amount of chorusing within the
structure. Type: float. Default value: 2\. Range: 0\...10\.;
#X msg 110 1125 @size;
#X text 245 1125 Get/Set size of delay-lines within the diffusion unit
\, producing the impression of a larger or smaller space. Values below
1 can sound quite metallic. Type: float. Default value: 1\. Range:
0.5\...3\.;
