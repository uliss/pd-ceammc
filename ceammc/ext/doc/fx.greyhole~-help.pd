-49933 0;
#X obj 735 493 ui.link @background_color 0.98039 0.98039 0.98039
@title [?] @url ceammc.props-info.pd;
#X msg 130 491 @id;
#X text 270 491 (initonly) OSC address id. If specified \, bind all
properties to /ID/fx_greyhole/PROP_NAME osc address \, if empty bind
to /fx_greyhole/PROP_NAME. Type: symbol.;
#X msg 130 548 @osc;
#X text 270 548 (initonly) OSC server name to listen. Type: symbol.;
#X msg 130 578 @active;
#X text 270 578 On/off object dsp processing. Type: bool. Default value:
1\.;
#X msg 130 608 @bypass;
#X text 270 608 Bypass flag. If true: bypass 'effected' signal. Type:
bool. Default value: 0\.;
#X msg 130 650 @damping;
#X text 270 650 Controls damping of high-frequencies as the delay decays.
0 is no damping \, 1 is very strong damping. Type: float. Default value:
0\. Range: 0\...0.99\.;
#X msg 130 707 @delaytime;
#X text 270 707 Approximate delay time in seconds. Type: float. Units:
'sec'. Default value: 0.2\. Range: 0.001\...1.45\.;
#X msg 130 749 @diffusion;
#X text 270 749 Shape of the diffusion unit. Values greater than 0.707
produce smooth exponential decay. Lower values produce a slower build-up
of echoes. Type: float. Default value: 0.5\. Range: 0\...0.99\.;
#X msg 130 821 @drywet;
#X text 270 821 Proportion of mix between the original (dry) and 'effected'
(wet) signals. 0 - dry signal \, 1 - wet. Type: float. Default value:
1\. Range: 0\...1\.;
#X msg 130 878 @feedback;
#X text 270 878 Amount of feedback for the delay line. Type: float.
Default value: 0.9\. Range: 0\...1\.;
#X msg 130 920 @moddepth;
#X text 270 920 Depth of delay-line modulation. Use in combination
with *@modfreq* to set amount of chorusing within the structure. Type:
float. Default value: 0.1\. Range: 0\...1\.;
#X msg 130 992 @modfreq;
#X text 270 992 Frequency of delay-line modulation. Use in combination
with *@moddepth* to set amount of chorusing within the structure. Type:
float. Default value: 2\. Range: 0\...10\.;
#X msg 130 1064 @size;
#X text 270 1064 Size of delay-lines within the diffusion unit \, producing
the impression of a larger or smaller space. Values below 1 can sound
quite metallic. Type: float. Default value: 1\. Range: 0.5\...3\.;
