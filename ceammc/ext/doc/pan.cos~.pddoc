<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="pan.cos~">
    <title>pan.cos~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">two-channel equal power sine/cosine panner</tr>
        <tr lang="ru">двухканальный панорамный регулятор равной мощности на основе
        синуса/косинуса</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>spat</category>
      <keywords>pan span</keywords>
      <since>0.5</since>
      <also>
        <see>pan.lin~</see>
        <see>pan.sqrt~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Two-channel equal power panner. The center pan position is boosted by 3dB
        compared to linear panning, and the total power at every pan position is 0dB.</tr>
        <tr lang="ru">Двухканальный панорамный регулятор равной мощности. Позиция центра
        панорамирования усилена на 3 дБ по сравнению с линейным панорамированием, а общая мощность
        в каждой позиции панорамирования составляет 0 дБ.</tr>
      </par>
    </info>
    <arguments>
      <argument name="POS" type="float" minvalue="-1" maxvalue="1">
        <tr lang="en">panning position. -1 means left, 0 means center, +1 means right.</tr>
        <tr lang="ru">позиция панорамирования. -1 означает левый канал, 0 — центр, +1 — правый
        канал.</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @pos -->
      <property name="@pos" type="float" minvalue="-1" maxvalue="1" default="0">
        <tr lang="en">panning position. -1 means left, 0 means center, +1 means right.</tr>
        <tr lang="ru">позиция панорамирования. -1 означает левый канал, 0 — центр, +1 — правый
        канал.</tr>
      </property>
      <!-- @smooth -->
      <property name="@smooth" type="int" minvalue="0" maxvalue="100" default="20"
      access="initonly">
        <tr lang="en">smoothing of the control signal to avoid zipper noise.</tr>
        <tr lang="ru">сглаживание управляющего сигнала для предотвращения шума квантования.</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float" minvalue="-1" maxvalue="1">
          <tr lang="en">pan position</tr>
          <tr lang="ru">позиция панорамирования</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left output channel</tr>
          <tr lang="ru">левый выходной канал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right output channel</tr>
          <tr lang="ru">правый выходной канал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
          [hsl]
          |
          [lin->lin 0 127 -1 1]
          |
[sig~ 1]  [F]
|         |.
[pan.cos~  ]
|       ^|
[env~]   [env~]
|        |
[F]      [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
