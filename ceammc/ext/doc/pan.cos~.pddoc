<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="pan.cos~">
        <title>pan.cos~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">two channel equal power sine/cosine panner</tr>
                <tr lang="ru">двухканальное косинусное панорамирование равной мощности</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>pan span</keywords>
            <since>0.5</since>
            <also>
                <see>pan.lin~</see>
                <see>pan.sqrt~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Two channel equal power panner. The center pan position is boosted by
                3 dB compared to linear panning, and the total power at every pan position is 0
                dB.</tr>
            </par>
        </info>
        <arguments>
            <argument name="POS" type="float" minvalue="-1" maxvalue="1">
                <tr lang="en">panning position. -1 means left, 0 - center, +1 - right</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @pos -->
            <property name="@pos" type="float" minvalue="-1" maxvalue="1" default="0">
                <tr lang="en">panning position. -1 means left, 0 - center, +1 - right</tr>
            </property>
            <!-- @smooth -->
            <property name="@smooth" type="int" minvalue="0" maxvalue="100" default="20"
            access="initonly">
                <tr lang="en">smooth control signal to avoid zipping-noise</tr>
            </property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float" minvalue="-1" maxvalue="1">
                    <tr lang="en">pan position</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">left output channel</outlet>
            <outlet type="audio">right output channel</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
          [hsl]
          |
          [lin->lin 0 127 -1 1]
          |
[sig~ 1]  [F]
|         |.
[pan.cos~  ]
|       ^|
[env~]   [env~]
|        |
[F]      [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
