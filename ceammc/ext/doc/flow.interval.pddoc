<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.interval">
    <title>flow.interval</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">measure the time between messages</tr>
        <tr lang="ru">измеряет время между сообщениями</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>time interval</keywords>
      <since>0.6</since>
      <also>
        <see>timer</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object measures the time in milliseconds between the current and the
        previous message received on the inlet</tr>
        <tr lang="ru">объект измеряет время в миллисекундах между текущим и предыдущим сообщением,
        полученным на входе</tr>
      </par>
      <par>
        <tr lang="en">the first message after the object is created produces no output, since there
        is no previous message to compare with</tr>
        <tr lang="ru">первое сообщение после создания объекта не даёт вывода, так как нет
        предыдущего сообщения для сравнения</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="any">
          <tr lang="en">input flow</tr>
          <tr lang="ru">входной поток</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">output time between the current and the previous message in
          milliseconds</tr>
          <tr lang="ru">время между текущим и предыдущим сообщением в миллисекундах</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]      [F]
|        |.
[metro 100]
|
|  [F]
|  |
[flow.interval]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
