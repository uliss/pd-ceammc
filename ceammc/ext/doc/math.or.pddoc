<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.or">
        <title>math.or</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">operation OR for multiple arguments</tr>
                <tr lang="ru">операция ИЛИ для множества аргументов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math or logic</keywords>
            <also>
                <see>math.and</see>
            </also>
            <aliases>
                <alias>ceammc/or</alias>
                <alias>or</alias>
            </aliases>
            <since>0.2</since>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="3" maxvalue="16">
                <tr lang="en">number of arguments</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @n -->
            <property name="@n" type="int" access="initonly" minvalue="3" maxvalue="16"
            default="3">
                <tr lang="en">number of arguments</tr>
            </property>
            <!-- @state -->
            <property name="@state" type="list" access="readonly" default="">
                <tr lang="en">internal logic state as list of 1 and 0</tr>
            </property>
            <!-- @sync -->
            <property name="@sync" type="flag" default="0" access="initonly">
                <tr lang="en">if specified - all inlets are 'hot'</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">resets all input states to false</tr>
                </info>
            </method>
        </methods>
        <inlets dynamic="true">
            <inlet>
                <xinfo on="float">
                    <tr lang="en">1 or 0</tr>
                </xinfo>
            </inlet>
            <inlet number="...">
                <xinfo on="float">
                    <tr lang="en">1 or 0</tr>
                </xinfo>
            </inlet>
            <inlet number="n">
                <xinfo on="float">
                    <tr lang="en">1 or 0</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>1 - if all input values are true (1), 0 - otherwise</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[HS]
|
[> 50]  [HS]
|       |
|       [> 50] [HS]
|       |      |
|       |      [< 50]
|       |.     |..
[math.or       3 @sync]
|
[F]
|
[B]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
