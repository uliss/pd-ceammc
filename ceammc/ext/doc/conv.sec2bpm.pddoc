<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.sec2bpm">
    <title>conv.sec2bpm</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts period in seconds to frequency in BPM</tr>
        <tr lang="ru">преобразует период в секундах в темп BPM</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv time</keywords>
      <also>
        <see>conv.bpm2sec</see>
        <see>conv.ms2bpm</see>
      </also>
      <since>0.9.1</since>
      <aliases>
        <alias>ceammc/sec-&gt;bpm</alias>
        <alias>sec-&gt;bpm</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts a period in seconds (the time between two consecutive
        beats) to a BPM tempo. The conversion is simply 60 / period_sec, but the object makes the
        patch more readable and self-documenting. This is the inverse operation of
        [conv.bpm2sec].</tr>
        <tr lang="ru">Объект преобразует период в секундах (время между двумя последовательными
        ударными долями) в темп BPM. Преобразование сводится к 60 / период_сек, но объект делает
        патч более читаемым и самодокументируемым. Это операция, обратная [conv.bpm2sec].</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">period in seconds</tr>
          <tr lang="ru">период в секундах</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">tempo in BPM</tr>
          <tr lang="ru">темп в BPM</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[1(  [2(  [0.5(
|    |    |
[sec->bpm ]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
