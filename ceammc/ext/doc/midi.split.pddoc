<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="midi.split">
    <title>midi.split</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">MIDI note range splitter</tr>
        <tr lang="ru">разделяет MIDI-ноты на диапазоны</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>midi</category>
      <keywords>midi note splitter</keywords>
      <since>0.9.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Split MIDI note messages at the specified pitch values</tr>
        <tr lang="ru">разделяет MIDI-сообщения нот по заданным значениям высоты</tr>
      </par>
      <par>
        <tr lang="en">the number of outlets is one more than the number of split points</tr>
        <tr lang="ru">количество выходов на единицу больше количества точек разделения</tr>
      </par>
      <par style="important">
        <tr lang="en">split points must be in strict ascending order</tr>
        <tr lang="ru">точки разделения должны идти строго по возрастанию</tr>
      </par>
    </info>
    <arguments>
      <argument name="NOTES" type="list">
        <tr lang="en">list of note values (split points)</tr>
        <tr lang="ru">список значений нот (точки разделения)</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @points -->
      <property name="@points" type="list" access="readonly" default="">
        <tr lang="en">split points, must be in strict ascending order</tr>
        <tr lang="ru">точки разделения, должны идти строго по возрастанию</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">NOTE VELOCITY [DUR] list</tr>
          <tr lang="ru">список НОТА СИЛА_НАЖАТИЯ [ДЛИТ]</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="list">
          <tr lang="en">MIDI pitches less than the first split point</tr>
          <tr lang="ru">MIDI-ноты меньше первой точки разделения</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="list">
          <tr lang="en">...</tr>
          <tr lang="ru">...</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="list">
          <tr lang="en">MIDI pitches greater than or equal to the N-th split point and less than
          N+1</tr>
          <tr lang="ru">MIDI-ноты больше или равные N-й точке разделения и меньше N+1</tr>
        </out>
      </outlet>
      <outlet number="n+1">
        <out type="list">
          <tr lang="en">notes greater than or equal to the last split point</tr>
          <tr lang="ru">ноты больше или равные последней точке разделения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
[midi.split 40 60 80 #x]
|
[ui.dt #a]

      [ui.dt #b]

            [ui.dt #c]

                  [ui.dt #d]
[X x:0->a]
[X x:1->b]
[X x:2->c]
[X x:3->d]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
