<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="ui.faust~" type="gui">
        <title>ui.faust~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Faust DSP programming language widget</tr>
                <tr lang="ru">виджет языка программирования Faust</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">lang</category>
            <keywords>faust</keywords>
            <since>0.9.2</since>
        </meta>
        <info>
            <a href="https://faust.grame.fr/">https://faust.grame.fr/</a>
        </info>
        <mouse>
            <event type="move" editmode="false" empty="true" />
            <event type="left-click" editmode="false" keys="Alt">open the Faust source code
            editor</event>
            <event type="drop-file" editmode="false">read Faust code from the dropped file</event>
            <event type="drop-text" editmode="false">no action</event>
            <event type="right-click" editmode="false">open popup menu</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Shift">open object help</event>
        </mouse>
        <arguments>
            <argument name="LOAD" type="symbol">
                <tr lang="en">initial file to load after object creation</tr>
                <tr lang="ru" finished="false">Загрузка исходного файла после создания объекта</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @active -->
            <property name="@active" type="bool" default="1">
                <tr lang="en">on/off dsp processing</tr>
                <tr lang="ru" finished="false">Обработка in/off</tr>
            </property>
            <!-- @include -->
            <property name="@include" type="list" default="">
                <tr lang="en">list of faust include directories</tr>
                <tr lang="ru" finished="false">Список faust включает каталоги</tr>
            </property>
            <!-- @load -->
            <property name="@load" type="symbol" default="" access="initonly">
                <tr lang="en">initial file to load after object creation</tr>
                <tr lang="ru" finished="false">Загрузка исходного файла после создания объекта</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="10 10">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
            <!-- @style -->
            <property name="@style" type="int" default="0">
                <tr lang="en">view style</tr>
            </property>
        </properties>
        <methods>
            <!-- open -->
            <method name="open">
                <info>
                    <tr lang="en">open faust dsp file in external editor</tr>
                    <tr lang="ru" finished="false">Открытый файл faust dsp во внешнем
                    редакторе</tr>
                </info>
            </method>
            <!-- read -->
            <method name="read">
                <info>
                    <tr lang="en">read Faust code from file and compile it.</tr>
                    <tr lang="ru" finished="false">Прочитайте код Faust из файла и скомпилируйте
                    его.</tr>
                </info>
                <param name="FILE" type="symbol" required="true">
                    <tr lang="en">file path, absolute or relative to patch, include
                    directories</tr>
                    <tr lang="ru" finished="false">Путь файла, абсолютный или относительный с
                    патчем, включает каталоги</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset object state</tr>
                    <tr lang="ru" finished="false">Сброс состояния объекта</tr>
                </info>
            </method>
            <!-- size -->
            <method name="size">
                <info>
                    <tr lang="en">resize object</tr>
                    <tr lang="ru" finished="false">размер объекта</tr>
                </info>
                <param name="W" type="int" required="true">
                    <tr lang="en">new width</tr>
                    <tr lang="ru" finished="false">Новая ширина</tr>
                </param>
                <param name="H" type="int" required="true">
                    <tr lang="en">new height</tr>
                    <tr lang="ru" finished="false">Новая высота</tr>
                </param>
            </method>
            <!-- write -->
            <method name="write">
                <info>
                    <tr lang="en">write Faust code to file.</tr>
                    <tr lang="ru" finished="false">Запишите код Фауста в файл.</tr>
                </info>
                <param name="FILE" type="symbol" required="true">
                    <tr lang="en">file path, absolute or relative to patch</tr>
                    <tr lang="ru" finished="false">Путь файла, абсолютный или относительный для
                    патча</tr>
                </param>
                <param name="@force" type="property" required="false">
                    <tr lang="en">overwrite existing files</tr>
                    <tr lang="ru" finished="false">перезаписывать существующие файлы</tr>
                </param>
            </method>
        </methods>
        <inlets dynamic="true">
            <inlet number="1">
                <xinfo>
                    <tr lang="en">control input</tr>
                    <tr lang="ru" finished="false">контрольный вход</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="2">
                <xinfo>
                    <tr lang="en">first faust input</tr>
                    <tr lang="ru" finished="false">Первый ввод фауста</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>
                    <tr lang="en">... faust input</tr>
                    <tr lang="ru" finished="false">Фаустный вход</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="n+1">
                <xinfo>
                    <tr lang="en">n-th faust input</tr>
                    <tr lang="ru" finished="false">n-й фаустный вход</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio" number="1">
                <out type="any">
                    <tr lang="en">first faust output</tr>
                    <tr lang="ru" finished="false">Первый выпуск фауста</tr>
                </out>
            </outlet>
            <outlet type="audio" number="...">
                <out type="any">
                    <tr lang="en">... faust output</tr>
                    <tr lang="ru" finished="false">Фаустовый выход</tr>
                </out>
            </outlet>
            <outlet type="audio" number="n">
                <out type="any">
                    <tr lang="en">n-th faust output</tr>
                    <tr lang="ru" finished="false">n-й выход фауста</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open( [read faust/ex1.dsp( [osc~ 500]
|      |                    |
|      |                    |
|      |                    |.
[ui.faust~ faust/ex0.dsp     ]
|
|
|
|
|
|
[ui.hgain~]       [ui.dsp~]
|\
[dac~]

[ui.faust~-extra]
]]>
            </pdascii>
            <pdascii id="extra">
<![CDATA[
[read faust/ks.dsp #a(

[read faust/blow.dsp #b(

[read faust/xfm.dsp #c(

[ui.faust~ faust/ex0.dsp #x]
|
|
|
|
|
|
|
|
|
|
|
|
|
[ui.hgain~]       [ui.dsp~]
|\
[dac~]

[X a->x]
[X b->x]
[X c->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
