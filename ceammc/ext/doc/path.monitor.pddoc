<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="path.monitor">
    <title>path.monitor</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">filesystem event monitor</tr>
        <tr lang="ru">мониторинг событий файловой системы</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>path</category>
      <keywords>path filesystem</keywords>
      <since>0.9.5</since>
    </meta>
    <arguments>
      <argument name="PATH" type="symbol">
        <tr lang="en">directory to monitor filesystem events</tr>
        <!-- old: каталог для мониторинга событий файловой
                системы -->
        <tr lang="ru" finished="false">каталог для мониторинга событий файловой системы</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @path -->
      <property name="@path" type="symbol" default="">
        <tr lang="en">directory to monitor filesystem events</tr>
        <!-- old: каталог для мониторинга событий файловой
                системы -->
        <tr lang="ru" finished="false">каталог для мониторинга событий файловой системы</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">...</tr>
          <tr lang="ru" finished="false">...</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">messages: [create fname(, [update fname(, [move fname(, [remove fname(</tr>
          <tr lang="ru" finished="false">[править] [править] [править] [править] [править]</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[path.monitor "%PD%"]
|
[ui.dt]

[open "%PD%/test.txt" w(
|
| [write 1 2 3, close(
| |
| | [remove "%PD%/test.txt"(
| | |
[path.file]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
