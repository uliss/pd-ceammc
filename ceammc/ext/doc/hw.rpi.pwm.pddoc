<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.pwm">
    <title>hw.rpi.pwm</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">hardware PWM output for Raspberry Pi</tr>
        <tr lang="ru">аппаратный ШИМ (PWM) для Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>pwm hardware rpi raspberry</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par style="info">
        <tr lang="en">Hardware PWM uses a dedicated module on the SoC for accurate signal
        generation. Software PWM is handled by the CPU, so its timing can vary depending on system
        load.</tr>
        <tr lang="ru">Аппаратный ШИМ использует выделенный модуль для точной генерации, программный
        — переключает пины силами CPU, что зависит от его загрузки.</tr>
      </par>
      <par style="important" space-top="10">
        <tr lang="en">Versions &lt;5.0</tr>
        <tr lang="ru">Версии платы &lt;5.0</tr>
      </par>
      <par>
        <tr lang="en">Supports 2 hardware PWM channels. By default, the channels are mapped as
        follows:</tr>
        <tr lang="ru">Поддерживает 2 аппаратных канала ШИМ. По умолчанию каналы отображаются
        следующим образом:</tr>
      </par>
      <par>
        <tr lang="en">• PWM0 = GPIO12/GPIO18</tr>
        <tr lang="ru">• PWM0 = GPIO12/GPIO18</tr>
      </par>
      <par>
        <tr lang="en">• PWM1 = GPIO13/GPIO19</tr>
        <tr lang="ru">• PWM1 = GPIO13/GPIO19</tr>
      </par>
      <par>
        <tr lang="en">Consult the official documentation on how to enable and configure these.</tr>
        <tr lang="ru">Обратитесь к официальной документации, чтобы узнать, как включить и настроить
        их.</tr>
      </par>
      <par>
        <tr lang="en">Note: the Raspberry Pi's analog audio output uses both PWM channels. Playing
        audio and simultaneously accessing a PWM channel may cause issues.</tr>
        <tr lang="ru">Примечание: аналоговый аудиовыход Raspberry Pi использует оба канала ШИМ.
        Воспроизведение звука и одновременное обращение к каналу ШИМ может вызвать проблемы.</tr>
      </par>
      <par style="important" space-top="10">
        <tr lang="en">Raspberry Pi 5 and later</tr>
        <tr lang="ru">Raspberry Pi 5 и выше</tr>
      </par>
      <par>
        <tr lang="en">Supports 4 hardware PWM channels. By default, the channels are mapped as
        follows:</tr>
        <tr lang="ru">Поддерживает 4 аппаратных канала ШИМ. По умолчанию каналы отображаются
        следующим образом:</tr>
      </par>
      <par>
        <tr lang="en">• PWM0 = GPIO12</tr>
        <tr lang="ru">• PWM0 = GPIO12</tr>
      </par>
      <par>
        <tr lang="en">• PWM1 = GPIO13</tr>
        <tr lang="ru">• PWM1 = GPIO13</tr>
      </par>
      <par>
        <tr lang="en">• PWM2 = GPIO18</tr>
        <tr lang="ru">• PWM2 = GPIO18</tr>
      </par>
      <par>
        <tr lang="en">• PWM3 = GPIO19</tr>
        <tr lang="ru">• PWM3 = GPIO19</tr>
      </par>
      <par>
        <tr lang="en">Consult the official documentation on how to enable and configure these.</tr>
        <tr lang="ru">Обратитесь к официальной документации, чтобы узнать, как включить и настроить
        их.</tr>
      </par>
      <par style="important" space-top="10">
        <tr lang="en">Some of the GPIO pins capable of supporting hardware PWM can also be
        configured for use with other peripherals. Be careful not to enable two peripherals on the
        same pin at the same time.</tr>
        <tr lang="ru">Некоторые из контактов GPIO, способных поддерживать аппаратный ШИМ, также
        могут быть настроены для использования с другими периферийными устройствами. Будьте
        осторожны и не включайте два периферийных устройства на одном контакте одновременно.</tr>
      </par>
    </info>
    <arguments>
      <argument name="PWM_CH" type="int" minvalue="-1" maxvalue="3">
        <tr lang="en">PWM channel. See @ch.</tr>
        <tr lang="ru">канал ШИМ. См. @ch.</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @pwm_ch -->
      <property name="@pwm_ch" type="int" default="-1" minvalue="-1" maxvalue="3"
      access="initonly">
        <tr lang="en">PWM channel. If equal to -1: no PWM channel is selected.</tr>
        <tr lang="ru">канал ШИМ. Если равно -1: канал ШИМ не выбран.</tr>
      </property>
    </properties>
    <methods>
      <!-- duty -->
      <method name="duty">
        <info>
          <tr lang="en">set the duty cycle</tr>
          <tr lang="ru">установить рабочий цикл</tr>
        </info>
        <param name="DUTY" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">duty cycle</tr>
          <tr lang="ru">рабочий цикл</tr>
        </param>
      </method>
      <!-- enable -->
      <method name="enable">
        <info>
          <tr lang="en">enable PWM. By default, it is disabled.</tr>
          <tr lang="ru">включить ШИМ. По умолчанию он отключен.</tr>
        </info>
        <param name="ENABLE" type="bool" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- freq -->
      <method name="freq">
        <info>
          <tr lang="en">set the frequency</tr>
          <tr lang="ru">установить частоту</tr>
        </info>
        <param name="FREQ" type="float" minvalue="0" units="hertz" required="true">
          <tr lang="en">frequency</tr>
          <tr lang="ru">частота</tr>
        </param>
        <param name="DUTY" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">duty cycle</tr>
          <tr lang="ru">рабочий цикл</tr>
        </param>
      </method>
      <!-- period -->
      <method name="period">
        <info>
          <tr lang="en">set the period. Expected width &lt;=period.</tr>
          <tr lang="ru">установить период. Ожидаемая ширина меньше или равна периоду.</tr>
        </info>
        <param name="PERIOD" type="float" minvalue="0" units="msec" required="true">
          <tr lang="en">the whole cycle period</tr>
          <tr lang="ru">полный период цикла</tr>
        </param>
      </method>
      <!-- polarity -->
      <method name="polarity">
        <info>
          <tr lang="en">set the output polarity</tr>
          <tr lang="ru">установить выходную полярность</tr>
        </info>
        <param name="INVERTED" type="bool" required="true">
          <tr lang="en">new value. If true: the polarity is inverted.</tr>
          <tr lang="ru">новое значение. Если true: полярность инвертирована.</tr>
        </param>
      </method>
      <!-- pwm -->
      <method name="pwm">
        <info>
          <tr lang="en">set the period and pulse width. Expected width &lt;=period.</tr>
          <tr lang="ru">установить период и ширину импульса. Ожидаемая ширина импульса меньше или
          равна периоду.</tr>
        </info>
        <param name="PERIOD" type="float" minvalue="0" units="msec" required="true">
          <tr lang="en">the whole cycle period</tr>
          <tr lang="ru">полный период цикла</tr>
        </param>
        <param name="WIDTH" type="float" minvalue="0" units="msec" required="true">
          <tr lang="en">pulse width</tr>
          <tr lang="ru">ширина импульса</tr>
        </param>
      </method>
      <!-- width -->
      <method name="width">
        <info>
          <tr lang="en">set the pulse width. Expected width &lt;=period.</tr>
          <tr lang="ru">установить ширину импульса. Ожидаемая ширина импульса меньше или равна
          периоду.</tr>
        </info>
        <param name="WIDTH" type="float" minvalue="0" units="msec" required="true">
          <tr lang="en">pulse width</tr>
          <tr lang="ru">ширина импульса</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input messages</tr>
          <tr lang="ru">входные сообщения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">no output</tr>
          <tr lang="ru">ничего не выводит</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]                [T]
|                  |
[@connect $1(      [enable $1 #a(
|
|
| [ui.hsl #c]      [ui.hsl #d]
| |                |
| [freq $1 0.5 #e( [pwm 20 $1 #f(
|
|
[hw.rpi.pwm @pwm_ch 0 #x]

[T]
|
[@connect $1 #g(

  [T]              [ui.hsl #h]
  |                |
  [enable $1(      [pwm 20 $1 #i(
  |
  |
[hw.rpi.pwm @pwm_ch 1 #y]

[ui.link @url=ceammc://img/conn_pwm.png @title='Connection_scheme']
[X a->x] [X e->x] [X f->x]
[X g->y] [X i->y]
#c @show_value 1 @min 50 @max 500
#d @show_value 1 @min 0 @max 20
#h @show_value 1 @min 1 @max 2
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
