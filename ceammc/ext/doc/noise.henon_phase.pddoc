<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="noise.henon_phase">
    <title>noise.henon_phase</title>
    <meta>
      <authors>
        <author>Paul Bourke</author>
        <author>André Sier</author>
      </authors>
      <description>
        <tr lang="en">henon phase diagrams</tr>
        <tr lang="ru">фазовые диаграммы Эно</tr>
      </description>
      <license>%</license>
      <library>ceammc</library>
      <category>noise</category>
      <keywords>noise</keywords>
      <since>.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Henon Phase Diagrams</tr>
        <tr lang="ru" finished="false">Фазовые диаграммы Henon</tr>
      </par>
      <par>
        <tr lang="en">Written by Paul Bourke</tr>
        <tr lang="ru" finished="false">Автор: Paul Bourke</tr>
      </par>
      <par>
        <tr lang="en">January 1991</tr>
        <tr lang="ru" finished="false">Январь 1991</tr>
      </par>
      <par>
        <tr lang="en">x[n+1] = x[n]*cos(a) - (y[n] - x[n]^2)*sin(a)</tr>
        <tr lang="ru" finished="false">x[n+1] = x[n]*cos(a) — (y[n] — x[n]^2)*sin(a)</tr>
      </par>
      <par>
        <tr lang="en">y[n+1] = x[n]*sin(a) + (y[n] - x[n]^2)*cos(a)</tr>
        <tr lang="ru" finished="false">y[n+1] ] = x[n]*sin(a) + (y[n] — x[n]^2)*cos(a)</tr>
      </par>
    </info>
    <arguments>
      <argument name="A" type="float">
        <tr lang="en">a value (optional)</tr>
        <tr lang="ru" finished="false">значение (факультативно)</tr>
      </argument>
      <argument name="B" type="float">
        <tr lang="en">b value (optional)</tr>
        <tr lang="ru" finished="false">b значение (факультативно)</tr>
      </argument>
      <argument name="X" type="float">
        <tr lang="en">x value (optional)</tr>
        <tr lang="ru" finished="false">x значение (необязательно)</tr>
      </argument>
      <argument name="Y" type="float">
        <tr lang="en">y value (optional)</tr>
        <tr lang="ru" finished="false">y значение (факультативно)</tr>
      </argument>
    </arguments>
    <methods>
      <!-- a -->
      <method name="a">
        <param name="A" type="float" required="true">
          <tr lang="en">a value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
      </method>
      <!-- b -->
      <method name="b">
        <param name="B" type="float" required="true">
          <tr lang="en">b value</tr>
          <tr lang="ru" finished="false">b значение</tr>
        </param>
      </method>
      <!-- dt -->
      <method name="dt">
        <param name="DT" type="float" required="true">
          <tr lang="en">dt value</tr>
          <tr lang="ru" finished="false">значение dt</tr>
        </param>
      </method>
      <!-- om -->
      <method name="om">
        <param name="OM" type="int" required="true">
          <tr lang="en">enables output when cut or fold value is changed</tr>
          <!-- old: позволяет вывод при изменении значения разреза
                    или сгиба -->
          <tr lang="ru" finished="false">позволяет вывод при изменении значения разреза или
          сгиба</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset state</tr>
          <tr lang="ru" finished="false">состояние сброса</tr>
        </info>
      </method>
      <!-- set -->
      <method name="set">
        <param name="SET" type="float" required="true">
          <tr lang="en">set to value</tr>
          <tr lang="ru" finished="false">установить ценность</tr>
        </param>
      </method>
      <!-- x -->
      <method name="x">
        <param name="X" type="float" required="true">
          <tr lang="en">x value</tr>
          <tr lang="ru" finished="false">x значение</tr>
        </param>
      </method>
      <!-- y -->
      <method name="y">
        <param name="Y" type="float" required="true">
          <tr lang="en">y value</tr>
          <tr lang="ru" finished="false">y значение</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output value</tr>
          <tr lang="ru" finished="false">выходная стоимость</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">x outlet</tr>
          <tr lang="ru" finished="false">х выход</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">y outlet</tr>
          <tr lang="ru" finished="false">выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[metro 50 #metro]

  [T]         [F]
  |           |
  [om $1 #om( [set $1 #set( [reset #reset(

 [F]           [F]
 |             |
 [x $1 #x(     [y $1 #y(  

    [F]       [F]       
    |         |         
    [a $1 #a( [b $1 #b( 

[noise.henon_phase #noise-obj]
|
[ui.display {i=1,o=0}]

[X x:0->noise-obj:0]  
[X y:0->noise-obj:0] 

[X a:0->noise-obj:0]
[X b:0->noise-obj:0]

[X om:0->noise-obj:0]
[X set:0->noise-obj:0]
[X reset:0->noise-obj:0]

[X metro->noise-obj]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
