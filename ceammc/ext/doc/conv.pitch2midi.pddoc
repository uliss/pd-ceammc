<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="conv.pitch2midi">
        <title>conv.pitch2midi</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">converts SPN pitch to MIDI note number</tr>
                <tr lang="ru">преобразует ноту в формате SPN в номер ноты MIDI</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv pitch midi</keywords>
            <since>0.4</since>
            <aliases>
                <alias>ceammc/pitch-&gt;midi</alias>
                <alias>pitch-&gt;midi</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Convert Scientific Pitch Notation to MIDI note numbers. SPN consist
                of pitch class (C, C#, D, Eb etc.) and octave (0-9). C4 is middle C (MIDI: 60). The
                rest symbol is R (-1 output)</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">Scientific Pitch Notation value</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">list of SPN values</tr>
                </xinfo>
                <xinfo on="data:string">
                    <tr lang="en">SPN value</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">list SPN values</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>MIDI note number or -1 on Rest</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]           [ui.dsp~]
|
[metro 100]
|
[list Bb3 C4 F4 G4 C6 E##7 R R R R(
|
[list.choice]
|
[pitch->midi]
|
[t f f  ]
|      ^|
[mtof] [!= -1]
|      |
[osc~] [lop~ 30]
|      |.
[*~     ]
|
[ui.hgain~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
