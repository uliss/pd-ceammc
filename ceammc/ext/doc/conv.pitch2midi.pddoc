<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.pitch2midi">
    <title>conv.pitch2midi</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts SPN pitch to MIDI note number</tr>
        <tr lang="ru">преобразует высоту в нотации SPN в MIDI-номер ноты</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv pitch midi</keywords>
      <since>0.4</since>
      <aliases>
        <alias>ceammc/pitch-&gt;midi</alias>
        <alias>pitch-&gt;midi</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts Scientific Pitch Notation (SPN) to a MIDI note number.
        SPN consists of a pitch class (C, C#, D, Eb, etc.) and an octave number (0–9). For example,
        C4 is middle C, which corresponds to MIDI note number 60. Sharps are written with '#', and
        flats with 'b'. Double sharps are written as '##' (or 'x') and double flats as 'bb'. The
        rest symbol 'R' is converted to the value -1.</tr>
        <tr lang="ru">Объект преобразует ноту в научной нотации (SPN) в MIDI-номер ноты. SPN
        состоит из класса высоты (C, C#, D, Eb и т. д.) и номера октавы (0–9). Например, C4 — это
        средняя до (middle C), соответствующая MIDI-номеру 60. Диезы записываются как '#', а бемоли
        — как 'b'. Двойные диезы — '##' (или 'x'), двойные бемоли — 'bb'. Символ паузы 'R'
        преобразуется в значение -1.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">SPN value</tr>
          <tr lang="ru">значение SPN</tr>
        </in>
        <in on="list">
          <tr lang="en">list of SPN values</tr>
          <tr lang="ru">список значений SPN</tr>
        </in>
        <in on="data:string">
          <tr lang="en">SPN value</tr>
          <tr lang="ru">значение SPN</tr>
        </in>
        <in on="data:mlist">
          <tr lang="en">list of SPN values</tr>
          <tr lang="ru">список значений SPN</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">MIDI note number, or -1 for a rest</tr>
          <tr lang="ru">MIDI-номер ноты или -1 для паузы</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]           [ui.dsp~]
|
[metro 100]
|
[list Bb3 C4 F4 G4 C6 E##7 R R R R(
|
[list.choice]
|
[pitch->midi]
|
[t f f  ]
|      ^|
[mtof] [!= -1]
|      |
[osc~] [lop~ 30]
|      |.
[*~     ]
|
[ui.hgain~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
