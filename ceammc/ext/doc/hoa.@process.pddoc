<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="hoa.@process">
        <title>hoa.@process</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
                <author>Pierre Guillot</author>
                <author>Eliott Paris</author>
                <author>Thomas Le Meur</author>
            </authors>
            <description>
                <tr lang="en">properties manager for [hoa.process~] object</tr>
                <tr lang="ru">управление свойствами объекта [hoa.process~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>hoa process properties</keywords>
            <since>0.8</since>
            <also>
                <see>hoa.process~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">With [hoa.@process] you can get [hoa.process~] instance properties
                and get/set properties declared via [prop.declare]</tr>
                <!-- old: С [hoa.@process] вы можете получить свойства
                экземпляра [hoa.process~] и получить / установить свойства, объявленные через
                [prop.declare] -->
                <tr lang="ru" finished="false">С [hoa.@process] вы можете получить свойства
                экземпляра [hoa.process~] и получить / установить свойства, объявленные через
                [prop.declare]</tr>
            </par>
        </info>
        <properties>
            <!-- @hdegree -->
            <property name="@hdegree" type="int" access="readonly" default="0">
                <tr lang="en">current harmonic degree in hoa.process~ instance (only in harmonics
                mode)</tr>
                <!-- old: текущая степень гармоники в hoa.process~ example
                (только в режиме гармоники) -->
                <tr lang="ru" finished="false">текущая степень гармоники в hoa.process~ example
                (только в режиме гармоники)</tr>
            </property>
            <!-- @horder -->
            <property name="@horder" type="int" access="readonly" default="0">
                <tr lang="en">current harmonic order in hoa.process~ instance (only in harmonics
                mode)</tr>
                <!-- old: текущий гармонический порядок в hoa.process~
                instance (только в режиме гармоник) -->
                <tr lang="ru" finished="false">текущий гармонический порядок в hoa.process~
                instance (только в режиме гармоник)</tr>
            </property>
            <!-- @index -->
            <property name="@index" type="int" access="readonly" default="0">
                <tr lang="en">current instance index starting from 0</tr>
                <tr lang="ru" finished="false">Текущий индекс экземпляра, начинающийся с 0</tr>
            </property>
            <!-- @order -->
            <property name="@order" type="int" access="readonly" default="0">
                <tr lang="en">order of parent hoa.process~</tr>
                <tr lang="ru" finished="false">Порядок родительского hoa.process</tr>
            </property>
            <!-- @pmode -->
            <property name="@pmode" type="symbol" enum="2d 3d" access="readonly" default="">
                <tr lang="en">amibisonic mode</tr>
                <tr lang="ru" finished="false">амибизонный режим</tr>
            </property>
            <!-- @ptype -->
            <property name="@ptype" type="symbol" enum="harmonics planewaves" access="readonly"
            default="">
                <tr lang="en">amibisonic type</tr>
                <tr lang="ru" finished="false">амибизонный тип</tr>
            </property>
            <!-- @total -->
            <property name="@total" type="int" access="readonly" default="0">
                <tr lang="en">total number of hoa.process~ instances</tr>
                <tr lang="ru" finished="false">Общее количество экземпляров hoa.process</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in>
                    <tr lang="en">set or request properties</tr>
                    <tr lang="ru" finished="false">устанавливать или запрашивать свойства</tr>
                </in>
                <in on="bang">
                    <tr lang="en">if harmonics mode output list: @order @hdegree @horder, in
                    planewaves: @order @index @index</tr>
                    <!-- old: если гармоники режим вывода список: @order
                    @hdegree @horder, в плоских волнах: @order @index @index -->
                    <tr lang="ru" finished="false">если гармоники режим вывода список: @order
                    @hdegree @horder, в плоских волнах: @order @index @index</tr>
                </in>
                <in on="float">
                    <tr lang="en">pass float message thru</tr>
                    <tr lang="ru" finished="false">Отправить сообщение Float Message</tr>
                </in>
                <in on="symbol">
                    <tr lang="en">pass symbol message thru</tr>
                    <tr lang="ru" finished="false">Передайте символьное сообщение через</tr>
                </in>
                <in on="list">
                    <tr lang="en">pass list message thru</tr>
                    <tr lang="ru" finished="false">Обсуждение Pass List Message</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">outputs properties</tr>
                    <tr lang="ru" finished="false">выводимые свойства</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open 0( [open 1( [open 2(     [@*?, @index? @order? @total? @hdegree? @horder? #a(
|        |        |
|        |        |              [@freq?, \#1 @freq 1000, @freq? #b(
|        |        |
|        |        |                [\#0 @freq 740, \#2 @freq 300 #c(
|        |        |
|        |        |                  [\#0 @freq 200, \#1 @freq 600, \#2 @freq 500 #d(
|        |        |
|        |        |                          [3(
|        |        |                          |
|        |        |                          [list.gen] X [random.int 100 1000]
|        |        |                          |
|        |        |   /*click me*/           [list.do #e] [\#$2 @freq $1 #x(
|        |        |                                       |.
[hoa.process~ 3 hoa/hoa_prop_example1 planewaves "@freq" 250 {w=60,i=2,o=4} #z]
| ^| ^^|                                   ^^^|
|  |   |                                      |
|  |   |                                      |
[ui.hgain~]   [ui.dsp~]                     [print]
|\
[dac~]

[X a->z:1]
[X b->z:1]
[X c->z:1]
[X d->z:1]
[X e:1->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
