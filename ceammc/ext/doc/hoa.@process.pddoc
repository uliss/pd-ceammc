<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hoa.@process">
    <title>hoa.@process</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
        <author>Pierre Guillot</author>
        <author>Eliott Paris</author>
        <author>Thomas Le Meur</author>
      </authors>
      <description>
        <tr lang="en">properties manager for [hoa.process~] object</tr>
        <tr lang="ru">менеджер свойств объекта [hoa.process~]</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>spat</category>
      <keywords>hoa process properties</keywords>
      <since>0.8</since>
      <also>
        <see>hoa.process~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">With [hoa.@process] you can read the properties of a [hoa.process~] instance
        and get or set custom properties declared via [prop.declare]. This is useful inside a patch
        that is loaded by [hoa.process~] — it allows instances to be identified, to read their own
        order/degree/index and to share parameters across instances.</tr>
        <tr lang="ru">С помощью [hoa.@process] можно читать свойства экземпляра [hoa.process~], а
        также получать и задавать пользовательские свойства, объявленные через [prop.declare]. Это
        удобно внутри патча, загружаемого [hoa.process~]: позволяет экземплярам идентифицировать
        себя, читать собственные order/degree/index и обмениваться параметрами между
        экземплярами.</tr>
      </par>
    </info>
    <properties>
      <!-- @hdegree -->
      <property name="@hdegree" type="int" access="readonly" default="0">
        <tr lang="en">current harmonic degree in the hoa.process~ instance (only in harmonics
        mode)</tr>
        <tr lang="ru">текущая степень гармоники в экземпляре hoa.process~ (только в режиме
        harmonics)</tr>
      </property>
      <!-- @horder -->
      <property name="@horder" type="int" access="readonly" default="0">
        <tr lang="en">current harmonic order in the hoa.process~ instance (only in harmonics
        mode)</tr>
        <tr lang="ru">текущий порядок гармоники в экземпляре hoa.process~ (только в режиме
        harmonics)</tr>
      </property>
      <!-- @index -->
      <property name="@index" type="int" access="readonly" default="0">
        <tr lang="en">current instance index, starting from 0</tr>
        <tr lang="ru">текущий индекс экземпляра, начиная с 0</tr>
      </property>
      <!-- @order -->
      <property name="@order" type="int" access="readonly" default="0">
        <tr lang="en">order of the parent hoa.process~</tr>
        <tr lang="ru">порядок родительского hoa.process~</tr>
      </property>
      <!-- @pmode -->
      <property name="@pmode" type="symbol" enum="2d 3d" access="readonly" default="">
        <tr lang="en">ambisonic mode</tr>
        <tr lang="ru">режим амбисоников</tr>
      </property>
      <!-- @ptype -->
      <property name="@ptype" type="symbol" enum="harmonics planewaves" access="readonly"
      default="">
        <tr lang="en">ambisonic type</tr>
        <tr lang="ru">тип амбисоников</tr>
      </property>
      <!-- @total -->
      <property name="@total" type="int" access="readonly" default="0">
        <tr lang="en">total number of hoa.process~ instances</tr>
        <tr lang="ru">общее число экземпляров hoa.process~</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">set or request properties</tr>
          <tr lang="ru">задать или запросить свойства</tr>
        </in>
        <in on="bang">
          <tr lang="en">in harmonics mode, outputs the list @order @hdegree @horder, in planewaves
          mode, outputs @order @index @index</tr>
          <tr lang="ru">в режиме harmonics выводит список @order @hdegree @horder, в режиме
          planewaves — @order @index @index</tr>
        </in>
        <in on="float">
          <tr lang="en">passes a float message through</tr>
          <tr lang="ru">пропускает сообщение с числом без изменений</tr>
        </in>
        <in on="symbol">
          <tr lang="en">passes a symbol message through</tr>
          <tr lang="ru">пропускает символьное сообщение без изменений</tr>
        </in>
        <in on="list">
          <tr lang="en">passes a list message through</tr>
          <tr lang="ru">пропускает сообщение-список без изменений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">outputs properties</tr>
          <tr lang="ru">выводит свойства</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[open 0( [open 1( [open 2(     [@*?, @index? @order? @total? @hdegree? @horder? #a(
|        |        |
|        |        |              [@freq?, \#1 @freq 1000, @freq? #b(
|        |        |
|        |        |                [\#0 @freq 740, \#2 @freq 300 #c(
|        |        |
|        |        |                  [\#0 @freq 200, \#1 @freq 600, \#2 @freq 500 #d(
|        |        |
|        |        |                          [3(
|        |        |                          |
|        |        |                          [list.gen] X [random.int 100 1000]
|        |        |                          |
|        |        |   /*click me*/           [list.do #e] [\#$2 @freq $1 #x(
|        |        |                                       |.
[hoa.process~ 3 hoa/hoa_prop_example1 planewaves "@freq" 250 {w=60,i=2,o=4} #z]
| ^| ^^|                                   ^^^|
|  |   |                                      |
|  |   |                                      |
[ui.hgain~]   [ui.dsp~]                     [print]
|\
[dac~]

[X a->z:1]
[X b->z:1]
[X c->z:1]
[X d->z:1]
[X e:1->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
