<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="envelope">
    <title>envelope</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">envelope data type</tr>
        <tr lang="ru">тип данных огибающей</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>envelope</keywords>
      <since>0.5</since>
      <also>
        <see>env-&gt;array</see>
        <see>env-&gt;vline</see>
      </also>
      <aliases>
        <alias>ceammc/envelope</alias>
        <alias>ceammc/env</alias>
        <alias>env</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Data type for a sound envelope. It contains points defined by time and value.
        A point can have the stop property — this makes the envelope stop at that point instead of
        continuing, so multi-segment envelopes can be created.</tr>
        <tr lang="ru">Тип данных для звуковой огибающей. Содержит точки, заданные временем и
        значением. Точка может иметь свойство «стоп» — в этом случае выполнение огибающей
        останавливается на этой точке, что позволяет создавать многосегментные огибающие.</tr>
      </par>
      <par>
        <tr lang="en">A point also has a segment type property that defines the following segment
        curve. It can be *step*, *line* (default) or *exp* (exponential).</tr>
        <tr lang="ru">Точка также имеет свойство типа сегмента, которое определяет кривую
        следующего сегмента. Это может быть *step*, *line* (по умолчанию) или *exp*
        (экспоненциальная).</tr>
      </par>
      <par>
        <tr lang="en">An exponential segment also has a curve property: 0 (linear), &lt;0 (concave,
        negatively curved), &gt;0 (convex, positively curved).</tr>
        <tr lang="ru">Экспоненциальный сегмент также имеет свойство кривизны: 0 (линейная), &lt;0
        (вогнутая, отрицательная кривизна), &gt;0 (выпуклая, положительная кривизна).</tr>
      </par>
    </info>
    <arguments>
      <argument name="adsr" type="list">
        <tr lang="en">ADSR envelope: attack (ms), decay (ms), sustain (%), release (ms)</tr>
        <tr lang="ru">огибающая ADSR: атака (мс), спад (мс), удержание (%), восстановление
        (мс)</tr>
      </argument>
      <argument name="asr" type="list">
        <tr lang="en">ASR envelope: attack (ms), release (ms) — with a sustain stop point</tr>
        <tr lang="ru">огибающая ASR: атака (мс), восстановление (мс) — с точкой остановки на
        удержании</tr>
      </argument>
      <argument name="ar" type="list">
        <tr lang="en">AR envelope: attack (ms), release (ms)</tr>
        <tr lang="ru">огибающая AR: атака (мс), восстановление (мс)</tr>
      </argument>
      <argument name="eadsr" type="list">
        <tr lang="en">exponential ADSR envelope: attack (ms), attack_curve, decay (ms),
        decay_curve, sustain (%), release (ms), release_curve</tr>
        <tr lang="ru">экспоненциальная огибающая ADSR: атака (мс), attack_curve, спад (мс),
        decay_curve, удержание (%), восстановление (мс), release_curve</tr>
      </argument>
      <argument name="easr" type="list">
        <tr lang="en">exponential ASR envelope: attack (ms), attack_curve, release (ms),
        release_curve — with a sustain stop point</tr>
        <tr lang="ru">экспоненциальная огибающая ASR: атака (мс), attack_curve, восстановление
        (мс), release_curve — с точкой остановки на удержании</tr>
      </argument>
      <argument name="ear" type="list">
        <tr lang="en">exponential AR envelope: attack (ms), attack_curve, release (ms),
        release_curve — no sustain point</tr>
        <tr lang="ru">экспоненциальная огибающая AR: атака (мс), attack_curve, восстановление (мс),
        release_curve — без точки удержания</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @length -->
      <property name="@length" type="float" units="millisecond" access="readonly" default="0"
      minvalue="0">
        <tr lang="en">total envelope time length</tr>
        <tr lang="ru">общая длительность огибающей</tr>
      </property>
      <!-- @npoints -->
      <property name="@npoints" type="int" access="readonly" minvalue="0" default="0">
        <tr lang="en">number of points</tr>
        <tr lang="ru">количество точек</tr>
      </property>
      <!-- @points -->
      <property name="@points" type="list" access="readonly" default="">
        <tr lang="en">list of point times (ms)</tr>
        <tr lang="ru">список моментов времени точек (мс)</tr>
      </property>
      <!-- @stops -->
      <property name="@stops" type="list" access="readonly" default="">
        <tr lang="en">list of stop points</tr>
        <tr lang="ru">список точек остановки</tr>
      </property>
      <!-- @values -->
      <property name="@values" type="list" access="readonly" default="">
        <tr lang="en">list of point values</tr>
        <tr lang="ru">список значений точек</tr>
      </property>
    </properties>
    <methods>
      <!-- * -->
      <method name="*">
        <info>
          <tr lang="en">multiplies all envelope points by the specified value</tr>
          <tr lang="ru">умножает все точки огибающей на заданное значение</tr>
        </info>
        <param name="VALUE" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- + -->
      <method name="+">
        <info>
          <tr lang="en">adds the specified value to all envelope points</tr>
          <tr lang="ru">прибавляет заданное значение ко всем точкам огибающей</tr>
        </info>
        <param name="VALUE" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- >> -->
      <method name="&gt;&gt;">
        <info>
          <tr lang="en">shifts all envelope points by the specified time in milliseconds</tr>
          <tr lang="ru">сдвигает все точки огибающей на заданное время в миллисекундах</tr>
        </info>
        <param name="SHIFT" type="float" required="true" units="millisecond">
          <tr lang="en">shift time</tr>
          <tr lang="ru">время сдвига</tr>
        </param>
      </method>
      <!-- add_point -->
      <method name="add_point">
        <info>
          <tr lang="en">adds an envelope point</tr>
          <tr lang="ru">добавляет точку огибающей</tr>
        </info>
        <param name="TIME" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">point time</tr>
          <tr lang="ru">время точки</tr>
        </param>
        <param name="VALUE" type="float" required="true">
          <tr lang="en">point value</tr>
          <tr lang="ru">значение точки</tr>
        </param>
        <param name="IS_STOP" type="int" enum="0 1" default="0">
          <tr lang="en">is stop point</tr>
          <tr lang="ru">является ли точка точкой остановки</tr>
        </param>
        <param name="TYPE" type="symbol" enum="step line exp sin2 sigmoid" default="line">
          <tr lang="en">segment type: step, linear, exponential, sin² or sigmoid curve</tr>
          <tr lang="ru">тип сегмента: step (ступень), line (линейный), exp (экспоненциальный), sin2
          (синус в квадрате) или sigmoid (сигмоидный)</tr>
        </param>
        <param name="CURVE" type="float" default="1">
          <tr lang="en">exponential curve degree: 0 (linear), &lt;0 (concave, negatively curved),
          &gt;0 (convex, positively curved)</tr>
          <tr lang="ru">степень экспоненциальной кривой: 0 (линейная), &lt;0 (вогнутая,
          отрицательная кривизна), &gt;0 (выпуклая, положительная кривизна)</tr>
        </param>
      </method>
      <!-- add_seg -->
      <method name="add_seg">
        <info>
          <tr lang="en">adds a segment to the end of the envelope. On an empty envelope, adds a
          start point at 0 ms with value 0</tr>
          <tr lang="ru">добавляет сегмент в конец огибающей. На пустой огибающей добавляется
          начальная точка в 0 мс со значением 0</tr>
        </info>
        <param name="TYPE" type="symbol" required="true" enum="step line sin2 exp sigmoid">
          <tr lang="en">segment type</tr>
          <tr lang="ru">тип сегмента</tr>
        </param>
        <param name="LENGTH" type="float" units="millisecond" required="true">
          <tr lang="en">segment length</tr>
          <tr lang="ru">длина сегмента</tr>
        </param>
        <param name="VALUE" type="float" required="true">
          <tr lang="en">end value of the segment</tr>
          <tr lang="ru">конечное значение сегмента</tr>
        </param>
        <param name="CURVE" type="float" required="false" default="0">
          <tr lang="en">curve (for exp and sigmoid types)</tr>
          <tr lang="ru">кривизна (для типов exp и sigmoid)</tr>
        </param>
      </method>
      <!-- adsr -->
      <method name="adsr">
        <info>
          <tr lang="en">creates an ADSR envelope with one stop point</tr>
          <tr lang="ru">создаёт огибающую ADSR с одной точкой остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">attack time</tr>
          <tr lang="ru">время атаки</tr>
        </param>
        <param name="DECAY" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">decay time</tr>
          <tr lang="ru">время спада</tr>
        </param>
        <param name="SUSTAIN" type="float" units="percent" required="true" minvalue="0"
        maxvalue="100">
          <tr lang="en">sustain level</tr>
          <tr lang="ru">уровень удержания</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">release time</tr>
          <tr lang="ru">время восстановления</tr>
        </param>
      </method>
      <!-- ar -->
      <method name="ar">
        <info>
          <tr lang="en">creates an AR envelope without stop points</tr>
          <tr lang="ru">создаёт огибающую AR без точек остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">attack time</tr>
          <tr lang="ru">время атаки</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">release time</tr>
          <tr lang="ru">время восстановления</tr>
        </param>
      </method>
      <!-- asr -->
      <method name="asr">
        <info>
          <tr lang="en">creates an ASR envelope with one stop point</tr>
          <tr lang="ru">создаёт огибающую ASR с одной точкой остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">attack time</tr>
          <tr lang="ru">время атаки</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">release time</tr>
          <tr lang="ru">время восстановления</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">removes all envelope points</tr>
          <tr lang="ru">удаляет все точки огибающей</tr>
        </info>
      </method>
      <!-- eadsr -->
      <method name="eadsr">
        <info>
          <tr lang="en">creates an exponential ADSR envelope with one stop point</tr>
          <tr lang="ru">создаёт экспоненциальную огибающую ADSR с одной точкой остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">attack time</tr>
          <tr lang="ru">время атаки</tr>
        </param>
        <param name="ATTACK_CURVE" type="float" required="true">
          <tr lang="en">attack segment curve</tr>
          <tr lang="ru">кривизна сегмента атаки</tr>
        </param>
        <param name="DECAY" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">decay time</tr>
          <tr lang="ru">время спада</tr>
        </param>
        <param name="DECAY_CURVE" type="float" required="true">
          <tr lang="en">decay segment curve</tr>
          <tr lang="ru">кривизна сегмента спада</tr>
        </param>
        <param name="SUSTAIN" type="float" units="percent" required="true" minvalue="0"
        maxvalue="100">
          <tr lang="en">sustain level</tr>
          <tr lang="ru">уровень удержания</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">release time</tr>
          <tr lang="ru">время восстановления</tr>
        </param>
        <param name="RELEASE_CURVE" type="float" required="true">
          <tr lang="en">release segment curve</tr>
          <tr lang="ru">кривизна сегмента восстановления</tr>
        </param>
      </method>
      <!-- ear -->
      <method name="ear">
        <info>
          <tr lang="en">creates an exponential AR envelope without stop points</tr>
          <tr lang="ru">создаёт экспоненциальную огибающую AR без точек остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true">
          <tr lang="en">attack time</tr>
          <tr lang="ru">время атаки</tr>
        </param>
        <param name="ATTACK_CURVE" type="float" required="true">
          <tr lang="en">attack segment curve</tr>
          <tr lang="ru">кривизна сегмента атаки</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true">
          <tr lang="en">release time</tr>
          <tr lang="ru">время восстановления</tr>
        </param>
        <param name="RELEASE_CURVE" type="float" required="true">
          <tr lang="en">release segment curve</tr>
          <tr lang="ru">кривизна сегмента восстановления</tr>
        </param>
      </method>
      <!-- easr -->
      <method name="easr">
        <info>
          <tr lang="en">creates an exponential ASR envelope with one stop point</tr>
          <tr lang="ru">создаёт экспоненциальную огибающую ASR с одной точкой остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">attack time</tr>
          <tr lang="ru">время атаки</tr>
        </param>
        <param name="ATTACK_CURVE" type="float" required="true">
          <tr lang="en">attack segment curve</tr>
          <tr lang="ru">кривизна сегмента атаки</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">release time</tr>
          <tr lang="ru">время восстановления</tr>
        </param>
        <param name="RELEASE_CURVE" type="float" required="true">
          <tr lang="en">release segment curve</tr>
          <tr lang="ru">кривизна сегмента восстановления</tr>
        </param>
      </method>
      <!-- exp -->
      <method name="exp">
        <info>
          <tr lang="en">creates an exponential-segmented envelope with an arbitrary number of
          segments</tr>
          <tr lang="ru">создаёт огибающую из экспоненциальных сегментов с произвольным числом
          сегментов</tr>
        </info>
        <param name="VAL0" type="float" required="true">
          <tr lang="en">starting value</tr>
          <tr lang="ru">начальное значение</tr>
        </param>
        <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
          <tr lang="en">segment length</tr>
          <tr lang="ru">длина сегмента</tr>
        </param>
        <param name="CURVE0" type="float" required="true">
          <tr lang="en">segment curve</tr>
          <tr lang="ru">кривизна сегмента</tr>
        </param>
        <param name="VAL1" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
        <param name="LEN1" type="float" required="false">
          <tr lang="en">segment length</tr>
          <tr lang="ru">длина сегмента</tr>
        </param>
        <param name="CURVE1" type="float" required="false">
          <tr lang="en">segment curve</tr>
          <tr lang="ru">кривизна сегмента</tr>
        </param>
        <param name="VAL2" type="float" required="false">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- line -->
      <method name="line">
        <info>
          <tr lang="en">creates a line-segmented envelope with an arbitrary number of segments</tr>
          <tr lang="ru">создаёт огибающую из линейных сегментов с произвольным числом
          сегментов</tr>
        </info>
        <param name="VAL0" type="float" required="true">
          <tr lang="en">starting value</tr>
          <tr lang="ru">начальное значение</tr>
        </param>
        <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
          <tr lang="en">line length</tr>
          <tr lang="ru">длина линии</tr>
        </param>
        <param name="VAL1" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
        <param name="LEN1" type="float" required="false">
          <tr lang="en">segment length</tr>
          <tr lang="ru">длина сегмента</tr>
        </param>
        <param name="VAL2" type="float" required="false">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- remove_point -->
      <method name="remove_point">
        <info>
          <tr lang="en">removes an envelope point by index</tr>
          <tr lang="ru">удаляет точку огибающей по индексу</tr>
        </info>
        <param name="IDX" type="int" required="true" minvalue="0">
          <tr lang="en">point index</tr>
          <tr lang="ru">индекс точки</tr>
        </param>
      </method>
      <!-- set_point -->
      <method name="set_point">
        <info>
          <tr lang="en">sets the time, value and stop flag of a point</tr>
          <tr lang="ru">устанавливает время, значение и флаг остановки точки</tr>
        </info>
        <param name="IDX" type="int" required="true" minvalue="0">
          <tr lang="en">point index</tr>
          <tr lang="ru">индекс точки</tr>
        </param>
        <param name="TIME" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">point time</tr>
          <tr lang="ru">время точки</tr>
        </param>
        <param name="VALUE" type="int" required="true" minvalue="0">
          <tr lang="en">point value</tr>
          <tr lang="ru">значение точки</tr>
        </param>
        <param name="IS_STOP" type="int" enum="0 1" default="0">
          <tr lang="en">stop point</tr>
          <tr lang="ru">точка остановки</tr>
        </param>
      </method>
      <!-- set_point_time -->
      <method name="set_point_time">
        <info>
          <tr lang="en">sets the point time</tr>
          <tr lang="ru">устанавливает время точки</tr>
        </info>
        <param name="IDX" type="int" required="true" minvalue="0">
          <tr lang="en">point index</tr>
          <tr lang="ru">индекс точки</tr>
        </param>
        <param name="TIME" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">point time</tr>
          <tr lang="ru">время точки</tr>
        </param>
      </method>
      <!-- set_point_value -->
      <method name="set_point_value">
        <info>
          <tr lang="en">sets the point value</tr>
          <tr lang="ru">устанавливает значение точки</tr>
        </info>
        <param name="IDX" type="int" required="true" minvalue="0">
          <tr lang="en">point index</tr>
          <tr lang="ru">индекс точки</tr>
        </param>
        <param name="VALUE" type="int" required="true" minvalue="0">
          <tr lang="en">point value</tr>
          <tr lang="ru">значение точки</tr>
        </param>
      </method>
      <!-- set_seg_type -->
      <method name="set_seg_type">
        <info>
          <tr lang="en">sets the segment type</tr>
          <tr lang="ru">устанавливает тип сегмента</tr>
        </info>
        <param name="IDX" type="int" required="true" minvalue="0">
          <tr lang="en">segment index, starting from 0</tr>
          <tr lang="ru">индекс сегмента, начиная с 0</tr>
        </param>
        <param name="TYPE" type="symbol" required="true" enum="step line sin2 exp sigmoid">
          <tr lang="en">segment type</tr>
          <tr lang="ru">тип сегмента</tr>
        </param>
      </method>
      <!-- set_stop_point -->
      <method name="set_stop_point">
        <info>
          <tr lang="en">sets or clears the stop flag of a point</tr>
          <tr lang="ru">устанавливает или снимает флаг остановки точки</tr>
        </info>
        <param name="IDX" type="int" required="true" minvalue="0">
          <tr lang="en">point index</tr>
          <tr lang="ru">индекс точки</tr>
        </param>
        <param name="IS_STOP" type="int" enum="0 1" required="true">
          <tr lang="en">stop point</tr>
          <tr lang="ru">точка остановки</tr>
        </param>
      </method>
      <!-- sigmoid -->
      <method name="sigmoid">
        <info>
          <tr lang="en">creates a sigmoid-segmented envelope with an arbitrary number of
          segments</tr>
          <tr lang="ru">создаёт огибающую из сигмоидных сегментов с произвольным числом
          сегментов</tr>
        </info>
        <param name="VAL0" type="float" required="true">
          <tr lang="en">starting value</tr>
          <tr lang="ru">начальное значение</tr>
        </param>
        <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
          <tr lang="en">segment length</tr>
          <tr lang="ru">длина сегмента</tr>
        </param>
        <param name="CURVE0" type="float" required="true">
          <tr lang="en">segment curve</tr>
          <tr lang="ru">кривизна сегмента</tr>
        </param>
        <param name="VAL1" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
        <param name="LEN1" type="float" required="false">
          <tr lang="en">segment length</tr>
          <tr lang="ru">длина сегмента</tr>
        </param>
        <param name="CURVE1" type="float" required="false">
          <tr lang="en">segment curve</tr>
          <tr lang="ru">кривизна сегмента</tr>
        </param>
        <param name="VAL2" type="float" required="false">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- sin2 -->
      <method name="sin2">
        <info>
          <tr lang="en">creates a quadratic-sine-segmented envelope with an arbitrary number of
          segments</tr>
          <tr lang="ru">создаёт огибающую из сегментов вида sin² с произвольным числом
          сегментов</tr>
        </info>
        <param name="VAL0" type="float" required="true">
          <tr lang="en">starting value</tr>
          <tr lang="ru">начальное значение</tr>
        </param>
        <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
          <tr lang="en">segment length</tr>
          <tr lang="ru">длина сегмента</tr>
        </param>
        <param name="VAL1" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
        <param name="LEN1" type="float" required="false">
          <tr lang="en">segment length</tr>
          <tr lang="ru">длина сегмента</tr>
        </param>
        <param name="VAL2" type="float" required="false">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- step -->
      <method name="step">
        <info>
          <tr lang="en">creates a step-segmented envelope with an arbitrary number of segments</tr>
          <tr lang="ru">создаёт ступенчатую огибающую с произвольным числом сегментов</tr>
        </info>
        <param name="VAL0" type="float" required="true">
          <tr lang="en">starting value</tr>
          <tr lang="ru">начальное значение</tr>
        </param>
        <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
          <tr lang="en">step length</tr>
          <tr lang="ru">длина шага</tr>
        </param>
        <param name="VAL1" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
        <param name="LEN1" type="float" required="false">
          <tr lang="en">segment length</tr>
          <tr lang="ru">длина сегмента</tr>
        </param>
        <param name="VAL2" type="float" required="false">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the current envelope</tr>
          <tr lang="ru">выводит текущую огибающую</tr>
        </in>
        <in on="data">
          <tr lang="en">sets a new envelope and outputs it</tr>
          <tr lang="ru">устанавливает новую огибающую и выводит её</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">data output</tr>
          <tr lang="ru">вывод данных</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ar 100 200, bang( [exp 0 30 -2 1 100 -4 0 40 4 0.5 30 2 0, bang #a(
|
| [adsr 10 30 60 150, bang( [line 0.1 40 0.9 20 0.3 60 0, bang #b(
| |
| | [ear 10 -2 60 -2, bang( [sigmoid 0 40 14 1 100 8 0, bang #c(
| | |
| | | [eadsr 20 -5 70 -12 30 100 -7, bang( [sin2 0 80 1 80 0, bang #d(
| | | |
[envelope #env]
|
[env->array env_arr]


[array env_arr size=100 w=400 h=100 yr=0..1]

[X a->env] [X b->env] [X c->env] [X d->env]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
