<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="envelope">
        <title>envelope</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">envelope data type</tr>
                <tr lang="ru">тип данных огибающей</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>env</category>
            <keywords>envelope</keywords>
            <since>0.5</since>
            <also>
                <see>env-&gt;array</see>
                <see>env-&gt;vline</see>
            </also>
            <aliases>
                <alias>ceammc/envelope</alias>
                <alias>ceammc/env</alias>
                <alias>env</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Data type for sound envelope. Contains points specified by time and
                value. Points could have stop property - to execute oly part of envelope and stop
                on this point. So multisegment envelopes could be created</tr>
                <!-- old: Тип данных для звукового конверта. Содержит точки,
                определенные временем и стоимостью. Точки могли иметь останавливающее свойство —
                выполнять оли часть конверта и останавливаться на этой точке. Можно создать
                многосегментные конверты -->
                <tr lang="ru" finished="false">Тип данных для звукового конверта. Содержит точки,
                определенные временем и стоимостью. Точки могли иметь останавливающее свойство —
                выполнять оли часть конверта и останавливаться на этой точке. Можно создать
                многосегментные конверты</tr>
            </par>
            <par>
                <tr lang="en">Point also has segment type property, that defines following segment
                curve - it could be *step*, *line* (default) or *exp* (exponential)</tr>
                <!-- old: Точка также имеет свойство типа сегмента, которое
                определяет следующую кривую сегмента - это может быть *step*, *line* (по умолчанию)
                или *exp* (экспоненциально). -->
                <tr lang="ru" finished="false">Точка также имеет свойство типа сегмента, которое
                определяет следующую кривую сегмента - это может быть *step*, *line* (по умолчанию)
                или *exp* (экспоненциально).</tr>
            </par>
            <par>
                <tr lang="en">Exponential segment also has curve property: if 0 - (linear) &lt;0
                (concave, negatively curved) &gt;0 (convex, positively curved)</tr>
                <!-- old: Экспоненциальный сегмент также имеет кривое
                свойство: если 0 - (линейный) <0 (вогнутый, отрицательно изогнутый) >0
                (выпуклый, положительно изогнутый) -->
                <tr lang="ru" finished="false">Экспоненциальный сегмент также имеет кривое
                свойство: если 0 - (линейный) &lt;0 (вогнутый, отрицательно изогнутый) &gt;0
                (выпуклый, положительно изогнутый)</tr>
            </par>
        </info>
        <arguments>
            <argument name="adsr" type="list">
                <tr lang="en">ADSR envelope: attack(ms), decay(ms), sustain(%), release(ms)</tr>
                <!-- old: Оболочка ADSR: атака (ms), распад (ms), поддержка
                (%), высвобождение (ms) -->
                <tr lang="ru" finished="false">Оболочка ADSR: атака (ms), распад (ms), поддержка
                (%), высвобождение (ms)</tr>
            </argument>
            <argument name="asr" type="list">
                <tr lang="en">ASR envelope: attack(ms), release(ms) - with sustain stop point</tr>
                <!-- old: Оболочка ASR: атака (ms), высвобождение (ms) - с
                устойчивой точкой остановки -->
                <tr lang="ru" finished="false">Оболочка ASR: атака (ms), высвобождение (ms) - с
                устойчивой точкой остановки</tr>
            </argument>
            <argument name="ar" type="list">
                <tr lang="en">AR envelope: attack(ms), release(ms)</tr>
                <tr lang="ru" finished="false">Конверт AR: атака (ms), релиз (ms)</tr>
            </argument>
            <argument name="eadsr" type="list">
                <tr lang="en">exponential ADSR envelope: attack(ms), attack_curve, decay(ms),
                decay_curve, sustain(%), release(ms), release_curve</tr>
                <!-- old: Экспоненциальная оболочка ADSR: attack(ms),
                attack_curve, decay(ms), decay_curve, sustain(%), release(ms), release_curve -->
                <tr lang="ru" finished="false">Экспоненциальная оболочка ADSR: attack(ms),
                attack_curve, decay(ms), decay_curve, sustain(%), release(ms), release_curve</tr>
            </argument>
            <argument name="easr" type="list">
                <tr lang="en">exponential ASR envelope: attack(ms), attack_curve, release(ms),
                release_curve - with sustain stop point</tr>
                <!-- old: Экспоненциальный конверт ASR: attack(ms),
                attack_curve, release(ms), release_curve - с точкой остановки -->
                <tr lang="ru" finished="false">Экспоненциальный конверт ASR: attack(ms),
                attack_curve, release(ms), release_curve - с точкой остановки</tr>
            </argument>
            <argument name="ear" type="list">
                <tr lang="en">exponential ASR envelope: attack(ms), attack_curve, release(ms),
                release_curve - no sustain point</tr>
                <!-- old: Экспоненциальная оболочка ASR: attack(ms),
                attack_curve, release(ms), release_curve - нет точки опоры -->
                <tr lang="ru" finished="false">Экспоненциальная оболочка ASR: attack(ms),
                attack_curve, release(ms), release_curve - нет точки опоры</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @length -->
            <property name="@length" type="float" units="millisecond" access="readonly" default="0"
            minvalue="0">
                <tr lang="en">total envelope time length</tr>
                <tr lang="ru" finished="false">Общая продолжительность конверта</tr>
            </property>
            <!-- @npoints -->
            <property name="@npoints" type="int" access="readonly" minvalue="0" default="0">
                <tr lang="en">number of points</tr>
                <tr lang="ru" finished="false">количество точек</tr>
            </property>
            <!-- @points -->
            <property name="@points" type="list" access="readonly" default="">
                <tr lang="en">list of point times (ms)</tr>
                <tr lang="ru" finished="false">Список моментов времени (ms)</tr>
            </property>
            <!-- @stops -->
            <property name="@stops" type="list" access="readonly" default="">
                <tr lang="en">list of stop points</tr>
                <tr lang="ru" finished="false">Список остановочных точек</tr>
            </property>
            <!-- @values -->
            <property name="@values" type="list" access="readonly" default="">
                <tr lang="en">list of point values</tr>
                <tr lang="ru" finished="false">Список точечных значений</tr>
            </property>
        </properties>
        <methods>
            <!-- * -->
            <method name="*">
                <info>
                    <tr lang="en">multiply all envelope points to specified value</tr>
                    <!-- old: Умножьте все точки конверта на заданное
                    значение -->
                    <tr lang="ru" finished="false">Умножьте все точки конверта на заданное
                    значение</tr>
                </info>
                <param name="VALUE" type="float" required="true">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- + -->
            <method name="+">
                <info>
                    <tr lang="en">add specified value to all envelope points</tr>
                    <!-- old: добавить указанное значение для всех точек
                    конверта -->
                    <tr lang="ru" finished="false">добавить указанное значение для всех точек
                    конверта</tr>
                </info>
                <param name="VALUE" type="float" required="true">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- >> -->
            <method name="&gt;&gt;">
                <info>
                    <tr lang="en">shift all envelope point by specified time in milliseconds</tr>
                    <!-- old: переместить всю точку конверта по заданному
                    времени в миллисекундах -->
                    <tr lang="ru" finished="false">переместить всю точку конверта по заданному
                    времени в миллисекундах</tr>
                </info>
                <param name="SHIFT" type="float" required="true" units="millisecond">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- add_point -->
            <method name="add_point">
                <info>
                    <tr lang="en">add envelope point</tr>
                    <tr lang="ru" finished="false">Добавить точку конверта</tr>
                </info>
                <param name="TIME" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">point time</tr>
                    <tr lang="ru" finished="false">точка</tr>
                </param>
                <param name="VALUE" type="float" required="true">
                    <tr lang="en">point value</tr>
                    <tr lang="ru" finished="false">значение точки</tr>
                </param>
                <param name="IS_STOP" type="int" enum="0 1" default="0">
                    <tr lang="en">is stop point</tr>
                    <tr lang="ru" finished="false">точка остановки</tr>
                </param>
                <param name="TYPE" type="symbol" enum="step line exp sin2 sigmoid" default="line">
                    <tr lang="en">segment type: step, linear, exponential, sin^2 or sigmoid
                    curve</tr>
                    <!-- old: тип сегмента: шаг, линейная, экспоненциальная,
                    sin2 или сигмоидная кривая -->
                    <tr lang="ru" finished="false">тип сегмента: шаг, линейная, экспоненциальная,
                    sin2 или сигмоидная кривая</tr>
                </param>
                <param name="CURVE" type="float" default="1">
                    <tr lang="en">exponential curve degree: 0 (linear) &lt;0 (concave, negatively
                    curved) &gt;0 (convex, positively curved)</tr>
                    <!-- old: Степень экспоненциальной кривой: 0 (линейная)
                    <0 (вогнутая, отрицательно изогнутая) >0 (выпуклая, положительно
                    изогнутая) -->
                    <tr lang="ru" finished="false">Степень экспоненциальной кривой: 0 (линейная)
                    &lt;0 (вогнутая, отрицательно изогнутая) &gt;0 (выпуклая, положительно
                    изогнутая)</tr>
                </param>
            </method>
            <!-- add_seg -->
            <method name="add_seg">
                <info>
                    <tr lang="en">add segment to the end of envelope. On empty envelope adds start
                    point at 0ms and 0 value</tr>
                    <!-- old: Добавьте сегмент в конец конверта. На пустом
                    конверте добавляется начальная точка 0ms и 0 значение -->
                    <tr lang="ru" finished="false">Добавьте сегмент в конец конверта. На пустом
                    конверте добавляется начальная точка 0ms и 0 значение</tr>
                </info>
                <param name="TYPE" type="symbol" required="true" enum="step line sin2 exp sigmoid">
                    <tr lang="en">segment type</tr>
                    <tr lang="ru" finished="false">Тип сегмента</tr>
                </param>
                <param name="LENGTH" type="float" units="millisecond" required="true">
                    <tr lang="en">segment length</tr>
                    <tr lang="ru" finished="false">длина сегмента</tr>
                </param>
                <param name="VALUE" type="float" required="true">
                    <tr lang="en">end segment value</tr>
                    <tr lang="ru" finished="false">Стоимость конечного сегмента</tr>
                </param>
                <param name="CURVE" type="float" required="false" default="0">
                    <tr lang="en">curve (for exp and sigmoid type)</tr>
                    <tr lang="ru" finished="false">кривая (для exp и сигмоидного типа)</tr>
                </param>
            </method>
            <!-- adsr -->
            <method name="adsr">
                <info>
                    <tr lang="en">creates ADSR envelope with one stop point</tr>
                    <!-- old: Создание конверта ADSR с одной точкой
                    остановки -->
                    <tr lang="ru" finished="false">Создание конверта ADSR с одной точкой
                    остановки</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">attack time</tr>
                    <tr lang="ru" finished="false">Время атаки</tr>
                </param>
                <param name="DECAY" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">decay time</tr>
                    <tr lang="ru" finished="false">время распада</tr>
                </param>
                <param name="SUSTAIN" type="float" units="percent" required="true" minvalue="0"
                maxvalue="100">
                    <tr lang="en">sustain level</tr>
                    <tr lang="ru" finished="false">поддержание</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true"
                minvalue="0">
                    <tr lang="en">release time</tr>
                    <tr lang="ru" finished="false">Время освобождения</tr>
                </param>
            </method>
            <!-- ar -->
            <method name="ar">
                <info>
                    <tr lang="en">creates AR envelope without stop points</tr>
                    <tr lang="ru" finished="false">Создает конверт AR без точек остановки</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">attack time</tr>
                    <tr lang="ru" finished="false">Время атаки</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true"
                minvalue="0">
                    <tr lang="en">release time</tr>
                    <tr lang="ru" finished="false">Время освобождения</tr>
                </param>
            </method>
            <!-- asr -->
            <method name="asr">
                <info>
                    <tr lang="en">creates ASR envelope with one stop point</tr>
                    <!-- old: Создание конверта ASR с одной точкой
                    остановки -->
                    <tr lang="ru" finished="false">Создание конверта ASR с одной точкой
                    остановки</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">attack time</tr>
                    <tr lang="ru" finished="false">Время атаки</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true"
                minvalue="0">
                    <tr lang="en">release time</tr>
                    <tr lang="ru" finished="false">Время освобождения</tr>
                </param>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">remove all envelope points</tr>
                    <tr lang="ru" finished="false">Удалить все точки конверта</tr>
                </info>
            </method>
            <!-- eadsr -->
            <method name="eadsr">
                <info>
                    <tr lang="en">creates exponential ADSR envelope with one stop point</tr>
                    <!-- old: создает экспоненциальный конверт ADSR с одной
                    точкой остановки -->
                    <tr lang="ru" finished="false">создает экспоненциальный конверт ADSR с одной
                    точкой остановки</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">attack time</tr>
                    <tr lang="ru" finished="false">Время атаки</tr>
                </param>
                <param name="ATTACK_CURVE" type="float" required="true">
                    <tr lang="en">attack segment curve</tr>
                    <tr lang="ru" finished="false">кривая сегмента атаки</tr>
                </param>
                <param name="DECAY" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">decay time</tr>
                    <tr lang="ru" finished="false">время распада</tr>
                </param>
                <param name="DECAY_CURVE" type="float" required="true">
                    <tr lang="en">decay segment curve</tr>
                    <tr lang="ru" finished="false">кривая сегмента распада</tr>
                </param>
                <param name="SUSTAIN" type="float" units="percent" required="true" minvalue="0"
                maxvalue="100">
                    <tr lang="en">sustain level</tr>
                    <tr lang="ru" finished="false">поддержание</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true"
                minvalue="0">
                    <tr lang="en">release time</tr>
                    <tr lang="ru" finished="false">Время освобождения</tr>
                </param>
                <param name="RELEASE_CURVE" type="float" required="true">
                    <tr lang="en">release segment curve</tr>
                    <tr lang="ru" finished="false">кривая сегмента высвобождения</tr>
                </param>
            </method>
            <!-- ear -->
            <method name="ear">
                <info>
                    <tr lang="en">creates exponential AR envelope without stop points</tr>
                    <!-- old: Создает экспоненциальный конверт AR без точек
                    остановки -->
                    <tr lang="ru" finished="false">Создает экспоненциальный конверт AR без точек
                    остановки</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true">
                    <tr lang="en">attack time</tr>
                    <tr lang="ru" finished="false">Время атаки</tr>
                </param>
                <param name="ATTACK_CURVE" type="float" required="true">
                    <tr lang="en">attack segment curve</tr>
                    <tr lang="ru" finished="false">кривая сегмента атаки</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true">
                    <tr lang="en">release time</tr>
                    <tr lang="ru" finished="false">Время освобождения</tr>
                </param>
                <param name="RELEASE_CURVE" type="float" required="true">
                    <tr lang="en">release segment curve</tr>
                    <tr lang="ru" finished="false">кривая сегмента высвобождения</tr>
                </param>
            </method>
            <!-- easr -->
            <method name="easr">
                <info>
                    <tr lang="en">creates exponential AR envelope with one stop point</tr>
                    <!-- old: Создает экспоненциальный конверт AR с одной
                    точкой остановки -->
                    <tr lang="ru" finished="false">Создает экспоненциальный конверт AR с одной
                    точкой остановки</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">attack time</tr>
                    <tr lang="ru" finished="false">Время атаки</tr>
                </param>
                <param name="ATTACK_CURVE" type="float" required="true">
                    <tr lang="en">attack segment curve</tr>
                    <tr lang="ru" finished="false">кривая сегмента атаки</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true"
                minvalue="0">
                    <tr lang="en">release time</tr>
                    <tr lang="ru" finished="false">Время освобождения</tr>
                </param>
                <param name="RELEASE_CURVE" type="float" required="true">
                    <tr lang="en">release segment curve</tr>
                    <tr lang="ru" finished="false">кривая сегмента высвобождения</tr>
                </param>
            </method>
            <!-- exp -->
            <method name="exp">
                <info>
                    <tr lang="en">creates exponential-segmented envelope with arbitrary number of
                    segments</tr>
                    <!-- old: создает экспоненциально-сегментированную
                    оболочку с произвольным количеством сегментов -->
                    <tr lang="ru" finished="false">создает экспоненциально-сегментированную
                    оболочку с произвольным количеством сегментов</tr>
                </info>
                <param name="VAL0" type="float" required="true">
                    <tr lang="en">begin value</tr>
                    <tr lang="ru" finished="false">Начало значения</tr>
                </param>
                <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
                    <tr lang="en">line length</tr>
                    <tr lang="ru" finished="false">длина линии</tr>
                </param>
                <param name="CURVE0" type="float" required="true">
                    <tr lang="en">segment curve</tr>
                    <tr lang="ru" finished="false">сегментная кривая</tr>
                </param>
                <param name="VAL1" type="float" required="true">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
                <param name="LEN1" type="float" required="false">
                    <tr lang="en">segment length</tr>
                    <tr lang="ru" finished="false">длина сегмента</tr>
                </param>
                <param name="CURVE1" type="float" required="false">
                    <tr lang="en">segment curve</tr>
                    <tr lang="ru" finished="false">сегментная кривая</tr>
                </param>
                <param name="VAL2" type="float" required="false">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- line -->
            <method name="line">
                <info>
                    <tr lang="en">creates line-segmented envelope with arbitrary number of
                    segments</tr>
                    <!-- old: создает линейно-сегментированный конверт с
                    произвольным количеством сегментов -->
                    <tr lang="ru" finished="false">создает линейно-сегментированный конверт с
                    произвольным количеством сегментов</tr>
                </info>
                <param name="VAL0" type="float" required="true">
                    <tr lang="en">begin value</tr>
                    <tr lang="ru" finished="false">Начало значения</tr>
                </param>
                <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
                    <tr lang="en">line length</tr>
                    <tr lang="ru" finished="false">длина линии</tr>
                </param>
                <param name="VAL1" type="float" required="true">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
                <param name="LEN1" type="float" required="false">
                    <tr lang="en">segment length</tr>
                    <tr lang="ru" finished="false">длина сегмента</tr>
                </param>
                <param name="VAL2" type="float" required="false">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- remove_point -->
            <method name="remove_point">
                <info>
                    <tr lang="en">remove envelope point by specified time</tr>
                    <!-- old: Удалить точку конверта по указанному
                    времени -->
                    <tr lang="ru" finished="false">Удалить точку конверта по указанному
                    времени</tr>
                </info>
                <param name="IDX" type="int" required="true" minvalue="0">
                    <tr lang="en">point index</tr>
                    <tr lang="ru" finished="false">точечный индекс</tr>
                </param>
            </method>
            <!-- set_point -->
            <method name="set_point">
                <info>
                    <tr lang="en">set point time and value</tr>
                    <tr lang="ru" finished="false">установленное время и ценность</tr>
                </info>
                <param name="IDX" type="int" required="true" minvalue="0">
                    <tr lang="en">point index</tr>
                    <tr lang="ru" finished="false">точечный индекс</tr>
                </param>
                <param name="TIME" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">point time</tr>
                    <tr lang="ru" finished="false">точка</tr>
                </param>
                <param name="VALUE" type="int" required="true" minvalue="0">
                    <tr lang="en">point value</tr>
                    <tr lang="ru" finished="false">значение точки</tr>
                </param>
                <param name="IS_STOP" type="int" enum="0 1" default="0">
                    <tr lang="en">stop point</tr>
                    <tr lang="ru" finished="false">точка остановки</tr>
                </param>
            </method>
            <!-- set_point_time -->
            <method name="set_point_time">
                <info>
                    <tr lang="en">set point time</tr>
                    <tr lang="ru" finished="false">установленный момент времени</tr>
                </info>
                <param name="IDX" type="int" required="true" minvalue="0">
                    <tr lang="en">point index</tr>
                    <tr lang="ru" finished="false">точечный индекс</tr>
                </param>
                <param name="TIME" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">point time</tr>
                    <tr lang="ru" finished="false">точка</tr>
                </param>
            </method>
            <!-- set_point_value -->
            <method name="set_point_value">
                <info>
                    <tr lang="en">set point time</tr>
                    <tr lang="ru" finished="false">установленный момент времени</tr>
                </info>
                <param name="IDX" type="int" required="true" minvalue="0">
                    <tr lang="en">point index</tr>
                    <tr lang="ru" finished="false">точечный индекс</tr>
                </param>
                <param name="VALUE" type="int" required="true" minvalue="0">
                    <tr lang="en">point value</tr>
                    <tr lang="ru" finished="false">значение точки</tr>
                </param>
            </method>
            <!-- set_seg_type -->
            <method name="set_seg_type">
                <info>
                    <tr lang="en">set segment type</tr>
                    <tr lang="ru" finished="false">тип сегмента</tr>
                </info>
                <param name="IDX" type="int" required="true" minvalue="0">
                    <tr lang="en">segment index, starting from 0</tr>
                    <tr lang="ru" finished="false">Индекс сегмента, начинающийся с 0</tr>
                </param>
                <param name="TYPE" type="symbol" required="true" enum="step line sin2 exp sigmoid">
                    <tr lang="en">segment type</tr>
                    <tr lang="ru" finished="false">Тип сегмента</tr>
                </param>
            </method>
            <!-- set_stop_point -->
            <method name="set_stop_point">
                <info>
                    <tr lang="en">set stop-point</tr>
                    <tr lang="ru" finished="false">установленная точка остановки</tr>
                </info>
                <param name="IDX" type="int" required="true" minvalue="0">
                    <tr lang="en">point index</tr>
                    <tr lang="ru" finished="false">точечный индекс</tr>
                </param>
                <param name="IS_STOP" type="int" enum="0 1" required="true">
                    <tr lang="en">stop point</tr>
                    <tr lang="ru" finished="false">точка остановки</tr>
                </param>
            </method>
            <!-- sigmoid -->
            <method name="sigmoid">
                <info>
                    <tr lang="en">creates sigmoid-segmented envelope with arbitrary number of
                    segments</tr>
                    <!-- old: создает сигмоид-сегментированную оболочку с
                    произвольным количеством сегментов -->
                    <tr lang="ru" finished="false">создает сигмоид-сегментированную оболочку с
                    произвольным количеством сегментов</tr>
                </info>
                <param name="VAL0" type="float" required="true">
                    <tr lang="en">begin value</tr>
                    <tr lang="ru" finished="false">Начало значения</tr>
                </param>
                <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
                    <tr lang="en">line length</tr>
                    <tr lang="ru" finished="false">длина линии</tr>
                </param>
                <param name="CURVE0" type="float" required="true">
                    <tr lang="en">segment curve</tr>
                    <tr lang="ru" finished="false">сегментная кривая</tr>
                </param>
                <param name="VAL1" type="float" required="true">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
                <param name="LEN1" type="float" required="false">
                    <tr lang="en">segment length</tr>
                    <tr lang="ru" finished="false">длина сегмента</tr>
                </param>
                <param name="CURVE1" type="float" required="false">
                    <tr lang="en">segment curve</tr>
                    <tr lang="ru" finished="false">сегментная кривая</tr>
                </param>
                <param name="VAL2" type="float" required="false">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- sin2 -->
            <method name="sin2">
                <info>
                    <tr lang="en">creates quadratic sine-segmented envelope with arbitrary number
                    of segments</tr>
                    <!-- old: создает квадратичную синесегментированную
                    оболочку с произвольным числом сегментов -->
                    <tr lang="ru" finished="false">создает квадратичную синесегментированную
                    оболочку с произвольным числом сегментов</tr>
                </info>
                <param name="VAL0" type="float" required="true">
                    <tr lang="en">begin value</tr>
                    <tr lang="ru" finished="false">Начало значения</tr>
                </param>
                <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
                    <tr lang="en">line length</tr>
                    <tr lang="ru" finished="false">длина линии</tr>
                </param>
                <param name="VAL1" type="float" required="true">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
                <param name="LEN1" type="float" required="false">
                    <tr lang="en">segment length</tr>
                    <tr lang="ru" finished="false">длина сегмента</tr>
                </param>
                <param name="VAL2" type="float" required="false">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- step -->
            <method name="step">
                <info>
                    <tr lang="en">creates step-segmented envelope with arbitrary number of
                    segments</tr>
                    <!-- old: создает пошаговый сегментированный конверт с
                    произвольным количеством сегментов -->
                    <tr lang="ru" finished="false">создает пошаговый сегментированный конверт с
                    произвольным количеством сегментов</tr>
                </info>
                <param name="VAL0" type="float" required="true">
                    <tr lang="en">begin value</tr>
                    <tr lang="ru" finished="false">Начало значения</tr>
                </param>
                <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
                    <tr lang="en">step length</tr>
                    <tr lang="ru" finished="false">длина шага</tr>
                </param>
                <param name="VAL1" type="float" required="true">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
                <param name="LEN1" type="float" required="false">
                    <tr lang="en">segment length</tr>
                    <tr lang="ru" finished="false">длина сегмента</tr>
                </param>
                <param name="VAL2" type="float" required="false">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">outputs current envelope</tr>
                    <tr lang="ru" finished="false">выходы текущего конверта</tr>
                </xinfo>
                <xinfo on="data">
                    <tr lang="en">set new envelope and output it</tr>
                    <tr lang="ru" finished="false">установить новый конверт и вывести его</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">data output</tr>
                    <tr lang="ru" finished="false">выход данных</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ar 100 200, bang( [exp 0 30 -2 1 100 -4 0 40 4 0.5 30 2 0, bang #a(
|
| [adsr 10 30 60 150, bang( [line 0.1 40 0.9 20 0.3 60 0, bang #b(
| |
| | [ear 10 -2 60 -2, bang( [sigmoid 0 40 14 1 100 8 0, bang #c(
| | |
| | | [eadsr 20 -5 70 -12 30 100 -7, bang( [sin2 0 80 1 80 0, bang #d(
| | | |
[envelope #env]
|
[env->array env_arr]


[array env_arr size=100 w=400 h=100 yr=0..1]

[X a->env] [X b->env] [X c->env] [X d->env]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
