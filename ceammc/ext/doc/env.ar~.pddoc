<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env.ar~">
    <title>env.ar~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Attack/Release envelope generator</tr>
        <tr lang="ru">генератор огибающей Attack/Release (атака/восстановление)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>envelope ar</keywords>
      <since>0.7</since>
      <also>
        <see>env.adsr~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">A simple AR (Attack / Release) envelope generator with two stages: attack
        (rise from 0 to 1) and release (fall back to 0). Unlike [env.adsr~], it has no decay or
        sustain stage, so it is triggered by a bang or a gate and immediately starts fading out
        after the attack is complete. The envelope multiplies the incoming audio signal by its
        current value.</tr>
        <tr lang="ru">Простой генератор огибающей AR (атака / восстановление) с двумя фазами:
        атакой (рост от 0 до 1) и восстановлением (спад обратно к 0). В отличие от [env.adsr~],
        здесь нет фаз спада и удержания, поэтому огибающая запускается по bang или gate и сразу
        начинает затухать после завершения атаки. Огибающая умножает входящий аудиосигнал на своё
        текущее значение.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Percussive sounds — shaping the amplitude of a short hit or click, where
        the sound should fade out naturally after the attack without holding a sustain level.</tr>
        <tr lang="ru">• Перкуссионные звуки — формирование амплитуды короткого удара или щелчка,
        когда звук должен естественно затухать после атаки, без удержания уровня.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Plucked string emulation — reproducing the natural decay of a plucked
        string or a struck bell, where there is no sustain phase.</tr>
        <tr lang="ru">• Эмуляция щипковых струн — воспроизведение естественного затухания щипковой
        струны или удара колокола, когда фаза удержания отсутствует.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Modulation envelopes — modulating filter cutoff, pitch, or pan with a short
        attack-release shape to add accents or movement to a parameter.</tr>
        <tr lang="ru">• Огибающие модуляции — модуляция среза фильтра, высоты тона или панорамы
        короткой формой attack-release для добавления акцентов или движения в параметр.</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">run envelope</event>
    </mouse>
    <arguments>
      <argument name="ATTACK" type="float" units="millisecond" minvalue="0" maxvalue="100000">
        <tr lang="en">attack time</tr>
        <tr lang="ru">время атаки</tr>
      </argument>
      <argument name="RELEASE" type="float" units="millisecond" minvalue="0" maxvalue="100000">
        <tr lang="en">release time</tr>
        <tr lang="ru">время восстановления</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @ar -->
      <property name="@ar" type="list" access="readonly">
        <tr lang="en">attack release pair</tr>
        <tr lang="ru">пара «атака, восстановление»</tr>
      </property>
      <!-- @attack -->
      <property name="@attack" type="float" units="millisecond" minvalue="0" maxvalue="100000"
      default="10">
        <tr lang="en">attack time</tr>
        <tr lang="ru">время атаки</tr>
      </property>
      <!-- @gate -->
      <property name="@gate" type="bool" default="0">
        <tr lang="en">trigger signal</tr>
        <tr lang="ru">триггерный сигнал</tr>
      </property>
      <!-- @length -->
      <property name="@length" type="float" units="millisecond" access="readonly" default="310">
        <tr lang="en">envelope length</tr>
        <tr lang="ru">длительность огибающей</tr>
      </property>
      <!-- @release -->
      <property name="@release" type="float" units="millisecond" minvalue="0" maxvalue="100000"
      default="300">
        <tr lang="en">release time</tr>
        <tr lang="ru">время восстановления</tr>
      </property>
    </properties>
    <methods>
      <!-- play -->
      <method name="play">
        <info>
          <tr lang="en">runs the envelope</tr>
          <tr lang="ru">запускает огибающую</tr>
        </info>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the envelope to its initial state</tr>
          <tr lang="ru">возвращает огибающую в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
        <in on="bang">
          <tr lang="en">runs the envelope</tr>
          <tr lang="ru">запускает огибающую</tr>
        </in>
        <in on="list">
          <tr lang="en">ATTACK, RELEASE values are expected</tr>
          <tr lang="ru">ожидаются значения ATTACK, RELEASE</tr>
        </in>
        <in on="data">
          <tr lang="en">envelope data type</tr>
          <tr lang="ru">тип данных огибающей</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal with the applied envelope</tr>
          <tr lang="ru">выходной сигнал с применённой огибающей</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">bang when the envelope is finished</tr>
          <tr lang="ru">bang по завершении огибающей</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[osc.tri~ 1500] [msg.onload]
|               |
|               [ar 300 8(
|               |
|               [ui.env @size 200 70]
|               |
|               |
|               |
|               |
|   [B]         |
|   |           |
[env.ar~ 10 600  ]
|           ^|
|           [B]
|
[ui.gain~ @size 140 16] [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
