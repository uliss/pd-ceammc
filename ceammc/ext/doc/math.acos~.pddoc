<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.acos~">
        <title>math.acos~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">arc cosine function for signals</tr>
                <tr lang="ru">арккосинус для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math acos</keywords>
            <also>
                <see>math.acos</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Outputs the principle value of the arc cosine of input signal. The
                result is in the range [0, pi]</tr>
                <!-- old: Выходит принципиальное значение дугового косинуса
                входного сигнала. Результат находится в диапазоне [0, pi]. -->
                <tr lang="ru" finished="false">Выходит принципиальное значение дугового косинуса
                входного сигнала. Результат находится в диапазоне [0, pi].</tr>
            </par>
        </info>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">result signal</tr>
                    <tr lang="ru" finished="false">результат сигнала</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[plot.linspace~ -1 1]
|                 ^|
[math.acos~]       |
|                  |.
[ui.plot~ @xlabels 1 @ylabels 1 @yauto 1 @size 200 200]














[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
