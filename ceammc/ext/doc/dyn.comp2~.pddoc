<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="dyn.comp2~">
    <title>dyn.comp2~</title>
    <meta>
      <authors>
        <author>Alex Nadzharov</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">stereo dynamic range compressor</tr>
        <tr lang="ru">стерео-компрессор динамического диапазона</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>dyn</category>
      <keywords>compressor</keywords>
      <since>0.1</since>
      <also>
        <see>dyn.comp~</see>
      </also>
    </meta>
    <info>
      <a href="https://en.wikipedia.org/wiki/Dynamic_range_compression">Dynamic range
      compression</a>
    </info>
    <arguments>
      <argument name="RATIO" type="float" minvalue="1" maxvalue="16">
        <tr lang="en">compression ratio (1 = no compression, &gt;1 means compression)</tr>
        <tr lang="ru">коэффициент сжатия (1 = без компрессии, &gt;1 означает компрессию)</tr>
      </argument>
      <argument name="THRESHOLD" type="float" minvalue="-90" maxvalue="0" units="decibel">
        <tr lang="en">level threshold above which compression kicks in</tr>
        <tr lang="ru">порог уровня, выше которого начинается компрессия</tr>
      </argument>
      <argument name="ATTACK" type="float" units="millisecond" minvalue="0.1" maxvalue="100">
        <tr lang="en">attack time - the time that elapses between exceeding the threshold and when
        the compression ratio is reached</tr>
        <tr lang="ru">время атаки — время, которое проходит между превышением порога и достижением
        заданного коэффициента сжатия</tr>
      </argument>
      <argument name="RELEASE" type="float" units="millisecond" minvalue="1" maxvalue="500">
        <tr lang="en">release time - the time that elapses between when the input signal level
        drops below the threshold and when the compressor stops attenuating the signal</tr>
        <tr lang="ru">время восстановления — время, которое проходит между падением уровня входного
        сигнала ниже порога и моментом, когда компрессор перестаёт ослаблять сигнал</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @attack -->
      <property name="@attack" type="float" units="millisecond" default="10" minvalue="0.1"
      maxvalue="100">
        <tr lang="en">time constant when level and compression are increasing</tr>
        <tr lang="ru">постоянная времени, когда уровень и сжатие увеличиваются</tr>
      </property>
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypasses the effected signal.</tr>
        <tr lang="ru">флаг обхода. Если true: обходит обработанный сигнал.</tr>
      </property>
      <!-- @gain -->
      <property name="@gain" type="float" units="decibel" default="0" minvalue="-18" maxvalue="18">
        <tr lang="en">make-up gain: applied to the signal after compression takes place.</tr>
        <tr lang="ru">компенсационное усиление: применяется к сигналу после компрессии.</tr>
      </property>
      <!-- @level -->
      <property name="@level" type="float" default="0" minvalue="0" maxvalue="1" access="readonly">
        <tr lang="en">current compression level</tr>
        <tr lang="ru">текущий уровень сжатия</tr>
      </property>
      <!-- @ratio -->
      <property name="@ratio" type="float" default="1" minvalue="1" maxvalue="16">
        <tr lang="en">compression ratio (1 = no compression, &gt;1 means compression)</tr>
        <tr lang="ru">коэффициент сжатия (1 = без компрессии, &gt;1 означает компрессию)</tr>
      </property>
      <!-- @refresh -->
      <property name="@refresh" type="int" default="100" minvalue="0" maxvalue="1000"
      units="millisecond">
        <tr lang="en">compression level output interval. If 0: no output.</tr>
        <tr lang="ru">интервал вывода уровня сжатия. Если 0: вывод отсутствует.</tr>
      </property>
      <!-- @release -->
      <property name="@release" type="float" units="millisecond" default="50" minvalue="1"
      maxvalue="500">
        <tr lang="en">release time — time constant when coming out of compression.</tr>
        <tr lang="ru">время восстановления — постоянная времени при выходе из компрессии.</tr>
      </property>
      <!-- @threshold -->
      <property name="@threshold" type="float" units="decibel" default="-10" minvalue="-90"
      maxvalue="0">
        <tr lang="en">level threshold above which compression kicks in</tr>
        <tr lang="ru">порог уровня, выше которого начинается компрессия</tr>
      </property>
    </properties>
    <methods>
      <!-- preset -->
      <method name="preset">
        <info>
          <tr lang="en">choose a predefined preset</tr>
          <tr lang="ru">выбрать предустановленный набор параметров</tr>
        </info>
        <param name="PRESET" type="symbol" enum="vocal drums bass strings" required="true">
          <tr lang="en">preset name</tr>
          <tr lang="ru">имя предустановки</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset to the initial state</tr>
          <tr lang="ru">сбросить в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">left input signal</tr>
          <tr lang="ru">левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">right input signal</tr>
          <tr lang="ru">правый входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left output signal</tr>
          <tr lang="ru">левый выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right output signal</tr>
          <tr lang="ru">правый выходной сигнал</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">float: outputs the current compression level in the range [0..1]</tr>
          <tr lang="ru">float: выводит текущий уровень сжатия в диапазоне [0..1]</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.hsl #x]  [ui.hsl #x]          [ui.dsp~]
|            |
[dbfs->amp]  [dbfs->amp]
|            |
[sig~]       [sig~] [ui.hsl #a]   [ui.hsl #b]
|            |      |             |
|            |      |             |
|            |      [@ratio $1(   [@threshold $1(
|            |      |             |
|            |.     |             |
[dyn.comp2~ 3 -60 10 100         ]
|        ^|         ^^|
[env~]   [env~]     [ui.hsl @active_scale 1]
|        |
[- 100]  [- 100]
|        |
[F]      [F]

#a 1 16 @show_value 1
#b -60 0 @show_value 1
#x -60 20 @show_value 1
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
