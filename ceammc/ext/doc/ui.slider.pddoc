<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="ui.slider" type="gui">
        <title>ui.slider</title>
        <meta>
            <authors>
                <author>Pierre Guillot</author>
            </authors>
            <description>
                <tr lang="en">slider widget</tr>
                <tr lang="ru">виджет слайдера (ползунка)</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui slider</keywords>
            <since>0.1</since>
            <aliases>
                <alias view="link">ui.hsl</alias>
                <alias view="link">ui.vsl</alias>
            </aliases>
            <also>
                <see view="link">ui.slider2d</see>
                <see view="link">ui.sliders</see>
                <see view="link">ui.knob</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">[ui.hsl] is alias for horizontal slider, [ui.vsl] - for vertical</tr>
            </par>
        </info>
        <mouse>
            <event type="drag" editmode="true" keys="Cmd">changes the slider value</event>
            <event type="double-click" editmode="true" keys="Cmd">changes slider
            orientation</event>
            <event type="drag" editmode="0">changes the slider value</event>
            <event type="drag" editmode="0" keys="Shift">changes the slider value slowly (only in
            relative mode)</event>
            <event type="left-click" editmode="0">jump to value unless @mode property is on</event>
            <event type="double-click" editmode="0" keys="Shift">toggle MIDI-learn mode (red border
            displayed)</event>
            <event type="wheel" editmode="true" keys="Cmd">change the knob value (with ⇧ change
            slowly)</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <arguments>
            <argument name="MIN" type="float">
                <tr lang="en">min value</tr>
            </argument>
            <argument name="MAX" type="float">
                <tr lang="en">max value</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_label.xml" />
            <xi:include href="props_label_align.xml" />
            <xi:include href="props_label_inner.xml" />
            <xi:include href="props_label_margins.xml" />
            <xi:include href="props_label_side.xml" />
            <xi:include href="props_label_valign.xml" />
            <xi:include href="props_pinned.xml" />
            <xi:include href="props_ui_receive.xml" />
            <xi:include href="props_ui_send.xml" />
            <xi:include href="props_midi_channel.xml" />
            <xi:include href="props_preset.xml" />
            <!-- @active_scale -->
            <property name="@active_scale" type="bool" default="0">
                <tr lang="en">if should draw active scale</tr>
            </property>
            <!-- @knob_color -->
            <property name="@knob_color" type="list" default="0 0.75 1 1">
                <tr lang="en">knob color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @max -->
            <property name="@max" type="float" default="1">
                <tr lang="en">maximum slider value</tr>
            </property>
            <!-- @midi_control -->
            <property name="@midi_control" type="int" minvalue="-1" maxvalue="127" default="-1">
                <tr lang="en">binded MIDI controller number. -1 means not binded to any
                controller.</tr>
            </property>
            <!-- @midi_pickup -->
            <property name="@midi_pickup" type="bool" default="1">
                <tr lang="en">pickup current value. If slider is binded to value, first time you
                should pass over this value to make binding. It prevents from sudden value change
                on first control change</tr>
            </property>
            <!-- @min -->
            <property name="@min" type="float" default="0">
                <tr lang="en">minimum slider value</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="bool" default="0">
                <tr lang="en">relative mode. Do not jump on click to value</tr>
            </property>
            <!-- @mouse_events -->
            <property name="@mouse_events" type="bool" default="0">
                <tr lang="en">mouse events output mode. If on outputs @mouse_down, @mouse_up and
                @mouse_drag events</tr>
            </property>
            <!-- @scale -->
            <property name="@scale" type="symbol" default="linear" enum="linear log">
                <tr lang="en">scale mode. Linear or logarithmic.</tr>
            </property>
            <!-- @show_value -->
            <property name="@show_value" type="bool" default="0">
                <tr lang="en">show value (in horizontal mode only)</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="15 120">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
            <!-- @text_color -->
            <property name="@text_color" type="list" default="0 0 0 1">
                <tr lang="en">value text color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="float" default="0">
                <tr lang="en">current value</tr>
            </property>
            <!-- @value_pos -->
            <property name="@value_pos" type="symbol" default="center" enum="left center right">
                <tr lang="en">value position</tr>
            </property>
            <!-- @value_precision -->
            <property name="@value_precision" type="int" default="2" minvalue="0" maxvalue="7">
                <tr lang="en">number of digits shown after decimal point</tr>
            </property>
        </properties>
        <methods>
            <!-- * -->
            <method name="*">multiply slider value without output 
            <param name="V" type="float" required="true">
                <tr lang="en">multiplied value</tr>
            </param></method>
            <!-- + -->
            <method name="+">add value to slider without output 
            <param name="V" type="float" required="true">
                <tr lang="en">added value</tr>
            </param></method>
            <!-- ++ -->
            <method name="++">increment slider value without output</method>
            <method name="-">subtract value from slider without output 
            <param name="V" type="float" required="true">
                <tr lang="en">subtracted value</tr>
            </param></method>
            <method name="--">decrement slider value without output</method>
            <!-- / -->
            <method name="/">divide slider value without output 
            <param name="V" type="float" required="true">
                <tr lang="en">denominator value</tr>
            </param></method>
            <!-- clear -->
            <method name="clear">clears specified preset 
            <param name="IDX" type="int" required="true">
                <tr lang="en">preset index</tr>
            </param></method>
            <!-- interp -->
            <method name="interp">interplolates between presets 
            <param name="IDX" type="float" required="true">
                <tr lang="en">preset fraction index</tr>
            </param></method>
            <!-- load -->
            <method name="load">loads specified preset 
            <param name="IDX" type="int" required="true">
                <tr lang="en">preset index</tr>
            </param></method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">
                <tr lang="en">top left x-coord</tr>
            </param>
            <param name="Y" type="float" required="true">
                <tr lang="en">top right y-coord</tr>
            </param></method>
            <!-- random -->
            <method name="random">set slider to random value and output</method>
            <!-- set -->
            <method name="set">sets slider value without output 
            <param name="V" type="atom" required="true">
                <tr lang="en">new float value or 'random'</tr>
            </param></method>
            <!-- store -->
            <method name="store">stores specified preset 
            <param name="IDX" type="int" required="true">
                <tr lang="en">preset index</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">outputs current slider state</xinfo>
                <xinfo on="float">set slider value and output</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[5( [50( [set 100( [bang(
|   |    |         |
|   |    |         |  [- 5( [+ 10( [* 2( [/ 3(
|   |    |         |  |     |      |     |
|   |    |         |  |     |      |     | [++, bang( [--, bang #a(
|   |    |         |  |     |      |     | |
|   |    |         |  |     |      |     | | [random(
|   |    |         |  |     |      |     | | |
[ui.slider @max 127                        #z]
|
|
|
|
|
|
|
|
[F]

[X a->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
