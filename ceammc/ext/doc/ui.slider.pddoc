<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.slider" type="gui">
    <title>ui.slider</title>
    <meta>
      <authors>
        <author>Pierre Guillot</author>
      </authors>
      <description>
        <tr lang="en">slider widget</tr>
        <tr lang="ru">виджет-слайдер</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui slider</keywords>
      <since>0.1</since>
      <aliases>
        <alias view="link">ui.hsl</alias>
        <alias view="link">ui.vsl</alias>
      </aliases>
      <also>
        <see view="link">ui.slider2d</see>
        <see view="link">ui.sliders</see>
        <see view="link">ui.knob</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">[ui.hsl] is an alias for the horizontal slider, [ui.vsl] — for the vertical one</tr>
        <tr lang="ru">[ui.hsl] — псевдоним для горизонтального слайдера, [ui.vsl] — для вертикального</tr>
      </par>
      <par>
        <tr lang="en">the slider value is set by dragging the mouse or by a click that jumps to the clicked position, unless @mode is on</tr>
        <tr lang="ru">значение слайдера задаётся перетаскиванием мыши или кликом, который переходит в позицию клика, если только не включён @mode</tr>
      </par>
      <par>
        <tr lang="en">@min, @max and @scale define the value range and response curve, @show_value displays the numeric value</tr>
        <tr lang="ru">@min, @max и @scale задают диапазон значений и кривую отклика, @show_value отображает числовое значение</tr>
      </par>
    </info>
    <mouse>
      <event type="drag" editmode="true" keys="Cmd">changes the slider value</event>
      <event type="double-click" editmode="true" keys="Cmd">changes slider orientation</event>
      <event type="drag" editmode="0">changes the slider value</event>
      <event type="drag" editmode="0" keys="Shift">changes the slider value slowly (only in
      relative mode)</event>
      <event type="left-click" editmode="0">jump to value unless @mode property is on</event>
      <event type="double-click" editmode="0" keys="Shift">toggle MIDI-learn mode (red border
      displayed)</event>
      <event type="wheel" editmode="true" keys="Cmd">change the knob value (with ⇧ change
      slowly)</event>
      <event type="right-click" editmode="false" keys="Shift">open object help</event>
      <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
      <event type="right-click" editmode="true">opens Pd popup menu</event>
      <event type="right-click" editmode="true" keys="Shift">open object help</event>
      <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
    </mouse>
    <arguments>
      <argument name="MIN" type="float">
        <tr lang="en">min value</tr>
        <tr lang="ru">минимальное значение</tr>
      </argument>
      <argument name="MAX" type="float">
        <tr lang="en">max value</tr>
        <tr lang="ru">максимальное значение</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_background_color.xml" />
      <xi:include href="props_border_color.xml" />
      <xi:include href="props_fontname.xml" />
      <xi:include href="props_fontsize.xml" />
      <xi:include href="props_fontslant.xml" />
      <xi:include href="props_fontweight.xml" />
      <xi:include href="props_label.xml" />
      <xi:include href="props_label_align.xml" />
      <xi:include href="props_label_inner.xml" />
      <xi:include href="props_label_margins.xml" />
      <xi:include href="props_label_side.xml" />
      <xi:include href="props_label_valign.xml" />
      <xi:include href="props_pinned.xml" />
      <xi:include href="props_ui_receive.xml" />
      <xi:include href="props_ui_send.xml" />
      <xi:include href="props_midi_channel.xml" />
      <xi:include href="props_preset.xml" />
      <!-- @active_scale -->
      <property name="@active_scale" type="bool" default="0">
        <tr lang="en">if true, draw the active scale</tr>
        <tr lang="ru">если true, рисовать активную шкалу</tr>
      </property>
      <!-- @knob_color -->
      <property name="@knob_color" type="list" default="0 0.75 1 1">
        <tr lang="en">knob color (list of red, green, blue values in 0–1 range)</tr>
        <tr lang="ru">цвет ручки (список значений красного, зелёного, синего в диапазоне 0–1)</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="float" default="1">
        <tr lang="en">maximum slider value</tr>
        <tr lang="ru">максимальное значение слайдера</tr>
      </property>
      <!-- @midi_control -->
      <property name="@midi_control" type="int" minvalue="-1" maxvalue="127" default="-1">
        <tr lang="en">bound MIDI controller number. -1 means not bound to any controller</tr>
        <tr lang="ru">привязанный номер MIDI-контроллера. -1 означает, что контроллер не привязан</tr>
      </property>
      <!-- @midi_pickup -->
      <property name="@midi_pickup" type="bool" default="1">
        <tr lang="en">pickup current value. If the slider is bound to a MIDI controller, you first have to pass over the current value to make the binding. This prevents a sudden value jump on the first control change</tr>
        <tr lang="ru">подхват текущего значения. Если слайдер привязан к MIDI-контроллеру, сначала нужно пройти через текущее значение, чтобы установить связь. Это предотвращает внезапный скачок значения при первом изменении контроллера</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="float" default="0">
        <tr lang="en">minimum slider value</tr>
        <tr lang="ru">минимальное значение слайдера</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="bool" default="0">
        <tr lang="en">relative mode. Do not jump on click to value</tr>
        <tr lang="ru">относительный режим. Не переходить к значению по клику</tr>
      </property>
      <!-- @mouse_events -->
      <property name="@mouse_events" type="bool" default="0">
        <tr lang="en">mouse events output mode. If on, outputs @mouse_down, @mouse_up and @mouse_drag events</tr>
        <tr lang="ru">режим вывода событий мыши. Если включён, выводит события @mouse_down, @mouse_up и @mouse_drag</tr>
      </property>
      <!-- @scale -->
      <property name="@scale" type="symbol" default="linear" enum="linear log">
        <tr lang="en">scale mode: linear or logarithmic</tr>
        <tr lang="ru">режим шкалы: линейный или логарифмический</tr>
      </property>
      <!-- @show_value -->
      <property name="@show_value" type="bool" default="0">
        <tr lang="en">show value (in horizontal mode only)</tr>
        <tr lang="ru">показывать значение (только в горизонтальном режиме)</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="15 120">
        <tr lang="en">object size (width, height pair)</tr>
        <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
      </property>
      <!-- @text_color -->
      <property name="@text_color" type="list" default="0 0 0 1">
        <tr lang="en">value text color (list of red, green, blue values in 0–1 range)</tr>
        <tr lang="ru">цвет текста значения (список значений красного, зелёного, синего в диапазоне 0–1)</tr>
      </property>
      <!-- @value -->
      <property name="@value" type="float" default="0">
        <tr lang="en">current value</tr>
        <tr lang="ru">текущее значение</tr>
      </property>
      <!-- @value_pos -->
      <property name="@value_pos" type="symbol" default="center" enum="left center right">
        <tr lang="en">value position</tr>
        <tr lang="ru">положение значения</tr>
      </property>
      <!-- @value_precision -->
      <property name="@value_precision" type="int" default="2" minvalue="0" maxvalue="7">
        <tr lang="en">number of digits shown after decimal point</tr>
        <tr lang="ru">количество знаков после запятой</tr>
      </property>
    </properties>
    <methods>
      <!-- * -->
      <method name="*">
        <info>
          <tr lang="en">multiply slider value without output</tr>
          <tr lang="ru">умножить значение слайдера без вывода</tr>
        </info>
        <param name="V" type="float" required="true">
          <tr lang="en">multiplied value</tr>
          <tr lang="ru">умножаемое значение</tr>
        </param>
      </method>
      <!-- + -->
      <method name="+">
        <info>
          <tr lang="en">add value to slider without output</tr>
          <tr lang="ru">прибавить значение к слайдеру без вывода</tr>
        </info>
        <param name="V" type="float" required="true">
          <tr lang="en">added value</tr>
          <tr lang="ru">прибавляемое значение</tr>
        </param>
      </method>
      <!-- ++ -->
      <method name="++">
        <info>
          <tr lang="en">increment slider value without output</tr>
          <tr lang="ru">увеличить значение слайдера на единицу без вывода</tr>
        </info>
      </method>
      <method name="-">
        <info>
          <tr lang="en">subtract value from slider without output</tr>
          <tr lang="ru">вычесть значение из слайдера без вывода</tr>
        </info>
        <param name="V" type="float" required="true">
          <tr lang="en">subtracted value</tr>
          <tr lang="ru">вычитаемое значение</tr>
        </param>
      </method>
      <method name="--">
        <info>
          <tr lang="en">decrement slider value without output</tr>
          <tr lang="ru">уменьшить значение слайдера на единицу без вывода</tr>
        </info>
      </method>
      <!-- / -->
      <method name="/">
        <info>
          <tr lang="en">divide slider value without output</tr>
          <tr lang="ru">разделить значение слайдера без вывода</tr>
        </info>
        <param name="V" type="float" required="true">
          <tr lang="en">denominator value</tr>
          <tr lang="ru">значение знаменателя</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clears the specified preset</tr>
          <tr lang="ru">очищает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- interp -->
      <method name="interp">
        <info>
          <tr lang="en">interpolates between presets</tr>
          <tr lang="ru">интерполирует между пресетами</tr>
        </info>
        <param name="IDX" type="float" required="true">
          <tr lang="en">preset fraction index</tr>
          <tr lang="ru">дробный индекс пресета</tr>
        </param>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">loads the specified preset</tr>
          <tr lang="ru">загружает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set UI element position</tr>
          <tr lang="ru">задать положение элемента UI</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top left x-coord</tr>
          <tr lang="ru">x-координата верхнего левого угла</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top right y-coord</tr>
          <tr lang="ru">y-координата верхнего левого угла</tr>
        </param>
      </method>
      <!-- random -->
      <method name="random">
        <info>
          <tr lang="en">set slider to a random value and output</tr>
          <tr lang="ru">установить слайдер в случайное значение и вывести</tr>
        </info>
      </method>
      <!-- set -->
      <method name="set">
        <info>
          <tr lang="en">sets slider value without output</tr>
          <tr lang="ru">устанавливает значение слайдера без вывода</tr>
        </info>
        <param name="V" type="atom" required="true">
          <tr lang="en">new float value or 'random'</tr>
          <tr lang="ru">новое числовое значение или 'random'</tr>
        </param>
      </method>
      <!-- store -->
      <method name="store">
        <info>
          <tr lang="en">stores the specified preset</tr>
          <tr lang="ru">сохраняет указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs current slider state</tr>
          <tr lang="ru">выводит текущее состояние слайдера</tr>
        </in>
        <in on="float">
          <tr lang="en">set slider value and output</tr>
          <tr lang="ru">установить значение слайдера и вывести</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output value</tr>
          <tr lang="ru">выходное значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[5( [50( [set 100( [bang(
|   |    |         |
|   |    |         |  [- 5( [+ 10( [* 2( [/ 3(
|   |    |         |  |     |      |     |
|   |    |         |  |     |      |     | [++, bang( [--, bang #a(
|   |    |         |  |     |      |     | |
|   |    |         |  |     |      |     | | [random(
|   |    |         |  |     |      |     | | |
[ui.slider @max 127                        #z]
|
|
|
|
|
|
|
|
[F]

[X a->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
