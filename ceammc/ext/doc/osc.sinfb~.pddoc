<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="osc.sinfb~">
        <title>osc.sinfb~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sine oscillator with feedback</tr>
                <tr lang="ru">синусоидальный осциллятор с обратной связью</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>osc</category>
            <keywords>osc feedback</keywords>
            <since>0.1</since>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" minvalue="0.0" maxvalue="22050" units="hertz">
                <tr lang="en">See @freq</tr>
            </argument>
            <argument name="FEEDBACK" type="float" minvalue="0" maxvalue="6.283185">
                <tr lang="en">oscillator feedback coefficient in range 0..2pi</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1">
                <tr lang="en">on/off dsp processing</tr>
            </property>
            <!-- @feedback -->
            <property name="@feedback" type="float" minvalue="0" maxvalue="6.2832" default="0">
                <tr lang="en">oscillator feedback coefficient</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" default="0" minvalue="0" maxvalue="22050"
            units="hertz">
                <tr lang="en">frequency</tr>
            </property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo>frequency</xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">reset phase</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]     [ui.knob @min 0 @max 6.28]
|       |
|       |
|       |
|       [@feedback $1(
|       |
[osc.sinfb~ 440 2]
|
[ui.gain~ @size 120 14]  [ui.dsp~]
|\      |
[dac~]  [ui.scope~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
