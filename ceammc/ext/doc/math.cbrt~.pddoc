<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.cbrt~">
        <title>math.cbrt~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">cube root function for signals</tr>
                <tr lang="ru">кубический корень для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math cbrt</keywords>
            <also>
                <see>math.cbrt</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Outputs the cube root of input signal</tr>
                <tr lang="ru" finished="false">Выходит кубический корень входного сигнала</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
                <tr lang="ru" finished="false">Особые ценности:</tr>
            </par>
            <par>
                <tr lang="en">cbrt(+-0) returns +-0.</tr>
                <tr lang="ru" finished="false">cbrt(+-0) возвращается +-0.</tr>
            </par>
            <par>
                <tr lang="en">cbrt(+-infinity) returns +-infinity.</tr>
                <tr lang="ru" finished="false">cbrt (+-бесконечность) возвращает
                +-бесконечность.</tr>
            </par>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">result signal</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[plot.linspace~ -8 8]
|                 ^|
[math.cbrt~]       |
|                  |.
[ui.plot~ @xlabels 1 @ylabels 1 @yauto 1 @size 400 200]














[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
