<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="flow.float">
        <title>flow.float</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">pass floats</tr>
                <tr lang="ru" finished="false">плавать</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>pass</keywords>
            <since>0.9.4</since>
            <aliases>
                <alias>flow.f</alias>
            </aliases>
        </meta>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">passes numerical values</tr>
                    <tr lang="ru">пропускает числовые значения</tr>
                </in>
                <in on="bang">
                    <tr lang="en">ignored</tr>
                    <tr lang="ru">игнорируется</tr>
                </in>
                <in on="symbol">
                    <tr lang="en">ignored</tr>
                    <tr lang="ru">игнорируется</tr>
                </in>
                <in on="list">
                    <tr lang="en">ignored</tr>
                    <tr lang="ru">игнорируется</tr>
                </in>
                <in on="any">
                    <tr lang="en">ignored</tr>
                    <tr lang="ru">игнорируется</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="float">
                    <tr lang="en">passed numerical values</tr>
                    <tr lang="ru">пропущенные числовые значения</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]   [symbol ABC(
|     |
| [B] | [1 2 3( [@a 1 2 3( [any msg(
| |   | |       |          |
[flow.f                    ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
