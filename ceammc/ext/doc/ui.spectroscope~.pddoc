<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.spectroscope~" type="gui">
        <title>ui.spectroscope~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">spectroscope widget</tr>
                <tr lang="ru">виджет просмотрщика спектра</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui spectroscope</keywords>
            <since>0.1</since>
            <aliases>
                <alias view="link">ui.ssc~</alias>
            </aliases>
            <also>
                <see view="link">ui.scope~</see>
            </also>
        </meta>
        <mouse>
            <event type="right-click" editmode="false">opens popup menu to change scale
            type</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <!-- @active_color -->
            <property name="@active_color" type="list" default="0 0.75 1 1">
                <tr lang="en">active color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <xi:include href="props_background_color.xml" />
            <!-- @border_color -->
            <property name="@border_color" type="list" default="0.6 0.6 0.6 1">
                <tr lang="en">border color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @fontname -->
            <property name="@fontname" type="symbol" default="Helvetica"
            enum="Courier DejaVu Helvetica Monaco Times">
                <tr lang="en">fontname</tr>
            </property>
            <!-- @fontsize -->
            <property name="@fontsize" type="int" minvalue="4" maxvalue="100" default="11">
                <tr lang="en">fontsize</tr>
            </property>
            <!-- @fontslant -->
            <property name="@fontslant" type="symbol" enum="roman italic" default="roman">
                <tr lang="en">font slant</tr>
            </property>
            <!-- @fontweight -->
            <property name="@fontweight" type="symbol" enum="normal bold" default="normal">
                <tr lang="en">font weight</tr>
            </property>
            <!-- @label_color -->
            <property name="@label_color" type="list" default="0 0 0 1">
                <tr lang="en">label color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @log_scale -->
            <property name="@log_scale" type="bool" default="0">
                <tr lang="en">display in log scale</tr>
            </property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="0">
                <tr lang="en">pin mode. if 1 - put element to the lowest level</tr>
            </property>
            <!-- @receive -->
            <property name="@receive" type="symbol" default="(null)">
                <tr lang="en">receive source</tr>
            </property>
            <!-- @refresh -->
            <property name="@refresh" type="int" minvalue="20" maxvalue="1000" default="100"
            units="millisecond">
                <tr lang="en">approximate refresh rate</tr>
            </property>
            <!-- @scale_color -->
            <property name="@scale_color" type="list" default="0.6 0.6 0.6 1">
                <tr lang="en">scale color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="150 100">
                <tr lang="en">element size (width, height pair)</tr>
            </property>
        </properties>
        <methods>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>signal input</xinfo>
            </inlet>
        </inlets>
        <example>
            <pdascii>
<![CDATA[
         [F]             [F]
         |               |
[noise~] [osc.saw~ 1000] [osc~ 5000]
|        |               |
| [T]    | [T]           | [T]  [T]
| |.     | |.            | |.   |
[*~]     [*~]            [*~]   [@log_scale $1(
|        |               |      |
|        |               |      |
[ui.spectroscope~   @size 500 150 @nosave 1]










[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
