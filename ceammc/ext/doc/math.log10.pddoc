<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="math.log10">
        <title>math.log10</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">base-10 logarithm</tr>
                <tr lang="ru">логарифм по основанию 10</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math log10</keywords>
            <also>
                <see>math.exp</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The log10() function computes the value of the logarithm of argument
                x to base 10.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
            </par>
            <par>
                <tr lang="en">log10(+-0) return -infinity</tr>
            </par>
            <par>
                <tr lang="en">log10(1) return +0.</tr>
            </par>
            <par>
                <tr lang="en">log10(x) return a NaN</tr>
            </par>
            <par>
                <tr lang="en">log10(+infinity) return +infinity.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input value</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">apply to all numeric values</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(                  [array LOG10 yr=-2..2 w=320]
|
[list.seq -1 100 0.5]
|
[math.log10]
|
[list->array LOG10]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
