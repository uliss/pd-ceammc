<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="list.none_of">
        <title>list.none_of</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks if none of list elements is accepted by the predicate
                side-chain</tr>
                <tr lang="ru">проверяет, что ни один из элементов не принимается предикатом боковой
                цепи обработки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list predicate none</keywords>
            <since>0.1</since>
            <also>
                <see>list.all_of</see>
                <see>list.any_of</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">Input list</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">Input mlist</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float" minvalue="0" maxvalue="1">
                    <tr lang="en">input value from predicate. "1" means accepted. "0" means
                    reject.</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>1 - if predicate object returns true for all the elements or list is empty or 0
            otherwise.</outlet>
            <outlet>atom to predicate</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2( [1 2 3( [1 2 3 4(
|     |       |
|     |       |
|     |       |
[list.none_of ] X [> 3]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
