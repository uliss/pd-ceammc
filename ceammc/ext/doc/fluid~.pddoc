<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="fluid~">
        <title>fluid~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">FluidSynth SoundFont 2 player</tr>
                <tr lang="ru">плеер для семплов FluidSynth SoundFont 2</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>misc</category>
            <keywords>mod player midi soundfont fluid</keywords>
            <since>0.6</since>
            <aliases>
                <alias>ceammc/fluid~</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">If no soundfont specified: default soundfont is loaded</tr>
                <tr lang="ru" finished="false">Если звуковой шрифт не указан: по умолчанию загружен
                звуковой шрифт</tr>
            </par>
            <par>
                <tr lang="en">It is WaveSine.sf2, simple sine synth</tr>
                <tr lang="ru" finished="false">WaveSine.sf2, простой синусовый синтезатор</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false" keys="Shift">all sounds off</event>
            <event type="left-click" editmode="false" keys="Alt">all notes off</event>
            <event type="left-click" editmode="false" keys="Shift+Alt">panic (reset synth)</event>
        </mouse>
        <arguments>
            <argument name="SF" type="symbol">
                <tr lang="en">soundfont path</tr>
                <tr lang="ru" finished="false">звуковой путь</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @avoices -->
            <property name="@avoices" type="float" default="0" access="readonly">
                <tr lang="en">number midi channels</tr>
                <tr lang="ru" finished="false">Мидийские каналы</tr>
            </property>
            <!-- @bufsize -->
            <property name="@bufsize" type="float" units="sample" default="0" access="readonly">
                <tr lang="en">internal buffer size</tr>
                <tr lang="ru" finished="false">Внутренний размер буфера</tr>
            </property>
            <!-- @cpuload -->
            <property name="@cpuload" type="float" default="0" access="readonly">
                <tr lang="en">current cpu load</tr>
                <tr lang="ru" finished="false">Текущая нагрузка Pu</tr>
            </property>
            <!-- @gain -->
            <property name="@gain" type="float" minvalue="0" maxvalue="10" default="0">
                <tr lang="en">output gain</tr>
                <tr lang="ru" finished="false">выходной прирост</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" default="16" access="readonly">
                <tr lang="en">number of active voices</tr>
                <tr lang="ru" finished="false">Количество активных голосов</tr>
            </property>
            <!-- @poly -->
            <property name="@poly" type="float" minvalue="1" maxvalue="1024" default="0">
                <tr lang="en">max number of voices</tr>
                <tr lang="ru" finished="false">Максимальное количество голосов</tr>
            </property>
            <!-- @presets -->
            <property name="@presets" type="list" default="" access="readonly">
                <tr lang="en">presets name for current soundfont</tr>
                <tr lang="ru" finished="false">Предустановленное имя для текущего звукового
                шрифта</tr>
            </property>
            <!-- @reverb_damp -->
            <property name="@reverb_damp" type="float" default="0">
                <tr lang="en">reverberation damp</tr>
                <tr lang="ru" finished="false">влажная реверберация</tr>
            </property>
            <!-- @reverb_level -->
            <property name="@reverb_level" type="float" default="0">
                <tr lang="en">reverberation level</tr>
                <tr lang="ru" finished="false">уровень реверберации</tr>
            </property>
            <!-- @reverb_room -->
            <property name="@reverb_room" type="float" default="0">
                <tr lang="en">reverberation room size</tr>
                <tr lang="ru" finished="false">размер реверберационной комнаты</tr>
            </property>
            <!-- @reverb_width -->
            <property name="@reverb_width" type="float" default="0">
                <tr lang="en">reverberation spread width</tr>
                <tr lang="ru" finished="false">Ширина распространения реверберации</tr>
            </property>
            <!-- @sf -->
            <property name="@sf" type="symbol" default="default">
                <tr lang="en">soundfont path, you can use **default** value to load default
                soundfont</tr>
                <tr lang="ru" finished="false">Путь звукового шрифта вы можете использовать
                значение **default** для загрузки звукового шрифта по умолчанию</tr>
            </property>
            <!-- @soundfonts -->
            <property name="@soundfonts" type="list" access="readonly" default="">
                <tr lang="en">list of found soundfonts</tr>
                <tr lang="ru" finished="false">Список найденных звуковых шрифтов</tr>
            </property>
            <!-- @version -->
            <property name="@version" type="symbol" access="readonly" default="2.3.2">
                <tr lang="en">FluidSynth version</tr>
                <tr lang="ru" finished="false">Версия FluidSynth</tr>
            </property>
            <!-- @volume -->
            <property name="@volume" type="float" minvalue="-60" maxvalue="20" default="0"
            units="decibel">
                <tr lang="en">output volume (same as @gain but in db)</tr>
                <tr lang="ru" finished="false">Объем выпуска (та же, что и @gain, но в дб)</tr>
            </property>
        </properties>
        <methods>
            <!-- aftertouch -->
            <method name="aftertouch">
                <info>
                    <tr lang="en">aftertouch channel pressure</tr>
                    <tr lang="ru" finished="false">давление после касания канала</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, ignored</tr>
                    <tr lang="ru" finished="false">Канал MIDI, проигнорированный</tr>
                </param>
                <param name="VEL" type="int" required="true" minvalue="0" maxvalue="127">
                    <tr lang="en">MIDI velocity</tr>
                    <tr lang="ru" finished="false">Скорость MIDI</tr>
                </param>
            </method>
            <!-- bank -->
            <method name="bank">
                <info>
                    <tr lang="en">select instrument bank number on a MIDI channel, but doesn't
                    change instrument, it should be done with after that with *prog* message.</tr>
                    <tr lang="ru" finished="false">Выберите номер банка инструментов на канале
                    MIDI, но не меняйте инструмент, это должно быть сделано с сообщением
                    *prog*.</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если ноль или опущенный набор для
                    всех каналов</tr>
                </param>
                <param name="BANK" type="int" required="true" minvalue="0" maxvalue="16383">
                    <tr lang="en">instrument bank number</tr>
                    <tr lang="ru" finished="false">Банковский номер инструмента</tr>
                </param>
            </method>
            <!-- bend -->
            <method name="bend">
                <info>
                    <tr lang="en">pitchband change</tr>
                    <tr lang="ru" finished="false">изменение</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если ноль или опущенный набор для
                    всех каналов</tr>
                </param>
                <param name="VALUE" type="int" required="true" minvalue="0" maxvalue="16383">
                    <tr lang="en">value in 0..0x3fff range, with 0x2000 center.</tr>
                    <tr lang="ru" finished="false">значение в диапазоне 0..0x3fff, с центром
                    0x2000.</tr>
                </param>
            </method>
            <!-- bend:f -->
            <method name="bend:f">
                <info>
                    <tr lang="en">pitchband change</tr>
                    <tr lang="ru" finished="false">изменение</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если ноль или опущенный набор для
                    всех каналов</tr>
                </param>
                <param name="VALUE" type="float" required="true" minvalue="-1" maxvalue="1">
                    <tr lang="en">value in -1..+1 range, with 0 center.</tr>
                    <tr lang="ru" finished="false">значение в диапазоне -1..+1, с центром 0.</tr>
                </param>
            </method>
            <!-- bend:i -->
            <method name="bend:i">
                <info>
                    <tr lang="en">pitchband change</tr>
                    <tr lang="ru" finished="false">изменение</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если ноль или опущенный набор для
                    всех каналов</tr>
                </param>
                <param name="VALUE" type="int" required="true" minvalue="-8192" maxvalue="8191">
                    <tr lang="en">value in -0x2000..0x1fff range, with 0 center.</tr>
                    <tr lang="ru" finished="false">значение в диапазоне -0x2000..0x1fff, с центром
                    0.</tr>
                </param>
            </method>
            <!-- bendsens -->
            <method name="bendsens">
                <info>
                    <tr lang="en">set pitchbend sensitivity</tr>
                    <tr lang="ru" finished="false">Установить чувствительность к питчэнду</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если ноль или опущенный набор для
                    всех каналов</tr>
                </param>
                <param name="RANGE" type="int" units="semitone" minvalue="0" maxvalue="64"
                required="true">
                    <tr lang="en">semitones sensitivity</tr>
                    <tr lang="ru" finished="false">чувствительность полутонов</tr>
                </param>
            </method>
            <!-- cc -->
            <method name="cc">
                <info>
                    <tr lang="en">control change</tr>
                    <tr lang="ru" finished="false">изменение контроля</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or omitted set on all channel</tr>
                    <tr lang="ru" finished="false">MIDI канал, если ноль или опущенный установлен
                    на всех каналах</tr>
                </param>
                <param name="CC" type="int" required="true" minvalue="0" maxvalue="127">
                    <tr lang="en">MIDI control number</tr>
                    <tr lang="ru" finished="false">Контрольный номер MIDI</tr>
                </param>
                <param name="VAL" type="int" required="true" minvalue="0" maxvalue="127">
                    <tr lang="en">MIDI control value</tr>
                    <tr lang="ru" finished="false">MIDI контрольная величина</tr>
                </param>
            </method>
            <!-- gen -->
            <method name="gen">
                <info>
                    <tr lang="en">set a SoundFont generator (effect) value on the MIDI channel in
                    real-time (CHANNEL, PARAM, VALUE or PARAM, VALUE expected)</tr>
                    <tr lang="ru" finished="false">установить значение генератора SoundFont
                    (эффекта) на канале MIDI в режиме реального времени (CHANNEL, PARAM, VALUE или
                    PARAM, VALUE ожидаемое)</tr>
                </info>
            </method>
            <!-- hold -->
            <method name="hold">
                <info>
                    <tr lang="en">hold (sustain, right) pedal, ignore note release when active,
                    release all notes when set to off.</tr>
                    <tr lang="ru" finished="false">удерживайте (поддерживайте, правильно) педаль,
                    игнорируйте выпуск заметок при активации, выпускайте все заметки при
                    запуске.</tr>
                </info>
                <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0"
                required="true">
                    <tr lang="en">MIDI channel, if zero or omitted sustain all channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если он нулевой или пропущенный,
                    поддерживает все каналы</tr>
                </param>
                <param name="VAL" type="int" enum="0 1" required="true">
                    <tr lang="en">pedal state</tr>
                    <tr lang="ru" finished="false">состояние педали</tr>
                </param>
            </method>
            <!-- legato -->
            <method name="legato">
                <info>
                    <tr lang="en">enable or disable legato/smooth transitions between consecutive
                    notes</tr>
                    <tr lang="ru" finished="false">включить или отключить легато/гладкий переход
                    между последовательными нотами;</tr>
                </info>
                <param name="CHAN" type="int" minvalue="0" maxvalue="15" required="true">
                    <tr lang="en">MIDI channel, if zero or omitted apply to all channels</tr>
                    <tr lang="ru" finished="false">MIDI-канал, если он нулевой или опущенный,
                    применяется ко всем каналам</tr>
                </param>
                <param name="VAL" type="int" enum="0 1" required="true">
                    <tr lang="en">pedal state</tr>
                    <tr lang="ru" finished="false">состояние педали</tr>
                </param>
            </method>
            <!-- midi -->
            <method name="midi">
                <info>
                    <tr lang="en">send raw midi message to synth</tr>
                    <tr lang="ru" finished="false">Отправить сообщение Midi для Synth</tr>
                </info>
                <param name="BYTES" type="list" required="true">
                    <tr lang="en">list of bytes</tr>
                    <tr lang="ru" finished="false">Список байтов</tr>
                </param>
            </method>
            <!-- note -->
            <method name="note">
                <info>
                    <tr lang="en">play note</tr>
                    <tr lang="ru" finished="false">играть в игру</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or omitted play on first(!) channel</tr>
                    <tr lang="ru" finished="false">MIDI канал, если ноль или пропущена игра на
                    первом (!) канале</tr>
                </param>
                <param name="NOTE" type="int" required="true" minvalue="0" maxvalue="127">
                    <tr lang="en">MIDI note</tr>
                    <tr lang="ru" finished="false">Записка MIDI</tr>
                </param>
                <param name="VEL" type="int" required="true" minvalue="0" maxvalue="127">
                    <tr lang="en">MIDI velocity</tr>
                    <tr lang="ru" finished="false">Скорость MIDI</tr>
                </param>
            </method>
            <!-- notes_off -->
            <method name="notes_off">
                <info>
                    <tr lang="en">turn off all notes on a MIDI channel (put them into release
                    phase)</tr>
                    <tr lang="ru" finished="false">выключите все записи на канале MIDI (поместите
                    их в фазу выпуска)</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or not specified turn notes on all
                    channels</tr>
                    <tr lang="ru" finished="false">MIDI-канал, если ноль или не указаны заметки
                    поворота на всех каналах</tr>
                </param>
            </method>
            <!-- pan -->
            <method name="pan">
                <info>
                    <tr lang="en">set channel panning</tr>
                    <tr lang="ru" finished="false">Настройка канала Panning</tr>
                </info>
                <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0"
                required="false">
                    <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если ноль или опущенный набор для
                    всех каналов</tr>
                </param>
                <param name="PAN" type="float" minvalue="0" maxvalue="16383" required="true">
                    <tr lang="en">pan value, 0: left, 8192(0x2000): center, 16383(0x3fff):
                    right</tr>
                    <tr lang="ru" finished="false">Пановое значение, 0: слева, 8192(0x2000): центр,
                    16383(0x3fff): справа</tr>
                </param>
            </method>
            <!-- pan:f -->
            <method name="pan:f">
                <info>
                    <tr lang="en">set channel panning</tr>
                    <tr lang="ru" finished="false">Настройка канала Panning</tr>
                </info>
                <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0"
                required="false">
                    <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если ноль или опущенный набор для
                    всех каналов</tr>
                </param>
                <param name="PAN" type="float" minvalue="-1" maxvalue="1" required="true">
                    <tr lang="en">pan value, -1: left, 0: center, 1): right</tr>
                    <tr lang="ru" finished="false">Пановое значение, -1: слева, 0: по центру, 1):
                    справа</tr>
                </param>
            </method>
            <!-- pan:i -->
            <method name="pan:i">
                <info>
                    <tr lang="en">set channel panning</tr>
                    <tr lang="ru" finished="false">Настройка канала Panning</tr>
                </info>
                <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0"
                required="false">
                    <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если ноль или опущенный набор для
                    всех каналов</tr>
                </param>
                <param name="PAN" type="float" minvalue="-8192" maxvalue="8191" required="true">
                    <tr lang="en">pan value, -8192(-0x2000): left, 0: center, 8191(0x1fff):
                    right</tr>
                    <tr lang="ru" finished="false">Пановое значение, -8192(-0x2000): слева, 0: в
                    центре, 8191(0x1fff): справа</tr>
                </param>
            </method>
            <!-- panic -->
            <method name="panic">
                <info>
                    <tr lang="en">send MIDI system reset command (big red 'panic' button), turns
                    off notes, resets controllers and restores initial basic channel
                    configuration</tr>
                    <tr lang="ru" finished="false">Отправьте команду сброса системы MIDI (большая
                    красная кнопка «panic»), отключите заметки, сбросите контроллеры и восстановите
                    начальную базовую конфигурацию канала</tr>
                </info>
            </method>
            <!-- polytouch -->
            <method name="polytouch">
                <info>
                    <tr lang="en">polytouch key pressure</tr>
                    <tr lang="ru" finished="false">давление ключа политач</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, ignored</tr>
                    <tr lang="ru" finished="false">Канал MIDI, проигнорированный</tr>
                </param>
                <param name="NOTE" type="int" required="true" minvalue="0" maxvalue="127">
                    <tr lang="en">MIDI note</tr>
                    <tr lang="ru" finished="false">Записка MIDI</tr>
                </param>
                <param name="VEL" type="int" required="true" minvalue="0" maxvalue="127">
                    <tr lang="en">MIDI velocity</tr>
                    <tr lang="ru" finished="false">Скорость MIDI</tr>
                </param>
            </method>
            <!-- prog -->
            <method name="prog">
                <info>
                    <tr lang="en">program change</tr>
                    <tr lang="ru" finished="false">Изменение программы</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если ноль или опущенный набор для
                    всех каналов</tr>
                </param>
                <param name="PGM" type="int" required="true" minvalue="0" maxvalue="16383">
                    <tr lang="en">program number</tr>
                    <tr lang="ru" finished="false">номер программы</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset synth channels</tr>
                    <tr lang="ru" finished="false">Сброс синтетических каналов</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or not specified reset all channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если ноль или не указан, сбрасывает
                    все каналы</tr>
                </param>
            </method>
            <!-- set_preset -->
            <method name="set_preset">
                <info>
                    <tr lang="en">set soundfont preset for midi channel</tr>
                    <tr lang="ru" finished="false">Настройка звукового шрифта для канала Midi</tr>
                </info>
                <param name="CHAN" type="int" minvalue="1" maxvalue="16" required="true">
                    <tr lang="en">MIDI channel</tr>
                    <tr lang="ru" finished="false">MIDI канал</tr>
                </param>
                <param name="PRESET" type="atom" required="true">
                    <tr lang="en">preset name or index</tr>
                    <tr lang="ru" finished="false">Предустановленное имя или индекс</tr>
                </param>
                <param name="SFONT" type="int" minvalue="1" required="false">
                    <tr lang="en">soundfont index. See @soundfonts property.</tr>
                    <tr lang="ru" finished="false">Индекс звукового шрифта. См. @soundfonts
                    property.</tr>
                </param>
            </method>
            <!-- soft -->
            <method name="soft">
                <info>
                    <tr lang="en">soft (left) pedal, activate the soft strike effect</tr>
                    <tr lang="ru" finished="false">мягкая (слева) педаль, активация эффекта мягкого
                    удара</tr>
                </info>
                <param name="CHAN" type="int" minvalue="0" maxvalue="15" required="true">
                    <tr lang="en">MIDI channel, if zero or omitted apply to all channels</tr>
                    <tr lang="ru" finished="false">MIDI-канал, если он нулевой или опущенный,
                    применяется ко всем каналам</tr>
                </param>
                <param name="VAL" type="int" enum="0 1" required="true">
                    <tr lang="en">pedal state</tr>
                    <tr lang="ru" finished="false">состояние педали</tr>
                </param>
            </method>
            <!-- sostenuto -->
            <method name="sostenuto">
                <info>
                    <tr lang="en">sostenuto (middle) pedal, hold notes pressed before pedal
                    activation, new notes are passed untouched. Release holded notes when set to
                    off</tr>
                    <tr lang="ru" finished="false">состенуто (средняя) педаль, удерживайте ноты,
                    нажатые перед активацией педали, новые ноты передаются нетронутыми. Отпуск
                    удерживаемых заметок при запуске</tr>
                </info>
                <param name="CHAN" type="int" minvalue="0" maxvalue="15" required="true">
                    <tr lang="en">MIDI channel, if zero or omitted apply to all channels</tr>
                    <tr lang="ru" finished="false">MIDI-канал, если он нулевой или опущенный,
                    применяется ко всем каналам</tr>
                </param>
                <param name="VAL" type="int" enum="0 1" required="true">
                    <tr lang="en">pedal state</tr>
                    <tr lang="ru" finished="false">состояние педали</tr>
                </param>
            </method>
            <!-- sound_off -->
            <method name="sound_off">
                <info>
                    <tr lang="en">immediately stop all notes (skips release phase).</tr>
                    <tr lang="ru" finished="false">Немедленно прекратите все записи (фаза выпуска
                    промахов).</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or not specified stop notes on all
                    channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если ноль или не указаны стоп-ноты
                    на всех каналах</tr>
                </param>
            </method>
            <!-- sysex -->
            <method name="sysex">
                <info>
                    <tr lang="en">accept SYSEX message</tr>
                    <tr lang="ru" finished="false">Принять сообщение SYSEX</tr>
                </info>
                <param name="BYTES" type="list" required="true">
                    <tr lang="en">list of bytes</tr>
                    <tr lang="ru" finished="false">Список байтов</tr>
                </param>
            </method>
            <!-- tune. -->
            <method name="tune.">
                <info>
                    <tr lang="en">set fine tuning in cents, see tune:s</tr>
                    <tr lang="ru" finished="false">установить тонкую настройку в центах, см.
                    тюнинг:</tr>
                </info>
            </method>
            <!-- tune:12 -->
            <method name="tune:12">
                <info>
                    <tr lang="en">set and activate octave tuning program in cents deviations</tr>
                    <tr lang="ru" finished="false">установить и активировать программу настройки
                    октавы в отклонениях центов</tr>
                </info>
                <param name="BANK" type="int" required="true" minvalue="1" maxvalue="256">
                    <tr lang="en">tuning bank (not related to MIDI instrument bank)</tr>
                    <tr lang="ru" finished="false">тюнинг-банк (не связанный с банком инструментов
                    MIDI)</tr>
                </param>
                <param name="PRESET" type="int" required="true" minvalue="1" maxvalue="256">
                    <tr lang="en">tuning preset (not related to MIDI instrument program)</tr>
                    <tr lang="ru" finished="false">предустановленная настройка (не связанная с
                    программой инструментов MIDI)</tr>
                </param>
                <param name="TUNES" type="list" required="true">
                    <tr lang="en">list of scale deviations from 12TET in cents</tr>
                    <tr lang="ru" finished="false">Список отклонений от 12TET в центах</tr>
                </param>
            </method>
            <!-- tune:c -->
            <method name="tune:c">
                <info>
                    <tr lang="en">set fine tuning in cents</tr>
                    <tr lang="ru" finished="false">установить тонкую настройку в центах</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or not specified apply tuning to all
                    channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если он нулевой или неопределенный,
                    настраивается на все каналы.</tr>
                </param>
                <param name="CENTS" type="float" required="true" minvalue="-100" maxvalue="100">
                    <tr lang="en">cents (float) tuning</tr>
                    <tr lang="ru" finished="false">Центы (плавающий) тюнинг</tr>
                </param>
            </method>
            <!-- tune:s -->
            <method name="tune:s">
                <info>
                    <tr lang="en">set tuning in semitones</tr>
                    <tr lang="ru" finished="false">Настройка в полутонах</tr>
                </info>
                <param name="CHAN" type="int" required="false" default="0" minvalue="0"
                maxvalue="16">
                    <tr lang="en">MIDI channel, if zero or not specified apply tuning to all
                    channels</tr>
                    <tr lang="ru" finished="false">Канал MIDI, если он нулевой или неопределенный,
                    настраивается на все каналы.</tr>
                </param>
                <param name="SEMI" type="float" required="true" minvalue="-64" maxvalue="63">
                    <tr lang="en">semitones (float) tuning</tr>
                    <tr lang="ru" finished="false">полутонная (плавающая) настройка</tr>
                </param>
            </method>
            <!-- tunesel -->
            <method name="tunesel">
                <info>
                    <tr lang="en">select tuning bank and preset</tr>
                    <tr lang="ru" finished="false">Выберите тюнинг-банк и Preset</tr>
                </info>
                <param name="BANK" type="int" required="true" minvalue="1" maxvalue="256">
                    <tr lang="en">tuning bank (not related to MIDI instrument bank)</tr>
                    <tr lang="ru" finished="false">тюнинг-банк (не связанный с банком инструментов
                    MIDI)</tr>
                </param>
                <param name="PRESET" type="int" required="true" minvalue="1" maxvalue="256">
                    <tr lang="en">tuning preset (not related to MIDI instrument program)</tr>
                    <tr lang="ru" finished="false">предустановленная настройка (не связанная с
                    программой инструментов MIDI)</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">load mod file</tr>
                    <tr lang="ru" finished="false">Скачать файл load mod</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">left channel and property output</tr>
                </out>
            </outlet>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">right channel</tr>
                </out>
            </outlet>
            <outlet type="control">
                <out type="any">
                    <tr lang="en">int: number of active voices (output only on change)</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
|         [ui.hrd @nitems 4]            /*program change on MIDI chan 1*/
|         |.
[flow.demux 4 #a]                       [hradio]
                                        |
                                        |
[msg #n1] [msg #n2] [msg #n3] [msg #n4] [prog 1 $1 #b(


 [dump #e([@sf sf2/VintageDreamsWaves-v2.sf2 #c(

          [@sf sf2/waves.sf2 #d(

[fluid~      #z]
*|*
[ui.hgain2~]   [ui.dsp~]
*|*
[dac~]

[fluid~-bend]   [fluid~-tune]     [fluid~-pan]  [fluid~-bank]

[fluid~-midi]   [fluid~-tune-12]  [fluid~-prog] [fluid~-notesoff]

[fluid~-pedals] [fluid~-soundoff] [fluid~-presets]

#n1 note 1
#n2 note 2
#n3 note 3
#n4 note 4
[X a:0->n1] [X a:1->n2] [X a:2->n3] [X a:3->n4] [X b->z]
[X n1->z]   [X n2->z]   [X n3->z]   [X n4->z]
[X c->z]    [X d->z]    [X e->z]
]]>
            </pdascii>
            <pdascii id="bend">
<![CDATA[
/*Shift+Click to hold note*/

[ui.keyboard 25 48]
|
|                   [loadmsg 1]
|                   |
|                   [ui.hsl  #a] X [spring 0]  [ui.k #b] [ui.k #c]
|                   |                          |         |
|                   [flow.f]    [ui.hrd]       |         |
|                   |           |              |         |
[msg note 1]        [bend:f $1( [bendsens $1(  [bend $1( [bend:i $1(
|                   |           |              |         |
|                   |           |              |         |
[fluid~                                                  ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]

#a -1 1 @show_value 1 @mouse_events 1
#b 0 16383 @show_value 1
#c -8192 8191 @show_value 1
]]>
            </pdascii>
            <pdascii id="midi">
<![CDATA[
/*play MIDI keyboard with default Sine tone sample*/

[midiin]
|
[msg midi]
|
[fluid~]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="tune">
<![CDATA[
/*play MIDI keyboard with default Sine tone sample*/

[midiin]   [F]          [F]
|          |            |
[msg midi] [tune:s $1(  [tune:c $1(
|          |            |
[fluid~                 ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="tune-12">
<![CDATA[
/*play MIDI keyboard with default Sine tone sample*/

            /*save and activate tuning at bank:1, preset:1*/

[midiin]    [1 1 0 0 -50 0 0 0 0 0 0 0 0 -50(
|           |
|           |             /*restore 12TFT*/
|           |
[msg midi]  [msg tune:12] [tunesel 0 0( [tunesel 1 1(
|           |             |             |
[fluid~                                 ] /*activate bank:1, preset:1*/
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="pan">
<![CDATA[
[midiin]   [ui.k #a] [ui.k #b]  [ui.k #c]
|          |         |          |
|          |         |          |
|          |         |          |
[msg midi] [pan $1(  [pan:i $1( [pan:f $1(
|          |         |          |
[fluid~                         ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]

#a 0 16383 @show_value 1
#b -8192 8191 @show_value 1
#c -1 1 @show_value 1
]]>
            </pdascii>
            <pdascii id="prog">
<![CDATA[
[ui.keyboard 25 60]
|
|
|
|
|          [ui.hrd 5] /*different attack and vibrato*/
|          |
[msg note] [prog 1 $1(
|          |
[fluid~    ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="bank">
<![CDATA[
[ui.keyboard 25 60]
|
|
|
|
|
|   [ui.hrd 4]
|   |
|   [+ 1]
|   |.
[msg 1]    [loadbang]
|          |
[msg note] [bank 1 0, prog 1 1, bank 2 1, prog 2 4, bank 3 2, prog 3 1, bank 4 3, prog 4 1(
|          |
|          |
|          |
[fluid~ sf2/waves.sf2]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="reset">
<![CDATA[
[note 1 60 120, note 1 65 120, note 2 47 120(
|
| [reset( [reset 1( [reset 2(
| |       |         |
[fluid~             ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="notesoff">
<![CDATA[
[note 1 60 120, note 1 65 120, note 2 47 120(
|
| /*all*/     /*1st chan*/  /*2nd chan*/   [loadbang]
|                                          |
| [notes_off( [notes_off 1( [notes_off 2(  [bank 0 0, prog 0 1( /*slow attack/release*/
| |           |             |              |
[fluid~ sf2/waves.sf2                      ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="soundoff">
<![CDATA[
[note 1 60 120, note 1 65 120, note 2 47 120(
|
| /*all*/    /*1st chan*/  /*2nd chan*/   [loadbang]
|                                         |
| [sound_off( [sound_off 1( [sound_off 2( [bank 0 0, prog 0 1( /*slow attack/release*/
| |           |             |             |
[fluid~ sf2/waves.sf2                     ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="pedals">
<![CDATA[
[notein]
*|*
[pack f f]
|
[ui.keyboard]
|
|
|
|
|           [ui.btn]  [ui.btn]  [ui.btn]    [ui.btn]
|           |         |         |           |
[msg note]  [hold $1( [soft $1( [legato $1( [sostenuto $1(
|           |         |         |           |
|           |         |         |           |
[fluid~ sf2/waves.sf2 #z                    ]
*|*
[ui.hgain2~]    [ui.dsp~]   [bank 1 0, prog 1 2 #a(
*|*
[dac~]
[X a->z]
]]>
            </pdascii>
            <pdascii id="presets">
<![CDATA[
[ui.keyboard 25 48]                [ui.dsp~]
|
|
|
|
|
|   [ui.hrd 4]
|   |
|   [+ 1]
|   |.
[msg 1]       [loadbang]
|             |
[msg note #c] [del 100]
              |
              [set_preset 1 tri, set_preset 2 square_mod, set_preset 3 saw, set_preset 4 sine_mod #a(



              [B]
              |
              [prop.get @presets #b]
              ^|
              [msg @items]
              |
              [ui.menu @nosave 1]
              |
              [set_preset 1 $2 #d(



[fluid~ sf2/waves.sf2 #z]
*|*
[ui.hgain2~]
*|*
[dac~]

[X a->z] [X b->z] [X c->z] [X d->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
