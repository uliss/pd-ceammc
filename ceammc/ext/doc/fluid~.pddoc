<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="fluid~">
        <title>fluid~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">FluidSynth SoundFont 2 player</tr>
                <tr lang="ru">плеер для семплов FluidSynth SoundFont 2</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>misc</category>
            <keywords>mod player midi soundfont fluid</keywords>
            <since>0.6</since>
            <aliases>
                <alias>ceammc/fluid~</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">If no soundfont specified: default soundfont is loaded</tr>
            </par>
            <par>
                <tr lang="en">It is WaveSine.sf2, simple sine synth</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false" keys="Shift">all sounds off</event>
            <event type="left-click" editmode="false" keys="Alt">all notes off</event>
            <event type="left-click" editmode="false" keys="Shift+Alt">panic (reset synth)</event>
        </mouse>
        <arguments>
            <argument name="SF" type="symbol">
                <tr lang="en">soundfont path</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @avoices -->
            <property name="@avoices" type="float" default="0" access="readonly">
                <tr lang="en">number midi channels</tr>
            </property>
            <!-- @bufsize -->
            <property name="@bufsize" type="float" units="sample" default="0" access="readonly">
                <tr lang="en">internal buffer size</tr>
            </property>
            <!-- @cpuload -->
            <property name="@cpuload" type="float" default="0" access="readonly">
                <tr lang="en">current cpu load</tr>
            </property>
            <!-- @gain -->
            <property name="@gain" type="float" minvalue="0" maxvalue="10" default="0">
                <tr lang="en">output gain</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" default="16" access="readonly">
                <tr lang="en">number of active voices</tr>
            </property>
            <!-- @poly -->
            <property name="@poly" type="float" minvalue="1" maxvalue="1024" default="0">
                <tr lang="en">max number of voices</tr>
            </property>
            <!-- @presets -->
            <property name="@presets" type="list" default="" access="readonly">
                <tr lang="en">presets name for current soundfont</tr>
            </property>
            <!-- @reverb_damp -->
            <property name="@reverb_damp" type="float" default="0">
                <tr lang="en">reverberation damp</tr>
            </property>
            <!-- @reverb_level -->
            <property name="@reverb_level" type="float" default="0">
                <tr lang="en">reverberation level</tr>
            </property>
            <!-- @reverb_room -->
            <property name="@reverb_room" type="float" default="0">
                <tr lang="en">reverberation room size</tr>
            </property>
            <!-- @reverb_width -->
            <property name="@reverb_width" type="float" default="0">
                <tr lang="en">reverberation spread width</tr>
            </property>
            <!-- @sf -->
            <property name="@sf" type="symbol" default="default">
                <tr lang="en">soundfont path, you can use **default** value to load default
                soundfont</tr>
            </property>
            <!-- @soundfonts -->
            <property name="@soundfonts" type="list" access="readonly" default="">
                <tr lang="en">list of found soundfonts</tr>
            </property>
            <!-- @version -->
            <property name="@version" type="symbol" access="readonly" default="2.3.2">
                <tr lang="en">FluidSynth version</tr>
            </property>
            <!-- @volume -->
            <property name="@volume" type="float" minvalue="-60" maxvalue="20" default="0"
            units="decibel">
                <tr lang="en">output volume (same as @gain but in db)</tr>
            </property>
        </properties>
        <methods>
            <!-- aftertouch -->
            <method name="aftertouch">aftertouch channel pressure 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, ignored</tr>
            </param>
            <param name="VEL" type="int" required="true" minvalue="0" maxvalue="127">
                <tr lang="en">MIDI velocity</tr>
            </param></method>
            <!-- bank -->
            <method name="bank">select instrument bank number on a MIDI channel, but doesn't change
            instrument, it should be done with after that with *prog* message. 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
            </param>
            <param name="BANK" type="int" required="true" minvalue="0" maxvalue="16383">
                <tr lang="en">instrument bank number</tr>
            </param></method>
            <!-- bend -->
            <method name="bend">pitchband change 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
            </param>
            <param name="VALUE" type="int" required="true" minvalue="0" maxvalue="16383">
                <tr lang="en">value in 0..0x3fff range, with 0x2000 center.</tr>
            </param></method>
            <!-- bend:f -->
            <method name="bend:f">pitchband change 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
            </param>
            <param name="VALUE" type="float" required="true" minvalue="-1" maxvalue="1">
                <tr lang="en">value in -1..+1 range, with 0 center.</tr>
            </param></method>
            <!-- bend:i -->
            <method name="bend:i">pitchband change 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
            </param>
            <param name="VALUE" type="int" required="true" minvalue="-8192" maxvalue="8191">
                <tr lang="en">value in -0x2000..0x1fff range, with 0 center.</tr>
            </param></method>
            <!-- bendsens -->
            <method name="bendsens">set pitchbend sensitivity 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
            </param>
            <param name="RANGE" type="int" units="semitone" minvalue="0" maxvalue="64"
            required="true">
                <tr lang="en">semitones sensitivity</tr>
            </param></method>
            <!-- cc -->
            <method name="cc">control change 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or omitted set on all channel</tr>
            </param>
            <param name="CC" type="int" required="true" minvalue="0" maxvalue="127">
                <tr lang="en">MIDI control number</tr>
            </param>
            <param name="VAL" type="int" required="true" minvalue="0" maxvalue="127">
                <tr lang="en">MIDI control value</tr>
            </param></method>
            <!-- gen -->
            <method name="gen">set a SoundFont generator (effect) value on the MIDI channel in
            real-time (CHANNEL, PARAM, VALUE or PARAM, VALUE expected)</method>
            <!-- hold -->
            <method name="hold">hold (sustain, right) pedal, ignore note release when active,
            release all notes when set to off. 
            <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0" required="true">
                <tr lang="en">MIDI channel, if zero or omitted sustain all channels</tr>
            </param>
            <param name="VAL" type="int" enum="0 1" required="true">
                <tr lang="en">pedal state</tr>
            </param></method>
            <!-- legato -->
            <method name="legato">enable or disable legato/smooth transitions between consecutive
            notes 
            <param name="CHAN" type="int" minvalue="0" maxvalue="15" required="true">
                <tr lang="en">MIDI channel, if zero or omitted apply to all channels</tr>
            </param>
            <param name="VAL" type="int" enum="0 1" required="true">
                <tr lang="en">pedal state</tr>
            </param></method>
            <!-- midi -->
            <method name="midi">send raw midi message to synth 
            <param name="BYTES" type="list" required="true">
                <tr lang="en">list of bytes</tr>
            </param></method>
            <!-- note -->
            <method name="note">play note 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or omitted play on first(!) channel</tr>
            </param>
            <param name="NOTE" type="int" required="true" minvalue="0" maxvalue="127">
                <tr lang="en">MIDI note</tr>
            </param>
            <param name="VEL" type="int" required="true" minvalue="0" maxvalue="127">
                <tr lang="en">MIDI velocity</tr>
            </param></method>
            <!-- notes_off -->
            <method name="notes_off">turn off all notes on a MIDI channel (put them into release
            phase) 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or not specified turn notes on all
                channels</tr>
            </param></method>
            <!-- pan -->
            <method name="pan">set channel panning 
            <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0" required="false">
                <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
            </param>
            <param name="PAN" type="float" minvalue="0" maxvalue="16383" required="true">
                <tr lang="en">pan value, 0: left, 8192(0x2000): center, 16383(0x3fff): right</tr>
            </param></method>
            <!-- pan:f -->
            <method name="pan:f">set channel panning 
            <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0" required="false">
                <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
            </param>
            <param name="PAN" type="float" minvalue="-1" maxvalue="1" required="true">
                <tr lang="en">pan value, -1: left, 0: center, 1): right</tr>
            </param></method>
            <!-- pan:i -->
            <method name="pan:i">set channel panning 
            <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0" required="false">
                <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
            </param>
            <param name="PAN" type="float" minvalue="-8192" maxvalue="8191" required="true">
                <tr lang="en">pan value, -8192(-0x2000): left, 0: center, 8191(0x1fff): right</tr>
            </param></method>
            <!-- panic -->
            <method name="panic">send MIDI system reset command (big red 'panic' button), turns off
            notes, resets controllers and restores initial basic channel configuration</method>
            <!-- polytouch -->
            <method name="polytouch">polytouch key pressure 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, ignored</tr>
            </param>
            <param name="NOTE" type="int" required="true" minvalue="0" maxvalue="127">
                <tr lang="en">MIDI note</tr>
            </param>
            <param name="VEL" type="int" required="true" minvalue="0" maxvalue="127">
                <tr lang="en">MIDI velocity</tr>
            </param></method>
            <!-- prog -->
            <method name="prog">program change 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or omitted set for all channels</tr>
            </param>
            <param name="PGM" type="int" required="true" minvalue="0" maxvalue="16383">
                <tr lang="en">program number</tr>
            </param></method>
            <!-- reset -->
            <method name="reset">reset synth channels 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or not specified reset all channels</tr>
            </param></method>
            <!-- set_preset -->
            <method name="set_preset">set soundfont preset for midi channel 
            <param name="CHAN" type="int" minvalue="1" maxvalue="16" required="true">
                <tr lang="en">MIDI channel</tr>
            </param>
            <param name="PRESET" type="atom" required="true">
                <tr lang="en">preset name or index</tr>
            </param>
            <param name="SFONT" type="int" minvalue="1" required="false">
                <tr lang="en">soundfont index. See @soundfonts property.</tr>
            </param></method>
            <!-- soft -->
            <method name="soft">soft (left) pedal, activate the soft strike effect 
            <param name="CHAN" type="int" minvalue="0" maxvalue="15" required="true">
                <tr lang="en">MIDI channel, if zero or omitted apply to all channels</tr>
            </param>
            <param name="VAL" type="int" enum="0 1" required="true">
                <tr lang="en">pedal state</tr>
            </param></method>
            <!-- sostenuto -->
            <method name="sostenuto">sostenuto (middle) pedal, hold notes pressed before pedal
            activation, new notes are passed untouched. Release holded notes when set to off 
            <param name="CHAN" type="int" minvalue="0" maxvalue="15" required="true">
                <tr lang="en">MIDI channel, if zero or omitted apply to all channels</tr>
            </param>
            <param name="VAL" type="int" enum="0 1" required="true">
                <tr lang="en">pedal state</tr>
            </param></method>
            <!-- sound_off -->
            <method name="sound_off">immediately stop all notes (skips release phase). 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or not specified stop notes on all
                channels</tr>
            </param></method>
            <!-- sysex -->
            <method name="sysex">accept SYSEX message 
            <param name="BYTES" type="list" required="true">
                <tr lang="en">list of bytes</tr>
            </param></method>
            <!-- tune. -->
            <method name="tune.">set fine tuning in cents, see tune:s</method>
            <!-- tune:12 -->
            <method name="tune:12">set and activate octave tuning program in cents deviations 
            <param name="BANK" type="int" required="true" minvalue="1" maxvalue="256">
                <tr lang="en">tuning bank (not related to MIDI instrument bank)</tr>
            </param>
            <param name="PRESET" type="int" required="true" minvalue="1" maxvalue="256">
                <tr lang="en">tuning preset (not related to MIDI instrument program)</tr>
            </param>
            <param name="TUNES" type="list" required="true">
                <tr lang="en">list of scale deviations from 12TET in cents</tr>
            </param></method>
            <!-- tune:c -->
            <method name="tune:c">set fine tuning in cents 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or not specified apply tuning to all
                channels</tr>
            </param>
            <param name="CENTS" type="float" required="true" minvalue="-100" maxvalue="100">
                <tr lang="en">cents (float) tuning</tr>
            </param></method>
            <!-- tune:s -->
            <method name="tune:s">set tuning in semitones 
            <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
                <tr lang="en">MIDI channel, if zero or not specified apply tuning to all
                channels</tr>
            </param>
            <param name="SEMI" type="float" required="true" minvalue="-64" maxvalue="63">
                <tr lang="en">semitones (float) tuning</tr>
            </param></method>
            <!-- tunesel -->
            <method name="tunesel">select tuning bank and preset 
            <param name="BANK" type="int" required="true" minvalue="1" maxvalue="256">
                <tr lang="en">tuning bank (not related to MIDI instrument bank)</tr>
            </param>
            <param name="PRESET" type="int" required="true" minvalue="1" maxvalue="256">
                <tr lang="en">tuning preset (not related to MIDI instrument program)</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="symbol">load mod file</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">left channel and property output</outlet>
            <outlet type="audio">right channel</outlet>
            <outlet type="control">int: number of active voices (output only on change)</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
|         [ui.hrd @nitems 4]            /*program change on MIDI chan 1*/
|         |.
[flow.demux 4 #a]                       [hradio]
                                        |
                                        |
[msg #n1] [msg #n2] [msg #n3] [msg #n4] [prog 1 $1 #b(


 [dump #e([@sf sf2/VintageDreamsWaves-v2.sf2 #c(

          [@sf sf2/waves.sf2 #d(

[fluid~      #z]
*|*
[ui.hgain2~]   [ui.dsp~]
*|*
[dac~]

[fluid~-bend]   [fluid~-tune]     [fluid~-pan]  [fluid~-bank]

[fluid~-midi]   [fluid~-tune-12]  [fluid~-prog] [fluid~-notesoff]

[fluid~-pedals] [fluid~-soundoff] [fluid~-presets]

#n1 note 1
#n2 note 2
#n3 note 3
#n4 note 4
[X a:0->n1] [X a:1->n2] [X a:2->n3] [X a:3->n4] [X b->z]
[X n1->z]   [X n2->z]   [X n3->z]   [X n4->z]
[X c->z]    [X d->z]    [X e->z]
]]>
            </pdascii>
            <pdascii id="bend">
<![CDATA[
/*Shift+Click to hold note*/

[ui.keyboard 25 48]
|
|                   [loadmsg 1]
|                   |
|                   [ui.hsl  #a] X [spring 0]  [ui.k #b] [ui.k #c]
|                   |                          |         |
|                   [flow.f]    [ui.hrd]       |         |
|                   |           |              |         |
[msg note 1]        [bend:f $1( [bendsens $1(  [bend $1( [bend:i $1(
|                   |           |              |         |
|                   |           |              |         |
[fluid~                                                  ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]

#a -1 1 @show_value 1 @mouse_events 1
#b 0 16383 @show_value 1
#c -8192 8191 @show_value 1
]]>
            </pdascii>
            <pdascii id="midi">
<![CDATA[
/*play MIDI keyboard with default Sine tone sample*/

[midiin]
|
[msg midi]
|
[fluid~]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="tune">
<![CDATA[
/*play MIDI keyboard with default Sine tone sample*/

[midiin]   [F]          [F]
|          |            |
[msg midi] [tune:s $1(  [tune:c $1(
|          |            |
[fluid~                 ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="tune-12">
<![CDATA[
/*play MIDI keyboard with default Sine tone sample*/

            /*save and activate tuning at bank:1, preset:1*/

[midiin]    [1 1 0 0 -50 0 0 0 0 0 0 0 0 -50(
|           |
|           |             /*restore 12TFT*/
|           |
[msg midi]  [msg tune:12] [tunesel 0 0( [tunesel 1 1(
|           |             |             |
[fluid~                                 ] /*activate bank:1, preset:1*/
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="pan">
<![CDATA[
[midiin]   [ui.k #a] [ui.k #b]  [ui.k #c]
|          |         |          |
|          |         |          |
|          |         |          |
[msg midi] [pan $1(  [pan:i $1( [pan:f $1(
|          |         |          |
[fluid~                         ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]

#a 0 16383 @show_value 1
#b -8192 8191 @show_value 1
#c -1 1 @show_value 1
]]>
            </pdascii>
            <pdascii id="prog">
<![CDATA[
[ui.keyboard 25 60]
|
|
|
|
|          [ui.hrd 5] /*different attack and vibrato*/
|          |
[msg note] [prog 1 $1(
|          |
[fluid~    ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="bank">
<![CDATA[
[ui.keyboard 25 60]
|
|
|
|
|
|   [ui.hrd 4]
|   |
|   [+ 1]
|   |.
[msg 1]    [loadbang]
|          |
[msg note] [bank 1 0, prog 1 1, bank 2 1, prog 2 4, bank 3 2, prog 3 1, bank 4 3, prog 4 1(
|          |
|          |
|          |
[fluid~ sf2/waves.sf2]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="reset">
<![CDATA[
[note 1 60 120, note 1 65 120, note 2 47 120(
|
| [reset( [reset 1( [reset 2(
| |       |         |
[fluid~             ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="notesoff">
<![CDATA[
[note 1 60 120, note 1 65 120, note 2 47 120(
|
| /*all*/     /*1st chan*/  /*2nd chan*/   [loadbang]
|                                          |
| [notes_off( [notes_off 1( [notes_off 2(  [bank 0 0, prog 0 1( /*slow attack/release*/
| |           |             |              |
[fluid~ sf2/waves.sf2                      ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="soundoff">
<![CDATA[
[note 1 60 120, note 1 65 120, note 2 47 120(
|
| /*all*/    /*1st chan*/  /*2nd chan*/   [loadbang]
|                                         |
| [sound_off( [sound_off 1( [sound_off 2( [bank 0 0, prog 0 1( /*slow attack/release*/
| |           |             |             |
[fluid~ sf2/waves.sf2                     ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="pedals">
<![CDATA[
[notein]
*|*
[pack f f]
|
[ui.keyboard]
|
|
|
|
|           [ui.btn]  [ui.btn]  [ui.btn]    [ui.btn]
|           |         |         |           |
[msg note]  [hold $1( [soft $1( [legato $1( [sostenuto $1(
|           |         |         |           |
|           |         |         |           |
[fluid~ sf2/waves.sf2 #z                    ]
*|*
[ui.hgain2~]    [ui.dsp~]   [bank 1 0, prog 1 2 #a(
*|*
[dac~]
[X a->z]
]]>
            </pdascii>
            <pdascii id="presets">
<![CDATA[
[ui.keyboard 25 48]                [ui.dsp~]
|
|
|
|
|
|   [ui.hrd 4]
|   |
|   [+ 1]
|   |.
[msg 1]       [loadbang]
|             |
[msg note #c] [del 100]
              |
              [set_preset 1 tri, set_preset 2 square_mod, set_preset 3 saw, set_preset 4 sine_mod #a(



              [B]
              |
              [prop.get @presets #b]
              ^|
              [msg @items]
              |
              [ui.menu @nosave 1]
              |
              [set_preset 1 $2 #d(



[fluid~ sf2/waves.sf2 #z]
*|*
[ui.hgain2~]
*|*
[dac~]

[X a->z] [X b->z] [X c->z] [X d->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
