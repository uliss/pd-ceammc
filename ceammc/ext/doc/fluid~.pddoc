<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fluid~">
    <title>fluid~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">FluidSynth SoundFont 2 player</tr>
        <tr lang="ru">проигрыватель SoundFont 2 (FluidSynth)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>misc</category>
      <keywords>mod player midi soundfont fluid</keywords>
      <since>0.6</since>
      <aliases>
        <alias>ceammc/fluid~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">If no soundfont is specified, the default soundfont is loaded.</tr>
        <tr lang="ru">Если звуковой шрифт не указан, загружается звуковой шрифт по умолчанию.</tr>
      </par>
      <par>
        <tr lang="en">The default soundfont is WaveSine.sf2, a simple sine synthesizer.</tr>
        <tr lang="ru">Звуковой шрифт по умолчанию — WaveSine.sf2, простой синусоидальный
        синтезатор.</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false" keys="Shift">all sounds off</event>
      <event type="left-click" editmode="false" keys="Alt">all notes off</event>
      <event type="left-click" editmode="false" keys="Shift+Alt">panic (reset synth)</event>
    </mouse>
    <arguments>
      <argument name="SF" type="symbol">
        <tr lang="en">soundfont path</tr>
        <tr lang="ru">путь к звуковому шрифту</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @avoices -->
      <property name="@avoices" type="float" default="0" access="readonly">
        <tr lang="en">number of active voices</tr>
        <tr lang="ru">количество активных голосов</tr>
      </property>
      <!-- @bufsize -->
      <property name="@bufsize" type="float" units="sample" default="0" access="readonly">
        <tr lang="en">internal buffer size (in samples)</tr>
        <tr lang="ru">внутренний размер буфера (в сэмплах)</tr>
      </property>
      <!-- @cpuload -->
      <property name="@cpuload" type="float" default="0" access="readonly">
        <tr lang="en">current CPU load</tr>
        <tr lang="ru">текущая загрузка ЦП</tr>
      </property>
      <!-- @gain -->
      <property name="@gain" type="float" minvalue="0" maxvalue="10" default="0">
        <tr lang="en">output gain (amplitude)</tr>
        <tr lang="ru">выходной коэффициент усиления (амплитуда)</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" default="16" access="readonly">
        <tr lang="en">number of active voices</tr>
        <tr lang="ru">количество активных голосов</tr>
      </property>
      <!-- @poly -->
      <property name="@poly" type="float" minvalue="1" maxvalue="1024" default="0">
        <tr lang="en">maximum number of voices (polyphony)</tr>
        <tr lang="ru">максимальное количество голосов (полифония)</tr>
      </property>
      <!-- @presets -->
      <property name="@presets" type="list" default="" access="readonly">
        <tr lang="en">preset names for the current soundfont</tr>
        <tr lang="ru">названия пресетов для текущего звукового шрифта</tr>
      </property>
      <!-- @reverb_damp -->
      <property name="@reverb_damp" type="float" default="0">
        <tr lang="en">reverb damping factor</tr>
        <tr lang="ru">коэффициент демпфирования реверберации</tr>
      </property>
      <!-- @reverb_level -->
      <property name="@reverb_level" type="float" default="0">
        <tr lang="en">reverb level</tr>
        <tr lang="ru">уровень реверберации</tr>
      </property>
      <!-- @reverb_room -->
      <property name="@reverb_room" type="float" default="0">
        <tr lang="en">reverb room size</tr>
        <tr lang="ru">размер помещения реверберации</tr>
      </property>
      <!-- @reverb_width -->
      <property name="@reverb_width" type="float" default="0">
        <tr lang="en">reverb spread width</tr>
        <tr lang="ru">ширина распространения реверберации</tr>
      </property>
      <!-- @sf -->
      <property name="@sf" type="symbol" default="default">
        <tr lang="en">soundfont path. Use **default** to load the default soundfont.</tr>
        <tr lang="ru">путь к звуковому шрифту. Используйте **default** для загрузки шрифта по
        умолчанию.</tr>
      </property>
      <!-- @soundfonts -->
      <property name="@soundfonts" type="list" access="readonly" default="">
        <tr lang="en">list of available soundfonts</tr>
        <tr lang="ru">список доступных звуковых шрифтов</tr>
      </property>
      <!-- @version -->
      <property name="@version" type="symbol" access="readonly" default="2.3.2">
        <tr lang="en">FluidSynth version</tr>
        <tr lang="ru">версия FluidSynth</tr>
      </property>
      <!-- @volume -->
      <property name="@volume" type="float" minvalue="-60" maxvalue="20" default="0"
      units="decibel">
        <tr lang="en">output volume (same as @gain but in dB)</tr>
        <tr lang="ru">выходная громкость (то же, что и @gain, но в дБ)</tr>
      </property>
    </properties>
    <methods>
      <!-- aftertouch -->
      <method name="aftertouch">
        <info>
          <tr lang="en">aftertouch channel pressure</tr>
          <tr lang="ru">давление после касания (aftertouch) на канале</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel (ignored)</tr>
          <tr lang="ru">MIDI-канал (игнорируется)</tr>
        </param>
        <param name="VEL" type="int" required="true" minvalue="0" maxvalue="127">
          <tr lang="en">pressure value</tr>
          <tr lang="ru">значение давления</tr>
        </param>
      </method>
      <!-- bank -->
      <method name="bank">
        <info>
          <tr lang="en">select the instrument bank number on a MIDI channel. Does not change the
          instrument: use the *prog* message to do that.</tr>
          <tr lang="ru">выбирает номер банка инструментов на MIDI-канале. Не меняет инструмент —
          для этого используйте сообщение *prog*.</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="BANK" type="int" required="true" minvalue="0" maxvalue="16383">
          <tr lang="en">instrument bank number</tr>
          <tr lang="ru">номер банка инструментов</tr>
        </param>
      </method>
      <!-- bend -->
      <method name="bend">
        <info>
          <tr lang="en">pitch bend change</tr>
          <tr lang="ru">изменение высоты тона (pitch bend)</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="VALUE" type="int" required="true" minvalue="0" maxvalue="16383">
          <tr lang="en">value in the 0..0x3fff range, with 0x2000 as center</tr>
          <tr lang="ru">значение в диапазоне 0..0x3fff, центр — 0x2000</tr>
        </param>
      </method>
      <!-- bend:f -->
      <method name="bend:f">
        <info>
          <tr lang="en">pitch bend change (float)</tr>
          <tr lang="ru">изменение высоты тона (число с плавающей точкой)</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="VALUE" type="float" required="true" minvalue="-1" maxvalue="1">
          <tr lang="en">value in the -1..+1 range, with 0 as center</tr>
          <tr lang="ru">значение в диапазоне -1..+1, центр — 0</tr>
        </param>
      </method>
      <!-- bend:i -->
      <method name="bend:i">
        <info>
          <tr lang="en">pitch bend change (integer)</tr>
          <tr lang="ru">изменение высоты тона (целое число)</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="VALUE" type="int" required="true" minvalue="-8192" maxvalue="8191">
          <tr lang="en">value in the -0x2000..0x1fff range, with 0 as center</tr>
          <tr lang="ru">значение в диапазоне -0x2000..0x1fff, центр — 0</tr>
        </param>
      </method>
      <!-- bendsens -->
      <method name="bendsens">
        <info>
          <tr lang="en">set pitch bend sensitivity</tr>
          <tr lang="ru">установить чувствительность pitch bend</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="RANGE" type="int" units="semitone" minvalue="0" maxvalue="64" required="true">
          <tr lang="en">sensitivity in semitones</tr>
          <tr lang="ru">чувствительность в полутонах</tr>
        </param>
      </method>
      <!-- cc -->
      <method name="cc">
        <info>
          <tr lang="en">control change</tr>
          <tr lang="ru">изменение контроллера</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="CC" type="int" required="true" minvalue="0" maxvalue="127">
          <tr lang="en">MIDI controller number</tr>
          <tr lang="ru">номер MIDI-контроллера</tr>
        </param>
        <param name="VAL" type="int" required="true" minvalue="0" maxvalue="127">
          <tr lang="en">MIDI controller value</tr>
          <tr lang="ru">значение MIDI-контроллера</tr>
        </param>
      </method>
      <!-- gen -->
      <method name="gen">
        <info>
          <tr lang="en">set a SoundFont generator (effect) value on a MIDI channel in real time.
          Expected format: CHANNEL PARAM VALUE or PARAM VALUE.</tr>
          <tr lang="ru">устанавливает значение генератора SoundFont (эффекта) на MIDI-канале в
          реальном времени. Ожидаемый формат: CHANNEL PARAM VALUE или PARAM VALUE.</tr>
        </info>
      </method>
      <!-- hold -->
      <method name="hold">
        <info>
          <tr lang="en">hold (sustain) pedal. When active, note release is ignored, when set to
          off, releases all held notes.</tr>
          <tr lang="ru">педаль демпфера (hold/sustain). При активации отпускание нот игнорируется,
          при выключении отпускает все удерживаемые ноты.</tr>
        </info>
        <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0" required="true">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="VAL" type="int" enum="0 1" required="true">
          <tr lang="en">pedal state (0: off, 1: on)</tr>
          <tr lang="ru">состояние педали (0: выкл, 1: вкл)</tr>
        </param>
      </method>
      <!-- legato -->
      <method name="legato">
        <info>
          <tr lang="en">enable or disable legato (smooth transitions between consecutive
          notes)</tr>
          <tr lang="ru">включить или выключить легато (плавные переходы между последовательными
          нотами)</tr>
        </info>
        <param name="CHAN" type="int" minvalue="0" maxvalue="15" required="true">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="VAL" type="int" enum="0 1" required="true">
          <tr lang="en">legato state (0: off, 1: on)</tr>
          <tr lang="ru">состояние легато (0: выкл, 1: вкл)</tr>
        </param>
      </method>
      <!-- midi -->
      <method name="midi">
        <info>
          <tr lang="en">send a raw MIDI message to the synth</tr>
          <tr lang="ru">отправить сырое MIDI-сообщение синтезатору</tr>
        </info>
        <param name="BYTES" type="list" required="true">
          <tr lang="en">list of byte values</tr>
          <tr lang="ru">список байтов</tr>
        </param>
      </method>
      <!-- note -->
      <method name="note">
        <info>
          <tr lang="en">play a note</tr>
          <tr lang="ru">воспроизвести ноту</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, plays on the first channel (!).</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, воспроизводит на первом канале (!).</tr>
        </param>
        <param name="NOTE" type="int" required="true" minvalue="0" maxvalue="127">
          <tr lang="en">MIDI note number</tr>
          <tr lang="ru">номер MIDI-ноты</tr>
        </param>
        <param name="VEL" type="int" required="true" minvalue="0" maxvalue="127">
          <tr lang="en">MIDI velocity</tr>
          <tr lang="ru">MIDI-скорость</tr>
        </param>
      </method>
      <!-- notes_off -->
      <method name="notes_off">
        <info>
          <tr lang="en">turn off all notes on a MIDI channel (enter release phase)</tr>
          <tr lang="ru">выключить все ноты на MIDI-канале (перевести в фазу затухания)</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
      </method>
      <!-- pan -->
      <method name="pan">
        <info>
          <tr lang="en">set channel panning (integer)</tr>
          <tr lang="ru">установить панорамирование канала (целое число)</tr>
        </info>
        <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0" required="false">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="PAN" type="float" minvalue="0" maxvalue="16383" required="true">
          <tr lang="en">pan value: 0 = left, 8192 (0x2000) = center, 16383 (0x3fff) = right</tr>
          <tr lang="ru">значение панорамы: 0 = лево, 8192 (0x2000) = центр, 16383 (0x3fff) =
          право</tr>
        </param>
      </method>
      <!-- pan:f -->
      <method name="pan:f">
        <info>
          <tr lang="en">set channel panning (float)</tr>
          <tr lang="ru">установить панорамирование канала (число с плавающей точкой)</tr>
        </info>
        <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0" required="false">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="PAN" type="float" minvalue="-1" maxvalue="1" required="true">
          <tr lang="en">pan value: -1 = left, 0 = center, 1 = right</tr>
          <tr lang="ru">значение панорамы: -1 = лево, 0 = центр, 1 = право</tr>
        </param>
      </method>
      <!-- pan:i -->
      <method name="pan:i">
        <info>
          <tr lang="en">set channel panning (integer, signed)</tr>
          <tr lang="ru">установить панорамирование канала (целое число со знаком)</tr>
        </info>
        <param name="CHAN" type="int" minvalue="0" maxvalue="16" default="0" required="false">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="PAN" type="float" minvalue="-8192" maxvalue="8191" required="true">
          <tr lang="en">pan value: -8192 (-0x2000) = left, 0 = center, 8191 (0x1fff) = right</tr>
          <tr lang="ru">значение панорамы: -8192 (-0x2000) = лево, 0 = центр, 8191 (0x1fff) =
          право</tr>
        </param>
      </method>
      <!-- panic -->
      <method name="panic">
        <info>
          <tr lang="en">send the MIDI system reset command (the big red 'panic' button). Turns off
          all notes, resets controllers, and restores the initial basic channel configuration.</tr>
          <tr lang="ru">отправить команду сброса MIDI (большая красная кнопка 'panic'). Выключает
          все ноты, сбрасывает контроллеры и восстанавливает начальную базовую конфигурацию
          каналов.</tr>
        </info>
      </method>
      <!-- polytouch -->
      <method name="polytouch">
        <info>
          <tr lang="en">polyphonic key pressure (polytouch)</tr>
          <tr lang="ru">полифоническое давление на клавишу (polytouch)</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel (ignored)</tr>
          <tr lang="ru">MIDI-канал (игнорируется)</tr>
        </param>
        <param name="NOTE" type="int" required="true" minvalue="0" maxvalue="127">
          <tr lang="en">MIDI note number</tr>
          <tr lang="ru">номер MIDI-ноты</tr>
        </param>
        <param name="VEL" type="int" required="true" minvalue="0" maxvalue="127">
          <tr lang="en">pressure value</tr>
          <tr lang="ru">значение давления</tr>
        </param>
      </method>
      <!-- prog -->
      <method name="prog">
        <info>
          <tr lang="en">program change</tr>
          <tr lang="ru">смена программы</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="PGM" type="int" required="true" minvalue="0" maxvalue="16383">
          <tr lang="en">program number</tr>
          <tr lang="ru">номер программы</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset synth channels</tr>
          <tr lang="ru">сбросить каналы синтезатора</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, resets all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, сбрасывает все каналы.</tr>
        </param>
      </method>
      <!-- set_preset -->
      <method name="set_preset">
        <info>
          <tr lang="en">set the soundfont preset for a MIDI channel</tr>
          <tr lang="ru">установить пресет звукового шрифта для MIDI-канала</tr>
        </info>
        <param name="CHAN" type="int" minvalue="1" maxvalue="16" required="true">
          <tr lang="en">MIDI channel</tr>
          <tr lang="ru">MIDI-канал</tr>
        </param>
        <param name="PRESET" type="atom" required="true">
          <tr lang="en">preset name or index</tr>
          <tr lang="ru">название или индекс пресета</tr>
        </param>
        <param name="SFONT" type="int" minvalue="1" required="false">
          <tr lang="en">soundfont index. See the @soundfonts property.</tr>
          <tr lang="ru">индекс звукового шрифта. См. свойство @soundfonts.</tr>
        </param>
      </method>
      <!-- soft -->
      <method name="soft">
        <info>
          <tr lang="en">soft (left) pedal. Activates the soft strike effect.</tr>
          <tr lang="ru">мягкая (левая) педаль. Активирует эффект мягкого удара.</tr>
        </info>
        <param name="CHAN" type="int" minvalue="0" maxvalue="15" required="true">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="VAL" type="int" enum="0 1" required="true">
          <tr lang="en">pedal state (0: off, 1: on)</tr>
          <tr lang="ru">состояние педали (0: выкл, 1: вкл)</tr>
        </param>
      </method>
      <!-- sostenuto -->
      <method name="sostenuto">
        <info>
          <tr lang="en">sostenuto (middle) pedal. Holds notes pressed before pedal activation: new
          notes are unaffected. Releases held notes when set to off.</tr>
          <tr lang="ru">педаль sostenuto (средняя). Удерживает ноты, нажатые до активации педали:
          новые ноты не затрагиваются. При выключении отпускает удерживаемые ноты.</tr>
        </info>
        <param name="CHAN" type="int" minvalue="0" maxvalue="15" required="true">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="VAL" type="int" enum="0 1" required="true">
          <tr lang="en">pedal state (0: off, 1: on)</tr>
          <tr lang="ru">состояние педали (0: выкл, 1: вкл)</tr>
        </param>
      </method>
      <!-- sound_off -->
      <method name="sound_off">
        <info>
          <tr lang="en">immediately stop all notes on a MIDI channel (skip the release phase)</tr>
          <tr lang="ru">немедленно остановить все ноты на MIDI-канале (пропустить фазу
          затухания)</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
      </method>
      <!-- sysex -->
      <method name="sysex">
        <info>
          <tr lang="en">accept a SYSEX message</tr>
          <tr lang="ru">принять SYSEX-сообщение</tr>
        </info>
        <param name="BYTES" type="list" required="true">
          <tr lang="en">list of byte values</tr>
          <tr lang="ru">список байтов</tr>
        </param>
      </method>
      <!-- tune. -->
      <method name="tune.">
        <info>
          <tr lang="en">set fine tuning in cents (see also tune:s)</tr>
          <tr lang="ru">установить точную настройку в центах (см. также tune:s)</tr>
        </info>
      </method>
      <!-- tune:12 -->
      <method name="tune:12">
        <info>
          <tr lang="en">set and activate an octave tuning program in cent deviations</tr>
          <tr lang="ru">установить и активировать программу настройки октавы в отклонениях
          центов</tr>
        </info>
        <param name="BANK" type="int" required="true" minvalue="1" maxvalue="256">
          <tr lang="en">tuning bank (not related to the MIDI instrument bank)</tr>
          <tr lang="ru">банк настройки (не связан с банком MIDI-инструментов)</tr>
        </param>
        <param name="PRESET" type="int" required="true" minvalue="1" maxvalue="256">
          <tr lang="en">tuning preset (not related to the MIDI instrument program)</tr>
          <tr lang="ru">пресет настройки (не связан с программой MIDI-инструментов)</tr>
        </param>
        <param name="TUNES" type="list" required="true">
          <tr lang="en">list of scale deviations from 12TET in cents</tr>
          <tr lang="ru">список отклонений от 12-тоновой равномерной темперации (12TET) в
          центах</tr>
        </param>
      </method>
      <!-- tune:c -->
      <method name="tune:c">
        <info>
          <tr lang="en">set fine tuning in cents</tr>
          <tr lang="ru">установить точную настройку в центах</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="CENTS" type="float" required="true" minvalue="-100" maxvalue="100">
          <tr lang="en">tuning offset in cents</tr>
          <tr lang="ru">смещение настройки в центах</tr>
        </param>
      </method>
      <!-- tune:s -->
      <method name="tune:s">
        <info>
          <tr lang="en">set tuning in semitones</tr>
          <tr lang="ru">установить настройку в полутонах</tr>
        </info>
        <param name="CHAN" type="int" required="false" default="0" minvalue="0" maxvalue="16">
          <tr lang="en">MIDI channel. If zero or omitted, applies to all channels.</tr>
          <tr lang="ru">MIDI-канал. Если 0 или не указан, применяется ко всем каналам.</tr>
        </param>
        <param name="SEMI" type="float" required="true" minvalue="-64" maxvalue="63">
          <tr lang="en">tuning offset in semitones</tr>
          <tr lang="ru">смещение настройки в полутонах</tr>
        </param>
      </method>
      <!-- tunesel -->
      <method name="tunesel">
        <info>
          <tr lang="en">select a tuning bank and preset</tr>
          <tr lang="ru">выбрать банк настройки и пресет</tr>
        </info>
        <param name="BANK" type="int" required="true" minvalue="1" maxvalue="256">
          <tr lang="en">tuning bank (not related to the MIDI instrument bank)</tr>
          <tr lang="ru">банк настройки (не связан с банком MIDI-инструментов)</tr>
        </param>
        <param name="PRESET" type="int" required="true" minvalue="1" maxvalue="256">
          <tr lang="en">tuning preset (not related to the MIDI instrument program)</tr>
          <tr lang="ru">пресет настройки (не связан с программой MIDI-инструментов)</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">load a SoundFont file</tr>
          <tr lang="ru">загрузить SoundFont-файл</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left channel and property output</tr>
          <tr lang="ru">левый канал и вывод свойств</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right channel</tr>
          <tr lang="ru">правый канал</tr>
        </out>
      </outlet>
      <outlet type="control">
        <out type="any">
          <tr lang="en">int: number of active voices (output only when changed)</tr>
          <tr lang="ru">int: количество активных голосов (выводится только при изменении)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
|         [ui.hrd @nitems 4]            /*program change on MIDI chan 1*/
|         |.
[flow.demux 4 #a]                       [hradio]
                                        |
                                        |
[msg #n1] [msg #n2] [msg #n3] [msg #n4] [prog 1 $1 #b(


 [dump #e([@sf sf2/VintageDreamsWaves-v2.sf2 #c(

          [@sf sf2/waves.sf2 #d(

[fluid~      #z]
*|*
[ui.hgain2~]   [ui.dsp~]
*|*
[dac~]

[fluid~-bend]   [fluid~-tune]     [fluid~-pan]  [fluid~-bank]

[fluid~-midi]   [fluid~-tune-12]  [fluid~-prog] [fluid~-notesoff]

[fluid~-pedals] [fluid~-soundoff] [fluid~-presets]

#n1 note 1
#n2 note 2
#n3 note 3
#n4 note 4
[X a:0->n1] [X a:1->n2] [X a:2->n3] [X a:3->n4] [X b->z]
[X n1->z]   [X n2->z]   [X n3->z]   [X n4->z]
[X c->z]    [X d->z]    [X e->z]
]]>
      </pdascii>
      <pdascii id="bend">
<![CDATA[
/*Shift+Click to hold note*/

[ui.keyboard 25 48]
|
|                   [loadmsg 1]
|                   |
|                   [ui.hsl  #a] X [spring 0]  [ui.k #b] [ui.k #c]
|                   |                          |         |
|                   [flow.f]    [ui.hrd]       |         |
|                   |           |              |         |
[msg note 1]        [bend:f $1( [bendsens $1(  [bend $1( [bend:i $1(
|                   |           |              |         |
|                   |           |              |         |
[fluid~                                                  ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]

#a -1 1 @show_value 1 @mouse_events 1
#b 0 16383 @show_value 1
#c -8192 8191 @show_value 1
]]>
      </pdascii>
      <pdascii id="midi">
<![CDATA[
/*play MIDI keyboard with default Sine tone sample*/

[midiin]
|
[msg midi]
|
[fluid~]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
      <pdascii id="tune">
<![CDATA[
/*play MIDI keyboard with default Sine tone sample*/

[midiin]   [F]          [F]
|          |            |
[msg midi] [tune:s $1(  [tune:c $1(
|          |            |
[fluid~                 ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
      <pdascii id="tune-12">
<![CDATA[
/*play MIDI keyboard with default Sine tone sample*/

            /*save and activate tuning at bank:1, preset:1*/

[midiin]    [1 1 0 0 -50 0 0 0 0 0 0 0 0 -50(
|           |
|           |             /*restore 12TFT*/
|           |
[msg midi]  [msg tune:12] [tunesel 0 0( [tunesel 1 1(
|           |             |             |
[fluid~                                 ] /*activate bank:1, preset:1*/
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
      <pdascii id="pan">
<![CDATA[
[midiin]   [ui.k #a] [ui.k #b]  [ui.k #c]
|          |         |          |
|          |         |          |
|          |         |          |
[msg midi] [pan $1(  [pan:i $1( [pan:f $1(
|          |         |          |
[fluid~                         ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]

#a 0 16383 @show_value 1
#b -8192 8191 @show_value 1
#c -1 1 @show_value 1
]]>
      </pdascii>
      <pdascii id="prog">
<![CDATA[
[ui.keyboard 25 60]
|
|
|
|
|          [ui.hrd 5] /*different attack and vibrato*/
|          |
[msg note] [prog 1 $1(
|          |
[fluid~    ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
      <pdascii id="bank">
<![CDATA[
[ui.keyboard 25 60]
|
|
|
|
|
|   [ui.hrd 4]
|   |
|   [+ 1]
|   |.
[msg 1]    [loadbang]
|          |
[msg note] [bank 1 0, prog 1 1, bank 2 1, prog 2 4, bank 3 2, prog 3 1, bank 4 3, prog 4 1(
|          |
|          |
|          |
[fluid~ sf2/waves.sf2]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
      <pdascii id="reset">
<![CDATA[
[note 1 60 120, note 1 65 120, note 2 47 120(
|
| [reset( [reset 1( [reset 2(
| |       |         |
[fluid~             ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
      <pdascii id="notesoff">
<![CDATA[
[note 1 60 120, note 1 65 120, note 2 47 120(
|
| /*all*/     /*1st chan*/  /*2nd chan*/   [loadbang]
|                                          |
| [notes_off( [notes_off 1( [notes_off 2(  [bank 0 0, prog 0 1( /*slow attack/release*/
| |           |             |              |
[fluid~ sf2/waves.sf2                      ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
      <pdascii id="soundoff">
<![CDATA[
[note 1 60 120, note 1 65 120, note 2 47 120(
|
| /*all*/    /*1st chan*/  /*2nd chan*/   [loadbang]
|                                         |
| [sound_off( [sound_off 1( [sound_off 2( [bank 0 0, prog 0 1( /*slow attack/release*/
| |           |             |             |
[fluid~ sf2/waves.sf2                     ]
*|*
[ui.hgain2~]    [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
      <pdascii id="pedals">
<![CDATA[
[notein]
*|*
[pack f f]
|
[ui.keyboard]
|
|
|
|
|           [ui.btn]  [ui.btn]  [ui.btn]    [ui.btn]
|           |         |         |           |
[msg note]  [hold $1( [soft $1( [legato $1( [sostenuto $1(
|           |         |         |           |
|           |         |         |           |
[fluid~ sf2/waves.sf2 #z                    ]
*|*
[ui.hgain2~]    [ui.dsp~]   [bank 1 0, prog 1 2 #a(
*|*
[dac~]
[X a->z]
]]>
      </pdascii>
      <pdascii id="presets">
<![CDATA[
[ui.keyboard 25 48]                [ui.dsp~]
|
|
|
|
|
|   [ui.hrd 4]
|   |
|   [+ 1]
|   |.
[msg 1]       [loadbang]
|             |
[msg note #c] [del 100]
              |
              [set_preset 1 tri, set_preset 2 square_mod, set_preset 3 saw, set_preset 4 sine_mod #a(



              [B]
              |
              [prop.get @presets #b]
              ^|
              [msg @items]
              |
              [ui.menu @nosave 1]
              |
              [set_preset 1 $2 #d(



[fluid~ sf2/waves.sf2 #z]
*|*
[ui.hgain2~]
*|*
[dac~]

[X a->z] [X b->z] [X c->z] [X d->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
