<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="xdac~">
    <title>xdac~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">[dac~] with channel ranges</tr>
        <tr lang="ru">[dac~] с диапазонами каналов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>base</keywords>
      <since>0.8</since>
      <aliases>
        <alias>ceammc/xdac~</alias>
      </aliases>
    </meta>
    <mouse>
      <event type="left-click" editmode="false">opens audio properties dialog</event>
    </mouse>
    <arguments>
      <argument name="OUTS" type="list">
        <tr lang="en">list of output channels: single channel number or X:Y range, that means from
        X channel to Y (including last one). If not specified - using 1 and 2 out channels</tr>
        <tr lang="ru" finished="false">Список выходных каналов: одноканальный номер канала или
        диапазон X:Y, что означает от канала X до Y (включая последний). Если не указано -
        использование 1 и 2 каналов</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @channels -->
      <property name="@channels" type="list" default="1 2">
        <tr lang="en">list of mapped channels</tr>
        <tr lang="ru" finished="false">Список картографических каналов</tr>
      </property>
    </properties>
    <methods>
      <!-- reverse -->
      <method name="reverse">
        <info>
          <tr lang="en">reverse output channels order</tr>
          <tr lang="ru" finished="false">обратный выходной канал</tr>
        </info>
      </method>
      <!-- rotate -->
      <method name="rotate">
        <info>
          <tr lang="en">rotate output channels counter clockwise</tr>
          <tr lang="ru" finished="false">вращающиеся выходные каналы против часовой стрелки</tr>
        </info>
        <param name="N" type="int" required="true">
          <tr lang="en">number of rotation steps, can be negative</tr>
          <tr lang="ru" finished="false">Число шагов вращения может быть отрицательным</tr>
        </param>
      </method>
      <!-- shuffle -->
      <method name="shuffle">
        <info>
          <tr lang="en">shuffle output channels order</tr>
          <tr lang="ru" finished="false">Перетасовка выходных каналов заказа</tr>
        </info>
      </method>
      <!-- side2circle -->
      <method name="side2circle">
        <info>
          <tr lang="en">map left/right side pairs to counter clockwise layout</tr>
          <tr lang="ru" finished="false">карта левой / правой стороны пары, чтобы противостоять по
          часовой стрелке макет</tr>
        </info>
      </method>
    </methods>
    <inlets dynamic="true">
      <inlet type="audio" number="1">
        <in>
          <tr lang="en">first specified channel</tr>
          <tr lang="ru" finished="false">Первый указанный канал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... specified channel</tr>
          <tr lang="ru" finished="false">Указанный канал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">n-th specified channel</tr>
          <tr lang="ru" finished="false">n-й указанный канал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets />
    <example>
      <pdascii>
<![CDATA[
[xdac~] [xdac~ 1:6] [xdac~ 1:3 5 7:12]

[xdac~-map]
]]>
      </pdascii>
      <pdascii id="map">
<![CDATA[
[T]
|
[metro 500]
|
[T]
|
[sel 0 1       ]
|             ^|
[click~]      [click~ #b]
|
[flt.resonbp~ 1000 40]
|
|             [flt.resonbp~ 4000 40 #c]
|             |.
[ui.hgain2~    ]  [@channels 2 1(
| ^|              |
|  |.             |
[xdac~ 1 2   {i:2}]

[X b->c]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
