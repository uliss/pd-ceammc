<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="xdac~">
    <title>xdac~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">[dac~] with channel ranges</tr>
        <tr lang="ru">[dac~] с диапазонами каналов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>base</keywords>
      <since>0.8</since>
      <aliases>
        <alias>ceammc/xdac~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">An extended version of the standard [dac~] object that accepts a list of
        output channels as its argument. In addition to single channel numbers, it also accepts
        range notation like 1:6, which means "channels 1 through 6 inclusive". If no argument is
        given, channels 1 and 2 are used by default.</tr>
        <tr lang="ru">Расширенная версия стандартного объекта [dac~], которая принимает в качестве
        аргумента список выходных каналов. Помимо отдельных номеров каналов, она поддерживает
        диапазоны, например 1:6, что означает «каналы с 1 по 6 включительно». Если аргумент не
        указан, по умолчанию используются каналы 1 и 2.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Multi-channel installations — connecting a patch to a specific subset of
        audio outputs of a multi-channel sound card (for example, 1:6 for six speakers), without
        having to list every channel number individually.</tr>
        <tr lang="ru">• Многоканальные инсталляции — подключение патча к определённому подмножеству
        аудиовыходов многоканальной звуковой карты (например, 1:6 для шести колонок), без
        необходимости перечислять каждый номер канала вручную.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Channel remapping on the fly — using the @channels property or the reverse,
        rotate and shuffle methods to reorder the outputs during a performance, for example to swap
        left and right or to rotate a surround layout.</tr>
        <tr lang="ru">• Переназначение каналов на лету — использование свойства @channels или
        методов reverse, rotate и shuffle для переупорядочивания выходов во время выступления,
        например чтобы поменять левый и правый каналы или «повернуть» схему объёмного звука.</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">opens audio properties dialog</event>
    </mouse>
    <arguments>
      <argument name="OUTS" type="list">
        <tr lang="en">list of output channels: a single channel number or an X:Y range, which means
        "from channel X to channel Y inclusive". If not specified, output channels 1 and 2 are
        used</tr>
        <tr lang="ru">список выходных каналов: отдельный номер канала или диапазон X:Y, что
        означает «с канала X по канал Y включительно». Если не указано, используются выходные
        каналы 1 и 2</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @channels -->
      <property name="@channels" type="list" default="1 2">
        <tr lang="en">list of mapped channels</tr>
        <tr lang="ru">список назначенных каналов</tr>
      </property>
    </properties>
    <methods>
      <!-- reverse -->
      <method name="reverse">
        <info>
          <tr lang="en">reverses the output channel order</tr>
          <tr lang="ru">обращает порядок выходных каналов</tr>
        </info>
      </method>
      <!-- rotate -->
      <method name="rotate">
        <info>
          <tr lang="en">rotates output channels counter-clockwise</tr>
          <tr lang="ru">циклически сдвигает выходные каналы против часовой стрелки</tr>
        </info>
        <param name="N" type="int" required="true">
          <tr lang="en">number of rotation steps, can be negative</tr>
          <tr lang="ru">число шагов сдвига, может быть отрицательным</tr>
        </param>
      </method>
      <!-- shuffle -->
      <method name="shuffle">
        <info>
          <tr lang="en">shuffles the output channel order</tr>
          <tr lang="ru">перемешивает порядок выходных каналов случайным образом</tr>
        </info>
      </method>
      <!-- side2circle -->
      <method name="side2circle">
        <info>
          <tr lang="en">maps left/right side pairs to a counter-clockwise layout</tr>
          <tr lang="ru">преобразует раскладку пар левый/правый в круговую раскладку против часовой
          стрелки</tr>
        </info>
      </method>
    </methods>
    <inlets dynamic="true">
      <inlet type="audio" number="1">
        <in>
          <tr lang="en">first specified channel</tr>
          <tr lang="ru">первый указанный канал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... specified channel</tr>
          <tr lang="ru">... указанный канал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">n-th specified channel</tr>
          <tr lang="ru">n-й указанный канал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets />
    <example>
      <pdascii>
<![CDATA[
[xdac~] [xdac~ 1:6] [xdac~ 1:3 5 7:12]

[xdac~-map]
]]>
      </pdascii>
      <pdascii id="map">
<![CDATA[
[T]
|
[metro 500]
|
[T]
|
[sel 0 1       ]
|             ^|
[click~]      [click~ #b]
|
[flt.resonbp~ 1000 40]
|
|             [flt.resonbp~ 4000 40 #c]
|             |.
[ui.hgain2~    ]  [@channels 2 1(
| ^|              |
|  |.             |
[xdac~ 1 2   {i:2}]

[X b->c]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
