<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="dyn.comp_peak~">
    <title>dyn.comp_peak~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">mono dynamic range peak feed forward compressor</tr>
        <tr lang="ru">пиковый моно-компрессор прямой топологии</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>dyn</category>
      <keywords>compressor</keywords>
      <since>0.9.7</since>
      <also>
        <see>dyn.comp_peak2~</see>
      </also>
      <aliases>
        <alias>comp.peak~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">A mono peak compressor with feed-forward topology. Instead of the traditional
        "ratio" control, it uses a strength parameter, which makes it easy to use the object both
        as a regular compressor and as a hard limiter or overcompressor (when strength is greater
        than 1).</tr>
        <tr lang="ru">Монофонический пиковый компрессор с прямой топологией (feed-forward). Вместо
        традиционного управления «ratio» (степень сжатия) используется параметр силы (strength),
        что позволяет применять объект и как обычный компрессор, и как жёсткий ограничитель или
        сверхкомпрессор (при strength больше 1).</tr>
      </par>
      <a href="https://en.wikipedia.org/wiki/Dynamic_range_compression">Dynamic range
      compression</a>
    </info>
    <arguments>
      <argument name="STRENGTH" type="float" minvalue="0" maxvalue="2">
        <tr lang="en">compression strength (0: no compression, 1: hard limiting, &gt;1:
        overcompression)</tr>
        <tr lang="ru">сила компрессии (0 — без компрессии, 1 — жёсткое ограничение, &gt;1 —
        сверхкомпрессия)</tr>
      </argument>
      <argument name="THRESHOLD" type="float" minvalue="-60" maxvalue="0" units="decibel">
        <tr lang="en">level threshold above which compression kicks in</tr>
        <tr lang="ru">пороговый уровень, выше которого начинается компрессия</tr>
      </argument>
      <argument name="ATTACK" type="float" units="millisecond" minvalue="0.1" maxvalue="100">
        <tr lang="en">attack time — the time that elapses between exceeding the threshold and the
        moment when the target compression level is reached</tr>
        <tr lang="ru">время атаки — время, которое проходит между превышением порогового значения и
        моментом достижения заданного уровня компрессии</tr>
      </argument>
      <argument name="RELEASE" type="float" units="millisecond" minvalue="1" maxvalue="500">
        <tr lang="en">release time — the decay time that elapses between the input signal level
        dropping below the threshold and the moment when the compressor stops attenuating the
        signal</tr>
        <tr lang="ru">время восстановления — время спада, которое проходит между моментом, когда
        уровень входного сигнала упал ниже порога, и моментом, когда компрессор перестаёт ослаблять
        сигнал</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @attack -->
      <property name="@attack" type="float" units="millisecond" default="10" minvalue="0.1"
      maxvalue="100">
        <tr lang="en">time constant for the attack phase (gain reduction increasing)</tr>
        <tr lang="ru">постоянная времени для фазы атаки (усиление снижается)</tr>
      </property>
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true — the input signal is passed through unchanged, without
        compression</tr>
        <tr lang="ru">флаг обхода. Если истина — входной сигнал проходит без обработки, минуя
        компрессию</tr>
      </property>
      <!-- @gain -->
      <property name="@gain" type="float" units="decibel" default="0" minvalue="-18" maxvalue="18">
        <tr lang="en">make-up gain: applied to the signal after the compression takes place</tr>
        <tr lang="ru">компенсирующее усиление (make-up gain): применяется к сигналу после
        компрессии</tr>
      </property>
      <!-- @knee -->
      <property name="@knee" type="float" units="decibel" default="3" minvalue="0" maxvalue="24">
        <tr lang="en">a gradual increase in gain reduction around the threshold: below
        thresh−(knee/2) there is no gain reduction, above thresh+(knee/2) the gain reduction is the
        same as without a knee, and in between there is a gradual increase in gain reduction</tr>
        <tr lang="ru">плавное увеличение снижения усиления вблизи порога: ниже thresh−(knee/2)
        снижения усиления нет, выше thresh+(knee/2) снижение усиления такое же, как и без knee, а
        между ними происходит плавное увеличение снижения усиления</tr>
      </property>
      <!-- @level -->
      <property name="@level" type="float" default="0" minvalue="0" maxvalue="1" access="readonly">
        <tr lang="en">current level of compression</tr>
        <tr lang="ru">текущий уровень компрессии</tr>
      </property>
      <!-- @refresh -->
      <property name="@refresh" type="int" default="100" minvalue="0" maxvalue="1000"
      units="millisecond">
        <tr lang="en">compression level output time interval. If 0 — no output</tr>
        <tr lang="ru">интервал вывода уровня компрессии. Если 0 — вывод не производится</tr>
      </property>
      <!-- @release -->
      <property name="@release" type="float" units="millisecond" default="50" minvalue="1"
      maxvalue="500">
        <tr lang="en">release time — time constant for coming out of compression</tr>
        <tr lang="ru">время восстановления — постоянная времени выхода из компрессии</tr>
      </property>
      <!-- @strength -->
      <property name="@strength" type="float" default="0" minvalue="0" maxvalue="2">
        <tr lang="en">compression strength (0: no compression, 1: hard limiting, &gt;1:
        overcompression)</tr>
        <tr lang="ru">сила компрессии (0 — без компрессии, 1 — жёсткое ограничение, &gt;1 —
        сверхкомпрессия)</tr>
      </property>
      <!-- @threshold -->
      <property name="@threshold" type="float" units="decibel" default="-10" minvalue="-60"
      maxvalue="0">
        <tr lang="en">level threshold above which compression kicks in (100 dB = max level)</tr>
        <tr lang="ru">пороговый уровень, выше которого начинается компрессия (100 дБ — максимальный
        уровень)</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the object to its initial state</tr>
          <tr lang="ru">возвращает объект в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set compression strength</tr>
          <tr lang="ru">задать силу компрессии</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output compressed signal</tr>
          <tr lang="ru">выходной сжатый сигнал</tr>
        </out>
      </outlet>
      <outlet>
        <out type="float">
          <tr lang="en">current compression level in the [0, 1] range</tr>
          <tr lang="ru">текущий уровень компрессии в диапазоне [0, 1]</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.hsl #a]              [ui.dsp~]
|
[dbfs->amp]
|
[sig~]  [ui.hsl #a]
|       |
|       |
|       [@threshold $1(  [ui.knob @label STRENGTH @show_value 1]
|       |                |
|       |                |.
[dyn.comp_peak~ 0 -60 10 100]
|                     ^|
[env~]                [ui.hsl @active_scale 1]
|
[- 100]
|
[F]

[dyn.comp_peak~-plot]

#a -60 0 @show_value 1
]]>
      </pdascii>
      <pdascii id="plot">
<![CDATA[
[B]
|
[plot.linspace~ -60 6 1024 #a]  [ui.k #b]  [ui.hsl 0 24 #c]
|                                          |
[dbfs->amp~]                               [@knee $1 #d(
|
[dyn.comp_peak~ 1 -20 0.1 1     #z]
|
[amp->dbfs~]
|
[ui.plot~ @ymin -60 @ymax 6 @size 400 350 @xlabels 1 @ylabels 1 @xmin_grid 0 @ymin_ticks 0 @xmin_ticks 0 #x]























#b @show_value 1 @label STRENGTH
#c @show_value 1
/*...*/
[X a:1->x:1]
[X b->z:1]
[X d->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
