<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flt.a-weight">
        <title>flt.a-weight</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert frequency to A-weight value</tr>
                <tr lang="ru">вычисляет А-взвешенное значение для данной частоты</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter weight A</keywords>
            <since>0.9.5</since>
        </meta>
        <properties>
            <!-- @db -->
            <property name="@db" type="flag" default="0" access="initonly">
                <tr lang="en">output in decibels</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input frequency in Herz</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">list of input frequencies in Herz, non float types are
                    ignored</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>float or list A-weight amplitudes or decibel values</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(                  [array A-WEIGHT w=400 yr=0..1]
|
[list.seq 20 20000 50]
|
[flt.a-weight]
|
[list->array A-WEIGHT]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
