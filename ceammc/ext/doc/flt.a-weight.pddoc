<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flt.a-weight">
    <title>flt.a-weight</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">convert frequency to A-weight value</tr>
        <tr lang="ru">вычисляет А-взвешенное значение для заданной частоты</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flt</category>
      <keywords>filter weight A</keywords>
      <since>0.9.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object computes the A-weighting value for the given frequency according to the IEC 61672 standard</tr>
        <tr lang="ru">объект вычисляет А-взвешенное значение для заданной частоты согласно стандарту IEC 61672</tr>
      </par>
      <par>
        <tr lang="en">A-weighting is commonly used in audio measurements to approximate the frequency response of human hearing</tr>
        <tr lang="ru">А-взвешивание обычно применяется в аудиоизмерениях для приближения к частотной характеристике человеческого слуха</tr>
      </par>
    </info>
    <properties>
      <!-- @db -->
      <property name="@db" type="flag" default="0" access="initonly">
        <tr lang="en">output in decibels</tr>
        <tr lang="ru">выводить в децибелах</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input frequency in Hz</tr>
          <tr lang="ru">входная частота в Гц</tr>
        </in>
        <in on="list">
          <tr lang="en">list of input frequencies in Hz, non-float types are ignored</tr>
          <tr lang="ru">список входных частот в Гц, нечисловые элементы игнорируются</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">float or list of A-weight amplitudes or decibel values</tr>
          <tr lang="ru">число или список А-взвешенных амплитуд либо значений в децибелах</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang(                  [array A-WEIGHT w=400 yr=0..1]
|
[list.seq 20 20000 50]
|
[flt.a-weight]
|
[list->array A-WEIGHT]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
