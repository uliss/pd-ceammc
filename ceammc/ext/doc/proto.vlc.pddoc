<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="proto.vlc">
    <title>proto.vlc</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">VLC video player control over HTTP</tr>
        <tr lang="ru">управление видеоплеером VLC через HTTP</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>proto</category>
      <keywords>mpv mplayer</keywords>
      <since>0.9.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">VLC video player control</tr>
        <tr lang="ru">Управление видеоплеером VLC</tr>
      </par>
      <a href="https://www.videolan.org/vlc">videolan.org</a>
    </info>
    <arguments>
      <argument name="HOST" type="symbol">
        <tr lang="en">hostname on which the VLC player is running</tr>
        <tr lang="ru">имя хоста на котором запущен VLC плеер</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @host -->
      <property name="@host" type="symbol" default="localhost">
        <tr lang="en">hostname on which the VLC player is running</tr>
        <tr lang="ru">имя хоста на котором запущен VLC плеер</tr>
      </property>
      <!-- @pass -->
      <property name="@pass" type="atom" default="">
        <tr lang="en">password for accessing VLC over HTTP</tr>
        <tr lang="ru">пароль для доступа к VLC по http</tr>
      </property>
      <!-- @port -->
      <property name="@port" type="int" default="8080" minvalue="1" maxvalue="32768">
        <tr lang="en">network port number for VLC's HTTP control interface</tr>
        <tr lang="ru">номер сетевого порта для http интерфейса управления VLC</tr>
      </property>
    </properties>
    <methods>
      <!-- add -->
      <method name="add">
        <info>
          <tr lang="en">add URI to playlist</tr>
          <tr lang="ru">добавить URI в плейлист</tr>
        </info>
        <param name="URI" type="symbol" required="true">
          <tr lang="en">resource URI (file:// or http:// or camera://)</tr>
          <tr lang="ru">URI ресурса (file:// или http:// или camera://)</tr>
        </param>
      </method>
      <!-- add_dir -->
      <method name="add_dir">
        <info>
          <tr lang="en">add directory files to the playlist. If the file is already in the
          playlist, it will not be added.</tr>
          <tr lang="ru">добавить файлы директории в плейлист. Если файл уже в плейлисте, повторно
          он не добавляется.</tr>
        </info>
        <param name="DIR" type="symbol" required="true">
          <tr lang="en">the full path to the directory on the computer where VLC is running</tr>
          <tr lang="ru">полный путь к директории на компьютере, на котором запущен VLC</tr>
        </param>
        <param name="GLOB" type="symbol" required="true">
          <tr lang="en">match pattern for files. For example: *.wav - adds all files with the .wav
          extension.</tr>
          <tr lang="ru">шаблон соответствия для файлов. Например: *.wav - добавляет все файлы с
          расшиением wav.</tr>
        </param>
      </method>
      <!-- browse -->
      <method name="browse">
        <info>
          <tr lang="en">browse a list of files and folders in the specified directory on the host
          where the VLC player is running</tr>
          <tr lang="ru">выводит список файлов и папок в указанной директории на хосте, на котором
          запущен VLC плеер</tr>
        </info>
        <param name="DIR" type="symbol" required="true">
          <tr lang="en">the full path to the directory on the computer where VLC is running</tr>
          <tr lang="ru">полный путь к директории на компьютере, на котором запущен VLC</tr>
        </param>
        <param name="@dir" type="flag">
          <tr lang="en">list only subdirectories</tr>
          <tr lang="ru">выводить только под-директории</tr>
        </param>
        <param name="@file" type="flag">
          <tr lang="en">list only files</tr>
          <tr lang="ru">выводить файлы</tr>
        </param>
        <param name="@glob" type="symbol">
          <tr lang="en">match pattern for files. For example: *.wav - shows all files with the .wav
          extension.</tr>
          <tr lang="ru">шаблон соответствия для файлов. Например: *.wav - выводит все файлы с
          расширением wav.</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">remove all items from the playlist</tr>
          <tr lang="ru">удалить все элементы из плейлиста</tr>
        </info>
      </method>
      <!-- delete -->
      <method name="delete">
        <info>
          <tr lang="en">delete item from playlist</tr>
          <tr lang="ru">удалить элемент из плейлиста</tr>
        </info>
        <param name="ID" type="int">
          <tr lang="en">Item ID in the playlist (NB: not the position in the playlist, but the
          unique index assigned when added)</tr>
          <tr lang="ru">ID элемента в плейлисте (NB: не позиция в плейлисте, а уникальный индес при
          добавлении)</tr>
        </param>
      </method>
      <!-- fs -->
      <method name="fs">
        <info>
          <tr lang="en">set or toggle VLC full-screen mode</tr>
          <tr lang="ru">устанавливает или переключает полноэкранный режим VLC</tr>
        </info>
        <param name="STATE" type="bool">
          <tr lang="en">If set to 1, it switches to full-screen mode \; if 0, it exits full-screen
          mode. If the parameter is omitted, it toggles between the modes.</tr>
          <tr lang="ru">Если равно 1, переводит в полноэкранный режим, если 0: выходит из
          полноэкранного режима. Если параметер опущен, переключает между режимами.</tr>
        </param>
      </method>
      <!-- loop -->
      <method name="loop">
        <info>
          <tr lang="en">toggle loop</tr>
          <tr lang="ru" finished="false">петля переключения</tr>
        </info>
      </method>
      <!-- next -->
      <method name="next">
        <info>
          <tr lang="en">go to the next entry on the playlist</tr>
          <tr lang="ru" finished="false">перейти к следующей записи в плейлисте</tr>
        </info>
      </method>
      <!-- pause -->
      <method name="pause">
        <info>
          <tr lang="en">pause/resume playback</tr>
          <tr lang="ru" finished="false">пауза/возобновление воспроизведения</tr>
        </info>
        <param name="VAL" type="int" enum="0 1">
          <tr lang="en">1 or omitted: pause, 0: resume</tr>
          <tr lang="ru" finished="false">1 или опущено: пауза, 0: резюме</tr>
        </param>
      </method>
      <!-- play -->
      <method name="play">
        <info>
          <tr lang="en">start playback</tr>
          <tr lang="ru" finished="false">Начать играть</tr>
        </info>
      </method>
      <!-- playlist -->
      <method name="playlist">
        <info>
          <tr lang="en">request playlist. Output as dict to second outlet</tr>
          <tr lang="ru" finished="false">Запросить плейлист. Выход как диктовка второму выходу</tr>
        </info>
      </method>
      <!-- prev -->
      <method name="prev">
        <info>
          <tr lang="en">go to the previous entry on the playlist</tr>
          <tr lang="ru" finished="false">перейти к предыдущей записи в плейлисте</tr>
        </info>
      </method>
      <!-- seek -->
      <method name="seek">
        <info>
          <tr lang="en">seek playback position</tr>
          <tr lang="ru" finished="false">Посмотреть Playback</tr>
        </info>
        <param name="TIME" type="atom" required="true">
          <tr lang="en">absolute time position (int value in seconds or 00h:00m:00s) or relative
          offset (+val, -val)</tr>
          <tr lang="ru" finished="false">абсолютная временная позиция (int value in seconds или
          00h:00m:00s) или относительное смещение (+val, -val)</tr>
        </param>
      </method>
      <!-- status -->
      <method name="status">
        <info>
          <tr lang="en">request playback status. Output as dict to second outlet</tr>
          <tr lang="ru" finished="false">запросить статус воспроизведения. Выход как диктовка
          второму выходу</tr>
        </info>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stop playback</tr>
          <tr lang="ru" finished="false">остановить воспроизведение</tr>
        </info>
      </method>
      <!-- volume -->
      <method name="volume">
        <info>
          <tr lang="en">set playing volume</tr>
          <tr lang="ru" finished="false">игровой объем</tr>
        </info>
        <param name="VAL" type="atom" required="true">
          <tr lang="en">absolute value in percent or relative change +VOL or -VOL</tr>
          <tr lang="ru" finished="false">абсолютное значение в процентах или относительное
          изменение +VOL или -VOL</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">commands</tr>
          <tr lang="ru" finished="false">командовать</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">int: 1 on success, 0 on error</tr>
          <tr lang="ru" finished="false">Инт: 1 об успехе, 0 об ошибке</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">dict: response data</tr>
          <tr lang="ru" finished="false">ct: данные ответа</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[play #a(    [playlist #c(   [next #d( [prev #e(

[stop #b(    [B]             [browse file:// #f(
             |
 [T]         [openpanel]     [S digits=10]
 |           |               |
[pause( [fs( [add file://$1( [seek $1(
|       |    |               |
[proto.vlc localhost @pass 12345 #z]
|                      ^|
[T]                    [print]
[X a->z]
[X b->z]
[X c->z]
[X d->z]
[X e->z]
[X f->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
