<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="proto.vlc">
    <title>proto.vlc</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">VLC video player control over HTTP</tr>
        <tr lang="ru">управление видеоплеером VLC через HTTP</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>proto</category>
      <keywords>mpv mplayer</keywords>
      <since>0.9.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">VLC video player control</tr>
        <tr lang="ru">Управление видеоплеером VLC</tr>
      </par>
      <par>
        <tr lang="en">To control VLC using this object, the HTTP control module must be enabled and
        a password set</tr>
        <tr lang="ru">Для управления VLC при помощи этого объекта, должен быть включен модуль
        управления http и установлен пароль</tr>
      </par>
      <a href="https://wiki.videolan.org/Documentation:Modules/http_intf/">See documentation</a>
    </info>
    <arguments>
      <argument name="HOST" type="symbol">
        <tr lang="en">hostname on which the VLC player is running</tr>
        <tr lang="ru">имя хоста на котором запущен VLC плеер</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @host -->
      <property name="@host" type="symbol" default="localhost">
        <tr lang="en">hostname on which the VLC player is running</tr>
        <tr lang="ru">имя хоста на котором запущен VLC плеер</tr>
      </property>
      <!-- @pass -->
      <property name="@pass" type="atom" default="">
        <tr lang="en">password for accessing VLC over HTTP</tr>
        <tr lang="ru">пароль для доступа к VLC по http</tr>
      </property>
      <!-- @port -->
      <property name="@port" type="int" default="8080" minvalue="1" maxvalue="32768">
        <tr lang="en">network port number for VLC's HTTP control interface</tr>
        <tr lang="ru">номер сетевого порта для http интерфейса управления VLC</tr>
      </property>
    </properties>
    <methods>
      <!-- add -->
      <method name="add">
        <info>
          <tr lang="en">add URI to playlist</tr>
          <tr lang="ru">добавить URI в плейлист</tr>
        </info>
        <param name="URI" type="symbol" required="true">
          <tr lang="en">resource URI (file:// or http:// or camera://)</tr>
          <tr lang="ru">URI ресурса (file:// или http:// или camera://)</tr>
        </param>
      </method>
      <!-- add_dir -->
      <method name="add_dir">
        <info>
          <tr lang="en">add directory files to the playlist. If the file is already in the
          playlist, it will not be added.</tr>
          <tr lang="ru">добавить файлы директории в плейлист. Если файл уже в плейлисте, повторно
          он не добавляется.</tr>
        </info>
        <param name="DIR" type="symbol" required="true">
          <tr lang="en">the full path to the directory on the computer where VLC is running</tr>
          <tr lang="ru">полный путь к директории на компьютере, на котором запущен VLC</tr>
        </param>
        <param name="GLOB" type="symbol" required="true">
          <tr lang="en">match pattern for files. For example: *.wav - adds all files with the .wav
          extension.</tr>
          <tr lang="ru">шаблон соответствия для файлов. Например: *.wav - добавляет все файлы с
          расшиением wav.</tr>
        </param>
      </method>
      <!-- browse -->
      <method name="browse">
        <info>
          <tr lang="en">browse a list of files and folders in the specified directory on the host
          where the VLC player is running</tr>
          <tr lang="ru">выводит список файлов и папок в указанной директории на хосте, на котором
          запущен VLC плеер</tr>
        </info>
        <param name="DIR" type="symbol" required="true">
          <tr lang="en">the full path to the directory on the computer where VLC is running</tr>
          <tr lang="ru">полный путь к директории на компьютере, на котором запущен VLC</tr>
        </param>
        <param name="@dir" type="flag">
          <tr lang="en">list only subdirectories</tr>
          <tr lang="ru">выводить только под-директории</tr>
        </param>
        <param name="@file" type="flag">
          <tr lang="en">list only files</tr>
          <tr lang="ru">выводить только файлы</tr>
        </param>
        <param name="@glob" type="symbol">
          <tr lang="en">match pattern for files. For example: *.wav - shows all files with the .wav
          extension.</tr>
          <tr lang="ru">шаблон соответствия для файлов. Например: *.wav - выводит все файлы с
          расширением wav.</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">remove all items from the playlist</tr>
          <tr lang="ru">удалить все элементы из плейлиста</tr>
        </info>
      </method>
      <!-- delete -->
      <method name="delete">
        <info>
          <tr lang="en">delete item from playlist</tr>
          <tr lang="ru">удалить элемент из плейлиста</tr>
        </info>
        <param name="ID" type="int">
          <tr lang="en">Item ID in the playlist (NB: not the position in the playlist, but the
          unique index assigned when added)</tr>
          <tr lang="ru">ID элемента в плейлисте (NB: не позиция в плейлисте, а уникальный индес при
          добавлении)</tr>
        </param>
      </method>
      <!-- fs -->
      <method name="fs">
        <info>
          <tr lang="en">set or toggle VLC full-screen mode</tr>
          <tr lang="ru">устанавливает или переключает полноэкранный режим VLC</tr>
        </info>
        <param name="STATE" type="bool">
          <tr lang="en">If == 1, it switches to full-screen mode. If == 0, it exits full-screen
          mode. If the parameter is omitted, it toggles between the modes.</tr>
          <tr lang="ru">Если == 1, переводит в полноэкранный режим. Если == 0: выходит из
          полноэкранного режима. Если параметер не указан, переключает между режимами.</tr>
        </param>
      </method>
      <!-- get_playlist -->
      <method name="get_playlist">
        <info>
          <tr lang="en">request for the current playlist. Outputs as a message [playlist( into the
          second output.</tr>
          <tr lang="ru">запрос текущего плейлиста. Выводит в виде сообщения [playlist( во второй
          выход</tr>
        </info>
      </method>
      <!-- loop -->
      <method name="loop">
        <info>
          <tr lang="en">sets or toggles the repeat mode for the entire playlist</tr>
          <tr lang="ru">устанавливает или переключает режим повторного проигрывания всего
          плейлиста</tr>
        </info>
        <param name="STATE" type="bool">
          <tr lang="en">If == 1: turns on playlist repeat. If == 0: turns it off. If the parameter
          is omitted, it toggles between modes.</tr>
          <tr lang="ru">Если == 1: включает повтор плейлист. Если == 0: выключает. Если параметер
          не указан, переключает между режимами.</tr>
        </param>
      </method>
      <!-- next -->
      <method name="next">
        <info>
          <tr lang="en">go to the next entry on the playlist</tr>
          <tr lang="ru">перейти к следующей записи в плейлисте</tr>
        </info>
      </method>
      <!-- pause -->
      <method name="pause">
        <info>
          <tr lang="en">pause/resume playback</tr>
          <tr lang="ru">приостановить/возобновить воспроизведение</tr>
        </info>
        <param name="VAL" type="int" enum="0 1">
          <tr lang="en">If == 1: pause. If == 0: resume. If omitted: toggle between states</tr>
          <tr lang="ru">Если == 1: приостановить. Если == 0: возобновить. Если не указано:
          переключить между состояниями</tr>
        </param>
      </method>
      <!-- play -->
      <method name="play">
        <info>
          <tr lang="en">start playback</tr>
          <tr lang="ru">начать воспроизведение</tr>
        </info>
        <param name="ID" type="int">
          <tr lang="en">item ID in the playlist. If omitted, plays the current element</tr>
          <tr lang="ru">ID элемента в плейлисте. Если не указано, воспроизводит текущий
          элемент.</tr>
        </param>
      </method>
      <!-- prev -->
      <method name="prev">
        <info>
          <tr lang="en">go to the previous entry on the playlist</tr>
          <tr lang="ru">перейти к предыдущей записи в плейлисте</tr>
        </info>
      </method>
      <!-- seek -->
      <method name="seek">
        <info>
          <tr lang="en">jump to the specified playback position</tr>
          <tr lang="ru">перейти в указанную позицию времени воспроизведения</tr>
        </info>
        <param name="TIME" type="atom" required="true">
          <tr lang="en">absolute position in time (in integer seconds, percents or in the format
          00h:00m:00s) or relative offset (+val, -val)</tr>
          <tr lang="ru">абсолютная позиция во времени (в целых секундах, процентах или формате
          00h:00m:00s) или относительное смещение (+val, -val)</tr>
        </param>
      </method>
      <!-- status -->
      <method name="status">
        <info>
          <tr lang="en">request for the current VLC status. Output as a message [status( into the
          second output</tr>
          <tr lang="ru">запрос текущего статуса VLC. Вывод в виде сообщения [status( во второй
          выход</tr>
        </info>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stop playback</tr>
          <tr lang="ru">остановить воспроизведение</tr>
        </info>
      </method>
      <!-- volume -->
      <method name="volume">
        <info>
          <tr lang="en">set the playback volume</tr>
          <tr lang="ru">установить громкость воспроизведения</tr>
        </info>
        <param name="VAL" type="atom" required="true">
          <tr lang="en">absolute value in percent or relative change +VOL or -VOL</tr>
          <tr lang="ru">абсолютное значение в процентах или относительное изменение +VOL или
          -VOL</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input commands</tr>
          <tr lang="ru">входные команды</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">int: 1 on success, 0 on error</tr>
          <tr lang="ru" finished="false">Инт: 1 об успехе, 0 об ошибке</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">dict: response data</tr>
          <tr lang="ru" finished="false">ct: данные ответа</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[play #a(    [get_playlist #c( [next #d( [prev #e(

[stop #b(       [B]             [browse #f(
                |
 [T]            [openpanel]       [ui.tab @items 50% +5% -5% #h]
 |              |
[pause $1( [fs( [add file://$1(  [ui.tab @items 10 +5 -5 #i]
|          |    |
|          |    |               [ui.tab @items 00m:00s 01m:02s +00m:01s #j]
|          |    |               |
|          |    |               [seek $2 #g(
|          |    |               |
[proto.vlc localhost @pass 12345 #z]
|                      ^|
[T]                    [print]
[X a->z]
[X b->z]
[X c->z]
[X d->z]
[X e->z]
[X f->z]
[X h->g]
[X i->g]
#f %audio% @file @glob *.wav
#j @size 200 17
#i @size 100 17
#h @size 130 17
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
