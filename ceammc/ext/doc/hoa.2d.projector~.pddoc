<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="hoa.2d.projector~">
        <title>hoa.2d.projector~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
                <author>Pierre Guillot</author>
                <author>Eliott Paris</author>
                <author>Thomas Le Meur</author>
            </authors>
            <description>
                <tr lang="en">a plane waves decomposer from circular harmonics domain</tr>
                <tr lang="ru">декомпозиция из сферических гармоник в плоские волны</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>hoa recomposer projector</keywords>
            <since>0.8</since>
            <also>
                <see>hoa.2d.recomposer~</see>
            </also>
            <aliases>
                <alias>hoa.projector~</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Discretizes the ambisonic sound field into the plane waves
                domain.</tr>
                <!-- old: Дискретизирует амбисоническое звуковое поле в
                область плоских волн. -->
                <tr lang="ru" finished="false">Дискретизирует амбисоническое звуковое поле в
                область плоских волн.</tr>
            </par>
            <a href="hoa/hoa.2d.projector~-help.pd">CICM documentation</a>
        </info>
        <arguments>
            <argument name="ORDER" type="int" minvalue="1" maxvalue="63">
                <tr lang="en">the order of decomposition</tr>
                <tr lang="ru" finished="false">Порядок разложения</tr>
            </argument>
            <argument name="N" type="int" minvalue="1" maxvalue="63">
                <tr lang="en">number of channels</tr>
                <tr lang="ru" finished="false">Количество каналов</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @n -->
            <property name="@n" type="int" minvalue="0" maxvalue="63" default="0"
            access="initonly">
                <tr lang="en">number of channels (planewaves)</tr>
                <tr lang="ru" finished="false">Количество каналов (плановых волн)</tr>
            </property>
            <!-- @order -->
            <property name="@order" type="int" minvalue="1" maxvalue="63" default="1"
            access="initonly">
                <tr lang="en">the order of decomposition</tr>
                <tr lang="ru" finished="false">Порядок разложения</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input harmonic</tr>
                    <tr lang="ru" finished="false">входная гармоника</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>
                    <tr lang="en">... input harmonic</tr>
                    <tr lang="ru" finished="false">Входная гармоника</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="n">
                <xinfo>
                    <tr lang="en">n-th input harmonic</tr>
                    <tr lang="ru" finished="false">n-я входная гармоника</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">first plane wave output</tr>
                    <tr lang="ru" finished="false">Первая волна самолёта</tr>
                </out>
            </outlet>
            <outlet type="audio" number="...">
                <out type="any">
                    <tr lang="en">... plane wave output</tr>
                    <tr lang="ru" finished="false">Выходная волна самолета</tr>
                </out>
            </outlet>
            <outlet type="audio" number="n">
                <out type="any">
                    <tr lang="en">n-th plane wave output</tr>
                    <tr lang="ru" finished="false">n-й плоскости волновой выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[sig~ 1]              [lfo.saw~ 0.05]
|                     |
|                     [phase->rad~]
|                     |.
[hoa.2d.encoder~ 3 {w=30,o=7,i=2}]
*|*
[hoa.2d.projector~ 3 7 {w=30,i=7,o=7} #z]



[ui.m~ #a] [ui.m~ #b] [ui.m~ #c] [ui.m~ #d] [ui.m~ #e] [ui.m~ #f] [ui.m~ #g]

[X z:0->a]
[X z:1->b]
[X z:2->c]
[X z:3->d]
[X z:4->e]
[X z:5->f]
[X z:6->g]

[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
