<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="noise.baker">
    <title>noise.baker</title>
    <meta>
      <authors>
        <author>André Sier</author>
      </authors>
      <description>
        <tr lang="en">Baker map chaos generator</tr>
        <tr lang="ru">хаотический генератор на основе отображения пекаря</tr>
      </description>
      <license>%</license>
      <library>ceammc</library>
      <category>noise</category>
      <keywords>noise</keywords>
      <since>0.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Port of Richard's chaos-baker from the chaos collection</tr>
        <tr lang="ru">порт объекта chaos-baker Ричарда из коллекции chaos</tr>
      </par>
      <par>
        <tr lang="en">The baker's map is a chaotic map that stretches and folds the unit square, producing a random-looking sequence from a deterministic rule</tr>
        <tr lang="ru">отображение пекаря — хаотическое отображение, которое растягивает и складывает единичный квадрат, порождая внешне случайную последовательность из детерминированного правила</tr>
      </par>
      <par>
        <tr lang="en">the output value lies in the [0..1] range and is produced on bang</tr>
        <tr lang="ru">выходное значение лежит в диапазоне [0..1] и выдаётся по bang</tr>
      </par>
    </info>
    <arguments>
      <argument name="VALUE" type="float">
        <tr lang="en">initial value</tr>
        <tr lang="ru">начальное значение</tr>
      </argument>
    </arguments>
    <methods>
      <!-- cut -->
      <method name="cut">
        <param name="CUT" type="float" required="true">
          <tr lang="en">cut value [0..1]</tr>
          <tr lang="ru">значение разреза [0..1]</tr>
        </param>
      </method>
      <!-- fold -->
      <method name="fold">
        <param name="FOLD" type="float" required="true">
          <tr lang="en">fold value [0..1]</tr>
          <tr lang="ru">значение сгиба [0..1]</tr>
        </param>
      </method>
      <!-- fold_cut -->
      <method name="fold_cut">
        <param name="FOLD_CUT" type="int" required="true">
          <tr lang="en">enable fold / cut value action</tr>
          <tr lang="ru">включить действие сгиба/разреза</tr>
        </param>
      </method>
      <!-- om -->
      <method name="om">
        <param name="OM" type="int" required="true">
          <tr lang="en">enables output when cut or fold value is changed</tr>
          <tr lang="ru">включает вывод при изменении значения разреза или сгиба</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset state</tr>
          <tr lang="ru">сбросить состояние</tr>
        </info>
      </method>
      <!-- seed -->
      <method name="seed">
        <param name="SEED" type="float" required="true">
          <tr lang="en">seed value</tr>
          <tr lang="ru">начальное значение генератора</tr>
        </param>
      </method>
      <!-- set -->
      <method name="set">
        <param name="SET" type="float" required="true">
          <tr lang="en">set to value</tr>
          <tr lang="ru">установить значение</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output value</tr>
          <tr lang="ru">вывести значение</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">main outlet</tr>
          <tr lang="ru">основной выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[metro 50]
|                                   [ui.slider {o=1,w=100}] [ui.slider {o=1}]
|                                   |                       |
|                                   |                       |
|                                   |                       |
|                                   |                       |
|                                   |                       |
|                                   |                       |
|                                   |                       |
|                                   |                       |
|  [B]              [reset(         [set $1(                [seed $1(
|  |                |               |                       |
|  |                |               | [T]                   |   [T]
|  |                |               | |                     |   |
|  |                |               | [fold_cut $1(         |   [om $1(
|  |  [F]           |  [F]          | |                     |   |
|  |  |             |  |            | |                     |   |
|  |  [cut $1(      |  [fold $1(    | |                     |   |
|  |  |             |  |            | |                     |   |
[noise.baker 0.85                                                ]
|
[ui.display {i=1,o=0}]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
