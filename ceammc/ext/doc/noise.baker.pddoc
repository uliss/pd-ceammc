<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="noise.baker">
        <title>noise.baker</title>
        <meta>
            <authors>
                <author>André Sier</author>
            </authors>
            <description>
                <tr lang="en">Baker map chaos generator</tr>
                <tr lang="ru">хаотический генератор на основе преобразования Пекаря</tr>
            </description>
            <license>%</license>
            <library>ceammc</library>
            <category>noise</category>
            <keywords>noise</keywords>
            <since>0.5</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Port of Richard's chaos-baker from chaos collection</tr>
                <tr lang="ru" finished="false">Порт Ричарда - пекарь хаоса из коллекции хаоса</tr>
            </par>
        </info>
        <arguments>
            <argument name="VALUE" type="float">
                <tr lang="en">initial value</tr>
                <tr lang="ru" finished="false">начальное значение</tr>
            </argument>
        </arguments>
        <methods>
            <!-- cut -->
            <method name="cut">
                <param name="CUT" type="float" required="true">
                    <tr lang="en">cut value [0..1]</tr>
                    <tr lang="ru" finished="false">Сокращение [0,1]</tr>
                </param>
            </method>
            <!-- fold -->
            <method name="fold">
                <param name="FOLD" type="float" required="true">
                    <tr lang="en">fold value [0..1]</tr>
                    <tr lang="ru" finished="false">значение сгиба [0,1]</tr>
                </param>
            </method>
            <!-- fold_cut -->
            <method name="fold_cut">
                <param name="FOLD_CUT" type="int" required="true">
                    <tr lang="en">enable fold / cut value action</tr>
                    <!-- old: Позволяет сгибать / сокращать значение
                    действия -->
                    <tr lang="ru" finished="false">Позволяет сгибать / сокращать значение
                    действия</tr>
                </param>
            </method>
            <!-- om -->
            <method name="om">
                <param name="OM" type="int" required="true">
                    <tr lang="en">enables output when cut or fold value is changed</tr>
                    <!-- old: позволяет вывод при изменении значения разреза
                    или сгиба -->
                    <tr lang="ru" finished="false">позволяет вывод при изменении значения разреза
                    или сгиба</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset state</tr>
                    <tr lang="ru" finished="false">состояние сброса</tr>
                </info>
            </method>
            <!-- seed -->
            <method name="seed">
                <param name="SEED" type="float" required="true">
                    <tr lang="en">seed value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- set -->
            <method name="set">
                <param name="SET" type="float" required="true">
                    <tr lang="en">set to value</tr>
                    <tr lang="ru" finished="false">установить ценность</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output value</tr>
                    <tr lang="ru" finished="false">выходная стоимость</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">main outlet</tr>
                    <tr lang="ru" finished="false">главный выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 50]
|                                   [ui.slider {o=1,w=100}] [ui.slider {o=1}]
|                                   |                       |
|                                   |                       |
|                                   |                       |
|                                   |                       |
|                                   |                       |
|                                   |                       |
|                                   |                       |
|                                   |                       |
|  [B]              [reset(         [set $1(                [seed $1(  
|  |                |               |                       |
|  |                |               | [T]                   |   [T]
|  |                |               | |                     |   |  
|  |                |               | [fold_cut $1(         |   [om $1(
|  |  [F]           |  [F]          | |                     |   |
|  |  |             |  |            | |                     |   |
|  |  [cut $1(      |  [fold $1(    | |                     |   |
|  |  |             |  |            | |                     |   |
[noise.baker 0.85                                                ]
|
[ui.display {i=1,o=0}]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
