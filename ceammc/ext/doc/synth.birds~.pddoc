<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="synth.birds~">
        <title>synth.birds~</title>
        <meta>
            <authors>
                <author>Pierre Cochard</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">bird singing generator</tr>
                <tr lang="ru" finished="false">генератор пения птиц</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>birds</keywords>
            <since>0.6</since>
        </meta>
        <arguments>
            <argument name="SPEED" type="float" minvalue="120" maxvalue="480">maximum speed of
            whistles if @auto enabled</argument>
            <argument name="PROBABILITY" type="float" minvalue="25" maxvalue="100" units="percent">
            whistles probability if @auto enabled</argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1">on/off dsp processing</property>
            <!-- @auto -->
            <property name="@auto" type="bool" default="0">auto playing mode</property>
            <!-- @gate -->
            <property name="@gate" type="bool" default="0">play trigger. Starts playing on
            release</property>
            <!-- @probability -->
            <property name="@probability" type="float" minvalue="25" maxvalue="100" default="50"
            units="percent">whistles probability if @auto enabled</property>
            <!-- @speed -->
            <property name="@speed" type="float" minvalue="120" maxvalue="480" default="240">
            maximum speed of whistles if @auto enabled</property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">play</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">synth left channel</outlet>
            <outlet type="audio">synth right channel</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[gsynth.birds~   {i=2,o=2}]
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
[fx.zita_rev1~]   [ui.dsp~]
*|*
[ui.hgain2~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
