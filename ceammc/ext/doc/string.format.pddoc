<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="string.format">
        <title>string.format</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">formats a string like printf function</tr>
                <tr lang="ru">форматирует строку в стиле функции printf</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>string</category>
            <keywords>string format</keywords>
            <since>0.3</since>
            <aliases>
                <alias>str.format</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">This format modifiers are supported: %d, %u, %i, %o, %x, %X, %s, %e,
                %E.</tr>
                <tr lang="ru" finished="false">Поддерживаются модификаторы формата: %d, %u, %i, %o,
                %x, %X, %s, %e, %E.</tr>
            </par>
        </info>
        <arguments>
            <argument name="FORMAT" type="list">
                <tr lang="en">format string</tr>
                <tr lang="ru" finished="false">Форматная строка</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @format -->
            <property name="@format" type="list" default="">
                <tr lang="en">format string</tr>
                <tr lang="ru" finished="false">Форматная строка</tr>
            </property>
            <!-- @int -->
            <property name="@int" type="flag" default="0" access="initonly">
                <tr lang="en">flag for integer mode. If specified all floats are converted to
                integers. This usefull for hex and octal formatting</tr>
                <tr lang="ru" finished="false">Флаг для целочисленного режима. Если указано, все
                поплавки преобразуются в целые числа. Это полезно для шестнадцатеричного и
                октального форматирования</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">float format argument</tr>
                    <tr lang="ru" finished="false">Аргументация формата Float</tr>
                </in>
                <in on="symbol">
                    <tr lang="en">float format argument</tr>
                    <tr lang="ru" finished="false">Аргументация формата Float</tr>
                </in>
                <in on="list">
                    <tr lang="en">format arguments (if many)</tr>
                    <tr lang="ru" finished="false">Аргументы формата (если их много)</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output string</tr>
                    <tr lang="ru" finished="false">выходная строка</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]  [@format %+02d(
|    |
|    |
[string.format "%08.2f"]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
