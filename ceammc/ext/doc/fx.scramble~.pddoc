<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="fx.scramble~">
        <title>fx.scramble~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">scramble delayed sound fragments</tr>
                <tr lang="ru">скремблер задержанных звуковых фрагментов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx echo delay</keywords>
            <since>0.9.7</since>
            <also>
                <see>fx.delay~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ1" type="float" minvalue="0.25" maxvalue="50" units="hertz">
                <tr lang="en">left channel scramble frequency</tr>
                <tr lang="ru" finished="false">частота скремблирования левого канала</tr>
            </argument>
            <argument name="FREQ2" type="float" minvalue="0.25" maxvalue="50" units="hertz">
                <tr lang="en">right channel scramble frequency</tr>
                <tr lang="ru" finished="false">частота скремблирования правого канала</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
                <!-- old: Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал. -->
                <tr lang="ru" finished="false">Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал.</tr>
            </property>
            <!-- @dev -->
            <property name="@dev" type="float" minvalue="0" maxvalue="1" default="0.25">
                <tr lang="en">scramble freq deviation</tr>
                <tr lang="ru" finished="false">Отклонение freq</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet</tr>
                <!-- old: пропорция смеси между исходными (сухими) и
                "влажными" сигналами. 0 - сухой сигнал, 1 - влажный -->
                <tr lang="ru" finished="false">пропорция смеси между исходными (сухими) и
                "влажными" сигналами. 0 - сухой сигнал, 1 - влажный</tr>
            </property>
            <!-- @feedback -->
            <property name="@feedback" type="float" minvalue="0" maxvalue="0.99" default="0.25">
                <tr lang="en">feedback coefficient</tr>
                <tr lang="ru" finished="false">коэффициент обратной связи</tr>
            </property>
            <!-- @freq1 -->
            <property name="@freq1" type="float" minvalue="0.25" maxvalue="50" units="hertz"
            default="7">
                <tr lang="en">left channel scramble frequency</tr>
                <tr lang="ru" finished="false">частота скремблирования левого канала</tr>
            </property>
            <!-- @freq2 -->
            <property name="@freq2" type="float" minvalue="0.25" maxvalue="50" units="hertz"
            default="5">
                <tr lang="en">right channel scramble frequency</tr>
                <tr lang="ru" finished="false">частота скремблирования правого канала</tr>
            </property>
            <!-- @range -->
            <property name="@range" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">scramble delay amount</tr>
                <tr lang="ru" finished="false">Сумма задержки Scramble</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                    <tr lang="ru" finished="false">Перезагрузка в начальное состояние</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">left output signal</tr>
                    <tr lang="ru" finished="false">левый выходной сигнал</tr>
                </out>
            </outlet>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">right output signal</tr>
                    <tr lang="ru" finished="false">правильный выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env]
|
[readsf~]
|
[fx.scramble~]
*|*
[ui.gain2~ @size 120 16]  [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
