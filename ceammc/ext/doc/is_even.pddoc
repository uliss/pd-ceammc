<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="is_even">
        <title>is_even</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">even number check</tr>
                <tr lang="ru">проверка входного числа на чётность</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>predicates</category>
            <keywords>predicate numbers</keywords>
            <also>
                <see>is_odd</see>
            </also>
            <since>0.1</since>
        </meta>
        <inlets>
            <inlet>
                <in on="int">
                    <tr lang="en">outputs '1' if number can be divided exactly by 2, otherwise
                    '0'</tr>
                    <!-- old: выходы 1, если число можно разделить ровно на 2,
                    в противном случае 0 -->
                    <tr lang="ru" finished="false">выходы 1, если число можно разделить ровно на 2,
                    в противном случае 0</tr>
                </in>
                <in on="float">
                    <tr lang="en">first value converted to integer, then the check is
                    performed</tr>
                    <!-- old: сначала значение преобразуется в целое число,
                    затем выполняется проверка -->
                    <tr lang="ru" finished="false">сначала значение преобразуется в целое число,
                    затем выполняется проверка</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">0 or 1</tr>
                    <tr lang="ru" finished="false">0 или 1</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">passed even numbers</tr>
                    <tr lang="ru" finished="false">Пропущенные четные числа</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[is_even     ]
|    ^|
[_]  [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
