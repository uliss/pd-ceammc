<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="prop.get">
    <title>prop.get</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">get the property value from the connected object, subpatch or
        abstraction</tr>
        <tr lang="ru">получает значение свойства от подключённого объекта, субпатча или
        абстракции</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>property</category>
      <keywords>property</keywords>
      <since>0.9</since>
      <aliases>
        <alias>p.get</alias>
      </aliases>
      <also>
        <see>prop&lt;-</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object reads properties from the object, subpatch or abstraction
        connected to its first outlet</tr>
        <tr lang="ru">объект читает свойства у объекта, субпатча или абстракции, подключённых к его
        первому выходу</tr>
      </par>
      <par>
        <tr lang="en">the PROPS argument or the list sent to the inlet sets the names of the
        requested properties, the values are output from the corresponding outlets</tr>
        <tr lang="ru">аргумент PROPS или список, поданный на вход, задаёт имена запрашиваемых
        свойств, значения выводятся с соответствующих выходов</tr>
      </par>
      <par>
        <tr lang="en">on bang, all requested properties are output at once. When a single property
        name is sent, only that property is output to the second outlet</tr>
        <tr lang="ru">по bang все запрошенные свойства выводятся сразу. При подаче одного имени
        свойства только это свойство выводится на второй выход</tr>
      </par>
      <par>
        <tr lang="en">a left-click on the object gets the properties, which is convenient for quick
        inspection during patching</tr>
        <tr lang="ru">левый клик по объекту запрашивает свойства, что удобно для быстрой проверки
        во время патчинга</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">get properties</event>
    </mouse>
    <arguments>
      <argument name="PROPS" type="list">
        <tr lang="en">property names</tr>
        <tr lang="ru">имена свойств</tr>
      </argument>
    </arguments>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output the specified properties to the corresponding outlets</tr>
          <tr lang="ru">вывести указанные свойства на соответствующие выходы</tr>
        </in>
        <in on="any">
          <tr lang="en">output the specified property to the second outlet</tr>
          <tr lang="ru">вывести указанное свойство на второй выход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="any">
          <tr lang="en">connected to the destination object</tr>
          <tr lang="ru">подключён к объекту назначения</tr>
        </out>
      </outlet>
      <outlet number="2">
        <out type="any">
          <tr lang="en">output of the first requested property</tr>
          <tr lang="ru">выход первого запрошенного свойства</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="any">
          <tr lang="en">output of the ... requested property</tr>
          <tr lang="ru">выход ... запрошенного свойства</tr>
        </out>
      </outlet>
      <outlet number="n+1">
        <out type="any">
          <tr lang="en">output of the n-th requested property</tr>
          <tr lang="ru">выход N-го запрошенного свойства</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang(
|
[prop.get @size @value]
|          ^|   ^^|
|          |      [ui.dt]
|          |
[ui.knob]  [ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
