<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="prop.get">
        <title>prop.get</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">get the property value from connected object, subpatch or
                abstraction</tr>
                <tr lang="ru">получить значение свойства от подсоединённого объекта, субпатча или
                абстракции</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>property</category>
            <keywords>property</keywords>
            <since>0.9</since>
            <aliases>
                <alias>p.get</alias>
            </aliases>
            <also>
                <see>prop&lt;-</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Get properties from connected object/subpatch/abstraction</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">get properties</event>
        </mouse>
        <arguments>
            <argument name="PROPS" type="list">
                <tr lang="en">property names</tr>
            </argument>
        </arguments>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output specified properites to corresponding outlets</tr>
                </xinfo>
                <xinfo on="any">
                    <tr lang="en">output specified property to second outlet</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="any">
                    <tr lang="en">connected to destination object</tr>
                </out>
            </outlet>
            <outlet number="2">
                <out type="any">
                    <tr lang="en">output of first requested property</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">output of ... requested property</tr>
                </out>
            </outlet>
            <outlet number="n+1">
                <out type="any">
                    <tr lang="en">output of n-th requested property</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(
|
[prop.get @size @value]
|          ^|   ^^|
|          |      [ui.dt]
|          |
[ui.knob]  [ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
