<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="list.remove">
        <title>list.remove</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">remove list elements at specified positions</tr>
                <tr lang="ru">удалить элементы списка по указанным позициям</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list remove</keywords>
            <since>0.6</since>
            <also>
                <see>list.insert</see>
            </also>
        </meta>
        <arguments>
            <argument name="INDEXES" type="list">
                <tr lang="en">list of indexes to remove. Negative indexes are also supported</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @indexes -->
            <property name="@indexes" type="list" default="">
                <tr lang="en">indexes to remove</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">set remove indexes</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output list</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 4 5 6(      [\(a b c d e\), bang(
|                  |
|  [list A B C D(  [ml]
|  |               |
|  |           [F] |
|  |           |.  |
[list.remove 0 -1  ]
|
[ui.display @display_type 1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
