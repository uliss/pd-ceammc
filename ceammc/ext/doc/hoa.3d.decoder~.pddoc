<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="hoa.3d.decoder~">
        <title>hoa.3d.decoder~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
                <author>Pierre Guillot</author>
                <author>Eliott Paris</author>
                <author>Thomas Le Meur</author>
            </authors>
            <description>
                <tr lang="en">3D decoder of higher order ambisonics</tr>
                <tr lang="ru">трехмерный декодер амбисоников высоких порядков</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>hoa decoder</keywords>
            <since>0.9.7</since>
            <also>
                <see>hoa.3d.encoder~</see>
                <see>hoa.2d.decoder~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Decodes an ambisonics soundfield for several loudspeakers
                configuration or for headphones.</tr>
            </par>
            <a href="hoa/hoa.3d.decoder~-help.pd">CICM documentation</a>
        </info>
        <arguments>
            <argument name="ORDER" type="int" minvalue="1" maxvalue="10">
                <tr lang="en">the order of decomposition</tr>
            </argument>
            <argument name="MODE" type="symbol" enum="binaural regular">
                <tr lang="en">decoding mode</tr>
            </argument>
            <argument name="NCH" type="int">
                <tr lang="en">number of loud speakers</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @angles -->
            <property name="@angles" type="list" units="degree"
            default="0 90 0 340.5288 120 340.5288 240 340.5288">
                <tr lang="en">angles of loudspeakers.</tr>
            </property>
            <!-- @binaural -->
            <property name="@binaural" type="alias">
                <tr lang="en">alias for @mode binaural</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" default="regular" enum="regular binaural">
                <tr lang="en">decoding mode</tr>
            </property>
            <!-- @nch -->
            <property name="@nch" type="int" minvalue="1" access="initonly" default="0">
                <tr lang="en">number of plain waves.</tr>
            </property>
            <!-- @nharm -->
            <property name="@nharm" type="int" minvalue="1" access="readonly" default="4">
                <tr lang="en">number of circular harmonics.</tr>
            </property>
            <!-- @offset -->
            <property name="@offset" type="list" units="degree" default="0 0 0">
                <tr lang="en">rotation of loudspeakers. Only available for @regular and @irregular
                mode.</tr>
            </property>
            <!-- @order -->
            <property name="@order" type="int" minvalue="1" maxvalue="10" default="1"
            access="initonly">
                <tr lang="en">the order of decomposition</tr>
            </property>
            <!-- @pw_x -->
            <property name="@pw_x" type="list" units="radian" minvalue="-1" maxvalue="1"
            access="readonly" default="0.0 -0.0 -0.8165 0.8165">
                <tr lang="en">list of plain wave x-coordinates (abscissas). -1 is the left of the
                soundfield, 0 is the center of the soundfield and 1 is the right of the
                soundfield.</tr>
            </property>
            <!-- @pw_y -->
            <property name="@pw_y" type="list" units="radian" minvalue="-1" maxvalue="1"
            access="readonly" default="-0.0 0.9428 -0.4714 -0.4714">
                <tr lang="en">list of plain wave y-coordinates (ordinatas). -1 is the back of the
                soundfield, 0 is the center of the soundfield and 1 is the front of the
                soundfield.</tr>
            </property>
            <!-- @pw_z -->
            <property name="@pw_z" type="list" units="radian" minvalue="-1" maxvalue="1"
            access="readonly" default="1 -0.3333 -0.3333 -0.3333">
                <tr lang="en">list of plain wave z-coordinates (heights). -1 is the bottom of the
                soundfield, 0 is the center of the soundfield and 1 is the top of the
                soundfield.</tr>
            </property>
            <!-- @regular -->
            <property name="@regular" type="alias">
                <tr lang="en">alias for @mode regular</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet type="audio">
                <xinfo>first input harmonic</xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>... input harmonic</xinfo>
            </inlet>
            <inlet type="audio" number="n">
                <xinfo>n-th input harmonic</xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio">first loudspeaker output</outlet>
            <outlet type="audio" number="...">... loudspeaker output</outlet>
            <outlet type="audio" number="n">n-th loudspeaker output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[hoa/hoa.soundgrain]               [lfo.saw~ 0.15]
|                                  |
[ui.gain~ @size 120 14]            [phase->rad~]
|                              .___/ |
[hoa.3d.encoder~ 3 {w=36,i=3,o=16}]  [ui.n~]
*|*
[hoa.3d.decoder~ 3 binaural {w=36,i=16,o=2}]
*|*
[xdac~ 1:2 {w=36,i=2}]

[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
