<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="string.equal">
        <title>string.equal</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">check strings or symbols for equality</tr>
                <tr lang="ru">проверка строк или символов на равенство</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>string</category>
            <keywords>compare equal</keywords>
            <since>0.3</since>
            <aliases>
                <alias>str.equal</alias>
            </aliases>
            <also>
                <see>string</see>
            </also>
        </meta>
        <arguments>
            <argument name="SUBJ" type="symbol">
                <tr lang="en">second string initial value</tr>
                <tr lang="ru" finished="false">вторая строка начальное значение</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @subj -->
            <property name="@subj" type="symbol" default="">
                <tr lang="en">string to compare</tr>
                <tr lang="ru" finished="false">Струна для сравнения</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="data:string">
                    <tr lang="en">do compare</tr>
                    <tr lang="ru" finished="false">сравнивать</tr>
                </in>
                <in on="symbol">
                    <tr lang="en">do compare</tr>
                    <tr lang="ru" finished="false">сравнивать</tr>
                </in>
            </inlet>
            <inlet>
                <in on="data:string">
                    <tr lang="en">set compare subject</tr>
                    <tr lang="ru" finished="false">Сравнительная тема</tr>
                </in>
                <in on="symbol">
                    <tr lang="en">set compare subject</tr>
                    <tr lang="ru" finished="false">Сравнительная тема</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">outputs 1 if strings are equal, otherwise 0</tr>
                    <tr lang="ru" finished="false">выходы 1 если строки равны, в противном случае
                    0</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[string Chuck] [symbol Chuck?(
|              |
[string.equal Chuck]
|
[T]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
