<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="dyn.comp_up~">
    <title>dyn.comp_up~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">mono upward compressor</tr>
        <tr lang="ru">восходящий моно-компрессор</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>dyn</category>
      <keywords>compressor</keywords>
      <since>0.9.7</since>
      <also>
        <see>dyn.comp_peak~</see>
      </also>
      <aliases>
        <alias>comp.up~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">A mono upward compressor. Unlike a regular (downward) compressor, which
        reduces the level of loud signals, an upward compressor increases the level of quiet
        signals, effectively raising their dynamics toward the threshold. Instead of the
        traditional "ratio" control, it uses a strength parameter, which makes it easy to use the
        object as a gentle upward compressor or as a hard expander.</tr>
        <tr lang="ru">Монофонический восходящий компрессор. В отличие от обычного (нисходящего)
        компрессора, который снижает уровень громких сигналов, восходящий компрессор повышает
        уровень тихих сигналов, тем самым приближая их динамику к порогу. Вместо традиционного
        управления «ratio» (степень сжатия) используется параметр силы (strength), что позволяет
        применять объект и как мягкий восходящий компрессор, и как жёсткий экспандер.</tr>
      </par>
      <a href="https://en.wikipedia.org/wiki/Dynamic_range_compression">Dynamic range
      compression</a>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Adding sustain to percussive or plucked sounds — extending the audible
        portion of short percussive hits, plucked strings or drum samples by lifting the decaying
        tails.</tr>
        <tr lang="ru">• Удлинение сустейна перкуссионных и щипковых звуков — продление слышимой
        части коротких перкуссионных ударов, щипковых струн или барабанных сэмплов путём подъёма
        затухающих хвостов.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Ambient and drone textures — raising the level of very quiet background
        layers, room tone or subtle resonances, so that they become audible without affecting the
        loud foreground material.</tr>
        <tr lang="ru">• Эмбиент и дроун-текстуры — подъём уровня очень тихих фоновых слоёв, шума
        помещения или тонких резонансов, чтобы они стали слышимыми, не влияя на громкий основной
        материал.</tr>
      </par>
    </info>
    <arguments>
      <argument name="STRENGTH" type="float" minvalue="0" maxvalue="1">
        <tr lang="en">compression strength (0: no compression, 1: increase level by @range dB)</tr>
        <tr lang="ru">сила компрессии (0 — без компрессии, 1 — повышение уровня на @range дБ)</tr>
      </argument>
      <argument name="THRESHOLD" type="float" minvalue="-60" maxvalue="0" units="decibel">
        <tr lang="en">level threshold below which compression kicks in</tr>
        <tr lang="ru">пороговый уровень, ниже которого начинается компрессия</tr>
      </argument>
      <argument name="ATTACK" type="float" units="millisecond" minvalue="0.1" maxvalue="100">
        <tr lang="en">attack time — time constant for the attack phase (level rising)</tr>
        <tr lang="ru">время атаки — постоянная времени для фазы атаки (уровень растёт)</tr>
      </argument>
      <argument name="RELEASE" type="float" units="millisecond" minvalue="1" maxvalue="500">
        <tr lang="en">release time — time constant for coming out of compression</tr>
        <tr lang="ru">время восстановления — постоянная времени выхода из компрессии</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @attack -->
      <property name="@attack" type="float" units="millisecond" default="10" minvalue="0.1"
      maxvalue="100">
        <tr lang="en">time constant for the attack phase (level rising)</tr>
        <tr lang="ru">постоянная времени для фазы атаки (уровень растёт)</tr>
      </property>
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true — the input signal is passed through unchanged, without
        compression</tr>
        <tr lang="ru">флаг обхода. Если истина — входной сигнал проходит без обработки, минуя
        компрессию</tr>
      </property>
      <!-- @hold -->
      <property name="@hold" type="float" units="sample" default="128" minvalue="1" maxvalue="255">
        <tr lang="en">hold period</tr>
        <tr lang="ru">период удержания</tr>
      </property>
      <!-- @knee -->
      <property name="@knee" type="float" units="decibel" default="3" minvalue="0" maxvalue="6">
        <tr lang="en">a gradual increase in gain reduction around the threshold: below thresh −
        (knee / 2) there is no gain reduction, above thresh + (knee / 2) the gain reduction is the
        same as without a knee, and in between there is a gradual increase in gain reduction</tr>
        <tr lang="ru">плавное увеличение снижения усиления вблизи порога: ниже thresh − (knee / 2)
        снижения усиления нет, выше thresh + (knee / 2) снижение усиления такое же, как и без knee,
        а между ними происходит плавное увеличение снижения усиления</tr>
      </property>
      <!-- @level -->
      <property name="@level" type="float" units="decibel" default="0" minvalue="0" maxvalue="90"
      access="readonly">
        <tr lang="en">current level of compression, in dB</tr>
        <tr lang="ru">текущий уровень компрессии в дБ</tr>
      </property>
      <!-- @range -->
      <property name="@range" type="float" units="decibel" default="32" minvalue="0" maxvalue="32">
        <tr lang="en">max upward compression range</tr>
        <tr lang="ru">максимальный диапазон восходящей компрессии</tr>
      </property>
      <!-- @refresh -->
      <property name="@refresh" type="int" default="100" minvalue="0" maxvalue="1000"
      units="millisecond">
        <tr lang="en">compression level output time interval. If 0 — no output</tr>
        <tr lang="ru">интервал вывода уровня компрессии. Если 0 — вывод не производится</tr>
      </property>
      <!-- @release -->
      <property name="@release" type="float" units="millisecond" default="50" minvalue="1"
      maxvalue="500">
        <tr lang="en">release time — time constant for coming out of compression</tr>
        <tr lang="ru">время восстановления — постоянная времени выхода из компрессии</tr>
      </property>
      <!-- @strength -->
      <property name="@strength" type="float" default="0" minvalue="0" maxvalue="1">
        <tr lang="en">compression strength (0: no compression, 1: increase level by @range dB)</tr>
        <tr lang="ru">сила компрессии (0 — без компрессии, 1 — повышение уровня на @range дБ)</tr>
      </property>
      <!-- @threshold -->
      <property name="@threshold" type="float" units="decibel" default="-32" minvalue="-60"
      maxvalue="0">
        <tr lang="en">level threshold below which compression kicks in (100 dB = max level)</tr>
        <tr lang="ru">пороговый уровень, ниже которого начинается компрессия (100 дБ — максимальный
        уровень)</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the object to its initial state</tr>
          <tr lang="ru">возвращает объект в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set compression strength</tr>
          <tr lang="ru">задать силу компрессии</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output compressed signal</tr>
          <tr lang="ru">выходной сжатый сигнал</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">float: current compression level in dB</tr>
          <tr lang="ru">число: текущий уровень компрессии в дБ</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.hsl #a]              [ui.dsp~]
|
[dbfs->amp]
|
[sig~]  [ui.hsl #a]
|       |
|       |
|       [@threshold $1(  [ui.knob @label STRENGTH @show_value 1]
|       |                |
|       |                |.
[dyn.comp_up~ 0 -60 10 100]
|                     ^|
[env~]                [ui.hsl 0 32 @active_scale 1 @show_value 1]
|
[- 100]
|
[F]

#a -60 0 @show_value 1
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
