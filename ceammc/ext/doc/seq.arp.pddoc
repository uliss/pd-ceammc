<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="seq.arp">
    <title>seq.arp</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">chord arpeggiator</tr>
        <tr lang="ru">арпеджиатор аккордов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>seq</category>
      <keywords>seq arpeggio pattern</keywords>
      <since>0.9.1</since>
      <also>
        <see>seq.b</see>
        <see>seq.t</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object arpeggiates a chord by turning notes on and off step by step, producing a pitch and velocity pair on each step</tr>
        <tr lang="ru">объект арпеджирует аккорд, включая и выключая ноты шаг за шагом, и выдаёт на каждом шаге пару нота и скорость</tr>
      </par>
      <par>
        <tr lang="en">the *asr* method sets the arpeggio mode and runs it, *on* and *off* control the active notes manually</tr>
        <tr lang="ru">метод *asr* задаёт режим арпеджио и запускает его, методы *on* и *off* управляют активными нотами вручную</tr>
      </par>
      <par>
        <tr lang="en">the second outlet outputs the number of currently active notes</tr>
        <tr lang="ru">второй выход выдаёт количество активных в данный момент нот</tr>
      </par>
    </info>
    <arguments>
      <argument name="CHORD" type="list">
        <tr lang="en">list of pitches to arpeggiate</tr>
        <tr lang="ru">список нот для арпеджирования</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @chord -->
      <property name="@chord" type="list" default="">
        <tr lang="en">list of pitches to arpeggiate</tr>
        <tr lang="ru">список нот для арпеджирования</tr>
      </property>
    </properties>
    <methods>
      <!-- asr -->
      <method name="asr">
        <info>
          <tr lang="en">set arpeggio mode and run</tr>
          <tr lang="ru">задать режим арпеджио и запустить</tr>
        </info>
        <param name="STEP" type="float" minvalue="0" units="millisecond" required="true">
          <tr lang="en">step duration</tr>
          <tr lang="ru">длительность шага</tr>
        </param>
        <param name="ON_MODE" type="symbol" enum="all first last random" required="true">
          <tr lang="en">on mode</tr>
          <tr lang="ru">режим включения</tr>
        </param>
        <param name="HOLD" type="int" minvalue="1" required="true">
          <tr lang="en">number of steps to hold value</tr>
          <tr lang="ru">количество шагов удержания значения</tr>
        </param>
        <param name="OFF_MODE" type="symbol" enum="all first last random" required="true">
          <tr lang="en">off mode</tr>
          <tr lang="ru">режим выключения</tr>
        </param>
      </method>
      <!-- off -->
      <method name="off">
        <info>
          <tr lang="en">turn off active notes</tr>
          <tr lang="ru">выключить активные ноты</tr>
        </info>
        <param name="MODE" type="symbol" enum="first last all random">
          <tr lang="en">if =first turn off the first active note in the chord list, if =last turn off the last inactive note in the chord list, if =all turn off all active notes</tr>
          <tr lang="ru">если =first выключить первую активную ноту в списке аккорда, если =last выключить последнюю неактивную ноту в списке аккорда, если =all выключить все активные ноты</tr>
        </param>
        <param name="NUM" type="int" minvalue="1" default="1">
          <tr lang="en">number of notes to turn on</tr>
          <tr lang="ru">количество нот для включения</tr>
        </param>
      </method>
      <!-- on -->
      <method name="on">
        <info>
          <tr lang="en">turn on inactive notes</tr>
          <tr lang="ru">включить неактивные ноты</tr>
        </info>
        <param name="MODE" type="symbol" enum="first last all random">
          <tr lang="en">if =first play the first inactive note in the chord list, if =last play the last inactive note in the chord list, if =all play all inactive notes</tr>
          <tr lang="ru">если =first играть первую неактивную ноту в списке аккорда, если =last играть последнюю неактивную ноту в списке аккорда, если =all играть все неактивные ноты</tr>
        </param>
        <param name="VEL" type="float" minvalue="1" maxvalue="127" default="127">
          <tr lang="en">note velocity</tr>
          <tr lang="ru">сила нажатия ноты</tr>
        </param>
        <param name="NUM" type="int" minvalue="1" default="1">
          <tr lang="en">number of notes to turn on</tr>
          <tr lang="ru">количество нот для включения</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset all notes to off without output</tr>
          <tr lang="ru">сбросить все ноты в выключенное состояние без вывода</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">play one note in sequence (same as the [on( message)</tr>
          <tr lang="ru">играть одну ноту в последовательности (то же, что сообщение [on()</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">pitch vel</tr>
          <tr lang="ru">нота сила_нажатия</tr>
        </out>
      </outlet>
      <outlet>
        <out type="float">
          <tr lang="en">number of active notes</tr>
          <tr lang="ru">количество активных нот</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[asr 500 first 2 all #a(     /*start from first, off all at once*/

 [asr 500 last 2 all #b(     /*start from last, off all at once*/

  [asr 500 last 2 last #c(   /*start from last, off from last*/

   [asr 500 all 2 last #d(   /*start from all, off from last*/

    [asr 500 all 2 first #e( /*start from all, off from first*/

     [asr 500 all 4 all #f(  /*start from all, hold 4 beat, off all*/

 [reset(
 |
[seq.arp 60 64 67 72 76 #x]
| |
| [print]
|
[msg note]
|
[fluid~]        [ui.dsp~]
*|*
[ui.hgain2~]
|\
[dac~]
[X a->x] [X b->x] [X c->x] [X d->x] [X e->x] [X f->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
