<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="seq.arp">
        <title>seq.arp</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">chord arpeggiator</tr>
                <tr lang="ru">арпеджиатор аккордов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>seq</category>
            <keywords>seq arpeggio pattern</keywords>
            <since>0.9.1</since>
            <also>
                <see>seq.b</see>
                <see>seq.t</see>
            </also>
        </meta>
        <arguments>
            <argument name="CHORD" type="list">
                <tr lang="en">list of pitches to arpeggiate</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @chord -->
            <property name="@chord" type="list" default="">
                <tr lang="en">list of pitches to arpeggiate</tr>
            </property>
        </properties>
        <methods>
            <!-- asr -->
            <method name="asr">
                <info>
                    <tr lang="en">set arpeggiate mode and run</tr>
                </info>
                <param name="STEP" type="float" minvalue="0" units="millisecond" required="true">
                    <tr lang="en">step duration</tr>
                </param>
                <param name="ON_MODE" type="symbol" enum="all first last random" required="true">
                    <tr lang="en">on mode</tr>
                </param>
                <param name="HOLD" type="int" minvalue="1" required="true">
                    <tr lang="en">number of steps to hold value</tr>
                </param>
                <param name="OFF_MODE" type="symbol" enum="all first last random" required="true">
                    <tr lang="en">off mode</tr>
                </param>
            </method>
            <!-- off -->
            <method name="off">
                <info>
                    <tr lang="en">turn off active notes.</tr>
                </info>
                <param name="MODE" type="symbol" enum="first last all random">
                    <tr lang="en">if =first turn off first active note in chord list, if =last turn
                    off last inactive note in chord list, if =all turn off all active notes</tr>
                </param>
                <param name="NUM" type="int" minvalue="1" default="1">
                    <tr lang="en">number of notes to turn on</tr>
                </param>
            </method>
            <!-- on -->
            <method name="on">
                <info>
                    <tr lang="en">turn on inactive notes</tr>
                </info>
                <param name="MODE" type="symbol" enum="first last all random">
                    <tr lang="en">if =first play first inactive note in chord list, if =last play
                    last inactive note in chord list, if =all play all inactive notes</tr>
                </param>
                <param name="VEL" type="float" minvalue="1" maxvalue="127" default="127">
                    <tr lang="en">note velocity</tr>
                </param>
                <param name="NUM" type="int" minvalue="1" default="1">
                    <tr lang="en">number of notes to turn on</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset all notes to off without output</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">play one note in sequence (same as [on( message)</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list: pitch vel</outlet>
            <outlet>float: number of active notes</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[asr 500 first 2 all #a(     /*start from first, off all at once*/

 [asr 500 last 2 all #b(     /*start from last, off all at once*/

  [asr 500 last 2 last #c(   /*start from last, off from last*/

   [asr 500 all 2 last #d(   /*start from all, off from last*/

    [asr 500 all 2 first #e( /*start from all, off from first*/

     [asr 500 all 4 all #f(  /*start from all, hold 4 beat, off all*/

 [reset(
 |
[seq.arp 60 64 67 72 76 #x]
| |
| [print]
|
[msg note]
|
[fluid~]        [ui.dsp~]
*|*
[ui.hgain2~]
|\
[dac~]
[X a->x] [X b->x] [X c->x] [X d->x] [X e->x] [X f->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
