#N canvas 0 0 800 500 12;
#X obj 200 10 ui.label Raspberry Pi GPIO;
#X obj 600 30 ui.b @label "Reset\ All" @background_color 1 0 0 @size
40 40;
#X msg 600 80 0;
#X obj 600 105 s \$0-all-menu;
#X obj 350 500 loadmsg 0;
#X obj 350 525 s \$0-all-menu;
#X obj 350 550 r \$0-gpio;
#X obj 350 575 print GPIO;
#X obj 350 600 hw.rpi.gpio;
#X obj 350 625 route pin;
#X obj 350 650 list.prepend \$0;
#X msg 350 675 \; \$1-rgpio\$2 set \$3;
#X obj 360 70 ui.t @size 20 20 @background_color 1.0 0.0 0.0
@active_color 1.0 0.0 0.0 @fontsize 10 @send "#0_send" @receive
"#0_recv" @label 3.3V @label_side left @label_align right
@label_valign center;
