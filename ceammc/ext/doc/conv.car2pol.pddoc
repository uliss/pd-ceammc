<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.car2pol">
    <title>conv.car2pol</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts cartesian coords to polar</tr>
        <tr lang="ru">преобразует декартовы координаты в полярные</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv polar cartesian</keywords>
      <since>0.8</since>
      <also>
        <see>conv.pol2car</see>
      </also>
      <aliases>
        <alias>ceammc/car-&gt;pol</alias>
        <alias>car-&gt;pol</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts a pair of Cartesian coordinates (x, y) to polar
        coordinates (radius, angle). The radius is the distance from the origin, and the angle is
        given in radians. By default the angle is in the range [-π, +π]. If the @positive flag is
        set, the angle is mapped to the range [0, 2π) instead.</tr>
        <tr lang="ru">Объект преобразует пару декартовых координат (x, y) в полярные координаты
        (радиус, угол). Радиус — это расстояние от начала координат, а угол задаётся в радианах.
        По умолчанию угол лежит в диапазоне [-π, +π]. Если установлен флаг @positive, угол
        приводится к диапазону [0, 2π).</tr>
      </par>
    </info>
    <properties>
      <!-- @positive -->
      <property name="@positive" type="bool" default="0">
        <tr lang="en">output in the positive range. If 1: output range is [0, 2π). Otherwise the
        output range is [-π, +π]</tr>
        <tr lang="ru">выводить в положительном диапазоне. Если 1: выходной диапазон [0, 2π). В
        противном случае выходной диапазон [-π, +π]</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">x, y coord pair</tr>
          <tr lang="ru">пара координат x, y</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">radius and angle (in radians) pair</tr>
          <tr lang="ru">пара: радиус и угол (в радианах)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.slider2d @size 100 100]
|
|
|
|               [T]
|               |
|               [@positive $1(
|               |
[car->pol       ]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
