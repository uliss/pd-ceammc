<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="conv.car2pol">
        <title>conv.car2pol</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">converts cartesian coords to polar</tr>
                <tr lang="ru">преобразует картезианские координаты в полярные</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv polar cartesian</keywords>
            <since>0.8</since>
            <also>
                <see>conv.pol2car</see>
            </also>
            <aliases>
                <alias>ceammc/car-&gt;pol</alias>
                <alias>car-&gt;pol</alias>
            </aliases>
        </meta>
        <properties>
            <!-- @positive -->
            <property name="@positive" type="bool" default="0">
                <tr lang="en">output in positive range. If true output is in [0..2π) range,
                otherwise output range is [-π..+π]</tr>
                <tr lang="ru">вывод в положительном диапазоне. Если 1: выходные значения находятся
                в [0,2π) диапазоне, в противном случае выходным диапазоном является [-π,+π).</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">x, y coord pair</tr>
                    <tr lang="ru" finished="false">x, y coord pair</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">radius and angle (in radians) pair</tr>
                    <tr lang="ru" finished="false">радиус и угол (в радианах)</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.slider2d @size 100 100]
|
|
|
|               [T]
|               |
|               [@positive $1(
|               |
[car->pol       ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
