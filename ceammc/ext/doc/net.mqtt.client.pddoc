<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="net.mqtt.client">
    <title>net.mqtt.client</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">MQTT client</tr>
        <tr lang="ru">MQTT-клиент</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>net</category>
      <keywords>mqtt net client</keywords>
      <since>0.9.8</since>
      <aliases>
        <alias>mqtt.client</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">MQTT (Message Queuing Telemetry Transport) is a lightweight publish/subscribe messaging protocol designed for constrained devices and low-bandwidth networks</tr>
        <tr lang="ru">MQTT (Message Queuing Telemetry Transport) — лёгкий протокол обмена сообщениями по схеме издатель/подписчик, предназначенный для маломощных устройств и сетей с низкой пропускной способностью</tr>
      </par>
      <par>
        <tr lang="en">the object connects to an MQTT broker, publishes messages to topics and subscribes to receive messages from them</tr>
        <tr lang="ru">объект подключается к MQTT-брокеру, публикует сообщения в темы и подписывается на получение сообщений из них</tr>
      </par>
      <par>
        <tr lang="en">@qos sets the quality of service level (0 — at most once, 1 — at least once, 2 — exactly once)</tr>
        <tr lang="ru">@qos задаёт уровень качества обслуживания (0 — не более одного раза, 1 — не менее одного раза, 2 — ровно один раз)</tr>
      </par>
      <par>
        <tr lang="en">the second outlet outputs a bang when a ping message is received from the broker</tr>
        <tr lang="ru">второй выход выдаёт bang при получении ping-сообщения от брокера</tr>
      </par>
    </info>
    <properties>
      <!-- @id -->
      <property name="@id" type="symbol" default="pd_mqtt_client_0">
        <tr lang="en">client id</tr>
        <tr lang="ru">идентификатор клиента</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" default="fudi" enum="data fudi json sym bytes">
        <tr lang="en">parsing mode for incoming/outgoing messages. If "fudi" — interpret data as Pd messages, if "sym" — always interpret as symbols, "data" — parse ceammc data, "json" — convert JSON values to ceammc data</tr>
        <tr lang="ru">режим разбора входящих/исходящих сообщений. Если "fudi" — интерпретировать данные как Pd-сообщения, если "sym" — всегда интерпретировать как символы, "data" — разбирать данные ceammc, "json" — преобразовывать значения JSON в данные ceammc</tr>
      </property>
      <!-- @qos -->
      <property name="@qos" type="int" default="0" enum="0 1 2">
        <tr lang="en">quality of service</tr>
        <tr lang="ru">качество обслуживания</tr>
      </property>
      <!-- @retain -->
      <property name="@retain" type="bool" default="0">
        <tr lang="en">retain flag</tr>
        <tr lang="ru">флаг retain</tr>
      </property>
    </properties>
    <methods>
      <!-- close -->
      <method name="close">
        <info>
          <tr lang="en">close MQTT connection</tr>
          <tr lang="ru">закрыть MQTT-соединение</tr>
        </info>
      </method>
      <!-- connect -->
      <method name="connect">
        <info>
          <tr lang="en">connect to websocket server</tr>
          <tr lang="ru">подключиться к серверу websocket</tr>
        </info>
        <param name="URL" type="symbol" required="true">
          <tr lang="en">mqtt server url, for ex.: mqtt://127.0.0.1:9000, tcp://user:pass@127.0.0.1:9000, ssl://user:pass@127.0.0.1 etc.</tr>
          <tr lang="ru">URL MQTT-сервера, например: mqtt://127.0.0.1:9000, tcp://user:pass@127.0.0.1:9000, ssl://user:pass@127.0.0.1 и т.д.</tr>
        </param>
      </method>
      <!-- publish -->
      <method name="publish">
        <info>
          <tr lang="en">publish message to topic</tr>
          <tr lang="ru">опубликовать сообщение в тему</tr>
        </info>
        <param name="TOPIC" type="symbol" required="true">
          <tr lang="en">topic</tr>
          <tr lang="ru">тема</tr>
        </param>
        <param name="ARGS" type="list" required="false">
          <tr lang="en">content</tr>
          <tr lang="ru">содержимое</tr>
        </param>
      </method>
      <!-- subscribe -->
      <method name="subscribe">
        <info>
          <tr lang="en">subscribe to topic</tr>
          <tr lang="ru">подписаться на тему</tr>
        </info>
        <param name="TOPIC" type="symbol" required="true">
          <tr lang="en">topic</tr>
          <tr lang="ru">тема</tr>
        </param>
      </method>
      <!-- unsubscribe -->
      <method name="unsubscribe">
        <info>
          <tr lang="en">unsubscribe from topic</tr>
          <tr lang="ru">отписаться от темы</tr>
        </info>
        <param name="TOPIC" type="symbol" required="true">
          <tr lang="en">topic</tr>
          <tr lang="ru">тема</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">message input</tr>
          <tr lang="ru">вход сообщений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output messages: topic data</tr>
          <tr lang="ru">выходные сообщения: тема данные</tr>
        </out>
      </outlet>
      <outlet>
        <out type="bang">
          <tr lang="en">bang: on ping message</tr>
          <tr lang="ru">bang: при ping-сообщении</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*you can start testing mqtt server with command: 'nanomq -start'*/


  [connect tcp://test.mosquitto.org:1883 #k(

 [connect mqtt://ro:readonly@test.mosquitto.org:1884 #l(

[connect mqtt://localhost:1883(  [subscribe topic/1 #e(
|
| [close #b(                     [subscribe topic/2 #f(
|
| [publish topic/1 MSG1 #c(      [subscribe topic/# #g(
|
| [publish topic/2 MSG2 #d(      [unsubscribe topic/1 #h(
|
|                                [unsubscribe topic/2 #i(
|
|                                [unsubscribe topic/# #j(
|
[net.mqtt.client #x ]
|                  ^|
[ui.dt]            [B]

[X b->x] [X c->x] [X d->x] [X k->x] [X l->x]
[X e->x] [X f->x] [X g->x] [X h->x] [X i->x] [X j->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
