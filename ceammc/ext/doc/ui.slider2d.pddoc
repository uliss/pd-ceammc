<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.slider2d" type="gui">
        <title>ui.slider2d</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">2D slider widget</tr>
                <tr lang="ru">2D виджет слайдера</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui slider</keywords>
            <aliases>
                <alias view="link">ui.s2d</alias>
            </aliases>
            <since>0.1</since>
            <also>
                <see view="link">ui.slider</see>
                <see view="link">ui.polar</see>
            </also>
        </meta>
        <mouse>
            <event type="left-click" editmode="false">jump to coord under mouse pointer</event>
            <event type="drag" editmode="false">change slider coords</event>
            <event type="wheel" editmode="false">change Y coord</event>
            <event type="wheel" editmode="false" keys="Shift">change precisely Y coord</event>
            <event type="wheel" editmode="false" keys="Alt">change X coord</event>
            <event type="wheel" editmode="false" keys="Alt+Shift">change precisely X coord</event>
            <event type="right-click" editmode="false">opens popup menu for quick settings</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_background_color.xml" />
            <!-- @bind_x -->
            <property name="@bind_x" type="list" default="">
                <tr lang="en">MIDI/keyboard bind expression for x-axis movement</tr>
            </property>
            <!-- @bind_y -->
            <property name="@bind_y" type="list" default="">
                <tr lang="en">MIDI/keyboard bind expression for y-axis movement</tr>
            </property>
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <!-- @fontweight -->
            <property name="@fontweight" type="symbol" enum="normal bold" default="normal">
                <tr lang="en">font weight</tr>
            </property>
            <!-- @label -->
            <property name="@label" type="symbol" default="(null)">
                <tr lang="en">label text</tr>
            </property>
            <!-- @label_align -->
            <property name="@label_align" type="symbol" enum="left center right" default="left">
                <tr lang="en">label horizontal align</tr>
            </property>
            <!-- @label_color -->
            <property name="@label_color" type="list" default="0 0 0 1">
                <tr lang="en">label color in RGB format within 0-1 range, for example: 0.2 0.4
                0.1</tr>
            </property>
            <!-- @label_inner -->
            <property name="@label_inner" type="bool" default="0">
                <tr lang="en">label position (1 - inner, 0 - outer).</tr>
            </property>
            <!-- @label_margins -->
            <property name="@label_margins" type="list" default="0 0">
                <tr lang="en">label offset in pixels</tr>
            </property>
            <!-- @label_side -->
            <property name="@label_side" type="symbol" enum="left top right bottom" default="top">
                <tr lang="en">label snap side</tr>
            </property>
            <!-- @label_valign -->
            <property name="@label_valign" type="symbol" enum="top center bottom" default="top">
                <tr lang="en">label vertical align</tr>
            </property>
            <!-- @mouse_events -->
            <property name="@mouse_events" type="bool" default="0">
                <tr lang="en">mouse events output mode. If on outputs @mouse_down, @mouse_up and
                @mouse_drag events</tr>
            </property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="0">
                <tr lang="en">pin mode. if 1 - put element to the lowest level</tr>
            </property>
            <!-- @presetname -->
            <property name="@presetname" type="symbol" default="(null)">
                <tr lang="en">preset name for using with [ui.preset]</tr>
            </property>
            <!-- @receive -->
            <property name="@receive" type="symbol" default="(null)">
                <tr lang="en">receive source</tr>
            </property>
            <!-- @send -->
            <property name="@send" type="symbol" default="(null)">
                <tr lang="en">send destination</tr>
            </property>
            <!-- @show_grid -->
            <property name="@show_grid" type="bool" default="0">
                <tr lang="en">if show grid</tr>
            </property>
            <!-- @show_range -->
            <property name="@show_range" type="bool" default="1">
                <tr lang="en">if show slider range</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="100 100">
                <tr lang="en">element size (width, height pair)</tr>
            </property>
            <!-- @x_left -->
            <property name="@x_left" type="float" default="-1">
                <tr lang="en">leftmost x-value</tr>
            </property>
            <!-- @x_range -->
            <property name="@x_range" type="float" access="readonly" default="2">
                <tr lang="en">abs x-value range</tr>
            </property>
            <!-- @x_right -->
            <property name="@x_right" type="float" default="1">
                <tr lang="en">rightmost x-value</tr>
            </property>
            <!-- @x_value -->
            <property name="@x_value" type="float" default="0">
                <tr lang="en">slider x-value</tr>
            </property>
            <!-- @y_bottom -->
            <property name="@y_bottom" type="float" default="-1">
                <tr lang="en">bottom y-value</tr>
            </property>
            <!-- @y_range -->
            <property name="@y_range" type="float" access="readonly" default="2">
                <tr lang="en">abs y-value range</tr>
            </property>
            <!-- @y_top -->
            <property name="@y_top" type="float" default="1">
                <tr lang="en">top y-value</tr>
            </property>
            <!-- @y_value -->
            <property name="@y_value" type="float" default="0">
                <tr lang="en">slider y-value</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">clears specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
            <!-- dump -->
            <method name="dump">dumps all object info to Pd console window</method>
            <!-- interp -->
            <method name="interp">interplolates between presets 
            <param name="IDX" type="float" required="true">preset fraction index</param></method>
            <!-- load -->
            <method name="load">loads specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
            <!-- move -->
            <method name="move">move slider by given offset 
            <param name="X" type="float" required="true">x-offset</param>
            <param name="Y" type="float" required="true">y-offset</param></method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
            <!-- set -->
            <method name="set">sets slider position without output 
            <param name="X" type="float" required="true">x-position</param>
            <param name="Y" type="float" required="true">y-position</param></method>
            <!-- store -->
            <method name="store">stores specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">outputs slider position</xinfo>
                <xinfo on="list">sets slider position and outputs it</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list output of two values: X and Y</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
                           [T]
                           |
[set 0 0(  [move 0.1 -0.1( [@show_grid $1(
|          |               |
[ui.slider2d @nosave 1     ]
|
|
|
|
|
|
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
