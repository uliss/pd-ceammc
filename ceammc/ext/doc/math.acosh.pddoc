<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.acosh">
        <title>math.acosh</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">inverse hyperbolic cosine function</tr>
                <tr lang="ru">обратный гиперболический косинус</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math acosh</keywords>
            <also>
                <see>math.asinh</see>
                <see>math.atanh</see>
                <see>math.exp</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The acosh() function computes the principle value of the inverse
                hyperbolic cosine of input value. The result is in the range [0, +infinity].</tr>
                <!-- old: Функция acosh() вычисляет основное значение
                обратного гиперболического косинуса входного значения. Результат находится в
                диапазоне [0, + бесконечность]. -->
                <tr lang="ru" finished="false">Функция acosh() вычисляет основное значение
                обратного гиперболического косинуса входного значения. Результат находится в
                диапазоне [0, + бесконечность].</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
                <tr lang="ru" finished="false">Особые ценности:</tr>
            </par>
            <par>
                <tr lang="en">acosh(1) returns +0.</tr>
                <tr lang="ru" finished="false">acosh(1) возвращается +0.</tr>
            </par>
            <par>
                <tr lang="en">acosh(x) returns a NAN.</tr>
                <tr lang="ru" finished="false">acosh(x) возвращает NAN.</tr>
            </par>
            <par>
                <tr lang="en">acosh(+infinity) returns +infinity.</tr>
                <tr lang="ru" finished="false">acosh (+infinity) возвращается +infinity.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input value</tr>
                    <tr lang="ru" finished="false">входная стоимость</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">apply to all numeric values</tr>
                    <tr lang="ru" finished="false">применяется ко всем числовым значениям</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result value</tr>
                    <tr lang="ru" finished="false">значение результата</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]    [1 2 d b(
|      |
[math.acosh]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
