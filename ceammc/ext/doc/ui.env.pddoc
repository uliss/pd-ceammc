<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.env" type="gui">
    <title>ui.env</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">envelope editor</tr>
        <tr lang="ru">редактор огибающей</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui envelope</keywords>
      <since>0.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Editor of sound envelope function</tr>
        <tr lang="ru" finished="false">Редактор функции звуковых конвертов</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">on segment: toggle segment selection</event>
      <event type="left-click" editmode="false" keys="Alt">remove node under cursor</event>
      <event type="left-click" editmode="false" keys="Shift">create new node under cursor</event>
      <event type="left-click" editmode="false" keys="Cmd">output envelope on mouse DOWN</event>
      <event type="left-click" editmode="false">output envelope on mouse UP if @output_mode =
      mouse_up</event>
      <event type="move" editmode="false">show info on hover envelope points</event>
      <event type="drag" editmode="false">move node under the cursor. Note: node can have fixed Y
      coordinate, output envelope if @output_mode = drag</event>
      <event type="right-click" editmode="false">on segment: segment type context menu. on selected
      node: node context menu. if no selection: opens standard envelope menu.</event>
      <event type="right-click" editmode="false" keys="Shift">open object help</event>
      <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
      <event type="wheel" editmode="false">on selected segment: change curve of exp or sigmoid
      curve. on selected node: move node up/down</event>
      <event type="right-click" editmode="true" keys="Shift">open object help</event>
      <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
    </mouse>
    <properties>
      <xi:include href="props_active_color.xml" />
      <xi:include href="props_background_color.xml" />
      <xi:include href="props_border_color.xml" />
      <xi:include href="props_fontname.xml" />
      <xi:include href="props_fontsize.xml" />
      <xi:include href="props_fontslant.xml" />
      <xi:include href="props_fontweight.xml" />
      <xi:include href="props_pinned.xml" />
      <xi:include href="props_ui_receive.xml" />
      <xi:include href="props_ui_send.xml" />
      <xi:include href="props_preset.xml" />
      <!-- @length -->
      <property name="@length" type="float" default="400" minvalue="10" units="millisecond">
        <tr lang="en">envelope time length</tr>
        <tr lang="ru" finished="false">время конверта</tr>
      </property>
      <!-- @line_color -->
      <property name="@line_color" type="list" default="0.1 0.1 0.1 1">
        <tr lang="en">line color (list of red, green, blue values in 0-1 range)</tr>
        <tr lang="ru" finished="false">цвет линии (список красных, зеленых, синих значений в
        диапазоне 0-1)</tr>
      </property>
      <!-- @mouse_events -->
      <property name="@mouse_events" type="bool" default="0">
        <tr lang="en">mouse events output mode. If on outputs @mouse_down, @mouse_up and
        @mouse_drag events</tr>
        <tr lang="ru" finished="false">Режим вывода событий мыши. Если на выходе @mouse_down,
        @mouse_up и @mouse_drag события</tr>
      </property>
      <!-- @norm -->
      <property name="@norm" type="bool" default="1">
        <tr lang="en">normalize input values</tr>
        <tr lang="ru" finished="false">нормализовать входные значения</tr>
      </property>
      <!-- @output_mode -->
      <property name="@output_mode" type="symbol" enum="mouse_up drag" default="mouse_up">
        <tr lang="en">output envelope mode. If set to "mouse_up" - output envelope on mouse up if
        Ctrl/Cmd key not pressed. If set to "drag" - output envelope on every change. Note: in any
        mode you can output envelope with Ctrl/Cmd + mouse down.</tr>
        <tr lang="ru" finished="false">Режим выходной оболочки. При настройке на "mouse_up" - вывод
        конверта на мышь вверх, если ключ Ctrl/Cmd не нажат. Если настроен на "перетаскивание" -
        вывод конверта на каждое изменение. Примечание: в любом режиме можно вывести конверт с
        помощью Ctrl/Cmd + мышь вниз.</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="200 150">
        <tr lang="en">object size (width, height pair)</tr>
        <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
      </property>
    </properties>
    <methods>
      <!-- adsr -->
      <method name="adsr">
        <info>
          <tr lang="en">creates ADSR envelope with one stop point</tr>
          <tr lang="ru" finished="false">Создание конверта ADSR с одной точкой остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">attack time</tr>
          <tr lang="ru" finished="false">Время атаки</tr>
        </param>
        <param name="DECAY" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">decay time</tr>
          <tr lang="ru" finished="false">время распада</tr>
        </param>
        <param name="SUSTAIN" type="float" units="percent" required="true" minvalue="0"
        maxvalue="100">
          <tr lang="en">sustain level</tr>
          <tr lang="ru" finished="false">поддержание</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">release time</tr>
          <tr lang="ru" finished="false">Время освобождения</tr>
        </param>
      </method>
      <!-- ar -->
      <method name="ar">
        <info>
          <tr lang="en">creates AR envelope without stop points</tr>
          <tr lang="ru" finished="false">Создает конверт AR без точек остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">attack time</tr>
          <tr lang="ru" finished="false">Время атаки</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">release time</tr>
          <tr lang="ru" finished="false">Время освобождения</tr>
        </param>
      </method>
      <!-- asr -->
      <method name="asr">
        <info>
          <tr lang="en">creates ASR envelope with one stop point</tr>
          <tr lang="ru" finished="false">Создание конверта ASR с одной точкой остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">attack time</tr>
          <tr lang="ru" finished="false">Время атаки</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">release time</tr>
          <tr lang="ru" finished="false">Время освобождения</tr>
        </param>
      </method>
      <!-- at -->
      <method name="at">
        <info>
          <tr lang="en">output envelope value at specified position to second outlet</tr>
          <tr lang="ru" finished="false">значение выходной оболочки в указанном положении для
          второго выхода</tr>
        </info>
        <param name="VAL" type="float" required="true">
          <tr lang="en">position (in milliseconds if unit arg is omitted)</tr>
          <tr lang="ru" finished="false">положение (в миллисекундах, если единица arg опущена)</tr>
        </param>
        <param name="UNIT" type="symbol" required="false" enum="ms % *">
          <tr lang="en">position unit: ms, % or *(phase)</tr>
          <tr lang="ru" finished="false">единица положения: ms, % или *(фаза)</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clear specified preset</tr>
          <tr lang="ru" finished="false">четкая заданная предустановка</tr>
        </info>
        <param name="IDX" type="int" required="true" minvalue="0">
          <tr lang="en">preset index</tr>
          <tr lang="ru" finished="false">предустановленный индекс</tr>
        </param>
      </method>
      <!-- eadsr -->
      <method name="eadsr">
        <info>
          <tr lang="en">creates exponential ADSR envelope with one stop point</tr>
          <tr lang="ru" finished="false">создает экспоненциальный конверт ADSR с одной точкой
          остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">attack time</tr>
          <tr lang="ru" finished="false">Время атаки</tr>
        </param>
        <param name="ATTACK_CURVE" type="float" required="true">
          <tr lang="en">attack segment curve</tr>
          <tr lang="ru" finished="false">кривая сегмента атаки</tr>
        </param>
        <param name="DECAY" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">decay time</tr>
          <tr lang="ru" finished="false">время распада</tr>
        </param>
        <param name="DECAY_CURVE" type="float" required="true">
          <tr lang="en">decay segment curve</tr>
          <tr lang="ru" finished="false">кривая сегмента распада</tr>
        </param>
        <param name="SUSTAIN" type="float" units="percent" required="true" minvalue="0"
        maxvalue="100">
          <tr lang="en">sustain level</tr>
          <tr lang="ru" finished="false">поддержание</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">release time</tr>
          <tr lang="ru" finished="false">Время освобождения</tr>
        </param>
        <param name="RELEASE_CURVE" type="float" required="true">
          <tr lang="en">release segment curve</tr>
          <tr lang="ru" finished="false">кривая сегмента высвобождения</tr>
        </param>
      </method>
      <!-- ear -->
      <method name="ear">
        <info>
          <tr lang="en">creates exponential AR envelope without stop points</tr>
          <tr lang="ru" finished="false">Создает экспоненциальный конверт AR без точек
          остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true">
          <tr lang="en">attack time</tr>
          <tr lang="ru" finished="false">Время атаки</tr>
        </param>
        <param name="ATTACK_CURVE" type="float" required="true">
          <tr lang="en">attack segment curve</tr>
          <tr lang="ru" finished="false">кривая сегмента атаки</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true">
          <tr lang="en">release time</tr>
          <tr lang="ru" finished="false">Время освобождения</tr>
        </param>
        <param name="RELEASE_CURVE" type="float" required="true">
          <tr lang="en">release segment curve</tr>
          <tr lang="ru" finished="false">кривая сегмента высвобождения</tr>
        </param>
      </method>
      <!-- easr -->
      <method name="easr">
        <info>
          <tr lang="en">creates exponential AR envelope with one stop point</tr>
          <tr lang="ru" finished="false">Создает экспоненциальный конверт AR с одной точкой
          остановки</tr>
        </info>
        <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">attack time</tr>
          <tr lang="ru" finished="false">Время атаки</tr>
        </param>
        <param name="ATTACK_CURVE" type="float" required="true">
          <tr lang="en">attack segment curve</tr>
          <tr lang="ru" finished="false">кривая сегмента атаки</tr>
        </param>
        <param name="RELEASE" type="float" units="millisecond" required="true" minvalue="0">
          <tr lang="en">release time</tr>
          <tr lang="ru" finished="false">Время освобождения</tr>
        </param>
        <param name="RELEASE_CURVE" type="float" required="true">
          <tr lang="en">release segment curve</tr>
          <tr lang="ru" finished="false">кривая сегмента высвобождения</tr>
        </param>
      </method>
      <!-- exp -->
      <method name="exp">
        <info>
          <tr lang="en">creates exponential-segmented envelope with arbitrary number of
          segments</tr>
          <tr lang="ru" finished="false">создает экспоненциально-сегментированную оболочку с
          произвольным количеством сегментов</tr>
        </info>
        <param name="VAL0" type="float" required="true">
          <tr lang="en">begin value</tr>
          <tr lang="ru" finished="false">Начало значения</tr>
        </param>
        <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
          <tr lang="en">line length</tr>
          <tr lang="ru" finished="false">длина линии</tr>
        </param>
        <param name="CURVE0" type="float" required="true">
          <tr lang="en">segment curve</tr>
          <tr lang="ru" finished="false">сегментная кривая</tr>
        </param>
        <param name="VAL1" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
        <param name="LEN1" type="float" required="false">
          <tr lang="en">segment length</tr>
          <tr lang="ru" finished="false">длина сегмента</tr>
        </param>
        <param name="CURVE1" type="float" required="false">
          <tr lang="en">segment curve</tr>
          <tr lang="ru" finished="false">сегментная кривая</tr>
        </param>
        <param name="VAL2" type="float" required="false">
          <tr lang="en">value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
      </method>
      <!-- interp -->
      <method name="interp">
        <info>
          <tr lang="en">for this object acts as *load*, no interpolation performed</tr>
          <tr lang="ru" finished="false">для этого объекта действует как *load*, интерполяция не
          выполняется</tr>
        </info>
      </method>
      <!-- line -->
      <method name="line">
        <info>
          <tr lang="en">creates line-segmented envelope with arbitrary number of segments</tr>
          <tr lang="ru" finished="false">создает линейно-сегментированный конверт с произвольным
          количеством сегментов</tr>
        </info>
        <param name="VAL0" type="float" required="true">
          <tr lang="en">begin value</tr>
          <tr lang="ru" finished="false">Начало значения</tr>
        </param>
        <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
          <tr lang="en">line length</tr>
          <tr lang="ru" finished="false">длина линии</tr>
        </param>
        <param name="VAL1" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
        <param name="LEN1" type="float" required="false">
          <tr lang="en">segment length</tr>
          <tr lang="ru" finished="false">длина сегмента</tr>
        </param>
        <param name="VAL2" type="float" required="false">
          <tr lang="en">value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">loads specified preset</tr>
          <tr lang="ru" finished="false">заданный заранее заданный</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru" finished="false">предустановленный индекс</tr>
        </param>
      </method>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set UI element position</tr>
          <tr lang="ru" finished="false">Установите положение элемента UI</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top left x-coord</tr>
          <tr lang="ru" finished="false">верхний левый x-coord</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top right y-coord</tr>
          <tr lang="ru" finished="false">верхняя правая y-coord</tr>
        </param>
      </method>
      <!-- sigmoid -->
      <method name="sigmoid">
        <info>
          <tr lang="en">creates sigmoid-segmented envelope with arbitrary number of segments</tr>
          <tr lang="ru" finished="false">создает сигмоид-сегментированную оболочку с произвольным
          количеством сегментов</tr>
        </info>
        <param name="VAL0" type="float" required="true">
          <tr lang="en">begin value</tr>
          <tr lang="ru" finished="false">Начало значения</tr>
        </param>
        <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
          <tr lang="en">line length</tr>
          <tr lang="ru" finished="false">длина линии</tr>
        </param>
        <param name="CURVE0" type="float" required="true">
          <tr lang="en">segment curve</tr>
          <tr lang="ru" finished="false">сегментная кривая</tr>
        </param>
        <param name="VAL1" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
        <param name="LEN1" type="float" required="false">
          <tr lang="en">segment length</tr>
          <tr lang="ru" finished="false">длина сегмента</tr>
        </param>
        <param name="CURVE1" type="float" required="false">
          <tr lang="en">segment curve</tr>
          <tr lang="ru" finished="false">сегментная кривая</tr>
        </param>
        <param name="VAL2" type="float" required="false">
          <tr lang="en">value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
      </method>
      <!-- sin2 -->
      <method name="sin2">
        <info>
          <tr lang="en">creates quadratic sine-segmented envelope with arbitrary number of
          segments</tr>
          <tr lang="ru" finished="false">создает квадратичную синесегментированную оболочку с
          произвольным числом сегментов</tr>
        </info>
        <param name="VAL0" type="float" required="true">
          <tr lang="en">begin value</tr>
          <tr lang="ru" finished="false">Начало значения</tr>
        </param>
        <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
          <tr lang="en">line length</tr>
          <tr lang="ru" finished="false">длина линии</tr>
        </param>
        <param name="VAL1" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
        <param name="LEN1" type="float" required="false">
          <tr lang="en">segment length</tr>
          <tr lang="ru" finished="false">длина сегмента</tr>
        </param>
        <param name="VAL2" type="float" required="false">
          <tr lang="en">value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
      </method>
      <!-- step -->
      <method name="step">
        <info>
          <tr lang="en">creates step-segmented envelope with arbitrary number of segments</tr>
          <tr lang="ru" finished="false">создает пошаговый сегментированный конверт с произвольным
          количеством сегментов</tr>
        </info>
        <param name="VAL0" type="float" required="true">
          <tr lang="en">begin value</tr>
          <tr lang="ru" finished="false">Начало значения</tr>
        </param>
        <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
          <tr lang="en">step length</tr>
          <tr lang="ru" finished="false">длина шага</tr>
        </param>
        <param name="VAL1" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
        <param name="LEN1" type="float" required="false">
          <tr lang="en">segment length</tr>
          <tr lang="ru" finished="false">длина сегмента</tr>
        </param>
        <param name="VAL2" type="float" required="false">
          <tr lang="en">value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
      </method>
      <!-- store -->
      <method name="store">
        <info>
          <tr lang="en">stores specified preset</tr>
          <tr lang="ru" finished="false">магазины, указанные Preset</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru" finished="false">предустановленный индекс</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="data">
          <tr lang="en">set new envelope and output it</tr>
          <tr lang="ru" finished="false">установить новый конверт и вывести его</tr>
        </in>
        <in on="bang">
          <tr lang="en">output current envelope</tr>
          <tr lang="ru" finished="false">выходной ток</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">envelope</tr>
          <tr lang="ru" finished="false">конверт</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">float: envelope value at time moment</tr>
          <tr lang="ru" finished="false">Поплавок: значение конверта в момент времени</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ar 10 450, bang(
|
[envelope] [adsr 10 20 15 80( [eadsr 180 -2 20 4 30 100 -8(
|          |                  |
|          | [asr 300 400(    | [easr 200 2 30 7(
|          | |                | |
|          | | [ar 10 80(     | | [ear 10 -4 70 -6(
|          | | |              | | |
|          | | |              | | |
|          | | |              | | |
[ui.env               @size 240 60]  /*Cmd+Click to play envelope*/
|
|
|
|
[env->vline @sync 1]
|
[vline~]  [osc~ 1000]
|  .______/
[*~]
|
[ui.gain~ @size 120 16] [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
