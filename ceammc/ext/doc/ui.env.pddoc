<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="ui.env" type="gui">
        <title>ui.env</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">envelope editor</tr>
                <tr lang="ru">редактор огибающей</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui envelope</keywords>
            <since>0.5</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Editor of sound envelope function</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">on segment: toggle segment selection</event>
            <event type="left-click" editmode="false" keys="Alt">remove node under cursor</event>
            <event type="left-click" editmode="false" keys="Shift">create new node under
            cursor</event>
            <event type="left-click" editmode="false" keys="Cmd">output envelope on mouse
            DOWN</event>
            <event type="left-click" editmode="false">output envelope on mouse UP if @output_mode =
            mouse_up</event>
            <event type="move" editmode="false">show info on hover envelope points</event>
            <event type="drag" editmode="false">move node under the cursor. Note: node can have
            fixed Y coordinate, output envelope if @output_mode = drag</event>
            <event type="right-click" editmode="false">on segment: segment type context menu. on
            selected node: node context menu. if no selection: opens standard envelope
            menu.</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="wheel" editmode="false">on selected segment: change curve of exp or
            sigmoid curve. on selected node: move node up/down</event>
            <event type="right-click" editmode="true" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_active_color.xml" />
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_pinned.xml" />
            <xi:include href="props_ui_receive.xml" />
            <xi:include href="props_ui_send.xml" />
            <xi:include href="props_preset.xml" />
            <!-- @length -->
            <property name="@length" type="float" default="400" minvalue="10" units="millisecond">
                <tr lang="en">envelope time length</tr>
            </property>
            <!-- @line_color -->
            <property name="@line_color" type="list" default="0.1 0.1 0.1 1">
                <tr lang="en">line color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @mouse_events -->
            <property name="@mouse_events" type="bool" default="0">
                <tr lang="en">mouse events output mode. If on outputs @mouse_down, @mouse_up and
                @mouse_drag events</tr>
            </property>
            <!-- @norm -->
            <property name="@norm" type="bool" default="1">
                <tr lang="en">normalize input values</tr>
            </property>
            <!-- @output_mode -->
            <property name="@output_mode" type="symbol" enum="mouse_up drag" default="mouse_up">
                <tr lang="en">output envelope mode. If set to "mouse_up" - output envelope on mouse
                up if Ctrl/Cmd key not pressed. If set to "drag" - output envelope on every change.
                Note: in any mode you can output envelope with Ctrl/Cmd + mouse down.</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="200 150">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
        </properties>
        <methods>
            <!-- adsr -->
            <method name="adsr">
                <info>
                    <tr lang="en">creates ADSR envelope with one stop point</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">attack time</tr>
                </param>
                <param name="DECAY" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">decay time</tr>
                </param>
                <param name="SUSTAIN" type="float" units="percent" required="true" minvalue="0"
                maxvalue="100">
                    <tr lang="en">sustain level</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true"
                minvalue="0">
                    <tr lang="en">release time</tr>
                </param>
            </method>
            <!-- ar -->
            <method name="ar">
                <info>
                    <tr lang="en">creates AR envelope without stop points</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">attack time</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true"
                minvalue="0">
                    <tr lang="en">release time</tr>
                </param>
            </method>
            <!-- asr -->
            <method name="asr">
                <info>
                    <tr lang="en">creates ASR envelope with one stop point</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">attack time</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true"
                minvalue="0">
                    <tr lang="en">release time</tr>
                </param>
            </method>
            <!-- at -->
            <method name="at">
                <info>
                    <tr lang="en">output envelope value at specified position to second outlet</tr>
                </info>
                <param name="VAL" type="float" required="true">
                    <tr lang="en">position (in milliseconds if unit arg is omitted)</tr>
                </param>
                <param name="UNIT" type="symbol" required="false" enum="ms % *">
                    <tr lang="en">position unit: ms, % or *(phase)</tr>
                </param>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clear specified preset</tr>
                </info>
                <param name="IDX" type="int" required="true" minvalue="0">
                    <tr lang="en">preset index</tr>
                </param>
            </method>
            <!-- eadsr -->
            <method name="eadsr">
                <info>
                    <tr lang="en">creates exponential ADSR envelope with one stop point</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">attack time</tr>
                </param>
                <param name="ATTACK_CURVE" type="float" required="true">
                    <tr lang="en">attack segment curve</tr>
                </param>
                <param name="DECAY" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">decay time</tr>
                </param>
                <param name="DECAY_CURVE" type="float" required="true">
                    <tr lang="en">decay segment curve</tr>
                </param>
                <param name="SUSTAIN" type="float" units="percent" required="true" minvalue="0"
                maxvalue="100">
                    <tr lang="en">sustain level</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true"
                minvalue="0">
                    <tr lang="en">release time</tr>
                </param>
                <param name="RELEASE_CURVE" type="float" required="true">
                    <tr lang="en">release segment curve</tr>
                </param>
            </method>
            <!-- ear -->
            <method name="ear">
                <info>
                    <tr lang="en">creates exponential AR envelope without stop points</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true">
                    <tr lang="en">attack time</tr>
                </param>
                <param name="ATTACK_CURVE" type="float" required="true">
                    <tr lang="en">attack segment curve</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true">
                    <tr lang="en">release time</tr>
                </param>
                <param name="RELEASE_CURVE" type="float" required="true">
                    <tr lang="en">release segment curve</tr>
                </param>
            </method>
            <!-- easr -->
            <method name="easr">
                <info>
                    <tr lang="en">creates exponential AR envelope with one stop point</tr>
                </info>
                <param name="ATTACK" type="float" units="millisecond" required="true" minvalue="0">
                    <tr lang="en">attack time</tr>
                </param>
                <param name="ATTACK_CURVE" type="float" required="true">
                    <tr lang="en">attack segment curve</tr>
                </param>
                <param name="RELEASE" type="float" units="millisecond" required="true"
                minvalue="0">
                    <tr lang="en">release time</tr>
                </param>
                <param name="RELEASE_CURVE" type="float" required="true">
                    <tr lang="en">release segment curve</tr>
                </param>
            </method>
            <!-- exp -->
            <method name="exp">
                <info>
                    <tr lang="en">creates exponential-segmented envelope with arbitrary number of
                    segments</tr>
                </info>
                <param name="VAL0" type="float" required="true">
                    <tr lang="en">begin value</tr>
                </param>
                <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
                    <tr lang="en">line length</tr>
                </param>
                <param name="CURVE0" type="float" required="true">
                    <tr lang="en">segment curve</tr>
                </param>
                <param name="VAL1" type="float" required="true">
                    <tr lang="en">value</tr>
                </param>
                <param name="LEN1" type="float" required="false">
                    <tr lang="en">segment length</tr>
                </param>
                <param name="CURVE1" type="float" required="false">
                    <tr lang="en">segment curve</tr>
                </param>
                <param name="VAL2" type="float" required="false">
                    <tr lang="en">value</tr>
                </param>
            </method>
            <!-- interp -->
            <method name="interp">
                <info>
                    <tr lang="en">for this object acts as *load*, no interpolation performed</tr>
                </info>
            </method>
            <!-- line -->
            <method name="line">
                <info>
                    <tr lang="en">creates line-segmented envelope with arbitrary number of
                    segments</tr>
                </info>
                <param name="VAL0" type="float" required="true">
                    <tr lang="en">begin value</tr>
                </param>
                <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
                    <tr lang="en">line length</tr>
                </param>
                <param name="VAL1" type="float" required="true">
                    <tr lang="en">value</tr>
                </param>
                <param name="LEN1" type="float" required="false">
                    <tr lang="en">segment length</tr>
                </param>
                <param name="VAL2" type="float" required="false">
                    <tr lang="en">value</tr>
                </param>
            </method>
            <!-- load -->
            <method name="load">
                <info>
                    <tr lang="en">loads specified preset</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                </param>
            </method>
            <!-- pos -->
            <method name="pos">
                <info>
                    <tr lang="en">set UI element position</tr>
                </info>
                <param name="X" type="float" required="true">
                    <tr lang="en">top left x-coord</tr>
                </param>
                <param name="Y" type="float" required="true">
                    <tr lang="en">top right y-coord</tr>
                </param>
            </method>
            <!-- sigmoid -->
            <method name="sigmoid">
                <info>
                    <tr lang="en">creates sigmoid-segmented envelope with arbitrary number of
                    segments</tr>
                </info>
                <param name="VAL0" type="float" required="true">
                    <tr lang="en">begin value</tr>
                </param>
                <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
                    <tr lang="en">line length</tr>
                </param>
                <param name="CURVE0" type="float" required="true">
                    <tr lang="en">segment curve</tr>
                </param>
                <param name="VAL1" type="float" required="true">
                    <tr lang="en">value</tr>
                </param>
                <param name="LEN1" type="float" required="false">
                    <tr lang="en">segment length</tr>
                </param>
                <param name="CURVE1" type="float" required="false">
                    <tr lang="en">segment curve</tr>
                </param>
                <param name="VAL2" type="float" required="false">
                    <tr lang="en">value</tr>
                </param>
            </method>
            <!-- sin2 -->
            <method name="sin2">
                <info>
                    <tr lang="en">creates quadratic sine-segmented envelope with arbitrary number
                    of segments</tr>
                </info>
                <param name="VAL0" type="float" required="true">
                    <tr lang="en">begin value</tr>
                </param>
                <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
                    <tr lang="en">line length</tr>
                </param>
                <param name="VAL1" type="float" required="true">
                    <tr lang="en">value</tr>
                </param>
                <param name="LEN1" type="float" required="false">
                    <tr lang="en">segment length</tr>
                </param>
                <param name="VAL2" type="float" required="false">
                    <tr lang="en">value</tr>
                </param>
            </method>
            <!-- step -->
            <method name="step">
                <info>
                    <tr lang="en">creates step-segmented envelope with arbitrary number of
                    segments</tr>
                </info>
                <param name="VAL0" type="float" required="true">
                    <tr lang="en">begin value</tr>
                </param>
                <param name="LEN0" type="float" units="millisecond" required="true" minvalue="1">
                    <tr lang="en">step length</tr>
                </param>
                <param name="VAL1" type="float" required="true">
                    <tr lang="en">value</tr>
                </param>
                <param name="LEN1" type="float" required="false">
                    <tr lang="en">segment length</tr>
                </param>
                <param name="VAL2" type="float" required="false">
                    <tr lang="en">value</tr>
                </param>
            </method>
            <!-- store -->
            <method name="store">
                <info>
                    <tr lang="en">stores specified preset</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="data">
                    <tr lang="en">set new envelope and output it</tr>
                </xinfo>
                <xinfo on="bang">
                    <tr lang="en">output current envelope</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>envelope</outlet>
            <outlet>float: envelope value at time moment</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ar 10 450, bang(
|
[envelope] [adsr 10 20 15 80( [eadsr 180 -2 20 4 30 100 -8(
|          |                  |
|          | [asr 300 400(    | [easr 200 2 30 7(
|          | |                | |
|          | | [ar 10 80(     | | [ear 10 -4 70 -6(
|          | | |              | | |
|          | | |              | | |
|          | | |              | | |
[ui.env               @size 240 60]  /*Cmd+Click to play envelope*/
|
|
|
|
[env->vline @sync 1]
|
[vline~]  [osc~ 1000]
|  .______/
[*~]
|
[ui.gain~ @size 120 16] [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
