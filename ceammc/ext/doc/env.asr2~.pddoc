<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env.asr2~">
    <title>env.asr2~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">stereo Attack/Sustain/Release envelope generator</tr>
        <tr lang="ru">стереофонический генератор огибающей Attack/Sustain/Release
        (атака/удержание/восстановление)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>envelope asr stereo</keywords>
      <since>0.9.7</since>
      <also>
        <see>env.adsr~</see>
        <see>env.ar~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">A stereo ASR (Attack / Sustain / Release) envelope generator with three
        stages: attack (rise from 0 to 1), sustain (hold at the sustain level while the gate is on)
        and release (fall back to 0 after the gate is turned off). Both channels are controlled by
        the same envelope, so the object is convenient for applying a single envelope shape to a
        stereo signal.</tr>
        <tr lang="ru">Стереофонический генератор огибающей ASR (атака / удержание /
        восстановление) с тремя фазами: атакой (рост от 0 до 1), удержанием (уровень удержания
        сохраняется, пока открыт gate) и восстановлением (спад обратно к 0 после закрытия gate).
        Оба канала управляются одной и той же огибающей, поэтому объект удобен для применения
        единой формы огибающей к стереосигналу.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ATTACK" type="float" units="millisecond" minvalue="0" maxvalue="100000">
        <tr lang="en">attack time</tr>
        <tr lang="ru">время атаки</tr>
      </argument>
      <argument name="SUSTAIN" type="float" units="percent" minvalue="0" maxvalue="100">
        <tr lang="en">sustain level (percentage of trigger)</tr>
        <tr lang="ru">уровень удержания (в процентах от триггера)</tr>
      </argument>
      <argument name="RELEASE" type="float" units="millisecond" minvalue="0" maxvalue="100000">
        <tr lang="en">release time</tr>
        <tr lang="ru">время восстановления</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @asr -->
      <property name="@asr" type="list" access="readonly">
        <tr lang="en">attack, sustain, release triplet</tr>
        <tr lang="ru">тройка значений «атака, удержание, восстановление»</tr>
      </property>
      <!-- @attack -->
      <property name="@attack" type="float" units="millisecond" minvalue="0" maxvalue="100000"
      default="10">
        <tr lang="en">attack time</tr>
        <tr lang="ru">время атаки</tr>
      </property>
      <!-- @gate -->
      <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
        <tr lang="en">trigger. If &gt; 0 — starts the envelope</tr>
        <tr lang="ru">триггер. Если &gt; 0 — запускает огибающую</tr>
      </property>
      <!-- @release -->
      <property name="@release" type="float" units="millisecond" minvalue="0" maxvalue="100000"
      default="300">
        <tr lang="en">release time</tr>
        <tr lang="ru">время восстановления</tr>
      </property>
      <!-- @sustain -->
      <property name="@sustain" type="float" units="percent" minvalue="0" maxvalue="100"
      default="100">
        <tr lang="en">sustain level — percentage of the trigger signal</tr>
        <tr lang="ru">уровень удержания — процент от триггерного сигнала</tr>
      </property>
    </properties>
    <methods>
      <!-- play -->
      <method name="play">
        <info>
          <tr lang="en">runs the envelope and releases it after the specified time</tr>
          <tr lang="ru">запускает огибающую и снимает её через заданное время</tr>
        </info>
        <param name="DUR" type="float" minvalue="0">
          <tr lang="en">duration</tr>
          <tr lang="ru">длительность</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the envelope to its initial state</tr>
          <tr lang="ru">возвращает огибающую в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">first input signal</tr>
          <tr lang="ru">первый входной сигнал</tr>
        </in>
        <in on="list">
          <tr lang="en">ATTACK, SUSTAIN, RELEASE values are expected</tr>
          <tr lang="ru">ожидаются значения ATTACK, SUSTAIN, RELEASE</tr>
        </in>
        <in on="data">
          <tr lang="en">envelope data type</tr>
          <tr lang="ru">тип данных огибающей</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">second input signal</tr>
          <tr lang="ru">второй входной сигнал</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">float: 1 = start the envelope, 0 = stop</tr>
          <tr lang="ru">число: 1 — запустить огибающую, 0 — остановить</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">first output signal with the envelope applied</tr>
          <tr lang="ru">первый выходной сигнал с применённой огибающей</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">second output signal with the envelope applied</tr>
          <tr lang="ru">второй выходной сигнал с применённой огибающей</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">outputs 1 when the attack phase finishes, 0 when the release phase
          finishes</tr>
          <tr lang="ru">выводит 1 по завершении фазы атаки, 0 — по завершении фазы
          восстановления</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[osc~ 440] [osc~ 1000] [T]
|          |.          |..
[env.asr2~ 1000 100 1000  ]
|  ^|               ^^|
|   |               [T]
|   |.
[ui.hgain2~]        [ui.dsp~]
*|*
[dac~ ]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
