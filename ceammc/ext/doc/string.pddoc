<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="string">
        <title>string</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">constructs the string</tr>
                <tr lang="ru">создание строки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>string</category>
            <keywords>string data</keywords>
            <since>0.3</since>
            <aliases>
                <alias>ceammc/string</alias>
                <alias>ceammc/str</alias>
                <alias>str</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="VALUE" type="list">
                <tr lang="en">initial string</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @value -->
            <property name="@value" type="list" default="">
                <tr lang="en">string value</tr>
            </property>
        </properties>
        <methods>
            <!-- append -->
            <method name="append">
                <info>
                    <tr lang="en">append values to the end of string</tr>
                </info>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clear string without output</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">set string content without output</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">outputs string value</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">convert float to string and outputs value</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">convert symbol to string and outputs value</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">convert list to string (separated with spaces) and outputs
                    value</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">string data</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B] [F]   [symbol ABC(
|   |     |
|   |     |
[string 1 2 3 "a string"]  [F]
|                          |
| [B] [clear(              [append $1 $1(
| |   |                    |
[string                    ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
