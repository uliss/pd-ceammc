<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.tramp~">
    <title>array.tramp~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">triggered ramp index generator for the array</tr>
        <tr lang="ru">запускаемый генератор линейно нарастающего индекса для массива</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array ramp trigger</keywords>
      <since>0.9.7</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object generates a ramp signal that can be used as a reading index for
        the specified array. The ramp starts on bang and runs from the @from value to the @to value
        at the speed set by @speed, with the range normalized to the 0..1 interval. When the ramp
        reaches the final value, a bang is sent out through the control outlet.</tr>
        <tr lang="ru">Объект генерирует линейно нарастающий сигнал, который можно использовать как
        индекс чтения для указанного массива. Сигнал запускается по bang и изменяется от значения
        @from к значению @to со скоростью, заданной @speed, при этом диапазон нормализован к
        интервалу 0..1. Когда сигнал достигает конечного значения, через управляющий выход
        отправляется bang.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array the ramp is generated for</tr>
        <tr lang="ru">имя массива, для которого генерируется сигнал</tr>
      </argument>
      <argument name="SPEED" type="float">
        <tr lang="en">playback speed</tr>
        <tr lang="ru">скорость воспроизведения</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array the ramp is generated for</tr>
        <tr lang="ru">имя массива, для которого генерируется сигнал</tr>
      </property>
      <!-- @from -->
      <property name="@from" type="float" minvalue="0" default="0" maxvalue="1">
        <tr lang="en">start of the ramp, normalized to the 0..1 range</tr>
        <tr lang="ru">начало линейного сигнала, нормализованное к диапазону 0..1</tr>
      </property>
      <!-- @range -->
      <property name="@range" type="list" default="0 1">
        <tr lang="en">ramp range</tr>
        <tr lang="ru">диапазон линейного сигнала</tr>
      </property>
      <!-- @speed -->
      <property name="@speed" type="float" default="1">
        <tr lang="en">ramp speed</tr>
        <tr lang="ru">скорость линейного сигнала</tr>
      </property>
      <!-- @to -->
      <property name="@to" type="float" minvalue="0" default="1" maxvalue="1">
        <tr lang="en">end of the ramp, normalized to the 0..1 range</tr>
        <tr lang="ru">конец линейного сигнала, нормализованный к диапазону 0..1</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">starts the ramp signal for array reading</tr>
          <tr lang="ru">запускает линейный сигнал для чтения массива</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">ramp signal</tr>
          <tr lang="ru">линейный сигнал</tr>
        </out>
      </outlet>
      <outlet type="control">
        <out type="bang">
          <tr lang="en">sent after the ramp reaches the final value</tr>
          <tr lang="ru">отправляется после достижения конечного значения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[loadmsg load guitar1.wav to ARAMP @resize]  [table ARAMP 44100]
|
[snd.file]


[B]   [ui.rslider]
|     |
|     [msg @range]
|     |
[array.tramp~ ARAMP]
|                ^|
|                [B]
|
[tabread4~ ARAMP]
|
[flt.dcblock~]
|
[ui.hgain2~]     [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
