<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="midi.vramp">
        <title>midi.vramp</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">apply crescendo or diminuendo for notes flow</tr>
                <tr lang="ru">применяет crescendo или diminuendo для потока нот</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>midi</category>
            <keywords>midi ramp crescendo diminuendo</keywords>
            <since>0.9.1</since>
        </meta>
        <arguments>
            <argument name="FROM" type="int" maxvalue="127" minvalue="0">
                <tr lang="en">start value</tr>
            </argument>
            <argument name="TO" type="int" maxvalue="127" minvalue="0">
                <tr lang="en">end value</tr>
            </argument>
            <argument name="N" type="int" minvalue="0">
                <tr lang="en">number of steps</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @auto -->
            <property name="@auto" type="bool" default="0">
                <tr lang="en">auto reset mode. If true: reset to @start value after ramp is
                finished</tr>
            </property>
            <!-- @from -->
            <property name="@from" type="int" default="127" maxvalue="127" minvalue="0">
                <tr lang="en">start value</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" default="0" minvalue="0">
                <tr lang="en">number of steps</tr>
            </property>
            <!-- @to -->
            <property name="@to" type="int" default="127" maxvalue="127" minvalue="0">
                <tr lang="en">end value</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to start value</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">if VALUE &gt;0, treat as (VALUE 127) list, otherwise as (-VALUE,
                0)</xinfo>
                <xinfo on="list">NOTE [VELOCITY] list expected</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>outputs NOTE VELOCITY pair</outlet>
            <outlet>bang when destination value is reached</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
|                            [reset(
|                            |
[midi.vramp 30 127 12 @auto 1]
|
[msg note]
|
[fluid~ sf2/VintageDreamsWaves-v2.sf2]
*|*
[ui.hgain2~]     [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
