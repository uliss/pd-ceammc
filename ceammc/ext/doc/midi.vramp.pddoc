<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="midi.vramp">
        <title>midi.vramp</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">apply crescendo or diminuendo for notes flow</tr>
                <tr lang="ru">применяет crescendo или diminuendo для потока нот</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>midi</category>
            <keywords>midi ramp crescendo diminuendo</keywords>
            <since>0.9.1</since>
        </meta>
        <arguments>
            <argument name="FROM" type="int" maxvalue="127" minvalue="0">
                <tr lang="en">start value</tr>
                <tr lang="ru" finished="false">стартовая стоимость</tr>
            </argument>
            <argument name="TO" type="int" maxvalue="127" minvalue="0">
                <tr lang="en">end value</tr>
                <tr lang="ru" finished="false">конечная стоимость</tr>
            </argument>
            <argument name="N" type="int" minvalue="0">
                <tr lang="en">number of steps</tr>
                <tr lang="ru" finished="false">Количество шагов</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @auto -->
            <property name="@auto" type="bool" default="0">
                <tr lang="en">auto reset mode. If true: reset to @start value after ramp is
                finished</tr>
                <!-- old: Режим автоматического сброса. Если это правда:
                перезагрузка до @start после завершения рампы -->
                <tr lang="ru" finished="false">Режим автоматического сброса. Если это правда:
                перезагрузка до @start после завершения рампы</tr>
            </property>
            <!-- @from -->
            <property name="@from" type="int" default="127" maxvalue="127" minvalue="0">
                <tr lang="en">start value</tr>
                <tr lang="ru" finished="false">стартовая стоимость</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" default="0" minvalue="0">
                <tr lang="en">number of steps</tr>
                <tr lang="ru" finished="false">Количество шагов</tr>
            </property>
            <!-- @to -->
            <property name="@to" type="int" default="127" maxvalue="127" minvalue="0">
                <tr lang="en">end value</tr>
                <tr lang="ru" finished="false">конечная стоимость</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to start value</tr>
                    <tr lang="ru" finished="false">Сбросить, чтобы начать значение</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">if VALUE &gt;0, treat as (VALUE 127) list, otherwise as (-VALUE,
                    0)</tr>
                    <!-- old: Если значение >0, относитесь к списку (VALUE
                    127), в противном случае (-VALUE, 0) -->
                    <tr lang="ru" finished="false">Если значение &gt;0, относитесь к списку (VALUE
                    127), в противном случае (-VALUE, 0)</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">NOTE [VELOCITY] list expected</tr>
                    <tr lang="ru" finished="false">ПРИМЕЧАНИЕ (Список ожидаемых)</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">outputs NOTE VELOCITY pair</tr>
                    <tr lang="ru" finished="false">Отметить пару VELOCITY</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">bang when destination value is reached</tr>
                    <tr lang="ru" finished="false">Bang, когда достигается значение назначения</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
|                            [reset(
|                            |
[midi.vramp 30 127 12 @auto 1]
|
[msg note]
|
[fluid~ sf2/VintageDreamsWaves-v2.sf2]
*|*
[ui.hgain2~]     [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
