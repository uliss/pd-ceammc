<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="midi.vramp">
    <title>midi.vramp</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">apply crescendo or diminuendo to a note stream</tr>
        <tr lang="ru">применяет crescendo или diminuendo к потоку нот</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>midi</category>
      <keywords>midi ramp crescendo diminuendo</keywords>
      <since>0.9.1</since>
    </meta>
    <arguments>
      <argument name="FROM" type="int" maxvalue="127" minvalue="0">
        <tr lang="en">start value</tr>
        <tr lang="ru">начальное значение</tr>
      </argument>
      <argument name="TO" type="int" maxvalue="127" minvalue="0">
        <tr lang="en">end value</tr>
        <tr lang="ru">конечное значение</tr>
      </argument>
      <argument name="N" type="int" minvalue="0">
        <tr lang="en">number of steps</tr>
        <tr lang="ru">количество шагов</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @auto -->
      <property name="@auto" type="bool" default="0">
        <tr lang="en">auto reset mode. If true: reset to @from value after the ramp is finished</tr>
        <tr lang="ru">режим автоматического сброса. Если true: сброс к значению @from после завершения перехода</tr>
      </property>
      <!-- @from -->
      <property name="@from" type="int" default="127" maxvalue="127" minvalue="0">
        <tr lang="en">start value</tr>
        <tr lang="ru">начальное значение</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" default="0" minvalue="0">
        <tr lang="en">number of steps</tr>
        <tr lang="ru">количество шагов</tr>
      </property>
      <!-- @to -->
      <property name="@to" type="int" default="127" maxvalue="127" minvalue="0">
        <tr lang="en">end value</tr>
        <tr lang="ru">конечное значение</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset to start value</tr>
          <tr lang="ru">сбросить к начальному значению</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">if VALUE &gt; 0, treat as (VALUE 127) list, otherwise as (-VALUE, 0)</tr>
          <tr lang="ru">если VALUE &gt; 0, трактовать как список (VALUE 127), иначе как (-VALUE, 0)</tr>
        </in>
        <in on="list">
          <tr lang="en">NOTE [VELOCITY] list expected</tr>
          <tr lang="ru">ожидается список НОТА [СКОРОСТЬ]</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">outputs NOTE VELOCITY pair</tr>
          <tr lang="ru">выводит пару НОТА СКОРОСТЬ</tr>
        </out>
      </outlet>
      <outlet>
        <out type="bang">
          <tr lang="en">when destination value is reached</tr>
          <tr lang="ru">при достижении конечного значения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
|                            [reset(
|                            |
[midi.vramp 30 127 12 @auto 1]
|
[msg note]
|
[fluid~ sf2/VintageDreamsWaves-v2.sf2]
*|*
[ui.hgain2~]     [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
