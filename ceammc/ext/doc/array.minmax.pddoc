<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.minmax">
    <title>array.minmax</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">find minimal and max values in the array</tr>
        <tr lang="ru">поиск минимального и максимального значения в массиве</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array minmax</keywords>
      <since>0.3</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object finds the minimum and maximum values in the specified array and
        outputs them together with their positions. The first outlet outputs a list of two values:
        MIN MAX. The second outlet outputs a list of their indexes: MIN_INDEX MAX_INDEX.</tr>
        <tr lang="ru">Объект находит минимальное и максимальное значения в указанном массиве и
        выводит их вместе с их позициями. Из первого выхода выводится список из двух значений:
        MIN MAX. Из второго выхода выводится список их индексов: MIN_INDEX MAX_INDEX.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array to search</tr>
        <tr lang="ru">имя массива для поиска</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array to search</tr>
        <tr lang="ru">имя массива для поиска</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">performs the search in the current array</tr>
          <tr lang="ru">выполняет поиск в текущем массиве</tr>
        </in>
        <in on="symbol">
          <tr lang="en">sets a new array and performs the search</tr>
          <tr lang="ru">устанавливает новый массив и выполняет поиск</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">minimal and maximum value</tr>
          <tr lang="ru">минимальное и максимальное значение</tr>
        </out>
      </outlet>
      <outlet>
        <out type="list">
          <tr lang="en">indexes of the found values</tr>
          <tr lang="ru">индексы найденных значений</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                            [array amm size=100 w=180 h=130]
|
[array.minmax amm]
|              ^|
[ui.d #a]      [ui.d #b]

[loadmsg sinesum 100 0.2 0.3]
|
[s amm]
#a @float_width 3 @auto_size 0 @size 100 20
#b @auto_size 0 @size 100 20
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
