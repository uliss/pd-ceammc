<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="proto.midi.casio">
        <title>proto.midi.casio</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Casio Privia MIDI control</tr>
                <tr lang="ru">управление Casio Privia MIDI</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>proto</category>
            <keywords>parser midi casio</keywords>
            <since>0.9.5</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: only PX160 model supported at this moment</tr>
            </par>
            <par>
                <tr lang="en">Note: on PX160 instrument change done only for incoming midi
                signals.</tr>
            </par>
        </info>
        <properties>
            <!-- @model -->
            <property name="@model" type="symbol" default="px160" enum="px160">
                <tr lang="en">device model</tr>
            </property>
        </properties>
        <methods>
            <!-- chorus -->
            <method name="chorus">
                <info>
                    <tr lang="en">set chorus fx level</tr>
                </info>
                <param name="VALUE" type="float" required="true" minvalue="0" maxvalue="1">
                    <tr lang="en">level</tr>
                </param>
            </method>
            <!-- chorus_depth -->
            <method name="chorus_depth">
                <info>
                    <tr lang="en">set chorus depth</tr>
                </info>
                <param name="DEPTH" type="float" minvalue="0" maxvalue="1" required="true">
                    <tr lang="en">depth value</tr>
                </param>
            </method>
            <!-- chorus_fb -->
            <method name="chorus_fb">
                <info>
                    <tr lang="en">set chorus feedback level</tr>
                </info>
                <param name="AMOUNT" type="float" minvalue="0" maxvalue="1" required="true">
                    <tr lang="en">level</tr>
                </param>
            </method>
            <!-- chorus_rate -->
            <method name="chorus_rate">
                <info>
                    <tr lang="en">set chorus rate</tr>
                </info>
                <param name="RATE" type="float" minvalue="0" maxvalue="1" required="true">
                    <tr lang="en">rate value</tr>
                </param>
            </method>
            <!-- chorus_send -->
            <method name="chorus_send">
                <info>
                    <tr lang="en">set chorus send level</tr>
                </info>
                <param name="AMOUNT" type="float" minvalue="0" maxvalue="1" required="true">
                    <tr lang="en">level</tr>
                </param>
            </method>
            <!-- chorus_type -->
            <method name="chorus_type">
                <info>
                    <tr lang="en">set chorus type</tr>
                </info>
                <param name="TYPE" type="int" minvalue="1" maxvalue="4" required="true">
                    <tr lang="en">chorus type. For PX160 - 1: chorus1, 2: chorus2, 3: deep chorus,
                    4: flanger</tr>
                </param>
            </method>
            <!-- instr -->
            <method name="instr">
                <info>
                    <tr lang="en">send Note On message</tr>
                </info>
                <param name="CH" type="int" minvalue="0" maxvalue="15" required="false">
                    <tr lang="en">midi channel</tr>
                </param>
                <param name="NAME" type="symbol" enum="piano epiano strings bass organ vibr harps"
                required="true">
                    <tr lang="en">instrument name</tr>
                </param>
                <param name="TYPE" type="atom" required="true">
                    <tr lang="en">instrument type. for 'piano':
                    concert|modern|classic|mellow|bright|0..4, for 'epiano': 0|1|fm|2|3|60, for
                    'strings': 0|1, for 'bass': 0, for 'organ': pipe|jass|elec1|elec2|0..3, for
                    'vibr' and 'haprs': 0</tr>
                </param>
            </method>
            <!-- rev_time -->
            <method name="rev_time">
                <info>
                    <tr lang="en">set reverb time</tr>
                </info>
                <param name="AMOUNT" type="int" minvalue="0" maxvalue="127" required="true">
                    <tr lang="en">reverb time</tr>
                </param>
            </method>
            <!-- rev_type -->
            <method name="rev_type">
                <info>
                    <tr lang="en">set reverb type</tr>
                </info>
                <param name="TYPE" type="int" minvalue="1" maxvalue="4" required="true">
                    <tr lang="en">reverb type. For PX160 - 1: room, 2: default (hall), 3: hall2, 4:
                    stadium</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">control messages</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>float: raw midi output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.midi]          /*choose CASIO output device!*/

[ui.tab piano epiano strings bass organ vibr harps @size 310 15]
|
[$2(   [ui.hrd 6]   [T]
|      |.           |
[flow.pack' 2]      [metro.wchoice 120 85% 240 15%]
|                   |
[msg instr 0]       [random.a 58 56 46 53 41 @nonrep 1]
|                   |
[proto.midi.casio]  [makenote 100 90]
|                   | ^|.
[midiout]           [noteout #z]

[proto.midi.casio-rev]

[proto.midi.casio-chorus]
]]>
            </pdascii>
            <pdascii id="rev">
<![CDATA[
[ui.hrd 5]     [ui.knob]
|              |
|              |
[rev_type $1(  [rev_time $1(
|              |
|              |
|              |
[proto.midi.casio]
|
[midiout]
]]>
            </pdascii>
            <pdascii id="chorus">
<![CDATA[
[ui.hrd 5]        [ui.knob]
|                 |
|                 |
[chorus_type $1(  [chorus_depth $1 #a(
|
| [ui.hsl @show_value 1]
| |
| [chorus $1(
| |
[proto.midi.casio  #z]
|
[midiout]

[X a->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
