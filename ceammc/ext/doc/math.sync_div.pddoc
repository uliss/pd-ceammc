<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.sync_div">
        <title>math.sync_div</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sync division</tr>
                <tr lang="ru">синхронное деление</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math division sync</keywords>
            <aliases>
                <alias>math./'</alias>
                <alias>ceammc//'</alias>
                <alias>/'</alias>
            </aliases>
            <since>0.8</since>
        </meta>
        <info>
            <par>
                <tr lang="en">on division by zero outputs nothing: just put error message into
                console</tr>
                <!-- old: на деление на ноль ничего не выводит: просто
                поместите сообщение об ошибке в консоль -->
                <tr lang="ru" finished="false">на деление на ноль ничего не выводит: просто
                поместите сообщение об ошибке в консоль</tr>
            </par>
        </info>
        <arguments>
            <argument name="DIV" type="float">
                <tr lang="en">divisor</tr>
                <tr lang="ru" finished="false">делитель</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @int -->
            <property name="@int" type="flag" default="0" access="initonly">
                <tr lang="en">operate on integers only</tr>
                <tr lang="ru" finished="false">работать только на целых числах</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">set divident, calculate and output result</tr>
                    <!-- old: установить делитель, вычислить и получить
                    результат -->
                    <tr lang="ru" finished="false">установить делитель, вычислить и получить
                    результат</tr>
                </in>
                <in on="list">
                    <tr lang="en">pair: set divident and divisor, calculate and output result</tr>
                    <!-- old: пара: установленный делитель и делитель,
                    вычисление и выходной результат -->
                    <tr lang="ru" finished="false">пара: установленный делитель и делитель,
                    вычисление и выходной результат</tr>
                </in>
            </inlet>
            <inlet>
                <in on="float">
                    <tr lang="en">change divisor, calculate and output result</tr>
                    <!-- old: изменение делителя, вычисление и выходной
                    результат -->
                    <tr lang="ru" finished="false">изменение делителя, вычисление и выходной
                    результат</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">division result</tr>
                    <tr lang="ru" finished="false">Результат деления</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]   [F]   /*same as:*/ [F]  [F]
|     |                  |    |
|     |                  |    [t b f]
|     |.                 |    | ^|.
[math.sync_div 2]        [/ 2      ]
|                        |
[F]                      [F]

[3.1415 5.1( [13 0(
|            |
|            |
[math.sync_div @int]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
