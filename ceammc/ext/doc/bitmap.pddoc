<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="bitmap">
        <title>bitmap</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">binary image (2D bit matrix)</tr>
                <tr lang="ru">бинарное изображение (битовая 2D-матрица)</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>bitmap</keywords>
            <also>
                <see view="link">ui.matrix</see>
            </also>
            <since>0.9.8</since>
            <aliases>
                <alias>ceammc/bitmap</alias>
            </aliases>
        </meta>
        <mouse>
            <event type="left-click" editmode="false" keys="Shift">open bitmap viewer
            window</event>
        </mouse>
        <arguments>
            <argument name="W" type="int" minvalue="1" maxvalue="256">
                <tr lang="en">bitmap width in pixels, see @w</tr>
            </argument>
            <argument name="H" type="int" minvalue="1" maxvalue="256">
                <tr lang="en">bitmap height in pixels, see @h</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @h -->
            <property name="@h" type="int" default="8" minvalue="1" maxvalue="256"
            access="initonly">
                <tr lang="en">bitmap height in pixels</tr>
            </property>
            <!-- @w -->
            <property name="@w" type="int" default="8" minvalue="1" maxvalue="256"
            access="initonly">
                <tr lang="en">bitmap width in pixels</tr>
            </property>
        </properties>
        <methods>
            <!-- arc -->
            <method name="arc">
                <info>
                    <tr lang="en">draw arc</tr>
                </info>
                <param name="X" type="int" required="true">
                    <tr lang="en">x coord</tr>
                </param>
                <param name="Y" type="int" required="true">
                    <tr lang="en">y coord</tr>
                </param>
                <param name="D" type="int" required="true">
                    <tr lang="en">diameter</tr>
                </param>
                <param name="START" type="int" required="true" units="degree">
                    <tr lang="en">start angle. 0 - top</tr>
                </param>
                <param name="LEN" type="int" required="true" units="degree">
                    <tr lang="en">arc length, counter-clockwise</tr>
                </param>
                <param name="CENTER" type="bool" required="false" default="0">
                    <tr lang="en">if 1: set coordinate of the arc center, not the top-left
                    corner</tr>
                </param>
            </method>
            <!-- circle -->
            <method name="circle">
                <info>
                    <tr lang="en">draw circle</tr>
                </info>
                <param name="X" type="int" required="true">
                    <tr lang="en">x coord</tr>
                </param>
                <param name="Y" type="int" required="true">
                    <tr lang="en">y coord</tr>
                </param>
                <param name="D" type="int" required="true">
                    <tr lang="en">diameter</tr>
                </param>
                <param name="CENTER" type="bool" required="false" default="0">
                    <tr lang="en">if 1: set coordinate of the circle center, not the top-left
                    corner</tr>
                </param>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clear bitmap (set all pixels to 0)</tr>
                </info>
            </method>
            <!-- column -->
            <method name="column">
                <info>
                    <tr lang="en">draw column</tr>
                </info>
                <param name="COL" type="int" required="true">
                    <tr lang="en">column</tr>
                </param>
                <param name="H" type="int" required="true">
                    <tr lang="en">column height, can be negative(!), to draw in opposite
                    direction</tr>
                </param>
                <param name="DY" type="int" required="true">
                    <tr lang="en">y offset</tr>
                </param>
            </method>
            <!-- ellipse -->
            <method name="ellipse">
                <info>
                    <tr lang="en">draw ellipse</tr>
                </info>
                <param name="X" type="int" required="true">
                    <tr lang="en">x coord</tr>
                </param>
                <param name="Y" type="int" required="true">
                    <tr lang="en">y coord</tr>
                </param>
                <param name="W" type="int" required="true">
                    <tr lang="en">width</tr>
                </param>
                <param name="H" type="int" required="true">
                    <tr lang="en">height</tr>
                </param>
                <param name="CENTER" type="bool" required="false" default="0">
                    <tr lang="en">if 1: set coordinate of the ellipse center, not the top-left
                    corner</tr>
                </param>
            </method>
            <!-- fill -->
            <method name="fill">
                <info>
                    <tr lang="en">set all pixels to value</tr>
                </info>
                <param name="V" type="int" default="0">
                    <tr lang="en">value</tr>
                </param>
            </method>
            <!-- fill_color -->
            <method name="fill_color">
                <info>
                    <tr lang="en">set fill color</tr>
                </info>
                <param name="COLOR" type="int">
                    <tr lang="en">fill color (0, 1 or -1 if no color)</tr>
                </param>
            </method>
            <!-- font -->
            <method name="font">
                <info>
                    <tr lang="en">set font</tr>
                </info>
                <param name="NAME" type="symbol" required="true"
                enum="FONT_4X6 FONT_5X7 FONT_5X8 FONT_6X10 FONT_6X9">
                    <tr lang="en">font name</tr>
                </param>
            </method>
            <!-- get list -->
            <method name="get list">
                <info>
                    <tr lang="en">output content as list</tr>
                </info>
            </method>
            <!-- get matrix -->
            <method name="get matrix">
                <info>
                    <tr lang="en">output bitmap content as: [matrix NROWS NCOLS DATA...(
                    message</tr>
                </info>
            </method>
            <!-- get submatrix -->
            <method name="get submatrix">
                <info>
                    <tr lang="en">output submatrix bitmap content as: [matrix NROWS NCOLS DATA...(
                    message</tr>
                </info>
                <param name="NROWS" type="int" required="true">
                    <tr lang="en">matrix number of rows</tr>
                </param>
                <param name="NCOLS" type="int" required="true">
                    <tr lang="en">matrix number of columns</tr>
                </param>
                <param name="AT_ROW" type="int" required="true">
                    <tr lang="en">row position</tr>
                </param>
                <param name="AT_COL" type="int" required="true">
                    <tr lang="en">columns position</tr>
                </param>
            </method>
            <!-- hshift -->
            <method name="hshift">
                <info>
                    <tr lang="en">horizontal shift (rotate)</tr>
                </info>
                <param name="V" type="int" required="true">
                    <tr lang="en">number of pixels to shift</tr>
                </param>
            </method>
            <!-- invert -->
            <method name="invert">
                <info>
                    <tr lang="en">invert all pixel values</tr>
                </info>
            </method>
            <!-- line -->
            <method name="line">
                <info>
                    <tr lang="en">draw line</tr>
                </info>
                <param name="X0" type="int" required="true">
                    <tr lang="en">x0 coord</tr>
                </param>
                <param name="Y0" type="int" required="true">
                    <tr lang="en">y0 coord</tr>
                </param>
                <param name="X1" type="int" required="true">
                    <tr lang="en">x1 coord</tr>
                </param>
                <param name="Y1" type="int" required="true">
                    <tr lang="en">y1 coord</tr>
                </param>
            </method>
            <!-- load -->
            <method name="load">
                <info>
                    <tr lang="en">load image to bitmap</tr>
                </info>
                <param name="FILE" type="symbol" required="true">
                    <tr lang="en">image path, relative, or absolute</tr>
                </param>
                <param name="SCALE" type="float" minvalue="0" default="1">
                    <tr lang="en">image scale</tr>
                </param>
            </method>
            <!-- mirror -->
            <method name="mirror">
                <info>
                    <tr lang="en">mirror bitmap</tr>
                </info>
                <param name="AXIS" type="symbol" enum="x y" required="true">
                    <tr lang="en">mirror axis</tr>
                </param>
            </method>
            <!-- pixel -->
            <method name="pixel">
                <info>
                    <tr lang="en">set pixel</tr>
                </info>
                <param name="X" type="int" required="true">
                    <tr lang="en">x coord</tr>
                </param>
                <param name="Y" type="int" required="true">
                    <tr lang="en">y coord</tr>
                </param>
                <param name="VAL" type="bool" required="false" default="1">
                    <tr lang="en">new pixel value</tr>
                </param>
            </method>
            <!-- rect -->
            <method name="rect">
                <info>
                    <tr lang="en">draw rect</tr>
                </info>
                <param name="X" type="int" required="true">
                    <tr lang="en">x coord</tr>
                </param>
                <param name="Y" type="int" required="true">
                    <tr lang="en">y coord</tr>
                </param>
                <param name="W" type="int" required="true">
                    <tr lang="en">width</tr>
                </param>
                <param name="H" type="int" required="true">
                    <tr lang="en">height</tr>
                </param>
                <param name="CENTER" type="bool" required="false" default="0">
                    <tr lang="en">if 1: set coordinate of the rect center, not the top-left
                    corner</tr>
                </param>
            </method>
            <!-- row -->
            <method name="row">
                <info>
                    <tr lang="en">draw draw</tr>
                </info>
                <param name="ROW" type="int" required="true">
                    <tr lang="en">row</tr>
                </param>
                <param name="W" type="int" required="true">
                    <tr lang="en">row width, can be negative(!), to draw in opposite right to
                    left</tr>
                </param>
                <param name="DX" type="int" required="true">
                    <tr lang="en">x offset</tr>
                </param>
            </method>
            <!-- save -->
            <method name="save">
                <info>
                    <tr lang="en">save bitmap to PNG file</tr>
                </info>
                <param name="PATH" type="symbol">
                    <tr lang="en">file name, absolute, or relative</tr>
                </param>
            </method>
            <!-- sector -->
            <method name="sector">
                <info>
                    <tr lang="en">draw sector</tr>
                </info>
                <param name="X" type="int" required="true">
                    <tr lang="en">x coord</tr>
                </param>
                <param name="Y" type="int" required="true">
                    <tr lang="en">y coord</tr>
                </param>
                <param name="D" type="int" required="true">
                    <tr lang="en">diameter</tr>
                </param>
                <param name="START" type="int" required="true" units="degree">
                    <tr lang="en">start angle. 0 - top</tr>
                </param>
                <param name="LEN" type="int" required="true" units="degree">
                    <tr lang="en">arc length, counter-clockwise</tr>
                </param>
                <param name="CENTER" type="bool" required="false" default="0">
                    <tr lang="en">if 1: set coordinate of the sector center, not the top-left
                    corner</tr>
                </param>
            </method>
            <!-- set list -->
            <method name="set list">
                <info>
                    <tr lang="en">set bitmap content from list</tr>
                </info>
                <param name="DATA" type="list" required="true">
                    <tr lang="en">list of 0 and 1</tr>
                </param>
            </method>
            <!-- set matrix -->
            <method name="set matrix">
                <info>
                    <tr lang="en">set matrix data</tr>
                </info>
                <param name="NROWS" type="int" minvalue="1" required="true">
                    <tr lang="en">matrix number of rows</tr>
                </param>
                <param name="NCOLS" type="int" minvalue="1" required="true">
                    <tr lang="en">matrix number of columns</tr>
                </param>
                <param name="DATA" type="list" required="true">
                    <tr lang="en">data</tr>
                </param>
            </method>
            <!-- set matrix_at -->
            <method name="set matrix_at">
                <info>
                    <tr lang="en">set matrix data at specified position</tr>
                </info>
                <param name="NROWS" type="int" minvalue="1" required="true">
                    <tr lang="en">matrix number of rows</tr>
                </param>
                <param name="NCOLS" type="int" minvalue="1" required="true">
                    <tr lang="en">matrix number of columns</tr>
                </param>
                <param name="AT_ROW" type="int" required="true">
                    <tr lang="en">row position</tr>
                </param>
                <param name="AT_COL" type="int" required="true">
                    <tr lang="en">columns position</tr>
                </param>
                <param name="DATA" type="list" required="true">
                    <tr lang="en">data</tr>
                </param>
            </method>
            <!-- stroke_color -->
            <method name="stroke_color">
                <info>
                    <tr lang="en">set stroke color</tr>
                </info>
                <param name="COLOR" type="int">
                    <tr lang="en">stroke color (0 or 1)</tr>
                </param>
            </method>
            <!-- stroke_width -->
            <method name="stroke_width">
                <info>
                    <tr lang="en">set stroke width</tr>
                </info>
                <param name="W" type="int" minvalue="0" required="true">
                    <tr lang="en">new width</tr>
                </param>
            </method>
            <!-- text -->
            <method name="text">
                <info>
                    <tr lang="en">draw text</tr>
                </info>
                <param name="X" type="int" required="true">
                    <tr lang="en">left x-coord</tr>
                </param>
                <param name="Y" type="int" required="true">
                    <tr lang="en">bottom y-coord</tr>
                </param>
                <param name="TXT" type="symbol" required="true">
                    <tr lang="en">text</tr>
                </param>
            </method>
            <!-- text_color -->
            <method name="text_color">
                <info>
                    <tr lang="en">set text color</tr>
                </info>
                <param name="COLOR" type="int">
                    <tr lang="en">fill color (0, 1 or -1 if no color)</tr>
                </param>
            </method>
            <!-- triangle -->
            <method name="triangle">
                <info>
                    <tr lang="en">draw triangle</tr>
                </info>
                <param name="X0" type="int" required="true">
                    <tr lang="en">x0 coord</tr>
                </param>
                <param name="Y0" type="int" required="true">
                    <tr lang="en">y0 coord</tr>
                </param>
                <param name="X1" type="int" required="true">
                    <tr lang="en">x1 coord</tr>
                </param>
                <param name="Y1" type="int" required="true">
                    <tr lang="en">y1 coord</tr>
                </param>
                <param name="X2" type="int" required="true">
                    <tr lang="en">x2 coord</tr>
                </param>
                <param name="Y2" type="int" required="true">
                    <tr lang="en">y2 coord</tr>
                </param>
            </method>
            <!-- view -->
            <method name="view">
                <info>
                    <tr lang="en">opens bitmap view window</tr>
                </info>
            </method>
            <!-- vshift -->
            <method name="vshift">
                <info>
                    <tr lang="en">vertical shift</tr>
                </info>
                <param name="V" type="int" required="true">
                    <tr lang="en">number of pixels to shift</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output as list</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[clear #a(            [rect 1 2 10 5 #f(  [mirror x #b1(

  [fill 1 #b(         [clear, ellipse 1 2 10 5 #g(

  [invert #c(         [clear, text 1 6 Hi! #h(

  [fill_color 1 #d(   [clear, line 0 7 15 0 #i(

  [fill_color 0 #e(   [pixel 15 7 #l(

  [stroke_width 1 #j( [triangle 0 0 8 0 4 7 #m(

  [stroke_width 2 #k( [arc 1 1 6 0 270 #n(

  [font FONT_4x6 #o(  [set list 0 1 0 1 0 1 1 #t(

  [font FONT_5x7 #p(  [set matrix 3 3 1 0 1 0 1 0 1 0 1 #u(

  [hshift 1 #r(       [set matrix_at 2 2 6 10 1 0 0 1 #v(

  [hshift -1 #s(      [row 1 10 1 #a1(  [save ~/bitmap.png #c1(




[msg.after bang #x]
|
[bitmap 16 8]
|
[ui.matrix 8 16]


/* ... */
[X a->x] [X b->x] [X c->x] [X d->x] [X e->x]
[X f->x] [X g->x] [X h->x] [X i->x] [X j->x] [X k->x]
[X l->x] [X m->x] [X n->x] [X o->x] [X p->x]
[X r->x] [X s->x] [X t->x] [X u->x] [X v->x]
[X a1->x] [X b1->x] [X c1->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
