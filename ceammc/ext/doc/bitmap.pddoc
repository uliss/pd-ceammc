<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="bitmap">
    <title>bitmap</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">binary image (2D bit matrix)</tr>
        <tr lang="ru">бинарное изображение (битовая 2D-матрица)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>bitmap</keywords>
      <also>
        <see view="link">ui.matrix</see>
      </also>
      <since>0.9.8</since>
      <aliases>
        <alias>ceammc/bitmap</alias>
      </aliases>
    </meta>
    <mouse>
      <event type="left-click" editmode="false" keys="Shift">open bitmap viewer window</event>
    </mouse>
    <arguments>
      <argument name="W" type="int" minvalue="1" maxvalue="256">
        <tr lang="en">bitmap width in pixels, see @w</tr>
        <tr lang="ru">ширина растрового изображения в пикселях, см. @w</tr>
      </argument>
      <argument name="H" type="int" minvalue="1" maxvalue="256">
        <tr lang="en">bitmap height in pixels, see @h</tr>
        <tr lang="ru">высота растрового изображения в пикселях, см. @h</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @h -->
      <property name="@h" type="int" default="8" minvalue="1" maxvalue="256" access="initonly">
        <tr lang="en">bitmap height in pixels</tr>
        <tr lang="ru">высота растрового изображения в пикселях</tr>
      </property>
      <!-- @w -->
      <property name="@w" type="int" default="8" minvalue="1" maxvalue="256" access="initonly">
        <tr lang="en">bitmap width in pixels</tr>
        <tr lang="ru">ширина растрового изображения в пикселях</tr>
      </property>
    </properties>
    <methods>
      <!-- arc -->
      <method name="arc">
        <info>
          <tr lang="en">draw an arc</tr>
          <tr lang="ru">нарисовать дугу</tr>
        </info>
        <param name="X" type="int" required="true">
          <tr lang="en">x coordinate</tr>
          <tr lang="ru">координата x</tr>
        </param>
        <param name="Y" type="int" required="true">
          <tr lang="en">y coordinate</tr>
          <tr lang="ru">координата y</tr>
        </param>
        <param name="D" type="int" required="true">
          <tr lang="en">diameter</tr>
          <tr lang="ru">диаметр</tr>
        </param>
        <param name="START" type="int" required="true" units="degree">
          <tr lang="en">start angle. 0 = top</tr>
          <tr lang="ru">начальный угол. 0 — верх</tr>
        </param>
        <param name="LEN" type="int" required="true" units="degree">
          <tr lang="en">arc length, counter-clockwise</tr>
          <tr lang="ru">длина дуги, против часовой стрелки</tr>
        </param>
        <param name="CENTER" type="bool" required="false" default="0">
          <tr lang="en">if 1: set the center of the arc, not the top-left corner</tr>
          <tr lang="ru">если 1: использовать координату центра дуги, а не верхнего левого угла</tr>
        </param>
      </method>
      <!-- circle -->
      <method name="circle">
        <info>
          <tr lang="en">draw a circle</tr>
          <tr lang="ru">нарисовать окружность</tr>
        </info>
        <param name="X" type="int" required="true">
          <tr lang="en">x coordinate</tr>
          <tr lang="ru">координата x</tr>
        </param>
        <param name="Y" type="int" required="true">
          <tr lang="en">y coordinate</tr>
          <tr lang="ru">координата y</tr>
        </param>
        <param name="D" type="int" required="true">
          <tr lang="en">diameter</tr>
          <tr lang="ru">диаметр</tr>
        </param>
        <param name="CENTER" type="bool" required="false" default="0">
          <tr lang="en">if 1: set the center of the circle, not the top-left corner</tr>
          <tr lang="ru">если 1: использовать координату центра окружности, а не верхнего левого угла</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clear the bitmap (set all pixels to 0)</tr>
          <tr lang="ru">очистить растровое изображение (установить все пиксели в 0)</tr>
        </info>
      </method>
      <!-- column -->
      <method name="column">
        <info>
          <tr lang="en">draw a column</tr>
          <tr lang="ru">нарисовать столбец</tr>
        </info>
        <param name="COL" type="int" required="true">
          <tr lang="en">column index</tr>
          <tr lang="ru">индекс столбца</tr>
        </param>
        <param name="H" type="int" required="true">
          <tr lang="en">column height (can be negative to draw in the opposite direction)</tr>
          <tr lang="ru">высота столбца (может быть отрицательной для рисования в противоположном направлении)</tr>
        </param>
        <param name="DY" type="int" required="true">
          <tr lang="en">y offset</tr>
          <tr lang="ru">смещение по y</tr>
        </param>
      </method>
      <!-- ellipse -->
      <method name="ellipse">
        <info>
          <tr lang="en">draw an ellipse</tr>
          <tr lang="ru">нарисовать эллипс</tr>
        </info>
        <param name="X" type="int" required="true">
          <tr lang="en">x coordinate</tr>
          <tr lang="ru">координата x</tr>
        </param>
        <param name="Y" type="int" required="true">
          <tr lang="en">y coordinate</tr>
          <tr lang="ru">координата y</tr>
        </param>
        <param name="W" type="int" required="true">
          <tr lang="en">width</tr>
          <tr lang="ru">ширина</tr>
        </param>
        <param name="H" type="int" required="true">
          <tr lang="en">height</tr>
          <tr lang="ru">высота</tr>
        </param>
        <param name="CENTER" type="bool" required="false" default="0">
          <tr lang="en">if 1: set the center of the ellipse, not the top-left corner</tr>
          <tr lang="ru">если 1: использовать координату центра эллипса, а не верхнего левого угла</tr>
        </param>
      </method>
      <!-- fill -->
      <method name="fill">
        <info>
          <tr lang="en">set all pixels to a value</tr>
          <tr lang="ru">установить все пиксели в заданное значение</tr>
        </info>
        <param name="V" type="int" default="0">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- fill_color -->
      <method name="fill_color">
        <info>
          <tr lang="en">set the fill color</tr>
          <tr lang="ru">установить цвет заливки</tr>
        </info>
        <param name="COLOR" type="int">
          <tr lang="en">fill color (0, 1, or -1 for no color)</tr>
          <tr lang="ru">цвет заливки (0, 1 или -1 — без цвета)</tr>
        </param>
      </method>
      <!-- font -->
      <method name="font">
        <info>
          <tr lang="en">set the font</tr>
          <tr lang="ru">установить шрифт</tr>
        </info>
        <param name="NAME" type="symbol" required="true"
        enum="FONT_4X6 FONT_5X7 FONT_5X8 FONT_6X10 FONT_6X9">
          <tr lang="en">font name</tr>
          <tr lang="ru">название шрифта</tr>
        </param>
      </method>
      <!-- get list -->
      <method name="get list">
        <info>
          <tr lang="en">output content as a list</tr>
          <tr lang="ru">вывести содержимое в виде списка</tr>
        </info>
      </method>
      <!-- get matrix -->
      <method name="get matrix">
        <info>
          <tr lang="en">output bitmap content as a [matrix NROWS NCOLS DATA...( message</tr>
          <tr lang="ru">вывести содержимое растрового изображения в виде сообщения [matrix NROWS NCOLS DATA...(</tr>
        </info>
      </method>
      <!-- get submatrix -->
      <method name="get submatrix">
        <info>
          <tr lang="en">output submatrix bitmap content as a [matrix NROWS NCOLS DATA...( message</tr>
          <tr lang="ru">вывести содержимое субматрицы растрового изображения в виде сообщения [matrix NROWS NCOLS DATA...(</tr>
        </info>
        <param name="NROWS" type="int" required="true">
          <tr lang="en">number of rows in the matrix</tr>
          <tr lang="ru">количество строк в матрице</tr>
        </param>
        <param name="NCOLS" type="int" required="true">
          <tr lang="en">number of columns in the matrix</tr>
          <tr lang="ru">количество столбцов в матрице</tr>
        </param>
        <param name="AT_ROW" type="int" required="true">
          <tr lang="en">starting row position</tr>
          <tr lang="ru">начальная позиция по строкам</tr>
        </param>
        <param name="AT_COL" type="int" required="true">
          <tr lang="en">starting column position</tr>
          <tr lang="ru">начальная позиция по столбцам</tr>
        </param>
      </method>
      <!-- hshift -->
      <method name="hshift">
        <info>
          <tr lang="en">horizontal shift (rotate)</tr>
          <tr lang="ru">горизонтальный сдвиг (поворот)</tr>
        </info>
        <param name="V" type="int" required="true">
          <tr lang="en">number of pixels to shift</tr>
          <tr lang="ru">количество пикселей для сдвига</tr>
        </param>
      </method>
      <!-- invert -->
      <method name="invert">
        <info>
          <tr lang="en">invert all pixel values</tr>
          <tr lang="ru">инвертировать все значения пикселей</tr>
        </info>
      </method>
      <!-- line -->
      <method name="line">
        <info>
          <tr lang="en">draw a line</tr>
          <tr lang="ru">нарисовать линию</tr>
        </info>
        <param name="X0" type="int" required="true">
          <tr lang="en">x0 coordinate</tr>
          <tr lang="ru">координата x0</tr>
        </param>
        <param name="Y0" type="int" required="true">
          <tr lang="en">y0 coordinate</tr>
          <tr lang="ru">координата y0</tr>
        </param>
        <param name="X1" type="int" required="true">
          <tr lang="en">x1 coordinate</tr>
          <tr lang="ru">координата x1</tr>
        </param>
        <param name="Y1" type="int" required="true">
          <tr lang="en">y1 coordinate</tr>
          <tr lang="ru">координата y1</tr>
        </param>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">load an image into the bitmap</tr>
          <tr lang="ru">загрузить изображение</tr>
        </info>
        <param name="FILE" type="symbol" required="true">
          <tr lang="en">image path, relative or absolute</tr>
          <tr lang="ru">путь к изображению, относительный или абсолютный</tr>
        </param>
        <param name="SCALE" type="float" minvalue="0" default="1">
          <tr lang="en">image scale</tr>
          <tr lang="ru">масштаб изображения</tr>
        </param>
      </method>
      <!-- mirror -->
      <method name="mirror">
        <info>
          <tr lang="en">mirror the bitmap</tr>
          <tr lang="ru">зеркально отразить растровое изображение</tr>
        </info>
        <param name="AXIS" type="symbol" enum="x y" required="true">
          <tr lang="en">mirror axis</tr>
          <tr lang="ru">ось отражения</tr>
        </param>
      </method>
      <!-- pixel -->
      <method name="pixel">
        <info>
          <tr lang="en">set a pixel</tr>
          <tr lang="ru">установить пиксель</tr>
        </info>
        <param name="X" type="int" required="true">
          <tr lang="en">x coordinate</tr>
          <tr lang="ru">координата x</tr>
        </param>
        <param name="Y" type="int" required="true">
          <tr lang="en">y coordinate</tr>
          <tr lang="ru">координата y</tr>
        </param>
        <param name="VAL" type="bool" required="false" default="1">
          <tr lang="en">pixel value</tr>
          <tr lang="ru">значение пикселя</tr>
        </param>
      </method>
      <!-- rect -->
      <method name="rect">
        <info>
          <tr lang="en">draw a rectangle</tr>
          <tr lang="ru">нарисовать прямоугольник</tr>
        </info>
        <param name="X" type="int" required="true">
          <tr lang="en">x coordinate</tr>
          <tr lang="ru">координата x</tr>
        </param>
        <param name="Y" type="int" required="true">
          <tr lang="en">y coordinate</tr>
          <tr lang="ru">координата y</tr>
        </param>
        <param name="W" type="int" required="true">
          <tr lang="en">width</tr>
          <tr lang="ru">ширина</tr>
        </param>
        <param name="H" type="int" required="true">
          <tr lang="en">height</tr>
          <tr lang="ru">высота</tr>
        </param>
        <param name="CENTER" type="bool" required="false" default="0">
          <tr lang="en">if 1: set the center of the rectangle, not the top-left corner</tr>
          <tr lang="ru">если 1: использовать координату центра прямоугольника, а не верхнего левого угла</tr>
        </param>
      </method>
      <!-- row -->
      <method name="row">
        <info>
          <tr lang="en">draw a row</tr>
          <tr lang="ru">нарисовать строку</tr>
        </info>
        <param name="ROW" type="int" required="true">
          <tr lang="en">row index</tr>
          <tr lang="ru">индекс строки</tr>
        </param>
        <param name="W" type="int" required="true">
          <tr lang="en">row width (can be negative to draw from right to left)</tr>
          <tr lang="ru">ширина строки (может быть отрицательной для рисования справа налево)</tr>
        </param>
        <param name="DX" type="int" required="true">
          <tr lang="en">x offset</tr>
          <tr lang="ru">смещение по x</tr>
        </param>
      </method>
      <!-- save -->
      <method name="save">
        <info>
          <tr lang="en">save the bitmap to a PNG file</tr>
          <tr lang="ru">сохранить растровое изображение в PNG-файл</tr>
        </info>
        <param name="PATH" type="symbol">
          <tr lang="en">file name, absolute or relative</tr>
          <tr lang="ru">имя файла, абсолютное или относительное</tr>
        </param>
      </method>
      <!-- sector -->
      <method name="sector">
        <info>
          <tr lang="en">draw a sector</tr>
          <tr lang="ru">нарисовать сектор</tr>
        </info>
        <param name="X" type="int" required="true">
          <tr lang="en">x coordinate</tr>
          <tr lang="ru">координата x</tr>
        </param>
        <param name="Y" type="int" required="true">
          <tr lang="en">y coordinate</tr>
          <tr lang="ru">координата y</tr>
        </param>
        <param name="D" type="int" required="true">
          <tr lang="en">diameter</tr>
          <tr lang="ru">диаметр</tr>
        </param>
        <param name="START" type="int" required="true" units="degree">
          <tr lang="en">start angle. 0 = top</tr>
          <tr lang="ru">начальный угол. 0 — верх</tr>
        </param>
        <param name="LEN" type="int" required="true" units="degree">
          <tr lang="en">arc length, counter-clockwise</tr>
          <tr lang="ru">длина дуги, против часовой стрелки</tr>
        </param>
        <param name="CENTER" type="bool" required="false" default="0">
          <tr lang="en">if 1: set the center of the sector, not the top-left corner</tr>
          <tr lang="ru">если 1: использовать координату центра сектора, а не верхнего левого угла</tr>
        </param>
      </method>
      <!-- set list -->
      <method name="set list">
        <info>
          <tr lang="en">set bitmap content from a list</tr>
          <tr lang="ru">установить содержимое растрового изображения из списка</tr>
        </info>
        <param name="DATA" type="list" required="true">
          <tr lang="en">list of 0s and 1s</tr>
          <tr lang="ru">список из 0 и 1</tr>
        </param>
      </method>
      <!-- set matrix -->
      <method name="set matrix">
        <info>
          <tr lang="en">set matrix data</tr>
          <tr lang="ru">установить данные матрицы</tr>
        </info>
        <param name="NROWS" type="int" minvalue="1" required="true">
          <tr lang="en">number of rows in the matrix</tr>
          <tr lang="ru">количество строк в матрице</tr>
        </param>
        <param name="NCOLS" type="int" minvalue="1" required="true">
          <tr lang="en">number of columns in the matrix</tr>
          <tr lang="ru">количество столбцов в матрице</tr>
        </param>
        <param name="DATA" type="list" required="true">
          <tr lang="en">data</tr>
          <tr lang="ru">данные</tr>
        </param>
      </method>
      <!-- set matrix_at -->
      <method name="set matrix_at">
        <info>
          <tr lang="en">set matrix data at the specified position</tr>
          <tr lang="ru">установить данные матрицы в указанной позиции</tr>
        </info>
        <param name="NROWS" type="int" minvalue="1" required="true">
          <tr lang="en">number of rows in the matrix</tr>
          <tr lang="ru">количество строк в матрице</tr>
        </param>
        <param name="NCOLS" type="int" minvalue="1" required="true">
          <tr lang="en">number of columns in the matrix</tr>
          <tr lang="ru">количество столбцов в матрице</tr>
        </param>
        <param name="AT_ROW" type="int" required="true">
          <tr lang="en">starting row position</tr>
          <tr lang="ru">начальная позиция по строкам</tr>
        </param>
        <param name="AT_COL" type="int" required="true">
          <tr lang="en">starting column position</tr>
          <tr lang="ru">начальная позиция по столбцам</tr>
        </param>
        <param name="DATA" type="list" required="true">
          <tr lang="en">data</tr>
          <tr lang="ru">данные</tr>
        </param>
      </method>
      <!-- stroke_color -->
      <method name="stroke_color">
        <info>
          <tr lang="en">set the stroke color</tr>
          <tr lang="ru">установить цвет обводки</tr>
        </info>
        <param name="COLOR" type="int">
          <tr lang="en">stroke color (0 or 1)</tr>
          <tr lang="ru">цвет обводки (0 или 1)</tr>
        </param>
      </method>
      <!-- stroke_width -->
      <method name="stroke_width">
        <info>
          <tr lang="en">set the stroke width</tr>
          <tr lang="ru">установить ширину обводки</tr>
        </info>
        <param name="W" type="int" minvalue="0" required="true">
          <tr lang="en">new width</tr>
          <tr lang="ru">новая ширина</tr>
        </param>
      </method>
      <!-- text -->
      <method name="text">
        <info>
          <tr lang="en">draw text</tr>
          <tr lang="ru">нарисовать текст</tr>
        </info>
        <param name="X" type="int" required="true">
          <tr lang="en">left x coordinate</tr>
          <tr lang="ru">левая координата x</tr>
        </param>
        <param name="Y" type="int" required="true">
          <tr lang="en">bottom y coordinate</tr>
          <tr lang="ru">нижняя координата y</tr>
        </param>
        <param name="TXT" type="symbol" required="true">
          <tr lang="en">text</tr>
          <tr lang="ru">текст</tr>
        </param>
      </method>
      <!-- text_color -->
      <method name="text_color">
        <info>
          <tr lang="en">set the text color</tr>
          <tr lang="ru">установить цвет текста</tr>
        </info>
        <param name="COLOR" type="int">
          <tr lang="en">text color (0, 1, or -1 for no color)</tr>
          <tr lang="ru">цвет текста (0, 1 или -1 — без цвета)</tr>
        </param>
      </method>
      <!-- triangle -->
      <method name="triangle">
        <info>
          <tr lang="en">draw a triangle</tr>
          <tr lang="ru">нарисовать треугольник</tr>
        </info>
        <param name="X0" type="int" required="true">
          <tr lang="en">x0 coordinate</tr>
          <tr lang="ru">координата x0</tr>
        </param>
        <param name="Y0" type="int" required="true">
          <tr lang="en">y0 coordinate</tr>
          <tr lang="ru">координата y0</tr>
        </param>
        <param name="X1" type="int" required="true">
          <tr lang="en">x1 coordinate</tr>
          <tr lang="ru">координата x1</tr>
        </param>
        <param name="Y1" type="int" required="true">
          <tr lang="en">y1 coordinate</tr>
          <tr lang="ru">координата y1</tr>
        </param>
        <param name="X2" type="int" required="true">
          <tr lang="en">x2 coordinate</tr>
          <tr lang="ru">координата x2</tr>
        </param>
        <param name="Y2" type="int" required="true">
          <tr lang="en">y2 coordinate</tr>
          <tr lang="ru">координата y2</tr>
        </param>
      </method>
      <!-- view -->
      <method name="view">
        <info>
          <tr lang="en">open the bitmap viewer window</tr>
          <tr lang="ru">открыть окно просмотра растрового изображения</tr>
        </info>
      </method>
      <!-- vshift -->
      <method name="vshift">
        <info>
          <tr lang="en">vertical shift</tr>
          <tr lang="ru">вертикальный сдвиг</tr>
        </info>
        <param name="V" type="int" required="true">
          <tr lang="en">number of pixels to shift</tr>
          <tr lang="ru">количество пикселей для сдвига</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output as a list</tr>
          <tr lang="ru">вывести в виде списка</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output</tr>
          <tr lang="ru">выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[clear #a(            [rect 1 2 10 5 #f(  [mirror x #b1(

  [fill 1 #b(         [clear, ellipse 1 2 10 5 #g(

  [invert #c(         [clear, text 1 6 Hi! #h(

  [fill_color 1 #d(   [clear, line 0 7 15 0 #i(

  [fill_color 0 #e(   [pixel 15 7 #l(

  [stroke_width 1 #j( [triangle 0 0 8 0 4 7 #m(

  [stroke_width 2 #k( [arc 1 1 6 0 270 #n(

  [font FONT_4x6 #o(  [set list 0 1 0 1 0 1 1 #t(

  [font FONT_5x7 #p(  [set matrix 3 3 1 0 1 0 1 0 1 0 1 #u(

  [hshift 1 #r(       [set matrix_at 2 2 6 10 1 0 0 1 #v(

  [hshift -1 #s(      [row 1 10 1 #a1(  [save ~/bitmap.png #c1(




