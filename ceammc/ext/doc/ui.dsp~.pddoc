<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="ui.dsp~" type="gui">
        <title>ui.dsp~</title>
        <meta>
            <authors>
                <author>Pierre Guillot</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">widget to switch DSP on or off</tr>
                <tr lang="ru">виджет для включения или выключения обработки звука</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui dsp</keywords>
            <since>0.1</since>
        </meta>
        <mouse>
            <event type="left-click" editmode="false">toggle DSP processing</event>
            <event type="right-click" editmode="false">opens popup menu with items: Audio
            Settings</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_active_color.xml" />
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_pinned.xml" />
            <xi:include href="props_ui_receive.xml" />
            <xi:include href="props_ui_send.xml" />
            <!-- @size -->
            <property name="@size" type="list" default="30 30">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
        </properties>
        <methods>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">
                <tr lang="en">top left x-coord</tr>
            </param>
            <param name="Y" type="float" required="true">
                <tr lang="en">top right y-coord</tr>
            </param></method>
            <!-- settings -->
            <method name="settings">opens audio settings dialog</method>
            <!-- start -->
            <method name="start">starts audio processing</method>
            <!-- stop -->
            <method name="stop">stops audio processing</method>
        </methods>
        <inlets>
            <inlet />
        </inlets>
        <example>
            <pdascii>
<![CDATA[
[start( [stop( [settings(
|       |      |
|       |      |
[ui.dsp~       ]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
