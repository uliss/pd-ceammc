<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="math.log~">
        <title>math.log~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">natural logarithm for signals</tr>
                <tr lang="ru">натуральный логарифм для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math log</keywords>
            <also>
                <see>math.exp~</see>
                <see>math.log2</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Outputs the value of the natural logarithm</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
            </par>
            <par>
                <tr lang="en">log(1) return +0.</tr>
            </par>
            <par>
                <tr lang="en">log(+infinity) return +infinity.</tr>
            </par>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">result signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[plot.linspace~ -4 30]
|                 ^|
[math.log~]        |
|                  |.
[ui.plot~ @xlabels 1 @ylabels 1 @ymin -5 @ymax 5 @size 400 200]














[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
