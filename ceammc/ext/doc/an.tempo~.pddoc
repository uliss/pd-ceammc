<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="an.tempo~">
    <title>an.tempo~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">the signal tempo detector</tr>
        <tr lang="ru">детектор темпа сигнала</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>an</category>
      <keywords>tempo aubio bpm</keywords>
      <since>0.9.3</since>
    </meta>
    <info>
      <par>
        <tr lang="en">An audio tempo detector based on the aubio library. It analyzes the incoming
        signal and outputs the estimated tempo in BPM from the first outlet and a detection
        confidence value from the second outlet.</tr>
        <tr lang="ru">Детектор темпа сигнала на основе библиотеки aubio. Анализирует входящий
        сигнал и выводит оценку темпа в BPM из первого выхода и значение уверенности детектора
        из второго.</tr>
      </par>
      <par>
        <tr lang="en">The detection is based on onset detection: the object finds transient
        events in the signal (attacks, hits, note starts) and estimates the tempo from the
        intervals between them. The onset detection function is controlled by @method; other
        properties tune the analysis: @bs and @hs for the analysis window and hop size, @silence
        for the silence threshold, @threshold for peak-picking and @delay for compensating a
        constant system latency.</tr>
        <tr lang="ru">Детекция основана на обнаружении атак: объект находит в сигнале
        транзиентные события (атаки, удары, начала нот) и оценивает темп по интервалам между
        ними. Функция обнаружения атак управляется свойством @method; остальные свойства
        настраивают анализ: @bs и @hs — размер окна и шага, @silence — порог тишины,
        @threshold — порог пикового отбора, @delay — компенсация постоянной системной
        задержки.</tr>
      </par>
      <a href="https://aubio.org/">https://aubio.org</a>
    </info>
    <arguments>
      <argument name="BS" type="int" minvalue="64" units="sample">
        <tr lang="en">buffer size</tr>
        <tr lang="ru">размер буфера</tr>
      </argument>
      <argument name="METHOD" type="symbol"
      enum="centroid complex complexdomain decrease default energy hfc kl kurtosis phase rolloff skewness slope specdiff specflux spread wphase">
        <tr lang="en">onset detection method</tr>
        <tr lang="ru">метод обнаружения атак</tr>
      </argument>
      <argument name="HS" type="int" minvalue="0" units="sample">
        <tr lang="en">hop size (by default buffer_size/2)</tr>
        <tr lang="ru">размер шага (по умолчанию размер_буфера/2)</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_active.xml" />
      <!-- @bs -->
      <property name="@bs" type="int" minvalue="64" default="1024" units="sample"
      access="initonly">
        <tr lang="en">buffer size</tr>
        <tr lang="ru">размер буфера</tr>
      </property>
      <!-- @complex -->
      <property name="@complex" type="alias">
        <tr lang="en">alias for @method complex. Complex Domain Method onset detection function</tr>
        <tr lang="ru">сокращение для @method complex. Функция обнаружения атак Complex Domain
        Method</tr>
      </property>
      <!-- @delay -->
      <property name="@delay" type="float" minvalue="0" default="0" units="millisecond">
        <tr lang="en">constant system delay to subtract from the detection time</tr>
        <tr lang="ru">постоянная системная задержка, вычитаемая из времени обнаружения</tr>
      </property>
      <!-- @energy -->
      <property name="@energy" type="alias">
        <tr lang="en">alias for @method energy. Energy based onset detection function</tr>
        <tr lang="ru">сокращение для @method energy. Функция обнаружения атак на основе
        энергии</tr>
      </property>
      <!-- @hfc -->
      <property name="@hfc" type="alias">
        <tr lang="en">alias for @method hfc. High Frequency Content onset detection</tr>
        <tr lang="ru">сокращение для @method hfc. Обнаружение атак по высокочастотному
        содержимому</tr>
      </property>
      <!-- @hs -->
      <property name="@hs" type="int" minvalue="0" default="0" units="sample">
        <tr lang="en">hop size. 0 means @bs/2</tr>
        <tr lang="ru">размер шага. 0 означает @bs/2</tr>
      </property>
      <!-- @kl -->
      <property name="@kl" type="alias">
        <tr lang="en">alias for @method kl. Kullback-Liebler onset detection function</tr>
        <tr lang="ru">сокращение для @method kl. Функция обнаружения атак Кульбака —
        Лейблера</tr>
      </property>
      <!-- @method -->
      <property name="@method" type="symbol"
      enum="specflux phase energy hfc kl complex default specdiff wphase rolloff spread kurtosis skewness complexdomain decrease slope centroid"
      default="default">
        <tr lang="en">onset detection method. Default is hfc.</tr>
        <tr lang="ru">метод обнаружения атак. По умолчанию hfc.</tr>
      </property>
      <!-- @mkl -->
      <property name="@mkl" type="alias">
        <tr lang="en">alias for @method mkl. Modified Kullback-Liebler onset detection
        function</tr>
        <tr lang="ru">сокращение для @method mkl. Модифицированная функция обнаружения атак
        Кульбака — Лейблера</tr>
      </property>
      <!-- @phase -->
      <property name="@phase" type="alias">
        <tr lang="en">alias for @method phase. Phase Based Method onset detection function</tr>
        <tr lang="ru">сокращение для @method phase. Функция обнаружения атак Phase Based
        Method</tr>
      </property>
      <!-- @silence -->
      <property name="@silence" type="float" units="decibel" default="-90" minvalue="-90"
      maxvalue="0">
        <tr lang="en">onset detection silence threshold</tr>
        <tr lang="ru">порог тишины для обнаружения атак</tr>
      </property>
      <!-- @specdiff -->
      <property name="@specdiff" type="alias">
        <tr lang="en">alias for @method specdiff. Spectral difference method onset detection
        function</tr>
        <tr lang="ru">сокращение для @method specdiff. Функция обнаружения атак методом
        спектральной разности</tr>
      </property>
      <!-- @specflux -->
      <property name="@specflux" type="alias">
        <tr lang="en">alias for @method specflux. Spectral Flux</tr>
        <tr lang="ru">сокращение для @method specflux. Spectral Flux</tr>
      </property>
      <!-- @threshold -->
      <property name="@threshold" type="float" default="0.3">
        <tr lang="en">peak picking threshold</tr>
        <tr lang="ru">порог пикового отбора</tr>
      </property>
      <!-- @wphase -->
      <property name="@wphase" type="alias">
        <tr lang="en">alias for @method phase. Weighted Phase Deviation onset detection
        function</tr>
        <tr lang="ru">сокращение для @method phase. Функция обнаружения атак Weighted Phase
        Deviation</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">BPM value</tr>
          <tr lang="ru">значение BPM</tr>
        </out>
      </outlet>
      <outlet>
        <out type="float">
          <tr lang="en">detection confidence</tr>
          <tr lang="ru">уверенность детектора</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[loadmsg load sound/loop_breakbeat.flac to antmp @resize]
|
[snd.file]

[table antmp]  [ui.hsl @show_value 1 @min 0.1 @max 2.5]
               |
[B #a] [stop(  [@speed $1(      [ui.dsp~]
|      |       |
|      |       |
[array.play~ antmp @loop 1 #b]  [ui.menu #m]
|  |                            |
|  |                            [@method $1(
|  |                            |
|  [an.tempo~                   ]
|  |      ^|
|  [F]    [F]
|  |
|  [ui.b]
|  |
|  [click~]
|  |
|  [flt.resonbp~ 1000 50]
|  |
[ui.hgain~]
|\
[dac~]

#m hfc energy complex phase wphase specdiff specflux kl mkl
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
