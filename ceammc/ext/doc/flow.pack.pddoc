<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.pack">
    <title>flow.pack</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">packs atoms from multiple streams into a single one</tr>
        <tr lang="ru">упаковывает атомы из нескольких потоков в один</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow pack</keywords>
      <since>0.8</since>
      <also>
        <see>pack</see>
        <see>flow.sync</see>
        <see>flow.sync_pack</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object stores the last received value for each inlet and outputs all of
        them as a single list or message</tr>
        <tr lang="ru">объект хранит последнее полученное значение для каждого входа и выводит их
        все в виде одного списка или сообщения</tr>
      </par>
      <par>
        <tr lang="en">the first inlet triggers the output on bang, float, symbol, list or any
        message</tr>
        <tr lang="ru">первый вход запускает вывод по bang, числу, символу, списку или любому
        сообщению</tr>
      </par>
      <par>
        <tr lang="en">@init sets the initial values for all inlets, missing values default to
        0</tr>
        <tr lang="ru">@init задаёт начальные значения для всех входов, отсутствующие значения по
        умолчанию равны 0</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="1" maxvalue="255">
        <tr lang="en">number of inputs</tr>
        <tr lang="ru">количество входов</tr>
      </argument>
      <argument name="INIT" type="list">
        <tr lang="en">default values for all inlets. If not enough default values are given, the
        rest is set to 0.</tr>
        <tr lang="ru">значения по умолчанию для всех входов. Если значений по умолчанию не хватает,
        остальные устанавливаются в 0</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @init -->
      <property name="@init" type="list" access="initonly" default="">
        <tr lang="en">default init values</tr>
        <tr lang="ru">значения инициализации по умолчанию</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" minvalue="1" default="1" maxvalue="255" access="initonly">
        <tr lang="en">number of inlets</tr>
        <tr lang="ru">количество входов</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet number="1">
        <in on="bang">
          <tr lang="en">output current value</tr>
          <tr lang="ru">вывести текущее значение</tr>
        </in>
        <in on="float">
          <tr lang="en">change first packed value and output</tr>
          <tr lang="ru">изменить первое упакованное значение и вывести</tr>
        </in>
        <in on="symbol">
          <tr lang="en">change first packed value and output</tr>
          <tr lang="ru">изменить первое упакованное значение и вывести</tr>
        </in>
        <in on="list">
          <tr lang="en">propagate list values to other inlets and output</tr>
          <tr lang="ru">распространить значения списка на другие входы и вывести</tr>
        </in>
        <in on="any">
          <tr lang="en">propagate message values to other inlets and output</tr>
          <tr lang="ru">распространить значения сообщения на другие входы и вывести</tr>
        </in>
      </inlet>
      <inlet number="...">
        <in on="float">
          <tr lang="en">change ... packed value</tr>
          <tr lang="ru">изменить ... упакованное значение</tr>
        </in>
        <in on="symbol">
          <tr lang="en">change ... packed value</tr>
          <tr lang="ru">изменить ... упакованное значение</tr>
        </in>
        <in on="list">
          <tr lang="en">propagate ... list values among rest inlets</tr>
          <tr lang="ru">распространить ... значения списка на остальные входы</tr>
        </in>
      </inlet>
      <inlet number="n">
        <in on="float">
          <tr lang="en">change n-th packed value</tr>
          <tr lang="ru">изменить n-е упакованное значение</tr>
        </in>
        <in on="symbol">
          <tr lang="en">change n-th packed value</tr>
          <tr lang="ru">изменить n-е упакованное значение</tr>
        </in>
        <in on="list">
          <tr lang="en">propagate n-th list values among rest inlets</tr>
          <tr lang="ru">распространить значения n-го списка на остальные входы</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">packed list or message (if message input)</tr>
          <tr lang="ru">упакованный список или сообщение (если на вход подан message)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]  [F]   [F]  [1 2(   [1 2 3( [F]
|    |     |    |       |       |
|    |     |.   |       |       |..
[flow.pack 3 0 0 ABC {w=20}       ]
|
[ui.dt]

[a b c(
|
[flow.pack 5 @init 1 2 3 4 5]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
