<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hoa.2d.recomposer~">
    <title>hoa.2d.recomposer~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
        <author>Pierre Guillot</author>
        <author>Eliott Paris</author>
        <author>Thomas Le Meur</author>
      </authors>
      <description>
        <tr lang="en">recomposes a 2d plane wave decomposition into circular harmonics</tr>
        <tr lang="ru">восстанавливает двумерное разложение плоских волн в круговые гармоники</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>spat</category>
      <keywords>hoa recomposer</keywords>
      <since>0.8</since>
      <also>
        <see>hoa.2d.projector~</see>
      </also>
      <aliases>
        <alias>hoa.recomposer~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Recomposes a plane wave decomposition into circular harmonics. There are
        three modes: fixe (default), fisheye and free.</tr>
        <tr lang="ru">Восстанавливает разложение плоских волн в круговые гармоники. Поддерживаются
        три режима: fixe (по умолчанию), fisheye и free.</tr>
      </par>
      <a href="hoa/hoa.2d.recomposer~-help.pd">CICM documentation</a>
    </info>
    <arguments>
      <argument name="ORDER" type="int" minvalue="1" maxvalue="63">
        <tr lang="en">the order of decomposition</tr>
        <tr lang="ru">порядок декомпозиции</tr>
      </argument>
      <argument name="N" type="int" minvalue="0" maxvalue="128">
        <tr lang="en">number of channels. '0' means auto-calculation.</tr>
        <tr lang="ru">число каналов. '0' — автоматический расчёт</tr>
      </argument>
      <argument name="MODE" type="symbol" enum="fixe fisheye free">
        <tr lang="en">recomposition mode. There are three modes: *fixe* — simply recomposes a
        plane wave decomposition into circular harmonics. *fisheye* — allows you to perform an
        operation similar to the visual "fisheye" effect by distorting the sound field perspective
        toward the front of the scene. *free* — allows you to change the angles and the widening
        value for each channel.</tr>
        <tr lang="ru">режим восстановления. Поддерживаются три режима: *fixe* — просто
        восстанавливает разложение плоских волн в круговые гармоники. *fisheye* — позволяет
        выполнить операцию, аналогичную визуальному эффекту «рыбий глаз», искажая перспективу
        звукового поля к передней части сцены. *free* — позволяет задавать углы и степень
        расширения для каждого канала отдельно.</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @fisheye -->
      <property name="@fisheye" type="alias" access="initonly">
        <tr lang="en">alias for @mode fisheye</tr>
        <tr lang="ru">сокращение для @mode fisheye</tr>
      </property>
      <!-- @fixe -->
      <property name="@fixe" type="alias" access="initonly">
        <tr lang="en">alias for @mode fixe</tr>
        <tr lang="ru">сокращение для @mode fixe</tr>
      </property>
      <!-- @free -->
      <property name="@free" type="alias" access="initonly">
        <tr lang="en">alias for @mode free</tr>
        <tr lang="ru">сокращение для @mode free</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" enum="fixe fisheye free" default="free"
      access="initonly">
        <tr lang="en">recomposition mode. There are three modes: *fixe* — simply recomposes a
        plane wave decomposition into circular harmonics. *fisheye* — allows you to perform an
        operation similar to the visual "fisheye" effect by distorting the sound field perspective
        toward the front of the scene. *free* — allows you to change the angles and the widening
        value for each channel.</tr>
        <tr lang="ru">режим восстановления. Поддерживаются три режима: *fixe* — просто
        восстанавливает разложение плоских волн в круговые гармоники. *fisheye* — позволяет
        выполнить операцию, аналогичную визуальному эффекту «рыбий глаз», искажая перспективу
        звукового поля к передней части сцены. *free* — позволяет задавать углы и степень
        расширения для каждого канала отдельно.</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" minvalue="0" maxvalue="128" default="0" access="initonly">
        <tr lang="en">number of channels (plane waves). '0' means auto-calculation.</tr>
        <tr lang="ru">число каналов (плоских волн). '0' — автоматический расчёт</tr>
      </property>
      <!-- @order -->
      <property name="@order" type="int" minvalue="1" maxvalue="63" default="1" access="initonly">
        <tr lang="en">the order of decomposition</tr>
        <tr lang="ru">порядок декомпозиции</tr>
      </property>
      <!-- @ramp -->
      <property name="@ramp" type="float" default="100" minvalue="0">
        <tr lang="en">ramp time</tr>
        <tr lang="ru">время плавного перехода</tr>
      </property>
    </properties>
    <methods>
      <!-- angles -->
      <method name="angles">
        <info>
          <tr lang="en">sets the angles of the channels. Angles are in radians and are wrapped
          between 0 and 2π</tr>
          <tr lang="ru">устанавливает углы каналов. Углы задаются в радианах и приводятся к
          диапазону от 0 до 2π</tr>
        </info>
        <param name="VALS" type="list" required="true" units="radian">
          <tr lang="en">list of angles</tr>
          <tr lang="ru">список углов</tr>
        </param>
      </method>
      <!-- wide -->
      <method name="wide">
        <info>
          <tr lang="en">sets the widening value of the channels. The widening value is clipped
          between 0 (omnidirectional) and 1 (directional)</tr>
          <tr lang="ru">устанавливает степень расширения каналов. Значение расширения
          ограничивается диапазоном от 0 (всенаправленный) до 1 (направленный)</tr>
        </info>
        <param name="VALS" type="list" required="true">
          <tr lang="en">list of values per channel</tr>
          <tr lang="ru">список значений по каналам</tr>
        </param>
      </method>
    </methods>
    <inlets dynamic="true">
      <inlet type="audio">
        <in>
          <tr lang="en">input harmonic</tr>
          <tr lang="ru">входная гармоника</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">input harmonic</tr>
          <tr lang="ru">входная гармоника</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">input harmonic. If @fisheye mode is used: fisheye factor [0, 1] on the
          last inlet</tr>
          <tr lang="ru">входная гармоника. Если используется режим @fisheye: коэффициент fisheye
          [0, 1] на последнем входе</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet type="audio">
        <out type="any">
          <tr lang="en">first plane wave output</tr>
          <tr lang="ru">выход первой плоской волны</tr>
        </out>
      </outlet>
      <outlet type="audio" number="...">
        <out type="any">
          <tr lang="en">... plane wave output</tr>
          <tr lang="ru">... выход плоской волны</tr>
        </out>
      </outlet>
      <outlet type="audio" number="n">
        <out type="any">
          <tr lang="en">n-th plane wave output</tr>
          <tr lang="ru">выход n-й плоской волны</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[hoa/hoa.soundgrain]
|
[ui.gain~ @size 120 14]
|
[hoa.2d.encoder~ 7 16 {w=46}]
*|*
[hoa.projector~ 7 16 {w=46,i=16,o=16}]
*|*
[hoa.process~ 16 hoa/hoa.fx.delay2~ planewaves {w=46,i=17,o=16}]
*|*
[hoa.process~ 16 hoa/hoa.fx.gain~ planewaves 1 {w=46,i=17,o=16}]
*|*
[hoa.2d.recomposer~ 7 16 {w=46,i=16,o=15}]
*|* *|*
*|* *|*
*|* [hoa.scope~ 7 @gain 4 @size 164 164 {i=15}]
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
[hoa.decoder~ 7 regular {w=46,i=15,o=16}] [ui.dsp~]
*|*
[xdac~ 1:16 {w=46,i=16}]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
