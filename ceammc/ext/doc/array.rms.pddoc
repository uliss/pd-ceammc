<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.rms">
    <title>array.rms</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">calculates the root-mean-square value for the array</tr>
        <tr lang="ru">вычисляет среднеквадратичное значение для массива</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array mean rms square</keywords>
      <since>0.7.1</since>
      <also>
        <see>array.mean</see>
        <see>array.sum2</see>
      </also>
    </meta>
    <info>
      <wiki name="Root_mean_square">Root mean square</wiki>
      <par>
        <tr lang="en">The object computes the root-mean-square (RMS) value of all samples in the
        specified array and outputs it as a single float. The RMS is calculated as the square root
        of the arithmetic mean of the squares of the samples.</tr>
        <tr lang="ru">Объект вычисляет среднеквадратичное (RMS) значение всех семплов указанного
        массива и выводит его одним числом с плавающей точкой. RMS вычисляется как квадратный
        корень из среднего арифметического квадратов семплов.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">calculates the RMS value and outputs it</tr>
          <tr lang="ru">вычисляет значение RMS и выводит его</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">RMS value</tr>
          <tr lang="ru">среднеквадратичное значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                       [array arms size=300 w=300 h=100]
|
[array.rms arms]
|
[F digits=16]



[uniform( [sin 100( [gauss 0 0.3( [fill 0( [pulse 50( [tri 60(
|         |         |             |        |          |
|         |         |             |        |          |
|         |         |             |        |          |
[array.fill                                       arms]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
