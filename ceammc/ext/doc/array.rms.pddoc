<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="array.rms">
        <title>array.rms</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">calculates the root mean square value for the array</tr>
                <tr lang="ru">вычисляет среднее квадратичное значение для массива</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array mean rms square</keywords>
            <since>0.7.1</since>
            <also>
                <see>array.mean</see>
                <see>array.sum2</see>
            </also>
        </meta>
        <info>
            <wiki name="Root_mean_square">Root mean square</wiki>
        </info>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">calculates and outputs RMS value</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>RMS value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]                       [array arms size=300 w=300 h=100]
|
[array.rms arms]
|
[F digits=16]



[uniform( [sin 100( [gauss 0 0.3( [fill 0( [pulse 50( [tri 60(
|         |         |             |        |          |
|         |         |             |        |          |
|         |         |             |        |          |
[array.fill                                       arms]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
