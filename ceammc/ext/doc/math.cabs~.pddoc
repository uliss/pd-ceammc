<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.cabs~">
        <title>math.cabs~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">magnitude of a complex signals</tr>
                <tr lang="ru">абсолютное значение комплексного сигнала</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math complex magnitude module</keywords>
            <aliases>
                <alias>ceammc/cabs~</alias>
                <alias>cabs~</alias>
            </aliases>
            <since>0.9</since>
            <also>
                <see>math.carg~</see>
            </also>
        </meta>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">real part of input signal</tr>
                </xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">imag part of input signal</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">signal magnitude</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.slider2d @show_grid 1 @size 100 100]
|
|
|
|
|
|
|
[unpack f f]
|       ^|
[sig~] [sig~]
|      |.
[math.cabs~]  [ui.dsp~]
|
[ui.n~]
]]>
            </pdascii>
        </example>
    </object>
