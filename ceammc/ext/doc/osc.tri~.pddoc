<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="osc.tri~">
    <title>osc.tri~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">bandlimited triangle wave oscillator</tr>
        <tr lang="ru">осциллятор треугольной волны с ограниченным спектром</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>osc</category>
      <keywords>oscillator band-limited</keywords>
      <since>0.1</since>
      <also>
        <see>osc.saw~</see>
        <see>osc.square~</see>
        <see>lfo.tri~</see>
      </also>
    </meta>
    <arguments>
      <argument name="FREQ" type="float" minvalue="0.0" maxvalue="22050" units="hertz">
        <tr lang="en">see @freq</tr>
        <tr lang="ru">см. @freq</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @freq -->
      <property name="@freq" type="float" default="0" minvalue="0" maxvalue="22050" units="hertz">
        <tr lang="en">frequency</tr>
        <tr lang="ru">частота</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">frequency in Hz</tr>
          <tr lang="ru">частота в Гц</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">reset the phase</tr>
          <tr lang="ru">сбросить фазу</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal in the range [-1, 1]</tr>
          <tr lang="ru">выходной сигнал в диапазоне [-1, 1]</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]       [ui.dsp~]
|
[$1 50(
|
[line~]     [bang(
|           |.
[osc.tri~    ]
|
[ui.gain~ @size 120 14]
|\      |
[dac~]  [ui.scope~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
