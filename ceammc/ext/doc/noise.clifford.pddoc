<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="noise.clifford">
    <title>noise.clifford</title>
    <meta>
      <authors>
        <author>André Sier</author>
      </authors>
      <description>
        <tr lang="en">Clifford attractor</tr>
        <tr lang="ru">аттрактор Клиффорда</tr>
      </description>
      <license>BSD</license>
      <library>ceammc</library>
      <category>noise</category>
      <keywords>noise</keywords>
      <since>0.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Clifford Attractors</tr>
        <tr lang="ru" finished="false">Клиффордские аттракторы</tr>
      </par>
      <par>
        <tr lang="en">Attributed to Cliff Pickover</tr>
        <tr lang="ru" finished="false">Оригинальное название: Cliff Pickover</tr>
      </par>
      <par>
        <tr lang="en">x[n+1] = sin(a*y[n]) + c*cos(a*x[n])</tr>
        <tr lang="ru" finished="false">x[n+1] = sin(a*y[n]) + c*cos(a*x[n])</tr>
      </par>
      <par>
        <tr lang="en">y[n+1] = sin(b*x[n]) + d*cos(b*y[n])</tr>
        <tr lang="ru" finished="false">y[n+1] ] = sin(b*x[n]) + d*cos(b*y[n])</tr>
      </par>
      <par>
        <tr lang="en">where a, b, c, d are variables that define each attractor.</tr>
        <!-- old: где a, b, c, d - переменные, определяющие каждый
                аттрактор. -->
        <tr lang="ru" finished="false">где a, b, c, d - переменные, определяющие каждый
        аттрактор.</tr>
      </par>
    </info>
    <arguments>
      <argument name="X" type="float">
        <tr lang="en">x value (optional)</tr>
        <tr lang="ru" finished="false">x значение (необязательно)</tr>
      </argument>
      <argument name="Y" type="float">
        <tr lang="en">y value (optional)</tr>
        <tr lang="ru" finished="false">y значение (факультативно)</tr>
      </argument>
      <argument name="A" type="float">
        <tr lang="en">a value (optional)</tr>
        <tr lang="ru" finished="false">значение (факультативно)</tr>
      </argument>
      <argument name="B" type="float">
        <tr lang="en">b value (optional)</tr>
        <tr lang="ru" finished="false">b значение (факультативно)</tr>
      </argument>
      <argument name="C" type="float">
        <tr lang="en">c value (optional)</tr>
        <tr lang="ru" finished="false">c значение (факультативно)</tr>
      </argument>
      <argument name="D" type="float">
        <tr lang="en">d value (optional)</tr>
        <tr lang="ru" finished="false">d значение (факультативно)</tr>
      </argument>
    </arguments>
    <methods>
      <!-- a -->
      <method name="a">
        <param name="A" type="float" required="true">
          <tr lang="en">a value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
      </method>
      <!-- b -->
      <method name="b">
        <param name="B" type="float" required="true">
          <tr lang="en">b value</tr>
          <tr lang="ru" finished="false">b значение</tr>
        </param>
      </method>
      <!-- c -->
      <method name="c">
        <param name="C" type="float" required="true">
          <tr lang="en">c value</tr>
          <tr lang="ru" finished="false">c значение</tr>
        </param>
      </method>
      <!-- d -->
      <method name="d">
        <param name="D" type="float" required="true">
          <tr lang="en">d value</tr>
          <tr lang="ru" finished="false">d значение</tr>
        </param>
      </method>
      <!-- om -->
      <method name="om">
        <param name="OM" type="int" required="true">
          <tr lang="en">enables output when cut or fold value is changed</tr>
          <!-- old: позволяет вывод при изменении значения разреза
                    или сгиба -->
          <tr lang="ru" finished="false">позволяет вывод при изменении значения разреза или
          сгиба</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset state</tr>
          <tr lang="ru" finished="false">состояние сброса</tr>
        </info>
      </method>
      <!-- set -->
      <method name="set">
        <param name="SET" type="float" required="true">
          <tr lang="en">set to value</tr>
          <tr lang="ru" finished="false">установить ценность</tr>
        </param>
      </method>
      <!-- x -->
      <method name="x">
        <param name="X" type="float" required="true">
          <tr lang="en">x value</tr>
          <tr lang="ru" finished="false">x значение</tr>
        </param>
      </method>
      <!-- y -->
      <method name="y">
        <param name="Y" type="float" required="true">
          <tr lang="en">y value</tr>
          <tr lang="ru" finished="false">y значение</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output value</tr>
          <tr lang="ru" finished="false">выходная стоимость</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">x output</tr>
          <tr lang="ru" finished="false">x выходной выход</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">y output</tr>
          <tr lang="ru" finished="false">y выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]     [ui.dsp~] [set -1.4 1.6 1.0 0.7 #x0( [set 1.7 1.7 0.06 1.2 #x3(
|
[metro 50 #metro]  [set 1.1 -1.0 1.0 1.5 #x1( [set 1.3 1.7 0.5 1.4 #x4(

  [T]         [F]  [set 1.6 -0.6 -1.2 1.6 #x2(
  |           |
  [om $1 #om( [set $1 #set( [reset #reset(

 [F]           [F]
 |             |
 [x $1 #x-msg( [y $1 #y-msg(  

    [F]       [F]       [F]       [F]
    |         |         |         |
    [a $1 #a( [b $1 #b( [c $1 #c( [d $1 #d(

[noise.clifford -1.4 1.6 1 0.7 #noise-obj]
|
[l->l -2 2 3 30] [l->l -2 2 0 20 #f0]
|
[lop~ 20]        [l->l -2 2 100 2000 #f1]
|
[osc.saw~]
|
[flt.resonlp~ #fx]
|
[dyn.limit~]
|
[ui.hgain~]
|\
[dac~]

[X x-msg:0->noise-obj]
[X y-msg:0->noise-obj]

[X noise-obj:0->f1]
[X noise-obj:1->f0]
[X f1->fx:1]
[X f0->fx:2]

[X a->noise-obj]
[X b->noise-obj]
[X c->noise-obj]
[X d->noise-obj]

[X x0->noise-obj]
[X x1->noise-obj]
[X x2->noise-obj]
[X x3->noise-obj]
[X x4->noise-obj]

[X om:0->noise-obj:0]
[X set:0->noise-obj:0]
[X reset:0->noise-obj:0]

[X metro->noise-obj]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
