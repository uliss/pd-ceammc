<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="path.exists">
        <title>path.exists</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks if the given path exists</tr>
                <tr lang="ru">проверка существования пути</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>path</category>
            <keywords>path exists</keywords>
            <since>0.1</since>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">checks if given path exists</tr>
                </xinfo>
                <xinfo on="data">
                    <tr lang="en">If string given - checks if path exists</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>1 - on success, 0 - if not exists</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[symbol .( [symbol ABC( [B]
|          |            |
|          |            [string test]
|          |            |
[path.exists            ]
|
[T]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
