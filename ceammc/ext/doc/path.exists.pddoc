<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="path.exists">
    <title>path.exists</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">checks if the given path exists</tr>
        <tr lang="ru">проверяет, существует ли заданный путь</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>path</category>
      <keywords>path exists</keywords>
      <since>0.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object checks whether the given path exists in the file system</tr>
        <tr lang="ru">объект проверяет, существует ли заданный путь в файловой системе</tr>
      </par>
      <par>
        <tr lang="en">the result is output as 1 if the path exists, otherwise 0</tr>
        <tr lang="ru">результат выводится как 1, если путь существует, иначе 0</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">checks if the given path exists</tr>
          <tr lang="ru">проверяет, существует ли заданный путь</tr>
        </in>
        <in on="data">
          <tr lang="en">if a string is given, checks if the path exists</tr>
          <tr lang="ru">если передана строка, проверяет, существует ли путь</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">1 on success, 0 if not exists</tr>
          <tr lang="ru">1 при успехе, 0 если не существует</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[symbol .( [symbol ABC( [B]
|          |            |
|          |            [string test]
|          |            |
[path.exists            ]
|
[T]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
