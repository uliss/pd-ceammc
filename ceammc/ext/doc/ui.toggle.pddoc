<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.toggle" type="gui">
        <title>ui.toggle</title>
        <meta>
            <authors>
                <author>Pierre Guillot</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">modern toggle widget</tr>
                <tr lang="ru">cовременный виджет переключателя</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui toggle</keywords>
            <since>0.1</since>
            <aliases>
                <alias view="link">ui.t</alias>
            </aliases>
            <also>
                <see view="link">ui.bang</see>
            </also>
        </meta>
        <info>
            <par>This is the ceammc counterpart of the vanilla toggle</par>
        </info>
        <mouse>
            <event type="left-click" editmode="0">toggles state</event>
            <event type="double-click" editmode="0" keys="Shift">toggle MIDI-learn mode (red border
            displayed)</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_active_color.xml" />
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <!-- @midi_channel -->
            <property name="@midi_channel" type="int" minvalue="0" maxvalue="16" default="0">
                <tr lang="en">binded MIDI channel. 0 means listen to all channels</tr>
            </property>
            <!-- @midi_control -->
            <property name="@midi_control" type="int" minvalue="-1" maxvalue="127" default="-1">
                <tr lang="en">binded MIDI controller number. -1 means not binded to any
                controller.</tr>
            </property>
            <!-- @off_value -->
            <property name="@off_value" type="float" default="0">
                <tr lang="en">output off value</tr>
            </property>
            <!-- @on_value -->
            <property name="@on_value" type="float" default="1">
                <tr lang="en">output on value</tr>
            </property>
            <xi:include href="props_pinned.xml" />
            <!-- @presetname -->
            <property name="@presetname" type="symbol" default="(null)">
                <tr lang="en">preset name for using with [ui.preset]</tr>
            </property>
            <!-- @receive -->
            <property name="@receive" type="symbol" default="(null)">
                <tr lang="en">receive source</tr>
            </property>
            <!-- @send -->
            <property name="@send" type="symbol" default="(null)">
                <tr lang="en">send destination</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="15 15">
            <tr lang="en">object size (width, height pair)</tr>
            <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="int" default="0" enum="0 1">
                <tr lang="en">widget logical value</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">clears specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
            <!-- dump -->
            <method name="dump">dumps all object info to Pd console window</method>
            <!-- interp -->
            <method name="interp">for this object acts as *load*, no interpolation
            performed</method>
            <!-- load -->
            <method name="load">loads specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
            <!-- set -->
            <method name="set">sets toggle state without output</method>
            <!-- store -->
            <method name="store">stores specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">change toggle state</xinfo>
                <xinfo on="float">if *0* given, sets state to unchecked and outputs @off_value. On
                any other number sets to checked state and outputs @on_value</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>outputs @on_value or @off_value (by default 0 or 1)</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
                  [T]
                  |
[B] [0( [1( [-1(  [set $1(
|   |   |   |     |
|   |   |   |     |
[ui.toggle @size=40x40]  [ui.t @on_value 90 @off_value -90]
|                        |
|                        [F] /*other on/off values*/
|
[ui.display]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
