<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.toggle" type="gui">
    <title>ui.toggle</title>
    <meta>
      <authors>
        <author>Pierre Guillot</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">modern toggle widget</tr>
        <tr lang="ru">современный виджет-переключатель</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui toggle</keywords>
      <since>0.1</since>
      <aliases>
        <alias view="link">ui.t</alias>
      </aliases>
      <also>
        <see view="link">ui.bang</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">this is the ceammc counterpart of the vanilla toggle</tr>
        <tr lang="ru">это аналог стандартного переключателя в ceammc</tr>
      </par>
      <par>
        <tr lang="en">the widget has two states (on and off) and outputs @on_value or @off_value depending on the current state</tr>
        <tr lang="ru">виджет имеет два состояния (вкл и выкл) и выводит @on_value или @off_value в зависимости от текущего состояния</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="0">toggles state</event>
      <event type="double-click" editmode="0" keys="Shift">toggle MIDI-learn mode (red border
      displayed)</event>
      <event type="right-click" editmode="false" keys="Shift">open object help</event>
      <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
      <event type="right-click" editmode="true">opens Pd popup menu</event>
      <event type="right-click" editmode="true" keys="Shift">open object help</event>
      <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
    </mouse>
    <properties>
      <xi:include href="props_active_color.xml" />
      <xi:include href="props_background_color.xml" />
      <xi:include href="props_border_color.xml" />
      <xi:include href="props_fontname.xml" />
      <xi:include href="props_fontsize.xml" />
      <xi:include href="props_fontslant.xml" />
      <xi:include href="props_fontweight.xml" />
      <xi:include href="props_pinned.xml" />
      <xi:include href="props_ui_receive.xml" />
      <xi:include href="props_ui_send.xml" />
      <xi:include href="props_midi_channel.xml" />
      <xi:include href="props_preset.xml" />
      <!-- @midi_control -->
      <property name="@midi_control" type="int" minvalue="-1" maxvalue="127" default="-1">
        <tr lang="en">bound MIDI controller number. -1 means not bound to any controller</tr>
        <tr lang="ru">привязанный номер MIDI-контроллера. -1 означает, что контроллер не привязан</tr>
      </property>
      <!-- @off_value -->
      <property name="@off_value" type="float" default="0">
        <tr lang="en">output value in the off state</tr>
        <tr lang="ru">выходное значение в выключенном состоянии</tr>
      </property>
      <!-- @on_value -->
      <property name="@on_value" type="float" default="1">
        <tr lang="en">output value in the on state</tr>
        <tr lang="ru">выходное значение во включённом состоянии</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="15 15">
        <tr lang="en">object size (width, height pair)</tr>
        <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
      </property>
      <!-- @value -->
      <property name="@value" type="int" default="0" enum="0 1">
        <tr lang="en">widget logical value</tr>
        <tr lang="ru">логическое значение виджета</tr>
      </property>
    </properties>
    <methods>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clears the specified preset</tr>
          <tr lang="ru">очищает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- dump -->
      <method name="dump">
        <info>
          <tr lang="en">dumps all object info to the Pd console window</tr>
          <tr lang="ru">выводит всю информацию об объекте в окно консоли Pd</tr>
        </info>
      </method>
      <!-- interp -->
      <method name="interp">
        <info>
          <tr lang="en">for this object acts as *load*, no interpolation performed</tr>
          <tr lang="ru">для этого объекта действует как *load*, интерполяция не выполняется</tr>
        </info>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">loads the specified preset</tr>
          <tr lang="ru">загружает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set UI element position</tr>
          <tr lang="ru">задать положение элемента UI</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top left x-coord</tr>
          <tr lang="ru">x-координата верхнего левого угла</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top right y-coord</tr>
          <tr lang="ru">y-координата верхнего левого угла</tr>
        </param>
      </method>
      <!-- set -->
      <method name="set">
        <info>
          <tr lang="en">sets toggle state without output</tr>
          <tr lang="ru">устанавливает состояние переключателя без вывода</tr>
        </info>
      </method>
      <!-- store -->
      <method name="store">
        <info>
          <tr lang="en">stores the specified preset</tr>
          <tr lang="ru">сохраняет указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">change toggle state</tr>
          <tr lang="ru">изменить состояние переключателя</tr>
        </in>
        <in on="float">
          <tr lang="en">if 0 is given, sets state to unchecked and outputs @off_value. On any other number sets to checked state and outputs @on_value</tr>
          <tr lang="ru">если подано 0, устанавливает состояние «выкл» и выводит @off_value. При любом другом числе устанавливает состояние «вкл» и выводит @on_value</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">outputs @on_value or @off_value (by default 0 or 1)</tr>
          <tr lang="ru">выводит @on_value или @off_value (по умолчанию 0 или 1)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
                  [T]
                  |
[B] [0( [1( [-1(  [set $1(
|   |   |   |     |
|   |   |   |     |
[ui.toggle @size=40x40]  [ui.t @on_value 90 @off_value -90]
|                        |
|                        [F] /*other on/off values*/
|
[ui.display]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
