<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="data.dict">
        <title>data.dict</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">the dictionary container: stores key-values pairs</tr>
                <tr lang="ru">контейнер словаря: хранит пары ключ-значение</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data dictionary</keywords>
            <since>0.6</since>
            <also>
                <see>data.set</see>
                <see>data.mlist</see>
            </also>
            <aliases>
                <alias>ceammc/dict</alias>
                <alias>dict</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Syntax: [key1: value key2 : "with space"]. Nested dictionaries are
                supported: [a: [A:1 B:2]]).</tr>
                <tr lang="ru" finished="false">Синтаксис: [key1: value key2: "с пространством"].
                Поддерживаются вложенные словари: [a: [A:1 B:2]].</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">open data editor</event>
        </mouse>
        <properties>
            <!-- @empty -->
            <property name="@empty" type="bool" access="readonly" default="1">
                <tr lang="en">1 if dict is empty, otherwise 0</tr>
                <tr lang="ru" finished="false">1 если дикт пуст, иначе 0</tr>
            </property>
            <!-- @keys -->
            <property name="@keys" type="list" access="readonly" default="">
                <tr lang="en">keys of dictionary</tr>
                <tr lang="ru" finished="false">Ключи словаря</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="int" access="readonly" minvalue="0" default="0">
                <tr lang="en">number of entries in dictionary</tr>
                <tr lang="ru" finished="false">Количество записей в словаре</tr>
            </property>
        </properties>
        <methods>
            <!-- [....] -->
            <method name="[....]" example="true">
                <info>
                    <tr lang="en">sets new content without output</tr>
                    <tr lang="ru" finished="false">Новый контент без вывода</tr>
                </info>
            </method>
            <!-- add -->
            <method name="add">
                <info>
                    <tr lang="en">adds entry to dictionary</tr>
                    <tr lang="ru" finished="false">Добавить запись в словарь</tr>
                </info>
                <param name="KEY" type="symbol" required="true">
                    <tr lang="en">entry key</tr>
                    <tr lang="ru" finished="false">Ключ входа</tr>
                </param>
                <param name="VAL" type="list" required="true">
                    <tr lang="en">single value or list</tr>
                    <tr lang="ru" finished="false">Единое значение или список</tr>
                </param>
            </method>
            <!-- choose -->
            <method name="choose">
                <info>
                    <tr lang="en">choose random key and output it</tr>
                    <tr lang="ru" finished="false">Выберите случайный ключ и выведите его</tr>
                </info>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">removes all dict values. No output</tr>
                    <tr lang="ru" finished="false">удаляет все диктовые значения. Нет выхода</tr>
                </info>
            </method>
            <!-- get_key -->
            <method name="get_key">
                <info>
                    <tr lang="en">get entry from dictionary</tr>
                    <tr lang="ru" finished="false">Получить доступ к словарю</tr>
                </info>
                <param name="KEY" type="symbol" required="true">
                    <tr lang="en">entry key</tr>
                    <tr lang="ru" finished="false">Ключ входа</tr>
                </param>
            </method>
            <!-- read -->
            <method name="read">
                <info>
                    <tr lang="en">read dict from JSON file</tr>
                    <tr lang="ru" finished="false">Читать дикт из файла JSON</tr>
                </info>
                <param name="PATH" type="symbol" required="true">
                    <tr lang="en">file path</tr>
                    <tr lang="ru" finished="false">Файловый путь</tr>
                </param>
            </method>
            <!-- remove -->
            <method name="remove">
                <info>
                    <tr lang="en">remove entry from dictionary</tr>
                    <tr lang="ru" finished="false">Удалить запись из словаря</tr>
                </info>
                <param name="KEY" type="symbol" required="true">
                    <tr lang="en">entry key</tr>
                    <tr lang="ru" finished="false">Ключ входа</tr>
                </param>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">set dict content without output</tr>
                    <tr lang="ru" finished="false">Настройка контента без вывода</tr>
                </info>
            </method>
            <!-- set_key -->
            <method name="set_key">
                <info>
                    <tr lang="en">change entry in dictionary. If it's not exists, do nothing.</tr>
                    <tr lang="ru" finished="false">изменить запись в словаре. Если его нет, ничего
                    не делай.</tr>
                </info>
                <param name="KEY" type="symbol" required="true">
                    <tr lang="en">key</tr>
                    <tr lang="ru" finished="false">ключ</tr>
                </param>
                <param name="VAL" type="list" required="true">
                    <tr lang="en">single value or list</tr>
                    <tr lang="ru" finished="false">Единое значение или список</tr>
                </param>
            </method>
            <!-- write -->
            <method name="write">
                <info>
                    <tr lang="en">write dict as JSON file</tr>
                    <tr lang="ru" finished="false">Пишите дикт как файл JSON</tr>
                </info>
                <param name="PATH" type="symbol" required="true">
                    <tr lang="en">file path</tr>
                    <tr lang="ru" finished="false">Файловый путь</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output current dictionary value</tr>
                    <tr lang="ru" finished="false">выход текущей словарной стоимости</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">set dict from list. Key-value pairs are expected. [1 2 3 4(
                    becames dict with keys: 1 and 3, values: 2 and 4. No output</tr>
                    <tr lang="ru" finished="false">Установить диктовку из списка. Ключ Ожидаются
                    пары значений. [1 2 3 4(стали диктовать ключами: 1 и 3, значения: 2 и 4). Нет
                    выхода</tr>
                </xinfo>
                <xinfo on="data:dict">
                    <tr lang="en">set and output new dict</tr>
                    <tr lang="ru" finished="false">Установить и вывести новый дикт</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output dictionary</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang( [[a: [K0: 1 2 3 K2: "a symbol"]], bang #a( [get_key a #b(
|
|  [[a: b c: d], bang(  [clear( [remove a(
|  |                    |       |
|  |  [add KEY value(   |       | [B]
|  |  |                 |       | |
|  |  |                 |       | [openpanel]
|  |  |  [list a b c d( |       | |
|  |  |  |              |       | [read $1(
|  |  |  |              |       | |
[data.dict \[tempo: 120 title: "New Masterpiece"\] #z]
|
[ui.display @display_type 1]
[X a->z]
[X b->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
