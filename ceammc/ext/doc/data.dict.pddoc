<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="data.dict">
    <title>data.dict</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">the dictionary container: stores key-value pairs</tr>
        <tr lang="ru">контейнер словаря: хранит пары ключ-значение</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data dictionary</keywords>
      <since>0.6</since>
      <also>
        <see>data.set</see>
        <see>data.mlist</see>
      </also>
      <aliases>
        <alias>ceammc/dict</alias>
        <alias>dict</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Syntax: [key1: value key2: "with space"]. Nested dictionaries are supported:
        [a: [A:1 B:2]].</tr>
        <tr lang="ru">Синтаксис: [key1: value key2: "with space"]. Поддерживаются вложенные словари:
        [a: [A:1 B:2]].</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">open data editor</event>
    </mouse>
    <properties>
      <!-- @empty -->
      <property name="@empty" type="bool" access="readonly" default="1">
        <tr lang="en">1 if the dict is empty, otherwise 0</tr>
        <tr lang="ru">1, если словарь пуст, иначе 0</tr>
      </property>
      <!-- @keys -->
      <property name="@keys" type="list" access="readonly" default="">
        <tr lang="en">keys of the dictionary</tr>
        <tr lang="ru">ключи словаря</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="int" access="readonly" minvalue="0" default="0">
        <tr lang="en">number of entries in the dictionary</tr>
        <tr lang="ru">количество записей в словаре</tr>
      </property>
    </properties>
    <methods>
      <!-- [....] -->
      <method name="[....]" example="true">
        <info>
          <tr lang="en">sets new content without output</tr>
          <tr lang="ru">устанавливает новое содержимое без вывода</tr>
        </info>
      </method>
      <!-- add -->
      <method name="add">
        <info>
          <tr lang="en">adds an entry to the dictionary</tr>
          <tr lang="ru">добавляет запись в словарь</tr>
        </info>
        <param name="KEY" type="symbol" required="true">
          <tr lang="en">entry key</tr>
          <tr lang="ru">ключ записи</tr>
        </param>
        <param name="VAL" type="list" required="true">
          <tr lang="en">single value or list</tr>
          <tr lang="ru">одно значение или список</tr>
        </param>
      </method>
      <!-- choose -->
      <method name="choose">
        <info>
          <tr lang="en">choose a random key and output it</tr>
          <tr lang="ru">выбрать случайный ключ и вывести его</tr>
        </info>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">removes all dict values. No output</tr>
          <tr lang="ru">удаляет все значения словаря. Без вывода</tr>
        </info>
      </method>
      <!-- get_key -->
      <method name="get_key">
        <info>
          <tr lang="en">get an entry from the dictionary</tr>
          <tr lang="ru">получить запись из словаря</tr>
        </info>
        <param name="KEY" type="symbol" required="true">
          <tr lang="en">entry key</tr>
          <tr lang="ru">ключ записи</tr>
        </param>
      </method>
      <!-- read -->
      <method name="read">
        <info>
          <tr lang="en">read the dict from a JSON file</tr>
          <tr lang="ru">прочитать словарь из файла JSON</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">file path</tr>
          <tr lang="ru">путь к файлу</tr>
        </param>
      </method>
      <!-- remove -->
      <method name="remove">
        <info>
          <tr lang="en">remove an entry from the dictionary</tr>
          <tr lang="ru">удалить запись из словаря</tr>
        </info>
        <param name="KEY" type="symbol" required="true">
          <tr lang="en">entry key</tr>
          <tr lang="ru">ключ записи</tr>
        </param>
      </method>
      <!-- set -->
      <method name="set">
        <info>
          <tr lang="en">set dict content without output</tr>
          <tr lang="ru">установить содержимое словаря без вывода</tr>
        </info>
      </method>
      <!-- set_key -->
      <method name="set_key">
        <info>
          <tr lang="en">change an entry in the dictionary. If it does not exist, do nothing.</tr>
          <tr lang="ru">изменить запись в словаре. Если её нет, ничего не делать.</tr>
        </info>
        <param name="KEY" type="symbol" required="true">
          <tr lang="en">key</tr>
          <tr lang="ru">ключ</tr>
        </param>
        <param name="VAL" type="list" required="true">
          <tr lang="en">single value or list</tr>
          <tr lang="ru">одно значение или список</tr>
        </param>
      </method>
      <!-- write -->
      <method name="write">
        <info>
          <tr lang="en">write the dict as a JSON file</tr>
          <tr lang="ru">записать словарь в виде файла JSON</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">file path</tr>
          <tr lang="ru">путь к файлу</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output the current dictionary value</tr>
          <tr lang="ru">вывести текущее значение словаря</tr>
        </in>
        <in on="list">
          <tr lang="en">set the dict from a list. Key-value pairs are expected. [1 2 3 4( becomes a
          dict with keys: 1 and 3, values: 2 and 4. No output</tr>
          <tr lang="ru">установить словарь из списка. Ожидаются пары ключ-значение. [1 2 3 4(
          становится словарём с ключами: 1 и 3, значениями: 2 и 4. Без вывода</tr>
        </in>
        <in on="data:dict">
          <tr lang="en">set and output a new dict</tr>
          <tr lang="ru">установить и вывести новый словарь</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output dictionary</tr>
          <tr lang="ru">выходной словарь</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang( [[a: [K0: 1 2 3 K2: "a symbol"]], bang #a( [get_key a #b(
|
|  [[a: b c: d], bang(  [clear( [remove a(
|  |                    |       |
|  |  [add KEY value(   |       | [B]
|  |  |                 |       | |
|  |  |                 |       | [openpanel]
|  |  |  [list a b c d( |       | |
|  |  |  |              |       | [read $1(
|  |  |  |              |       | |
[data.dict \[tempo: 120 title: "New Masterpiece"\] #z]
|
[ui.display @display_type 1]
[X a->z]
[X b->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
