<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="proto.moppy">
        <title>proto.moppy</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">protocol for Musical flOPPY controller</tr>
                <tr lang="ru">nротокол для музыкального контроллера flOPPY</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>proto</category>
            <keywords>floppy diy serial</keywords>
            <since>0.9.5</since>
        </meta>
        <info>
            <a href="https://github.com/Sammy1Am/Moppy2">https://github.com/Sammy1Am/Moppy2</a>
        </info>
        <properties>
            <!-- @device -->
            <property name="@device" type="int" default="1" minvalue="1" maxvalue="255">
                <tr lang="en">moppy device ID</tr>
            </property>
            <!-- @floppy -->
            <property name="@floppy" type="int" default="1" minvalue="1" maxvalue="16">
                <tr lang="en">floppy ID on moppy device</tr>
            </property>
            <!-- @v -->
            <property name="@v" type="int" default="2" enum="2 1">
                <tr lang="en">MOPPY protocol version</tr>
            </property>
        </properties>
        <methods>
            <!-- bend:f -->
            <method name="bend:f">note pitchbend 
            <param name="VAL" type="float" required="true" minvalue="-1" maxvalue="1">
                <tr lang="en">pitch bend</tr>
            </param></method>
            <!-- freq -->
            <method name="freq">set floppy frequency. Note: moppy.v1 version only. 
            <param name="CHAN" type="int" required="false">
                <tr lang="en">optional floppy id (overrides @floppy property)</tr>
            </param>
            <param name="FREQ" type="float" required="true" units="hertz">
                <tr lang="en">freq</tr>
            </param></method>
            <!-- note -->
            <method name="note">see noteon</method>
            <!-- noteoff -->
            <method name="noteoff">note off message 
            <param name="CHAN" type="int" required="false">
                <tr lang="en">optional floppy id (overrides @floppy property)</tr>
            </param>
            <param name="NOTE" type="int" required="true" minvalue="24" maxvalue="72">
                <tr lang="en">MIDI note</tr>
            </param></method>
            <!-- noteon -->
            <method name="noteon">play note 
            <param name="CHAN" type="int" required="false">
                <tr lang="en">optional floppy id (overrides @floppy property)</tr>
            </param>
            <param name="NOTE" type="int" required="true" minvalue="24" maxvalue="72">
                <tr lang="en">MIDI note</tr>
            </param>
            <param name="VEL" type="int" required="true" minvalue="0" maxvalue="127">
                <tr lang="en">note velocity (if 0 - turns note off, otherwise ignored)</tr>
            </param></method>
            <!-- period -->
            <method name="period">directly set floppy drive period. Note: moppy.v1 version only. 
            <param name="CHAN" type="int" required="false">
                <tr lang="en">optional floppy id (overrides @floppy property)</tr>
            </param>
            <param name="TIME" type="int" required="true">
                <tr lang="en">period in microseconds</tr>
            </param></method>
            <!-- ping -->
            <method name="ping">send ping request to all devices</method>
            <!-- reset -->
            <method name="reset">reset moppy device. 
            <param name="all" type="symbol">
                <tr lang="en">reset all devices</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>commands</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list: output to moppy</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard 60 12]
|
|
|
|
|
|                  [choose(
|                  |
[msg note] [reset( [data.list 1 14 15 19]
|          |       |
|          |       [@v 1, period $1 #a(
|          |
[proto.moppy #x]   [dump(
|                  |
[hw.arduino @rate 57600]
[X a->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
