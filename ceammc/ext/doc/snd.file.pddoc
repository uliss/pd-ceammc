<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="snd.file">
    <title>snd.file</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">sound file loader with additional features</tr>
        <tr lang="ru">загрузчик звуковых файлов с дополнительными возможностями</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>snd</category>
      <keywords>soundfiler</keywords>
      <since>0.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Works with sound files: reads file info and loads them into arrays. Various
        formats are supported. Supports array name patterns.</tr>
        <tr lang="ru">Работает со звуковыми файлами: читает информацию о файлах и загружает их в
        массивы. Поддерживаются различные форматы. Поддерживает шаблоны имён массивов.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Loading samples and loops into arrays — bringing external audio files into
        a patch as Pd arrays, ready for playback with [tabplay~], [tabread4~] or processing with
        other array-based objects.</tr>
        <tr lang="ru">• Загрузка сэмплов и лупов в массивы — добавление внешних аудиофайлов в
        патч в виде массивов Pd, готовых к воспроизведению через [tabplay~], [tabread4~] или
        обработке другими объектами на массивах.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Multi-channel file handling — loading multi-channel files into multiple
        arrays at once using array name patterns, for example array_[1-4] for a 4-channel file, or
        array_[left|right] for stereo.</tr>
        <tr lang="ru">• Обработка многоканальных файлов — загрузка многоканальных файлов сразу в
        несколько массивов с помощью шаблонов имён, например array_[1-4] для четырёхканального
        файла или array_[left|right] для стерео.</tr>
      </par>
    </info>
    <properties>
      <!-- @channels -->
      <property name="@channels" type="list" access="readonly" default="">
        <tr lang="en">list of loaded channels into each array</tr>
        <tr lang="ru">список загруженных каналов в каждый массив</tr>
      </property>
      <!-- @filename -->
      <property name="@filename" type="list" access="readonly" default="">
        <tr lang="en">filename</tr>
        <tr lang="ru">имя файла</tr>
      </property>
      <!-- @formats -->
      <property name="@formats" type="list" access="readonly"
      default="AAC AIFF ALAC AU AVR CAF FLAC HTK IFF MACE3:1 MACE6:1 MAT4 MAT5 MP3 MP4 MPC OGG PAF PVF RAW RF64 SD2 SDS SF VOC W64 WAV WAVEX WVE XI">
        <tr lang="en">list of supported formats</tr>
        <tr lang="ru">список поддерживаемых форматов</tr>
      </property>
      <!-- @samples -->
      <property name="@samples" type="list" access="readonly" default="">
        <tr lang="en">list of the number of loaded samples into each array</tr>
        <tr lang="ru">список количества загруженных семплов в каждый массив</tr>
      </property>
      <!-- @smpte_fr -->
      <property name="@smpte_fr" type="float" minvalue="1" maxvalue="99" default="30">
        <tr lang="en">SMPTE framerate for SMPTE offset calculations</tr>
        <tr lang="ru">частота кадров SMPTE для расчёта смещения SMPTE</tr>
      </property>
      <!-- @sr -->
      <property name="@sr" type="list" access="readonly" default="">
        <tr lang="en">source file sample rate</tr>
        <tr lang="ru">частота дискретизации исходного файла</tr>
      </property>
      <!-- @verbose -->
      <property name="@verbose" type="bool" default="0" access="initonly">
        <tr lang="en">verbose output to the Pd window</tr>
        <tr lang="ru">подробный вывод в окно Pd</tr>
      </property>
    </properties>
    <methods>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">Loads a sound file. Outputs the info properties and the number of loaded
          samples after loading.</tr>
          <tr lang="ru">Загружает звуковой файл. Выводит свойства информации и число загруженных
          семплов после загрузки.</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">path to the sound file</tr>
          <tr lang="ru">путь к звуковому файлу</tr>
        </param>
        <param name="to ARRAY_NAME" type="symbol" required="true">
          <tr lang="en">destination array names or a pattern. Array patterns are specified in
          square brackets: array_[1-4] means array_1, array_2, array_3, array_4.
          array_[left|right] means array_left and array_right</tr>
          <tr lang="ru">имена массивов назначения или шаблон. Шаблоны массива задаются в квадратных
          скобках: array_[1-4] означает array_1, array_2, array_3, array_4.
          array_[left|right] означает array_left и array_right</tr>
        </param>
        <param name="@resize" type="property">
          <tr lang="en">resize the array to fit the loaded samples</tr>
          <tr lang="ru">изменить размер массива под загруженные семплы</tr>
        </param>
        <param name="@channel N" type="property">
          <tr lang="en">specify input channels. Space-separated list or a range x-y.</tr>
          <tr lang="ru">задать входные каналы. Список, разделённый пробелами, или диапазон x-y</tr>
        </param>
        <param name="@normalize" type="property">
          <tr lang="en">normalize the array after loading</tr>
          <tr lang="ru">нормализовать массив после загрузки</tr>
        </param>
        <param name="@gain V" type="property">
          <tr lang="en">apply gain to the loaded samples, examples: +3.1db, -6db, 0.5 etc.</tr>
          <tr lang="ru">применить усиление к загруженным семплам, примеры: +3.1db, -6db, 0.5 и
          т. д.</tr>
        </param>
        <param name="@begin X" type="property">
          <tr lang="en">specify the input file begin position, by default in samples, but you can
          use other units: 1s, 10ms, 00:01.12 (SMPTE). To specify a value relative to the file end,
          you can use the $-X syntax</tr>
          <tr lang="ru">задать начальную позицию входного файла, по умолчанию в семплах, но можно
          использовать и другие единицы: 1s, 10ms, 00:01.12 (SMPTE). Для указания значения
          относительно конца файла можно использовать синтаксис $-X</tr>
        </param>
        <param name="@end X" type="property">
          <tr lang="en">specify the input file end position, by default in samples, but you can use
          other units: 1s, 10ms, 00:01.12 (SMPTE). To specify a value relative to the file end, you
          can use the $-X syntax</tr>
          <tr lang="ru">задать конечную позицию входного файла, по умолчанию в семплах, но можно
          использовать и другие единицы: 1s, 10ms, 00:01.12 (SMPTE). Для указания значения
          относительно конца файла можно использовать синтаксис $-X</tr>
        </param>
        <param name="@length X" type="property">
          <tr lang="en">specify the input length, by default in samples, but you can use other
          units: 1s, 10ms, 00:00:02.00 (SMPTE)</tr>
          <tr lang="ru">задать длину входного фрагмента, по умолчанию в семплах, но можно
          использовать и другие единицы: 1s, 10ms, 00:00:02.00 (SMPTE)</tr>
        </param>
        <param name="@offset SAMPLES" type="property">
          <tr lang="en">offset in samples from the beginning of the file. Deprecated, use @begin
          instead</tr>
          <tr lang="ru">смещение в семплах от начала файла. Устаревшее, используйте @begin</tr>
        </param>
        <param name="@resample R?" type="property">
          <tr lang="en">if R is not specified — resample from the file sample rate to the current
          Pd sample rate. Otherwise you can manually specify R as a float value or as an integer
          fraction, for example 44100/48000</tr>
          <tr lang="ru">если R не указан — выполняется пересемплирование из частоты дискретизации
          файла в текущую частоту дискретизации Pd. Иначе можно вручную указать R как число с
          плавающей точкой или целочисленную дробь, например 44100/48000</tr>
        </param>
      </method>
      <!-- save -->
      <method name="save">
        <info>
          <tr lang="en">Saves arrays to the specified file</tr>
          <tr lang="ru">сохраняет массивы в указанный файл</tr>
        </info>
        <param name="ARRAYS" type="list" required="true">
          <tr lang="en">list of arrays</tr>
          <tr lang="ru">список массивов</tr>
        </param>
        <param name="@to FNAME" type="symbol" required="true">
          <tr lang="en">output filename</tr>
          <tr lang="ru">имя выходного файла</tr>
        </param>
        <param name="@begin X" type="property">
          <tr lang="en">specify the input array begin position, by default in samples, but you can
          use other units: 1s, 10ms, 00:01.12 (SMPTE). To specify a value relative to the array end,
          you can use the $-X syntax</tr>
          <tr lang="ru">задать начальную позицию входного массива, по умолчанию в семплах, но
          можно использовать и другие единицы: 1s, 10ms, 00:01.12 (SMPTE). Для указания значения
          относительно конца массива можно использовать синтаксис $-X</tr>
        </param>
        <param name="@end X" type="property">
          <tr lang="en">specify the input array end position, by default in samples, but you can
          use other units: 1s, 10ms, 00:01.12 (SMPTE). To specify a value relative to the array end,
          you can use the $-X syntax</tr>
          <tr lang="ru">задать конечную позицию входного массива, по умолчанию в семплах, но можно
          использовать и другие единицы: 1s, 10ms, 00:01.12 (SMPTE). Для указания значения
          относительно конца массива можно использовать синтаксис $-X</tr>
        </param>
        <param name="@gain V" type="property">
          <tr lang="en">apply gain to the saved arrays, examples: +3.1db, -6db, 0.5 etc.</tr>
          <tr lang="ru">применить усиление к сохраняемым массивам, примеры: +3.1db, -6db, 0.5 и
          т. д.</tr>
        </param>
        <param name="@in_sr SR" type="property">
          <tr lang="en">array source sample rate. If omitted, the patch sample rate is used</tr>
          <tr lang="ru">частота дискретизации исходного массива. Если не указана, используется
          частота дискретизации патча</tr>
        </param>
        <param name="@out_sr SR" type="property">
          <tr lang="en">output sample rate</tr>
          <tr lang="ru">частота дискретизации выхода</tr>
        </param>
        <param name="@norm[alize]" type="property">
          <tr lang="en">normalize output</tr>
          <tr lang="ru">нормализовать выход</tr>
        </param>
        <param name="@overwrite" type="property">
          <tr lang="en">overwrite existing file flag</tr>
          <tr lang="ru">флаг перезаписи существующего файла</tr>
        </param>
        <param name="@samp FMT" type="property">
          <tr lang="en">output sample format. Supported values are: 0 (use default), 8, 16, 24,
          32, f</tr>
          <tr lang="ru">формат выходного семпла. Поддерживаются значения: 0 (по умолчанию), 8, 16,
          24, 32, f</tr>
        </param>
        <param name="@wav" type="property">
          <tr lang="en">WAV output format</tr>
          <tr lang="ru">выходной формат WAV</tr>
        </param>
        <param name="@mp3" type="property">
          <tr lang="en">MP3 output format</tr>
          <tr lang="ru">выходной формат MP3</tr>
        </param>
        <param name="@ogg" type="property">
          <tr lang="en">Ogg/Vorbis output format</tr>
          <tr lang="ru">выходной формат Ogg/Vorbis</tr>
        </param>
        <param name="@opus" type="property">
          <tr lang="en">Opus output format</tr>
          <tr lang="ru">выходной формат Opus</tr>
        </param>
        <param name="@aiff" type="property">
          <tr lang="en">AIFF output format</tr>
          <tr lang="ru">выходной формат AIFF</tr>
        </param>
        <param name="@txt" type="property">
          <tr lang="en">TXT output format</tr>
          <tr lang="ru">выходной формат TXT</tr>
        </param>
        <param name="@raw" type="property">
          <tr lang="en">RAW output format</tr>
          <tr lang="ru">выходной формат RAW</tr>
        </param>
        <param name="@flac" type="property">
          <tr lang="en">FLAC output format</tr>
          <tr lang="ru">выходной формат FLAC</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet type="control">
        <in>
          <tr lang="en">control inlet</tr>
          <tr lang="ru">управляющий вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">number of loaded/saved samples, or -1 on error</tr>
          <tr lang="ru">число загруженных/сохранённых семплов или -1 при ошибке</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[openpanel #p1]

 [symbol %CEAMMC%/sin_ch4_44.1k.wav(
 |
 |  [symbol %CEAMMC%/sound/vla-overtones-3.mp3(
 |  |
[load $1 to array[1|2] @resize #m1(       [A array1 w=120 h=80]
|
[expand_env]
|
|
[snd.file]
|
[F digits=8]                              [A array2 w=120 h=80]

/* play */

[bang #play(  [stop #stop(
|             |
|             |
[tabplay~ array1]   [tabplay~ array2 #a2]
|                   |.
[ui.hgain2~          ]  [ui.dsp~]
|                  ^|.
[dac~                ]

[snd.file-resample] [snd.file-gain]

[snd.file-pattern]  [snd.file-pos]

[X play->a2]
[X stop->a2]
[X p1->m1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
