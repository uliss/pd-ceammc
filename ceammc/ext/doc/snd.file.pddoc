<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="snd.file">
        <title>snd.file</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sound file loader with additional features</tr>
                <tr lang="ru">загрузчик звуковых файлов с дополнительными возможностями</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>snd</category>
            <keywords>soundfiler</keywords>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Deal with sound files: gets files info and loads them into arrays.
                Various formats are supported. Supports array name patterns.</tr>
                <tr lang="ru" finished="false">Работа со звуковыми файлами: получает информацию о
                файлах и загружает их в массивы. Поддерживаются различные форматы. Поддерживает
                шаблоны имен массивов.</tr>
            </par>
        </info>
        <properties>
            <!-- @channels -->
            <property name="@channels" type="list" access="readonly" default="">
                <tr lang="en">list of loaded channels into each array</tr>
                <tr lang="ru" finished="false">Список загруженных каналов в каждый массив</tr>
            </property>
            <!-- @filename -->
            <property name="@filename" type="list" access="readonly" default="">
                <tr lang="en">filename</tr>
                <tr lang="ru" finished="false">имя файла</tr>
            </property>
            <!-- @formats -->
            <property name="@formats" type="list" access="readonly"
            default="AAC AIFF ALAC AU AVR CAF FLAC HTK IFF MACE3:1 MACE6:1 MAT4 MAT5 MP3 MP4 MPC OGG PAF PVF RAW RF64 SD2 SDS SF VOC W64 WAV WAVEX WVE XI">

                <tr lang="en">list of supported formats</tr>
                <tr lang="ru" finished="false">Список поддерживаемых форматов</tr>
            </property>
            <!-- @samples -->
            <property name="@samples" type="list" access="readonly" default="">
                <tr lang="en">list of number of loaded samples into each array</tr>
                <tr lang="ru" finished="false">Список количества загруженных образцов в каждый
                массив</tr>
            </property>
            <!-- @smpte_fr -->
            <property name="@smpte_fr" type="float" minvalue="1" maxvalue="99" default="30">
                <tr lang="en">SMPTE framerate for SMPTE offset calculations</tr>
                <tr lang="ru" finished="false">Скорость кадров SMPTE для расчетов смещения
                SMPTE</tr>
            </property>
            <!-- @sr -->
            <property name="@sr" type="list" access="readonly" default="">
                <tr lang="en">source file samplerate</tr>
                <tr lang="ru" finished="false">исходный файл samplerate</tr>
            </property>
            <!-- @verbose -->
            <property name="@verbose" type="bool" default="0" access="initonly">
                <tr lang="en">verbose output to Pd window</tr>
                <tr lang="ru" finished="false">verbose выход в окно Pd</tr>
            </property>
        </properties>
        <methods>
            <!-- load -->
            <method name="load">
                <info>
                    <tr lang="en">Loads sound file. Outputs info properties and number of loaded
                    samples after load.</tr>
                    <tr lang="ru" finished="false">Загрузил звуковой файл. Выходит информация о
                    свойствах и количестве загруженных образцов после загрузки.</tr>
                </info>
                <param name="PATH" type="symbol" required="true">
                    <tr lang="en">path to soundfile</tr>
                    <tr lang="ru" finished="false">Путь к Soundfile</tr>
                </param>
                <param name="to ARRAY_NAME" type="symbol" required="true">
                    <tr lang="en">destination array names or pattern. Array patterns specified in
                    square braces: array_[1-4] means - array_1, array_2, array_3, array_4.
                    array_[left|right] means array_left and array_right</tr>
                    <tr lang="ru" finished="false">Имена адресов или шаблоны. Узоры массива,
                    указанные в квадратных скобках: array_[1-4] означает - array_1, array_2,
                    array_3, array_4. array_[left |right] означает array_left и array_right</tr>
                </param>
                <param name="@resize" type="property">
                    <tr lang="en">resize array to fit loaded samples</tr>
                    <tr lang="ru" finished="false">размер массива для установки загруженных
                    образцов</tr>
                </param>
                <param name="@channel N" type="property">
                    <tr lang="en">specify input channels. Spaces separated list or range x-y.</tr>
                    <tr lang="ru" finished="false">Укажите входные каналы. Пространства,
                    разделенные списком или диапазоном x-y.</tr>
                </param>
                <param name="@normalize" type="property">
                    <tr lang="en">normalize array after loading</tr>
                    <tr lang="ru" finished="false">нормализовать массив после загрузки</tr>
                </param>
                <param name="@gain V" type="property">
                    <tr lang="en">apply gain to loaded samples, examples: +3.1db, -6db, 0.5
                    etc.</tr>
                    <tr lang="ru" finished="false">применять коэффициент усиления к загруженным
                    образцам, примерам: +3.1db, -6db, 0,5 и т.д.</tr>
                </param>
                <param name="@begin X" type="property">
                    <tr lang="en">specify input file begin position, by default in samples, but you
                    can use other units: 1s, 10ms, 00:01.12 (smpte). To specify value relative to
                    file end you can use $-X syntax</tr>
                    <tr lang="ru" finished="false">указать начальную позицию входного файла, по
                    умолчанию в выборках, но можно использовать и другие блоки: 1s, 10ms, 00:01.12
                    (smpte). Для указания значения относительно конца файла можно использовать
                    синтаксис $-X</tr>
                </param>
                <param name="@end X" type="property">
                    <tr lang="en">specify input file end position, by default in samples, but you
                    can use other units: 1s, 10ms, 00:01.12 (smpte). To specify value relative to
                    file end you can use $-X syntax</tr>
                    <tr lang="ru" finished="false">указать конечное положение входного файла, по
                    умолчанию в выборках, но можно использовать и другие блоки: 1s, 10ms, 00:01.12
                    (smpte). Для указания значения относительно конца файла можно использовать
                    синтаксис $-X</tr>
                </param>
                <param name="@length X" type="property">
                    <tr lang="en">specify input length, by default in samples, but you can use
                    other units: 1s, 10ms, 00:00:02.00 (smpte)</tr>
                    <tr lang="ru" finished="false">указать длину ввода, по умолчанию в образцах, но
                    можно использовать и другие агрегаты: 1s, 10ms, 00:00:02.00 (smpte)</tr>
                </param>
                <param name="@offset SAMPLES" type="property">
                    <tr lang="en">offset in samples from beginning of file. Deprecated, use @begin
                    instead</tr>
                    <tr lang="ru" finished="false">Смещение в образцах от начала файла. Устаревший,
                    используйте вместо этого @begin</tr>
                </param>
                <param name="@resample R?" type="property">
                    <tr lang="en">if R is not specified - resample from file samplerate to current
                    Pd samplerate. But you can manually specify R as float value or integer
                    fraction - 44100/48000</tr>
                    <tr lang="ru" finished="false">если R не указан - повторный образец из файла
                    сэмплрейт в текущий Pd сэмплрейт. Но вы можете вручную указать R в качестве
                    поплавкового значения или целочисленной фракции - 44100/48000</tr>
                </param>
            </method>
            <!-- save -->
            <method name="save">
                <info>
                    <tr lang="en">Save arrays to specified file</tr>
                    <tr lang="ru" finished="false">Сохранить массивы в указанный файл</tr>
                </info>
                <param name="ARRAYS" type="list" required="true">
                    <tr lang="en">list of arrays</tr>
                    <tr lang="ru" finished="false">Список массивов</tr>
                </param>
                <param name="@to FNAME" type="symbol" required="true">
                    <tr lang="en">output filename</tr>
                    <tr lang="ru" finished="false">Выходное имя файла</tr>
                </param>
                <param name="@begin X" type="property">
                    <tr lang="en">specify input array begin position, by default in samples, but
                    you can use other units: 1s, 10ms, 00:01.12 (smpte). To specify value relative
                    to array end you can use $-X syntax</tr>
                    <tr lang="ru" finished="false">указать начальную позицию входного массива, по
                    умолчанию в выборках, но можно использовать и другие блоки: 1s, 10ms, 00:01.12
                    (smpte). Для указания значения относительно конца массива можно использовать
                    синтаксис $-X</tr>
                </param>
                <param name="@end X" type="property">
                    <tr lang="en">specify input array end position, by default in samples, but you
                    can use other units: 1s, 10ms, 00:01.12 (smpte). To specify value relative to
                    array end you can use $-X syntax</tr>
                    <tr lang="ru" finished="false">указать конечное положение входного массива, по
                    умолчанию в образцах, но можно использовать другие блоки: 1s, 10ms, 00:01.12
                    (smpte). Для указания значения относительно конца массива можно использовать
                    синтаксис $-X</tr>
                </param>
                <param name="@gain V" type="property">
                    <tr lang="en">apply gain to saved arrays, examples: +3.1db, -6db, 0.5 etc.</tr>
                    <tr lang="ru" finished="false">применять коэффициент усиления к сохраненным
                    массивам, примеры: +3.1db, -6db, 0,5 и т.д.</tr>
                </param>
                <param name="@in_sr SR" type="property">
                    <tr lang="en">array source samplerate, if omitted using patch samplerate</tr>
                    <tr lang="ru" finished="false">Массив источник выборки, если опущен с помощью
                    пластыря выборки</tr>
                </param>
                <param name="@out_sr SR" type="property">
                    <tr lang="en">output samplerate</tr>
                    <tr lang="ru" finished="false">выходная выборка</tr>
                </param>
                <param name="@norm[alize]" type="property">
                    <tr lang="en">normalize output</tr>
                    <tr lang="ru" finished="false">нормализовать выход</tr>
                </param>
                <param name="@overwrite" type="property">
                    <tr lang="en">overwrite existing file flag</tr>
                    <tr lang="ru" finished="false">перезаписывать существующий файловый флаг</tr>
                </param>
                <param name="@samp FMT" type="property">
                    <tr lang="en">output sample format. Supported values are: 0(use default), 8,
                    16, 24, 32, f</tr>
                    <tr lang="ru" finished="false">Формат выходного образца. Поддерживаемые
                    значения: 0 (по умолчанию), 8, 16, 24, 32, f</tr>
                </param>
                <param name="@wav" type="property">
                    <tr lang="en">WAV output format</tr>
                    <tr lang="ru" finished="false">Формат вывода WAV</tr>
                </param>
                <param name="@mp3" type="property">
                    <tr lang="en">MP3 output format</tr>
                    <tr lang="ru" finished="false">Выходной формат MP3</tr>
                </param>
                <param name="@ogg" type="property">
                    <tr lang="en">Ogg/Vorbis output format</tr>
                    <tr lang="ru" finished="false">Формат выхода Ogg/Vorbis</tr>
                </param>
                <param name="@opus" type="property">
                    <tr lang="en">Opus output format</tr>
                    <tr lang="ru" finished="false">Выходной формат Opus</tr>
                </param>
                <param name="@aiff" type="property">
                    <tr lang="en">AIFF output format</tr>
                    <tr lang="ru" finished="false">Выходной формат AIFF</tr>
                </param>
                <param name="@txt" type="property">
                    <tr lang="en">TXT output format</tr>
                    <tr lang="ru" finished="false">Выходной формат TXT</tr>
                </param>
                <param name="@raw" type="property">
                    <tr lang="en">RAW output format</tr>
                    <tr lang="ru" finished="false">Формат вывода RAW</tr>
                </param>
                <param name="@flac" type="property">
                    <tr lang="en">FLAC output format</tr>
                    <tr lang="ru" finished="false">Формат вывода ФЛАК</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet type="control">
                <in>
                    <tr lang="en">input inlet</tr>
                    <tr lang="ru" finished="false">входной вход</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">number of loaded/saved samples or -1 on error</tr>
                    <tr lang="ru" finished="false">количество загруженных/спасенных образцов или -1
                    по ошибке</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[openpanel #p1]

 [symbol %CEAMMC%/sin_ch4_44.1k.wav(
 |
 |  [symbol %CEAMMC%/sound/vla-overtones-3.mp3(
 |  |
[load $1 to array[1|2] @resize #m1(       [A array1 w=120 h=80]
|
[expand_env]
|
|
[snd.file]
|
[F digits=8]                              [A array2 w=120 h=80]

/* play */

[bang #play(  [stop #stop(
|             |
|             |
[tabplay~ array1]   [tabplay~ array2 #a2]
|                   |.
[ui.hgain2~          ]  [ui.dsp~]
|                  ^|.
[dac~                ]

[snd.file-resample] [snd.file-gain]

[snd.file-pattern]  [snd.file-pos]

[X play->a2]
[X stop->a2]
[X p1->m1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
