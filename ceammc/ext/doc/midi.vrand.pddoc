<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="midi.vrand">
    <title>midi.vrand</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">MIDI velocity randomizer</tr>
        <tr lang="ru">рандомизатор силы нажатия MIDI-нот</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>midi</category>
      <keywords>midi velocity random</keywords>
      <since>0.9.2</since>
    </meta>
    <arguments>
      <argument name="MIN" type="float">
        <tr lang="en">min random range</tr>
        <tr lang="ru">нижняя граница случайного диапазона</tr>
      </argument>
      <argument name="MAX" type="float">
        <tr lang="en">max random range</tr>
        <tr lang="ru">верхняя граница случайного диапазона</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @add -->
      <property name="@add" type="alias">
        <tr lang="en">alias to @mode add</tr>
        <tr lang="ru">псевдоним для @mode add</tr>
      </property>
      <!-- @assign -->
      <property name="@assign" type="alias">
        <tr lang="en">alias to @mode assign</tr>
        <tr lang="ru">псевдоним для @mode assign</tr>
      </property>
      <!-- @dist -->
      <property name="@dist" type="symbol" default="uniform"
      enum="uniform gauss linup lindown cmin cmax cmean">
        <tr lang="en">random distribution. *uniform* - uniformly distributed value, *gauss* - mean=(@max+@min)/2, sigma=(@max-@min)/3, *linup* - linear distribution with prob=0 at @min and prob=1 at @max, *lindown* - linear distribution with prob=1 at @min and prob=0 at @max, *cmin* - constant @min value, *cmax* - constant @max value, *cmean* - constant (@max+@min)/2 value</tr>
        <tr lang="ru">распределение случайной величины. *uniform* — равномерно распределённое значение, *gauss* — среднее=(@max+@min)/2, sigma=(@max-@min)/3, *linup* — линейное распределение с prob=0 при @min и prob=1 при @max, *lindown* — линейное распределение с prob=1 при @min и prob=0 при @max, *cmin* — постоянное значение @min, *cmax* — постоянное значение @max, *cmean* — постоянное значение (@max+@min)/2</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="float" default="127">
        <tr lang="en">max random range</tr>
        <tr lang="ru">верхняя граница случайного диапазона</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="float" default="0">
        <tr lang="en">min random range</tr>
        <tr lang="ru">нижняя граница случайного диапазона</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" default="assign" enum="assign add sub">
        <tr lang="en">assign mode. If *assign* - replace original velocity with a new random one (default), if *add* - add random value to the original velocity, if *sub* - subtract random value from the original velocity.</tr>
        <tr lang="ru">режим. Если *assign* — заменить исходную силу нажатия на новую случайную (по умолчанию), если *add* — прибавить случайное значение к исходной силе нажатия, если *sub* — вычесть случайное значение из исходной силы нажатия.</tr>
      </property>
      <!-- @seed -->
      <property name="@seed" type="int" default="0" minvalue="0">
        <tr lang="en">random seed</tr>
        <tr lang="ru">начальное значение генератора случайных чисел</tr>
      </property>
      <!-- @sub -->
      <property name="@sub" type="alias">
        <tr lang="en">alias to @mode sub</tr>
        <tr lang="ru">псевдоним для @mode sub</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">note value</tr>
          <tr lang="ru">значение ноты</tr>
        </in>
        <in on="list">
          <tr lang="en">NOTE VELOCITY [DUR] list</tr>
          <tr lang="ru">список НОТА СИЛА_НАЖАТИЯ [ДЛИТ]</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">outputs NOTE VELOCITY [DUR] list with randomized VELOCITY value</tr>
          <tr lang="ru">выводит список НОТА СИЛА_НАЖАТИЯ [ДЛИТ] со случайным значением СИЛЫ НАЖАТИЯ</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[metro 350]  [ui.tab uniform gauss linup lindown cmin cmax cmean @size 400 15]
|            |
[60 20 300(  [@dist $2(  [ui.tab assign add sub]
|            |           |
|            |           [@mode $2(
|            |           |
[midi.vrand 60 90        ]
|  |
|  [ui.dt]
|
[makenote]
*|*
[midiout]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
