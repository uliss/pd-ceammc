<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="set.intersect">
        <title>set.intersect</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">intersection of sets</tr>
                <tr lang="ru">пересечение множеств</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data intersection set</keywords>
            <since>0.3</since>
            <also>
                <see>data.set</see>
                <see>set.union</see>
            </also>
        </meta>
        <arguments>
            <argument name="ARGS" type="any">
                <tr lang="en">right set elements</tr>
            </argument>
        </arguments>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">first set or list (converted to set), other values are
                    ignored</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">second set or list (converted to set)</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output intersection of given sets</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[trigger           b b]
|                  ^|
[data.set 1 2 3 4]  [data.set 3 4 5 6]
|                   |.
[set.intersect       ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
