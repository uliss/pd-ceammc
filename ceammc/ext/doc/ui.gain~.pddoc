<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.gain~" type="gui">
    <title>ui.gain~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">gain control</tr>
        <tr lang="ru">регулятор усиления</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui gain</keywords>
      <since>0.5</since>
      <aliases>
        <alias view="link">ui.hgain~</alias>
        <alias view="link">ui.vgain~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">a gain control widget with an audio input and an audio output. The gain can be set in decibels or as an amplitude ratio</tr>
        <tr lang="ru">виджет-регулятор усиления с аудиовходом и аудиовыходом. Усиление можно задавать в децибелах или как амплитудное отношение</tr>
      </par>
      <par>
        <tr lang="en">the gain is controlled by dragging the mouse or scrolling the wheel. Hold Shift to change the gain slowly, double-click with Cmd to switch the orientation</tr>
        <tr lang="ru">усиление регулируется перетаскиванием мыши или прокруткой колеса. Удерживайте Shift для медленного изменения, двойной клик с Cmd переключает ориентацию</tr>
      </par>
      <par>
        <tr lang="en">@db and @amp set the gain in decibels or as an amplitude ratio, @min and @max define the range, @relative enables relative mouse mode</tr>
        <tr lang="ru">@db и @amp задают усиление в децибелах или как амплитудное отношение, @min и @max задают диапазон, @relative включает относительный режим мыши</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">jump to click position if @relative property is
      off</event>
      <event type="drag" editmode="false">relative gain change if @relative is on, otherwise
      follows mouse pointer</event>
      <event type="drag" editmode="false" keys="Shift">slow relative gain change if @relative is
      on</event>
      <event type="wheel" editmode="false">change the knob value</event>
      <event type="wheel" editmode="false" keys="Shift">change the knob value slowly</event>
      <event type="right-click" editmode="false">open popup menu</event>
      <event type="right-click" editmode="false" keys="Shift">open object help</event>
      <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
      <event type="drag" editmode="true" keys="Cmd">relative gain change</event>
      <event type="double-click" editmode="true" keys="Cmd">toggle horizontal/vertical
      orientation</event>
      <event type="double-click" editmode="0" keys="Shift">toggle MIDI-learn mode (red border
      displayed)</event>
      <event type="right-click" editmode="true" keys="Shift">open object help</event>
      <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
    </mouse>
    <properties>
      <xi:include href="props_background_color.xml" />
      <xi:include href="props_border_color.xml" />
      <xi:include href="props_fontname.xml" />
      <xi:include href="props_fontsize.xml" />
      <xi:include href="props_fontslant.xml" />
      <xi:include href="props_fontweight.xml" />
      <xi:include href="props_pinned.xml" />
      <xi:include href="props_ui_receive.xml" />
      <xi:include href="props_ui_send.xml" />
      <xi:include href="props_midi_channel.xml" />
      <xi:include href="props_preset.xml" />
      <!-- @amp -->
      <property name="@amp" type="float" default="0">
        <tr lang="en">gain as an amplitude ratio</tr>
        <tr lang="ru">усиление как амплитудное отношение</tr>
      </property>
      <!-- @db -->
      <property name="@db" type="float" units="decibel" default="-60">
        <tr lang="en">gain in dBFS scale</tr>
        <tr lang="ru">усиление по шкале dBFS</tr>
      </property>
      <!-- @knob_color -->
      <property name="@knob_color" type="list" default="0 0.75 1 1">
        <tr lang="en">knob color (list of red, green, blue values in 0–1 range)</tr>
        <tr lang="ru">цвет ручки (список значений красного, зелёного, синего в диапазоне 0–1)</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="int" minvalue="-12" maxvalue="12" default="0" units="decibel">
        <tr lang="en">maximum gain value</tr>
        <tr lang="ru">максимальное значение усиления</tr>
      </property>
      <!-- @midi_control -->
      <property name="@midi_control" type="int" minvalue="-1" maxvalue="127" default="-1">
        <tr lang="en">bound MIDI controller number. -1 means not bound to any controller</tr>
        <tr lang="ru">привязанный номер MIDI-контроллера. -1 означает, что контроллер не привязан</tr>
      </property>
      <!-- @midi_pickup -->
      <property name="@midi_pickup" type="bool" default="1">
        <tr lang="en">pickup current value. If the slider is bound to a MIDI controller, you first have to pass over the current value to make the binding. This prevents a sudden value jump on the first control change</tr>
        <tr lang="ru">подхват текущего значения. Если слайдер привязан к MIDI-контроллеру, сначала нужно пройти через текущее значение, чтобы установить связь. Это предотвращает внезапный скачок значения при первом изменении контроллера</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="int" minvalue="-90" maxvalue="-15" default="-60" units="decibel">
        <tr lang="en">minimal gain value</tr>
        <tr lang="ru">минимальное значение усиления</tr>
      </property>
      <!-- @mouse_events -->
      <property name="@mouse_events" type="bool" default="0">
        <tr lang="en">mouse events output mode. If on, outputs @mouse_down, @mouse_up and @mouse_drag events</tr>
        <tr lang="ru">режим вывода событий мыши. Если включён, выводит события @mouse_down, @mouse_up и @mouse_drag</tr>
      </property>
      <!-- @output_value -->
      <property name="@output_value" type="bool" default="0">
        <tr lang="en">flag to output the @db property after each knob move</tr>
        <tr lang="ru">флаг для вывода свойства @db после каждого перемещения ручки</tr>
      </property>
      <!-- @relative -->
      <property name="@relative" type="bool" default="1">
        <tr lang="en">relative input mode. When set, do not jump to value on click</tr>
        <tr lang="ru">относительный режим ввода. Если включён, не переходить к значению по клику</tr>
      </property>
      <!-- @show_range -->
      <property name="@show_range" type="bool" default="1">
        <tr lang="en">if true, show the slider range</tr>
        <tr lang="ru">если true, показывать диапазон слайдера</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="15 120">
        <tr lang="en">object size (width, height pair)</tr>
        <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
      </property>
    </properties>
    <methods>
      <!-- + N -->
      <method name="+ N">
        <info>
          <tr lang="en">increase current gain by N dB</tr>
          <tr lang="ru">увеличить текущее усиление на N дБ</tr>
        </info>
      </method>
      <!-- ++ -->
      <method name="++">
        <info>
          <tr lang="en">decrease current gain by 1 dB</tr>
          <tr lang="ru">уменьшить текущее усиление на 1 дБ</tr>
        </info>
      </method>
      <!-- - N -->
      <method name="- N">
        <info>
          <tr lang="en">decrease current gain by N dB</tr>
          <tr lang="ru">уменьшить текущее усиление на N дБ</tr>
        </info>
      </method>
      <method name="--">
        <info>
          <tr lang="en">decrease current gain by 1 dB</tr>
          <tr lang="ru">уменьшить текущее усиление на 1 дБ</tr>
        </info>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clears the specified preset</tr>
          <tr lang="ru">очищает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- interp -->
      <method name="interp">
        <info>
          <tr lang="en">interpolates between presets</tr>
          <tr lang="ru">интерполирует между пресетами</tr>
        </info>
        <param name="IDX" type="float" required="true">
          <tr lang="en">preset fraction index</tr>
          <tr lang="ru">дробный индекс пресета</tr>
        </param>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">loads the specified preset</tr>
          <tr lang="ru">загружает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set UI element position</tr>
          <tr lang="ru">задать положение элемента UI</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top left x-coord</tr>
          <tr lang="ru">x-координата верхнего левого угла</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top right y-coord</tr>
          <tr lang="ru">y-координата верхнего левого угла</tr>
        </param>
      </method>
      <!-- set N -->
      <method name="set N">
        <info>
          <tr lang="en">set current gain to N dB</tr>
          <tr lang="ru">установить текущее усиление в N дБ</tr>
        </info>
      </method>
      <!-- store -->
      <method name="store">
        <info>
          <tr lang="en">stores the specified preset</tr>
          <tr lang="ru">сохраняет указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
        <in on="bang">
          <tr lang="en">output current gain @db property</tr>
          <tr lang="ru">вывести текущее усиление из свойства @db</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru">выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*use [ui.hgain~] to create horizontal control]*/

[ui.hgain~]

[osc~ 440]
|
|  [@db -30( [@amp 0.25( [- 3( [+ 3( [++( [--(
|  |         |           |     |     |    |
|  | [bang(  |           |     |     |    |
|  | |       |           |     |     |    |
[ui.gain~                  @output_value 1]
|
|    [ui.dsp~]
|
|
|
|
|
|
[~->     ]
|       ^|
[dac~]  [ui.display @display_type 1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
