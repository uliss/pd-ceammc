<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="hoa.2d.optim~">
        <title>hoa.2d.optim~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
                <author>Pierre Guillot</author>
                <author>Eliott Paris</author>
                <author>Thomas Le Meur</author>
            </authors>
            <description>
                <tr lang="en">a 2D ambisonic optimization tool</tr>
                <tr lang="ru">оптимизация двумерных амбисоников</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>hoa optim 2d</keywords>
            <since>0.8</since>
            <also>
                <see>hoa.2d.decoder~</see>
            </also>
            <aliases>
                <alias>hoa.optim~</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Weights the circular harmonics signals depending on the ambisonic
                optimization. It can be "basic" for no optimization, "maxre" or "inphase".</tr>
            </par>
            <par>
                <tr lang="en">If no optimization mode is specified, the default mode will be
                inphase.</tr>
            </par>
            <par>
                <tr lang="en">Maxre optimization is used when audience is confined to the center of
                the circle.</tr>
            </par>
            <par>
                <tr lang="en">Inphase optimization is used when the audience covers all the
                circle.</tr>
            </par>
            <par>
                <tr lang="en">NB: This is theoretical, the best choice is to trust your ears.</tr>
            </par>
            <a href="hoa/hoa.2d.optim~-help.pd">CICM documentation</a>
        </info>
        <arguments>
            <argument name="ORDER" type="int" minvalue="1" maxvalue="63">
                <tr lang="en">the order of decomposition</tr>
            </argument>
            <argument name="MODE" type="symbol" enum="basic maxre inphase">
                <tr lang="en">optimization mode</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @basic -->
            <property name="@basic" type="alias">
                <tr lang="en">alias for @mode basic (no optimization)</tr>
            </property>
            <!-- @inphase -->
            <property name="@inphase" type="alias">
                <tr lang="en">alias for @mode inphase.</tr>
            </property>
            <!-- @maxre -->
            <property name="@maxre" type="alias">
                <tr lang="en">alias for @mode maxre.</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" enum="basic maxre inphase" default="basic">
                <tr lang="en">optimization mode</tr>
            </property>
            <!-- @order -->
            <property name="@order" type="int" minvalue="1" maxvalue="63" default="1"
            access="initonly">
                <tr lang="en">the order of decomposition</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">first input harmonic</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>
                    <tr lang="en">... input harmonic</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="n">
                <xinfo>
                    <tr lang="en">n-th input harmonic</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio">first harmonic output</outlet>
            <outlet type="audio" number="...">... harmonic output</outlet>
            <outlet type="audio" number="n">n-th harmonic output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[hoa/hoa.soundrone]     [phasor~ 0.15]
|                       |
[ui.gain~ @size 120 14] [phase->rad~] [ui.menu basic maxre inphase]
|                       |.            |
[hoa.encoder~ 5 {w=25,i=11,o=11}]     [@mode $2(
*|*                                   |
[hoa.optim~ 5 inphase {w=25,i=11,o=11}]
*|* *|*
*|* [hoa.scope~ 5 @gain 4 {i=11} @size 164 164]
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
[hoa.decoder~ 5 regular 11 {w=25,i=11,o=11}]
*|*
[xdac~ 1:11 {w=25,i=11}]

[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
