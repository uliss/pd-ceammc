<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="conv.phase2rad~">
        <title>conv.phase2rad~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert phase value [0-1] to radians [0-2π]</tr>
                <tr lang="ru">преобразует значение фазы [0-1] в радианы [0-2π]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv phase radians</keywords>
            <since>0.8</since>
            <also>
                <see>conv.rad2phase~</see>
            </also>
            <aliases>
                <alias>ceammc/phase-&gt;rad~</alias>
                <alias>phase-&gt;rad~</alias>
            </aliases>
        </meta>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input value</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">converted value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[lfo.saw~ 0.1]  [ui.dsp~]
|
[phase->rad~]
|
[ui.n~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
