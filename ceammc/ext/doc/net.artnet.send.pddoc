<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="net.artnet.send">
    <title>net.artnet.send</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">ArtNet DMX message sender</tr>
        <tr lang="ru">отправитель сообщений ArtNet DMX</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>net</category>
      <keywords>osc net artnet dmx</keywords>
      <since>0.9.5</since>
      <aliases>
        <alias>artnet.send</alias>
      </aliases>
    </meta>
    <info>
      <par style="info">
        <tr lang="en">Art-Net is an Ethernet protocol based on TCP/IP that transports DMX512 lighting data over a standard network, allowing multiple DMX universes to be carried over a single cable</tr>
        <tr lang="ru">Art-Net — это Ethernet-протокол на основе TCP/IP, который передаёт данные освещения DMX512 по стандартной сети и позволяет передавать несколько вселенных DMX по одному кабелю</tr>
      </par>
      <par>
        <tr lang="en">transmission uses UDP, with the standard Art-Net port 6454</tr>
        <tr lang="ru">передача идёт по UDP, стандартный порт Art-Net — 6454</tr>
      </par>
      <par>
        <tr lang="en">the object sends ArtDmx packets to control DMX channels of the specified universe and subnet</tr>
        <tr lang="ru">объект отправляет пакеты ArtDmx для управления каналами DMX указанной вселенной и подсети</tr>
      </par>
      <par>
        <tr lang="en">each DMX universe contains up to 512 channels, values are in the range 0–255</tr>
        <tr lang="ru">каждая вселенная DMX содержит до 512 каналов, значения находятся в диапазоне 0–255</tr>
      </par>
      <par>
        <tr lang="en">if @sync is enabled, frames are sent only on bang, otherwise frames are sent at @rate using the internal clock</tr>
        <tr lang="ru">если включён @sync, кадры отправляются только по bang, иначе кадры отправляются с частотой @rate по внутренним часам</tr>
      </par>
      <par style="important">
        <tr lang="en">Alt+click on the object sends a blackout message</tr>
        <tr lang="ru">Alt+клик по объекту отправляет сообщение блэкаута</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false" keys="Alt">send blackout message</event>
    </mouse>
    <arguments>
      <argument name="UNIVERSE" type="int" minvalue="0" maxvalue="15">
        <tr lang="en">ArtNet universe</tr>
        <tr lang="ru">вселенная ArtNet</tr>
      </argument>
      <argument name="SUBNET" type="int" minvalue="0" maxvalue="15">
        <tr lang="en">ArtNet subnet</tr>
        <tr lang="ru">подсеть ArtNet</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @ip -->
      <property name="@ip" type="symbol" default="" access="initonly">
        <tr lang="en">bind interface IP address. If empty - use the first available interface.</tr>
        <tr lang="ru">привязать IP-адрес интерфейса. Если пусто — использовать первый доступный интерфейс.</tr>
      </property>
      <!-- @offset -->
      <property name="@offset" type="int" default="0" minvalue="0" maxvalue="511">
        <tr lang="en">DMX channel offset</tr>
        <tr lang="ru">смещение канала DMX</tr>
      </property>
      <!-- @rate -->
      <property name="@rate" type="float" units="hertz" default="44" minvalue="1" maxvalue="100">
        <tr lang="en">send framerate</tr>
        <tr lang="ru">частота отправки кадров</tr>
      </property>
      <!-- @subnet -->
      <property name="@subnet" type="int" default="0" minvalue="0" maxvalue="15">
        <tr lang="en">ArtNet subnet</tr>
        <tr lang="ru">подсеть ArtNet</tr>
      </property>
      <!-- @sync -->
      <property name="@sync" type="bool" default="0">
        <tr lang="en">send mode. If true: send frame only when bang is received, otherwise send frames with @rate speed using the internal clock</tr>
        <tr lang="ru">режим отправки. Если true: отправлять кадр только при получении bang, иначе отправлять кадры с частотой @rate по внутренним часам</tr>
      </property>
      <!-- @universe -->
      <property name="@universe" type="int" default="0" minvalue="0" maxvalue="15">
        <tr lang="en">ArtNet universe</tr>
        <tr lang="ru">вселенная ArtNet</tr>
      </property>
    </properties>
    <methods>
      <!-- blackout -->
      <method name="blackout">
        <info>
          <tr lang="en">blackout (send 0 to all DMX channels)</tr>
          <tr lang="ru">блэкаут (отправить 0 на все каналы DMX)</tr>
        </info>
      </method>
      <!-- dmx -->
      <method name="dmx">
        <info>
          <tr lang="en">set DMX channel values</tr>
          <tr lang="ru">задать значения каналов DMX</tr>
        </info>
        <param name="VALUES" type="list" required="true">
          <tr lang="en">list of DMX values, the first element sets the first channel etc.</tr>
          <tr lang="ru">список значений DMX, первый элемент задаёт первый канал и т.д.</tr>
        </param>
      </method>
      <!-- dmx_fill -->
      <method name="dmx_fill">
        <info>
          <tr lang="en">set all DMX channels to the given value</tr>
          <tr lang="ru">установить все каналы DMX в заданное значение</tr>
        </info>
        <param name="VAL" type="int" required="true" minvalue="0" maxvalue="255">
          <tr lang="en">DMX value</tr>
          <tr lang="ru">значение DMX</tr>
        </param>
      </method>
      <!-- dmx_set -->
      <method name="dmx_set">
        <info>
          <tr lang="en">set DMX channel value</tr>
          <tr lang="ru">задать значение канала DMX</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0" maxvalue="512">
          <tr lang="en">DMX channel</tr>
          <tr lang="ru">канал DMX</tr>
        </param>
        <param name="VAL" type="int" required="true" minvalue="0" maxvalue="255">
          <tr lang="en">DMX value</tr>
          <tr lang="ru">значение DMX</tr>
        </param>
      </method>
      <!-- poll -->
      <method name="poll">
        <info>
          <tr lang="en">send poll request, dump response to the Pd window</tr>
          <tr lang="ru">отправить запрос опроса, вывести ответ в окно Pd</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input</tr>
          <tr lang="ru">вход</tr>
        </in>
        <in on="bang">
          <tr lang="en">send packet</tr>
          <tr lang="ru">отправить пакет</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output</tr>
          <tr lang="ru">выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.hrd 4]        [F]
|                 |
[@universe $1 #a( [@offset $1 #b(

 [ui.colorpanel #c]
 |
 |
 |
 |
 |
 |
 |
 [route @rgb]
 |
 [math.* 255]
 |
 [msg dmx] [poll( [dmx_fill 0(
 |         |      |
[net.artnet.send #x]

[X a->x]
[X b->x]
#c @matrix 16 8
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
