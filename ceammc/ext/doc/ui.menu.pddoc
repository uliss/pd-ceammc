<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="ui.menu" type="gui">
        <title>ui.menu</title>
        <meta>
            <authors>
                <author>Pierre Guillot</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">dropdown menu</tr>
                <tr lang="ru">выпадающее меню</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui menu</keywords>
            <since>0.1</since>
            <also>
                <see view="link">ui.radio</see>
            </also>
        </meta>
        <mouse>
            <event type="left-click" editmode="false">toggle the menu and choose the menu
            item</event>
            <event type="move" editmode="false">highlight hover menu item</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true">open Pd popup menu</event>
        </mouse>
        <properties>
            <xi:include href="props_active_color.xml"/>
            <xi:include href="props_background_color.xml"/>
            <xi:include href="props_border_color.xml"/>
            <xi:include href="props_fontname.xml"/>
            <xi:include href="props_fontsize.xml"/>
            <xi:include href="props_fontslant.xml"/>
            <xi:include href="props_fontweight.xml"/>
            <xi:include href="props_pinned.xml"/>
            <xi:include href="props_ui_receive.xml"/>
            <xi:include href="props_ui_send.xml"/>
            <xi:include href="props_preset.xml"/>
            <!-- @count -->
            <property name="@count" type="int" access="readonly" default="0">
                <tr lang="en">number of menu items</tr>
                <tr lang="ru" finished="false">Количество пунктов меню</tr>
            </property>
            <!-- @index -->
            <property name="@index" type="int" default="-1">
                <tr lang="en">current menu item index</tr>
                <tr lang="ru" finished="false">Текущий индекс пунктов меню</tr>
            </property>
            <!-- @items -->
            <property name="@items" type="list" default="">
                <tr lang="en">list of menu items</tr>
                <tr lang="ru" finished="false">Список пунктов меню</tr>
            </property>
            <!-- @max_length -->
            <property name="@max_length" type="int" minvalue="10" maxvalue="1024" default="100">
                <tr lang="en">maximum displayed item character length</tr>
                <tr lang="ru" finished="false">Максимальная отображаемая длина символа</tr>
            </property>
            <!-- @open -->
            <property name="@open" type="bool" default="0">
                <tr lang="en">opened state</tr>
                <tr lang="ru" finished="false">Открытое государство</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="100 16">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
            <!-- @text_color -->
            <property name="@text_color" type="list" default="0 0 0 1">
                <tr lang="en">text color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @title -->
            <property name="@title" type="symbol" access="readonly" default="">
                <tr lang="en">current element text</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="atom">
                <tr lang="en">current menu item value</tr>
            </property>
        </properties>
        <methods>
            <!-- append -->
            <method name="append">
                <info>
                    <tr lang="en">appends new menu item</tr>
                    <tr lang="ru" finished="false">Добавить новый пункт меню</tr>
                </info>
                <param name="ATOMS" type="list" required="true">
                    <tr lang="en">item name</tr>
                    <tr lang="ru" finished="false">название пункта</tr>
                </param>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clears specified preset</tr>
                    <tr lang="ru" finished="false">заданный заранее</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
            <!-- delete -->
            <method name="delete">
                <info>
                    <tr lang="en">removes item from menu</tr>
                    <tr lang="ru" finished="false">Удалить элемент из меню</tr>
                </info>
                <param name="IDX" type="int" minvalue="0" required="true">
                    <tr lang="en">removed item index</tr>
                    <tr lang="ru" finished="false">Удаленный индекс</tr>
                </param>
            </method>
            <!-- erase -->
            <method name="erase">
                <info>
                    <tr lang="en">clears all items menu</tr>
                    <tr lang="ru" finished="false">Очистить все пункты меню</tr>
                </info>
            </method>
            <!-- file_glob -->
            <method name="file_glob">
                <info>
                    <tr lang="en">fill menu with filenames.</tr>
                    <tr lang="ru" finished="false">Заполните меню именами файлов.</tr>
                </info>
                <param name="PATTERN" type="symbol" required="true">
                    <tr lang="en">filename pattern, like * (all files), *.wav (all wav files)
                    etc.</tr>
                    <tr lang="ru" finished="false">шаблон имени файла, например * (все файлы),
                    *.wav (все файлы wav) и т.д.</tr>
                </param>
                <param name="DIR" type="symbol" required="false">
                    <tr lang="en">search directory. If omitted - search in patch directory.
                    Performs tilde (~) expansion to home directory. To elide long filenames see
                    @max_length property.</tr>
                    <tr lang="ru" finished="false">каталог поиска. Если опущен - поиск в
                    патч-каталоге. Выполняет расширение tilde (~) в домашний каталог. Чтобы
                    избежать длинных имен файлов см. свойство @max_length.</tr>
                </param>
            </method>
            <!-- insert -->
            <method name="insert">
                <info>
                    <tr lang="en">inserts new menu item before specified position</tr>
                    <tr lang="ru" finished="false">вставить новый пункт меню перед указанной
                    позицией</tr>
                </info>
                <param name="IDX" type="int" minvalue="0" required="true">
                    <tr lang="en">item position</tr>
                    <tr lang="ru" finished="false">пункт повестки дня</tr>
                </param>
                <param name="ATOM" type="atom" required="true">
                    <tr lang="en">item name</tr>
                    <tr lang="ru" finished="false">название пункта</tr>
                </param>
            </method>
            <!-- interp -->
            <method name="interp">
                <info>
                    <tr lang="en">for this object acts as *load*, no preset interpolation
                    performed</tr>
                    <tr lang="ru" finished="false">для этого объекта действует как *load*, не
                    выполняется предустановленная интерполяция</tr>
                </info>
            </method>
            <!-- load -->
            <method name="load">
                <info>
                    <tr lang="en">loads specified preset</tr>
                    <tr lang="ru" finished="false">заданный заранее заданный</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
            <!-- pos -->
            <method name="pos">
                <info>
                    <tr lang="en">set UI element position</tr>
                    <tr lang="ru" finished="false">Установите положение элемента UI</tr>
                </info>
                <param name="X" type="float" required="true">
                    <tr lang="en">top left x-coord</tr>
                    <tr lang="ru" finished="false">верхний левый x-coord</tr>
                </param>
                <param name="Y" type="float" required="true">
                    <tr lang="en">top right y-coord</tr>
                    <tr lang="ru" finished="false">верхняя правая y-coord</tr>
                </param>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">silently sets menu state.</tr>
                    <tr lang="ru" finished="false">Тихо устанавливает состояние меню.</tr>
                </info>
                <param name="IDX" type="int" minvalue="0" required="true">
                    <tr lang="en">item index</tr>
                    <tr lang="ru" finished="false">элемент индекса</tr>
                </param>
            </method>
            <!-- set_item -->
            <method name="set_item">
                <info>
                    <tr lang="en">renames menu item</tr>
                    <tr lang="ru" finished="false">Переименовать пункт меню</tr>
                </info>
                <param name="IDX" type="int" required="true" minvalue="0">
                    <tr lang="en">item index</tr>
                    <tr lang="ru" finished="false">элемент индекса</tr>
                </param>
                <param name="ATOM" type="list" required="true">
                    <tr lang="en">item name</tr>
                    <tr lang="ru" finished="false">название пункта</tr>
                </param>
            </method>
            <!-- store -->
            <method name="store">
                <info>
                    <tr lang="en">stores specified preset</tr>
                    <tr lang="ru" finished="false">магазины, указанные Preset</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">outputs current menu state as list: INDEX ITEM_NAME</tr>
                    <tr lang="ru" finished="false">текущее состояние меню в виде списка: INDEX
                    ITEM_NAME</tr>
                </in>
                <in on="float">
                    <tr lang="en">change menu state and output list: INDEX ITEM_NAME</tr>
                    <tr lang="ru" finished="false">изменить состояние меню и список выходов: INDEX
                    ITEM_NAME</tr>
                </in>
                <in on="any">
                    <tr lang="en">selects item equal to given and output list: INDEX ITEM_NAME</tr>
                    <tr lang="ru" finished="false">Выберите пункт, равный данному и выходному
                    списку: INDEX ITEM_NAME</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output</tr>
                    <tr lang="ru" finished="false">выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[loadbang]
|
[erase, file_glob * %DOC%/sound, 0(
|
[expand_env]
|
[ui.menu @max_length 32 @size 200 16]
|
[list.at 1]
|
[S digits=60]
|
[open $1, 1(
|
[snd.play~]
| ^|.
[ui.gain2~ @size 120 16]   [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
