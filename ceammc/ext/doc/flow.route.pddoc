<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.route">
    <title>flow.route</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">enhanced message router</tr>
        <tr lang="ru">расширенный маршрутизатор сообщений</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>route</keywords>
      <since>0.6</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes incoming messages to the outlets according to the match list</tr>
        <tr lang="ru">объект направляет входящие сообщения на выходы согласно списку совпадений</tr>
      </par>
      <par>
        <tr lang="en">if no match occurred, the original message is sent to the last outlet</tr>
        <tr lang="ru">если совпадения не произошло, исходное сообщение отправляется на последний выход</tr>
      </par>
      <par>
        <tr lang="en">if a route starts with '*', the output includes the message selector, otherwise the selector is removed</tr>
        <tr lang="ru">если шаблон начинается с '*', вывод включает селектор сообщения, иначе селектор удаляется</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to dispatch messages by selector or by the first list element, for example to route "note", "ctlin" or numeric messages to different destinations</tr>
        <tr lang="ru">объект можно использовать для диспетчеризации сообщений по селектору или по первому элементу списка, например для маршрутизации сообщений "note", "ctlin" или числовых сообщений в разные места назначения</tr>
      </par>
    </info>
    <arguments>
      <argument name="MATCHES" type="list">
        <tr lang="en">list of route matches</tr>
        <tr lang="ru">список шаблонов маршрутизации</tr>
      </argument>
    </arguments>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">match to the first list element, output to the corresponding outlet. If the route starts with *, output the list as is, otherwise output without the first element</tr>
          <tr lang="ru">совпадение с первым элементом списка, вывод на соответствующий выход. Если шаблон начинается с *, вывести список как есть, иначе вывести без первого элемента</tr>
        </in>
        <in on="any">
          <tr lang="en">match to the message selector, output to the corresponding outlet. On success outputs the message arguments to the corresponding outlet</tr>
          <tr lang="ru">совпадение с селектором сообщения, вывод на соответствующий выход. При успехе выводит аргументы сообщения на соответствующий выход</tr>
        </in>
        <in on="data:mlist">
          <tr lang="en">same as list</tr>
          <tr lang="ru">то же, что список</tr>
        </in>
        <in on="data:dict">
          <tr lang="en">match dict keys. On success outputs dict values to the corresponding outlets, if the route starts with * the output includes the matched key</tr>
          <tr lang="ru">совпадение с ключами словаря. При успехе выводит значения словаря на соответствующие выходы, если шаблон начинается с *, вывод включает совпавший ключ</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="any">
          <tr lang="en">first pattern match output</tr>
          <tr lang="ru">выход первого совпадения с шаблоном</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="any">
          <tr lang="en">... pattern match output</tr>
          <tr lang="ru">... выход совпадения с шаблоном</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="any">
          <tr lang="en">n-th pattern match output</tr>
          <tr lang="ru">выход N-го совпадения с шаблоном</tr>
        </out>
      </outlet>
      <outlet number="n+1">
        <out type="any">
          <tr lang="en">unmatched output</tr>
          <tr lang="ru">выход для несовпавших сообщений</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[list a b c #k(

[a b c #l(

[list d e f #m(

[d e f #n(

[100 200 300 #o(

[400 500 600 #p(  [unmatched(
                  |
[flow.route a *d 100 *400 #a {w=40}]
|
[ui.d @display_type 1] [ui.d @display_type 1 #d]

       [ui.d @display_type 1 #b]  [ui.d @display_type 1 #e]

              [ui.d @display_type 1 #c]

[flow.route-data]
[X a:1->b]
[X a:2->c]
[X a:3->d]
[X a:4->e]
[X k->a]
[X l->a]
[X m->a]
[X n->a]
[X o->a]
[X p->a]
]]>
      </pdascii>
      <pdascii id="data">
<![CDATA[
[B]                        [B]
|                          |
[data.mlist (1 2 3) #l0]   [data.mlist (3 4 5) #l1]

[[a: 1 2 3 b: c 1: test], bang(
|
[data.dict #d0]


[flow.route 1 *a #a]
|
[ui.d @display_type 1]

       [ui.d @display_type 1 #b]

           [ui.d @display_type 1 #c]

[X a:1->b]
[X a:2->c]
[X l0->a]
[X l1->a]
[X d0->a]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
