<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="flow.route">
        <title>flow.route</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">enhanced message router</tr>
                <tr lang="ru">улучшенный маршрутизатор сообщений</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>route</keywords>
            <since>0.6</since>
        </meta>
        <info>
            <par>
                <tr lang="en">if no match occured - output original message to last outlet</tr>
                <!-- old: Если совпадения не произошло - выведите исходное
                сообщение на последнюю розетку -->
                <tr lang="ru" finished="false">Если совпадения не произошло - выведите исходное
                сообщение на последнюю розетку</tr>
            </par>
            <par>
                <tr lang="en">if route starts with '*' - output with message selector</tr>
                <!-- old: если маршрут начинается с "*" - вывод с помощью
                селектора сообщений -->
                <tr lang="ru" finished="false">если маршрут начинается с "*" - вывод с помощью
                селектора сообщений</tr>
            </par>
        </info>
        <arguments>
            <argument name="MATCHES" type="list">
                <tr lang="en">list of route matches</tr>
                <tr lang="ru" finished="false">Список матчей маршрута</tr>
            </argument>
        </arguments>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">match to first list element, output to corresponding outlet. If
                    route starts with * output list 'as is', otherwise output without first
                    element</tr>
                    <!-- old: соответствие первому элементу списка, вывод на
                    соответствующую розетку. Если маршрут начинается с * списка вывода "как есть",
                    в противном случае выход без первого элемента -->
                    <tr lang="ru" finished="false">соответствие первому элементу списка, вывод на
                    соответствующую розетку. Если маршрут начинается с * списка вывода "как есть",
                    в противном случае выход без первого элемента</tr>
                </in>
                <in on="any">
                    <tr lang="en">match to message selector, output to corresponding outlet. On
                    success outputs message arguments to corresponding outlet</tr>
                    <!-- old: соответствие селектору сообщений, вывод на
                    соответствующую розетку. Об успехе выводит аргументы сообщения в
                    соответствующий выпуск -->
                    <tr lang="ru" finished="false">соответствие селектору сообщений, вывод на
                    соответствующую розетку. Об успехе выводит аргументы сообщения в
                    соответствующий выпуск</tr>
                </in>
                <in on="data:mlist">
                    <tr lang="en">same as list</tr>
                    <tr lang="ru" finished="false">Тот же список</tr>
                </in>
                <in on="data:dict">
                    <tr lang="en">match dict keys. On success outputs dict values to corresponding
                    outlets, if starts with * output with matched key</tr>
                    <!-- old: Ключи от диктовки. На выходе успеха диктуют
                    значения соответствующим выходам, если начинается с * выход с соответствующим
                    ключом -->
                    <tr lang="ru" finished="false">Ключи от диктовки. На выходе успеха диктуют
                    значения соответствующим выходам, если начинается с * выход с соответствующим
                    ключом</tr>
                </in>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="any">
                    <tr lang="en">first pattern match output</tr>
                    <tr lang="ru" finished="false">Первый образец соответствия выходу</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">... pattern match output</tr>
                    <tr lang="ru" finished="false">Производитель: pattern match output</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">n-th pattern match output</tr>
                    <tr lang="ru" finished="false">n-й результат сопоставления шаблонов</tr>
                </out>
            </outlet>
            <outlet number="n+1">
                <out type="any">
                    <tr lang="en">unmatched output</tr>
                    <tr lang="ru" finished="false">непревзойденный выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[list a b c #k(

[a b c #l(

[list d e f #m(

[d e f #n(

[100 200 300 #o(

[400 500 600 #p(  [unmatched(
                  |
[flow.route a *d 100 *400 #a {w=40}]
|
[ui.d @display_type 1] [ui.d @display_type 1 #d]

       [ui.d @display_type 1 #b]  [ui.d @display_type 1 #e]

              [ui.d @display_type 1 #c]

[flow.route-data]
[X a:1->b]
[X a:2->c]
[X a:3->d]
[X a:4->e]
[X k->a]
[X l->a]
[X m->a]
[X n->a]
[X o->a]
[X p->a]
]]>
            </pdascii>
            <pdascii id="data">
<![CDATA[
[B]                        [B]
|                          |
[data.mlist (1 2 3) #l0]   [data.mlist (3 4 5) #l1]

[[a: 1 2 3 b: c 1: test], bang(
|
[data.dict #d0]


[flow.route 1 *a #a]
|
[ui.d @display_type 1]

       [ui.d @display_type 1 #b]

           [ui.d @display_type 1 #c]

[X a:1->b]
[X a:2->c]
[X l0->a]
[X l1->a]
[X d0->a]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
