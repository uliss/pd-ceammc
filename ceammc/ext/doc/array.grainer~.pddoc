<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.grainer~">
    <title>array.grainer~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">array granulator</tr>
        <tr lang="ru">гранулятор звуковой таблицы</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array grain particle granular</keywords>
      <since>0.9.2</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Grain properties:</tr>
        <tr lang="ru">Свойства гранул:</tr>
      </par>
      <par>
        <tr lang="en">@at — grain position in the source array (in samples)</tr>
        <tr lang="ru">@at — позиция гранулы в исходном массиве (в семплах)</tr>
      </par>
      <par>
        <tr lang="en">@l — grain length (in samples)</tr>
        <tr lang="ru">@l — длина гранулы (в семплах)</tr>
      </par>
      <par>
        <tr lang="en">@amp — grain amplitude in the 0..256 range</tr>
        <tr lang="ru">@amp — амплитуда гранулы в диапазоне 0..256</tr>
      </par>
      <par>
        <tr lang="en">@s — grain speed in the -10..10 range</tr>
        <tr lang="ru">@s — скорость воспроизведения гранулы в диапазоне -10..10</tr>
      </par>
      <par>
        <tr lang="en">@p — grain pan in the 0..1 range</tr>
        <tr lang="ru">@p — панорама гранулы в диапазоне 0..1</tr>
      </par>
      <par>
        <tr lang="en">@w — grain window: rect, tri or hann</tr>
        <tr lang="ru">@w — окно гранулы: прямоугольное (rect), треугольное (tri) или Ханна (hann)</tr>
      </par>
      <par>
        <tr lang="en">@tb — time before grain start (in samples)</tr>
        <tr lang="ru">@tb — время перед началом гранулы (в семплах)</tr>
      </par>
      <par>
        <tr lang="en">@ta — time after grain done (in samples)</tr>
        <tr lang="ru">@ta — время после завершения гранулы (в семплах)</tr>
      </par>
      <par>
        <tr lang="en">@r — grain number of repeats (-1 means infinite)</tr>
        <tr lang="ru">@r — число повторов гранулы (-1 — бесконечно)</tr>
      </par>
      <par>
        <tr lang="en">@tag — grain tag</tr>
        <tr lang="ru">@tag — метка гранулы</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the source array used by the granulator</tr>
        <tr lang="ru">имя исходного массива, используемого гранулятором</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the source array used by the granulator</tr>
        <tr lang="ru">имя исходного массива, используемого гранулятором</tr>
      </property>
      <!-- @prob -->
      <property name="@prob" type="float" default="1" minvalue="0" maxvalue="1">
        <tr lang="en">grain start probability in internal or external sync mode ('int' or
        'ext')</tr>
        <tr lang="ru">вероятность запуска гранулы во внутреннем или внешнем режиме синхронизации
        ('int' или 'ext')</tr>
      </property>
      <!-- @sync -->
      <property name="@sync" type="symbol" default="none" enum="none int ext">
        <tr lang="en">grain sync mode. If 'none': start grains right after they are finished. If
        'int': start grains after the specified interval (@tsync)</tr>
        <tr lang="ru">режим синхронизации гранул. Если 'none': гранулы запускаются сразу после
        завершения. Если 'int': гранулы запускаются через заданный интервал (@tsync)</tr>
      </property>
      <!-- @tsync -->
      <property name="@tsync" type="float" default="50" minvalue="1" units="millisecond">
        <tr lang="en">grain sync interval</tr>
        <tr lang="ru">интервал синхронизации гранул</tr>
      </property>
    </properties>
    <methods>
      <!-- align -->
      <method name="align">
        <info>
          <tr lang="en">aligns grains to onset</tr>
          <tr lang="ru">выравнивает гранулы по атаке</tr>
        </info>
        <param name="SUBJ" type="atom" required="false">
          <tr lang="en">if '*' or omitted: align all grains. If '.': align finished grains only. If
          a number: align the grain with the corresponding #id. If a symbol: align grains with the
          corresponding tag</tr>
          <tr lang="ru">если '*' или не указано: выровнять все гранулы. Если '.': выровнять только
          завершённые гранулы. Если число: выровнять гранулу с соответствующим #id. Если символ:
          выровнять гранулы с соответствующим тегом</tr>
        </param>
      </method>
      <!-- append -->
      <method name="append">
        <info>
          <tr lang="en">appends several grains to the existing ones</tr>
          <tr lang="ru">добавляет несколько гранул к уже существующим</tr>
        </info>
        <param name="N" type="int" required="true" minvalue="1">
          <tr lang="en">number of grains</tr>
          <tr lang="ru">количество гранул</tr>
        </param>
        <param name="PROPS" type="list" required="true">
          <tr lang="en">grain properties</tr>
          <tr lang="ru">свойства гранул</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">removes grains</tr>
          <tr lang="ru">удаляет гранулы</tr>
        </info>
        <param name="SUBJ" type="atom" required="false">
          <tr lang="en">if '*' or omitted: remove all grains. If '.': remove finished grains only.
          If a float: remove the grain with the corresponding #id. If a symbol: remove grains with
          the corresponding tag</tr>
          <tr lang="ru">если '*' или не указано: удалить все гранулы. Если '.': удалить только
          завершённые гранулы. Если целое число: удалить гранулу с соответствующим #id. Если
          символ: удалить гранулы с соответствующим тегом</tr>
        </param>
      </method>
      <!-- defer -->
      <method name="defer">
        <info>
          <tr lang="en">defers the method call until the given number of grains has finished</tr>
          <tr lang="ru">откладывает вызов метода до завершения заданного числа гранул</tr>
        </info>
        <param name="N" type="int" minvalue="1" maxvalue="255">
          <tr lang="en">number of finished grains to wait for before calling. If not specified, 1
          is used</tr>
          <tr lang="ru">число завершённых гранул, которых нужно дождаться перед вызовом. Если не
          указано, используется 1</tr>
        </param>
        <param name="METHOD" type="symbol" required="true">
          <tr lang="en">method name</tr>
          <tr lang="ru">имя метода</tr>
        </param>
        <param name="ARGS" type="list">
          <tr lang="en">method arguments</tr>
          <tr lang="ru">аргументы метода</tr>
        </param>
      </method>
      <!-- fill -->
      <method name="fill">
        <info>
          <tr lang="en">replaces all existing grains with the given number of new grains</tr>
          <tr lang="ru">заменяет все существующие гранулы заданным числом новых гранул</tr>
        </info>
        <param name="N" type="int" required="true" minvalue="1">
          <tr lang="en">number of grains</tr>
          <tr lang="ru">количество гранул</tr>
        </param>
        <param name="PROPS" type="list" required="true">
          <tr lang="en">grain properties</tr>
          <tr lang="ru">свойства гранул</tr>
        </param>
      </method>
      <!-- grain -->
      <method name="grain">
        <info>
          <tr lang="en">creates a single grain</tr>
          <tr lang="ru">создаёт одну гранулу</tr>
        </info>
        <param name="PROPS" type="list" required="true">
          <tr lang="en">grain properties</tr>
          <tr lang="ru">свойства гранулы</tr>
        </param>
      </method>
      <!-- onsets -->
      <method name="onsets">
        <info>
          <tr lang="en">analyzes the source array for onsets</tr>
          <tr lang="ru">анализирует исходный массив на предмет атак</tr>
        </info>
        <param name="METHOD" type="symbol" default="default"
        enum="default hfc energy complex phase wphase specdiff kl mkl specflux">
          <tr lang="en">onset detection method</tr>
          <tr lang="ru">метод обнаружения атак</tr>
        </param>
        <param name="SPACE" type="float" default="64" units="millisecond" required="false">
          <tr lang="en">minimum space between onsets</tr>
          <tr lang="ru">минимальный интервал между атаками</tr>
        </param>
        <param name="SILENCE" type="float" default="-40" units="decibel" required="false">
          <tr lang="en">silence level</tr>
          <tr lang="ru">уровень тишины</tr>
        </param>
      </method>
      <!-- pause -->
      <method name="pause">
        <info>
          <tr lang="en">pauses or resumes grains</tr>
          <tr lang="ru">приостанавливает или возобновляет воспроизведение гранул</tr>
        </info>
        <param name="SUBJ" type="atom" required="true">
          <tr lang="en">if '*': pause all grains. If a float: pause the grain with the corresponding
          #id. If a symbol: pause grains with the matching tag</tr>
          <tr lang="ru">если '*': приостановить все гранулы. Если целое число: приостановить
          гранулу с соответствующим #id. Если символ: приостановить гранулы с соответствующим
          тегом</tr>
        </param>
        <param name="STATE" type="int" enum="0 1" required="false">
          <tr lang="en">on/off value</tr>
          <tr lang="ru">значение вкл./выкл.</tr>
        </param>
      </method>
      <!-- permutate -->
      <method name="permutate">
        <info>
          <tr lang="en">permutates grain positions (@ta and @tb) values</tr>
          <tr lang="ru">переставляет значения позиций гранул (@ta и @tb)</tr>
        </info>
        <param name="N" type="int" minvalue="-16" maxvalue="16">
          <tr lang="en">number of permutations. If N&gt;0 — N-th next permutation, if N&lt;0 — N-th
          previous permutation</tr>
          <tr lang="ru">число перестановок. Если N&gt;0 — N-я следующая перестановка, если N&lt;0 —
          N-я предыдущая перестановка</tr>
        </param>
        <param name="TAG" type="symbol" required="false">
          <tr lang="en">if '*' or omitted: permutate all grains. If '.': permutate positions of
          finished grains only. Otherwise permutate grains with the corresponding tag</tr>
          <tr lang="ru">если '*' или не указано: переставить все гранулы. Если '.': только
          завершённые. Иначе — гранулы с соответствующим тегом</tr>
        </param>
      </method>
      <!-- reverse -->
      <method name="reverse">
        <info>
          <tr lang="en">reverses grain positions (@ta and @tb) values</tr>
          <tr lang="ru">обращает значения позиций гранул (@ta и @tb)</tr>
        </info>
        <param name="TAG" type="symbol" required="false">
          <tr lang="en">if '*' or omitted: reverse positions of all grains. If '.': reverse
          positions of finished grains only. Otherwise reverse grains with the corresponding
          tag</tr>
          <tr lang="ru">если '*' или не указано: обратить позиции всех гранул. Если '.': только у
          завершённых гранул. Иначе — у гранул с соответствующим тегом</tr>
        </param>
      </method>
      <!-- set -->
      <method name="set">
        <info>
          <tr lang="en">sets grain properties</tr>
          <tr lang="ru">устанавливает свойства гранул</tr>
        </info>
        <param name="SUBJ" type="atom" required="true">
          <tr lang="en">if '*': set for all grains. If a float: set for the grain with the specified
          #id. If a symbol: set for grains with the specified tag</tr>
          <tr lang="ru">если '*': установить для всех гранул. Если целое число: для гранулы с
          указанным #id. Если символ: для гранул с указанным тегом</tr>
        </param>
        <param name="PROPS" type="list" required="true">
          <tr lang="en">grain properties</tr>
          <tr lang="ru">свойства гранул</tr>
        </param>
      </method>
      <!-- shuffle -->
      <method name="shuffle">
        <info>
          <tr lang="en">shuffles grain positions (@ta and @tb) values</tr>
          <tr lang="ru">случайно перетасовывает значения позиций гранул (@ta и @tb)</tr>
        </info>
        <param name="TAG" type="symbol" required="false">
          <tr lang="en">if '*' or omitted: shuffle all grains. If '.': shuffle finished grains
          only. Otherwise shuffle grains with the corresponding tag</tr>
          <tr lang="ru">если '*' или не указано: перетасовать все гранулы. Если '.': только
          завершённые гранулы. Иначе — гранулы с указанным тегом</tr>
        </param>
      </method>
      <!-- slice -->
      <method name="slice">
        <info>
          <tr lang="en">slices the specified duration into the given number of grains and adds
          them</tr>
          <tr lang="ru">нарезает указанный диапазон на заданное число гранул и добавляет их</tr>
        </info>
        <param name="N" type="int" required="true" minvalue="1" maxvalue="64">
          <tr lang="en">desired number of grains</tr>
          <tr lang="ru">желаемое количество гранул</tr>
        </param>
        <param name="DUR" type="atom">
          <tr lang="en">duration to slice. A positive time value is expected, for example: 100ms,
          1.02s, 400samp etc. A float value is treated as milliseconds. If not specified, the whole
          source array duration is used</tr>
          <tr lang="ru">длительность для нарезки. Ожидается положительное значение времени,
          например: 100ms, 1.02s, 400samp и т.д. Числовое значение без суффикса трактуется как
          миллисекунды. Если не указано — используется вся продолжительность исходного
          массива</tr>
        </param>
        <param name="GRAIN" type="list">
          <tr lang="en">properties of sliced grains</tr>
          <tr lang="ru">свойства нарезанных гранул</tr>
        </param>
      </method>
      <!-- spread -->
      <method name="spread">
        <info>
          <tr lang="en">uniformly arranges grains to fill the specified time space</tr>
          <tr lang="ru">равномерно располагает гранулы для заполнения заданного временного
          диапазона</tr>
        </info>
        <param name="DUR" type="atom">
          <tr lang="en">time space. A positive time value is expected, for example: 100ms, 1.02s,
          400samp etc. A float value is treated as milliseconds. If not specified, the whole source
          array duration is used</tr>
          <tr lang="ru">временной диапазон. Ожидается положительное значение времени, например:
          100ms, 1.02s, 400samp и т.д. Числовое значение без суффикса трактуется как миллисекунды.
          Если не указано — используется вся продолжительность исходного массива</tr>
        </param>
        <param name="TAG" type="symbol" required="false">
          <tr lang="en">if '*' or omitted: spread all grains. If '.': spread finished grains only.
          Otherwise spread grains with the corresponding tag</tr>
          <tr lang="ru">если '*' или не указано: распределить все гранулы. Если '.': только
          завершённые гранулы. Иначе — гранулы с соответствующей меткой</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control messages</tr>
          <tr lang="ru">вход для управляющих сообщений</tr>
        </in>
        <in on="bang">
          <tr lang="en">if @sync = 'ext': starts playback of finished grains</tr>
          <tr lang="ru">если @sync = 'ext': запускает воспроизведение завершённых гранул</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left output</tr>
          <tr lang="ru">левый канал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right output</tr>
          <tr lang="ru">правый канал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[fill 80 @l 300ms @at rand\()*1s @at ondone +=100ms @pan ondone rand\() @s ondone choice\(1\,-0.5) @tb rand\()*400ms @w hann(
|
|
|
|
|         [T]
|         |
| [clear( [pause * $1(
| |       |
[array.grainer~ agr0]  [ui.dsp~]
*|*
[ui.hgain2~]
*|*
[dac~]

[table agr0]

[msg.onload load guitar1.wav to agr0 @resize]
|
| [B]
| |
| [openpanel]
| |
| [load $1 to agr0 @resize(
| |
[snd.file]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
