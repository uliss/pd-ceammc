<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="array.grainer~">
        <title>array.grainer~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">array granulator</tr>
                <tr lang="ru">гранулятор звуковой таблицы</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array grain particle granular</keywords>
            <since>0.9.2</since>
        </meta>
        <info>
            <par>Grain properties:</par>
            <par>@at - grain position in source array (in samples)</par>
            <par>@l - grain length (in samples)</par>
            <par>@amp - grain amplitude in 0..256 range</par>
            <par>@s - grain speed in -10..10 range</par>
            <par>@p - grain pan in 0..1 range</par>
            <par>@w - grain window: rect, tri or hann</par>
            <par>@tb - time before grain start (in samples)</par>
            <par>@ta - time after grain done (in samples)</par>
            <par>@r - grain number of repeats (-1: infinite)</par>
            <par>@tag - grain tag</par>
        </info>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru" finished="false">имя массива</tr>
            </property>
            <!-- @prob -->
            <property name="@prob" type="float" default="1" minvalue="0" maxvalue="1">
                <tr lang="en">grain start probability in internal or external sync mode. ('int' or
                'ext')</tr>
                <tr lang="ru" finished="false">Вероятность начала зерна во внутреннем или внешнем
                режиме синхронизации. (перенаправлено с «Ext»)</tr>
            </property>
            <!-- @sync -->
            <property name="@sync" type="symbol" default="none" enum="none int ext">
                <tr lang="en">grain sync mode. If 'none': start grains right after they are
                finished, if 'int': start grains after specified interval (@tsync).</tr>
                <tr lang="ru" finished="false">Режим синхронизации зерна. Если «нет»: начинайте
                зерна сразу после их завершения, если «int»: начинайте зерна после определенного
                интервала (@tsync).</tr>
            </property>
            <!-- @tsync -->
            <property name="@tsync" type="float" default="50" minvalue="1" units="millisecond">
                <tr lang="en">grain sync interval</tr>
                <tr lang="ru" finished="false">интервал синхронизации зерна</tr>
            </property>
        </properties>
        <methods>
            <!-- align -->
            <method name="align">align grain(s) to onset 
            <param name="SUBJ" type="atom" required="false">
                <tr lang="en">if '*' or omitted: align all grains, if '.': align finished grains
                only, if float: align grain with corresponding #id, if symbol: align grains with
                corresponding tag</tr>
                <tr lang="ru" finished="false">если "*" или опущено: выровнять все зерна, если ".":
                выровнять только готовые зерна, если плавать: выровнять зерно с соответствующим
                #id, если символ: выровнять зерна с соответствующим тегом</tr>
            </param></method>
            <!-- append -->
            <method name="append">append several grains 
            <param name="N" type="int" required="true" minvalue="1">
                <tr lang="en">number of grains</tr>
                <tr lang="ru" finished="false">Количество зерен</tr>
            </param>
            <param name="PROPS" type="list" required="true">
                <tr lang="en">grain properties</tr>
                <tr lang="ru" finished="false">Зерновые свойства</tr>
            </param></method>
            <!-- clear -->
            <method name="clear">remove grain(s) 
            <param name="SUBJ" type="atom" required="false">
                <tr lang="en">if '*' or omitted: remove all grains, if '.': remove finished grains
                only, if float: remove grain with corresponding #id, if symbol: remove grains with
                corresponding tag</tr>
                <tr lang="ru" finished="false">если «*» или опущено: удалить все зерна, если «.»:
                удалить только готовые зерна, если плавать: удалить зерно с соответствующим #id,
                если символ: удалить зерна с соответствующим тегом</tr>
            </param></method>
            <!-- defer -->
            <method name="defer">defer method call until grains will finish 
            <param name="N" type="int" minvalue="1" maxvalue="255">
                <tr lang="en">number of finished grains to wait before calling. If not specified,
                treat as 1.</tr>
                <tr lang="ru" finished="false">Количество готовых зерен, чтобы подождать, прежде
                чем звонить. Если не указано, обращайтесь как 1.</tr>
            </param>
            <param name="METHOD" type="symbol" required="true">
                <tr lang="en">method name</tr>
                <tr lang="ru" finished="false">Название метода</tr>
            </param>
            <param name="ARGS" type="list">
                <tr lang="en">method arguments</tr>
                <tr lang="ru" finished="false">Методические аргументы</tr>
            </param></method>
            <!-- fill -->
            <method name="fill">fill with grains (remove all existing grains before) 
            <param name="N" type="int" required="true" minvalue="1">
                <tr lang="en">number of grains</tr>
                <tr lang="ru" finished="false">Количество зерен</tr>
            </param>
            <param name="PROPS" type="list" required="true">
                <tr lang="en">grain properties</tr>
                <tr lang="ru" finished="false">Зерновые свойства</tr>
            </param></method>
            <!-- grain -->
            <method name="grain">create single grain 
            <param name="PROPS" type="list" required="true">
                <tr lang="en">grain properties</tr>
                <tr lang="ru" finished="false">Зерновые свойства</tr>
            </param></method>
            <!-- onsets -->
            <method name="onsets">analyze source array for onsets 
            <param name="METHOD" type="symbol" default="default"
            enum="default hfc energy complex phase wphase specdiff kl mkl specflux">
                <tr lang="en">onset detection method</tr>
                <tr lang="ru" finished="false">Метод обнаружения начала</tr>
            </param>
            <param name="SPACE" type="float" default="64" units="millisecond" required="false">
                <tr lang="en">minimal space between onsets</tr>
                <tr lang="ru" finished="false">Минимальное пространство между стартами</tr>
            </param>
            <param name="SILENCE" type="float" default="-40" units="decibel" required="false">
                <tr lang="en">silence level</tr>
                <tr lang="ru" finished="false">Уровень тишины</tr>
            </param></method>
            <!-- pause -->
            <method name="pause">pause (resume) grain(s) 
            <param name="SUBJ" type="atom" required="true">
                <tr lang="en">if '*': pause all grains, if float: pause grain with corresponding
                #id, if symbol: pause grains with matched tag</tr>
                <tr lang="ru" finished="false">если '*': приостанавливать все зерна, если плавать:
                приостанавливать зерно с соответствующим #id, если символ: приостанавливать зерно с
                соответствующим тегом</tr>
            </param>
            <param name="STATE" type="int" enum="0 1" required="false">
                <tr lang="en">on/off value</tr>
                <tr lang="ru" finished="false">валовая стоимость</tr>
            </param></method>
            <!-- permutate -->
            <method name="permutate">permutate grain positions (@ta and @tb) values 
            <param name="N" type="int" minvalue="-16" maxvalue="16">
                <tr lang="en">number of permutations. If N&gt;0 results N-th next permutation,
                N&lt;0 - N-th previous permutation</tr>
                <tr lang="ru" finished="false">Количество перестановок. Если N&gt;0 приводит к N-й
                следующей перестановке, N&lt;0 - N-й предыдущей перестановке</tr>
            </param>
            <param name="TAG" type="symbol" required="false">
                <tr lang="en">if '*' or omitted: reverse positions of all grains, if '.': reverse
                positions of finished grains only, otherwise reverse grains with corresponding
                tag</tr>
                <tr lang="ru" finished="false">если «*» или опущено: обратные положения всех зерен,
                если «.»: только обратные положения готовых зерен, в противном случае обратные
                зерна с соответствующей меткой</tr>
            </param></method>
            <!-- reverse -->
            <method name="reverse">reverse grain positions (@ta and @tb) values 
            <param name="TAG" type="symbol" required="false">
                <tr lang="en">if '*' or omitted: reverse positions of all grains, if '.': reverse
                positions of finished grains only, otherwise reverse grains with corresponding
                tag</tr>
                <tr lang="ru" finished="false">если «*» или опущено: обратные положения всех зерен,
                если «.»: только обратные положения готовых зерен, в противном случае обратные
                зерна с соответствующей меткой</tr>
            </param></method>
            <!-- set -->
            <method name="set">set grain(s) properties 
            <param name="SUBJ" type="atom" required="true">
                <tr lang="en">if '*': set for all grains, if float: set for grain with specified
                #id, if symbol: set for grains with specified tag</tr>
                <tr lang="ru" finished="false">если "*": набор для всех зерен, если поплавок: набор
                для зерен с указанным #id, если символ: набор для зерен с указанным тегом</tr>
            </param>
            <param name="PROPS" type="list" required="true">
                <tr lang="en">grain properties</tr>
                <tr lang="ru" finished="false">Зерновые свойства</tr>
            </param></method>
            <!-- shuffle -->
            <method name="shuffle">shuffle grain positions (@ta and @tb) values 
            <param name="TAG" type="symbol" required="false">
                <tr lang="en">if '*' or omitted: shuffle all grains, if '.': shuffle finished
                grains only, otherwise shuffle grains with corresponding tag</tr>
                <tr lang="ru" finished="false">если "*" или опущено: перетасовать все зерна, если
                ".": перетасовать только готовые зерна, иначе перетасовать зерна с соответствующей
                меткой</tr>
            </param></method>
            <!-- slice -->
            <method name="slice">slice specified duration to specified number of grains and add
            them 
            <param name="N" type="int" required="true" minvalue="1" maxvalue="64">
                <tr lang="en">desired number of grains</tr>
                <tr lang="ru" finished="false">Желаемое количество зерен</tr>
            </param>
            <param name="DUR" type="atom">
                <tr lang="en">duration to slice. Positive time value expected, for example: 100ms,
                1.02s, 400samp etc. Float value treat as millisecond. If not specified - use the
                whole source array duration</tr>
                <tr lang="ru" finished="false">Длительность нарезки. Ожидаемое положительное
                значение времени, например: 100 мс, 1,02s, 400samp и т.д. Поплавковое значение
                трактуется как миллисекунда. Если не указано - используйте всю продолжительность
                исходного массива</tr>
            </param>
            <param name="GRAIN" type="list">
                <tr lang="en">properties of sliced grains</tr>
                <tr lang="ru" finished="false">свойства нарезанных зерен</tr>
            </param></method>
            <!-- spread -->
            <method name="spread">uniformly arrange grains to fill specified time space 
            <param name="DUR" type="atom">
                <tr lang="en">time space. Positive time values are expected, for example: 100ms,
                1.02s, 400samp etc. Float value treat as millisecond. If not specified - use the
                whole source array duration</tr>
                <tr lang="ru" finished="false">Пространство времени. Ожидаются положительные
                временные значения, например: 100 мс, 1,02s, 400samp и т.д. Поплавковое значение
                трактуется как миллисекунда. Если не указано - используйте всю продолжительность
                исходного массива</tr>
            </param>
            <param name="TAG" type="symbol" required="false">
                <tr lang="en">if '*' or omitted: spread all grains, if '.': spread finished grains
                only, otherwise spread grains with corresponding tag</tr>
                <tr lang="ru" finished="false">если "*" или опущено: распространить все зерна, если
                ".": распространить только готовые зерна, иначе распространить зерна с
                соответствующей меткой</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>control inlet</xinfo>
                <xinfo on="bang">if @sync = 'ext': starts finished grains playback</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">left output</outlet>
            <outlet type="audio">right output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[fill 80 @l 300ms @at rand\()*1s @at ondone +=100ms @pan ondone rand\() @s ondone choice\(1\,-0.5) @tb rand\()*400ms @w hann(
|
|
|
|
|         [T]
|         |
| [clear( [pause * $1(
| |       |
[array.grainer~ agr0]  [ui.dsp~]
*|*
[ui.hgain2~]
*|*
[dac~]

[table agr0]

[msg.onload load guitar1.wav to agr0 @resize]
|
| [B]
| |
| [openpanel]
| |
| [load $1 to agr0 @resize(
| |
[snd.file]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
