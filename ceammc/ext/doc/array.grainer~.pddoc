<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="array.grainer~">
        <title>array.grainer~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">array granulator</tr>
                <tr lang="ru">гранулятор звуковой таблицы</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array grain particle granular</keywords>
            <since>0.9.2</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Grain properties:</tr>
                <tr lang="ru">Свойства гранул:</tr>
            </par>
            <par>
                <tr lang="en">@at - grain position in source array (in samples)</tr>
                <tr lang="ru">@at - положение гранулы в исходном массиве (в семплах)</tr>
            </par>
            <par>
                <tr lang="en">@l - grain length (in samples)</tr>
                <tr lang="ru">@l - длина гранулы (в семплах)</tr>
            </par>
            <par>
                <tr lang="en">@amp - grain amplitude in 0..256 range</tr>
                <tr lang="ru">@amp - амплитуда гранулы в диапазоне 0..256</tr>
            </par>
            <par>
                <tr lang="en">@s - grain speed in -10..10 range</tr>
                <tr lang="ru">@s - скорость воспроизведения гранулы в диапазоне -10..10</tr>
            </par>
            <par>
                <tr lang="en">@p - grain pan in 0..1 range</tr>
                <tr lang="ru">@p - панорама гранулы в диапазоне 0,1</tr>
            </par>
            <par>
                <tr lang="en">@w - grain window: rect, tri or hann</tr>
                <tr lang="ru">@w - окно гранулы: прямоугольное, треугольное или Ханнинга</tr>
            </par>
            <par>
                <tr lang="en">@tb - time before grain start (in samples)</tr>
                <tr lang="ru">@tb - время перед началом гранулы (в семплах)</tr>
            </par>
            <par>
                <tr lang="en">@ta - time after grain done (in samples)</tr>
                <tr lang="ru">@ta - время после гранулы (в семплах)</tr>
            </par>
            <par>
                <tr lang="en">@r - grain number of repeats (-1: infinite)</tr>
                <tr lang="ru">@r - число повторов гранулы (-1: бесконечно)</tr>
            </par>
            <par>
                <tr lang="en">@tag - grain tag</tr>
                <tr lang="ru">@tag - метка гранулы</tr>
            </par>
        </info>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </property>
            <!-- @prob -->
            <property name="@prob" type="float" default="1" minvalue="0" maxvalue="1">
                <tr lang="en">grain start probability in internal or external sync mode. ('int' or
                'ext')</tr>
                <tr lang="ru">вероятность старта гранулы во внутреннем или внешнем режиме
                синхронизации</tr>
            </property>
            <!-- @sync -->
            <property name="@sync" type="symbol" default="none" enum="none int ext">
                <tr lang="en">grain sync mode. If 'none': start grains right after they are
                finished, if 'int': start grains after specified interval (@tsync)</tr>
                <tr lang="ru">режим синхронизации гранул. Если «none»: запускает гранулы сразу
                после их завершения, если «int»: запускает гранулы после определенного интервала
                (@tsync)</tr>
            </property>
            <!-- @tsync -->
            <property name="@tsync" type="float" default="50" minvalue="1" units="millisecond">
                <tr lang="en">grain sync interval</tr>
                <tr lang="ru">интервал синхронизации гранул</tr>
            </property>
        </properties>
        <methods>
            <!-- align -->
            <method name="align">
                <info>
                    <tr lang="en">align grain(s) to onset</tr>
                    <tr lang="ru">выровнять гранулу(ы) по атаке</tr>
                </info>
                <param name="SUBJ" type="atom" required="false">
                    <tr lang="en">if '*' or omitted: align all grains, if '.': align finished
                    grains only, if number: align grain with corresponding #id, if symbol: align
                    grains with corresponding tag</tr>
                    <tr lang="ru">если "*" или не указано: выравнивает все гранулы, если ".":
                    выровнять только завершенные гранулы, если целое значение: выравнивает гранулу
                    с соответствующим #id, если символ: выровнять гранулы с соответствующим
                    тегом</tr>
                </param>
            </method>
            <!-- append -->
            <method name="append">
                <info>
                    <tr lang="en">append several grains</tr>
                    <tr lang="ru">добавить гранулы</tr>
                </info>
                <param name="N" type="int" required="true" minvalue="1">
                    <tr lang="en">number of grains</tr>
                    <tr lang="ru">количество гранул</tr>
                </param>
                <param name="PROPS" type="list" required="true">
                    <tr lang="en">grain properties</tr>
                    <tr lang="ru">свойства гранулы</tr>
                </param>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">remove grain(s)</tr>
                    <tr lang="ru">удалить гранулу(ы)</tr>
                </info>
                <param name="SUBJ" type="atom" required="false">
                    <tr lang="en">if '*' or omitted: remove all grains, if '.': remove finished
                    grains only, if float: remove grain with corresponding #id, if symbol: remove
                    grains with corresponding tag</tr>
                    <tr lang="ru">если «*» или не указано: удалить все гранулы, если «.»: удалить
                    только завершенные гранулы, если целое число: удалить гранулу с соответствующим
                    #id, если символ: удалить гранулы с соответствующим тегом</tr>
                </param>
            </method>
            <!-- defer -->
            <method name="defer">
                <info>
                    <tr lang="en">defer method call until grains will finish</tr>
                    <tr lang="ru">отсрочить вызов метода пока не завершиться некоторое число
                    гранул</tr>
                </info>
                <param name="N" type="int" minvalue="1" maxvalue="255">
                    <tr lang="en">number of finished grains to wait before calling. If not
                    specified, treat as 1.</tr>
                    <tr lang="ru">дождаться указанного количество завершенных гранул прежде чем
                    вызывать метод. Если не указано, ждет завершения одной гранулы.</tr>
                </param>
                <param name="METHOD" type="symbol" required="true">
                    <tr lang="en">method name</tr>
                    <tr lang="ru">название метода</tr>
                </param>
                <param name="ARGS" type="list">
                    <tr lang="en">method arguments</tr>
                    <tr lang="ru">аргументы метода</tr>
                </param>
            </method>
            <!-- fill -->
            <method name="fill">
                <info>
                    <tr lang="en">fill with grains (remove all existing grains before)</tr>
                    <tr lang="ru">наполнить наполнить (удалить все существующие зерна раньше)</tr>
                </info>
                <param name="N" type="int" required="true" minvalue="1">
                    <tr lang="en">number of grains</tr>
                    <tr lang="ru">число гранул</tr>
                </param>
                <param name="PROPS" type="list" required="true">
                    <tr lang="en">grain properties</tr>
                    <tr lang="ru">свойства гранул</tr>
                </param>
            </method>
            <!-- grain -->
            <method name="grain">
                <info>
                    <tr lang="en">create single grain</tr>
                    <tr lang="ru">создать гранулу</tr>
                </info>
                <param name="PROPS" type="list" required="true">
                    <tr lang="en">grain properties</tr>
                    <tr lang="ru">свойства гранулы</tr>
                </param>
            </method>
            <!-- onsets -->
            <method name="onsets">
                <info>
                    <tr lang="en">analyze source array for onsets</tr>
                    <tr lang="ru">проанализировать исходный массив на атаки</tr>
                </info>
                <param name="METHOD" type="symbol" default="default"
                enum="default hfc energy complex phase wphase specdiff kl mkl specflux">
                    <tr lang="en">onset detection method</tr>
                    <tr lang="ru">метод обнаружения атаки</tr>
                </param>
                <param name="SPACE" type="float" default="64" units="millisecond" required="false">
                    <tr lang="en">minimal space between onsets</tr>
                    <tr lang="ru">минимальный интервал между атаками</tr>
                </param>
                <param name="SILENCE" type="float" default="-40" units="decibel" required="false">
                    <tr lang="en">silence level</tr>
                    <tr lang="ru">уровень тишины</tr>
                </param>
            </method>
            <!-- pause -->
            <method name="pause">
                <info>
                    <tr lang="en">pause (resume) grain(s)</tr>
                    <tr lang="ru">приостановить или возобновить воспроизведение гранул</tr>
                </info>
                <param name="SUBJ" type="atom" required="true">
                    <tr lang="en">if '*': pause all grains, if float: pause grain with
                    corresponding #id, if symbol: pause grains with matched tag</tr>
                    <tr lang="ru">если '*': приостанавливать все гранулы, если целое число:
                    приостанавить гранулу с соответствующим #id, если символ: приостановить гранулы
                    с соответствующим тегом</tr>
                </param>
                <param name="STATE" type="int" enum="0 1" required="false">
                    <tr lang="en">on/off value</tr>
                    <tr lang="ru">значение вкл./выкл.</tr>
                </param>
            </method>
            <!-- permutate -->
            <method name="permutate">
                <info>
                    <tr lang="en">permutate grain positions (@ta and @tb) values</tr>
                    <tr lang="ru">перестановка позиций гранул (@ta и @tb)</tr>
                </info>
                <param name="N" type="int" minvalue="-16" maxvalue="16">
                    <tr lang="en">number of permutations. If N&gt;0 results N-th next permutation,
                    N&lt;0 - N-th previous permutation</tr>
                    <tr lang="ru">количество перестановок. Если N&gt;0 приводит к N-й следующей
                    перестановке, N&lt;0 - N-й предыдущей перестановке</tr>
                </param>
                <param name="TAG" type="symbol" required="false">
                    <tr lang="en">if '*' or omitted: permutates all grains, if '.': permutate
                    positions of finished grains only, otherwise permutates grains with
                    corresponding tag</tr>
                    <tr lang="ru">если «*» или не указано: переставляет все гранулы, если «.»:
                    только завершенные, если символ – гранулы с соответствующим тегом</tr>
                </param>
            </method>
            <!-- reverse -->
            <method name="reverse">
                <info>
                    <tr lang="en">reverse grain positions (@ta and @tb) values</tr>
                    <tr lang="ru" finished="false">Значения обратных позиций зерна (@ta и @tb)</tr>
                </info>
                <param name="TAG" type="symbol" required="false">
                    <tr lang="en">if '*' or omitted: reverse positions of all grains, if '.':
                    reverse positions of finished grains only, otherwise reverse grains with
                    corresponding tag</tr>
                    <tr lang="ru" finished="false">если «*» или не указано: обратить позиции всех
                    гранул, если «.»: только у завершенных гранул, если символ – только у гранул с
                    соответствующим тегом</tr>
                </param>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">set grain(s) properties</tr>
                    <tr lang="ru">установить свойства гранул(ы)</tr>
                </info>
                <param name="SUBJ" type="atom" required="true">
                    <tr lang="en">if '*': set for all grains, if float: set for grain with
                    specified #id, if symbol: set for grains with specified tag</tr>
                    <tr lang="ru">если "*": установить для всех гранул, если целое число: гранулу с
                    указанным #id, если символ: набор гранул с указанным тегом</tr>
                </param>
                <param name="PROPS" type="list" required="true">
                    <tr lang="en">grain properties</tr>
                    <tr lang="ru">свойства гранул</tr>
                </param>
            </method>
            <!-- shuffle -->
            <method name="shuffle">
                <info>
                    <tr lang="en">shuffle grain positions (@ta and @tb) values</tr>
                    <tr lang="ru">случайно перетасовать позиции гранул (@ta и @tb)</tr>
                </info>
                <param name="TAG" type="symbol" required="false">
                    <tr lang="en">if '*' or omitted: shuffle all grains, if '.': shuffle finished
                    grains only, otherwise shuffle grains with corresponding tag</tr>
                    <tr lang="ru">если "*" или не указано: перетасовывает все гранулы, если ".":
                    перетасовать только завершенные гранулы, если символ: перетасовать гранулы с
                    указанным тегом</tr>
                </param>
            </method>
            <!-- slice -->
            <method name="slice">
                <info>
                    <tr lang="en">slice specified duration to specified number of grains and add
                    them</tr>
                    <tr lang="ru">нарезать указанный диапазон на указанное количество гранул</tr>
                </info>
                <param name="N" type="int" required="true" minvalue="1" maxvalue="64">
                    <tr lang="en">desired number of grains</tr>
                    <tr lang="ru">необходимое количество гранул</tr>
                </param>
                <param name="DUR" type="atom">
                    <tr lang="en">duration to slice. Positive time value expected, for example:
                    100ms, 1.02s, 400samp etc. Float value treat as millisecond. If not specified -
                    use the whole source array duration</tr>
                    <tr lang="ru">длительность для нарезки. Ожидаются положительные значение
                    времени, например: 100 мс, 1.02s, 400samp и т.д. Числовое значение без суффикса
                    трактуется как миллисекунда. Если не указано - использует всю продолжительность
                    исходного массива</tr>
                </param>
                <param name="GRAIN" type="list">
                    <tr lang="en">properties of sliced grains</tr>
                    <tr lang="ru">свойства нарезанных гранул</tr>
                </param>
            </method>
            <!-- spread -->
            <method name="spread">
                <info>
                    <tr lang="en">uniformly arrange grains to fill specified time space</tr>
                    <tr lang="ru">равномерно расположить гранулы для заполнения заданного
                    диапазона</tr>
                </info>
                <param name="DUR" type="atom">
                    <tr lang="en">time space. Positive time values are expected, for example:
                    100ms, 1.02s, 400samp etc. Float value treat as millisecond. If not specified -
                    use the whole source array duration</tr>
                    <tr lang="ru">пространство времени. Ожидаются положительные временные значения,
                    например: 100 мс, 1.02s, 400samp и т.д. Числовое значение без суффикса
                    трактуется как миллисекунда. Если не указано - использует всю продолжительность
                    исходного массива</tr>
                </param>
                <param name="TAG" type="symbol" required="false">
                    <tr lang="en">if '*' or omitted: spread all grains, if '.': spread finished
                    grains only, otherwise spread grains with corresponding tag</tr>
                    <tr lang="ru">если "*" или опущено: распределяет все гранулы, если ".":
                    распределить только завершенные гранулы, если символ - распределить гранулы с
                    соответствующей меткой</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">control inlet</tr>
                    <tr lang="ru" finished="false">контрольный вход</tr>
                </xinfo>
                <xinfo on="bang">
                    <tr lang="en">if @sync = 'ext': starts finished grains playback</tr>
                    <tr lang="ru" finished="false">если @sync = 'ext': начинается воспроизведение
                    готовых зерен</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">left output</tr>
                </out>
            </outlet>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">right output</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[fill 80 @l 300ms @at rand\()*1s @at ondone +=100ms @pan ondone rand\() @s ondone choice\(1\,-0.5) @tb rand\()*400ms @w hann(
|
|
|
|
|         [T]
|         |
| [clear( [pause * $1(
| |       |
[array.grainer~ agr0]  [ui.dsp~]
*|*
[ui.hgain2~]
*|*
[dac~]

[table agr0]

[msg.onload load guitar1.wav to agr0 @resize]
|
| [B]
| |
| [openpanel]
| |
| [load $1 to agr0 @resize(
| |
[snd.file]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
