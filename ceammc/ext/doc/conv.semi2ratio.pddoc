<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="conv.semi2ratio">
        <title>conv.semi2ratio</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">converts interval in semitones to frequency ratio in 12-ET</tr>
                <tr lang="ru">преобразует интервал в полутонах в частотное отношение в 12-ET</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv samp</keywords>
            <since>0.9.7</since>
            <aliases>
                <alias>ceammc/semi-&gt;ratio</alias>
                <alias>semi-&gt;ratio</alias>
            </aliases>
        </meta>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">interval in semitones</tr>
                    <tr lang="ru" finished="false">интервал в полутонах</tr>
                </in>
                <in on="list">
                    <tr lang="en">list of intervals in semitones</tr>
                    <tr lang="ru" finished="false">Список интервалов в полутонах</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">float or list: frequency ratio(s)</tr>
                    <tr lang="ru" finished="false">Поплавок или список: частотное
                    соотношение(я)</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[12( [0( [1( [F]
|    |   |   |
[semi->ratio ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
