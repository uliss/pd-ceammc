<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.spi.ws2812">
    <title>hw.rpi.spi.ws2812</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">ws2812 LED strip driver for Raspberry Pi</tr>
        <tr lang="ru">драйвер для светодиодной ленты ws2812 для Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>display neopixel rpi ws2812 led</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par style="important">
        <tr lang="en">When using the object, you need to specify the number of the SPI (@spi_bus property).</tr>
        <tr lang="ru">При использовании объекта нужно указать номер используемой шины SPI (свойство @spi_bus).</tr>
      </par>
      <par style="info">
        <tr lang="en">The object uses an internal pixel buffer, with the colors of which it works
        by sending messages to the object. After finishing work with the pixel buffer, it needs to
        be sent to the LED strip using a bang or the [flush( command.</tr>
        <tr lang="ru">Объект использует внутренний буфер пикселей, с цветами которых работают при
        помощи отправки сообщений объекту. После окончания работы с пискельным буфером его нужно
        передать на светодиодную ленту при помощи bang или команды [flush(</tr>
      </par>
      <par>
        <tr lang="en">To specify the group of pixels we are going to work with,
        two types of ranges are used: @slice and @lslice.</tr>
        <tr lang="ru">Для указания группы пикселей, с которой собираемся работать, используются два
        вида диапазонов: @slice и @lslice.</tr>
      </par>
    </info>
    <properties>
      <!-- @clear -->
      <property name="@clear" type="bool" default="1">
        <tr lang="en">turn off all pixels when an object is removed</tr>
        <tr lang="ru">выключать все пиксели при удалении объекта</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="int" minvalue="1" maxvalue="4096" default="16"
      access="initonly">
        <tr lang="en">number of leds in the strip</tr>
        <tr lang="ru">количество светодиодов в ленте</tr>
      </property>
      <!-- @spi_bus -->
      <property name="@spi_bus" type="int" minvalue="-1" maxvalue="6" default="-1"
      access="initonly">
        <tr lang="en">SPI bus number. If not specified or equal to -1: the object does not perform
        any actions.</tr>
        <tr lang="ru">номер шины SPI. Если не указано или равно -1: объект не производит никаких
        действий.</tr>
      </property>
      <!-- @spi_cs -->
      <property name="@spi_cs" type="int" minvalue="0" maxvalue="3" default="0" access="initonly">
        <tr lang="en">SPI CS (chip select/enable). In most cases you don't need to set this
        property, because LED strips are not using CS pin.</tr>
        <tr lang="ru">SPI CS (chip select/enable) индекс. В большинстве случаев вам не нужно
        устанавливать это свойство, потому что светодиодные ленты не используют пин CS</tr>
      </property>
    </properties>
    <methods>
      <!-- brightness -->
      <method name="brightness">
        <info>
          <tr lang="en">set pixel brightness</tr>
          <tr lang="ru">установить якрость пикселей</tr>
        </info>
        <param name="LEVEL" type="int" minvalue="0" maxvalue="255" required="true">
          <tr lang="en">brightness level</tr>
          <tr lang="ru">уровень яркости</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">turn off all pixels</tr>
          <tr lang="ru">выключить все пиксели</tr>
        </info>
      </method>
      <!-- fill -->
      <method name="fill">
        <info>
          <tr lang="en">fill pixels with the RGB color</tr>
          <tr lang="ru">заполнить пиксели цветом RGB</tr>
        </info>
        <param name="@color ..." type="list">
          <tr lang="en">color</tr>
          <tr lang="ru">цвет</tr>
          <xi:include href="props_verbose_color0.xml" parse="xml"/>
        </param>
        <param name="@slice FIRST LAST? STEP?" type="list">
          <tr lang="en">range slice of pixels</tr>
          <tr lang="ru">дипазонный срез пикселей</tr>
          <xi:include href="props_slice_verbose.xml" parse="xml"/>
        </param>
        <param name="@lslice FIRST LENGTH? STEP?" type="list">
          <tr lang="en">slice of pixels</tr>
          <tr lang="ru">срез пикселей по длине</tr>
          <xi:include href="props_lslice_verbose.xml" parse="xml"/>
        </param>
      </method>
      <!-- flush -->
      <method name="flush">
        <info>
          <tr lang="en">flush all pixels to the strip</tr>
          <tr lang="ru">вывести и очистить внутренний буфер на ленту</tr>
        </info>
      </method>
      <!-- fx -->
      <method name="fx">
        <info>
          <tr lang="en">apply color effect function</tr>
          <tr lang="ru">применить функцию цветового эффекта</tr>
        </info>
        <param name="NAME" type="symbol"
        enum="bounce breathe collision cycle fire meteor rainbow sparkle strobe twinkle"
        required="true">
          <tr lang="en">effect name</tr>
          <tr lang="ru">название эффекта</tr>
        </param>
        <param name="@slice FIRST LAST? STEP?" type="list">
          <tr lang="en">range slice of pixels</tr>
          <tr lang="ru">дипазонный срез пикселей</tr>
          <xi:include href="props_slice_verbose.xml" parse="xml"/>
        </param>
        <param name="@lslice FIRST LENGTH? STEP?" type="list">
          <tr lang="en">slice of pixels</tr>
          <tr lang="ru">срез пикселей по длине</tr>
          <xi:include href="props_lslice_verbose.xml" parse="xml"/>
        </param>
      </method>
      <!-- rotate -->
      <method name="rotate">
        <info>
          <tr lang="en">shift all pixel by specified step</tr>
          <tr lang="ru">сдвинуть все пиксели на указанный шаг</tr>
        </info>
        <param name="SHIFT" type="int" required="true">
          <tr lang="en">shift amount</tr>
          <tr lang="ru">значение шага</tr>
        </param>
      </method>
      <!-- set_pixel -->
      <method name="set_pixel">
        <info>
          <tr lang="en">set single pixel color</tr>
          <tr lang="ru">установить цвет отдельного пикселя</tr>
        </info>
        <param name="@color ..." type="list">
          <tr lang="en">color</tr>
          <tr lang="ru">цвет</tr>
          <xi:include href="props_verbose_color0.xml" parse="xml"/>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">flush pixels to the strip</tr>
          <tr lang="ru">сбросить значения пикселей на ленту</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">no output</tr>
          <tr lang="ru">ничего не выводит</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                    [fill @slice 2 @color8 255 0 0, bang #b(
|
|                      [fill @lslice 4 4 @color8 0 255 0, bang #c(
|
[system.colorpanel @f] [fill @slice 1 15 3 @color8 0 127 255, bang #d(
|
[msg fill @color]      [fx rainbow 0.5 #e(
|
[msg.after 0 bang #a]  [F]
                       |
 [brightness #f(       [set_pixel $1 @color8 0 0 255, bang #g(


 [clear(
 |
[hw.rpi.spi.ws2812 @size 16 #x]


[ui.link @url=ceammc://img/conn_ws2812.png @title='Connection_Scheme']
[X a->x] [X b->x] [X c->x] [X d->x] [X e->x] [X f->x] [X g->x]
#e 8, bang
#x @spi_bus 0
#f 32
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
