<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="hw.rpi.spi.ws2812">
        <title>hw.rpi.spi.ws2812</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">ws2812 LED strip driver for Raspberry Pi</tr>
                <tr lang="ru">драйвер для светодиодной ленты ws2812 для Raspberry Pi</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display neopixel rpi ws2812 led</keywords>
            <since>0.9.8</since>
        </meta>
        <info>
            <par>Note: you should **flush** (with bang or [flush( message) after almost all
            pixel/color operations</par>
        </info>
        <properties>
            <!-- @clear -->
            <property name="@clear" type="bool" default="1">turn off all pixels when the object is
            deleted</property>
            <!-- @size -->
            <property name="@size" type="int" minvalue="1" maxvalue="4096" default="16"
            access="initonly">number of leds in the strip</property>
            <!-- @spi_bus -->
            <property name="@spi_bus" type="int" minvalue="0" maxvalue="6" default="0"
            access="initonly">spi bus number</property>
            <!-- @spi_cs -->
            <property name="@spi_cs" type="int" minvalue="0" maxvalue="3" default="0"
            access="initonly">spi CS (chip select/enable). In most cases you don't need to set this
            property, because LED strips are not using CS pin.</property>
        </properties>
        <methods>
            <!-- brightness -->
            <method name="brightness">set pixel brightness 
            <param name="LEVEL" type="int" minvalue="0" maxvalue="255" required="true">brightness
            level</param></method>
            <!-- clear -->
            <method name="clear">turn off all pixels</method>
            <!-- fill -->
            <method name="fill">fill all pixels with the RGB color 
            <param name="R" type="int" minvalue="0" maxvalue="255" required="true">red color
            component</param>
            <param name="G" type="int" minvalue="0" maxvalue="255" required="true">greed color
            component</param>
            <param name="B" type="int" minvalue="0" maxvalue="255" required="true">blue color
            component</param></method>
            <!-- flush -->
            <method name="flush">flush all pixels to the strip</method>
            <!-- fx -->
            <method name="fx">apply color generator function 
            <param name="NAME" type="symbol" enum="rainbow" required="true">function name</param>
            <param name="ARG" type="float" minvalue="0" maxvalue="1">function param</param>
            <param name="BEGIN" type="int">range start</param>
            <param name="LENGTH" type="int" minvalue="0">range length</param></method>
            <!-- rotate -->
            <method name="rotate">shift all pixel by specified amount 
            <param name="SHIFT" type="int" required="true">shift amount</param></method>
            <!-- set -->
            <method name="set">set single pixel color 
            <param name="R" type="int" minvalue="0" maxvalue="255" required="true">red color
            component</param>
            <param name="G" type="int" minvalue="0" maxvalue="255" required="true">greed color
            component</param>
            <param name="B" type="int" minvalue="0" maxvalue="255" required="true">blue color
            component</param></method>
            <!-- set_range -->
            <method name="set_range">set pixel range to the specified color 
            <param name="BEGIN" type="int" minvalue="0" required="true">range start</param>
            <param name="LENGTH" type="int" minvalue="1" required="true">range length</param>
            <param name="R" type="int" minvalue="0" maxvalue="255" required="true">red color
            component</param>
            <param name="G" type="int" minvalue="0" maxvalue="255" required="true">greed color
            component</param>
            <param name="B" type="int" minvalue="0" maxvalue="255" required="true">blue color
            component</param></method>
            <!-- set_slice -->
            <method name="set_slice">set pixel slice to the specified color 
            <param name="BEGIN" type="int" minvalue="0" required="true">range start</param>
            <param name="END" type="int" minvalue="0" required="true">range end</param>
            <param name="STEP" type="int" minvalue="1" required="true">slice step</param>
            <param name="R" type="int" minvalue="0" maxvalue="255" required="true">red color
            component</param>
            <param name="G" type="int" minvalue="0" maxvalue="255" required="true">greed color
            component</param>
            <param name="B" type="int" minvalue="0" maxvalue="255" required="true">blue color
            component</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">flush pixels to the strip</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>no output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]                    [set_range 4 4 255 0 0, bang #b(
|
[system.colorpanel @i] [set_slice 1 15 3 0 127 255, bang #c(
|
[msg fill]             [fx rainbow 0.5, bang #d(
|
[msg.after 0 bang #a]  [F]
                       |
 [brightness #e(       [set $1 0 0 255, bang #f(


 [clear(
 |
[hw.rpi.spi.ws2812 @size 16 #x]


[ui.link @url=ceammc://img/conn_ws2812.png @title='Connection_Scheme']
[X a->x] [X b->x] [X c->x] [X d->x] [X e->x] [X f->x]
#e 8, bang
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
