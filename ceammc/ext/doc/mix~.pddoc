<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="mix~">
    <title>mix~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">multichannel signal mixer</tr>
        <tr lang="ru">многоканальный микшер сигналов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>mix amplitude decibel</keywords>
      <since>0.6</since>
      <aliases>
        <alias>ceammc/mix~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object mixes several audio inputs into a single audio output. Each
        input has its own gain, mute and solo state. Amplitude can be set either in linear
        values via @value or in decibels via @db. Changes are smoothed over the time
        specified by @xfade_time to avoid clicks.</tr>
        <tr lang="ru">Объект микширует несколько аудиовходов в один аудиовыход. Каждый вход
        имеет собственное усиление, состояние mute и solo. Амплитуду можно задавать либо
        в линейных значениях через @value, либо в децибелах через @db. Изменения
        сглаживаются за время, указанное в @xfade_time, чтобы избежать щелчков.</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="2" maxvalue="16">
        <tr lang="en">number of inputs</tr>
        <tr lang="ru">количество входов</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @db -->
      <property name="@db" type="list" minvalue="-144" units="decibel" default="-144 -144">
        <tr lang="en">amplitude values in decibels</tr>
        <tr lang="ru">значения амплитуды в децибелах</tr>
      </property>
      <!-- @mute -->
      <property name="@mute" type="list" default="0 0">
        <tr lang="en">mute channel list, allowed values: 0, 1</tr>
        <tr lang="ru">список каналов в режиме mute, допустимые значения: 0, 1</tr>
      </property>
      <!-- @solo -->
      <property name="@solo" type="list" default="0 0">
        <tr lang="en">solo channel list, allowed values: 0, 1</tr>
        <tr lang="ru">список каналов в режиме solo, допустимые значения: 0, 1</tr>
      </property>
      <!-- @value -->
      <property name="@value" type="list" minvalue="0" default="0 0">
        <tr lang="en">linear amplitude values</tr>
        <tr lang="ru">значения линейной амплитуды</tr>
      </property>
      <!-- @xfade_time -->
      <property name="@xfade_time" type="float" minvalue="1" default="20" units="millisecond">
        <tr lang="en">smooth time</tr>
        <tr lang="ru">время сглаживания</tr>
      </property>
    </properties>
    <methods>
      <!-- mute -->
      <method name="mute">
        <info>
          <tr lang="en">mute specified channel</tr>
          <tr lang="ru">выключить звук указанного канала</tr>
        </info>
        <param name="CH" type="int" minvalue="0" required="true">
          <tr lang="en">channel index (from 0)</tr>
          <tr lang="ru">индекс канала (начиная с 0)</tr>
        </param>
        <param name="VAL" type="int" enum="0 1" required="true">
          <tr lang="en">1 - mute, 0 - unmute</tr>
          <tr lang="ru">1 - выключить звук, 0 - включить звук</tr>
        </param>
      </method>
      <!-- solo -->
      <method name="solo">
        <info>
          <tr lang="en">solo (mute all others that are not solo) specified channel</tr>
          <tr lang="ru">solo (выключить все остальные каналы, не находящиеся в режиме solo)
          для указанного канала</tr>
        </info>
        <param name="CH" type="int" minvalue="0" required="true">
          <tr lang="en">channel index (from 0)</tr>
          <tr lang="ru">индекс канала (начиная с 0)</tr>
        </param>
        <param name="VAL" type="int" enum="0 1">
          <tr lang="en">1 - enable solo, 0 - disable solo</tr>
          <tr lang="ru">1 - включить solo, 0 - отключить solo</tr>
        </param>
      </method>
    </methods>
    <inlets dynamic="true">
      <inlet type="audio" number="1">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in on="float">
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output mixed signal</tr>
          <tr lang="ru">выходной смешанный сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.sliders @count 4]     [ui.dsp~]
|
|
|
|
|
|                                          [ui.radio #e] [ui.radio #f]
|                                          |             |
|  [osc~ #a] [osc~ #b] [osc~ #c] [osc~ #d] [msg @mute]   [msg @solo]
|  |         |         |         |         |             |
|  |         |.        |..       |...      |             |
[mix~ 4                                                  ]
|
[ui.gain~ @size 120 16]
|\
[dac~]

#a 200
#b 400
#c 600
#d 800
#e @nitems 4 @mode 1
#f @nitems 4 @mode 1
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
