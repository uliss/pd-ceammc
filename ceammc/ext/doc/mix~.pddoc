<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="mix~">
        <title>mix~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">multichannel signal mixer</tr>
                <tr lang="ru">многоканальный микшер сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>mix amplitude decibel</keywords>
            <since>0.6</since>
            <aliases>
                <alias>ceammc/mix~</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="2" maxvalue="16">
                <tr lang="en">number of inputs</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @db -->
            <property name="@db" type="list" minvalue="-144" units="decibel" default="-144 -144">
                <tr lang="en">amplitude values in decibels</tr>
            </property>
            <!-- @mute -->
            <property name="@mute" type="list" default="0 0">
                <tr lang="en">mute channel list, allowed values: 0, 1</tr>
            </property>
            <!-- @solo -->
            <property name="@solo" type="list" default="0 0">
                <tr lang="en">solo channel list, allowed values: 0, 1</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="list" minvalue="0" default="0 0">
                <tr lang="en">linear amplitude values</tr>
            </property>
            <!-- @xfade_time -->
            <property name="@xfade_time" type="float" minvalue="1" default="20"
            units="millisecond">
                <tr lang="en">smooth time</tr>
            </property>
        </properties>
        <methods>
            <!-- mute -->
            <method name="mute">
                <info>
                    <tr lang="en">mute specified channel</tr>
                </info>
                <param name="CH" type="int" minvalue="0" required="true">
                    <tr lang="en">channel index (from 0)</tr>
                </param>
                <param name="VAL" type="int" enum="0 1" required="true">
                    <tr lang="en">1 - mute, 0 - unmute</tr>
                </param>
            </method>
            <!-- solo -->
            <method name="solo">
                <info>
                    <tr lang="en">solo (mute all others that not solo) specified channel</tr>
                </info>
                <param name="CH" type="int" minvalue="0" required="true">
                    <tr lang="en">channel index (from 0)</tr>
                </param>
                <param name="VAL" type="int" enum="0 1">
                    <tr lang="en">1 - enable solo, 0 - disable solo</tr>
                </param>
            </method>
        </methods>
        <inlets dynamic="true">
            <inlet type="audio" number="1">
                <xinfo>input signal</xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>input signal</xinfo>
            </inlet>
            <inlet type="audio" number="n">
                <xinfo on="float">input signal</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output mixed signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.sliders @count 4]     [ui.dsp~]
|
|
|
|
|
|                                          [ui.radio #e] [ui.radio #f]
|                                          |             |
|  [osc~ #a] [osc~ #b] [osc~ #c] [osc~ #d] [msg @mute]   [msg @solo]
|  |         |         |         |         |             |
|  |         |.        |..       |...      |             |
[mix~ 4                                                  ]
|
[ui.gain~ @size 120 16]
|\
[dac~]

#a 200
#b 400
#c 600
#d 800
#e @nitems 4 @mode 1
#f @nitems 4 @mode 1
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
