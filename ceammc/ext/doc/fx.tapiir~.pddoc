            <property name="@tap5.delay" type="float" default="0" minvalue="0" maxvalue="5000"
            units="millisecond">
                <tr lang="en">tap5 delay time</tr>
                <tr lang="ru" finished="false">TAP5 Время задержки</tr>
            </property>
            <!-- @tap5.fb0 -->
            <property name="@tap5.fb0" type="float" default="0" minvalue="0" maxvalue="1">
                <tr lang="en">tap0 feedback to tap5</tr>
                <tr lang="ru" finished="false">Обратная связь от tap0 к tap5</tr>
            </property>
            <!-- @tap5.fb1 -->
            <property name="@tap5.fb1" type="float" default="0" minvalue="0" maxvalue="1">
                <tr lang="en">tap1 feedback to tap5</tr>
                <tr lang="ru" finished="false">Обратная связь от tap1 к tap5</tr>
            </property>
            <!-- @tap5.fb2 -->
            <property name="@tap5.fb2" type="float" default="0" minvalue="0" maxvalue="1">
                <tr lang="en">tap2 feedback to tap5</tr>
                <tr lang="ru" finished="false">Обратная связь tap2 с tap5</tr>
            </property>
            <!-- @tap5.fb3 -->
            <property name="@tap5.fb3" type="float" default="0" minvalue="0" maxvalue="1">
                <tr lang="en">tap3 feedback to tap5</tr>
                <tr lang="ru" finished="false">Обратная связь tap3 с tap5</tr>
            </property>
            <!-- @tap5.fb4 -->
            <property name="@tap5.fb4" type="float" default="0" minvalue="0" maxvalue="1">
                <tr lang="en">tap4 feedback to tap5</tr>
                <tr lang="ru" finished="false">Обратная связь tap4 с tap5</tr>
            </property>
            <!-- @tap5.fb5 -->
            <property name="@tap5.fb5" type="float" default="0" minvalue="0" maxvalue="1">
                <tr lang="en">tap5 feedback to tap5</tr>
                <tr lang="ru" finished="false">Обратная связь от tap5 к tap5</tr>
            </property>
            <!-- @tap5.gain -->
            <property name="@tap5.gain" type="float" default="0" minvalue="-60" maxvalue="0"
            units="decibel">
                <tr lang="en">tap5 common level</tr>
                <tr lang="ru" finished="false">TAP5 Общий уровень</tr>
            </property>
            <!-- @tap5.in0 -->
            <property name="@tap5.in0" type="float" default="1" minvalue="0" maxvalue="1">
                <tr lang="en">left input level to tap5</tr>
                <tr lang="ru" finished="false">левый входной уровень для tap5</tr>
            </property>
            <!-- @tap5.in1 -->
            <property name="@tap5.in1" type="float" default="1" minvalue="0" maxvalue="1">
                <tr lang="en">right input level to tap5</tr>
                <tr lang="ru" finished="false">Правильный входной уровень для tap5</tr>
            </property>
        </properties>
        <methods>
            <!-- pingpong -->
            <method name="pingpong">
                <info>
                    <tr lang="en">set pingpong delay values</tr>
                    <tr lang="ru" finished="false">установить значения задержки пингпонга</tr>
                </info>
                <param name="DELAY" type="float" units="millisecond" required="true">
                    <tr lang="en">delay time</tr>
                    <tr lang="ru" finished="false">задержка времени</tr>
                </param>
                <param name="FB" type="float" minvalue="0" maxvalue="1" required="true">
                    <tr lang="en">feedback value</tr>
                    <tr lang="ru" finished="false">значение обратной связи</tr>
                </param>
            </method>
            <!-- random -->
            <method name="random">
                <info>
                    <tr lang="en">randomize values</tr>
                    <tr lang="ru" finished="false">рандомизированные значения</tr>
                </info>
                <param name="TYPE" type="symbol" enum="delays fb inputs outputs gains"
                required="true">
                    <tr lang="en">group name. If 'delays' - randomize @delays properties, if 'fb' -
                    randomize @fb* properties.</tr>
                    <!-- old: название группы. Если «задержки» —
                    рандомизируйте свойства @delays, если «fb» — рандомизируйте свойства @fb*. -->
                    <tr lang="ru" finished="false">название группы. Если «задержки» —
                    рандомизируйте свойства @delays, если «fb» — рандомизируйте свойства @fb*.</tr>
                </param>
                <param name="MIN" type="float" minvalue="0">
                    <tr lang="en">minimal value</tr>
                    <tr lang="ru" finished="false">Минимальная ценность</tr>
                </param>
                <param name="MAX" type="float" minvalue="0">
                    <tr lang="en">maximum value</tr>
                    <tr lang="ru" finished="false">максимальное значение</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                    <tr lang="ru" finished="false">Перезагрузка в начальное состояние</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">left in channel</tr>
                    <tr lang="ru" finished="false">Остаться в канале</tr>
                </xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">right in channel</tr>
                    <tr lang="ru" finished="false">Прямо в канале</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">left out channel</tr>
                    <tr lang="ru" finished="false">Выброшенный канал</tr>
                </out>
            </outlet>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">right out channel</tr>
                    <tr lang="ru" finished="false">Прямой канал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
