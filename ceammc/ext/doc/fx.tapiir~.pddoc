<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="fx.tapiir~">
        <title>fx.tapiir~</title>
        <meta>
            <authors>
                <author>Viacheslav Lotsmanov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">multi-tap delay</tr>
                <tr lang="ru">многоуровневая задержка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx delay tapiir</keywords>
            <since>0.9.4</since>
        </meta>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1">
                <tr lang="en">on/off dsp processing</tr>
            </property>
            <!-- @delays -->
            <property name="@delays" type="list" default="0 0 0 0 0 0" units="millisecond">
                <tr lang="en">list of all tap delays</tr>
            </property>
            <!-- @fbs0 -->
            <property name="@fbs0" type="list" default="0 0 0 0 0 0" minvalue="0" maxvalue="1">
                <tr lang="en">list of all feedbacks to tap0</tr>
            </property>
            <!-- @fbs1 -->
            <property name="@fbs1" type="list" default="0 0 0 0 0 0" minvalue="0" maxvalue="1">
                <tr lang="en">list of all feedbacks to tap1</tr>
            </property>
            <!-- @fbs2 -->
            <property name="@fbs2" type="list" default="0 0 0 0 0 0" minvalue="0" maxvalue="1">
                <tr lang="en">list of all feedbacks to tap2</tr>
            </property>
            <!-- @fbs3 -->
            <property name="@fbs3" type="list" default="0 0 0 0 0 0" minvalue="0" maxvalue="1">
                <tr lang="en">list of all feedbacks to tap3</tr>
            </property>
            <!-- @fbs4 -->
            <property name="@fbs4" type="list" default="0 0 0 0 0 0" minvalue="0" maxvalue="1">
                <tr lang="en">list of all feedbacks to tap4</tr>
            </property>
            <!-- @fbs5 -->
            <property name="@fbs5" type="list" default="0 0 0 0 0 0" minvalue="0" maxvalue="1">
                <tr lang="en">list of all feedbacks to tap5</tr>
            </property>
            <!-- @gains -->
            <property name="@gains" type="list" default="0 0 0 0 0 0" units="decibel">
                <tr lang="en">list of all tap gains</tr>
            </property>
            <!-- @ins0 -->
            <property name="@ins0" type="list" default="1 1 1 1 1 1" minvalue="0" maxvalue="1">
                <tr lang="en">list of all taps left channel input levels</tr>
            </property>
            <!-- @ins1 -->
            <property name="@ins1" type="list" default="1 1 1 1 1 1" minvalue="0" maxvalue="1">
                <tr lang="en">list of all taps right channel input levels</tr>
            </property>
            <!-- @out0.gain -->
            <property name="@out0.gain" type="float" default="0" minvalue="-60" maxvalue="0"
            units="decibel">
                <tr lang="en">left channel output gain</tr>
            </property>
            <!-- @out0.in0 -->
            <property name="@out0.in0" type="float" default="0" minvalue="0" maxvalue="1">
                <tr lang="en">input left channel level to left output</tr>
            </property>
            <!-- @out0.in1 -->
            <property name="@out0.in1" type="float" default="0" minvalue="0" maxvalue="1">
