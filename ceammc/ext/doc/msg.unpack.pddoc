<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="msg.unpack">
    <title>msg.unpack</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">message unpack to selector and arguments</tr>
        <tr lang="ru">распаковка сообщения на селектор и аргументы</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>msg</category>
      <keywords>message unpack</keywords>
      <since>0.9.8</since>
      <also>
        <see>msg</see>
        <see>msg.pack</see>
      </also>
    </meta>
    <arguments>
      <argument name="N" type="int" minvalue="1" maxvalue="32">
        <tr lang="en">number of outputs</tr>
        <tr lang="ru">количество выходов</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @n -->
      <property name="@n" type="int" minvalue="1" default="1" maxvalue="32" access="initonly">
        <tr lang="en">number of outputs</tr>
        <tr lang="ru">количество выходов</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">any messages</tr>
          <tr lang="ru">любые сообщения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="symbol">
          <tr lang="en">message selector</tr>
          <tr lang="ru">селектор сообщений</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="atom">
          <tr lang="en">message atom</tr>
          <tr lang="ru">элемент сообщения</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="atom">
          <tr lang="en">n-th element of the message</tr>
          <tr lang="ru">n-й элемент сообщения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang #a(  [1 2 3 4 #d(  [L]
                         |
 [12.3 #b( [msg A 2 #e(  [msg #g]

   [symbol ABC #c(

 [1 2(     [msg A B 1 2 #f(
 |
[msg.unpack 3 #x]
|
[ui.dt #k]

     [ui.dt #l]

          [ui.dt #m]

[X a->x] [X b->x] [X c->x] [X d->x] [X g->x]
[X x:1->l] [X x:2->m] [X e->x] [X f->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
