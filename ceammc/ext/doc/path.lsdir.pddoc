<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="path.lsdir">
        <title>path.lsdir</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">list directory contents</tr>
                <tr lang="ru">cписок содержимого каталога</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>path</category>
            <keywords>path list</keywords>
            <since>0.2</since>
            <aliases>
                <alias>path.ls</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="PATH" type="list">
                <tr lang="en">init directory value</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @match -->
            <property name="@match" type="symbol" default="">
                <tr lang="en">match mask: for example *.wav for all wav files</tr>
            </property>
            <!-- @path -->
            <property name="@path" type="list" default="">
                <tr lang="en">current path</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">output directory content</xinfo>
                <xinfo on="symbol">set directory path (symbol or string) and output it content. If
                not absolute path is given list current patch directory</xinfo>
            </inlet>
            <inlet>
                <xinfo on="symbol">set @match property</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list of strings</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(     [symbol /(     [B]              [S digits=10]
|          |              |                |.
|          |              [path.lsdir ~ @match *.aiff]
|          |              |
[path.lsdir ~]            [ui.dt]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
