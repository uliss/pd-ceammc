<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="path.lsdir">
    <title>path.lsdir</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">list directory contents</tr>
        <tr lang="ru">выводит список содержимого каталога</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>path</category>
      <keywords>path list</keywords>
      <since>0.2</since>
      <aliases>
        <alias>path.ls</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object outputs a list of file names found in the specified directory</tr>
        <tr lang="ru">объект выводит список имён файлов, найденных в указанном каталоге</tr>
      </par>
      <par>
        <tr lang="en">the @match property filters the results by a mask, for example *.wav for all wav files</tr>
        <tr lang="ru">свойство @match фильтрует результаты по маске, например *.wav для всех файлов wav</tr>
      </par>
    </info>
    <arguments>
      <argument name="PATH" type="list">
        <tr lang="en">initial directory value</tr>
        <tr lang="ru">начальное значение каталога</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @match -->
      <property name="@match" type="symbol" default="">
        <tr lang="en">match mask: for example *.wav for all wav files</tr>
        <tr lang="ru">маска совпадения: например *.wav для всех файлов wav</tr>
      </property>
      <!-- @path -->
      <property name="@path" type="list" default="">
        <tr lang="en">current path</tr>
        <tr lang="ru">текущий путь</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output directory content</tr>
          <tr lang="ru">вывести содержимое каталога</tr>
        </in>
        <in on="symbol">
          <tr lang="en">set the directory path (symbol or string) and output its content. If a relative path is given, it is resolved relative to the current patch directory</tr>
          <tr lang="ru">задать путь каталога (символ или строка) и вывести его содержимое. Если указан неабсолютный путь, выводится относительно текущего каталога патча</tr>
        </in>
      </inlet>
      <inlet>
        <in on="symbol">
          <tr lang="en">set @match property</tr>
          <tr lang="ru">задать свойство @match</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">list of strings</tr>
          <tr lang="ru">список строк</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang(     [symbol /(     [B]              [S digits=10]
|          |              |                |.
|          |              [path.lsdir ~ @match *.aiff]
|          |              |
[path.lsdir ~]            [ui.dt]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
