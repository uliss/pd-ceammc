<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="convolve~">
        <title>convolve~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">real-time FFT convolution</tr>
                <tr lang="ru">свёртка FFT в реальном времени</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>fft convolution IR impulse response</keywords>
            <since>0.9.7</since>
            <aliases>
                <alias>ceammc/convolve~</alias>
            </aliases>
        </meta>
        <properties>
            <!-- @maxsize -->
            <property name="@maxsize" type="int" default="50000" maxvalue="300000" units="sample"
            minvalue="0">
                <tr lang="en">max impulse response size</tr>
            </property>
            <!-- @norm -->
            <property name="@norm" type="bool" default="1">
                <tr lang="en">normalize impulse response</tr>
            </property>
            <!-- @offset -->
            <property name="@offset" type="int" default="0" minvalue="0" units="sample">
                <tr lang="en">impulse response (IR) offset</tr>
            </property>
        </properties>
        <methods>
            <!-- load_array -->
            <method name="load_array">load IR from array 
            <param name="ARRAY" type="symbol" required="true">
                <tr lang="en">array name</tr>
            </param></method>
            <!-- load_file -->
            <method name="load_file">load IR from specified file (resamples if required from file
            samplerate to runtime samplerate) 
            <param name="FILE" type="atom" required="true">
                <tr lang="en">file name, relative or absolute</tr>
            </param></method>
            <!-- set -->
            <method name="set">set IR from list 
            <param name="LIST" type="float" required="true">
                <tr lang="en">IR data</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>input signal</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env]
|
[readsf~]  [msg.onload load_file ir/ir_church1_wide.wav]
|          |
[convolve~ ]    [ui.dsp~]
|
[ui.hgain~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
