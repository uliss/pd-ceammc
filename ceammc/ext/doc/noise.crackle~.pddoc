<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="noise.crackle~">
        <title>noise.crackle~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sparse noise generator</tr>
                <tr lang="ru">генератор разреженного шума</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>noise</category>
            <keywords>noise crackle</keywords>
            <since>0.6</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Random impulses in the amplitude range -1 to 1 are generated at an
                average rate of @freq impulses per second</tr>
                <!-- old: Случайные импульсы в амплитуде от -1 до 1
                генерируются со средней скоростью импульсов @freq в секунду. -->
                <tr lang="ru" finished="false">Случайные импульсы в амплитуде от -1 до 1
                генерируются со средней скоростью импульсов @freq в секунду.</tr>
            </par>
        </info>
        <arguments>
            <argument name="FREQ" type="float" minvalue="0" maxvalue="100" units="hertz">
                <tr lang="en">average frequency of noise impulses per second</tr>
                <tr lang="ru" finished="false">Средняя частота шумовых импульсов в секунду</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="0" maxvalue="100" default="10"
            units="hertz">
                <tr lang="en">average frequency of noise impulses per second</tr>
                <tr lang="ru" finished="false">Средняя частота шумовых импульсов в секунду</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">set average frequency</tr>
                    <tr lang="ru" finished="false">Установить среднюю частоту</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal</tr>
                    <tr lang="ru" finished="false">выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[@freq 3( [@freq 50(
|         |
[noise.crackle~ ]
|
[ui.gain~ @size 120 16]
|\
[dac~]

[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
