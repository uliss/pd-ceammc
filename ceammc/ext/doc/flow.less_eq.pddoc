<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.less_eq">
    <title>flow.less_eq</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">numeric stream router by 'less or equal' condition</tr>
        <tr lang="ru">маршрутизатор числового потока по условию «меньше или равно»</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>gate</keywords>
      <since>0.4</since>
      <aliases>
        <alias>flow.&lt;=</alias>
      </aliases>
      <also>
        <see>flow.less</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes the incoming numbers to the outlets according to the compare values: a number that is less than or equal to the first value goes to the first outlet, a number less than or equal to the N-th value goes to the N-th outlet</tr>
        <tr lang="ru">объект направляет входящие числа на выходы согласно пороговым значениям: число, меньшее или равное первому значению, идёт на первый выход, число, меньшее или равное N-му значению, идёт на N-й выход</tr>
      </par>
      <par>
        <tr lang="en">numbers greater than the last compare value are sent to the last outlet</tr>
        <tr lang="ru">числа, большие последнего порогового значения, отправляются на последний выход</tr>
      </par>
      <par>
        <tr lang="en">the compare values must be in ascending order</tr>
        <tr lang="ru">пороговые значения должны идти по возрастанию</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to split a numeric stream into ranges, for example to map note pitches to different instruments or to divide a sensor range into zones</tr>
        <tr lang="ru">объект можно использовать для разбиения числового потока на диапазоны, например для распределения нот по разным инструментам или деления диапазона датчика на зоны</tr>
      </par>
    </info>
    <arguments>
      <argument name="VALUES" type="list">
        <tr lang="en">compare values: list of floats in ascending order</tr>
        <tr lang="ru">пороговые значения: список чисел в порядке возрастания</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @values -->
      <property name="@values" type="list" access="initonly" default="">
        <tr lang="en">compare values: list of floats in ascending order</tr>
        <tr lang="ru">пороговые значения: список чисел в порядке возрастания</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input flow</tr>
          <tr lang="ru">входной поток</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="float">
          <tr lang="en">numbers that are less than or equal to the 1st argument</tr>
          <tr lang="ru">числа, меньшие или равные 1-му аргументу</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="float">
          <tr lang="en">numbers that are less than or equal to the ... argument</tr>
          <tr lang="ru">числа, меньшие или равные ... аргументу</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="float">
          <tr lang="en">numbers that are less than or equal to the N-th argument</tr>
          <tr lang="ru">числа, меньшие или равные N-му аргументу</tr>
        </out>
      </outlet>
      <outlet number="n+1">
        <out type="float">
          <tr lang="en">numbers that are greater than the last argument</tr>
          <tr lang="ru">числа, большие последнего аргумента</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]
|
|
|
[flow.less_eq 0 10 20 30   ]
|     ^|   ^^|   ^^^|  ^^^^|
[F]   [F]   [F]   [F]    [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
