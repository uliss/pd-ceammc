<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flow.less_eq">
        <title>flow.less_eq</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">numeric stream router by 'less or equal' condition</tr>
                <tr lang="ru">маршрутизатор числового потока по условию 'меньше или равно'</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>gate</keywords>
            <since>0.4</since>
            <aliases>
                <alias>flow.&lt;=</alias>
            </aliases>
            <also>
                <see>flow.less</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Numbers thar are *less equal* then N-th argument are passed to N-th
                inlet</tr>
                <!-- old: Числа тар *менее равны*, затем N-й аргумент
                передается на N-й вход -->
                <tr lang="ru" finished="false">Числа тар *менее равны*, затем N-й аргумент
                передается на N-й вход</tr>
            </par>
        </info>
        <arguments>
            <argument name="VALUES" type="list">
                <tr lang="en">compare values: list of floats in ascending order</tr>
                <!-- old: Сравнительные значения: список поплавков в порядке
                возрастания -->
                <tr lang="ru" finished="false">Сравнительные значения: список поплавков в порядке
                возрастания</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @values -->
            <property name="@values" type="list" access="initonly" default="">
                <tr lang="en">compare values: list of floats in ascending order</tr>
                <!-- old: Сравнительные значения: список поплавков в порядке
                возрастания -->
                <tr lang="ru" finished="false">Сравнительные значения: список поплавков в порядке
                возрастания</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">input flow</tr>
                    <tr lang="ru" finished="false">входной поток</tr>
                </in>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="any">
                    <tr lang="en">numbers that are less equal then 1st argument</tr>
                    <tr lang="ru" finished="false">Число, которое меньше, чем 1-й аргумент</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">numbers that are less equal than ... argument</tr>
                    <tr lang="ru" finished="false">Цифры, которые меньше, чем ... аргумент</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">numbers that are less equal than N-th argument</tr>
                    <tr lang="ru" finished="false">числа, которые менее равны, чем аргумент N</tr>
                </out>
            </outlet>
            <outlet number="n+1">
                <out type="any">
                    <tr lang="en">numbers that are greater than last argument</tr>
                    <tr lang="ru" finished="false">Цифры, которые больше, чем последний
                    аргумент</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
|
|
[flow.less_eq 0 10 20 30   ]
|     ^|   ^^|   ^^^|  ^^^^|
[F]   [F]   [F]   [F]    [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
