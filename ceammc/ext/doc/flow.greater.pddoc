<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flow.greater">
        <title>flow.greater</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">numeric stream router by 'greater' condition</tr>
                <tr lang="ru">маршрутизатор числового потока по условию 'больше'</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>gate greater</keywords>
            <since>0.9.1</since>
            <aliases>
                <alias>flow.&gt;</alias>
            </aliases>
            <also>
                <see>flow.less</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Numbers that are *less* or *equal* then last argument are passed to
                the N-th inlet</tr>
                <!-- old: Числа, которые *меньше* или *равны*, затем последний
                аргумент передается на вход N-го числа. -->
                <tr lang="ru" finished="false">Числа, которые *меньше* или *равны*, затем последний
                аргумент передается на вход N-го числа.</tr>
            </par>
        </info>
        <arguments>
            <argument name="VALUES" type="list">
                <tr lang="en">compare values: list of floats in descending order</tr>
                <!-- old: Сравнительные значения: список поплавков в
                нисходящем порядке -->
                <tr lang="ru" finished="false">Сравнительные значения: список поплавков в
                нисходящем порядке</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @values -->
            <property name="@values" type="list" access="initonly" default="">
                <tr lang="en">compare values: list of floats in descending order</tr>
                <!-- old: Сравнительные значения: список поплавков в
                нисходящем порядке -->
                <tr lang="ru" finished="false">Сравнительные значения: список поплавков в
                нисходящем порядке</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">input flow</tr>
                    <tr lang="ru" finished="false">входной поток</tr>
                </in>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="any">
                    <tr lang="en">numbers that are greater then 1st argument</tr>
                    <tr lang="ru" finished="false">Число, которое больше 1-го аргумента</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">numbers that are greater than ... argument</tr>
                    <tr lang="ru" finished="false">Цифры, которые превосходят... аргументы</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">numbers that are greater than last argument</tr>
                    <tr lang="ru" finished="false">Цифры, которые больше, чем последний
                    аргумент</tr>
                </out>
            </outlet>
            <outlet number="n+1">
                <out type="any">
                    <tr lang="en">numbers that are less or equal than last argument</tr>
                    <tr lang="ru" finished="false">Число, которое меньше или равно последнему
                    аргументу</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
|
|
[flow.greater 100 10 1]
|     ^|   ^^|   ^^^|
[F]   [F]   [F]   [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
