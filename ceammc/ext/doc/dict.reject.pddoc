<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="dict.reject">
    <title>dict.reject</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">rejects specified keys from the dictionary</tr>
        <tr lang="ru">удаляет указанные ключи из словаря</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>reject dictionary</keywords>
      <since>0.7</since>
      <also>
        <see>data.dict</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes a dictionary and outputs a new dictionary without the keys
        listed in KEYS (or set via the @keys property). All other keys are kept as is. </tr>
        <tr lang="ru">Объект принимает словарь и выводит новый словарь без ключей, перечисленных в
        KEYS (или заданных через свойство @keys). Все остальные ключи сохраняются без изменений.</tr>
      </par>
    </info>
    <arguments>
      <argument name="KEYS" type="list">
        <tr lang="en">list of keys to remove from the output dictionary. All other keys will be
        kept</tr>
        <tr lang="ru">список ключей, которые нужно удалить из выходного словаря. Все остальные ключи
        будут сохранены</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @keys -->
      <property name="@keys" type="list" default="">
        <tr lang="en">current list of keys to reject.</tr>
        <tr lang="ru">текущий список отклоняемых ключей.</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="data:dict">
          <tr lang="en">input dictionary. On receipt, the object immediately outputs a filtered
          dictionary with the specified keys removed</tr>
          <tr lang="ru">входной словарь. При получении объект сразу выводит отфильтрованный
          словарь с удалёнными указанными ключами</tr>
        </in>
      </inlet>
      <inlet>
        <in>
          <tr lang="en">set the list of keys to reject</tr>
          <tr lang="ru">задать список отклоняемых ключей</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">new dict with filtered keys</tr>
          <tr lang="ru">новый словарь с отфильтрованными ключами</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[\[a: b c: d e: f\], bang(
|
[dict]     [list a e(
|          |.
[dict.reject c]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
