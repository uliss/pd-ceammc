<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="dict.reject">
        <title>dict.reject</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">rejects specified keys from the dictionary</tr>
                <tr lang="ru">удаляет указанные ключи из словаря</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>reject dictionary</keywords>
            <since>0.7</since>
            <also>
                <see>data.dict</see>
            </also>
        </meta>
        <arguments>
            <argument name="KEYS" type="list">
                <tr lang="en">keys</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @keys -->
            <property name="@keys" type="list" default="">
                <tr lang="en">rejected keys</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="data:dict">
                    <tr lang="en">input dictionary</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">set rejected keys</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>new dict with filtered keys</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[\[a: b c: d e: f\], bang(
|
[dict]     [list a e(
|          |.
[dict.reject c]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
