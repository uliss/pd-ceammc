<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="xfade~">
    <title>xfade~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">multichannel cross-fade</tr>
        <tr lang="ru">многоканальный кроссфейд</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>crossfade xfade</keywords>
      <since>0.6</since>
      <aliases>
        <alias>ceammc/xfade~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The control float value in the range [0, N−1] selects the crossfade between
        the input signals: [0, 1) fades between the first and second signal, [1, 2) between the
        second and third, and so on. Integer values produce a single input, fractional values
        produce a blend of two neighbouring inputs.</tr>
        <tr lang="ru">Управляющее значение на входе в диапазоне [0, N−1] задаёт кроссфейд между
        входными сигналами: [0, 1) — переход между первым и вторым, [1, 2) — между вторым и
        третьим, и т. д. Целые значения соответствуют одному входу, дробные — смеси двух соседних
        входов.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Smooth switching between audio sources — crossfading between several
        oscillators, samplers or live inputs without clicks, for example selecting an active sound
        source by a single continuous parameter.</tr>
        <tr lang="ru">• Плавное переключение между аудиоисточниками — кроссфейд между несколькими
        осцилляторами, сэмплерами или живыми входами без щелчков, например выбор активного
        источника одним непрерывным параметром.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Layered transitions in performance — morphing between different textures,
        effects or voices on the fly, with a musical rather than abrupt transition, controlled
        from a single knob, LFO or automation curve.</tr>
        <tr lang="ru">• Слоистые переходы в исполнении — плавный морфинг между разными текстурами,
        эффектами или голосами на лету, с музыкальным, а не резким переходом, управляемый одной
        крутилкой, LFO или кривой автоматизации.</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="2" maxvalue="16">
        <tr lang="en">number of inputs</tr>
        <tr lang="ru">число входов</tr>
      </argument>
      <argument name="X" type="float">
        <tr lang="en">crossfade initial value. Valid value in the [0, N−1] range. See the @x
        property</tr>
        <tr lang="ru">начальное значение кроссфейда. Допустимое значение в диапазоне [0, N−1].
        См. свойство @x</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @lin -->
      <property name="@lin" type="alias">
        <tr lang="en">alias for @type lin</tr>
        <tr lang="ru">сокращение для @type lin</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" default="2" access="initonly" minvalue="2" maxvalue="16">
        <tr lang="en">number of xfade inputs</tr>
        <tr lang="ru">число входов кроссфейда</tr>
      </property>
      <!-- @pow -->
      <property name="@pow" type="alias">
        <tr lang="en">alias for @type pow</tr>
        <tr lang="ru">сокращение для @type pow</tr>
      </property>
      <!-- @smooth -->
      <property name="@smooth" type="float" minvalue="1" default="20" units="millisecond">
        <tr lang="en">signal change smooth time</tr>
        <tr lang="ru">время сглаживания при изменении сигнала</tr>
      </property>
      <!-- @type -->
      <property name="@type" type="symbol" enum="lin pow" default="pow">
        <tr lang="en">fade curve type: linear or power</tr>
        <tr lang="ru">тип кривой кроссфейда: линейная или степенная</tr>
      </property>
      <!-- @x -->
      <property name="@x" type="float" default="0">
        <tr lang="en">crossfade value. Valid value in the [0, N−1] range.</tr>
        <tr lang="ru">значение кроссфейда. Допустимое значение в диапазоне [0, N−1]</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet type="audio" number="1">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="control">
        <in on="float">
          <tr lang="en">sets the crossfade value</tr>
          <tr lang="ru">устанавливает значение кроссфейда</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru">выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*simple 2-channel crossfade*/                  [ui.radio 3]
                                                |
[osc~ 440]     [ui.knob]      [osc~ 440]        [ui.knob @max 2]
|              |              |                 |
|  [osc~ 1000] |              |  [osc~ 1000]    |
|  |           |              |  |              |
|  |           [F]            |  |  [osc~ 1500] [F]
|  |.          |..            |  |.  |..        |...
[xfade~           ]           [xfade~ 3 @pow        ]
|                             |
[ui.gain~ @size 120 16]       [ui.gain~ @size 120 16]     [ui.dsp~]
|\                            |\
[dac~]                        [dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
