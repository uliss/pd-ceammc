<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="path.file">
        <title>path.file</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">file input/output</tr>
                <tr lang="ru">файловый ввод/вывод</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>path</category>
            <keywords>path file</keywords>
            <since>0.9.5</since>
        </meta>
        <properties>
            <!-- @path -->
            <property name="@path" type="symbol" default="">
                <tr lang="en">file path</tr>
            </property>
        </properties>
        <methods>
            <!-- close -->
            <method name="close">
                <info>
                    <tr lang="en">close file</tr>
                </info>
            </method>
            <!-- open -->
            <method name="open">
                <info>
                    <tr lang="en">open file, updates @path property</tr>
                </info>
                <param name="FNAME" type="symbol" required="true">
                    <tr lang="en">file path: absolute or relative</tr>
                </param>
                <param name="MODE" type="symbol" required="false" enum="r w a r+ w+ a+">
                    <tr lang="en">open mode, 'r': open text file for reading only. 'w': truncate to
                    0 length, if existent, or create text file for writing only. 'a': append, open
                    or create text file only for writing at end of file. 'r+': open text file for
                    reading and writing. 'w+': truncate to 0 length, if existent, or create text
                    file for reading and writing. 'a+': append, open or create text file for
                    reading and writing, writing at end of file</tr>
                </param>
            </method>
            <!-- read_bytes -->
            <method name="read_bytes">
                <info>
                    <tr lang="en">read bytes from file, output as list of integers</tr>
                </info>
                <param name="N" type="int" required="false">
                    <tr lang="en">number of bytes to read, if omitted read all content</tr>
                </param>
            </method>
            <!-- read_line -->
            <method name="read_line">
                <info>
                    <tr lang="en">read line from file, output as list as atoms</tr>
                </info>
            </method>
            <!-- remove -->
            <method name="remove">
                <info>
                    <tr lang="en">remove file</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">file path</tr>
                </param>
            </method>
            <!-- rename -->
            <method name="rename">
                <info>
                    <tr lang="en">rename file</tr>
                </info>
                <param name="PATH" type="symbol" required="true">
                    <tr lang="en">old file path</tr>
                </param>
                <param name="NEW_PATH" type="symbol" required="true">
                    <tr lang="en">new file path</tr>
                </param>
            </method>
            <!-- seek_read -->
            <method name="seek_read">
                <info>
                    <tr lang="en">change reading position</tr>
                </info>
                <param name="POS" type="int" required="true">
                    <tr lang="en">offset position</tr>
                </param>
                <param name="ORIG" type="symbol" required="false" enum="beg|cur|end">
                    <tr lang="en">offset origin, if omitted offset from the beginning</tr>
                </param>
            </method>
            <!-- seek_write -->
            <method name="seek_write">
                <info>
                    <tr lang="en">change writing position</tr>
                </info>
                <param name="POS" type="int" required="true">
                    <tr lang="en">offset position</tr>
                </param>
                <param name="ORIG" type="symbol" required="false" enum="beg|cur|end">
                    <tr lang="en">offset origin, if omitted offset from the beginning</tr>
                </param>
            </method>
            <!-- write -->
            <method name="write">
                <info>
                    <tr lang="en">write space separated atoms to file, no newline added</tr>
                </info>
                <param name="ARGS" type="list" required="true">
                    <tr lang="en">atoms to write</tr>
                </param>
            </method>
            <!-- write_bytes -->
            <method name="write_bytes">
                <info>
                    <tr lang="en">write given bytes to file</tr>
                </info>
                <param name="ARGS" type="list" required="true">
                    <tr lang="en">list of bytes: integers in 0-255 or symbols with '0x' prefix:
                    0x11, 0xFF etc..</tr>
                </param>
            </method>
            <!-- write_line -->
            <method name="write_line">
                <info>
                    <tr lang="en">write space separated atoms to file, newline added</tr>
                </info>
                <param name="ARGS" type="list" required="true">
                    <tr lang="en">atoms to write</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>...</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list: read output</outlet>
            <outlet>bang on EOF reached</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open ~/test.txt w+, write_line 1 2 3 4 5(
|
| [close( [write_bytes 67 69 0x41 0x4D 0x43(
| |       |
| |       | [seek_read 0(
| |       | |
| |       | | [read_line( [remove ~/test.txt(
| |       | | |           |
[path.file                ]
|           ^|
[ui.dt]     [B]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
