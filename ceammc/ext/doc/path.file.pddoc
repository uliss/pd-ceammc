<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="path.file">
    <title>path.file</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">file input/output</tr>
        <tr lang="ru">файловый ввод/вывод</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>path</category>
      <keywords>path file</keywords>
      <since>0.9.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object provides basic file input/output: opening, closing, reading and writing text or bytes, seeking, renaming and removing files</tr>
        <tr lang="ru">объект обеспечивает базовый файловый ввод/вывод: открытие, закрытие, чтение и запись текста или байтов, позиционирование, переименование и удаление файлов</tr>
      </par>
      <par>
        <tr lang="en">the file path is set by the @path property, the [open( method updates it</tr>
        <tr lang="ru">путь к файлу задаётся свойством @path, метод [open( обновляет его</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to log messages to a file, to read configuration or data files, or to process binary data</tr>
        <tr lang="ru">объект можно использовать для записи сообщений в файл, чтения конфигурационных или данных-файлов, а также для обработки двоичных данных</tr>
      </par>
    </info>
    <properties>
      <!-- @path -->
      <property name="@path" type="symbol" default="">
        <tr lang="en">file path</tr>
        <tr lang="ru">путь к файлу</tr>
      </property>
    </properties>
    <methods>
      <!-- close -->
      <method name="close">
        <info>
          <tr lang="en">close file</tr>
          <tr lang="ru">закрыть файл</tr>
        </info>
      </method>
      <!-- open -->
      <method name="open">
        <info>
          <tr lang="en">open file, updates the @path property</tr>
          <tr lang="ru">открыть файл, обновляет свойство @path</tr>
        </info>
        <param name="FNAME" type="symbol" required="true">
          <tr lang="en">file path: absolute or relative</tr>
          <tr lang="ru">путь к файлу: абсолютный или относительный</tr>
        </param>
        <param name="MODE" type="symbol" required="false" enum="r w a r+ w+ a+">
          <tr lang="en">open mode, 'r': open text file for reading only. 'w': truncate to 0 length if exists, or create text file for writing only. 'a': append, open or create text file only for writing at the end of file. 'r+': open text file for reading and writing. 'w+': truncate to 0 length if exists, or create text file for reading and writing. 'a+': append, open or create text file for reading and writing, writing at the end of file</tr>
          <tr lang="ru">режим открытия, 'r': открыть текстовый файл только для чтения. 'w': усечь до нулевой длины, если существует, или создать текстовый файл только для записи. 'a': добавить, открыть или создать текстовый файл только для записи в конец файла. 'r+': открыть текстовый файл для чтения и записи. 'w+': усечь до нулевой длины, если существует, или создать текстовый файл для чтения и записи. 'a+': добавить, открыть или создать текстовый файл для чтения и записи с записью в конец файла</tr>
        </param>
      </method>
      <!-- read_bytes -->
      <method name="read_bytes">
        <info>
          <tr lang="en">read bytes from file, output as list of integers</tr>
          <tr lang="ru">прочитать байты из файла, вывести как список целых чисел</tr>
        </info>
        <param name="N" type="int" required="false">
          <tr lang="en">number of bytes to read, if omitted read all content</tr>
          <tr lang="ru">количество байтов для чтения, если не указано — прочитать всё содержимое</tr>
        </param>
      </method>
      <!-- read_line -->
      <method name="read_line">
        <info>
          <tr lang="en">read line from file, output as list of atoms</tr>
          <tr lang="ru">прочитать строку из файла, вывести как список атомов</tr>
        </info>
      </method>
      <!-- remove -->
      <method name="remove">
        <info>
          <tr lang="en">remove file</tr>
          <tr lang="ru">удалить файл</tr>
        </info>
        <param name="NAME" type="symbol" required="true">
          <tr lang="en">file path</tr>
          <tr lang="ru">путь к файлу</tr>
        </param>
      </method>
      <!-- rename -->
      <method name="rename">
        <info>
          <tr lang="en">rename file</tr>
          <tr lang="ru">переименовать файл</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">old file path</tr>
          <tr lang="ru">старый путь к файлу</tr>
        </param>
        <param name="NEW_PATH" type="symbol" required="true">
          <tr lang="en">new file path</tr>
          <tr lang="ru">новый путь к файлу</tr>
        </param>
      </method>
      <!-- seek_read -->
      <method name="seek_read">
        <info>
          <tr lang="en">change reading position</tr>
          <tr lang="ru">изменить позицию чтения</tr>
        </info>
        <param name="POS" type="int" required="true">
          <tr lang="en">offset position</tr>
          <tr lang="ru">позиция смещения</tr>
        </param>
        <param name="ORIG" type="symbol" required="false" enum="beg|cur|end">
          <tr lang="en">offset origin, if omitted offset from the beginning</tr>
          <tr lang="ru">начало отсчёта смещения, если не указано — смещение от начала файла</tr>
        </param>
      </method>
      <!-- seek_write -->
      <method name="seek_write">
        <info>
          <tr lang="en">change writing position</tr>
          <tr lang="ru">изменить позицию записи</tr>
        </info>
        <param name="POS" type="int" required="true">
          <tr lang="en">offset position</tr>
          <tr lang="ru">позиция смещения</tr>
        </param>
        <param name="ORIG" type="symbol" required="false" enum="beg|cur|end">
          <tr lang="en">offset origin, if omitted offset from the beginning</tr>
          <tr lang="ru">начало отсчёта смещения, если не указано — смещение от начала файла</tr>
        </param>
      </method>
      <!-- write -->
      <method name="write">
        <info>
          <tr lang="en">write space separated atoms to file, no newline added</tr>
          <tr lang="ru">записать атомы, разделённые пробелами, в файл без добавления новой строки</tr>
        </info>
        <param name="ARGS" type="list" required="true">
          <tr lang="en">atoms to write</tr>
          <tr lang="ru">атомы для записи</tr>
        </param>
      </method>
      <!-- write_bytes -->
      <method name="write_bytes">
        <info>
          <tr lang="en">write given bytes to file</tr>
          <tr lang="ru">записать заданные байты в файл</tr>
        </info>
        <param name="ARGS" type="list" required="true">
          <tr lang="en">list of bytes: integers in 0-255 or symbols with '0x' prefix: 0x11, 0xFF etc.</tr>
          <tr lang="ru">список байтов: целые числа в диапазоне 0-255 или символы с префиксом '0x': 0x11, 0xFF и т.д.</tr>
        </param>
      </method>
      <!-- write_line -->
      <method name="write_line">
        <info>
          <tr lang="en">write space separated atoms to file, newline added</tr>
          <tr lang="ru">записать атомы, разделённые пробелами, в файл с добавлением новой строки</tr>
        </info>
        <param name="ARGS" type="list" required="true">
          <tr lang="en">atoms to write</tr>
          <tr lang="ru">атомы для записи</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">...</tr>
          <tr lang="ru">...</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">read output</tr>
          <tr lang="ru">результат чтения</tr>
        </out>
      </outlet>
      <outlet>
        <out type="bang">
          <tr lang="en">bang on EOF reached</tr>
          <tr lang="ru">bang при достижении конца файла (EOF)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[open ~/test.txt w+, write_line 1 2 3 4 5(
|
| [close( [write_bytes 67 69 0x41 0x4D 0x43(
| |       |
| |       | [seek_read 0(
| |       | |
| |       | | [read_line( [remove ~/test.txt(
| |       | | |           |
[path.file                ]
|           ^|
[ui.dt]     [B]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
