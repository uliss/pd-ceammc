<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="local.dict">
        <title>local.dict</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">local named dict object</tr>
                <tr lang="ru">локальный для патча словарь</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>local</category>
            <keywords>dict local global</keywords>
            <since>0.6</since>
            <also>
                <see>data.dict</see>
                <see>global.dict</see>
            </also>
            <aliases>
                <alias>local.json</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Defines local scope dict variable, accessed by ID name and available
                only within its patch (canvas)</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">open data editor</event>
        </mouse>
        <arguments>
            <argument name="ID" type="symbol">
                <tr lang="en">object ID</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @empty -->
            <property name="@empty" type="bool" access="readonly" default="1">
                <tr lang="en">1 if dict is empty, otherwise 0</tr>
            </property>
            <!-- @id -->
            <property name="@id" type="symbol" access="initonly" default="default">
                <tr lang="en">local variable id</tr>
            </property>
            <!-- @keys -->
            <property name="@keys" type="list" access="readonly" default="">
                <tr lang="en">keys of dictionary</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="int" access="readonly" minvalue="0" default="0">
                <tr lang="en">number of entries in dictionary</tr>
            </property>
        </properties>
        <methods>
            <!-- [....] -->
            <method name="[....]" example="true">sets new content without output</method>
            <!-- add -->
            <method name="add">adds entry to dictionary 
            <param name="KEY" type="atom" required="true">
                <tr lang="en">entry key</tr>
            </param>
            <param name="VAL" type="list" required="true">
                <tr lang="en">single value or list</tr>
            </param></method>
            <!-- choose -->
            <method name="choose">choose random key and output it</method>
            <!-- clear -->
            <method name="clear">removes all dict values. No output</method>
            <!-- get_key -->
            <method name="get_key">get entry from dictionary 
            <param name="KEY" type="atom" required="true">
                <tr lang="en">entry key</tr>
            </param></method>
            <!-- read -->
            <method name="read">read dict from JSON file 
            <param name="PATH" type="symbol" required="true">
                <tr lang="en">file path</tr>
            </param></method>
            <!-- remove -->
            <method name="remove">remove entry from dictionary 
            <param name="KEY" type="atom" required="true">
                <tr lang="en">entry key</tr>
            </param></method>
            <!-- set -->
            <method name="set">set dict content without output</method>
            <!-- set_key -->
            <method name="set_key">change entry in dictionary. If it's not exists, do nothing. 
            <param name="KEY" type="atom" required="true">
                <tr lang="en">key</tr>
            </param>
            <param name="VAL" type="list" required="true">
                <tr lang="en">single value or list</tr>
            </param></method>
            <!-- write -->
            <method name="write">write dict as JSON file 
            <param name="PATH" type="symbol" required="true">
                <tr lang="en">file path</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">output current dictionary value</xinfo>
                <xinfo on="list">set dict from list. Key-value pairs are expected. [1 2 3 4(
                becames dict with keys: 1 and 3, values: 2 and 4. No output</xinfo>
                <xinfo on="data:dict">set and output new dict</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>dict output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[\[a: abc bpm: 100\], bang( [bang(
|                           |
|                           [local.dict d1]
|                           |
[local.dict d1]             [ui.dt]
|
[ui.dt]

[local.dict-subpatch]
]]>
            </pdascii>
            <pdascii id="subpatch">
<![CDATA[
/*dict from parent patch is not visible in subpatch*/

[bang(
|
[local.dict d1]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
