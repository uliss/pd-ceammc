<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="net.ws.client">
    <title>net.ws.client</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">WebSocket client</tr>
        <tr lang="ru">WebSocket-клиент</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>net</category>
      <keywords>websocket net client</keywords>
      <since>0.9.8</since>
      <also>
        <see>net.ws.server</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">WebSocket is a protocol that provides full-duplex communication channels over
        a single TCP connection, widely used in web applications for real-time data exchange</tr>
        <tr lang="ru">WebSocket — протокол, обеспечивающий полнодуплексную передачу данных по
        одному TCP-соединению, широко используется в веб-приложениях для обмена данными в реальном
        времени</tr>
      </par>
      <par>
        <tr lang="en">the object connects to a WebSocket server at the specified URL and exchanges
        text, binary or JSON messages</tr>
        <tr lang="ru">объект подключается к WebSocket-серверу по указанному URL и обменивается
        текстовыми, бинарными или JSON-сообщениями</tr>
      </par>
      <par>
        <tr lang="en">the *write* methods buffer messages, call *flush* to send them; the *send*
        methods send messages immediately</tr>
        <tr lang="ru">методы *write* буферизуют сообщения, для отправки вызовите *flush*; методы
        *send* отправляют сообщения сразу</tr>
      </par>
    </info>
    <properties>
      <!-- @mode -->
      <property name="@mode" type="symbol" default="fudi" enum="data fudi json sym">
        <tr lang="en">parsing mode for incoming messages. If "fudi" — interpret incoming websocket
        data as Pd messages, if "sym" — always interpret as symbols, "data" — parse ceammc data,
        "json" — convert JSON values to ceammc data</tr>
        <tr lang="ru">режим разбора входящих сообщений. Если "fudi" — интерпретировать входящие
        данные websocket как Pd-сообщения, если "sym" — всегда интерпретировать как символы, "data"
        — разбирать данные ceammc, "json" — преобразовывать значения JSON в данные ceammc</tr>
      </property>
    </properties>
    <methods>
      <!-- close -->
      <method name="close">
        <info>
          <tr lang="en">gracefully close connection (with websocket handshake)</tr>
          <tr lang="ru">корректно закрыть соединение (с websocket-рукопожатием)</tr>
        </info>
      </method>
      <!-- connect -->
      <method name="connect">
        <info>
          <tr lang="en">connect to websocket server</tr>
          <tr lang="ru">подключиться к websocket-серверу</tr>
        </info>
        <param name="URL" type="symbol" required="true">
          <tr lang="en">url - ws://HOST:PORT/, for ex.: ws://127.0.0.1:9000/path</tr>
          <tr lang="ru">URL — ws://HOST:PORT/, например: ws://127.0.0.1:9000/path</tr>
        </param>
      </method>
      <!-- flush -->
      <method name="flush">
        <info>
          <tr lang="en">flush output stream: sends all buffered messages</tr>
          <tr lang="ru">сбросить выходной поток: отправить все буферизованные сообщения</tr>
        </info>
      </method>
      <!-- latency -->
      <method name="latency">
        <info>
          <tr lang="en">measure roundtrip latency. Outputs: latency TIME_MSEC</tr>
          <tr lang="ru">измерить задержку кругового обхода. Выводит: latency TIME_MSEC</tr>
        </info>
      </method>
      <!-- ping -->
      <method name="ping">
        <info>
          <tr lang="en">send ping message to server (on server answer outputs: pong DATA)</tr>
          <tr lang="ru">отправить ping-сообщение на сервер (при ответе сервера выводит: pong
          DATA)</tr>
        </info>
        <param name="DATA" type="list" required="false">
          <tr lang="en">list of integers in [0..255] range</tr>
          <tr lang="ru">список целых чисел в диапазоне [0..255]</tr>
        </param>
      </method>
      <!-- send -->
      <method name="send">
        <info>
          <tr lang="en">send as text message</tr>
          <tr lang="ru">отправить как текстовое сообщение</tr>
        </info>
        <param name="ARGS" type="list" required="false">
          <tr lang="en">arguments</tr>
          <tr lang="ru">аргументы</tr>
        </param>
      </method>
      <!-- send_array -->
      <method name="send_array">
        <info>
          <tr lang="en">send Pd array content as json array</tr>
          <tr lang="ru">отправить содержимое Pd-массива как JSON-массив</tr>
        </info>
        <param name="ARR" type="symbol" required="true">
          <tr lang="en">array name</tr>
          <tr lang="ru">имя массива</tr>
        </param>
        <param name="START" type="int" required="false" minvalue="0" units="sample" default="0">
          <tr lang="en">array start index</tr>
          <tr lang="ru">начальный индекс массива</tr>
        </param>
        <param name="LENGTH" type="int" required="false" minvalue="0" units="sample">
          <tr lang="en">read length. If not specified - read until array end</tr>
          <tr lang="ru">длина чтения. Если не указана — читать до конца массива</tr>
        </param>
      </method>
      <!-- send_binary -->
      <method name="send_binary">
        <info>
          <tr lang="en">send as binary bytes</tr>
          <tr lang="ru">отправить как бинарные байты</tr>
        </info>
        <param name="ARGS" type="list" required="false">
          <tr lang="en">list of integers in [0..255] range</tr>
          <tr lang="ru">список целых чисел в диапазоне [0..255]</tr>
        </param>
      </method>
      <!-- send_json -->
      <method name="send_json">
        <info>
          <tr lang="en">send as encoded json</tr>
          <tr lang="ru">отправить как закодированный JSON</tr>
        </info>
        <param name="ARGS" type="list" required="false">
          <tr lang="en">arguments</tr>
          <tr lang="ru">аргументы</tr>
        </param>
      </method>
      <!-- write -->
      <method name="write">
        <info>
          <tr lang="en">write as text message to output buffer. You have to call [flush( method for
          sending</tr>
          <tr lang="ru">записать как текстовое сообщение в выходной буфер. Для отправки нужно
          вызвать метод [flush(</tr>
        </info>
        <param name="ARGS" type="list" required="false">
          <tr lang="en">arguments</tr>
          <tr lang="ru">аргументы</tr>
        </param>
      </method>
      <!-- write_binary -->
      <method name="write_binary">
        <info>
          <tr lang="en">write as binary bytes to output buffer. You have to call [flush( method for
          sending</tr>
          <tr lang="ru">записать как бинарные байты в выходной буфер. Для отправки нужно вызвать
          метод [flush(</tr>
        </info>
        <param name="ARGS" type="list" required="false">
          <tr lang="en">list of integers in [0..255] range</tr>
          <tr lang="ru">список целых чисел в диапазоне [0..255]</tr>
        </param>
      </method>
      <!-- write_json -->
      <method name="write_json">
        <info>
          <tr lang="en">write as encoded json to output buffer. You have to call [flush( method for
          sending</tr>
          <tr lang="ru">записать как закодированный JSON в выходной буфер. Для отправки нужно
          вызвать метод [flush(</tr>
        </info>
        <param name="ARGS" type="list" required="false">
          <tr lang="en">arguments</tr>
          <tr lang="ru">аргументы</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">message input</tr>
          <tr lang="ru">вход сообщений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output messages: latency, ping, text, binary, closed, connected,
          disconnected</tr>
          <tr lang="ru">выходные сообщения: latency, ping, text, binary, closed, connected,
          disconnected</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*you can start testing websocket server with command: 'websocat -s 8000 -t -v'*/


[connect ws://localhost:8000(         [array WS-CLI size=50 w=150 h=100 yr=0..100]
|
| [close #b(   [write MSG1 #e(
|
| [ping #c(    [write MSG2 #f(
|
| [latency #d( [flush #g(
|
| [send MESSAGE( [send_json 1 2 A #h(
| |
| | [send_array WS-CLI #i(
| | |
[net.ws.client #x]
|
[t a a #z]
|
[print]

    [ui.dt #a]

[X z:1->a] [X b->x] [X c->x] [X d->x]
[X e->x] [X f->x] [X g->x] [X h->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
