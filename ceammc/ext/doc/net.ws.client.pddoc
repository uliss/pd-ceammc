<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="net.ws.client">
        <title>net.ws.client</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">WebSocket client</tr>
                <tr lang="ru">WebSocket клиент</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>net</category>
            <keywords>websocket net client</keywords>
            <since>0.9.8</since>
            <also>
                <see>net.ws.server</see>
            </also>
        </meta>
        <properties>
            <!-- @mode -->
            <property name="@mode" type="symbol" default="fudi" enum="data fudi json sym">
                <tr lang="en">parsing mode for incoming messages. If 'fudi' - interpret incoming
                websocket data as Pd messages, if 'sym' - always interpret as symbols, 'data' -
                parse ceammc data, 'json' - convert json values to ceammc data.</tr>
                <tr lang="ru" finished="false">Режим разбора для входящих сообщений. Если «fudi» —
                интерпретировать входящие данные websocket как Pd-сообщения, если «sym» — всегда
                интерпретировать как символы, «data» — разбирать данные ceammc, «json» —
                преобразовывать значения json в данные ceammc.</tr>
            </property>
        </properties>
        <methods>
            <!-- close -->
            <method name="close">gracefully close connection (with websocket handshake)</method>
            <!-- connect -->
            <method name="connect">connect to websocket server 
            <param name="URL" type="symbol" required="true">
                <tr lang="en">url - ws://HOST:PORT/, for ex.: ws://127.0.0.1:9000/path</tr>
            </param></method>
            <!-- flush -->
            <method name="flush">flush output stream: sends all buffered messages.</method>
            <!-- latency -->
            <method name="latency">measure rountrip latency. Outputs: latency TIME_MSEC</method>
            <!-- ping -->
            <method name="ping">send ping message to server (on server answer outputs: pong DATA) 
            <param name="DATA" type="list" required="false">
                <tr lang="en">list of integers in [0..255] range</tr>
            </param></method>
            <!-- send -->
            <method name="send">send as text message 
            <param name="ARGS" type="list" required="false">
                <tr lang="en">arguments</tr>
            </param></method>
            <!-- send_array -->
            <method name="send_array">send as Pd array content as json array 
            <param name="ARR" type="symbol" required="true">
                <tr lang="en">array name</tr>
            </param>
            <param name="START" type="int" required="false" minvalue="0" units="sample"
            default="0">
                <tr lang="en">array start index</tr>
            </param>
            <param name="LENGTH" type="int" required="false" minvalue="0" units="sample">
                <tr lang="en">read length. If not specified - read until array end.</tr>
            </param></method>
            <!-- send_binary -->
            <method name="send_binary">send as binary bytes 
            <param name="ARGS" type="list" required="false">
                <tr lang="en">list of integers in [0..255] range</tr>
            </param></method>
            <!-- send_json -->
            <method name="send_json">send as encoded json 
            <param name="ARGS" type="list" required="false">
                <tr lang="en">arguments</tr>
            </param></method>
            <!-- write -->
            <method name="write">write as text message to output buffer. You have to call [flush(
            method for sending. 
            <param name="ARGS" type="list" required="false">
                <tr lang="en">arguments</tr>
            </param></method>
            <!-- write_binary -->
            <method name="write_binary">write as binary bytes to output buffer. You have to call
            [flush( method for sending. 
            <param name="ARGS" type="list" required="false">
                <tr lang="en">list of integers in [0..255] range</tr>
            </param></method>
            <!-- write_json -->
            <method name="write_json">write as encoded json to output buffer. You have to call
            [flush( method for sending. 
            <param name="ARGS" type="list" required="false">
                <tr lang="en">arguments</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>message input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output messages: latency, ping, text, binary, closed, connected,
            disconnected</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
/*you can start testing websocket server with command: 'websocat -s 8000 -t -v'*/


[connect ws://localhost:8000(         [array WS-CLI size=50 w=150 h=100 yr=0..100]
|
| [close #b(   [write MSG1 #e(
|
| [ping #c(    [write MSG2 #f(
|
| [latency #d( [flush #g(
|
| [send MESSAGE( [send_json 1 2 A #h(
| |
| | [send_array WS-CLI #i(
| | |
[net.ws.client #x]
|
[t a a #z]
|
[print]

    [ui.dt #a]

[X z:1->a] [X b->x] [X c->x] [X d->x]
[X e->x] [X f->x] [X g->x] [X h->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
