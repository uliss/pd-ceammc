<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="split~">
        <title>split~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">parametrized multichannel signal splitter</tr>
                <tr lang="ru">параметризованный многоканальный сплиттер сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>merge split</keywords>
            <since>0.9.7</since>
            <aliases>
                <alias>ceammc/split~</alias>
            </aliases>
            <also>
                <see>merge~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">mostly syntax sugar for clear schemes, but can be used in dynamic
                pathing</tr>
            </par>
        </info>
        <arguments>
            <argument name="N" type="int" minvalue="2" maxvalue="64">
                <tr lang="en">number of outputs</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @n -->
            <property name="@n" type="int" minvalue="2" maxvalue="64" default="2"
            access="initonly">
                <tr lang="en">number of outputs</tr>
            </property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio" number="1">first output signal</outlet>
            <outlet type="audio" number="...">... output signal</outlet>
            <outlet type="audio" number="n">n-th output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[sig~ 1]
|
[split~ 3 {i=1,o=3,w=28}]
|         ^|        ^^|
[ui.n~]   [ui.n~]   [ui.n~]

[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
