<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.10">
    <object name="synth.risset_tone~">
        <title>synth.risset_tone~</title>
        <meta>
            <authors>
                <author>Oliver Larkin</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Jean-Claude Risset's endless glissando</tr>
                <tr lang="ru">бесконечное глиссандо Жан-Клода Риссе</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>risset</keywords>
            <since>0.5</since>
        </meta>
        <arguments>
            <argument name="CENTROID" type="float" minvalue="20" maxvalue="120">
                <tr lang="en">main frequency (MIDI pitch)</tr>
            </argument>
            <argument name="RATE" type="float" minvalue="-2" maxvalue="2">
                <tr lang="en">glissanso speed</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1">on/off dsp processing</property>
            <!-- @centroid -->
            <property name="@centroid" type="float" minvalue="20" maxvalue="120" default="60">main
            frequency. Units: MIDI note</property>
            <!-- @range -->
            <property name="@range" type="float" minvalue="1" maxvalue="120" default="120">
            glissando range in MIDI note units</property>
            <!-- @rate -->
            <property name="@rate" type="float" minvalue="-2" maxvalue="2" default="0.01">glissanso
            speed</property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">reset to start position</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">reset to start position</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]              [bang #a(
|
[* 0.001]
|
[@rate $1 #b(

[synth.risset_tone~ 60 -0.005 #x ]
|
| [synth.risset_tone~ 56 -0.005 #y]
| |
| | [synth.risset_tone~ 53 -0.005 #z]
| | |
[ui.hgain~]      [ui.dsp~]
| \
[dac~]
[X a->x] [X a->y] [X a->z]
[X b->x] [X b->y] [X b->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
