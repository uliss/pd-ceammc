<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="ui.display" type="gui">
        <title>ui.display</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">display widget</tr>
                <tr lang="ru">виджет дисплей</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>display</keywords>
            <since>0.1</since>
            <aliases>
                <alias view="link">ui.d</alias>
                <alias view="link">ui.dt</alias>
            </aliases>
            <also>
                <see>msg</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">[ui.dt] is the alias for [ui.display @display_type 1]</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">copy the message value to the clipboard
            buffer</event>
            <event type="left-click" editmode="false" keys="Shift">copy the whole message value
            with selector to the clipboard buffer</event>
            <event type="double-click" editmode="false">show/hide message type</event>
            <event type="right-click" editmode="false">open popup menu</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_active_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_pinned.xml" />
            <xi:include href="props_ui_receive.xml" />
            <!-- @auto_size -->
            <property name="@auto_size" type="bool" default="1">
                <tr lang="en">flag if automatically resize contents to feet incoming message</tr>
            </property>
            <!-- @background_color -->
            <property name="@background_color" type="list" default="0.93 0.93 0.93 1">
                <tr lang="en">element background color (list of red, green, blue values in 0-1
                range)</tr>
            </property>
            <!-- @display_events -->
            <property name="@display_events" type="bool" default="1">
                <tr lang="en">flag for blinking on incoming messages</tr>
            </property>
            <!-- @display_type -->
            <property name="@display_type" type="bool" default="0">
                <tr lang="en">flag for displaying incoming message type</tr>
            </property>
            <!-- @float_width -->
            <property name="@float_width" type="int" default="-1" minvalue="-1" maxvalue="17">
                <tr lang="en">number of digits after floating point. If -1: skip trailing zeroes,
                if 0 - output as integers</tr>
            </property>
            <!-- @hex -->
            <property name="@hex" type="bool" default="0">
                <tr lang="en">output integers in hex format</tr>
            </property>
            <!-- @hex_width -->
            <property name="@hex_width" type="int" default="2" minvalue="0" maxvalue="16">
                <tr lang="en">hex output format width</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="80 18">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
            <!-- @text_color -->
            <property name="@text_color" type="list" default="0 0 0 1">
                <tr lang="en">text color (list of red, green, blue values in 0-1 range)</tr>
            </property>
        </properties>
        <methods>
            <!-- pos -->
            <method name="pos">
                <info>
                    <tr lang="en">set UI element position</tr>
                </info>
                <param name="X" type="float" required="true">
                    <tr lang="en">top left x-coord</tr>
                </param>
                <param name="Y" type="float" required="true">
                    <tr lang="en">top right y-coord</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">accepts any messages and displays it</tr>
                </xinfo>
            </inlet>
        </inlets>
        <example>
            <pdascii>
<![CDATA[
[list a b c( [1( [symbol X( [any msg( [bang(
|            |   |          |         |
|            |   |          |         |
|            |   |          |         |
[ui.display                           ]


/* display message type */

[list a b c( [1( [symbol X( [any msg( [bang(
|            |   |          |         |
|            |   |          |         |
|            |   |          |         |
[ui.dt                                ]

[ui.display-spec]
]]>
            </pdascii>
            <pdascii id="spec">
<![CDATA[
/* special characters for Pd */

[92( [123( [125(  [92( [123( [125(
|    |     |      |    |     |
[list tosymbol]   [list tosymbol]
|                 |
|                 [list trim]
|                 |
[ui.dt]           [ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
