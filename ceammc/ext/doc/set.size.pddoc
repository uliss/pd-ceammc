<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="set.size">
    <title>set.size</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">outputs the number of elements in a set</tr>
        <tr lang="ru">выводит число элементов во множестве</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data set size</keywords>
      <since>0.3</since>
      <also>
        <see>data.set</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Outputs the number of elements in the incoming set (or list converted to a
        set).</tr>
        <tr lang="ru">Выводит число элементов во входящем множестве (или в списке, преобразованном
        во множество).</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Counting unique elements — finding out how many distinct values are
        currently stored in a set, for example the number of active tags, selected notes or
        enabled options.</tr>
        <tr lang="ru">• Подсчёт уникальных элементов — определение того, сколько различных
        значений сейчас содержится во множестве, например число активных меток, выбранных нот или
        включённых опций.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Conditional behaviour based on set size — using the output as a condition
        in a patch, for example to trigger an event only when the set contains enough elements, or
        to stop processing when it becomes empty.</tr>
        <tr lang="ru">• Условное поведение по размеру множества — использование выхода как условия
        в патче, например чтобы запускать событие только тогда, когда во множестве достаточно
        элементов, или останавливать обработку, когда оно становится пустым.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input set. Other values are ignored</tr>
          <tr lang="ru">входное множество. Остальные значения игнорируются</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">number of elements in the set</tr>
          <tr lang="ru">число элементов во множестве</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]   [1 2 3 4(
|     |
| [B] |
| |   |
[data.set a b c]
|
[set.size]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
