<?xml version='1.0' encoding='utf-8'?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="hw.rpi.sensor.ir">
        <title>hw.rpi.sensor.ir</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>Infrared sensor support for Raspberry Pi</description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display gpio raspberry ir infrared sensor</keywords>
            <since>0.9.9</since>
        </meta>
        <methods>
            <method name="poll">start/stop IR sensor polling 
            <param name="VALUE" type="bool" required="true">state</param></method>
        </methods>
        <arguments>
            <argument name="PIN" type="int">GPIO connection pin. See @pin</argument>
        </arguments>
        <properties>
            <property name="@pin" type="int" default="0" access="initonly">connection GPIO
            pin</property>
            <property name="@tolerance_usec" type="int" default="200" minvalue="0" maxvalue="1000">
            absolute error tolerance in microsecons</property>
            <property name="@proto" type="symbol" default="NEC">protocol name</property>
            <property name="@tolerance_perc" type="int" default="30" units="percent" minvalue="0"
            maxvalue="100">relative error tolerance</property>
        </properties>
        <inlets>
            <inlet><xinfo>control input</xinfo></inlet>
        </inlets>
        <outlets>
            <outlet>pressed infrared remote keys accoring to protocol</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]         [ui.menu NEC RC5 RC6 JVC SHARP]
|           |
[poll $1(   [@protocol $1(
|           |
|           |
[hw.rpi.sensor.ir @pin 23 #x]
|
[route D S E   ]
|     ^|     ^^|
[F]    [F]    [F]

[print IR #a]

[ui.link @url=ceammc://img/conn_infrared.png @title=Connection]
[X x->a]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
