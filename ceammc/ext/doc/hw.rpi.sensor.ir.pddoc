<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.sensor.ir">
    <title>hw.rpi.sensor.ir</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">IR (infrared) sensors and protocols for Raspberry Pi</tr>
        <tr lang="ru">ИК (инфракрасные) датчики и протоколы для Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>display gpio raspberry ir infrared sensor</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par style="important">
        <tr lang="en">When created, the object takes exclusive ownership of the GPIO pin @pin — it is *impossible* to use it in other objects simultaneously with this one.</tr>
        <tr lang="ru">При создании объект забирает в эксклюзивное владение контакт GPIO @pin — использовать его в других объектах одновременно с этим *невозможно*.</tr>
      </par>
    </info>
    <arguments>
      <argument name="PIN" type="int" minvalue="-1" maxvalue="127">
        <tr lang="en">GPIO connection pin. See @pin.</tr>
        <tr lang="ru">контакт GPIO для подключения. См. @pin.</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @pin -->
      <property name="@pin" type="int" default="-1" access="initonly" minvalue="-1" maxvalue="127">
        <tr lang="en">connection GPIO pin</tr>
        <tr lang="ru">контакт GPIO для подключения</tr>
      </property>
      <!-- @proto -->
      <property name="@proto" type="symbol" default="NEC">
        <tr lang="en">protocol name. You must disable and re-enable sensor polling for the change to take effect.</tr>
        <tr lang="ru">название протокола. Чтобы изменение вступило в силу, необходимо выключить и снова включить опрос датчика.</tr>
      </property>
    </properties>
    <methods>
      <!-- poll -->
      <method name="poll">
        <info>
          <tr lang="en">start/stop IR sensor polling</tr>
          <tr lang="ru">запустить/остановить опрос ИК-датчика</tr>
        </info>
        <param name="VALUE" type="bool" required="true">
          <tr lang="en">state</tr>
          <tr lang="ru">состояние</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control input</tr>
          <tr lang="ru">вход для управляющих сообщений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">pressed infrared remote keys according to the protocol</tr>
          <tr lang="ru">нажатые кнопки ИК-пульта согласно протоколу</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]         [ui.menu NEC RC5 RC6 JVC Sharp]
|           |
[poll $1(   [@proto $2(
|           |
|           |
[hw.rpi.sensor.ir @pin 23 #x]
 |
 [route D S F   ]
 |     ^|     ^^|
 [F]    [F]    [F]

[print IR #a]

[ui.link @url=ceammc://img/conn_infrared.png @title=Connection_Scheme]
[X x->a]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
