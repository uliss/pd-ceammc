<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="set.union">
    <title>set.union</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">union of sets</tr>
        <tr lang="ru">объединение множеств</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data union set</keywords>
      <since>0.3</since>
      <also>
        <see>data.set</see>
        <see>set.intersect</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Computes the union of the two incoming sets (or lists converted to sets):
        outputs a new set that contains all unique elements from both input sets.</tr>
        <tr lang="ru">Вычисляет объединение двух входящих множеств (или списков, преобразованных во
        множества): выводит новое множество, содержащее все уникальные элементы из обоих входных
        множеств.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARGS" type="any">
        <tr lang="en">elements of the right set</tr>
        <tr lang="ru">элементы правого множества</tr>
      </argument>
    </arguments>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">first set or list (converted to set). Other values are ignored</tr>
          <tr lang="ru">первое множество или список (преобразуется во множество). Остальные
          значения игнорируются</tr>
        </in>
      </inlet>
      <inlet>
        <in>
          <tr lang="en">second set or list (converted to set)</tr>
          <tr lang="ru">второе множество или список (преобразуется во множество)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">outputs the union of the given sets</tr>
          <tr lang="ru">выводит объединение заданных множеств</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[trigger           b b]
|                  ^|
[data.set 1 2 3 4]  [data.set 3 4 5 6]
|                   |.
[set.union           ]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
