<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="conv.midi2freq">
        <title>conv.midi2freq</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">advanced MIDI pitch conversion to a frequency</tr>
                <tr lang="ru">продвинутое преобразование MIDI нот в частоту в Гц</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv freq midi</keywords>
            <since>0.6</since>
            <also>
                <see>mtof</see>
            </also>
            <aliases>
                <alias>ceammc/midi-&gt;freq</alias>
                <alias>midi-&gt;freq</alias>
                <alias>ceammc/m-&gt;f</alias>
                <alias>m-&gt;f</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="A" type="float" minvalue="200" maxvalue="600" units="hertz">
                <tr lang="en">A pitch frequency</tr>
                <tr lang="ru">частота звука</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @a -->
            <property name="@a" type="float" default="440" minvalue="200" maxvalue="600"
            units="hertz">
                <tr lang="en">A pitch frequency</tr>
                <tr lang="ru" finished="false">частота звука</tr>
            </property>
            <!-- @t -->
            <property name="@t" type="symbol" default="eq"
            enum="eq just ganassi meantone kirnberger3 pythagorean rameau valotti zarlino">
                <tr lang="en">temperament</tr>
                <tr lang="ru" finished="false">темперамент</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">input MIDI pitch</xinfo>
                <xinfo on="list">input MIDI pitches</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>converted value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
[f]  [@a 415( [@a 440(   [ui.menu eq just ganassi meantone kirnberger3 pythagorean rameau valotti zarlino]
|    |        |          |
|    |        |          [@t $2(
|    |        |          |
[m->f 442                ]
|
[F]
|
[osc~]
|
[ui.gain~ @size 120 16]
|\
[dac~]

[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
