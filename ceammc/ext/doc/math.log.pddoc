<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="math.log">
        <title>math.log</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">natural logarithm</tr>
                <tr lang="ru">натуральный логарифм</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math log</keywords>
            <also>
                <see>math.exp</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Computes the value of the natural logarithm of argument x.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
            </par>
            <par>
                <tr lang="en">log(+-0) return -infinity</tr>
            </par>
            <par>
                <tr lang="en">log(1) return +0.</tr>
            </par>
            <par>
                <tr lang="en">log(x) return a NaN</tr>
            </par>
            <par>
                <tr lang="en">log(+infinity) return +infinity.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input value</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">apply to all numeric values</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(                  [array LOG yr=-4..4 w=320]
|
[list.seq -1 16 0.125]
|
[math.log]
|
[list->array LOG]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
