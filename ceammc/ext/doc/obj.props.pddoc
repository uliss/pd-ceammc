<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="obj.props">
    <title>obj.props</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">extract object properties from the connected object</tr>
        <tr lang="ru">извлекает свойства подключённого объекта</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>property</keywords>
      <since>0.7</since>
    </meta>
    <info>
      <par>
        <tr lang="en">extract properties from the object connected to the second outlet</tr>
        <tr lang="ru">извлекает свойства объекта, подключённого ко второму выходу</tr>
      </par>
      <par>
        <tr lang="en">the second outlet is used as an input for connecting to the examined
        object</tr>
        <tr lang="ru">второй выход используется как вход для подключения к исследуемому
        объекту</tr>
      </par>
      <par>
        <tr lang="en">on bang, the extracted properties are output as data:Dict to the first
        outlet</tr>
        <tr lang="ru">по bang извлечённые свойства выводятся как data:Dict на первый выход</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output extracted properties to the first outlet</tr>
          <tr lang="ru">вывести извлечённые свойства на первый выход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">property output (data:Dict)</tr>
          <tr lang="ru">выход свойств (data:Dict)</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">connect to the examined object</tr>
          <tr lang="ru">подключение к исследуемому объекту</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[obj.props                     ]
|                             ^|
[ui.dt]                       [flt.moog_vcf~]




/* ... */
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
