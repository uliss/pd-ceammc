<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.bar2ms">
    <title>conv.bar2ms</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">calculates bar and beat duration</tr>
        <tr lang="ru">вычисляет продолжительность такта и ударной доли</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv time duration tempo bpm</keywords>
      <also>
        <see>conv.bpm2ms</see>
      </also>
      <since>0.9.7</since>
      <aliases>
        <alias>ceammc/bar-&gt;ms</alias>
        <alias>bar-&gt;ms</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object calculates the duration of a bar and a beat in milliseconds, based
        on the current tempo (in BPM) and the current time signature. The result is output from two
        outlets: the first outlet sends the bar duration, the second sends the beat duration.</tr>
        <tr lang="ru">Объект вычисляет продолжительность такта и ударной доли в миллисекундах на
        основе текущего темпа (в BPM) и текущего тактового размера. Результат выводится из двух
        выходов: из первого отправляется длительность такта, из второго — длительность ударной
        доли.</tr>
      </par>
      <par>
        <tr lang="en">Tempo values can be given as: 60, 120bpm, 90|4bpm, 80|3/8bpm. Time signature
        values can be given as: |3/8|, |1/4+3/16|.</tr>
        <tr lang="ru">Значения темпа можно задавать как: 60, 120bpm, 90|4bpm, 80|3/8bpm. Значения
        тактового размера можно задавать как: |3/8|, |1/4+3/16|.</tr>
      </par>
    </info>
    <arguments>
      <argument name="BPM" type="atom" units="bpm">
        <tr lang="en">initial tempo value</tr>
        <tr lang="ru">начальное значение темпа</tr>
      </argument>
      <argument name="TSIG" type="symbol">
        <tr lang="en">initial time signature value</tr>
        <tr lang="ru">начальное значение тактового размера</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @bpm -->
      <property name="@bpm" type="atom" default="60|4bpm" units="bpm">
        <tr lang="en">tempo bpm value</tr>
        <tr lang="ru">значение темпа</tr>
      </property>
      <!-- @tsig -->
      <property name="@tsig" type="symbol" default="|4/4|">
        <tr lang="en">time signature value</tr>
        <tr lang="ru">значение тактового размера</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the bar and beat duration</tr>
          <tr lang="ru">выводит длительность такта и ударной доли</tr>
        </in>
        <in on="float">
          <tr lang="en">sets the tempo BPM (in quarters) and outputs</tr>
          <tr lang="ru">устанавливает темп BPM (в четвертях) и выводит</tr>
        </in>
        <in on="symbol">
          <tr lang="en">sets the tempo BPM (like "120|8bpm") and outputs</tr>
          <tr lang="ru">устанавливает темп BPM (например, "120|8bpm") и выводит</tr>
        </in>
        <in on="list">
          <tr lang="en">sets the tempo BPM and time signature, then outputs</tr>
          <tr lang="ru">устанавливает темп BPM и тактовый размер, затем выводит</tr>
        </in>
      </inlet>
      <inlet>
        <in on="symbol">
          <tr lang="en">sets the time signature</tr>
          <tr lang="ru">устанавливает тактовый размер</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">bar period in milliseconds</tr>
          <tr lang="ru">длительность такта в миллисекундах</tr>
        </out>
      </outlet>
      <outlet>
        <out type="float">
          <tr lang="en">beat period in milliseconds</tr>
          <tr lang="ru">длительность ударной доли в миллисекундах</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]                      [symbol |7/8|(
|                        |
| [B] [symbol 128|8.bpm( [L]
| |   |                  |.
[bar->ms 60 |9/8|         ]
|            ^|
[ui.dt]       |
              |
              [ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
