<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="dict.each">
        <title>dict.each</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">map each value in dictionary with the side-chain function</tr>
                <tr lang="ru">отображение каждого значения в словаре с помощью боковой цепи
                обработки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>each iterate dictionary</keywords>
            <since>0.7</since>
            <also>
                <see>data.dict</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="data:dict">
                    <tr lang="en">input dictionary</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">new key value from sidechain</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>processed dict</outlet>
            <outlet>send value to sidechain</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[\[a: 1 c: 2 e: 3\], bang(
|
[dict]
|
[dict.each] X [* 100]
|
[ui.d]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
