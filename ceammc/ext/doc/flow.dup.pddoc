<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="flow.dup">
        <title>flow.dup</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">duplicate messages</tr>
                <tr lang="ru">дупликатор сообщений</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>flow duplicate repeat</keywords>
            <since>0.9.1</since>
            <also>
                <see>flow.mem</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Output incoming message specified number of times</tr>
                <!-- old: Выходное входящее сообщение указанное количество
                раз -->
                <tr lang="ru" finished="false">Выходное входящее сообщение указанное количество
                раз</tr>
            </par>
        </info>
        <arguments>
            <argument name="N" type="int" minvalue="0">
                <tr lang="en">number of repeats</tr>
                <tr lang="ru" finished="false">Количество повторений</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @n -->
            <property name="@n" type="int" minvalue="0" default="2">
                <tr lang="en">number of repeats</tr>
                <tr lang="ru" finished="false">Количество повторений</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in>
                    <tr lang="en">incoming message</tr>
                    <tr lang="ru" finished="false">Входящее сообщение</tr>
                </in>
            </inlet>
            <inlet>
                <in on="int" minvalue="0">
                    <tr lang="en">set number of repeats</tr>
                    <tr lang="ru" finished="false">количество повторений</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output</tr>
                    <tr lang="ru" finished="false">выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B] [F #a] [symbol ABC #b( [1 2 3 #c( [@prop 4 5 6 #d(
|
|
|
|      [F]
|      |.
[flow.dup 2 #z]
|
[print DUP]
[X a->z]
[X b->z]
[X c->z]
[X d->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
