<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.cexp~">
        <title>math.cexp~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">exponent of a complex signals</tr>
                <tr lang="ru">комплексная экспонента для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math complex magnitude module</keywords>
            <aliases>
                <alias>ceammc/cexp~</alias>
                <alias>cexp~</alias>
            </aliases>
            <since>0.9</since>
            <also>
                <see>math.carg~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Base-e exponential of complex signal, that is e (Euler's number,
                2.7182818) raised to the complex signal power</tr>
                <tr lang="ru" finished="false">База e экспоненциальна сложному сигналу, то есть e
                (число Эйлера, 2.7182818) повышена до мощности сложного сигнала</tr>
            </par>
            <par>
                <tr lang="en">The complex exponential function e^z for z = x+jy equals e^x (cos(y)
                + j sin(y))</tr>
                <tr lang="ru" finished="false">Сложная экспоненциальная функция e^z для z = x+jy
                равна e^x (cos(y) + j sin(y))</tr>
            </par>
            <par>
                <tr lang="en">The exponential function is an entire function in the complex plane
                and has no branch cuts</tr>
                <tr lang="ru" finished="false">Экспоненциальная функция является целой функцией в
                комплексной плоскости и не имеет разрезов ветвей.</tr>
            </par>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">real part of input signal</tr>
                    <tr lang="ru" finished="false">Реальная часть входного сигнала</tr>
                </xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">imag part of input signal</tr>
                    <tr lang="ru" finished="false">Имаг часть входного сигнала</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">real part of result</tr>
                </out>
            </outlet>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">imag part of result</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
/* Plot FIR frequency response: |H(w)| = 0.5 + 0.5e^-jw */

[bang(
|
[plot.linspace~ 0 3.141592 @pi #a]
|
[*~ -1]
|.
[math.cexp~] [sig~ 0.5]
| ^|.        |..
[math.cmul~    ]
|         ^|
[+~ 0.5]   |
|          |.
[math.cabs~ ]
|
[ui.plot~ @size 475 150 @xlabels 1 @ylabels 1 @ymin 0 @ymax 1 @ymin_ticks 0 @ymax_ticks 0 @xmin_ticks 0 @xmaj_ticks 0 @xmin_grid 1 #b]










[ui.dsp~]
[X a:1->b:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
