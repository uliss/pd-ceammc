<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="synth.tube_bell~">
        <title>synth.tube_bell~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">STK tubular bell (orchestral chime) FM synthesis instrument</tr>
                <tr lang="ru">FM-синтезатор оркестрового колокола из библиотеки STK</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>tubular stk bell</keywords>
            <since>0.9.4</since>
        </meta>
        <info>
            <par>
                <tr lang="en">This class implements two simple FM Pairs summed together, also
                referred to as algorithm 5 of the TX81Z</tr>
            </par>
        </info>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="0">
                <tr lang="en">main frequency</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @adsr -->
            <property name="@adsr" type="int" minvalue="0" maxvalue="127" default="0">
                <tr lang="en">ADSR 2 &amp; 4 Target</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="0" maxvalue="10000" default="220"
            units="hertz">
                <tr lang="en">frequency</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">play trigger - 1: on, 0: off</tr>
            </property>
            <!-- @lfo_depth -->
            <property name="@lfo_depth" type="int" minvalue="0" maxvalue="127" default="0">
                <tr lang="en">LFO delth</tr>
            </property>
            <!-- @lfo_speed -->
            <property name="@lfo_speed" type="int" minvalue="0" maxvalue="127" default="0">
                <tr lang="en">LFO speed in Hz</tr>
            </property>
            <!-- @mod -->
            <property name="@mod" type="int" minvalue="0" maxvalue="127" default="0">
                <tr lang="en">modulator index one</tr>
            </property>
            <!-- @pitch -->
            <property name="@pitch" type="float" minvalue="36" maxvalue="84" default="57">
                <tr lang="en">midi pitch</tr>
            </property>
            <!-- @xfade -->
            <property name="@xfade" type="int" minvalue="0" maxvalue="127" default="0">
                <tr lang="en">crossfade of outputs</tr>
            </property>
        </properties>
        <methods>
            <!-- cc -->
            <method name="cc">
                <info>
                    <tr lang="en">control change message</tr>
                </info>
                <param name="CTL" type="int" required="true">
                    <tr lang="en">control number</tr>
                </param>
                <param name="VAL" type="float" required="true">
                    <tr lang="en">value</tr>
                </param>
            </method>
            <!-- note -->
            <method name="note">
                <info>
                    <tr lang="en">note on/off message</tr>
                </info>
                <param name="NOTE" type="float" required="true">
                    <tr lang="en">midi note</tr>
                </param>
                <param name="VEL" type="float" minvalue="0" maxvalue="127" required="true">
                    <tr lang="en">velocity</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">NOTE VEL</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">synth output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
|
[list.apply_to 1]X[> 0]
|
[@pitch $1, @gate $2(
|
|  [F]        [F]
|  |          |
|  [@mod $1(  [@xfade $1(
|  |          |
[synth.tube_bell~ #x]
|
[ui.hgain~]   [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
