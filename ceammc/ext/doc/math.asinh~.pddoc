<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="math.asinh~">
        <title>math.asinh~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">hyperbolic arc sine for signals</tr>
                <tr lang="ru">обратный гиперболической синус для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math hyperbolic arc sine</keywords>
            <also>
                <see>math.sinh~</see>
                <see>math.asinh</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Outputs the principle value of the hyperbolic arc sine of input
                signal</tr>
                <!-- old: Выходит принципиальное значение синуса
                гиперболической дуги входного сигнала -->
                <tr lang="ru" finished="false">Выходит принципиальное значение синуса
                гиперболической дуги входного сигнала</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Inverse_hyperbolic_functions">wiki: Inverse
            hyperbolic functions</a>
        </info>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">result signal</tr>
                    <tr lang="ru" finished="false">результат сигнала</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[plot.linspace~ -4 4]
|                 ^|
[math.asinh~]      |
|                  |.
[ui.plot~ @xlabels 1 @ylabels 1 @ymin -2.5 @ymax 2.5 @ymin_ticks 0 @ymaj_ticks 0 @size 400 200]














[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
