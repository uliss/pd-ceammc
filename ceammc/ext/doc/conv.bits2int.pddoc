<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.bits2int">
    <title>conv.bits2int</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">convert list of bits to integer</tr>
        <tr lang="ru">преобразует список битов в целое число</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv bits int</keywords>
      <since>0.9.2</since>
      <aliases>
        <alias>ceammc/bits-&gt;int</alias>
        <alias>bits-&gt;int</alias>
      </aliases>
      <also>
        <see>conv.int2bits</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes a list of bits (0s and 1s) and converts it to an integer
        value. By default, the least significant bit is the rightmost element of the list, that is,
        the bits are read from most significant on the left to least significant on the right. This
        can be changed with the @rev property, which reverses the bit order.</tr>
        <tr lang="ru">Объект принимает список битов (0 и 1) и преобразует его в целое число. По
        умолчанию младший значащий бит — это самый правый элемент списка, то есть биты читаются от
        старшего слева к младшему справа. Это можно изменить свойством @rev, которое инвертирует
        порядок битов.</tr>
      </par>
    </info>
    <properties>
      <!-- @rev -->
      <property name="@rev" type="bool" default="0">
        <tr lang="en">reversed bit order</tr>
        <tr lang="ru">обратный порядок битов</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">input bit list</tr>
          <tr lang="ru">входной список битов</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">integer value</tr>
          <tr lang="ru">целое число</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[1 0 1 1(
|
[bits->int]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
