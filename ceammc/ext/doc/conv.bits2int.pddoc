<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="conv.bits2int">
        <title>conv.bits2int</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert list of bits to integer</tr>
                <tr lang="ru">преобразовать список битов в целое число</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv bits int</keywords>
            <since>0.9.2</since>
            <aliases>
                <alias>ceammc/bits-&gt;int</alias>
                <alias>bits-&gt;int</alias>
            </aliases>
            <also>
                <see>conv.int2bits</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: byte default the least significant bit is the rightmost, this
                can be changed with @rev property</tr>
            </par>
        </info>
        <properties>
            <!-- @rev -->
            <property name="@rev" type="bool" default="0">
                <tr lang="en">reversed bit order</tr>
                <tr lang="ru">обратный порядок битов</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">input bit list</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list of bits</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 0 1 1(
|
[bits->int]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
