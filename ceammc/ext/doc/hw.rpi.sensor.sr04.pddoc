<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.sensor.sr04">
    <title>hw.rpi.sensor.sr04</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">HC-SR04 ultrasonic ranging module for Raspberry Pi</tr>
        <tr lang="ru">HC-SR04 ультразвуковой датчик расстояния для Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>sensor ultrasonic range rpi arduino</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par style="critical">
        <tr lang="en">**Note:** The HC-SR04 ultrasonic sensor requires a 5V power supply, but the
        Raspberry Pi's GPIO inputs operate at 3.3V.</tr>
        <tr lang="ru">**Примечание:** Ультразвуковой датчик HC-SR04 требует питания 5В, но входы
        GPIO Raspberry Pi работают при 3.3В.</tr>
      </par>
      <par style="critical" space-top="-15">
        <tr lang="en">Therefore, you need to use a level converter from 5V to 3.3V, otherwise you
        can damage the Raspberry Pi!</tr>
        <tr lang="ru">Поэтому нужно использовать преобразователь уровней c 5В на 3.3В, иначе можно
        повредить Raspberry Pi! Преобразователь уровней можно сделать или на основе резистивного
        делителя, или на основе готовых модулей.</tr>
      </par>
      <par style="important">
        <tr lang="ru">При создании объект забирает в эксклюзивное владение GPIO контакты @trig_pin
        и @echo_pin: использовать их в других объектах одновременно с этим *невозможно*.</tr>
        <tr lang="en">When created, the object takes exclusive ownership of the GPIO pins @trig_pin
        and @echo_pin - it is *impossible* to use them in other objects simultaneously with this
        one.</tr>
      </par>
      <par style="info">
        <tr lang="en">To connect to the device, set the @connect property to 1</tr>
        <tr lang="ru">Для подключения к устройству установите свойство @connect равным 1</tr>
      </par>
    </info>
    <arguments>
      <argument name="TRIG_PIN" type="int" minvalue="-1" maxvalue="255">
        <tr lang="en">a trigger pin GPIO number. A value of -1 means not to use the GPIO pin</tr>
        <tr lang="ru">триггерный контакт GPIO. Значение -1 означает не использовать GPIO
        контакт</tr>
      </argument>
      <argument name="ECHO_PIN" type="int" minvalue="-1" maxvalue="255">
        <tr lang="en">an echo pin GPIO number. A value of -1 means not to use the GPIO pin</tr>
        <tr lang="ru">эхо контакт GPIO. Значение -1 означает не использовать GPIO контакт</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @connect -->
      <property name="@connect" type="bool" default="0" access="readwrite">
        <tr lang="en">When set to 1: tries to connect to the device on the I²C
        bus. When set to 0: disconnects from the device.</tr>
        <tr lang="ru">При установке в 1: пробует подключиться к устройству на
        шине I²C. При установке в 0: отключается от устройства.</tr>
      </property>
      <!-- @echo_pin -->
      <property name="@echo_pin" type="int" default="-1" minvalue="-1" maxvalue="255"
      access="initonly">
        <tr lang="en">an echo pin GPIO number. A value of -1 means not to use the GPIO pin</tr>
        <tr lang="ru">эхо контакт GPIO. Значение -1 означает не использовать GPIO контакт</tr>
      </property>
      <!-- @poll_interval -->
      <property name="@poll_interval" type="int" default="20" minvalue="10" maxvalue="1000"
      units="msec">
        <tr lang="en">poll interval</tr>
        <tr lang="ru">интервал между измерениями</tr>
      </property>
      <!-- @trig_pin -->
      <property name="@trig_pin" type="int" default="-1" minvalue="-1" maxvalue="255"
      access="initonly">
        <tr lang="en">a trigger pin GPIO number. A value of -1 means not to use the GPIO pin</tr>
        <tr lang="ru">триггерный контакт GPIO. Значение -1 означает не использовать GPIO
        контакт</tr>
      </property>
    </properties>
    <methods>
      <!-- poll -->
      <method name="poll">
        <info>
          <tr lang="en">turn the sensor polling on/off</tr>
          <tr lang="ru">включить/выключить автоматический опрос сенсора</tr>
        </info>
        <param name="STATE" type="bool" required="true">
          <tr lang="en">poll state</tr>
          <tr lang="ru">состояние опроса</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">make single distance measurement</tr>
          <tr lang="ru">произвести однократное измерение расстояния</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">distance in cm</tr>
          <tr lang="ru">расстояние в см</tr>
        </out>
      </outlet>
      <outlet>
        <out type="bang">
          <tr lang="en">if distance can not be measured</tr>
          <tr lang="ru">если расстояние невозможно измерить</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[@connect $1(  [bang #a(
|
| [T]
| |
| [poll $1(
| |
| |
[hw.rpi.sensor.sr04 @trig_pin 23 @echo_pin 24 #x]
|                              ^|
[F]                            [B]


[ui.link @url=ceammc://img/hc_sr04.png @title='Connection_scheme']
[X a->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
