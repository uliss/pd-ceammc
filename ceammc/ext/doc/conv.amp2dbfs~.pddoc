<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="conv.amp2dbfs~">
        <title>conv.amp2dbfs~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert from the amplitude to a decibel full scale</tr>
                <tr lang="ru">преобразование из амплитуды в децибелы полной шкалы</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv amp dbfs decibel</keywords>
            <since>0.6</since>
            <also>
                <see>dbfs-&gt;amp~</see>
            </also>
            <aliases>
                <alias>ceammc/amp-&gt;dbfs~</alias>
                <alias>amp-&gt;dbfs~</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">formulae: 20 * log10(amp)</tr>
            </par>
            <par>
                <tr lang="en">Note: amplitude value &lt;=0 is converted to -144 db (24-bit
                range)</tr>
            </par>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">converted signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(
|
[plot.linspace~ 1 -0.1]
|                    ^|
[amp->dbfs~]          |
|                     |.
[ui.plot~ @ymin -144 @ymax 0 @ylabels 1 @xlabels 1 @size 600 160]











[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
