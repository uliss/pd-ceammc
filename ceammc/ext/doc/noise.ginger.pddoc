<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="noise.ginger">
        <title>noise.ginger</title>
        <meta>
            <authors>
                <author>André Sier</author>
            </authors>
            <description>
                <tr lang="en">Gingerbreadman map chaotic generator</tr>
                <tr lang="ru">хаотический генератор на основе отображения Пряничного человечка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>noise</category>
            <keywords>chaos generator gingerbreadman</keywords>
            <since>0.1</since>
            <also>
                <see>chaos.gbman0</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">A non-interpolating generator based on the difference equations:</tr>
            </par>
            <par>
                <tr lang="en">x(n+1) = 1 - y(n) + seed * |x(n)|</tr>
            </par>
            <par>
                <tr lang="en">y(n+1) = x(n)</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Gingerbreadman_map">wiki: Gingerbreadman map</a>
        </info>
        <arguments>
            <argument name="SEED" type="float">
                <tr lang="en">seed value, default 0.82</tr>
            </argument>
            <argument name="X" type="float">
                <tr lang="en">initial x value, default 0.7</tr>
            </argument>
            <argument name="Y" type="float">
                <tr lang="en">initial y value, default 1.2</tr>
            </argument>
        </arguments>
        <properties />
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset seed, x and y values to defaults</tr>
                </info>
            </method>
            <!-- seed -->
            <method name="seed">
                <info>
                    <tr lang="en">set seed value and update default</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">set seed, x and y values, updates defaults</tr>
                </info>
            </method>
            <!-- x -->
            <method name="x">
                <info>
                    <tr lang="en">set x value and update default</tr>
                </info>
            </method>
            <!-- y -->
            <method name="y">
                <info>
                    <tr lang="en">set y value and update default</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">outputs current x/y values and generates new one</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>outputs x-value</outlet>
            <outlet>outputs y-value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 50 #metro]


  [T]         [F]
  |           |
  [om $1 #om( [set $1 #set( [reset #reset(

 [F]           
 |             
 [seed $1 #seed(      

        [F]       [F]       [F]       
        |         |         |         
        [x $1 #x( [y $1 #y( [z $1 #z(   

[noise.ginger 0.82 0.7 1.2 #noise-obj]
|                      |
[ui.display {i=1,o=0}] [ui.display {i=1,o=0}]

[X seed:0->noise-obj:0]

[X x:0->noise-obj:0] 
[X y:0->noise-obj:0] 
[X z:0->noise-obj:0] 

[X om:0->noise-obj:0]
[X set:0->noise-obj:0]
[X reset:0->noise-obj:0]

[X metro->noise-obj]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
