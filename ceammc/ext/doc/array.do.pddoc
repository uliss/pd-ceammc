<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="array.do">
        <title>array.do</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">iterate and modify the array content via the side-chain</tr>
                <tr lang="ru">обход и модификация содержимого массива через боковую цепь</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array do</keywords>
            <also>
                <see>array.each</see>
            </also>
            <since>0.3</since>
        </meta>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </property>
            <!-- @redraw -->
            <property name="@redraw" type="bool" default="1">
                <tr lang="en">redraw after array change</tr>
                <tr lang="ru">перерисовать после изменения массива</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">starts iteration</tr>
                    <tr lang="ru" finished="false">Начинается итерация</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">set array name</tr>
                    <tr lang="ru" finished="false">Имя при рождении</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">sample value from side-chain</tr>
                    <tr lang="ru" finished="false">значение выборки из боковой цепи</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">bang on finish</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">for each array sample outputs list: SAMPLE_VALUE, SAMPLE_POS,
                    TOTAL_SAMPLES</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[array A1 size=100 w=130 h=100 yr=0..1]







[B]
|
[array.do A1 #a] [unpack f f f #b]
|                   ^| ^^|.
[B]                 [/  #c]

[X a:1->b]
[X c->a:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
