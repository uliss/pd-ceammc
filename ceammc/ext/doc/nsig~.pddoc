<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="nsig~">
        <title>nsig~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">multichannel converter from the control signals to audio</tr>
                <tr lang="ru">многоканальный преобразователь управляющих сигналов в звуковые</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>sig list</keywords>
            <since>0.9</since>
            <also>
                <see>sig~</see>
            </also>
            <aliases>
                <alias>ceammc/nsig~</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="1" maxvalue="12">
                <tr lang="en">number of inputs/outputs</tr>
                <tr lang="ru" finished="false">Количество входов/выходов</tr>
            </argument>
            <argument name="VALUES" type="list">
                <tr lang="en">init values</tr>
                <tr lang="ru" finished="false">значения init</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @n -->
            <property name="@n" type="int" minvalue="1" default="1" maxvalue="12"
            access="initonly">
                <tr lang="en">number of inputs/outputs</tr>
                <tr lang="ru" finished="false">Количество входов/выходов</tr>
            </property>
            <!-- @values -->
            <property name="@values" type="list" default="">
                <tr lang="en">current output values. Default: 0</tr>
                <tr lang="ru" finished="false">текущие выходные значения. Дефолт: 0</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet number="1">
                <xinfo on="float">
                    <tr lang="en">set first output value</tr>
                    <tr lang="ru" finished="false">Установить первую выходную величину</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">set list of output values</tr>
                    <tr lang="ru" finished="false">установленный список выходных значений</tr>
                </xinfo>
            </inlet>
            <inlet number="...">
                <xinfo on="float">
                    <tr lang="en">set ... output value</tr>
                    <tr lang="ru" finished="false">установленная ... выходная стоимость</tr>
                </xinfo>
            </inlet>
            <inlet number="n">
                <xinfo on="float">
                    <tr lang="en">set n-th output value</tr>
                    <tr lang="ru" finished="false">установленная n-я выходная стоимость</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio" number="1">
                <out type="any">
                    <tr lang="en">first value output</tr>
                </out>
            </outlet>
            <outlet type="audio" number="...">
                <out type="any">
                    <tr lang="en">... value output</tr>
                </out>
            </outlet>
            <outlet type="audio" number="n">
                <out type="any">
                    <tr lang="en">n-th value output</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[3 2 1 #b( [0.5 0.5 #c(

[F]  [F]  [F]     [ui.dsp~]
|    |.   |..
[nsig~ 3 1 2 3 #a]
|
[ui.n~]

     [ui.n~ #y]

          [ui.n~ #z]
[X a:1->y] [X a:2->z] [X b->a] [X c->a]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
