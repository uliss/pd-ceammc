<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="array.mean">
        <title>array.mean</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">calculates the array arithmetic mean value</tr>
                <tr lang="ru">вычисляет среднее арифметическое значение массива</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array mean</keywords>
            <since>0.8</since>
            <also>
                <see>array.sum</see>
            </also>
        </meta>
        <info>
            <wiki name="Arithmetic_mean">Arithmetic mean</wiki>
        </info>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru" finished="false">имя массива</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">calculates and outputs mean value</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>mean value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]                            [array amean size=10 w=180 h=130]
|
[array.mean amean]
|
[F digits=16]

[uniform( [fill 0(
|         |
[array.fill amean]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
