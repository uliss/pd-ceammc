<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.mean">
    <title>array.mean</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">calculates the array arithmetic mean value</tr>
        <tr lang="ru">вычисляет среднее арифметическое значение массива</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array mean</keywords>
      <since>0.8</since>
      <also>
        <see>array.sum</see>
      </also>
    </meta>
    <info>
      <wiki name="Arithmetic_mean">Arithmetic mean</wiki>
      <par>
        <tr lang="en">The object computes the arithmetic mean (average) of all samples in the
        specified array and outputs it as a single float. The mean is calculated as the sum of all
        samples divided by their number.</tr>
        <tr lang="ru">Объект вычисляет среднее арифметическое всех семплов указанного массива и
        выводит его одним числом с плавающей точкой. Среднее вычисляется как сумма всех семплов,
        делённая на их количество.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">calculates the mean value and outputs it</tr>
          <tr lang="ru">вычисляет среднее значение и выводит его</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">mean value</tr>
          <tr lang="ru">среднее значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                            [array amean size=10 w=180 h=130]
|
[array.mean amean]
|
[F digits=16]

[uniform( [fill 0(
|         |
[array.fill amean]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
