<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.p2s">
    <title>array.p2s</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converting the array phase [0..1] to the sample index</tr>
        <tr lang="ru">преобразование фазы массива [0..1] в индекс семпла</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>array phase sample</keywords>
      <also>
        <see>array.s2p</see>
      </also>
      <since>0.2</since>
      <aliases>
        <alias>array.p-&gt;s</alias>
        <alias>array.phase-&gt;sample</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">This object allows relative access to the array: the input phase in the range
        0..1 is converted to the corresponding sample index in the array. A value of 0 maps to the
        beginning of the array and 1 to the end. If a list is received, the conversion is applied
        to each value and a list of indexes is output.</tr>
        <tr lang="ru">Объект позволяет получить относительный доступ к массиву: входная фаза в
        диапазоне 0..1 преобразуется в соответствующий индекс семпла в массиве. Значение 0
        соответствует началу массива, а 1 — концу. Если на вход подаётся список, преобразование
        применяется к каждому значению, и на выход отправляется список индексов.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array used for conversion</tr>
        <tr lang="ru">имя массива, используемого для преобразования</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array used for conversion</tr>
        <tr lang="ru">имя массива, используемого для преобразования</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">phase value between 0 and 1, where 0 maps to the beginning of the array and
          1 to the end</tr>
          <tr lang="ru">значение фазы от 0 до 1, где 0 соответствует началу массива, а 1 —
          концу</tr>
        </in>
        <in on="list">
          <tr lang="en">list of array phases</tr>
          <tr lang="ru">список фаз массива</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">sample index when the input value is a float</tr>
          <tr lang="ru">индекс семпла, когда входное значение — число</tr>
        </out>
        <out type="list">
          <tr lang="en">sample indexes when the input value is a list of floats</tr>
          <tr lang="ru">индексы семплов, когда входное значение — список чисел</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[HS min=0 max=1]       [array p2s size=100 w=200 h=150]
|
[F]
|
[array.p->s p2s]
|
[F]
|
[tabread p2s]
|
[F]

[loadmsg sinesum 100 0.5 0.2 0.1 0.3]
|
[s p2s]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
