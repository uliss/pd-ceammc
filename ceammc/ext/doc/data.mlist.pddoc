<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="data.mlist">
        <title>data.mlist</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">the multidimensional list container</tr>
                <tr lang="ru">многомерный список</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data multilist</keywords>
            <since>0.6</since>
            <also>
                <see>data.list</see>
            </also>
            <aliases>
                <alias>ceammc/mlist</alias>
                <alias>mlist</alias>
                <alias>ceammc/ml</alias>
                <alias>ml</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Syntax: values are separated by spaces: (1 2 3) - list of 1, 2 and
                3</tr>
            </par>
            <par>
                <tr lang="en">Nested lists: (1 2 3 (nested list values))</tr>
            </par>
            <par>
                <tr lang="en">Symbols with spaces: ("single item list")</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">open data editor</event>
        </mouse>
        <arguments>
            <argument name="VALUE" type="atom">
                <tr lang="en">initial list values in (). For example: (1 2 3 (1 2) 4)</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @empty -->
            <property name="@empty" type="bool" access="readonly" default="1">
                <tr lang="en">1 if list is empty, otherwise 0</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="int" access="readonly" minvalue="0" default="0">
                <tr lang="en">number of elements in list</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="atom" default="[]">
                <tr lang="en">mlist value</tr>
            </property>
        </properties>
        <methods>
            <!-- (....) -->
            <method name="(....)" example="true">
                <info>
                    <tr lang="en">sets new list without output</tr>
                </info>
            </method>
            <!-- append -->
            <method name="append">
                <info>
                    <tr lang="en">adds values to the end of the list</tr>
                </info>
                <param name="VAL" type="atom" required="true">
                    <tr lang="en">appended value</tr>
                </param>
            </method>
            <!-- at -->
            <method name="at">
                <info>
                    <tr lang="en">outputs atom at the specified position</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">position (negative indexes are supported: -1 means last
                    element)</tr>
                </param>
            </method>
            <!-- back -->
            <method name="back">
                <info>
                    <tr lang="en">output last list element</tr>
                </info>
            </method>
            <!-- choose -->
            <method name="choose">
                <info>
                    <tr lang="en">choose random element in list and output it</tr>
                </info>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">removes all list elements</tr>
                </info>
            </method>
            <!-- dump -->
            <method name="dump">
                <info>
                    <tr lang="en">dump object info to Pd window</tr>
                </info>
            </method>
            <!-- fill -->
            <method name="fill">
                <info>
                    <tr lang="en">fills with specified value</tr>
                </info>
                <param name="VAL" type="atom" required="true">
                    <tr lang="en">fill value</tr>
                </param>
            </method>
            <!-- front -->
            <method name="front">
                <info>
                    <tr lang="en">output first list element</tr>
                </info>
            </method>
            <!-- insert -->
            <method name="insert">
                <info>
                    <tr lang="en">inserts values to the specified position</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">insert position</tr>
                </param>
                <param name="VAL" type="atom" required="true">
                    <tr lang="en">value</tr>
                </param>
            </method>
            <!-- pop -->
            <method name="pop">
                <info>
                    <tr lang="en">removes last list element</tr>
                </info>
            </method>
            <!-- prepend -->
            <method name="prepend">
                <info>
                    <tr lang="en">inserts values to the list beginning</tr>
                </info>
                <param name="VAL" type="atom" required="true">
                    <tr lang="en">prepended value</tr>
                </param>
            </method>
            <!-- remove -->
            <method name="remove">
                <info>
                    <tr lang="en">removes specified element</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">element index</tr>
                </param>
            </method>
            <!-- reverse -->
            <method name="reverse">
                <info>
                    <tr lang="en">reverses list</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">sets new list without output</tr>
                </info>
                <param name="LIST" type="list" required="true">
                    <tr lang="en">new list content</tr>
                </param>
            </method>
            <!-- shuffle -->
            <method name="shuffle">
                <info>
                    <tr lang="en">put elements in random order</tr>
                </info>
            </method>
            <!-- sort -->
            <method name="sort">
                <info>
                    <tr lang="en">sorts list</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">output current list value</xinfo>
                <xinfo on="symbol">set new list with single symbol element and output</xinfo>
                <xinfo on="list">sets new list and output it</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output list or list elements</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(
|
|  [\(A B C), bang(
|  |
|  |  [1 2 3, bang(
|  |  |
[data.mlist (1 2 3 (1 3 3))]
|
[ui.d @display_type 1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
