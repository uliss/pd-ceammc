<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="list.pass_if">
        <title>list.pass_if</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">leave only elements accepted by side-chain predicate</tr>
                <tr lang="ru">оставляет в списке только элементы, принятые предикатом боковой цепи
                обработки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list pass accept leave predicate</keywords>
            <since>0.3</since>
            <also>
                <see>list.remove_if</see>
            </also>
            <aliases>
                <alias>list.filter</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Predicate object should accept atom and output 0 (remove element) or
                1 (leave element)</tr>
                <!-- old: Предикатный объект должен принимать атом и выводить
                0 (удалить элемент) или 1 (уйти элемент) -->
                <tr lang="ru" finished="false">Предикатный объект должен принимать атом и выводить
                0 (удалить элемент) или 1 (уйти элемент)</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">input list</tr>
                    <tr lang="ru" finished="false">вводный список</tr>
                </in>
                <in on="data:mlist">
                    <tr lang="en">input mlist</tr>
                    <tr lang="ru" finished="false">входной млечный</tr>
                </in>
            </inlet>
            <inlet>
                <in on="float">
                    <tr lang="en">value from predicate</tr>
                    <tr lang="ru" finished="false">значение из предиката</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output list with accepted elements</tr>
                    <tr lang="ru" finished="false">Список результатов с принятыми элементами</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">atom to predicate</tr>
                    <tr lang="ru" finished="false">Атом предсказывает</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[10(                          [10(
|                             |
[list.seq]                    [list.seq]
|                             |
[list.pass_if] X [is_odd]     [list.pass_if] X [> 5]
|                             |
[ui.dt]                       [ui.dt]

[B]
|
[path.ls .]
|
[list.pass_if] X [str.ends_with .pd]
|
[str.join ' ']
|
[str->sym]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
