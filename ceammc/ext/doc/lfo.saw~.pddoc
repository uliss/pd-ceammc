<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="lfo.saw~">
        <title>lfo.saw~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">full-range unit-amplitude low frequency saw</tr>
                <tr lang="ru">низкочастотная пилообразная волна в диапазоне [-1,+1]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>lfo</category>
            <keywords>lfo oscillator saw phasor</keywords>
            <since>0.7</since>
            <also>
                <see>lfo.+saw~</see>
                <see>lfo.square~</see>
                <see>lfo.impulse~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="0" maxvalue="1000">
                <tr lang="en">frequency</tr>
            </argument>
            <argument name="INVERT" type="bool">
                <tr lang="en">wave inversion</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" default="0" minvalue="0" maxvalue="1000"
            units="hertz">
                <tr lang="en">initial frequency</tr>
            </property>
            <!-- @invert -->
            <property name="@invert" type="bool" default="0">
                <tr lang="en">wave inversion</tr>
            </property>
            <!-- @pause -->
            <property name="@pause" type="bool" default="0">
                <tr lang="en">pause oscillator at current value</tr>
            </property>
            <!-- @phase -->
            <property name="@phase" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">initial phase</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">reset to initial state</method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>frequency in Hz (can be zero or negative)</xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">reset phase</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">saw wave in [-1, +1] range</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]      [T]                   [ui.dsp~]
|        |
|        [@invert $1(
|        |
|        |
[lfo.saw~ 46]
|
|
[ui.scope~ @size=300x100]







[lfo.saw~-sound]
]]>
            </pdascii>
            <pdascii id="sound">
<![CDATA[
[osc.saw~ 100]
|
[ui.gain~ @size 120 14] [T]          [T]
|                       |            |
|              [F]      [@invert $1( [@pause $1(
|              |        |            |
|              [lfo.saw~ 1           ]
|          .___/
[pan.linsig~]    [ui.dsp~]
|  ^|.
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
