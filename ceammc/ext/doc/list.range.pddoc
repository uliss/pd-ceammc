<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="list.range">
    <title>list.range</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">outputs list smallest and largest elements</tr>
        <tr lang="ru">выводит минимальный и максимальный элемент в списке</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>list</category>
      <keywords>list range compare</keywords>
      <since>0.1</since>
      <also>
        <see>list.min</see>
        <see>list.max</see>
      </also>
      <aliases>
        <alias>list.minmax</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Note: if @type = any, numbers are smaller then symbols</tr>
        <!-- old: Примечание: если @type = любой, числа меньше, чем
                символы -->
        <tr lang="ru" finished="false">Примечание: если @type = любой, числа меньше, чем
        символы</tr>
      </par>
    </info>
    <properties>
      <!-- @a -->
      <property name="@a" type="alias">
        <tr lang="en">alias to @type any, accept all</tr>
        <tr lang="ru" finished="false">alias to @type any, accept all</tr>
      </property>
      <!-- @f -->
      <property name="@f" type="alias">
        <tr lang="en">alias to @type float, accept only floats</tr>
        <!-- old: alias to @type float, accept only floats
                (недоступная ссылка) -->
        <tr lang="ru" finished="false">alias to @type float, accept only floats (недоступная
        ссылка)</tr>
      </property>
      <!-- @s -->
      <property name="@s" type="alias">
        <tr lang="en">alias to @type symbol, accept only symbols</tr>
        <tr lang="ru" finished="false">alias to @type symbol, только символы</tr>
      </property>
      <!-- @type -->
      <property name="@type" type="symbol" enum="float symbol any" default="float">
        <tr lang="en">type of accepted atoms</tr>
        <tr lang="ru" finished="false">Тип принятых атомов</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">input list</tr>
          <tr lang="ru" finished="false">вводный список</tr>
        </in>
        <in on="data:mlist">
          <tr lang="en">input mlist</tr>
          <tr lang="ru" finished="false">входной млечный</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">list of two elements: first is a smallest value, second - largest</tr>
          <tr lang="ru" finished="false">список из двух элементов: первый — наименьшее значение,
          второй — наибольшее</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[-3 0 10 2 -5 11 a b c(
|
[list.range @f]
|
[ui.dt]

[-3 0 10 2 -5 11 a b c(
|
[list.range @s]
|
[ui.dt]

[-3 0 10 2 -5 11 a b c(
|
[list.range @a]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
