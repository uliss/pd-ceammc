<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.range">
        <title>list.range</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs list smallest and largest elements</tr>
                <tr lang="ru">выводит минимальный и максимальный элемент в списке</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list range compare</keywords>
            <since>0.1</since>
            <also>
                <see>list.min</see>
                <see>list.max</see>
            </also>
            <aliases>
                <alias>list.minmax</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: if @type = any, numbers are smaller then symbols</tr>
            </par>
        </info>
        <properties>
            <!-- @a -->
            <property name="@a" type="alias">
                <tr lang="en">alias to @type any, accept all</tr>
            </property>
            <!-- @f -->
            <property name="@f" type="alias">
                <tr lang="en">alias to @type float, accept only floats</tr>
            </property>
            <!-- @s -->
            <property name="@s" type="alias">
                <tr lang="en">alias to @type symbol, accept only symbols</tr>
            </property>
            <!-- @type -->
            <property name="@type" type="symbol" enum="float symbol any" default="float">
                <tr lang="en">type of accepted atoms</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list of two elements: first is a smallest value, second - largest</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[-3 0 10 2 -5 11 a b c(
|
[list.range @f]
|
[ui.dt]

[-3 0 10 2 -5 11 a b c(
|
[list.range @s]
|
[ui.dt]

[-3 0 10 2 -5 11 a b c(
|
[list.range @a]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
