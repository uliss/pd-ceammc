<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="route.float">
    <title>route.float</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">separates float messages from others</tr>
        <tr lang="ru">отделяет числовые сообщения от сообщений других типов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>route</keywords>
      <since>0.9.2</since>
      <aliases>
        <alias>route.f</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes float messages to the first outlet and all other messages (bang, symbol, list, any) to the second outlet</tr>
        <tr lang="ru">объект направляет числовые сообщения на первый выход, а все остальные (bang, символы, списки, any) — на второй выход</tr>
      </par>
      <par>
        <tr lang="en">by default a list containing a single float is treated as a float. Set @strict to true to disable this behavior and route such lists to the second outlet</tr>
        <tr lang="ru">по умолчанию список из одного числа рассматривается как число. Установите @strict в true, чтобы отключить это поведение и направлять такие списки на второй выход</tr>
      </par>
      <par>
        <tr lang="en">to get properties, use the [prop.get] object, since all messages (including property requests) are passed through</tr>
        <tr lang="ru">для получения свойств используйте объект [prop.get], так как все сообщения (включая запросы свойств) проходят насквозь</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to separate numeric values from other messages, for example to route numbers to a display and everything else to a logger</tr>
        <tr lang="ru">объект можно использовать для отделения числовых значений от других сообщений, например чтобы направлять числа на дисплей, а всё остальное — в логгер</tr>
      </par>
    </info>
    <properties>
      <!-- @strict -->
      <property name="@strict" type="bool" default="0">
        <tr lang="en">strict mode. By default a list with a single float is treated as a float. Set to true to disable this behavior</tr>
        <tr lang="ru">строгий режим. По умолчанию список с одним числом рассматривается как число. Установите true, чтобы отключить это поведение</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">float to the first outlet</tr>
          <tr lang="ru">число на первый выход</tr>
        </in>
        <in on="bang">
          <tr lang="en">bang to the second outlet</tr>
          <tr lang="ru">bang на второй выход</tr>
        </in>
        <in on="symbol">
          <tr lang="en">symbol to the second outlet</tr>
          <tr lang="ru">символ на второй выход</tr>
        </in>
        <in on="list">
          <tr lang="en">list to the second outlet. See the @strict property for details</tr>
          <tr lang="ru">список на второй выход. См. свойство @strict для подробностей</tr>
        </in>
        <in on="any">
          <tr lang="en">any message to the second outlet</tr>
          <tr lang="ru">сообщение any на второй выход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">float output</tr>
          <tr lang="ru">выход чисел</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">other messages</tr>
          <tr lang="ru">другие сообщения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]  [bang( [S digits=10 #a]
|    |
|    |   [list 1 2 3(   [T]
|    |   |              |
|    |   |  [list 123(  [prop.set @strict]
|    |   |  |           |
|    |   |  | [@any(    |
|    |   |  | |         |
[route.float          #z]
|       ^|
[F]     [ui.dt]

[X a->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
