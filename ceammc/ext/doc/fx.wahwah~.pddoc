<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="fx.wahwah~">
        <title>fx.wahwah~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">digitized CryBaby wah pedal</tr>
                <tr lang="ru">педаль CryBaby WahWah</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>wahwah guitar crybaby</keywords>
            <since>0.6</since>
        </meta>
        <arguments>
            <argument name="ANGLE" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">pedal angle</tr>
            </argument>
            <argument name="SPEED" type="float" minvalue="360" maxvalue="780" units="bpm">
                <tr lang="en">automatisation speed</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @angle -->
            <property name="@angle" type="float" minvalue="0" maxvalue="1" default="0.6">
                <tr lang="en">pedal angle</tr>
            </property>
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet.</tr>
            </property>
            <!-- @speed -->
            <property name="@speed" type="float" minvalue="360" maxvalue="780" default="540"
            units="bpm">
                <tr lang="en">automatisation speed</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">reset object</method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>input signal</xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">set angle</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio" />
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[noise.lfreq0~ 10]
|
[fx.drone_box~] [ui.hsl]
|               |
|               [@angle $1(
|               |
[fx.wahwah~     ]
|
[ui.gain~ @size 120 16]
|\
[dac~]

[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
