<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="proto.xtouch_ext">
        <title>proto.xtouch_ext</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Behringer XTouch Extender XMidi protocol</tr>
                <tr lang="ru">управление Behringer XTouch XMidi</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>proto</category>
            <keywords>xtouch behringer</keywords>
            <since>0.9.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Behringer XTouch Extender XMidi</tr>
            </par>
        </info>
        <arguments>
            <argument name="PROTO" type="symbol" enum="hui mcu xmidi">
                <tr lang="en">connection protocol</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @n -->
            <property name="@n" type="int" access="initonly" minvalue="1" maxvalue="32"
            default="2">
                <tr lang="en">number of scenes</tr>
            </property>
            <!-- @proto -->
            <property name="@proto" type="symbol" default="xmidi" enum="hui mcu xmidi">
                <tr lang="en">connection protocol</tr>
            </property>
            <!-- @scene -->
            <property name="@scene" type="int" minvalue="0" default="0">
                <tr lang="en">current scene</tr>
            </property>
        </properties>
        <methods>
            <!-- fader -->
            <method name="fader">set fader value 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="X" type="list" required="true">
                <tr lang="en">fader value(s)</tr>
            </param></method>
            <!-- fader? -->
            <method name="fader?">get fader value, output to second outlet in format [fader? IDX
            VALUE( 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param></method>
            <!-- knob -->
            <method name="knob">set knob value 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="X" type="list" required="true">
                <tr lang="en">fader value(s)</tr>
            </param></method>
            <!-- knob? -->
            <method name="knob?">get knob value, output to second outlet in format [knob? IDX
            VALUE( 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param></method>
            <!-- lcd -->
            <method name="lcd">set LCD text 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="UPPER" type="atom" required="true">
                <tr lang="en">upper display text</tr>
            </param>
            <param name="LOWER" type="atom" required="true">
                <tr lang="en">lower display text</tr>
            </param></method>
            <!-- lcd0 -->
            <method name="lcd0">set upper LCD text 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="STR" type="list" required="true">
                <tr lang="en">upper display text</tr>
            </param></method>
            <!-- lcd1 -->
            <method name="lcd1">set lower LCD text 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="STR" type="list" required="true">
                <tr lang="en">lower display text</tr>
            </param></method>
            <!-- lcd_align -->
            <method name="lcd_align">set all texts alignment. Note: you should set this before
            setting upper display text 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="ALIGN" type="list" required="true">
                <tr lang="en">align name. Valid names are: left, right, center, justify and
                auto</tr>
            </param></method>
            <!-- lcd_align0 -->
            <method name="lcd_align0">set upper text alignment. Note: you should set this before
            setting upper display text 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="ALIGN" type="list" required="true">
                <tr lang="en">align name. Valid names are: left, right, center, justify and
                auto</tr>
            </param></method>
            <!-- lcd_align1 -->
            <method name="lcd_align1">set lower text alignment. Note: you should set this before
            setting lower display text 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="ALIGN" type="list" required="true">
                <tr lang="en">align name. Valid names are: left, right, center, justify and
                auto</tr>
            </param></method>
            <!-- lcd_color -->
            <method name="lcd_color">set display color 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="COLOR" type="list" required="true">
                <tr lang="en">list of color name or color indexes. Valid color names are: black,
                red, green, blue, yellow, magenta, cyan, white and random. Valid color indexes are
                in 0..7 range</tr>
            </param></method>
            <!-- lcd_enum0 -->
            <method name="lcd_enum0">set all upper display text with incremental enumeration 
            <param name="PREFIX" type="atom">
                <tr lang="en">name prefix</tr>
            </param></method>
            <!-- lcd_enum1 -->
            <method name="lcd_enum1">set all lower display text with incremental enumeration 
            <param name="PREFIX" type="atom">
                <tr lang="en">name prefix</tr>
            </param></method>
            <!-- lcd_mode -->
            <method name="lcd_mode">set lcd background/highlight mode. 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="MODE" type="list" required="true">
                <tr lang="en">mod values. 0: display is inverted, 1: upper is inverted, 2: lower is
                inverted, 3: none in inverted</tr>
            </param></method>
            <!-- llcd -->
            <method name="llcd">set several lower LCD text 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="ATOMS" type="list" required="true">
                <tr lang="en">lower display texts, each atom per display</tr>
            </param></method>
            <!-- mute -->
            <method name="mute">set mute buttons 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="X" type="list" required="true">
                <tr lang="en">button value(s)</tr>
            </param></method>
            <!-- mute? -->
            <method name="mute?">get mute button, output to second outlet in format [mute? IDX
            VALUE( 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param></method>
            <!-- mute_mode -->
            <method name="mute_mode">set mute buttons toggle mode 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="X" type="list" required="true">
                <tr lang="en">values list: -1, 0 or 1</tr>
            </param></method>
            <!-- rec -->
            <method name="rec">set rec buttons 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="X" type="list" required="true">
                <tr lang="en">button value(s)</tr>
            </param></method>
            <!-- rec? -->
            <method name="rec?">get rec button, output to second outlet in format [rec? IDX VALUE( 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param></method>
            <!-- rec_mode -->
            <method name="rec_mode">set rec buttons toggle mode 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="X" type="list" required="true">
                <tr lang="en">values list: -1, 0 or 1</tr>
            </param></method>
            <!-- reset -->
            <method name="reset">reset all knobs, faders and buttons to 0, vu to lowest values. Do
            not change display texts</method>
            <!-- select -->
            <method name="select">set select buttons 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="X" type="list" required="true">
                <tr lang="en">button value(s)</tr>
            </param></method>
            <!-- select? -->
            <method name="select?">get select button, output to second outlet in format [select?
            IDX VALUE( 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param></method>
            <!-- select_mode -->
            <method name="select_mode">set select buttons toggle mode 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="X" type="list" required="true">
                <tr lang="en">values list: -1, 0 or 1</tr>
            </param></method>
            <!-- solo -->
            <method name="solo">set solo buttons 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="X" type="list" required="true">
                <tr lang="en">button value(s)</tr>
            </param></method>
            <!-- solo? -->
            <method name="solo?">get solo button, output to second outlet in format [solo? IDX
            VALUE( 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param></method>
            <!-- solo_mode -->
            <method name="solo_mode">set solo buttons toggle mode 
            <param name="CHAN" type="atom" required="true">
                <tr lang="en">'all', 'scene' or channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="X" type="list" required="true">
                <tr lang="en">values list: -1, 0 or 1</tr>
            </param></method>
            <!-- ulcd -->
            <method name="ulcd">set several upper LCD text 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="ATOMS" type="list" required="true">
                <tr lang="en">upper display texts, each atom per display</tr>
            </param></method>
            <!-- vu -->
            <method name="vu">set VU meter indicator 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">channel index, max value is NUM_SCENES * 8</tr>
            </param>
            <param name="DB" type="float" required="true">
                <tr lang="en">level in decibels, in -144..0 range</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">raw midi input</xinfo>
                <xinfo on="any">recIDX VAL: set rec button, muteIDX VAL: set mute button, soloIDX
                VAL: set solo button, selectIDX VAL: set select button, knobIDX VAL: set knob
                value, faderIDX VAL: set fader value</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>raw midi output to behringer device</outlet>
            <outlet>control messages from device</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[midiin]   [S digits=25]         [r oxt]
|          |                     |
|          |                     [route fader0]
|          |                     |
| [r ixt]  [sym->any {i=1,o=1}]  [sync #a] [ui.knob #b]
| |        |                     |
[proto.xtouch_ext #z]            |
|         ^| ^|                  |
|          | [ui.dt]             [fader0 $1(
|          |                     |
[midiout]  [s oxt]               [s ixt]
[X a:1->b]
[X b->a:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
