<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="system.info">
        <title>system.info</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">retrieve system information: CPU and temperature</tr>
                <tr lang="ru">получение информации о системе: ЦПУ и температура</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>system</category>
            <keywords>system info cpu</keywords>
            <since>0.9.8</since>
        </meta>
        <methods>
            <!-- cpu -->
            <method name="cpu">request information about system cpus</method>
            <!-- temp -->
            <method name="temp">request system temperature information. Output in format: temp
            SENSOR_NAME VALUE</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>control input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output [temp SENSOR_NAME VALUE( or [cpu INFO_DICT(</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[temp(
|
| [cpu(
| |
| |
[system.info]
|
[print INFO]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
