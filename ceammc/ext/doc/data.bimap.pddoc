<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="data.bimap">
    <title>data.bimap</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">bidirectional map container</tr>
        <tr lang="ru">контейнер двунаправленного отображения</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data map container bidirectional</keywords>
      <since>0.9.7</since>
      <aliases>
        <alias>ceammc/bimap</alias>
        <alias>bimap</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">NOTE: all object inlets are 'hot'</tr>
        <tr lang="ru">ПРИМЕЧАНИЕ: все входы объекта являются «горячими»</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">open data editor</event>
    </mouse>
    <arguments>
      <argument name="VALUE" type="list">
        <tr lang="en">initial value, a list of pairs: LEFT_KEY1 RIGHT_KEY1 LEFT_KEY2 RIGHT_KEY2
        etc.</tr>
        <tr lang="ru">начальное значение, список пар: LEFT_KEY1 RIGHT_KEY1 LEFT_KEY2 RIGHT_KEY2
        и т.д.</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @empty -->
      <property name="@empty" type="bool" default="1" access="readonly">
        <tr lang="en">true if container is empty</tr>
        <tr lang="ru">истина, если контейнер пустой</tr>
      </property>
      <!-- @keys_left -->
      <property name="@keys_left" type="list" default="" access="readonly">
        <tr lang="en">list of left map keys</tr>
        <tr lang="ru">список левых ключей отображения</tr>
      </property>
      <!-- @keys_right -->
      <property name="@keys_right" type="list" default="" access="readonly">
        <tr lang="en">list of right map keys</tr>
        <tr lang="ru">список правых ключей отображения</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="int" default="0" access="readonly">
        <tr lang="en">number of left-right pairs in the map</tr>
        <tr lang="ru">количество лево-правых пар в отображении</tr>
      </property>
      <!-- @value -->
      <property name="@value" type="list" default="">
        <tr lang="en">value, a list of pairs: LEFT_KEY1 RIGHT_KEY1 LEFT_KEY2 RIGHT_KEY2 etc.</tr>
        <tr lang="ru">значение, список пар: LEFT_KEY1 RIGHT_KEY1 LEFT_KEY2 RIGHT_KEY2 и т.д.</tr>
      </property>
    </properties>
    <methods>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clear the bidirectional map content</tr>
          <tr lang="ru">очистить содержимое двунаправленного отображения</tr>
        </info>
      </method>
      <!-- insert -->
      <method name="insert">
        <info>
          <tr lang="en">insert a new left-right map entry</tr>
          <tr lang="ru">вставить новую лево-правую пару в отображение</tr>
        </info>
        <param name="PAIR" type="list" required="true">
          <tr lang="en">list: LEFT_KEY RIGHT_KEY</tr>
          <tr lang="ru">список: LEFT_KEY RIGHT_KEY</tr>
        </param>
      </method>
      <!-- read -->
      <method name="read">
        <info>
          <tr lang="en">read the bimap from a JSON file. An array of array pairs is expected.</tr>
          <tr lang="ru">прочитать отображение из файла JSON. Ожидается массив пар массивов.</tr>
        </info>
        <param name="FNAME" type="symbol" required="true">
          <tr lang="en">path to the file, absolute or relative</tr>
          <tr lang="ru">путь к файлу, абсолютный или относительный</tr>
        </param>
      </method>
      <!-- set -->
      <method name="set">
        <info>
          <tr lang="en">set the bidirectional map content</tr>
          <tr lang="ru">установить содержимое двунаправленного отображения</tr>
        </info>
        <param name="DATA" type="list" required="true">
          <tr lang="en">new value list</tr>
          <tr lang="ru">новый список значений</tr>
        </param>
      </method>
      <!-- write -->
      <method name="write">
        <info>
          <tr lang="en">write to a JSON file; to overwrite an existing file, use the @force
          flag</tr>
          <tr lang="ru">записать в файл JSON; чтобы перезаписать существующий файл, используйте
          флаг @force</tr>
        </info>
        <param name="FNAME" type="symbol" required="true">
          <tr lang="en">path to the file, absolute or relative</tr>
          <tr lang="ru">путь к файлу, абсолютный или относительный</tr>
        </param>
        <param name="@force" type="symbol" required="false">
          <tr lang="en">force flag to overwrite existing files</tr>
          <tr lang="ru">флаг принудительной перезаписи существующих файлов</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="atom">
          <tr lang="en">try to find the left key in the map and output the right value on
          success</tr>
          <tr lang="ru">попытаться найти левый ключ в отображении и вывести правое значение в
          случае успеха</tr>
        </in>
        <in on="list">
          <tr lang="en">try to find each left key of the list in the map and output the resulting
          list of right values</tr>
          <tr lang="ru">попытаться найти каждый левый ключ из списка в отображении и вывести
          результирующий список правых значений</tr>
        </in>
      </inlet>
      <inlet>
        <in on="atom">
          <tr lang="en">try to find the right key in the map and output the left value on
          success</tr>
          <tr lang="ru">попытаться найти правый ключ в отображении и вывести левое значение в
          случае успеха</tr>
        </in>
        <in on="list">
          <tr lang="en">try to find each right key of the list in the map and output the resulting
          list of left values</tr>
          <tr lang="ru">попытаться найти каждый правый ключ из списка в отображении и вывести
          результирующий список левых значений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">atom or list: right value output</tr>
          <tr lang="ru">атом или список: вывод правого значения</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">atom or list: left value output</tr>
          <tr lang="ru">атом или список: вывод левого значения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[L]                        [L]
|                          |
| [F]                      |  [S]
| |                        |. |.
[data.bimap 0 C 1 D 2 E 3 F 4 G 5 A 6 B]
|                          ^|
[ui.dt]                    [ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
