<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="set.symdiff">
    <title>set.symdiff</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">symmetric difference between two sets</tr>
        <tr lang="ru">симметрическая разность двух множеств</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data symmetric difference set</keywords>
      <since>0.3</since>
      <also>
        <see>data.set</see>
        <see>set.diff</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Computes the symmetric difference of the two incoming sets: outputs a new set
        that contains only those elements which belong to exactly one of the two sets — that is,
        all elements from either set, excluding those present in both.</tr>
        <tr lang="ru">Вычисляет симметрическую разность двух входящих множеств: выводит новое
        множество, содержащее только те элементы, которые принадлежат ровно одному из двух
        множеств, — то есть все элементы обоих множеств, кроме тех, что есть в обоих
        сразу.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARGS" type="any">
        <tr lang="en">elements of the right set</tr>
        <tr lang="ru">элементы правого множества</tr>
      </argument>
    </arguments>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">first set or list (converted to set). Other values are ignored</tr>
          <tr lang="ru">первое множество или список (преобразуется во множество). Остальные
          значения игнорируются</tr>
        </in>
      </inlet>
      <inlet>
        <in>
          <tr lang="en">second set or list (converted to set)</tr>
          <tr lang="ru">второе множество или список (преобразуется во множество)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">outputs the symmetric difference of the given sets</tr>
          <tr lang="ru">выводит симметрическую разность заданных множеств</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[data.set A B C D]
|
[set.symdiff C D E F]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
