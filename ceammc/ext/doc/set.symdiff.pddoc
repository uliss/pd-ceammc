<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="set.symdiff">
        <title>set.symdiff</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">symmetric difference between two sets</tr>
                <tr lang="ru">симметрическая разность между двумя множествами</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data symmetric difference set</keywords>
            <since>0.3</since>
            <also>
                <see>data.set</see>
                <see>set.diff</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Symmetric difference, of two sets is the set of elements which are in
                either of the sets and not in their intersection</tr>
                <tr lang="ru" finished="false">Симметричное различие двух множеств — это множество
                элементов, которые находятся в любом из множеств, а не в их пересечении.</tr>
            </par>
        </info>
        <arguments>
            <argument name="ARGS" type="any">
                <tr lang="en">right set elements</tr>
                <tr lang="ru" finished="false">Правильный набор элементов</tr>
            </argument>
        </arguments>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">first set or list (converted to set), other values are
                    ignored</tr>
                    <tr lang="ru" finished="false">первый набор или список (преобразуется в набор),
                    другие значения игнорируются;</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">second set or list (converted to set)</tr>
                    <tr lang="ru" finished="false">Второй набор или список (преобразуется в
                    набор)</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output symmetric set difference</tr>
                    <tr lang="ru" finished="false">выходная симметричная разность</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[data.set A B C D]
|
[set.symdiff C D E F]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
