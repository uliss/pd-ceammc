<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="ui.filter" type="gui">
        <title>ui.filter</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">filter widget for calculating [flt.biquad~] coefficients</tr>
                <tr lang="ru">виджет-калькулятор коэффициентов для фильтра [flt.biquad~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui filter biquad</keywords>
            <since>0.9.2</since>
            <also>
                <see view="link">ui.filter~</see>
            </also>
        </meta>
        <mouse>
            <event type="left-click" editmode="false">jump to coord under mouse pointer</event>
            <event type="right-click" editmode="false">opens popup menu for filter type
            selection</event>
            <event type="drag" editmode="false">change frequency and Q/gain value</event>
            <event type="wheel" editmode="false">only for peakEq filter: change Q-factor</event>
        </mouse>
        <properties>
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_label.xml" />
            <xi:include href="props_label_align.xml" />
            <xi:include href="props_label_inner.xml" />
            <xi:include href="props_label_margins.xml" />
            <xi:include href="props_label_side.xml" />
            <xi:include href="props_label_valign.xml" />
            <xi:include href="props_pinned.xml" />
            <xi:include href="props_ui_receive.xml" />
            <xi:include href="props_ui_send.xml" />
            <xi:include href="props_preset.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" default="1000" minvalue="0" maxvalue="20000">
                <tr lang="en">filter frequency</tr>
            </property>
            <!-- @gain -->
            <property name="@gain" type="float" default="0" minvalue="-24" maxvalue="24"
            units="decibel">
                <tr lang="en">gain (for low/highshelf/peak filters)</tr>
            </property>
            <!-- @grid_color -->
            <property name="@grid_color" type="list" default="0.6 0.6 0.6 1">
                <tr lang="en">knob color</tr>
            </property>
            <!-- @knob_color -->
            <property name="@knob_color" type="list" default="0 0.75 1 1">
                <tr lang="en">knob color</tr>
            </property>
            <!-- @label_color -->
            <property name="@label_color" type="list" default="0.6 0.6 0.6 1">
                <tr lang="en">label color in RGB format within 0-1 range, for example: 0.2 0.4
                0.1</tr>
            </property>
            <!-- @mouse_events -->
            <property name="@mouse_events" type="bool" default="0">
                <tr lang="en">mouse events output mode. If on outputs @mouse_down, @mouse_up and
                @mouse_drag events</tr>
            </property>
            <!-- @plot_color -->
            <property name="@plot_color" type="list" default="0 0 0 1">
                <tr lang="en">knob color</tr>
            </property>
            <!-- @q -->
            <property name="@q" type="float" default="0.7071" minvalue="0.0156" maxvalue="64">
                <tr lang="en">quality factor</tr>
            </property>
            <!-- @scale -->
            <property name="@scale" type="symbol" default="lin" enum="lin log rad">
                <tr lang="en">frequency scale</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="300 100">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
            <!-- @type -->
            <property name="@type" type="symbol" default="lpf"
            enum="lpf hpf bpf bpfq lowshelf highshelf peak notch">
                <tr lang="en">frequency scale</tr>
            </property>
        </properties>
        <methods>
            <!-- biquad -->
            <method name="biquad">
                <info>
                    <tr lang="en">set biquad coefficients (but not changes current filter
                    properties)</tr>
                </info>
                <param name="b0 b1 b2 a1 a2" type="list" required="true">
                    <tr lang="en">coefficients</tr>
                </param>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clears specified preset</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                </param>
            </method>
            <!-- dump -->
            <method name="dump">
                <info>
                    <tr lang="en">dumps all object info to Pd console window</tr>
                </info>
            </method>
            <!-- interp -->
            <method name="interp">
                <info>
                    <tr lang="en">for this object acts as *load*, no interpolation performed</tr>
                </info>
            </method>
            <!-- load -->
            <method name="load">
                <info>
                    <tr lang="en">loads specified preset</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                </param>
            </method>
            <!-- pos -->
            <method name="pos">
                <info>
                    <tr lang="en">set UI element position</tr>
                </info>
                <param name="X" type="float" required="true">
                    <tr lang="en">top left x-coord</tr>
                </param>
                <param name="Y" type="float" required="true">
                    <tr lang="en">top right y-coord</tr>
                </param>
            </method>
            <!-- store -->
            <method name="store">
                <info>
                    <tr lang="en">stores specified preset</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">control input</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">list: b0 b1 b2 a1 a2</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.tab lin log rad] [ui.tab lpf hpf bpf bpfq @size 160 15]
|                    |
[@scale $2(          [@type $2(
|                    |
[ui.filter           ]
|
|
|
|
|
|
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
