<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.sum">
        <title>list.sum</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">calculates the sum of the elements in the list</tr>
                <tr lang="ru">вычисляет сумму элементов в списке</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list sum</keywords>
            <since>0.1</since>
            <also>
                <see>list.product</see>
                <see>list.reduce</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list. Non float values are ignored</tr>
                    <!-- old: Список входов. Неподвижные значения
                    игнорируются -->
                    <tr lang="ru" finished="false">Список входов. Неподвижные значения
                    игнорируются</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                    <tr lang="ru" finished="false">входной млечный</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">float list sum</tr>
                    <tr lang="ru" finished="false">сумма листа</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 a b -1.1( [list a b c(
|                |
[list.sum        ]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
