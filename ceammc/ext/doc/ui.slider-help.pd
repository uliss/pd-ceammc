#X msg 110 873 @active_scale;
#X text 245 873 Get/Set if should draw active scale. Type: bool. Default
value: 0\.;
#X msg 110 915 @max;
#X text 245 915 Get/Set maximum slider value. Type: float. Default
value: 1\.;
#X msg 110 945 @min;
#X text 245 945 Get/Set minimum slider value. Type: float. Default
value: 0\.;
#X msg 110 975 @mode;
#X text 245 975 Get/Set relative mode. Do not jump on click to value.
