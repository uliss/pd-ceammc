#X msg 110 1242 @value;
#X text 245 1242 Get/Set current value. Type: float. Default value:
0\.;
#X msg 110 1272 @value_pos;
#X text 245 1272 Get/Set value position. Type: symbol. Default value:
center. Allowed values: left \, center \, right.;
#X msg 110 1314 @value_precision;
#X text 245 1314 Get/Set number of digits shown after decimal point.
Type: int. Default value: 2\. Range: 0\...7\.;
#X msg 110 1356 @midi_channel;
#X text 245 1356 Get/Set MIDI channel binding. If set to 0 \, it binds
to all channels. The values in the range [1\..16] are mapped to the
channels of the first Pd MIDI device \, [17\..32] to the channels of
the second \, and so on. Type: int. Default value: 0\. Range: 0\...255\.;
#X msg 110 1459 @midi_control;
#X text 245 1459 Get/Set binded MIDI controller number. -1 means not
binded to any controller. Type: int. Default value: -1\. Range: -1\...127\.;
#X msg 110 1516 @midi_pickup;
#X text 245 1516 Get/Set pickup current value. If slider is binded
to value \, first time you should pass over this value to make binding.
It prevents from sudden value change on first control change. Type:
bool. Default value: 1\.;
