#X msg 130 805 @active_scale;
#X text 270 805 Get/Set if should draw active scale. Type: bool. Default
value: 0\.;
#X msg 130 847 @max;
#X text 270 847 Get/Set maximum slider value. Type: float. Default
value: 1\.;
#X msg 130 877 @min;
#X text 270 877 Get/Set minimum slider value. Type: float. Default
value: 0\.;
#X msg 130 907 @mode;
#X text 270 907 Get/Set relative mode. Do not jump on click to value.
Type: bool. Default value: 0\.;
#X msg 130 949 @mouse_events;
#X text 270 949 Get/Set mouse events output mode. If on outputs @mouse_down
\, @mouse_up and @mouse_drag events. Type: bool. Default value: 0\.;
#X msg 130 1006 @receive;
#X text 270 1006 Get/Set source of message receive. Type: symbol. Default
value: (null).;
#X msg 130 1048 @scale;
#X text 270 1048 Get/Set scale mode. Linear or logarithmic. Type: symbol.
Default value: linear. Allowed values: linear \, log.;
#X msg 130 1090 @send;
#X text 270 1090 Get/Set address for sending messages. Type: symbol.
Default value: (null).;
#X msg 130 1132 @show_value;
#X text 270 1132 Get/Set show value (in horizontal mode only). Type:
bool. Default value: 0\.;
#X msg 130 1174 @value;
#X text 270 1174 Get/Set current value. Type: float. Default value:
0\.;
#X msg 130 1204 @value_pos;
#X text 270 1204 Get/Set value position. Type: symbol. Default value:
center. Allowed values: left \, center \, right.;
#X msg 130 1246 @value_precision;
#X text 270 1246 Get/Set number of digits shown after decimal point.
Type: int. Default value: 2\. Range: 0\...7\.;
#X msg 130 1288 @midi_channel;
#X text 270 1288 Get/Set MIDI channel binding. If set to 0 \, it binds
to all channels. The values in the range [1\..16] are mapped to the
channels of the first Pd MIDI device \, [17\..32] to the channels of
the second \, and so on. Type: int. Default value: 0\. Range: 0\...255\.;
#X msg 130 1391 @midi_control;
#X text 270 1391 Get/Set binded MIDI controller number. -1 means not
binded to any controller. Type: int. Default value: -1\. Range: -1\...127\.;
#X msg 130 1448 @midi_pickup;
#X text 270 1448 Get/Set pickup current value. If slider is binded
to value \, first time you should pass over this value to make binding.
It prevents from sudden value change on first control change. Type:
bool. Default value: 1\.;
#X msg 130 1535 @background_color;
#X text 270 1535 Get/Set element background color (list of red \, green
