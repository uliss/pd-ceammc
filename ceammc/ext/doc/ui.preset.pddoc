<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="ui.preset" type="gui">
        <title>ui.preset</title>
        <meta>
            <authors>
                <author>Pierre Guillot</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">preset manager</tr>
                <tr lang="ru">менеджер пресетов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui preset</keywords>
            <since>0.1</since>
            <also>
                <see>preset.float</see>
                <see>preset.storage</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Saves presets value of UI objects that have @presetname property. Can
                handle UI objects only on the save canvas, no subpatches or abstractions are
                supported.</tr>
                <tr lang="ru" finished="false">Сохраняет предустановленную ценность объектов
                пользовательского интерфейса, которые имеют свойство @presetname. Может
                обрабатывать объекты пользовательского интерфейса только на холсте сохранения,
                никакие подпатчи или абстракции не поддерживаются.</tr>
            </par>
            <par>
                <tr lang="en">NOTE: if no UI widgets with @presetname on canvas - *Shift-click* is
                disabled.</tr>
                <tr lang="ru" finished="false">Примечание: если на холсте нет виджетов
                пользовательского интерфейса с @presetname - *Shift-click* отключен.</tr>
            </par>
            <par>
                <tr lang="en">Active slot is highlighted, available slots are dark gray</tr>
                <tr lang="ru" finished="false">Активный слот выделен, доступные слоты
                темно-серые</tr>
            </par>
        </info>
        <mouse>
            <event type="move" editmode="false">highlight the slot under the cursor</event>
            <event type="left-click" editmode="false">select preset slot under the cursor</event>
            <event type="left-click" editmode="false" keys="Shift">saves current settings to
            specified preset slot</event>
            <event type="left-click" editmode="false" keys="Alt">clear all values from specified
            preset slot</event>
            <event type="right-click" editmode="false">opens popup menu with read/write/duplicate
            actions</event>
        </mouse>
        <properties>
            <xi:include href="props_active_color.xml"/>
            <xi:include href="props_background_color.xml"/>
            <xi:include href="props_border_color.xml"/>
            <xi:include href="props_fontname.xml"/>
            <xi:include href="props_fontsize.xml"/>
            <xi:include href="props_fontslant.xml"/>
            <xi:include href="props_fontweight.xml"/>
            <xi:include href="props_pinned.xml"/>
            <xi:include href="props_ui_receive.xml"/>
            <!-- @current -->
            <property name="@current" type="int" default="-1" access="readonly">
                <tr lang="en">current preset index</tr>
                <tr lang="ru" finished="false">Текущий предустановленный индекс</tr>
            </property>
            <!-- @empty_color -->
            <property name="@empty_color" type="list" default="0.86 0.86 0.86 1">
                <tr lang="en">empty cell color (list of red, green, blue values in 0-1 range)</tr>
                <tr lang="ru" finished="false">цвет пустых ячеек (список красных, зеленых, синих
                значений в диапазоне 0-1)</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="102 42">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
            <!-- @stored_color -->
            <property name="@stored_color" type="list" default="0.5 0.5 0.5 1">
                <tr lang="en">stored cell color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @text_color -->
            <property name="@text_color" type="list" default="0 0 0 1">
                <tr lang="en">text color (list of red, green, blue values in 0-1 range)</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clear specified preset</tr>
                    <tr lang="ru" finished="false">четкая заданная предустановка</tr>
                </info>
                <param name="IDX" type="int" required="true" minvalue="0">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
            <!-- clearall -->
            <method name="clearall">
                <info>
                    <tr lang="en">clear all existing presets</tr>
                    <tr lang="ru" finished="false">очистить все существующие предустановки</tr>
                </info>
            </method>
            <!-- duplicate -->
            <method name="duplicate">
                <info>
                    <tr lang="en">fill empty presets by coping exiting values</tr>
                    <tr lang="ru" finished="false">заполнять пустые предустановки, преодолевая
                    значения выхода</tr>
                </info>
            </method>
            <!-- interp -->
            <method name="interp">
                <info>
                    <tr lang="en">loads linearry interpolated value between preset, for example:
                    1.5 means load interpolated value between preset 1 and 2.</tr>
                    <tr lang="ru" finished="false">линейная интерполированная величина нагрузки
                    между предустановленными, например: 1.5 означает интерполированную величину
                    нагрузки между предустановленными 1 и 2.</tr>
                </info>
                <param name="IDX" type="float" required="true">
                    <tr lang="en">preset interpolation index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс интерполяции</tr>
                </param>
            </method>
            <!-- load -->
            <method name="load">
                <info>
                    <tr lang="en">loads specified preset</tr>
                    <tr lang="ru" finished="false">заданный заранее заданный</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
            <!-- pos -->
            <method name="pos">
                <info>
                    <tr lang="en">set UI element position</tr>
                    <tr lang="ru" finished="false">Установите положение элемента UI</tr>
                </info>
                <param name="X" type="float" required="true">
                    <tr lang="en">top left x-coord</tr>
                    <tr lang="ru" finished="false">верхний левый x-coord</tr>
                </param>
                <param name="Y" type="float" required="true">
                    <tr lang="en">top right y-coord</tr>
                    <tr lang="ru" finished="false">верхняя правая y-coord</tr>
                </param>
            </method>
            <!-- read -->
            <method name="read">
                <info>
                    <tr lang="en">read presets from file</tr>
                    <tr lang="ru" finished="false">читать предустановки из файла</tr>
                </info>
                <param name="PATH" type="symbol" required="true">
                    <tr lang="en">path to preset file</tr>
                    <tr lang="ru" finished="false">Путь к предустановленному файлу</tr>
                </param>
            </method>
            <!-- store -->
            <method name="store">
                <info>
                    <tr lang="en">stores specified preset</tr>
                    <tr lang="ru" finished="false">магазины, указанные Preset</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
            <!-- write -->
            <method name="write">
                <info>
                    <tr lang="en">read presets from file</tr>
                    <tr lang="ru" finished="false">читать предустановки из файла</tr>
                </info>
                <param name="PATH" type="symbol" required="true">
                    <tr lang="en">path to preset file</tr>
                    <tr lang="ru" finished="false">Путь к предустановленному файлу</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet/>
        </inlets>
        <example>
            <pdascii>
<![CDATA[
[ui.radio @presetname P-radio]   [ui.sliders @presetname P-sliders]


[ui.toggle @presetname=P-toggle]


[ui.rslider @presetname P-rslider]

[F]
|
[load $1(                 [ui.hsl @min 0 @max 2 @show_value 1]
|                         |
| [clear 1(   [clearall(  [interp $1 #a(
| |           |
| | [store 1( | [loadmsg read %CEAMMC%/prs.txt]
| | |         | |
| | |         | [expand_env]
| | |         | |
[ui.preset    #z]
[X a->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
