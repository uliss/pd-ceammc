<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.preset" type="gui">
    <title>ui.preset</title>
    <meta>
      <authors>
        <author>Pierre Guillot</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">preset manager</tr>
        <tr lang="ru">менеджер пресетов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui preset</keywords>
      <since>0.1</since>
      <also>
        <see>preset.float</see>
        <see>preset.storage</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">saves the values of UI objects that have the @presetname property</tr>
        <tr lang="ru">сохраняет значения UI-объектов, у которых есть свойство @presetname</tr>
      </par>
      <par>
        <tr lang="en">note: if there are no UI widgets with @presetname on the canvas, Shift-click is disabled</tr>
        <tr lang="ru">примечание: если на холсте нет UI-виджетов со свойством @presetname, Shift-клик отключён</tr>
      </par>
      <par>
        <tr lang="en">the active slot is highlighted, available slots are dark gray</tr>
        <tr lang="ru">активный слот выделен, доступные слоты — тёмно-серые</tr>
      </par>
    </info>
    <mouse>
      <event type="move" editmode="false">highlight the slot under the cursor</event>
      <event type="left-click" editmode="false">select preset slot under the cursor</event>
      <event type="left-click" editmode="false" keys="Shift">saves current settings to specified
      preset slot</event>
      <event type="left-click" editmode="false" keys="Alt">clear all values from specified preset
      slot</event>
      <event type="right-click" editmode="false">opens popup menu with read/write/duplicate
      actions</event>
    </mouse>
    <properties>
      <xi:include href="props_active_color.xml" />
      <xi:include href="props_background_color.xml" />
      <xi:include href="props_border_color.xml" />
      <xi:include href="props_fontname.xml" />
      <xi:include href="props_fontsize.xml" />
      <xi:include href="props_fontslant.xml" />
      <xi:include href="props_fontweight.xml" />
      <xi:include href="props_pinned.xml" />
      <xi:include href="props_ui_receive.xml" />
      <!-- @current -->
      <property name="@current" type="int" default="-1" access="readonly">
        <tr lang="en">current preset index</tr>
        <tr lang="ru">текущий индекс пресета</tr>
      </property>
      <!-- @empty_color -->
      <property name="@empty_color" type="list" default="0.86 0.86 0.86 1">
        <tr lang="en">empty cell color (list of red, green, blue values in 0–1 range)</tr>
        <tr lang="ru">цвет пустых ячеек (список значений красного, зелёного, синего в диапазоне 0–1)</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="102 42">
        <tr lang="en">object size (width, height pair)</tr>
        <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
      </property>
      <!-- @stored_color -->
      <property name="@stored_color" type="list" default="0.5 0.5 0.5 1">
        <tr lang="en">stored cell color (list of red, green, blue values in 0–1 range)</tr>
        <tr lang="ru">цвет сохранённых ячеек (список значений красного, зелёного, синего в диапазоне 0–1)</tr>
      </property>
      <!-- @text_color -->
      <property name="@text_color" type="list" default="0 0 0 1">
        <tr lang="en">text color (list of red, green, blue values in 0–1 range)</tr>
        <tr lang="ru">цвет текста (список значений красного, зелёного, синего в диапазоне 0–1)</tr>
      </property>
    </properties>
    <methods>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clears the specified preset</tr>
          <tr lang="ru">очищает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true" minvalue="0">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- clearall -->
      <method name="clearall">
        <info>
          <tr lang="en">clears all existing presets</tr>
          <tr lang="ru">очищает все существующие пресеты</tr>
        </info>
      </method>
      <!-- duplicate -->
      <method name="duplicate">
        <info>
          <tr lang="en">fills empty presets by copying existing values</tr>
          <tr lang="ru">заполняет пустые пресеты, копируя существующие значения</tr>
        </info>
      </method>
      <!-- interp -->
      <method name="interp">
        <info>
          <tr lang="en">loads a linearly interpolated value between presets, for example 1.5 loads the interpolated value between preset 1 and preset 2</tr>
          <tr lang="ru">загружает линейно интерполированное значение между пресетами, например 1.5 загружает интерполированное значение между пресетами 1 и 2</tr>
        </info>
        <param name="IDX" type="float" required="true">
          <tr lang="en">preset interpolation index</tr>
          <tr lang="ru">индекс интерполяции пресета</tr>
        </param>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">loads the specified preset</tr>
          <tr lang="ru">загружает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set UI element position</tr>
          <tr lang="ru">задать положение элемента UI</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top left x-coord</tr>
          <tr lang="ru">x-координата верхнего левого угла</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top right y-coord</tr>
          <tr lang="ru">y-координата верхнего левого угла</tr>
        </param>
      </method>
      <!-- read -->
      <method name="read">
        <info>
          <tr lang="en">read presets from a file</tr>
          <tr lang="ru">читает пресеты из файла</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">path to the preset file</tr>
          <tr lang="ru">путь к файлу пресетов</tr>
        </param>
      </method>
      <!-- store -->
      <method name="store">
        <info>
          <tr lang="en">stores the specified preset</tr>
          <tr lang="ru">сохраняет указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- write -->
      <method name="write">
        <info>
          <tr lang="en">writes presets to a file</tr>
          <tr lang="ru">записывает пресеты в файл</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">path to the preset file</tr>
          <tr lang="ru">путь к файлу пресетов</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet />
    </inlets>
    <example>
      <pdascii>
<![CDATA[
[ui.radio @presetname P-radio]   [ui.sliders @presetname P-sliders]


[ui.toggle @presetname=P-toggle]


[ui.rslider @presetname P-rslider]

[F]
|
[load $1(                 [ui.hsl @min 0 @max 2 @show_value 1]
|                         |
| [clear 1(   [clearall(  [interp $1 #a(
| |           |
| | [store 1( | [loadmsg read %CEAMMC%/prs.txt]
| | |         | |
| | |         | [expand_env]
| | |         | |
[ui.preset    #z]
[X a->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
