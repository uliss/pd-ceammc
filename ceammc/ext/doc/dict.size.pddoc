<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="dict.size">
    <title>dict.size</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">output the dictionary size (number of key/value pairs)</tr>
        <tr lang="ru">выводит размер словаря (число пар ключ/значение)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>size dictionary</keywords>
      <since>0.6</since>
      <also>
        <see>data.dict</see>
        <see>dict.keys</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes a dictionary on its inlet and outputs a single integer — the
        total number of key/value pairs stored in it.</tr>
        <tr lang="ru">Объект принимает словарь на вход и выводит одно целое число — общее количество
        пар ключ/значение, хранящихся в нём.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="data:dict">
          <tr lang="en">dictionary to measure. On receipt, the
          object immediately outputs its size</tr>
          <tr lang="ru">словарь, размер которого нужно измерить. При
          получении объект сразу выводит его размер</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">size of dict</tr>
          <tr lang="ru">размер словаря</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]         [B]
|           |
[data.dict] [data.dict \[a: b c: 200 12: 15151\]]
|           |
[dict.size  ]
|
[ui.display @display_type 1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
