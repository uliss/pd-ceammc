<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="dict.size">
        <title>dict.size</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">output the dictionary size (number of key/value pairs)</tr>
                <tr lang="ru">выводит размер словаря (число пар ключ/значение)</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>size dictionary</keywords>
            <since>0.6</since>
            <also>
                <see>data.dict</see>
                <see>dict.keys</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <in on="data">
                    <tr lang="en">data.dict</tr>
                    <tr lang="ru" finished="false">data.dict.</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">size of dict</tr>
                    <tr lang="ru" finished="false">размер дикта</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]         [B]
|           |
[data.dict] [data.dict \[a: b c: 200 12: 15151\]]
|           |
[dict.size  ]
|
[ui.display @display_type 1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
