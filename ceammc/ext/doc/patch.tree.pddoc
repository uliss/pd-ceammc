<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="patch.tree">
        <title>patch.tree</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">output the object tree of the patch</tr>
                <tr lang="ru">выводит дерево объектов патча</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>patch</category>
            <keywords>patch tree</keywords>
            <since>0.9.1</since>
            <also>
                <see>patch.deps</see>
            </also>
        </meta>
        <inlets>
            <inlet type="control">
                <xinfo on="bang">output current patch tree as Dict</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="control">patch tree as Dict</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(
|
[patch.tree]
|
[print TREE]

[patch.tree-abs1]
]]>
            </pdascii>
            <pdascii id="abs1">
<![CDATA[
[patch.tree-abs2]

[bang(
|
[patch.tree]
|
[ui.dt]
]]>
            </pdascii>
            <pdascii id="abs2">
<![CDATA[
[hsl]
|
[F]
|
[ui.hsl]

[bang(
|
[patch.tree]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
