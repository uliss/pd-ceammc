<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="lfo.impulse~">
        <title>lfo.impulse~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">unit-amplitude low-frequency impulse train</tr>
                <tr lang="ru">низкочастотный импульсный осциллятор единичной амплитуды</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>lfo</category>
            <keywords>lfo oscillator</keywords>
            <since>0.1</since>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="0" maxvalue="1000">
                <tr lang="en">frequency</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1">on/off dsp processing</property>
            <!-- @freq -->
            <property name="@freq" type="float" default="0" minvalue="0" maxvalue="1000"
            units="hertz">initial frequency</property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo on="float">frequency in Hz</xinfo>
            </inlet>
            <inlet type="control">
                <xinfo on="bang">reset phase</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]                 [ui.dsp~]
|
[lfo.impulse~ 401]
|
[ui.scope~ @size=300x100]







[lfo.impulse~-sound]
]]>
            </pdascii>
            <pdascii id="sound">
<![CDATA[
[F]                [ui.dsp~]
|
[lfo.impulse~ 8]
|
[ui.hgain~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
