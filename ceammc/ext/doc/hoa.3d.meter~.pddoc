<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hoa.3d.meter~" type="gui">
    <title>hoa.3d.meter~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
        <author>Pierre Guillot</author>
        <author>Eliott Paris</author>
        <author>Thomas Le Meur</author>
      </authors>
      <description>
        <tr lang="en">multi spherical meter with sound field descriptor</tr>
        <tr lang="ru">трехмерный измеритель уровня звукового поля</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">spat</category>
      <keywords>hoa meter 3d</keywords>
      <since>0.9.7</since>
    </meta>
    <info>
      <par>
        <tr lang="en">displays the peak levels for a spherical array of loudspeakers. It computes
        and displays the energy and velocity vectors.</tr>
        <!-- old: отображает пиковые уровни для сферического массива
                громкоговорителей. Он вычисляет и отображает векторы энергии и скорости. -->
        <tr lang="ru" finished="false">отображает пиковые уровни для сферического массива
        громкоговорителей. Он вычисляет и отображает векторы энергии и скорости.</tr>
      </par>
      <a href="hoa/hoa.3d.meter~-help.pd">CICM documentation</a>
    </info>
    <mouse>
      <event type="right-click" editmode="false">open popup menu</event>
      <event type="right-click" editmode="false" keys="Shift">open object help</event>
      <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
      <event type="right-click" editmode="true" keys="Shift">open object help</event>
      <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
    </mouse>
    <properties>
      <!-- @angles -->
      <property name="@angles" type="list" default="0 90 0 -19.5 120 -19.5 240 -19.5">
        <tr lang="en">channel layout angles</tr>
        <tr lang="ru" finished="false">углы расположения канала</tr>
      </property>
      <!-- @background_color -->
      <property name="@background_color" type="list" default="0.93 0.93 0.93 1">
        <tr lang="en">element background color (list of red, green, blue values in 0-1 range)</tr>
        <!-- old: цвет фона элемента (список красных, зеленых, синих
                значений в диапазоне 0-1) -->
        <tr lang="ru" finished="false">цвет фона элемента (список красных, зеленых, синих значений
        в диапазоне 0-1)</tr>
      </property>
      <!-- @border_color -->
      <property name="@border_color" type="list" default="0.6 0.6 0.6 1">
        <tr lang="en">border color (list of red, green, blue values in 0-1 range)</tr>
        <!-- old: пограничный цвет (список красных, зеленых, синих
                значений в диапазоне 0-1) -->
        <tr lang="ru" finished="false">пограничный цвет (список красных, зеленых, синих значений в
        диапазоне 0-1)</tr>
      </property>
      <!-- @channels -->
      <property name="@channels" type="int" minvalue="1" maxvalue="64" default="4">
        <tr lang="en">number of input channels</tr>
        <tr lang="ru" finished="false">Количество входных каналов</tr>
      </property>
      <!-- @clockwise -->
      <property name="@clockwise" type="bool" default="0">
        <tr lang="en">clockwise channel numbering mode</tr>
        <tr lang="ru" finished="false">режим нумерации каналов по часовой стрелке</tr>
      </property>
      <!-- @cold_color -->
      <property name="@cold_color" type="list" default="0 0.6 0 0.8">
        <tr lang="en">color for &gt;=-39db.</tr>
        <tr lang="ru" finished="false">Цвет для &gt;=-39db.</tr>
      </property>
      <!-- @energy_color -->
      <property name="@energy_color" type="list" default="0 0 1 0.8">
        <tr lang="en">energy vector color</tr>
        <tr lang="ru" finished="false">Цвет энергетического вектора</tr>
      </property>
      <!-- @fontname -->
      <property name="@fontname" type="symbol" default="Helvetica"
      enum="Courier DejaVu Helvetica Monaco Times">
        <tr lang="en">fontname</tr>
        <tr lang="ru" finished="false">название шрифта</tr>
      </property>
      <!-- @fontsize -->
      <property name="@fontsize" type="int" minvalue="4" maxvalue="100" default="11">
        <tr lang="en">fontsize</tr>
        <tr lang="ru" finished="false">шрифт</tr>
      </property>
      <!-- @fontslant -->
      <property name="@fontslant" type="symbol" enum="roman italic" default="roman">
        <tr lang="en">font slant</tr>
        <tr lang="ru" finished="false">наклон шрифта</tr>
      </property>
      <!-- @fontweight -->
      <property name="@fontweight" type="symbol" enum="normal bold" default="normal">
        <tr lang="en">font weight</tr>
        <tr lang="ru" finished="false">вес шрифта</tr>
      </property>
      <!-- @hot_color -->
      <property name="@hot_color" type="list" default="1 0.6 0 0.8">
        <tr lang="en">color for &gt;=-12db.</tr>
        <tr lang="ru" finished="false">Цвет для &gt;=12db.</tr>
      </property>
      <!-- @interval -->
      <property name="@interval" type="int" units="millisecond" minvalue="20" maxvalue="1000"
      default="50">
        <tr lang="en">refresh interval</tr>
        <tr lang="ru" finished="false">интервал обновления</tr>
      </property>
      <!-- @label -->
      <property name="@label" type="symbol" default="(null)">
        <tr lang="en">label text</tr>
        <tr lang="ru" finished="false">текст этикетки</tr>
      </property>
      <!-- @label_align -->
      <property name="@label_align" type="symbol" enum="left center right" default="left">
        <tr lang="en">label horizontal align</tr>
        <tr lang="ru" finished="false">горизонтальная маркировка</tr>
      </property>
      <!-- @label_color -->
      <property name="@label_color" type="list" default="0 0 0 1">
        <tr lang="en">label color in RGB format within 0-1 range, for example: 0.2 0.4 0.1</tr>
        <!-- old: цвет этикетки в формате RGB в диапазоне 0-1,
                например: 0.2 0.4 0.1 -->
        <tr lang="ru" finished="false">цвет этикетки в формате RGB в диапазоне 0-1, например: 0.2
        0.4 0.1</tr>
      </property>
      <!-- @label_inner -->
      <property name="@label_inner" type="bool" default="0">
        <tr lang="en">label position (1 - inner, 0 - outer).</tr>
        <tr lang="ru" finished="false">положение метки (1 - внутреннее, 0 - наружное).</tr>
      </property>
      <!-- @label_margins -->
      <property name="@label_margins" type="list" default="0 0">
        <tr lang="en">label offset in pixels</tr>
        <tr lang="ru" finished="false">Смещение этикетки в пикселях</tr>
      </property>
      <!-- @label_side -->
      <property name="@label_side" type="symbol" enum="left top right bottom" default="top">
        <tr lang="en">label snap side</tr>
        <tr lang="ru" finished="false">маркировка snap side</tr>
      </property>
      <!-- @label_valign -->
      <property name="@label_valign" type="symbol" enum="top center bottom" default="top">
        <tr lang="en">label vertical align</tr>
        <tr lang="ru" finished="false">вертикальное обозначение</tr>
      </property>
      <!-- @offset -->
      <property name="@offset" type="list" default="0 0 0">
        <tr lang="en">channel numbering offset for each axes</tr>
        <tr lang="ru" finished="false">Смещение нумерации каналов для каждой оси</tr>
      </property>
      <!-- @over_color -->
      <property name="@over_color" type="list" default="1 0 0 0.8">
        <tr lang="en">peak overload color</tr>
        <tr lang="ru" finished="false">Цвет пиковой перегрузки</tr>
      </property>
      <!-- @pinned -->
      <property name="@pinned" type="bool" default="0">
        <tr lang="en">pin mode. if 1 - put element to the lowest level</tr>
        <!-- old: Режим пин. если 1 - поставить элемент на самый
                низкий уровень -->
        <tr lang="ru" finished="false">Режим пин. если 1 - поставить элемент на самый низкий
        уровень</tr>
      </property>
      <!-- @receive -->
      <property name="@receive" type="symbol" default="(null)">
        <tr lang="en">receive source</tr>
        <tr lang="ru" finished="false">источник получения</tr>
      </property>
      <!-- @send -->
      <property name="@send" type="symbol" default="(null)">
        <tr lang="en">send destination</tr>
        <tr lang="ru" finished="false">Отправить пункт назначения</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="225 225">
        <tr lang="en">element size (width, height pair)</tr>
        <tr lang="ru" finished="false">Размер элемента (ширина, пара высоты)</tr>
      </property>
      <!-- @tepid_color -->
      <property name="@tepid_color" type="list" default="0.6 0.73 0 0.8">
        <tr lang="en">color for &gt;=-30db.</tr>
        <tr lang="ru" finished="false">Цвет для &gt;=-30db.</tr>
      </property>
      <!-- @vectors -->
      <property name="@vectors" type="symbol" default="energy" enum="both energy none velocity">
        <tr lang="en">vector display mode</tr>
        <tr lang="ru" finished="false">режим векторного отображения</tr>
      </property>
      <!-- @velocity_color -->
      <property name="@velocity_color" type="list" default="1 0 0 0.8">
        <tr lang="en">velocity vector</tr>
        <tr lang="ru" finished="false">вектор скорости</tr>
      </property>
      <!-- @view -->
      <property name="@view" type="symbol" default="top"
      enum="bottom top topnextbottom toponbottom">
        <tr lang="en">view mode</tr>
        <tr lang="ru" finished="false">режим просмотра</tr>
      </property>
      <!-- @warm_color -->
      <property name="@warm_color" type="list" default="0.85 0.85 0 0.8">
        <tr lang="en">color for &gt;=-21db.</tr>
        <tr lang="ru" finished="false">Цвет для &gt;=-21db.</tr>
      </property>
    </properties>
    <methods>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set UI element position</tr>
          <tr lang="ru" finished="false">Установите положение элемента UI</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top left x-coord</tr>
          <tr lang="ru" finished="false">верхний левый x-coord</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top right y-coord</tr>
          <tr lang="ru" finished="false">верхняя правая y-coord</tr>
        </param>
      </method>
    </methods>
    <inlets dynamic="true">
      <inlet type="audio">
        <in>
          <tr lang="en">first source input</tr>
          <tr lang="ru" finished="false">Первый источник ввода</tr>
        </in>
        <in on="list">
          <tr lang="en">SRC_IDX polar RADIUS AZIMUTH ELEVATION or SRC_IDX mute VALUE</tr>
          <!-- old: SRC_IDX Polar RADIUS AZIMUTH ELEVATION или
                    SRC_IDX mute VALUE -->
          <tr lang="ru" finished="false">SRC_IDX Polar RADIUS AZIMUTH ELEVATION или SRC_IDX mute
          VALUE</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... source input</tr>
          <tr lang="ru" finished="false">Источник ввода</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">n-th source input</tr>
          <tr lang="ru" finished="false">n-й исходный ввод</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet type="audio">
        <out type="any">
          <tr lang="en">first harmonic output</tr>
          <tr lang="ru" finished="false">Первый гармонический выход</tr>
        </out>
      </outlet>
      <outlet type="audio" number="...">
        <out type="any">
          <tr lang="en">... harmonic output</tr>
          <tr lang="ru" finished="false">Гармонический выход</tr>
        </out>
      </outlet>
      <outlet type="audio" number="n">
        <out type="any">
          <tr lang="en">n-th harmonic output</tr>
          <tr lang="ru" finished="false">n-й гармонический выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[hoa.3d.meter~ @view topnextbottom]




/*hide*/
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
