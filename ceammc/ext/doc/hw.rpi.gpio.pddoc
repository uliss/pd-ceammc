<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.gpio">
    <title>hw.rpi.gpio</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">GPIO control for Raspberry Pi</tr>
        <tr lang="ru">управление GPIO на Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>display gpio raspberry</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par style="important">
        <tr lang="en">GPIO pins are taken into exclusive ownership: only one entity can read or set
        the value of a pin. Send the [release( message to relinquish ownership of the pin.</tr>
        <tr lang="ru">Контакты GPIO забираются в эксклюзивное владение: только один объект может
        читать или устанавливать значение на контакте. Отправляйте сообщение [release(, чтобы отказаться от
        владения контактом.</tr>
      </par>
      <par style="info">
        <tr lang="en">That is, you can create any number of [hw.rpi.gpio] objects, but access to a
        specific pin will be available only to one of them (the first one that captured
        this pin).</tr>
        <tr lang="ru">То есть вы можете создавать любое количество объектов [hw.rpi.gpio], но
        доступ к определённому контакту будет только у одного из них (первого, который
        захватил этот контакт).</tr>
      </par>
    </info>
    <methods>
      <!-- clear_pwm -->
      <method name="clear_pwm">
        <info>
          <tr lang="en">clear PWM settings for a GPIO pin</tr>
          <tr lang="ru">сбросить настройки ШИМ для контакта GPIO</tr>
        </info>
        <param name="PIN" type="int" required="true">
          <tr lang="en">GPIO pin number</tr>
          <tr lang="ru">номер контакта GPIO</tr>
        </param>
      </method>
      <!-- impulse -->
      <method name="impulse">
        <info>
          <tr lang="en">send a single pulse of the specified duration</tr>
          <tr lang="ru">отправить одиночный импульс указанной длительности</tr>
        </info>
        <param name="LENGTH" type="int" required="true" minvalue="0.001" maxvalue="100"
        units="millisecond">
          <tr lang="en">pulse length</tr>
          <tr lang="ru">длина импульса</tr>
        </param>
      </method>
      <!-- input -->
      <method name="input">
        <info>
          <tr lang="en">set the GPIO pin to input mode</tr>
          <tr lang="ru">установить контакт GPIO в режим ввода</tr>
        </info>
        <param name="PIN" type="int" required="true">
          <tr lang="en">GPIO pin number</tr>
          <tr lang="ru">номер контакта GPIO</tr>
        </param>
      </method>
      <!-- output -->
      <method name="output">
        <info>
          <tr lang="en">set the GPIO pin to output mode</tr>
          <tr lang="ru">установить контакт GPIO в режим вывода</tr>
        </info>
        <param name="PIN" type="int" required="true">
          <tr lang="en">GPIO pin number</tr>
          <tr lang="ru">номер контакта GPIO</tr>
        </param>
      </method>
      <!-- poll -->
      <method name="poll">
        <info>
          <tr lang="en">enable/disable GPIO pin value monitoring</tr>
          <tr lang="ru">включить/выключить отслеживание значения контакта GPIO</tr>
        </info>
        <param name="PIN" type="int" required="true">
          <tr lang="en">GPIO pin number</tr>
          <tr lang="ru">номер контакта GPIO</tr>
        </param>
        <param name="STATE" type="bool" required="true">
          <tr lang="en">poll state: 1 = enable, 0 = disable</tr>
          <tr lang="ru">состояние мониторинга: 1 — включить, 0 — выключить</tr>
        </param>
        <param name="DEBOUNCE" type="float" minvalue="0" default="10" units="millisecond">
          <tr lang="en">debounce time</tr>
          <tr lang="ru">время подавления дребезга</tr>
        </param>
      </method>
      <!-- pull_down -->
      <method name="pull_down">
        <info>
          <tr lang="en">pull the internal pin resistors to a low level</tr>
          <tr lang="ru">подтянуть внутренние резисторы пина к низкому уровню</tr>
        </info>
        <param name="PIN" type="int" required="true">
          <tr lang="en">GPIO pin number</tr>
          <tr lang="ru">номер контакта GPIO</tr>
        </param>
      </method>
      <!-- pull_up -->
      <method name="pull_up">
        <info>
          <tr lang="en">pull the internal pin resistors to a high level</tr>
          <tr lang="ru">подтянуть внутренние резисторы пина к высокому уровню</tr>
        </info>
        <param name="PIN" type="int" required="true">
          <tr lang="en">GPIO pin number</tr>
          <tr lang="ru">номер контакта GPIO</tr>
        </param>
      </method>
      <!-- read -->
      <method name="read">
        <info>
          <tr lang="en">read the current value on the GPIO pin</tr>
          <tr lang="ru">прочитать текущее значение на контакте GPIO</tr>
        </info>
        <param name="PIN" type="int" required="true">
          <tr lang="en">GPIO pin number</tr>
          <tr lang="ru">номер контакта GPIO</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset the GPIO pin(s) to their initial state</tr>
          <tr lang="ru">сбросить контакт(ы) GPIO в начальное состояние</tr>
        </info>
        <param name="PIN" type="list" minvalue="1" maxvalue="16" required="true">
          <tr lang="en">GPIO pin number(s)</tr>
          <tr lang="ru">номер(а) контакта(ов) GPIO</tr>
        </param>
      </method>
      <!-- soft_pwm -->
      <method name="soft_pwm">
        <info>
          <tr lang="en">set the GPIO pin to software PWM mode</tr>
          <tr lang="ru">установить контакт GPIO в режим программной ШИМ</tr>
        </info>
        <param name="PIN" type="int" required="true">
          <tr lang="en">GPIO pin number</tr>
          <tr lang="ru">номер контакта GPIO</tr>
        </param>
        <param name="PERIOD" type="float" units="msec" minvalue="0" required="true">
          <tr lang="en">full period length</tr>
          <tr lang="ru">длина полного периода</tr>
        </param>
        <param name="DUTY" type="float" units="msec" minvalue="0" required="true">
          <tr lang="en">duty cycle length</tr>
          <tr lang="ru">длительность рабочего цикла</tr>
        </param>
      </method>
      <!-- soft_pwm_freq -->
      <method name="soft_pwm_freq">
        <info>
          <tr lang="en">set software PWM frequency for a GPIO pin</tr>
          <tr lang="ru">установить частоту программной ШИМ для контакта GPIO</tr>
        </info>
        <param name="PIN" type="int" required="true">
          <tr lang="en">GPIO pin number</tr>
          <tr lang="ru">номер контакта GPIO</tr>
        </param>
        <param name="FREQ" type="float" units="hertz" minvalue="0" required="true">
          <tr lang="en">frequency</tr>
          <tr lang="ru">частота</tr>
        </param>
        <param name="DUTY" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">duty cycle (0..1)</tr>
          <tr lang="ru">рабочий цикл (0..1)</tr>
        </param>
      </method>
      <!-- toggle -->
      <method name="toggle">
        <info>
          <tr lang="en">toggle the GPIO pin output value</tr>
          <tr lang="ru">переключить выходное значение контакта GPIO</tr>
        </info>
        <param name="PIN" type="int" required="true">
          <tr lang="en">GPIO pin number</tr>
          <tr lang="ru">номер контакта GPIO</tr>
        </param>
      </method>
      <!-- used_pins -->
      <method name="used_pins">
        <info>
          <tr lang="en">display a list of used GPIO pins. Sends a message in the format: [pins
          PIN ...( to the first outlet.</tr>
          <tr lang="ru">выводит список используемых контактов GPIO. Отправляет сообщение в
          формате: [pins КОНТАКТ ...( на первый выход.</tr>
        </info>
      </method>
      <!-- write -->
      <method name="write">
        <info>
          <tr lang="en">set a value on a GPIO pin</tr>
          <tr lang="ru">установить значение на контакте GPIO</tr>
        </info>
        <param name="PIN" type="int" required="true">
          <tr lang="en">GPIO pin number</tr>
          <tr lang="ru">номер контакта GPIO</tr>
        </param>
        <param name="VALUE" type="bool" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control message input</tr>
          <tr lang="ru">вход для управляющих сообщений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out name="pin" type="any">
          <tr lang="en">pin state: [pin PIN STATE(</tr>
          <tr lang="ru">состояние контакта: [pin КОНТАКТ СОСТОЯНИЕ(</tr>
        </out>
        <out name="pins" type="any">
          <tr lang="en">pin list: [pins PIN PIN ...(</tr>
          <tr lang="ru">список контактов: [pins КОНТАКТ КОНТАКТ ...(</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[loadbang]
|
[input 17, pull_up 17, output 18(
|
| [read 17 #a(        [T] [toggle 18 #f(
|                     |
| [T]                 [write 18 $1 #e(
| |
| [poll 17 $1 #c(     [read 18 #g(
|
| [reset 17 #d(       [soft_pwm 18 500 100 #j( [soft_pwm_freq 18 4 0.5 #k(
|
|                     [clear_pwm 18 #l(
|
|                     [reset 18 #h(
|
[hw.rpi.gpio #x]
|
[route pin]
|
[ui.dt]

[ui.link @url=ceammc://img/conn_gpio1.png @title='Connection_Scheme']

[ui.link @url=ceammc://hw.rpi.gpio-example.pd @title='GPIO_control']

[X a->x] [X b->x] [X c->x] [X d->x]
[X e->x] [X f->x] [X g->x] [X h->x]
[X j->x] [X k->x] [X l->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
