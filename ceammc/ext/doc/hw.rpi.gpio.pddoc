<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="hw.rpi.gpio">
        <title>hw.rpi.gpio</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">GPIO control for Raspberry Pi</tr>
                <tr lang="ru">управление GPIO на Raspberry Pi</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display gpio raspberry</keywords>
            <since>0.9.8</since>
        </meta>
        <methods>
            <!-- clear_pwm -->
            <method name="clear_pwm">
                <info>
                    <tr lang="en">clear PWM settings for pin</tr>
                    <tr lang="ru" finished="false">Чистые настройки PWM для pin</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
            </method>
            <!-- impulse -->
            <method name="impulse">
                <info>
                    <tr lang="en">send impulse of specified length</tr>
                    <tr lang="ru" finished="false">посылать импульс определенной длины</tr>
                </info>
                <param name="LENGTH" type="int" required="true" minvalue="0.001" maxvalue="100"
                units="millisecond">
                    <tr lang="en">impulse length</tr>
                    <tr lang="ru" finished="false">длина импульса</tr>
                </param>
            </method>
            <!-- input -->
            <method name="input">
                <info>
                    <tr lang="en">config pin into input mode</tr>
                    <tr lang="ru" finished="false">PIN-конфигурация в режиме ввода</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
            </method>
            <!-- output -->
            <method name="output">
                <info>
                    <tr lang="en">config pin into output mode</tr>
                    <tr lang="ru" finished="false">PIN-конфигурация в режиме вывода</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
            </method>
            <!-- poll -->
            <method name="poll">
                <info>
                    <tr lang="en">start/stop pin value polling</tr>
                    <tr lang="ru" finished="false">Start/Stop Pin Value</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
                <param name="STATE" type="bool" required="true">
                    <tr lang="en">poll state</tr>
                    <tr lang="ru" finished="false">государство</tr>
                </param>
                <param name="DEBOUNCE" type="float" minvalue="0" default="10" units="millisecond">
                    <tr lang="en">debounce time</tr>
                    <tr lang="ru" finished="false">время дезавуирования</tr>
                </param>
            </method>
            <!-- pull_down -->
            <method name="pull_down">
                <info>
                    <tr lang="en">pull internal pin resistors to low level</tr>
                    <!-- old: тянуть внутренние резисторы штифта на низкий
                    уровень -->
                    <tr lang="ru" finished="false">тянуть внутренние резисторы штифта на низкий
                    уровень</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
            </method>
            <!-- pull_up -->
            <method name="pull_up">
                <info>
                    <tr lang="en">pull internal pin resistors to high level</tr>
                    <!-- old: тянуть внутренние резисторы штифта на высокий
                    уровень -->
                    <tr lang="ru" finished="false">тянуть внутренние резисторы штифта на высокий
                    уровень</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
            </method>
            <!-- read -->
            <method name="read">
                <info>
                    <tr lang="en">read current pin value</tr>
                    <tr lang="ru" finished="false">читать текущее значение pin</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset current pin to initial state</tr>
                    <tr lang="ru" finished="false">Сброс текущего штифта в начальное состояние</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
            </method>
            <!-- soft_pwm -->
            <method name="soft_pwm">
                <info>
                    <tr lang="en">set software PWM for pin</tr>
                    <!-- old: установить программное обеспечение PWM для
                    pin -->
                    <tr lang="ru" finished="false">установить программное обеспечение PWM для
                    pin</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
                <param name="PERIOD" type="float" units="msec" minvalue="0" required="true">
                    <tr lang="en">period length</tr>
                    <tr lang="ru" finished="false">продолжительность периода</tr>
                </param>
                <param name="DUTY" type="float" units="msec" minvalue="0" required="true">
                    <tr lang="en">duty length</tr>
                    <tr lang="ru" finished="false">продолжительность службы</tr>
                </param>
            </method>
            <!-- soft_pwm_freq -->
            <method name="soft_pwm_freq">
                <info>
                    <tr lang="en">set software PWM frequency for pin</tr>
                    <tr lang="ru" finished="false">установить программную частоту PWM для pin</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
                <param name="FREQ" type="float" units="hertz" minvalue="0" required="true">
                    <tr lang="en">pwm freq</tr>
                    <tr lang="ru" finished="false">pwm freq</tr>
                </param>
                <param name="DUTY" type="float" minvalue="0" maxvalue="1" required="true">
                    <tr lang="en">duty cycle length</tr>
                    <tr lang="ru" finished="false">Продолжительность рабочего цикла</tr>
                </param>
            </method>
            <!-- toggle -->
            <method name="toggle">
                <info>
                    <tr lang="en">toggle output pin current value</tr>
                    <!-- old: Переключатель выходного штифта текущего
                    значения -->
                    <tr lang="ru" finished="false">Переключатель выходного штифта текущего
                    значения</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
            </method>
            <!-- used_pins -->
            <method name="used_pins">
                <info>
                    <tr lang="en">list used GPIO pins. Outputs [pins PIN...( message</tr>
                    <!-- old: Список использованных значков GPIO. Выходы [pins
                    PIN...(сообщение)] -->
                    <tr lang="ru" finished="false">Список использованных значков GPIO. Выходы [pins
                    PIN...(сообщение)]</tr>
                </info>
            </method>
            <!-- write -->
            <method name="write">
                <info>
                    <tr lang="en">write value to the pin</tr>
                    <tr lang="ru" finished="false">записывать значение в булавку</tr>
                </info>
                <param name="PIN" type="int" required="true">
                    <tr lang="en">pin number</tr>
                    <tr lang="ru" finished="false">пин-код</tr>
                </param>
                <param name="VALUE" type="bool" required="true">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in>
                    <tr lang="en">control input</tr>
                    <tr lang="ru" finished="false">контрольный вход</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">messages: [pin PIN STATE(, [pins PIN PIN...(</tr>
                    <tr lang="ru" finished="false">[pin PIN STATE, [pins PIN PIN...]]</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[loadbang]
|
[input 17, pull_up 17, output 18(
|
| [read 17 #a(        [T] [toggle 18 #f(
|                     |
| [T]                 [write 18 $1 #e(
| |
| [poll 17 $1 #c(     [read 18 #g(
|
| [reset 17 #d(       [soft_pwm 18 500 100 #j( [soft_pwm_freq 18 4 0.5 #k(
|
|                     [clear_pwm 18 #l(
|
|                     [reset 18 #h(
|
[hw.rpi.gpio #x]
|
[route pin]
|
[ui.dt]

[ui.link @url=ceammc://img/conn_gpio1.png @title='Connection_Scheme']

[ui.link @url=ceammc://hw.rpi.gpio-example.pd @title='GPIO_control']

[X a->x] [X b->x] [X c->x] [X d->x]
[X e->x] [X f->x] [X g->x] [X h->x]
[X j->x] [X k->x] [X l->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
