<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.char2morse">
    <title>conv.char2morse</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts the single character into the Morse code</tr>
        <tr lang="ru">преобразует единичный символ в код Морзе</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv char morse</keywords>
      <since>0.9.7</since>
      <also>
        <see>proto.morse</see>
      </also>
      <aliases>
        <alias>ceammc/char-&gt;morse</alias>
        <alias>char-&gt;morse</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Note: cyrillic utf-8 characters are also supported.</tr>
        <!-- old: Примечание: также поддерживаются кириллические
                символы utf-8. -->
        <tr lang="ru" finished="false">Примечание: также поддерживаются кириллические символы
        utf-8.</tr>
      </par>
    </info>
    <properties>
      <!-- @sym -->
      <property name="@sym" type="bool" default="0">
        <tr lang="en">symbol output mode. If 1: output as list of dots and dashes, otherwise as
        list of 0 and 1.</tr>
        <tr lang="ru">режим вывода символов. Если 1: выводит в виде списка точек и тире, в
        противном случае как список 0 и 1.</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">single character</tr>
          <tr lang="ru" finished="false">одиночный персонаж</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">list of 0 and 1 (or dots and dashes)</tr>
          <tr lang="ru" finished="false">Список 0 и 1 (или точек и тире)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[S digits=5] [T]
|            |
|            [@sym $1(
|            |
[conv.char2morse]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
