<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="conv.char2morse">
        <title>conv.char2morse</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">converts the single character into the Morse code</tr>
                <tr lang="ru">преобразует единичный символ в код Морзе</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv char morse</keywords>
            <since>0.9.7</since>
            <also>
                <see>proto.morse</see>
            </also>
            <aliases>
                <alias>ceammc/char-&gt;morse</alias>
                <alias>char-&gt;morse</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: cyrillic utf-8 characters are also supported.</tr>
            </par>
        </info>
        <properties>
            <!-- @sym -->
            <property name="@sym" type="bool" default="0">
                <tr lang="en">symbol output mode. If 1: output as list of dots and dashes,
                otherwise as list of 0 and 1.</tr>
                <tr lang="ru">режим вывода символов. Если 1: выводит в виде списка точек и тире, в
                противном случае как список 0 и 1.</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">single character</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list of 0 and 1 (or dots and dashes)</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[S digits=5] [T]
|            |
|            [@sym $1(
|            |
[conv.char2morse]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
