<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.char2morse">
    <title>conv.char2morse</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts the single character into the Morse code</tr>
        <tr lang="ru">преобразует один символ в код Морзе</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv char morse</keywords>
      <since>0.9.7</since>
      <also>
        <see>proto.morse</see>
      </also>
      <aliases>
        <alias>ceammc/char-&gt;morse</alias>
        <alias>char-&gt;morse</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts a single character into its Morse code representation. By
        default the output is a list of 0s and 1s, where 0 represents a dot and 1 represents a
        dash. With the @sym flag set, the output is a list of dots and dashes as symbols instead.
        Cyrillic UTF-8 characters are also supported.</tr>
        <tr lang="ru">Объект преобразует один символ в его представление в коде Морзе. По умолчанию
        вывод — это список из 0 и 1, где 0 обозначает точку, а 1 — тире. Если установлен флаг @sym,
        выводом становится список точек и тире в виде символов. Также поддерживаются кириллические
        символы в UTF-8.</tr>
      </par>
    </info>
    <properties>
      <!-- @sym -->
      <property name="@sym" type="bool" default="0">
        <tr lang="en">symbol output mode. If 1: output as a list of dots and dashes, otherwise as a
        list of 0 and 1</tr>
        <tr lang="ru">режим символьного вывода. Если 1: вывод в виде списка точек и тире, в
        противном случае — в виде списка 0 и 1</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">single character</tr>
          <tr lang="ru">один символ</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">list of 0 and 1 (or dots and dashes)</tr>
          <tr lang="ru">список из 0 и 1 (или точек и тире)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[S digits=5] [T]
|            |
|            [@sym $1(
|            |
[conv.char2morse]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
