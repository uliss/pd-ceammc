<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="system.memused">
        <title>system.memused</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs the process physical memory usage - current and peak</tr>
                <tr lang="ru">выводит использование физической памяти процессом - текущее и
                пиковое</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>system</category>
            <keywords>system memory</keywords>
            <also>
                <see>system.memsize</see>
            </also>
            <since>0.1</since>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">outputs memory use</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">current physical memory use measured in bytes, or zero if the
                    value cannot be determined on this OS.</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">peak (maximum so far) physical memory use measured in bytes, or
                    zero if the value cannot be determined on this OS.</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bng]
|
[system.memused]
|
|            /* in Kbytes */
[/ 1024               ]
|                     |
[floatatom digits=12] [floatatom digits=12]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
