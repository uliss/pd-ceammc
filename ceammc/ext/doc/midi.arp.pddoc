<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="midi.arp">
    <title>midi.arp</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">MIDI arpeggiator</tr>
        <tr lang="ru">MIDI арпеджиатор</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>midi</category>
      <keywords>midi arpeggiator</keywords>
      <since>0.9.6</since>
    </meta>
    <info>
      <par>
        <tr lang="en">'up' - play notes from bottom to up</tr>
        <tr lang="ru">«up» — играть ноты снизу вверх</tr>
      </par>
      <par>
        <tr lang="en">'down' - play from top to bottom</tr>
        <tr lang="ru">«down» — играть сверху вниз</tr>
      </par>
      <par>
        <tr lang="en">'tri' - play from bottom to up and then back</tr>
        <tr lang="ru">«tri» — играть снизу вверх, а затем обратно</tr>
      </par>
      <par>
        <tr lang="en">'up1' - play top note, then from bottom to up</tr>
        <tr lang="ru">«up1» — играть верхнюю ноту, затем снизу вверх</tr>
      </par>
      <par>
        <tr lang="en">'down1' - play bottom note, then from top to bottom</tr>
        <tr lang="ru">«down1» — играть нижнюю ноту, затем сверху вниз</tr>
      </par>
      <par>
        <tr lang="en">'tri1' - play from up to bottom, then back</tr>
        <tr lang="ru">«tri1» — играть сверху вниз, а затем обратно</tr>
      </par>
      <par>
        <tr lang="en">'random' - play random note, excluding the current one (no repeats)</tr>
        <tr lang="ru">«random» — играть случайную ноту, исключая текущую (без повторов)</tr>
      </par>
      <par>
        <tr lang="en">'random1' - play random note (there can be repeats)</tr>
        <tr lang="ru">«random1» — играть случайную ноту (возможны повторы)</tr>
      </par>
    </info>
    <arguments>
      <argument name="T" type="float" minvalue="1" maxvalue="1000" units="millisecond">
        <tr lang="en">time between arpeggio</tr>
        <tr lang="ru">время между нотами арпеджио</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @external -->
      <property name="@external" type="bool" default="0">
        <tr lang="en">use external clock</tr>
        <tr lang="ru">использовать внешний тактовый сигнал</tr>
      </property>
      <!-- @min_notes -->
      <property name="@min_notes" type="int" default="1" minvalue="1">
        <tr lang="en">number of minimal notes to perform arpeggio</tr>
        <tr lang="ru">минимальное количество нот для запуска арпеджио</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" default="up"
      enum="up down tri up1 down1 tri1 random random1">
        <tr lang="en">argpeggiator mode</tr>
        <tr lang="ru">режим арпеджиатора</tr>
      </property>
      <!-- @on -->
      <property name="@on" type="bool" default="1">
        <tr lang="en">arpeggiator state: on/off</tr>
        <tr lang="ru">состояние арпеджиатора: вкл/выкл</tr>
      </property>
      <!-- @pass -->
      <property name="@pass" type="bool" default="0">
        <tr lang="en">bypass arpeggiator</tr>
        <tr lang="ru">обход арпеджиатора (пропуск без обработки)</tr>
      </property>
      <!-- @seed -->
      <property name="@seed" type="int" default="0" minvalue="0">
        <tr lang="en">random seed value (to get reproducible random series)</tr>
        <tr lang="ru">начальное значение генератора случайных чисел (для воспроизводимых последовательностей)</tr>
      </property>
      <!-- @t -->
      <property name="@t" type="float" default="100" minvalue="1" maxvalue="1000"
      units="millisecond">
        <tr lang="en">time between arpeggio</tr>
        <tr lang="ru">время между нотами арпеджио</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">NOTE VELOCITY</tr>
          <tr lang="ru">НОТА СКОРОСТЬ</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">play next note in chord, if @external = 1</tr>
          <tr lang="ru">играть следующую ноту аккорда, если @external = 1</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">list: NOTE VELOCITY</tr>
          <tr lang="ru">список: НОТА СКОРОСТЬ</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">int: note index in chord</tr>
          <tr lang="ru">int: индекс ноты в аккорде</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[notein]       [ui.dsp~]
| ^|.
[pack f f]
|
[ui.keyboard]
|
|
|
|
|   [T]      [ui.tab up down tri up1 down1 tri1 random random1 @size 400 14]
|   |        |
|   [@on $1( [@mode $2( [F]     [1( [2( [3(
|   |        |          |       |   |   |
|   |        |          [@t $1( [@min_notes $1(
|   |        |          |       |
[midi.arp                       ]
|           ^|
[msg note]  [F]
|
[sfizz~ \#sine]
*|*
[ui.hgain2~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>