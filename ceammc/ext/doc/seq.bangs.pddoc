<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="seq.bangs">
    <title>seq.bangs</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">bang event sequencer</tr>
        <tr lang="ru">секвенсор событий bang</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>seq</category>
      <keywords>seq sequencer bang pattern rhythm</keywords>
      <since>0.9.1</since>
      <aliases>
        <alias>seq.b</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">A bang event sequencer: iterates over a list of durations and outputs a bang
        after each duration has elapsed. The pattern is given in beat duration units (relative to
        the beat time @t), and each value determines how many beats to wait before the next bang.
        Playback can be looped with @r, reversed with @mode dec or @mode tri, and subdivided with
        @div.</tr>
        <tr lang="ru">Секвенсор событий bang: перебирает список длительностей и выводит bang после
        истечения каждой из них. Паттерн задаётся в единицах длительности доли (относительно
        времени доли @t), и каждое значение определяет, сколько долей ждать до следующего bang.
        Воспроизведение можно зациклить через @r, обратить через @mode dec или @mode tri, и
        раздробить через @div.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Rhythmic triggers for drum synthesis — driving percussive voices or
        samplers with a precise rhythmic pattern, where each bang corresponds to a drum hit.</tr>
        <tr lang="ru">• Ритмические триггеры для синтеза барабанов — управление перкуссионными
        голосами или сэмплерами точным ритмическим паттерном, где каждый bang соответствует
        удару.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Algorithmic rhythm generation — combining different patterns, repeat counts
        and directions to build evolving rhythmic structures for generative music.</tr>
        <tr lang="ru">• Алгоритмическая генерация ритма — комбинирование разных паттернов, повторов
        и направлений для построения развивающихся ритмических структур в генеративной музыке.</tr>
      </par>
    </info>
    <arguments>
      <argument name="P" type="list">
        <tr lang="en">sequencer pattern in beat duration units</tr>
        <tr lang="ru">паттерн секвенсора в единицах длительности доли</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @div -->
      <property name="@div" type="int" minvalue="1" default="1" maxvalue="64">
        <tr lang="en">beat subdivision</tr>
        <tr lang="ru">дробление доли</tr>
      </property>
      <!-- @dur -->
      <property name="@dur" type="float" default="0" minvalue="0" units="millisecond">
        <tr lang="en">whole sequence duration (recalculates the @t property accordingly)</tr>
        <tr lang="ru">длительность всей последовательности (соответственно пересчитывает свойство
        @t)</tr>
      </property>
      <!-- @i -->
      <property name="@i" type="int" access="readonly" default="0">
        <tr lang="en">current sequence iteration</tr>
        <tr lang="ru">текущая итерация последовательности</tr>
      </property>
      <!-- @inf -->
      <property name="@inf" type="alias">
        <tr lang="en">alias for @r -1, repeats infinitely</tr>
        <tr lang="ru">сокращение для @r -1, повторяется бесконечно</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" enum="inc dec tri" default="inc">
        <tr lang="en">sequencer mode. 'inc' — from first to last, 'dec' — from last to first, 'tri'
        — from first to last, then back</tr>
        <tr lang="ru">режим секвенсора. 'inc' — от первого к последнему, 'dec' — от последнего к
        первому, 'tri' — от первого к последнему, затем обратно</tr>
      </property>
      <!-- @once -->
      <property name="@once" type="alias">
        <tr lang="en">alias for @r 1, play once</tr>
        <tr lang="ru">сокращение для @r 1, играть один раз</tr>
      </property>
      <!-- @p -->
      <property name="@p" type="list" default="">
        <tr lang="en">sequencer pattern in beat duration units</tr>
        <tr lang="ru">паттерн секвенсора в единицах длительности доли</tr>
      </property>
      <!-- @r -->
      <property name="@r" type="int" minvalue="-1" default="1">
        <tr lang="en">number of whole sequence repeats. If -1 — repeats infinitely</tr>
        <tr lang="ru">число повторов всей последовательности. Если -1 — повторяется бесконечно</tr>
      </property>
      <!-- @ri -->
      <property name="@ri" type="int" access="readonly" default="0">
        <tr lang="en">current repeat iteration</tr>
        <tr lang="ru">текущая итерация повтора</tr>
      </property>
      <!-- @t -->
      <property name="@t" type="float" default="100" minvalue="1" maxvalue="20000"
      units="millisecond">
        <tr lang="en">time between beats. Unit values like 100ms or 240bpm can also be used</tr>
        <tr lang="ru">время между долями. Можно также использовать значения с единицами, например
        100ms или 240bpm</tr>
      </property>
      <!-- @upbeat -->
      <property name="@upbeat" type="float" default="0" minvalue="0">
        <tr lang="en">wait the specified number of beats before the sequence starts</tr>
        <tr lang="ru">ждать заданное число долей перед запуском последовательности</tr>
      </property>
    </properties>
    <methods>
      <!-- hexbeat -->
      <method name="hexbeat">
        <info>
          <tr lang="en">sets a hexbeat bang pattern</tr>
          <tr lang="ru">устанавливает ритмический паттерн в hex-нотации</tr>
        </info>
        <param name="PATTERN" type="symbol" required="true">
          <tr lang="en">hex-string beat pattern</tr>
          <tr lang="ru">ритмический паттерн в виде hex-строки</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets all counters and stops</tr>
          <tr lang="ru">сбрасывает все счётчики и останавливает секвенсор</tr>
        </info>
      </method>
      <!-- rewind -->
      <method name="rewind">
        <info>
          <tr lang="en">resets all counters without stopping</tr>
          <tr lang="ru">сбрасывает все счётчики без остановки</tr>
        </info>
      </method>
      <!-- skip -->
      <method name="skip">
        <info>
          <tr lang="en">skips the specified number of steps</tr>
          <tr lang="ru">пропускает заданное число шагов</tr>
        </info>
        <param name="N" type="int" required="true">
          <tr lang="en">number of steps to skip</tr>
          <tr lang="ru">число шагов для пропуска</tr>
        </param>
      </method>
      <!-- start -->
      <method name="start">
        <info>
          <tr lang="en">starts the sequencer from the current position</tr>
          <tr lang="ru">запускает секвенсор с текущей позиции</tr>
        </info>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stops the sequencer</tr>
          <tr lang="ru">останавливает секвенсор</tr>
        </info>
      </method>
      <!-- tick -->
      <method name="tick">
        <info>
          <tr lang="en">outputs the current sequence element and moves to the next</tr>
          <tr lang="ru">выводит текущий элемент последовательности и переходит к следующему</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">resets all counters and starts the sequencer</tr>
          <tr lang="ru">сбрасывает все счётчики и запускает секвенсор</tr>
        </in>
      </inlet>
      <inlet>
        <in on="list">
          <tr lang="en">sets a new pattern value</tr>
          <tr lang="ru">устанавливает новое значение паттерна</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="bang">
          <tr lang="en">bang</tr>
          <tr lang="ru">bang</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">[i IDX N( — sequence iteration, [ri IDX N( — repeat iteration, [ed MS( —
          event duration, or [done( when done</tr>
          <tr lang="ru">[i IDX N( — итерация последовательности, [ri IDX N( — итерация повтора, [ed
          MS( — длительность события, или [done( по завершении</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]     [stop(  [reset(
|       |       |
|       |       |
[seq.bangs 3 1 2 1 1 @t 480bpm @r 4]
|                          ^|
|                          [route done i ed ri {w=21}]
|                          |    ^|  ^^|  ^^^|
[click~]                   [B]  [F]  [F]  [F]
|
[flt.resonbp~ 1000 40]     [ui.dsp~]
|
[ui.hgain~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
