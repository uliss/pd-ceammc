<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="route.any">
    <title>route.any</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">separate messages from bangs, floats, symbols and lists</tr>
        <tr lang="ru">отделяет сообщения общего вида от пустых событий (bang), числовых значений,
        символов и списков</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>route any</keywords>
      <since>0.9.6</since>
      <also>
        <see>route.float</see>
        <see>route.list</see>
        <see>route.random</see>
        <see>route.prop</see>
      </also>
    </meta>
    <inlets>
      <inlet>
        <in on="any">
          <tr lang="en">any to *first* outlet</tr>
          <tr lang="ru" finished="false">Любой *первый* выход</tr>
        </in>
        <in on="bang">
          <tr lang="en">bang to second outlet</tr>
          <tr lang="ru" finished="false">Bang to Second Outlet (альбом)</tr>
        </in>
        <in on="float">
          <tr lang="en">float to second outlet</tr>
          <tr lang="ru" finished="false">Поплавать на второй выход</tr>
        </in>
        <in on="list">
          <tr lang="en">list to second outlet</tr>
          <tr lang="ru" finished="false">Список для второго выхода</tr>
        </in>
        <in on="symbol">
          <tr lang="en">symbol to second outlet</tr>
          <tr lang="ru" finished="false">Символ для второго выхода</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">any output</tr>
          <tr lang="ru" finished="false">любой выход</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">bangs, floats, symbols and lists</tr>
          <tr lang="ru" finished="false">Банги, поплавки, символы и списки</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]  [bang( [symbol ABC #a(
|    |
|    |   [list 1 2 3(
|    |   |
|    |   |  [list(
|    |   |  |
|    |   |  | [@any( [other(
|    |   |  | |      |
[route.any         #z]
|       ^|
[ui.dt]  |
         |
         [ui.dt]

[X a->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
