<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flow.greater_eq">
        <title>flow.greater_eq</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">numeric stream router by 'greater or equal' condition</tr>
                <tr lang="ru">маршрутизатор числового потока по условию 'больше или равно'</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>gate greater equal</keywords>
            <since>0.9</since>
            <aliases>
                <alias>flow.&gt;=</alias>
            </aliases>
            <also>
                <see>flow.less</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Numbers thar are *less* then last argument are passed to N+1
                inlet</tr>
                <!-- old: Номера thar *less*, затем последний аргумент
                передается на вход N+1. -->
                <tr lang="ru" finished="false">Номера thar *less*, затем последний аргумент
                передается на вход N+1.</tr>
            </par>
        </info>
        <arguments>
            <argument name="VALUES" type="list">
                <tr lang="en">compare values: list of floats in descending order</tr>
                <!-- old: Сравнительные значения: список поплавков в
                нисходящем порядке -->
                <tr lang="ru" finished="false">Сравнительные значения: список поплавков в
                нисходящем порядке</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @values -->
            <property name="@values" type="list" access="initonly" default="">
                <tr lang="en">compare values: list of floats in descending order</tr>
                <!-- old: Сравнительные значения: список поплавков в
                нисходящем порядке -->
                <tr lang="ru" finished="false">Сравнительные значения: список поплавков в
                нисходящем порядке</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input flow</tr>
                    <tr lang="ru" finished="false">входной поток</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="any">
                    <tr lang="en">numbers that are greater or equal then 1st argument</tr>
                    <tr lang="ru" finished="false">Число, которое больше или равно 1-му
                    аргументу</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">numbers that are greater or equal than ... argument</tr>
                    <tr lang="ru" finished="false">Цифры, которые больше или равны, чем
                    аргументы</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">numbers that are greater or equal than last argument</tr>
                    <tr lang="ru" finished="false">Число, которое больше или равно последнему
                    аргументу</tr>
                </out>
            </outlet>
            <outlet number="n+1">
                <out type="any">
                    <tr lang="en">numbers that are less than last argument</tr>
                    <tr lang="ru" finished="false">Цифры, которые меньше последнего аргумента</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
|
|
[flow.>= 100 10 1   ]
|     ^|   ^^|   ^^^|
[F]   [F]   [F]   [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
