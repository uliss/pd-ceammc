<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="flow.greater_eq">
        <title>flow.greater_eq</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">numeric stream router by 'greater or equal' condition</tr>
                <tr lang="ru">маршрутизатор числового потока по условию 'больше или равно'</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>gate greater equal</keywords>
            <since>0.9</since>
            <aliases>
                <alias>flow.&gt;=</alias>
            </aliases>
            <also>
                <see>flow.less</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Numbers thar are *less* then last argument are passed to N+1
                outlet</tr>
                <tr lang="ru">Числа, которые *меньше* последнего аргумента выводятся на выход N+1.</tr>
            </par>
        </info>
        <arguments>
            <argument name="VALUES" type="list">
                <tr lang="en">values for comparison: a list of numbers in decreasing order</tr>
                <tr lang="ru">значения для сравнения: список чисел в порядке уменьшения</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @values -->
            <property name="@values" type="list" access="initonly" default="">
                <tr lang="en">values for comparison: a list of numbers in decreasing order</tr>
                <tr lang="ru">значения для сравнения: список чисел в порядке уменьшения</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">input numeric flow</tr>
                    <tr lang="ru">входной числовой поток</tr>
                </in>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="float">
                    <tr lang="en">numbers that are greater or equal then 1st argument</tr>
                    <tr lang="ru">числа большие или равные первому аргументу</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="float">
                    <tr lang="en">numbers that are greater or equal than ... argument</tr>
                    <tr lang="ru">числа, которые больше или равны аргументу ...</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="float">
                    <tr lang="en">numbers that are greater or equal than N-th argument</tr>
                    <tr lang="ru">числа, которые больше или равны аргументу N</tr>
                </out>
            </outlet>
            <outlet number="n+1">
                <out type="float">
                    <tr lang="en">numbers that are less than last argument</tr>
                    <tr lang="ru">числа, которые меньше последнего аргумента</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
|
|
[flow.>= 100 10 1   ]
|     ^|   ^^|   ^^^|
[F]   [F]   [F]   [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
