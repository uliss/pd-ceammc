<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="system.getenv">
    <title>system.getenv</title>
    <meta>
      <authors>
        <author>Alex Nadzharov</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">output system environment variables</tr>
        <tr lang="ru">выводит системные переменные окружения</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>system</category>
      <keywords>system environment</keywords>
      <since>0.1</since>
      <also>
        <see>system.hostname</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Outputs the value of a system environment variable. The variable name is set
        by the NAME argument, the @name property or a symbol on the inlet; a bang outputs the value
        of the currently set variable.</tr>
        <tr lang="ru">Выводит значение системной переменной окружения. Имя переменной задаётся
        аргументом NAME, свойством @name или символом на входе; bang выводит значение текущей
        заданной переменной.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Reading the user environment — accessing standard environment variables
        such as HOME, USER, PATH or SHELL to build file paths, detect the current user or set
        platform-specific defaults.</tr>
        <tr lang="ru">• Чтение окружения пользователя — доступ к стандартным переменным окружения,
        таким как HOME, USER, PATH или SHELL, для построения путей к файлам, определения текущего
        пользователя или установки платформо-зависимых значений по умолчанию.</tr>
      </par>
    </info>
    <arguments>
      <argument name="NAME" type="symbol">
        <tr lang="en">environment variable name</tr>
        <tr lang="ru">имя переменной окружения</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @name -->
      <property name="@name" type="symbol" default="">
        <tr lang="en">environment variable name</tr>
        <tr lang="ru">имя переменной окружения</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the variable value</tr>
          <tr lang="ru">выводит значение переменной</tr>
        </in>
        <in on="symbol">
          <tr lang="en">sets the name of the environment variable and outputs its value</tr>
          <tr lang="ru">задаёт имя переменной окружения и выводит её значение</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="symbol">
          <tr lang="en">symbol: environment variable value</tr>
          <tr lang="ru">символ: значение переменной окружения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[symbol HOME( [symbol APPDATA( [symbol PATH( [symbol USER( [symbol SHELL(
|             |                |             |             |
|             |                |             |             |
|  [B]        |                |             |             |
|  |          |                |             |             |
[system.getenv    USER                                     ]
|
[ui.display]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
