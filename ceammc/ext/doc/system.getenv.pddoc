<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="system.getenv">
        <title>system.getenv</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">output system environment variables</tr>
                <tr lang="ru">выводит системные переменные окружения</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>system</category>
            <keywords>system environment</keywords>
            <since>0.1</since>
            <also>
                <see>system.hostname</see>
            </also>
        </meta>
        <arguments>
            <argument name="NAME" type="symbol">environment variable name</argument>
        </arguments>
        <properties>
            <!-- @name -->
            <property name="@name" type="symbol" default="">environment variable name</property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">outputs variable value</xinfo>
                <xinfo on="symbol">sets name of environment variable and outputs it value</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>symbol: env-variable value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[symbol HOME( [symbol APPDATA( [symbol PATH( [symbol USER( [symbol SHELL(
|             |                |             |             |
|             |                |             |             |
|  [B]        |                |             |             |
|  |          |                |             |             |
[system.getenv    USER                                     ]
|
[ui.display]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
