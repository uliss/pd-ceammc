<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="dyn.comp~">
        <title>dyn.comp~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">mono dynamic range compressors</tr>
                <tr lang="ru">моно-компрессор</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>dyn</category>
            <keywords>compressor</keywords>
            <since>0.1</since>
            <also>
                <see>dyn.comp2~</see>
            </also>
        </meta>
        <info>
            <a href="https://en.wikipedia.org/wiki/Dynamic_range_compression">Dynamic range
            compression</a>
        </info>
        <arguments>
            <argument name="RATIO" type="float" minvalue="1" maxvalue="16">
                <tr lang="en">compression ratio (1 = no compression, &gt;1 means compression)</tr>
                <tr lang="ru">соотношение сжатия (1 = без компрессии, &gt;1 означает
                компрессию)</tr>
            </argument>
            <argument name="THRESHOLD" type="float" minvalue="-90" maxvalue="0" units="decibel">
                <tr lang="en">level threshold above which compression kicks in</tr>
                <tr lang="ru">порог уровня, выше которого начинается компрессия</tr>
            </argument>
            <argument name="ATTACK" type="float" units="millisecond" minvalue="0.1" maxvalue="100">
                <tr lang="en">attack time - the time that elapses between exceeding the threshold
                and when the compression ratio is reached</tr>
                <tr lang="ru">время, которое проходит между превышением порогового значения и
                моментом достижения заданного уровня компрессии</tr>
            </argument>
            <argument name="RELEASE" type="float" units="millisecond" minvalue="1" maxvalue="500">
                <tr lang="en">release time - the time of decay that elapses between when the input
                signal level drops below the threshold and when the compressor stops attenuating
                the signal</tr>
                <tr lang="ru">время спада, которое проходит между тем, как уровень входного сигнала
                упал ниже порога, и моментом, когда компрессор перестаёт ослаблять сигнал</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @attack -->
            <property name="@attack" type="float" units="millisecond" default="10" minvalue="0.1"
            maxvalue="100">
                <tr lang="en">time constant when level &amp; compression going up</tr>
            </property>
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
            </property>
            <!-- @gain -->
            <property name="@gain" type="float" units="decibel" default="0" minvalue="-18"
            maxvalue="18">
                <tr lang="en">make up gain: applied to the signal after the compression takes
                place</tr>
            </property>
            <!-- @level -->
            <property name="@level" type="float" default="0" minvalue="0" maxvalue="1"
            access="readonly">
                <tr lang="en">current level of compression</tr>
            </property>
            <!-- @ratio -->
            <property name="@ratio" type="float" default="1" minvalue="1" maxvalue="16">
                <tr lang="en">compression ratio (1 = no compression, &gt;1 means compression)</tr>
            </property>
            <!-- @refresh -->
            <property name="@refresh" type="int" default="100" minvalue="0" maxvalue="1000"
            units="millisecond">
                <tr lang="en">compression level output time interval. If 0 - no output</tr>
            </property>
            <!-- @release -->
            <property name="@release" type="float" units="millisecond" default="50" minvalue="1"
            maxvalue="500">
                <tr lang="en">release time = time constant coming out of compression</tr>
            </property>
            <!-- @threshold -->
            <property name="@threshold" type="float" units="decibel" default="-10" minvalue="-90"
            maxvalue="0">
                <tr lang="en">level threshold above which compression kicks in (100 dB = max
                level)</tr>
            </property>
        </properties>
        <methods>
            <!-- preset -->
            <method name="preset">choose predefined preset 
            <param name="PRESET" type="symbol" enum="vocal drums bass strings" required="true">
            name</param></method>
            <!-- reset -->
            <method name="reset">reset to initial state</method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>input signal</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output compressed signal</outlet>
            <outlet>float: output current compression level in [0..1]</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.hsl -60 20 @show_value 1] [ui.dsp~]
|
[dbfs->amp]
|
[sig~]    [ui.hsl #a]   [ui.hsl #b]
|         |             |
|         |             |
|         [@ratio $1(   [@threshold $1(
|         |             |
|         |             |
[dyn.comp~ 3 -60 10 100 ]
|               ^|
[env~]          [ui.hsl @active_scale 1]
|
[- 100]
|
[F]

#a 1 16 @show_value 1
#b -60 0 @show_value 1
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
