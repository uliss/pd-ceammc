<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="string2symbol">
    <title>string2symbol</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts the string into the symbol</tr>
        <tr lang="ru">преобразует строку в символ</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>string</category>
      <keywords>string symbol convert</keywords>
      <since>0.3</since>
      <aliases>
        <alias>ceammc/string2symbol</alias>
        <alias>ceammc/str-&gt;sym</alias>
        <alias>str-&gt;sym</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object converts a data:String value into a symbol, so that string data can be used in objects that expect symbols</tr>
        <tr lang="ru">объект преобразует значение data:String в символ, чтобы строковые данные можно было использовать в объектах, ожидающих символ</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input string value</tr>
          <tr lang="ru">входное строковое значение</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="symbol">
          <tr lang="en">symbol output</tr>
          <tr lang="ru">выход символа</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B] [F]    [symbol test(
|   |      |
[string A B C]
|
[str->sym]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
