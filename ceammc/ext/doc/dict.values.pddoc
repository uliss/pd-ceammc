<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="dict.values">
    <title>dict.values</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">output the dictionary values as an MList</tr>
        <tr lang="ru">выводит значения словаря в виде многоуровневого списка (MList)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>size dictionary</keywords>
      <since>0.6</since>
      <also>
        <see>data.dict</see>
        <see>data.mlist</see>
        <see>dict.keys</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes a dictionary on its inlet and outputs a multi-level list
        (MList) containing all dictionary values. The order of values matches the order of keys in
        the dictionary. Use dict.keys to get the corresponding list of keys.</tr>
        <tr lang="ru">Объект принимает словарь на вход и выводит многоуровневый список (MList),
        содержащий все значения словаря. Порядок значений соответствует порядку ключей в словаре.
        Для получения соответствующего списка ключей используйте dict.keys.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="data:dict">
          <tr lang="en">dictionary to extract values from. On receipt, the object immediately
          outputs the MList of values</tr>
          <tr lang="ru">словарь, из которого нужно извлечь значения. При получении объект сразу
          выводит MList значений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="data:mlist">
          <tr lang="en">mlist of values</tr>
          <tr lang="ru">MList значений</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[data.dict \[bpm: 120 title: "Unknown masterpiece" freqs: 1 2 3 4\]]
|
|
|
[dict.values  ]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
