<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="flow.select">
        <title>flow.select</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">enhanced message selector</tr>
                <tr lang="ru">улучшенный селектор сообщений</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>select</keywords>
            <since>0.9.1</since>
            <aliases>
                <alias>flow.sel</alias>
            </aliases>
            <also>
                <see>flow.match</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Match syntax:</tr>
            </par>
            <par>
                <tr lang="en">common: symbols or floats</tr>
            </par>
            <par>
                <tr lang="en">compare: &gt;NUM, &gt;=NUM, &lt;NUM, &lt;=NUM</tr>
            </par>
            <par>
                <tr lang="en">intervals: FROM..TO, or [FROM..TO] - closed interval, [FROM..TO) or
                (FROM..TO] semi-open interval, (FROM..TO) open interval, NUM~EPSILON - value in
                NUM+-EPSILON range</tr>
            </par>
            <par>
                <tr lang="en">set: A|B|C - match to A or B or C</tr>
            </par>
        </info>
        <arguments>
            <argument name="ARGS" type="list">
                <tr lang="en">flow match expressions</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @keep_value -->
            <property name="@keep_value" type="bool" default="0">
                <tr lang="en">value output mode. If false (by default) acts like vanilla select:
                output bang on match or full unmatched message to last outlet. If true always
                outputs full matched message to corresponding outlet.</tr>
            </property>
            <!-- @msg -->
            <property name="@msg" type="list" default="">
                <tr lang="en">output this message on match, instead of bang</tr>
            </property>
            <!-- @v -->
            <property name="@v" type="alias">
                <tr lang="en">alias to @keep_value 1</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">check float for matches</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">check symbol for matches</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">check first list element for matches</tr>
                </xinfo>
                <xinfo on="any">
                    <tr lang="en">check message selector for matches</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">first matched output: bang or full message</outlet>
            <outlet number="...">... matched output: bang or full message</outlet>
            <outlet number="n">nth matched output: bang or full message</outlet>
            <outlet number="n+1">unmatched message</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 #q(     [list c 17 #s(

[10(   [40 #p( [b #o(
|
[F]    [30(    [symbol c(   [unmatched(
|      |       |            |
[flow.sel 1..10 >20 a|b|c @v #a {w=32}]
|
[ui.dt #b]

       [ui.dt #c]

               [ui.dt #d]

                       [ui.dt #e]
[X a->b]
[X a:1->c]
[X a:2->d]
[X a:3->e]
[X p->a]
[X o->a]
[X q->a]
[X s->a]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
