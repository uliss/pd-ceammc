<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.radio" type="gui">
    <title>ui.radio</title>
    <meta>
      <authors>
        <author>Pierre Guillot</author>
      </authors>
      <description>
        <tr lang="en">radio toggle with multiselect option</tr>
        <tr lang="ru">радиопереключатель с возможностью множественного выбора</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui radio</keywords>
      <since>0.1</since>
      <also>
        <see view="link">ui.matrix</see>
      </also>
      <aliases>
        <alias view="link">ui.radio*</alias>
        <alias view="link">ui.hrd</alias>
        <alias view="link">ui.hrd*</alias>
        <alias view="link">ui.vrd</alias>
        <alias view="link">ui.vrd*</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">[ui.hrd] is an alias for a horizontal radio, [ui.vrd] is an alias for a
        vertical radio, [ui.hrd*] is an alias for a horizontal radio checklist.</tr>
        <tr lang="ru">[ui.hrd] — это псевдоним для горизонтального радиопереключателя, [ui.vrd] —
        для вертикального радиопереключателя, [ui.hrd*] — для горизонтального списка флажков.</tr>
      </par>
    </info>
    <mouse>
      <event type="double-click" editmode="true" keys="Cmd">changes slider orientation</event>
      <event type="drag" editmode="false">toggle radio cells in the checklist mode</event>
      <event type="left-click" editmode="0">select cell in radio mode, toggle cell in check list
      mode</event>
      <event type="right-click" editmode="0">show context menu</event>
    </mouse>
    <arguments>
      <argument name="NCELLS" type="float" minvalue="2" maxvalue="128">
        <tr lang="en">number of cells</tr>
        <tr lang="ru">количество ячеек</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_active_color.xml" />
      <xi:include href="props_background_color.xml" />
      <xi:include href="props_border_color.xml" />
      <xi:include href="props_fontname.xml" />
      <xi:include href="props_fontsize.xml" />
      <xi:include href="props_fontslant.xml" />
      <xi:include href="props_fontweight.xml" />
      <xi:include href="props_pinned.xml" />
      <xi:include href="props_ui_receive.xml" />
      <xi:include href="props_ui_send.xml" />
      <xi:include href="props_preset.xml" />
      <!-- @mode -->
      <property name="@mode" type="bool" default="0">
        <tr lang="en">check list mode. If true, acts as a checklist.</tr>
        <tr lang="ru">режим списка флажков. Если true, работает как список флажков.</tr>
      </property>
      <!-- @mouse_events -->
      <property name="@mouse_events" type="bool" default="0">
        <tr lang="en">mouse events output mode. If on, outputs @mouse_down and @mouse_drag
        events.</tr>
        <tr lang="ru">режим вывода событий мыши. Если включён, выводит события @mouse_down и
        @mouse_drag.</tr>
      </property>
      <!-- @nitems -->
      <property name="@nitems" type="int" default="8" minvalue="2" maxvalue="128">
        <tr lang="en">number of items</tr>
        <tr lang="ru">количество элементов</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="120 15">
        <tr lang="en">object size (width, height pair)</tr>
        <tr lang="ru">размер объекта (пара: ширина высота)</tr>
      </property>
      <!-- @value -->
      <property name="@value" type="list" default="">
        <tr lang="en">widget value (float or list)</tr>
        <tr lang="ru">значение виджета (число или список)</tr>
      </property>
    </properties>
    <methods>
      <!-- + STEP -->
      <method name="+ STEP">
        <info>
          <tr lang="en">moves several steps forward in a loop (single mode only)</tr>
          <tr lang="ru">перемещает на несколько шагов вперёд по циклу (только в одиночном
          режиме)</tr>
        </info>
      </method>
      <!-- - STEP -->
      <method name="- STEP">
        <info>
          <tr lang="en">moves several steps backward in a loop (single mode only)</tr>
          <tr lang="ru">перемещает на несколько шагов назад по циклу (только в одиночном
          режиме)</tr>
        </info>
      </method>
      <!-- cellsize -->
      <method name="cellsize">
        <info>
          <tr lang="en">set cell size (resize widget)</tr>
          <tr lang="ru">установить размер ячейки (изменить размер виджета)</tr>
        </info>
        <param name="X" type="int" required="true">
          <tr lang="en">cell size in pixels</tr>
          <tr lang="ru">размер ячейки в пикселях</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clears the specified preset</tr>
          <tr lang="ru">очищает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- euclid -->
      <method name="euclid">
        <info>
          <tr lang="en">set a Euclid pattern (checklist mode only)</tr>
          <tr lang="ru">установить евклидов паттерн (только в режиме списка флажков)</tr>
        </info>
        <param name="BEATS" type="int" required="true">
          <tr lang="en">requested number of beats</tr>
          <tr lang="ru">запрошенное количество ударов</tr>
        </param>
        <param name="OFFSET" type="int" required="false">
          <tr lang="en">pattern offset (rotation to the right)</tr>
          <tr lang="ru">смещение паттерна (поворот вправо)</tr>
        </param>
      </method>
      <!-- flip -->
      <method name="flip">
        <info>
          <tr lang="en">flips the radio (only in checklist mode)</tr>
          <tr lang="ru">инвертирует значения (только в режиме списка флажков)</tr>
        </info>
      </method>
      <!-- hexbeat -->
      <method name="hexbeat">
        <info>
          <tr lang="en">set a hexbeat pattern (checklist mode only)</tr>
          <tr lang="ru">установить hexbeat-паттерн (только в режиме списка флажков)</tr>
        </info>
        <param name="HEXSTR" type="symbol" required="true">
          <tr lang="en">hex string. For example, 0xF1 will set the pattern: 1 1 1 1 0 0 0 1.</tr>
          <tr lang="ru">шестнадцатеричная строка. Например, 0xF1 установит паттерн: 1 1 1 1 0 0 0
          1.</tr>
        </param>
      </method>
      <!-- interp -->
      <method name="interp">
        <info>
          <tr lang="en">for this object acts as *load*; no interpolation is performed.</tr>
          <tr lang="ru">для этого объекта действует как *load*; интерполяция не выполняется.</tr>
        </info>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">loads the specified preset</tr>
          <tr lang="ru">загружает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- next -->
      <method name="next">
        <info>
          <tr lang="en">moves to the next position until the last cell is reached (single mode
          only)</tr>
          <tr lang="ru">перемещает на следующую позицию до достижения последней ячейки (только в
          одиночном режиме)</tr>
        </info>
      </method>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set the UI element position</tr>
          <tr lang="ru">установить положение элемента интерфейса</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top-left x-coordinate</tr>
          <tr lang="ru">координата x верхнего левого угла</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top-left y-coordinate</tr>
          <tr lang="ru">координата y верхнего левого угла</tr>
        </param>
      </method>
      <!-- prev -->
      <method name="prev">
        <info>
          <tr lang="en">moves to the previous position until the first cell is reached (single mode
          only)</tr>
          <tr lang="ru">перемещает на предыдущую позицию до достижения первой ячейки (только в
          одиночном режиме)</tr>
        </info>
      </method>
      <!-- random -->
      <method name="random">
        <info>
          <tr lang="en">select random cells. If called as [random move(, moves to another random
          cell (excluding the current one).</tr>
          <tr lang="ru">выбирает случайные ячейки. Если вызвано как [random move(, перемещается на
          другую случайную ячейку (исключая текущую).</tr>
        </info>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the radio (only in checklist mode)</tr>
          <tr lang="ru">сбрасывает радиопереключатель (только в режиме списка флажков)</tr>
        </info>
      </method>
      <!-- rotate -->
      <method name="rotate">
        <info>
          <tr lang="en">left rotation (checklist mode only)</tr>
          <tr lang="ru">поворот влево (только в режиме списка флажков)</tr>
        </info>
        <param name="STEPS" type="int" required="true">
          <tr lang="en">number of steps</tr>
          <tr lang="ru">количество шагов</tr>
        </param>
      </method>
      <!-- set -->
      <method name="set">
        <info>
          <tr lang="en">sets the radio value without output</tr>
          <tr lang="ru">устанавливает значение радиопереключателя без вывода</tr>
        </info>
        <param name="V" type="float" required="true">
          <tr lang="en">new value</tr>
          <tr lang="ru">новое значение</tr>
        </param>
      </method>
      <!-- store -->
      <method name="store">
        <info>
          <tr lang="en">stores the specified preset</tr>
          <tr lang="ru">сохраняет указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the current radio state</tr>
          <tr lang="ru">выводит текущее состояние радиопереключателя</tr>
        </in>
        <in on="float">
          <tr lang="en">sets the radio value and outputs it</tr>
          <tr lang="ru">устанавливает значение радиопереключателя и выводит его</tr>
        </in>
        <in on="list">
          <tr lang="en">sets the radio value and outputs it (only in checklist mode)</tr>
          <tr lang="ru">устанавливает значение радиопереключателя и выводит его (только в режиме
          списка флажков)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output value</tr>
          <tr lang="ru">выходное значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]  [set 2(         [flip( [reset( [1 1 0 1 0 0 1( [euclid 3 1 #a(
|    |               |      |       |
|    |               |      |       |  [rotate 1(   [hexbeat BE #b(
|    |               |      |       |  |
[ui.radio ]          [ui.radio*         #x]
|                    |
[F]                  [ui.dt]

[+ 3( [- 1( [prev( [next( [random( [random move(
|     |     |      |      |        |
|     |     |      |      |        |
[ui.radio 4                        ]
|
[ui.dt]

[X a->x]
[X b->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
