<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="canvas.path">
    <title>canvas.path</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">output the current canvas file system full path of the object</tr>
        <tr lang="ru">выводит полный путь холста объекта в файловой системе</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>patch</category>
      <keywords>canvas path</keywords>
      <also>
        <see>canvas.name</see>
        <see>canvas.dir</see>
      </also>
      <since>0.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object outputs the full file system path of the canvas (window or
        subpatch) that contains it. On bang the path is sent out through the outlet as a symbol.
        This is useful, for example, for resolving paths to files located next to the patch that
        contains the object.</tr>
        <tr lang="ru">Объект выводит полный путь в файловой системе до холста (окна или субпатча),
        который его содержит. По bang путь отправляется через выход в виде символа. Это полезно,
        например, для построения путей к файлам, расположенным рядом с патчем, содержащим
        объект.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the current canvas full path</tr>
          <tr lang="ru">выводит полный путь текущего холста</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">current canvas full path as a symbol</tr>
          <tr lang="ru">полный путь текущего холста в виде символа</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[canvas.path] [B]
|             |
[ui.display   ]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
