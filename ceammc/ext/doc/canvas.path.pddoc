<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="canvas.path">
        <title>canvas.path</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">output the current canvas filesystem fullpath of the object</tr>
                <tr lang="ru">выводит полный путь холста в файловой системе у объекта</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>patch</category>
            <keywords>canvas path</keywords>
            <also>
                <see>canvas.name</see>
                <see>canvas.dir</see>
            </also>
            <since>0.8</since>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output current canvas fullpath</tr>
                    <tr lang="ru" finished="false">выходной ток canvas fullpath</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">current canvas fullpath as symbol</tr>
                    <tr lang="ru" finished="false">Текущий холст Fullpath как символ</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[canvas.path] [B]
|             |
[ui.display   ]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
