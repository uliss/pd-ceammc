<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.map">
        <title>list.map</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">map list values by specified dictionary</tr>
                <tr lang="ru" finished="false">Значения списка карт в указанном словаре</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list map dict</keywords>
            <since>0.9.5</since>
            <also>
                <see>data.dict</see>
            </also>
        </meta>
        <arguments>
            <argument name="DICT" type="list">
                <tr lang="en">mapping dictionary, see @dict property</tr>
                <tr lang="ru" finished="false">Картографический словарь, см. @dict property</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @def -->
            <property name="@def" type="list" default="">
                <tr lang="en">default value to replace missing keys. If empty (by default), missing
                keys are ignored.</tr>
                <tr lang="ru" finished="false">значение по умолчанию для замены отсутствующих
                ключей. Если пустые (по умолчанию), пропущенные ключи игнорируются.</tr>
            </property>
            <!-- @dict -->
            <property name="@dict" type="list" default="[]">
                <tr lang="en">mapping dictionary, the syntax is [KEY: VALUES...], for example: [1:
                "one" 2: "two" k: "map values"]</tr>
                <tr lang="ru" finished="false">Словарь отображения, синтаксис [KEY: VALUES...],
                например: [1: «один» 2: «два» k: «значения карты»]</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input float, no output if not in dict</tr>
                    <tr lang="ru" finished="false">Входной поплавок, нет выхода, если не в
                    дикте</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">input symbol, no output if not in dict</tr>
                    <tr lang="ru" finished="false">Входной символ, не выход, если не в дикте</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">input list, output always at least empty list</tr>
                    <tr lang="ru" finished="false">Список входов, выход всегда, по крайней мере,
                    пустой список</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input list, output always at least empty list</tr>
                    <tr lang="ru" finished="false">Список входов, выход всегда, по крайней мере,
                    пустой список</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="data:dict">
                    <tr lang="en">set mapping dictionary</tr>
                    <tr lang="ru" finished="false">Настройка картографического словаря</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">list or data:mlist mapped list</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">atom: missing keys</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard 24]
|
|
|
|
|
[$1(
|
[% 12]
|
[list.map \[0: "C" 1: "C#" 2: "D" 3: "Eb" 4: "E" 5: "F" 6: "F#" 7: "G" 8: "G#" 9: "A" 10: "A#" 11: "B"\] {w:50}]
|
|
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
