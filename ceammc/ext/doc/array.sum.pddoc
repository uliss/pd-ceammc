<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="array.sum">
        <title>array.sum</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">calculates sum of array elements</tr>
                <tr lang="ru">вычисляет сумму элементов массива</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array sum</keywords>
            <since>0.8</since>
            <also>
                <see>array.sum2</see>
            </also>
        </meta>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">calculates and outputs the sum</tr>
                    <tr lang="ru" finished="false">вычисляет и выводит сумму</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">sum of array values</tr>
                    <tr lang="ru" finished="false">Сумма значений массива</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]                            [array asum1 size=100 w=180 h=130]
|
[array.sum asum1]
|
[F digits=16]

[sinesum 100 0.2 0.3(
|
[s asum1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
