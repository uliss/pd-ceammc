<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.10">
    <object name="conv.samp2sec">
        <title>conv.samp2sec</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert samples to seconds according to sample rate</tr>
                <tr lang="ru">преобразовывает семплы в секунды в соответствии со скоростью
                семплирования</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv samp</keywords>
            <since>0.2</since>
            <aliases>
                <alias>ceammc/samp-&gt;sec</alias>
                <alias>samp-&gt;sec</alias>
            </aliases>
            <also>
                <see>conv.sec2samp</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="int">number of samples</xinfo>
                <xinfo on="list">list of number of samples</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>converted value (float or list)</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[44100(  [20 1000 5000 20000(
|        |
[samp->sec]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
