<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="list.rundiff">
        <title>list.rundiff</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">сomputes the difference between the adjacent elements of the input
                list</tr>
                <tr lang="ru">вычисляет разницу между соседними элементами входного списка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list running difference partial cumulative</keywords>
            <since>0.9.4</since>
            <also>
                <see>list.runsum</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">calculation flow:</tr>
            </par>
            <par>
                <tr lang="en">• y0 = x0</tr>
            </par>
            <par>
                <tr lang="en">• y1 = x1 - x0</tr>
            </par>
            <par>
                <tr lang="en">• y2 = x2 - x1</tr>
            </par>
            <par>
                <tr lang="en">• y3 = x3 - x2</tr>
            </par>
            <par>
                <tr lang="en">etc...</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="list">input list</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result list</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 1 1 1 #a( [1 2 3 4 #b( [1 3 5 7 #d( [1 2 3 2 1 #c(



[list.rundiff #x]
|
[ui.dt]
[X a->x] [X b->x] [X c->x] [X d->x]

[ui.sliders]
|
|
|
|
|
|
|
[list.rundiff]
|
[ui.dt]
/*.*/
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
