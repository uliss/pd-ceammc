<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="path.dirname">
    <title>path.dirname</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">outputs directory portion of path name</tr>
        <tr lang="ru">извлекает имя каталога из пути</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>path</category>
      <keywords>path environment</keywords>
      <since>0.1</since>
      <also>
        <see>path.basename</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">for example, for the path "/dir/file.txt" the output is "/dir"</tr>
        <tr lang="ru">например, для пути "/dir/file.txt" вывод — "/dir"</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">outputs directory portion of pathname</tr>
          <tr lang="ru">выводит имя каталога из пути</tr>
        </in>
        <in on="data:string">
          <tr lang="en">outputs directory portion of pathname</tr>
          <tr lang="ru">выводит имя каталога из пути</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">directory name</tr>
          <tr lang="ru">имя каталога</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[symbol HOME(
|
[system.getenv] [/dir/path( [./test( [/root(   [/(
|               |           |        |         |
|               |           |        |         |
|               [symbol                        ]
|               |
|               |     [.(  [..( [C://file.txt(
|               |     |    |    |
|               |     [symbol   ]
|               |     |
[path.dirname         ]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
