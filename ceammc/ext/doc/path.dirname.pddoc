<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="path.dirname">
        <title>path.dirname</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs directory portion of pathname</tr>
                <tr lang="ru">выводит имя каталога файла из пути к файлу</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>path</category>
            <keywords>path environment</keywords>
            <since>0.1</since>
            <also>
                <see>path.basename</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">outputs directory portion of pathname</tr>
                </xinfo>
                <xinfo on="data:string">
                    <tr lang="en">outputs directory portion of pathname</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>directory name</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[symbol HOME(
|
[system.getenv] [/dir/path( [./test( [/root(   [/(
|               |           |        |         |
|               |           |        |         |
|               [symbol                        ]
|               |
|               |     [.(  [..( [C://file.txt(
|               |     |    |    |
|               |     [symbol   ]
|               |     |
[path.dirname         ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
