<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="fx.bitdown~">
        <title>fx.bitdown~</title>
        <meta>
            <authors>
                <author>Viacheslav Lotsmanov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">a bit downer and downsampler effect</tr>
                <tr lang="ru">понижение разрядности входного сигнала и эффект даунсемплинга</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx bits downsample</keywords>
            <since>0.7</since>
        </meta>
        <arguments>
            <argument name="BITS" type="int" minvalue="1" maxvalue="16">
                <tr lang="en">number of bits</tr>
            </argument>
            <argument name="DOWNSAMP" type="int" minvalue="1" maxvalue="200" units="sample">
                <tr lang="en">number of samples to skip</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1">on/off dsp processing</property>
            <!-- @bits -->
            <property name="@bits" type="int" minvalue="1" maxvalue="16" default="16">output
            bits</property>
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">bypass flag. If true: bypass
            'effected' signal.</property>
            <!-- @downsamp -->
            <property name="@downsamp" type="int" minvalue="1" maxvalue="200" default="1"
            units="sample">number samples to skip</property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">reset object</method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>left channel</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env] [F]        [F]
|            |          |
[readsf~]    [@bits $1( [@downsamp $1(
|            |          |
|            |          |
|            |          |
[fx.bitdown~  8 12      ]
|
[ui.gain~ @size 120 14] [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
