<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fx.bitdown~">
    <title>fx.bitdown~</title>
    <meta>
      <authors>
        <author>Viacheslav Lotsmanov</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">a bit downer and downsampler effect</tr>
        <tr lang="ru">эффект понижения разрядности и даунсемплинга</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>fx</category>
      <keywords>fx bits downsample</keywords>
      <since>0.7</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object reduces the bit depth and sample rate of the input signal,
        producing a lo-fi or bitcrushed sound</tr>
        <tr lang="ru">объект понижает разрядность и частоту дискретизации входного сигнала,
        создавая lo-fi или биткраш-звучание</tr>
      </par>
      <par>
        <tr lang="en">@bits sets the output bit depth from 1 to 16 bits</tr>
        <tr lang="ru">@bits задаёт выходную разрядность от 1 до 16 бит</tr>
      </par>
      <par>
        <tr lang="en">@downsamp sets how many samples are skipped, a higher value gives a stronger
        downsampling effect</tr>
        <tr lang="ru">@downsamp задаёт количество пропускаемых сэмплов, большее значение даёт более
        сильный эффект даунсемплинга</tr>
      </par>
    </info>
    <arguments>
      <argument name="BITS" type="int" minvalue="1" maxvalue="16">
        <tr lang="en">number of bits</tr>
        <tr lang="ru">количество бит</tr>
      </argument>
      <argument name="DOWNSAMP" type="int" minvalue="1" maxvalue="200" units="sample">
        <tr lang="en">number of samples to skip</tr>
        <tr lang="ru">количество пропускаемых сэмплов</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @bits -->
      <property name="@bits" type="int" minvalue="1" maxvalue="16" default="16">
        <tr lang="en">output bits</tr>
        <tr lang="ru">выходная разрядность</tr>
      </property>
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypass the processed signal</tr>
        <tr lang="ru">флаг обхода. Если true: пропускать обработанный сигнал без изменений</tr>
      </property>
      <!-- @downsamp -->
      <property name="@downsamp" type="int" minvalue="1" maxvalue="200" default="1" units="sample">
        <tr lang="en">number of samples to skip</tr>
        <tr lang="ru">количество пропускаемых сэмплов</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset object</tr>
          <tr lang="ru">сбросить объект</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">left channel</tr>
          <tr lang="ru">левый канал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output</tr>
          <tr lang="ru">выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env] [F]        [F]
|            |          |
[readsf~]    [@bits $1( [@downsamp $1(
|            |          |
|            |          |
|            |          |
[fx.bitdown~  8 12      ]
|
[ui.gain~ @size 120 14] [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
