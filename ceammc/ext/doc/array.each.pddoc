<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.each">
    <title>array.each</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">process each array element via side-chain</tr>
        <tr lang="ru">обработка каждого элемента массива через боковую цепочку</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array each</keywords>
      <also>
        <see>list.each</see>
      </also>
      <since>0.3</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object iterates over the samples of the specified array and sends each
        sample to the side-chain (the float outlet) one by one. The processed value returned to the
        right inlet replaces the current sample in the array. When all samples have been processed,
        a bang is sent out to the first outlet.</tr>
        <tr lang="ru">Объект перебирает семплы указанного массива и по одному отправляет каждый
        семпл в боковую цепочку (выход числа). Обработанное значение, возвращённое в правый вход,
        заменяет текущий семпл в массиве. Когда все семплы обработаны, на первый выход отправляется
        bang.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array to process</tr>
        <tr lang="ru">имя массива для обработки</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array to process</tr>
        <tr lang="ru">имя массива для обработки</tr>
      </property>
      <!-- @redraw -->
      <property name="@redraw" type="bool" default="1">
        <tr lang="en">redraw the array after change</tr>
        <tr lang="ru">перерисовывать массив после изменения</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">starts processing</tr>
          <tr lang="ru">запускает обработку</tr>
        </in>
        <in on="symbol">
          <tr lang="en">sets a new array, then processes each element</tr>
          <tr lang="ru">устанавливает новый массив, затем обрабатывает каждый элемент</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">processed float value returned from the side-chain. Replaces the current
          sample in the array</tr>
          <tr lang="ru">обработанное значение, возвращённое из боковой цепочки. Заменяет текущий
          семпл в массиве</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="bang">
          <tr lang="en">sent when the iteration is finished</tr>
          <tr lang="ru">отправляется по завершении обхода</tr>
        </out>
      </outlet>
      <outlet>
        <out type="float">
          <tr lang="en">array sample value sent to the side-chain</tr>
          <tr lang="ru">значение семпла массива, отправляемое в боковую цепочку</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                            [array array1 size=100 w=130 h=100]
|
[array.each array1]X[sin]
|
[normalize(
|
[s array1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
