<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="math.asin">
        <title>math.asin</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">arc sine function</tr>
                <tr lang="ru">арксинус</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math asin</keywords>
            <also>
                <see>math.acos</see>
                <see>math.atan</see>
                <see>math.cos</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The asin() function computes the principal value of the arc sine of
                input value. The result is in the range [-pi/2, +pi/2].</tr>
                <!-- old: Функция asin() вычисляет основное значение синуса
                дуги входного значения. Результат находится в диапазоне [-pi/2, +pi/2]. -->
                <tr lang="ru" finished="false">Функция asin() вычисляет основное значение синуса
                дуги входного значения. Результат находится в диапазоне [-pi/2, +pi/2].</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
                <tr lang="ru" finished="false">Особые ценности:</tr>
            </par>
            <par>
                <tr lang="en">asin(+-0) returns +-0.</tr>
                <tr lang="ru" finished="false">Asin(+-0) возвращается +-0.</tr>
            </par>
            <par>
                <tr lang="en">asin(x) returns a NAN and raises the "invalid" floating-point
                exception for |x| &gt; 1.</tr>
                <!-- old: asin(x) возвращает NAN и поднимает
                «недействительное» исключение с плавающей точкой для |x | > 1. -->
                <tr lang="ru" finished="false">asin(x) возвращает NAN и поднимает
                «недействительное» исключение с плавающей точкой для |x | &gt; 1.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">input value</tr>
                    <tr lang="ru" finished="false">входная стоимость</tr>
                </in>
                <in on="list">
                    <tr lang="en">apply to all numeric values</tr>
                    <tr lang="ru" finished="false">применяется ко всем числовым значениям</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result value</tr>
                    <tr lang="ru" finished="false">значение результата</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[math.asin]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
