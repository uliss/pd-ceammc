<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="gate~">
        <title>gate~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">multichannel signal gate</tr>
                <tr lang="ru">многоканальный гейт для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>gate</keywords>
            <since>0.9.7</since>
            <aliases>
                <alias>ceammc/gate~</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="1" maxvalue="64">
                <tr lang="en">number of inputs/outputs</tr>
                <tr lang="ru" finished="false">Количество входов/выходов</tr>
            </argument>
            <argument name="INIT" type="bool">
                <tr lang="en">initial open/close state for all slots</tr>
                <tr lang="ru" finished="false">начальное состояние open/close для всех слотов</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @init -->
            <property name="@init" type="bool" access="initonly" default="true">
                <tr lang="en">init state for all slots. If true: all slots are open.</tr>
                <!-- old: Состояние init для всех слотов. Если это правда, все
                слоты открыты. -->
                <tr lang="ru" finished="false">Состояние init для всех слотов. Если это правда, все
                слоты открыты.</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" minvalue="1" default="1" maxvalue="64"
            access="initonly">
                <tr lang="en">number of [in|out]puts.</tr>
                <tr lang="ru" finished="false">Количество [внутренних] выходов.</tr>
            </property>
            <!-- @smooth -->
            <property name="@smooth" type="float" minvalue="0" default="50" maxvalue="1000"
            units="millisecond">
                <tr lang="en">gain change smooth time</tr>
                <tr lang="ru" finished="false">Изменение плавного времени</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet type="audio" number="1">
                <in>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
            <inlet type="audio" number="...">
                <in>
                    <tr lang="en">... input signal</tr>
                    <tr lang="ru" finished="false">... входной сигнал</tr>
                </in>
            </inlet>
            <inlet type="control" number="n">
                <in>
                    <tr lang="en">n-th input signal</tr>
                    <tr lang="ru" finished="false">n-й входной сигнал</tr>
                </in>
            </inlet>
            <inlet type="control" number="n+1">
                <in on="bool">
                    <tr lang="en">on/off all channels</tr>
                    <tr lang="ru" finished="false">Все каналы включены/выключены</tr>
                </in>
                <in on="list">
                    <tr lang="en">list of 1|0, on/off specified channels only</tr>
                    <tr lang="ru" finished="false">список 1 | 0, только по указанным каналам</tr>
                </in>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio" number="1">
                <out type="any">
                    <tr lang="en">first output signal</tr>
                    <tr lang="ru" finished="false">Первый выходной сигнал</tr>
                </out>
            </outlet>
            <outlet type="audio" number="...">
                <out type="any">
                    <tr lang="en">... output signal</tr>
                    <tr lang="ru" finished="false">... выходной сигнал</tr>
                </out>
            </outlet>
            <outlet type="audio" number="n">
                <out type="any">
                    <tr lang="en">n-th output signal</tr>
                    <tr lang="ru" finished="false">n-й выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[sig~ 1] [sig~ 2] [sig~ 100] [T]  [ui.hrd* 3]          [ui.dsp~]
|        |.       |..        |... |...
[gate~ 3                {i=4,o=3,w=30}]
|         ^|        ^^|
[ui.n~]   [ui.n~]   [ui.n~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
