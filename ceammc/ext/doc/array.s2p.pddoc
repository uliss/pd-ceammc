<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="array.s2p">
        <title>array.s2p</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert the sample index to the phase range [0..1]</tr>
                <tr lang="ru">преобразование индекса семпла в фазовый диапазон [0..1]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>array phase sample</keywords>
            <also>
                <see>array.p2s</see>
            </also>
            <since>0.2</since>
            <aliases>
                <alias>array.s-&gt;p</alias>
                <alias>array.sample-&gt;phase</alias>
            </aliases>
        </meta>
        <info>
            <par>with this object you can get relative position in array</par>
        </info>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">array sample number</xinfo>
                <xinfo on="list">list of sample numbers</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>relative position (non-clipped)</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[HS min=0 max=100]       [array s2p size=100 w=200 h=130]
|
[F]
|
[array.s->p s2p]
|
[F]
|
[array.p->s s2p]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
