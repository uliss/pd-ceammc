<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="merge~">
    <title>merge~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">merge audio signals</tr>
        <tr lang="ru">объединяет аудиосигналы</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>merge split</keywords>
      <since>0.9.7</since>
      <aliases>
        <alias>ceammc/merge~</alias>
      </aliases>
      <also>
        <see>split~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">it is mostly syntax sugar for clearer schemes, but can be used in dynamic patching</tr>
        <tr lang="ru">в основном это синтаксический сахар для более наглядных схем, но объект можно использовать и при динамическом патчинге</tr>
      </par>
      <par>
        <tr lang="en">the reverse operation is performed by [split~]</tr>
        <tr lang="ru">обратную операцию выполняет [split~]</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="2" maxvalue="64">
        <tr lang="en">number of inputs</tr>
        <tr lang="ru">количество входов</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @n -->
      <property name="@n" type="int" minvalue="2" maxvalue="64" default="2" access="initonly">
        <tr lang="en">number of inputs</tr>
        <tr lang="ru">количество входов</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet type="audio" number="1">
        <in>
          <tr lang="en">first input signal</tr>
          <tr lang="ru">первый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... input signal</tr>
          <tr lang="ru">... входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">n-th input signal</tr>
          <tr lang="ru">n-й входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output</tr>
          <tr lang="ru">выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[sig~ 1] [sig~ 2] [sig~ 3] [ui.hrd* 3]
|        |.       |..      |...
[gate~ 3             {i=4,o=3,w=30}]
*|*
[merge~ 3            {i=3,o=1,w=30}]
|
[ui.n~]

[ui.dsp~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
