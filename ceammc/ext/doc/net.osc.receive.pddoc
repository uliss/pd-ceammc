<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="net.osc.receive">
    <title>net.osc.receive</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">receives messages via the OSC protocol</tr>
        <tr lang="ru">получение сообщений по протоколу OSC</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>net</category>
      <keywords>osc net receive</keywords>
      <since>0.9.5</since>
      <also>
        <see>net.osc.server</see>
        <see>net.osc.send</see>
      </also>
      <aliases>
        <alias>net.osc.r</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">OSC type string: 'i' (int32), 'f' (float32), 's'/'S' (string), 'b' (blob),
        'h' (int64), 'd' (float64), 'c' (char), 'm' (MIDI), 'T' (true), 'F' (false), 'N' (nil), 'I'
        (inf)</tr>
        <tr lang="ru">строка типов OSC: 'i' (int32), 'f' (float32), 's'/'S' (строка), 'b' (blob),
        'h' (int64), 'd' (float64), 'c' (char), 'm' (MIDI), 'T' (истина), 'F' (ложь), 'N' (nil),
        'I' (бесконечность)</tr>
      </par>
    </info>
    <arguments>
      <argument name="PATH" type="symbol">
        <tr lang="en">OSC path to listen to</tr>
        <tr lang="ru">OSC-путь для прослушивания</tr>
      </argument>
      <argument name="SERVER" type="symbol">
        <tr lang="en">OSC server name</tr>
        <tr lang="ru">имя OSC-сервера</tr>
      </argument>
      <argument name="TYPES" type="symbol">
        <tr lang="en">expected OSC type string</tr>
        <tr lang="ru">ожидаемая строка типов OSC</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @path -->
      <property name="@path" type="symbol" default="">
        <tr lang="en">OSC path to listen to</tr>
        <tr lang="ru">OSC-путь для прослушивания</tr>
      </property>
      <!-- @server -->
      <property name="@server" type="symbol" default="default">
        <tr lang="en">OSC server name</tr>
        <tr lang="ru">имя OSC-сервера</tr>
      </property>
      <!-- @types -->
      <property name="@types" type="symbol" default="none">
        <tr lang="en">expected OSC type string</tr>
        <tr lang="ru">ожидаемая строка типов OSC</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control input</tr>
          <tr lang="ru">управляющий вход</tr>
        </in>
      </inlet>
      <inlet>
        <in on="symbol">
          <tr lang="en">set the OSC listen path</tr>
          <tr lang="ru">установить OSC-путь для прослушивания</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">OSC message output</tr>
          <tr lang="ru">выход OSC-сообщений</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*default OSC server: osc.udp://:9000*/ [net.osc.server TCP osc.tcp://:9001]

[net.osc.receive /x]                    [net.osc.receive /y TCP]
|                                       |
[ui.dt]                                 [ui.dt]


[send /x 1 2 3 4( [send /* 4 3 2 1(     [send /y ABC(
|                 |                     |
[net.osc.send osc.udp://:9000]          [net.osc.send osc.tcp://:9001]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
