<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="pan.linsig~">
        <title>pan.linsig~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">two channel linear panner with the signal control</tr>
                <tr lang="ru">двухканальное линейное панорамирование управляемое сигналом</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>pan span</keywords>
            <since>0.7</since>
            <also>
                <see>pan.sqrt~</see>
                <see>pan.cos~</see>
            </also>
        </meta>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo minvalue="-1" maxvalue="1">
                    <tr lang="en">pan position</tr>
                    <tr lang="ru" finished="false">положение</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">left output channel</tr>
                </out>
            </outlet>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">right output channel</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[osc.pulse~ 100]
|
[ui.gain~ @size 120 14]  [ui.dsp~]
|
|         [osc~ 1]
|         |.
[pan.linsig~]
|  ^|.
[dac~ ]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
