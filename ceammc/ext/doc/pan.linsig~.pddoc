<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="pan.linsig~">
    <title>pan.linsig~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">two-channel linear panner with signal control</tr>
        <tr lang="ru">двухканальный линейный панорамный регулятор с управлением сигналом</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>spat</category>
      <keywords>pan span</keywords>
      <since>0.7</since>
      <also>
        <see>pan.sqrt~</see>
        <see>pan.cos~</see>
      </also>
    </meta>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in minvalue="-1" maxvalue="1">
          <tr lang="en">pan position</tr>
          <tr lang="ru">позиция панорамирования</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left output channel</tr>
          <tr lang="ru">левый выходной канал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right output channel</tr>
          <tr lang="ru">правый выходной канал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[osc.pulse~ 100]
|
[ui.gain~ @size 120 14]  [ui.dsp~]
|
|         [osc~ 1]
|         |.
[pan.linsig~]
|  ^|.
[dac~ ]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
