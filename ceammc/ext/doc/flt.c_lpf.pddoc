<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="flt.c_lpf">
        <title>flt.c_lpf</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">LPF coefficients calculator for [flt.biquad~]</tr>
                <tr lang="ru">калькулятор коэффициентов ФНЧ для [flt.biquad~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter biquad lowpass</keywords>
            <since>0.9.2</since>
            <also>
                <see>flt.c_hpf</see>
            </also>
            <aliases>
                <alias>ceammc/lpf-&gt;biquad</alias>
                <alias>lpf-&gt;biquad</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Calculates coefficients for transfer function: H(z)=(b0 + b1*z⁻¹ +
                b2*z⁻²)/(1 + a1*z⁻¹ + a2*z⁻²)</tr>
            </par>
        </info>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="20" maxvalue="22050">
                <tr lang="en">center frequency</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="20" maxvalue="22050" default="1000"
            units="hertz">
                <tr lang="en">center frequency</tr>
            </property>
            <!-- @q -->
            <property name="@q" type="float" minvalue="0.01" maxvalue="100" default="0.7071">
                <tr lang="en">quality factor: @freq/BANDWIDTH</tr>
            </property>
            <!-- @rad -->
            <property name="@rad" type="flag" access="initonly">
                <tr lang="en">use angular frequency</tr>
            </property>
        </properties>
        <methods>
            <!-- bw -->
            <method name="bw">set bandwidth in octaves 
            <param name="OCT" type="float" required="true">
                <tr lang="en">bandwidth</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">filter frequency</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list: b0 b1 b2 a1 a2</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.hsl]                         [ui.hsl]
|                                |
[F]                              [F]
|                                |
[math.* expr(sr/2)]              [math.* pi()]
|                                |
[flt.c_lpf]                      [flt.c_lpf @rad]
|                                |
[ui.dt @float_width 5]           [ui.dt @float_width 5]




[flt.c_lpf-plot]
]]>
            </pdascii>
            <pdascii id="plot">
<![CDATA[
[ui.hsl]                       [array CLPF0 size=200 w=300 h=90]
|
[F]
|
[l->l 0 1 20 expr(sr/2-20)]
|
[flt.c_lpf @q 1]
|
[t b l ]                       [array CLPF1 size=200 w=300 h=90]
|     ^|
|    [msg biquad]
|    |
[flt.freqz @db 1]
|   ^|
|   [array.plot CLPF1]
|
[array.plot CLPF0 @nan 0]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
