<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="math.ceil">
        <title>math.ceil</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">round to the smallest integral value not less than input value</tr>
                <tr lang="ru">округление до наименьшего целого значения, которое не меньше
                входного</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math ceil</keywords>
            <also>
                <see>math.floor</see>
                <see>math.round</see>
                <see>math.trunc</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The ceil() function return the smallest integral value greater than
                or equal to input value.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
            </par>
            <par>
                <tr lang="en">ceil(+-0) returns +-0.</tr>
            </par>
            <par>
                <tr lang="en">ceil(+-infinity) returns +-infinity.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">input value</xinfo>
                <xinfo on="list">apply to all numeric values</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]    [2.3 3.8 5.5 -2.3 -3.8 -5.5(
|      |
[math.ceil]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
