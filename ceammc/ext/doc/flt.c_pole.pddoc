<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flt.c_pole">
        <title>flt.c_pole</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">оne-pole coefficient calculator for [flt.biquad~]</tr>
                <tr lang="ru">калькулятор однополюсного фильтра для [flt.biquad~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter biquad one pol</keywords>
            <since>0.9.2</since>
            <also>
                <see>flt.c_lpf</see>
            </also>
            <aliases>
                <alias>ceammc/pole-&gt;biquad</alias>
                <alias>pole-&gt;biquad</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Calculates coefficients for transfer function: H(z)=(b0 + b1*z⁻¹ +
                b2*z⁻²)/(1 + a1*z⁻¹ + a2*z⁻²)</tr>
            </par>
        </info>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="0" maxvalue="22050">
                <tr lang="en">center frequency</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="0" maxvalue="22050" default="1000"
            units="hertz">
                <tr lang="en">center frequency</tr>
            </property>
            <!-- @hpf -->
            <property name="@hpf" type="alias">
                <tr lang="en">ti @mode hpf</tr>
            </property>
            <!-- @lpf -->
            <property name="@lpf" type="alias">
                <tr lang="en">to @mode lpf</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" enum="hpf lpf" default="lpf">
                <tr lang="en">filter modey</tr>
            </property>
            <!-- @rad -->
            <property name="@rad" type="flag" access="initonly">
                <tr lang="en">use angular frequency</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">filter frequency</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list: b0 b1 b2 a1 a2</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.hsl]                         [ui.hsl]
|                                |
[F]                              [F]
|                                |
[math.* expr(sr/2)]              [math.* pi()]
|                                |
[flt.c_pole @lpf]                [flt.c_pole @rad @hpf]
|                                |
[ui.dt @float_width 5]           [ui.dt @float_width 5]




[flt.c_pole-plot]
]]>
            </pdascii>
            <pdascii id="plot">
<![CDATA[
[ui.hsl]                       [array C1P0 size=200 w=300 h=90]
|
[F]
|
[math.* sr()]
|
[flt.c_pole @lpf]
|
[t b l ]                       [array C1P1 size=200 w=300 h=90]
|     ^|
|    [msg biquad]
|    |
[flt.freqz @db 1]
|   ^|
|   [array.plot C1P1]
|
[array.plot C1P0 @nan 0]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
