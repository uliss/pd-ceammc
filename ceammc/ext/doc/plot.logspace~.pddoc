<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="plot.logspace~">
        <title>plot.logspace~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs numbers spaced evenly on a log scale</tr>
                <tr lang="ru">выводит последовательность равномерно распределенных по
                логарифмической шкале чисел</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array geom log scale</keywords>
            <also>
                <see>plot.linspace~</see>
                <see>plot.geomspace~</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">In linear space, the sequence starts at base^start (base to the power
                of start) and ends with base^stop (see @endpoint).</tr>
                <!-- old: В линейном пространстве последовательность
                начинается от base^start (база к мощности старта) и заканчивается base^stop (см.
                @endpoint). -->
                <tr lang="ru" finished="false">В линейном пространстве последовательность
                начинается от base^start (база к мощности старта) и заканчивается base^stop (см.
                @endpoint).</tr>
            </par>
        </info>
        <arguments>
            <argument name="START" type="float">
                <tr lang="en">@start property</tr>
                <tr lang="ru" finished="false">@Start Недвижимость</tr>
            </argument>
            <argument name="STOP" type="float">
                <tr lang="en">@stop property</tr>
                <tr lang="ru" finished="false">@stop Недвижимость</tr>
            </argument>
            <argument name="BASE" type="atom" enum="10 2 e">
                <tr lang="en">@base property</tr>
                <tr lang="ru" finished="false">Базовая собственность</tr>
            </argument>
            <argument name="N" type="int" minvalue="4" maxvalue="1024">
                <tr lang="en">@n property</tr>
                <tr lang="ru" finished="false">@n имущество</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @10 -->
            <property name="@10" type="atom">
                <tr lang="en">alias to @base 10</tr>
                <tr lang="ru" finished="false">Источник: @base 10</tr>
            </property>
            <!-- @2 -->
            <property name="@2" type="atom">
                <tr lang="en">alias to @base 2</tr>
                <tr lang="ru" finished="false">Оригинальное название: @base 2</tr>
            </property>
            <!-- @base -->
            <property name="@base" type="atom" enum="10 2 e" default="10">
                <tr lang="en">x-axis scale base</tr>
                <tr lang="ru" finished="false">x-осевая шкала</tr>
            </property>
            <!-- @e -->
            <property name="@e" type="atom">
                <tr lang="en">alias to @base e</tr>
                <tr lang="ru" finished="false">Источник: @base e</tr>
            </property>
            <!-- @endpoint -->
            <property name="@endpoint" type="bool" default="1">
                <tr lang="en">include @stop to interval</tr>
                <tr lang="ru" finished="false">Включите @stop в интервал</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" minvalue="4" maxvalue="1024" default="100">
                <tr lang="en">number of points</tr>
                <tr lang="ru" finished="false">количество точек</tr>
            </property>
            <!-- @start -->
            <property name="@start" type="float" default="0">
                <tr lang="en">starting value of the sequence: base^start</tr>
                <!-- old: Начальное значение последовательности:
                base^start -->
                <tr lang="ru" finished="false">Начальное значение последовательности:
                base^start</tr>
            </property>
            <!-- @stop -->
            <property name="@stop" type="float" default="2">
                <tr lang="en">the final value (base^stop) of the sequence, unless @endpoint is
                false. In that case, @n + 1 values are spaced over the interval in log-space, of
                which all but the last (a sequence of length @n) are returned.</tr>
                <!-- old: конечное значение (base^stop) последовательности,
                если только @endpoint не является ложным. В этом случае значения @n + 1 размещаются
                через интервал в пространстве журнала, из которого возвращаются все, кроме
                последнего (последовательность длины @n). -->
                <tr lang="ru" finished="false">конечное значение (base^stop) последовательности,
                если только @endpoint не является ложным. В этом случае значения @n + 1 размещаются
                через интервал в пространстве журнала, из которого возвращаются все, кроме
                последнего (последовательность длины @n).</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">starts output</tr>
                    <tr lang="ru" finished="false">Начинается вывод</tr>
                </in>
                <in on="float">
                    <tr lang="en">output specified number of values, change @n property valuue</tr>
                    <!-- old: выход заданного количества значений, изменение
                    @n стоимости имущества -->
                    <tr lang="ru" finished="false">выход заданного количества значений, изменение
                    @n стоимости имущества</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">signal output</tr>
                    <tr lang="ru" finished="false">выход сигнала</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">output to [array.plot~] or [ui.plot~]</tr>
                    <tr lang="ru" finished="false">[array.plot~] или [ui.plot~]</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
|
[plot.logspace~ 1 4 @10]
|      ^|.
[ui.plot~ @size 400 150 @xlabels 1 @ylabels 1 @xmin_grid 1 @ymin_ticks 0 @xmin_ticks 0 @yauto 1]










[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
