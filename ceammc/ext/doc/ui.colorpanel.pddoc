<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.colorpanel" type="gui">
        <title>ui.colorpanel</title>
        <meta>
            <authors>
                <author>Pierre Guillot</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">colorchooser widget</tr>
                <tr lang="ru">виджет выбора цвета</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui color choose</keywords>
            <since>0.1</since>
            <also>
                <see view="link">ui.number</see>
            </also>
        </meta>
        <mouse>
            <event type="left-click" editmode="false">choose and output selected color</event>
            <event type="move" editmode="false">hover color</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_background_color.xml" />
            <!-- @border_color -->
            <property name="@border_color" type="list" default="0.6 0.6 0.6 1">
                <tr lang="en">border color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @fontname -->
            <property name="@fontname" type="symbol" default="Helvetica"
            enum="Courier DejaVu Helvetica Monaco Times">
                <tr lang="en">fontname</tr>
            </property>
            <!-- @fontsize -->
            <property name="@fontsize" type="int" minvalue="4" maxvalue="100" default="11">
                <tr lang="en">fontsize</tr>
            </property>
            <!-- @fontslant -->
            <property name="@fontslant" type="symbol" enum="roman italic" default="roman">
                <tr lang="en">font slant</tr>
            </property>
            <!-- @fontweight -->
            <property name="@fontweight" type="symbol" enum="normal bold" default="normal">
                <tr lang="en">font weight</tr>
            </property>
            <!-- @hex -->
            <property name="@hex" type="symbol" access="readonly" default="">
                <tr lang="en">HEX value in format #RRGGBB</tr>
            </property>
            <!-- @hsl -->
            <property name="@hsl" type="list" access="readonly" default="">
                <tr lang="en">HSL value triplet on 0-1 range</tr>
            </property>
            <!-- @hue -->
            <property name="@hue" type="float" default="0" minvalue="0" maxvalue="1">
                <tr lang="en">first hue</tr>
            </property>
            <!-- @index -->
            <property name="@index" type="list" default="">
                <tr lang="en">color position in panel</tr>
            </property>
            <!-- @lightness -->
            <property name="@lightness" type="float" default="1" minvalue="0" maxvalue="1">
                <tr lang="en">first lightness</tr>
            </property>
            <!-- @matrix -->
            <property name="@matrix" type="list" default="24 13">
                <tr lang="en">matrix size</tr>
            </property>
            <!-- @pd -->
            <property name="@pd" type="int" access="readonly" default="0">
                <tr lang="en">pd color value</tr>
            </property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="0">
                <tr lang="en">pin mode. if 1 - put element to the lowest level</tr>
            </property>
            <!-- @presetname -->
            <property name="@presetname" type="symbol" default="(null)">
                <tr lang="en">preset name for using with [ui.preset]</tr>
            </property>
            <!-- @receive -->
            <property name="@receive" type="symbol" default="(null)">
                <tr lang="en">receive source</tr>
            </property>
            <!-- @reverse -->
            <property name="@reverse" type="bool" default="0">
                <tr lang="en">matrix reversed</tr>
            </property>
            <!-- @rgb -->
            <property name="@rgb" type="list" access="readonly" default="">
                <tr lang="en">RGB value triplet on 0-1 range</tr>
            </property>
            <!-- @saturation -->
            <property name="@saturation" type="float" default="1" minvalue="0" maxvalue="1">
                <tr lang="en">saturation</tr>
            </property>
            <!-- @send -->
            <property name="@send" type="symbol" default="(null)">
                <tr lang="en">send destination</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="181 105">
                <tr lang="en">element size (width, height pair)</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">clears specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
            <!-- interp -->
            <method name="interp">for this object acts as *load*, no interpolation
            performed</method>
            <!-- load -->
            <method name="load">loads specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
            <!-- set -->
            <method name="set">set widget value with no output 
            <param name="COL" type="int" required="true">column index</param>
            <param name="ROW" type="int" required="true">row index</param></method>
            <!-- store -->
            <method name="store">stores specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">outputs current widget value</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output values: @pd COLOR, @rgb in range [0-1], @hsl in range [0-1],
            @hex</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.colorpanel #a]       [ui.colorpanel @size 193 14]
|                        |
|                        |
|                        [route @rgb]
|                        |
|                        [msg @background_color]
|                        |
|                        [ui.radio]
|
[route @pd] [print COLOR #x]
|
[color $1(
|
[tgl]

[X a->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
