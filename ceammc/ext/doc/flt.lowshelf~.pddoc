<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="flt.lowshelf~">
        <title>flt.lowshelf~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">gain boost|cut below some frequency</tr>
                <tr lang="ru">усиление или ослабление частот ниже указанной</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter lowshelf</keywords>
            <since>0.1</since>
            <also>
                <see>flt.highshelf~</see>
                <see>flt.c_lowshelf~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="20" maxvalue="20000">
                <tr lang="en">corner frequency for the shelf</tr>
            </argument>
            <argument name="GAIN" type="float" units="decibel" minvalue="-15" maxvalue="15">
                <tr lang="en">amount of boost or cut apply to the signal</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" units="hertz" minvalue="20" maxvalue="20000"
            default="1000">
                <tr lang="en">corner frequency for the shelf</tr>
            </property>
            <!-- @gain -->
            <property name="@gain" type="float" units="decibel" minvalue="-15" maxvalue="15"
            default="0">
                <tr lang="en">amount of boost or cut apply to the signal</tr>
            </property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">filtered signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[noise~]   [F]         [F]
|          |           |
|          [@freq $1(  [@gain $1(
|          |           |
|          |           |
|          |           |
[flt.lowshelf~ 3000  -15]
|
[ui.gain~ @size 120 14] [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
