<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="synth.piano~">
        <title>synth.piano~</title>
        <meta>
            <authors>
                <author>Romain Michon</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">waveguide commuted piano</tr>
                <tr lang="ru">фортепиано на основе техники связанного волноводного синтеза</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>piano model synth</keywords>
            <since>0.9.2</since>
        </meta>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @brightness -->
            <property name="@brightness" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">brightness</tr>
            </property>
            <!-- @detuning -->
            <property name="@detuning" type="float" minvalue="0" maxvalue="1" default="0.1">
                <tr lang="en">detuning factor</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" units="hertz" default="130.8128">
                <tr lang="en">frequency</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">play trigger - 1: on, 0: off</tr>
            </property>
            <!-- @hammer_hardness -->
            <property name="@hammer_hardness" type="float" minvalue="0" maxvalue="1" default="0.1">
                <tr lang="en">hammer hardness</tr>
            </property>
            <!-- @pan -->
            <property name="@pan" type="float" minvalue="0" maxvalue="1" default="0.6">
                <tr lang="en">pan angle</tr>
            </property>
            <!-- @pitch -->
            <property name="@pitch" type="float" minvalue="21" maxvalue="108" default="48">
                <tr lang="en">midi pitch</tr>
            </property>
            <!-- @reverb_gain -->
            <property name="@reverb_gain" type="float" minvalue="0" maxvalue="1" default="0.137">
                <tr lang="en">reverb gain</tr>
            </property>
            <!-- @room_size -->
            <property name="@room_size" type="float" minvalue="0.005" maxvalue="1" default="0.36">
                <tr lang="en">reverb room size</tr>
            </property>
            <!-- @stiffness -->
            <property name="@stiffness" type="float" minvalue="0" maxvalue="1" default="0.28">
                <tr lang="en">stiffness factor</tr>
            </property>
            <!-- @width -->
            <property name="@width" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">spatialization width</tr>
            </property>
        </properties>
        <methods>
            <!-- note -->
            <method name="note">note on/off message 
            <param name="NOTE" type="float" required="true">
                <tr lang="en">midi note</tr>
            </param>
            <param name="VEL" type="float" minvalue="0" maxvalue="127" required="true">
                <tr lang="en">velocity</tr>
            </param></method>
            <!-- reset -->
            <method name="reset">reset synth</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="list">NOTE VEL</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">left output</outlet>
            <outlet type="audio">right output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|.
[midi.kbd qwerty 0]
|
[ui.hk]
|
|
|
|
|
[poly 6 {i=1,o=3}]
*|*
[pack f f f {i=3,o=1}]
|
[clone 7 poly.obj synth.piano~ {i=1,o=1}]
|
[ui.hgain~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
