<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="synth.piano~">
        <title>synth.piano~</title>
        <meta>
            <authors>
                <author>Romain Michon</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">waveguide commuted piano</tr>
                <tr lang="ru">фортепиано на основе техники связанного волноводного синтеза</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>piano model synth</keywords>
            <since>0.9.2</since>
        </meta>
        <properties>
            <xi:include href="props_osc.xml"/>
            <xi:include href="props_id.xml"/>
            <xi:include href="props_active.xml"/>
            <!-- @brightness -->
            <property name="@brightness" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">brightness</tr>
                <tr lang="ru" finished="false">яркость</tr>
            </property>
            <!-- @detuning -->
            <property name="@detuning" type="float" minvalue="0" maxvalue="1" default="0.1">
                <tr lang="en">detuning factor</tr>
                <tr lang="ru" finished="false">коэффициент отключения</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" units="hertz" default="130.8128">
                <tr lang="en">frequency</tr>
                <tr lang="ru" finished="false">частота</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">play trigger - 1: on, 0: off</tr>
                <tr lang="ru" finished="false">играть триггер - 1: on, 0: off</tr>
            </property>
            <!-- @hammer_hardness -->
            <property name="@hammer_hardness" type="float" minvalue="0" maxvalue="1" default="0.1">
                <tr lang="en">hammer hardness</tr>
                <tr lang="ru" finished="false">твердость молота</tr>
            </property>
            <!-- @pan -->
            <property name="@pan" type="float" minvalue="0" maxvalue="1" default="0.6">
                <tr lang="en">pan angle</tr>
                <tr lang="ru" finished="false">угол наклона</tr>
            </property>
            <!-- @pitch -->
            <property name="@pitch" type="float" minvalue="21" maxvalue="108" default="48">
                <tr lang="en">midi pitch</tr>
                <tr lang="ru" finished="false">миди-питч</tr>
            </property>
            <!-- @reverb_gain -->
            <property name="@reverb_gain" type="float" minvalue="0" maxvalue="1" default="0.137">
                <tr lang="en">reverb gain</tr>
                <tr lang="ru" finished="false">реверберация прибыль</tr>
            </property>
            <!-- @room_size -->
            <property name="@room_size" type="float" minvalue="0.005" maxvalue="1" default="0.36">
                <tr lang="en">reverb room size</tr>
                <tr lang="ru" finished="false">размер комнаты реверберации</tr>
            </property>
            <!-- @stiffness -->
            <property name="@stiffness" type="float" minvalue="0" maxvalue="1" default="0.28">
                <tr lang="en">stiffness factor</tr>
                <tr lang="ru" finished="false">коэффициент жесткости</tr>
            </property>
            <!-- @width -->
            <property name="@width" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">spatialization width</tr>
                <tr lang="ru" finished="false">ширина пространства</tr>
            </property>
        </properties>
        <methods>
            <!-- note -->
            <method name="note">
                <info>
                    <tr lang="en">note on/off message</tr>
                    <tr lang="ru" finished="false">примечание/выключение сообщения</tr>
                </info>
                <param name="NOTE" type="float" required="true">
                    <tr lang="en">midi note</tr>
                    <tr lang="ru" finished="false">нота миди</tr>
                </param>
                <param name="VEL" type="float" minvalue="0" maxvalue="127" required="true">
                    <tr lang="en">velocity</tr>
                    <tr lang="ru" finished="false">скорость</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset synth</tr>
                    <tr lang="ru" finished="false">Сбросить синтезатор</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">NOTE VEL</tr>
                    <tr lang="ru" finished="false">Примечание VEL</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">left output</tr>
                    <tr lang="ru" finished="false">левый выход</tr>
                </out>
            </outlet>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">right output</tr>
                    <tr lang="ru" finished="false">правильный выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|.
[midi.kbd qwerty 0]
|
[ui.hk]
|
|
|
|
|
[poly 6 {i=1,o=3}]
*|*
[pack f f f {i=3,o=1}]
|
[clone 7 poly.obj synth.piano~ {i=1,o=1}]
|
[ui.hgain~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
