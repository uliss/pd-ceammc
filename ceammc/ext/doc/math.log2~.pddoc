<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="math.log2~">
        <title>math.log2~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">base-2 logarithm for signals</tr>
                <tr lang="ru">логарифм по основанию 2 для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math log2</keywords>
            <also>
                <see>math.exp2~</see>
                <see>math.log2</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Outputs the value of the logarithm of argument x to base 2</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
            </par>
            <par>
                <tr lang="en">log2(1) return +0.</tr>
            </par>
            <par>
                <tr lang="en">log2(+infinity) return +infinity.</tr>
            </par>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo>input signal</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">result signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[plot.linspace~ -5 32]
|                 ^|
[math.log2~]       |
|                  |.
[ui.plot~ @xlabels 1 @ylabels 1 @ymin -5 @ymax 5 @size 400 200]














[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
