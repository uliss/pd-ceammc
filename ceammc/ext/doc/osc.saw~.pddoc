<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="osc.saw~">
        <title>osc.saw~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">alias-free sawtooth wave</tr>
                <tr lang="ru">осциллятор пилообразного сигнала с ограниченным спектром</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>osc</category>
            <keywords>oscillator band-limited</keywords>
            <since>0.1</since>
            <also>
                <see>osc.saw4~</see>
                <see>osc.tri~</see>
                <see>osc.square~</see>
                <see>lfo.tri~</see>
            </also>
        </meta>
        <info>
            <par>Polynomial Transition Regions (PTR) used for aliasing suppression. 2nd order
            interpolation.</par>
        </info>
        <arguments>
            <argument name="FREQ" type="float" minvalue="0.0" maxvalue="22050" units="hertz">See
            @freq</argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1">on/off dsp processing</property>
            <!-- @freq -->
            <property name="@freq" type="float" default="0" minvalue="0" maxvalue="22050"
            units="hertz">frequency</property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo on="float">frequency in Hz</xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">reset phase</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]      [ui.dsp~]
|
[$1 50(
|
[line~]  [bang(
|        |.
[osc.saw~ ]
|
[ui.gain~ @size 120 14]
|\       |
[dac~]   [ui.spectroscope~ @size 150 100]





[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
