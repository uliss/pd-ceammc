<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="global.int">
        <title>global.int</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">global named integer object</tr>
                <tr lang="ru">глобальной именованное целое число</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>global</category>
            <keywords>int global</keywords>
            <since>0.1</since>
            <also>
                <see>global.float</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Defines global scope integer variable, accessed by ID name.</tr>
            </par>
        </info>
        <arguments>
            <argument name="ID" type="symbol">
                <tr lang="en">object ID</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @id -->
            <property name="@id" type="symbol" access="initonly" default="default">
                <tr lang="en">global variable id</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="int" access="readonly" default="0">
                <tr lang="en">current value</tr>
            </property>
        </properties>
        <methods>
            <!-- * -->
            <method name="*">
                <info>
                    <tr lang="en">multiply to, no output</tr>
                </info>
            </method>
            <!-- + -->
            <method name="+">
                <info>
                    <tr lang="en">add to int, no output</tr>
                </info>
            </method>
            <method name="-">
                <info>
                    <tr lang="en">substruct from int, no output</tr>
                </info>
            </method>
            <!-- / -->
            <method name="/">
                <info>
                    <tr lang="en">divide by, no output</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">sets new value without output</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">outputs variable</xinfo>
                <xinfo on="float">set truncated integer and outputs</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="control">int output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]   [+ 2, bang(    [* 3, bang(    [bang(
|     |              |              |
|     |              |              |
|     |  [- 3, bang( | [/ 2, bang(  |
|     |  |           | |            |
|     |  | [set 2(   | |            |
|     |  | |         | |            |
[global.int          f1]            [global.int f1]
|                                   |
[F]                                 [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
