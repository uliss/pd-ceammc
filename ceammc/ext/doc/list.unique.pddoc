<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.unique">
        <title>list.unique</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">removes duplicates from the list</tr>
                <tr lang="ru">удаляет дубликаты из списка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list unique sort</keywords>
            <since>0.1</since>
            <also>
                <see>list.sort</see>
            </also>
        </meta>
        <properties>
            <!-- @stable -->
            <property name="@stable" type="bool" default="1">
                <tr lang="en">if true - preserves element appearing order</tr>
                <tr lang="ru" finished="false">Если верно - сохраняет элемент порядка</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                    <tr lang="ru" finished="false">вводный список</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                    <tr lang="ru" finished="false">входной млечный</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output list</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 1 3 6 9 -1 3(
|
|
[list.unique]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
