<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="lfo.pulse~">
        <title>lfo.pulse~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">full-range unit-amplitude low frequency pulse train</tr>
                <tr lang="ru">прямоугольная низкочастотная волна единичной амплитуды в диапазоне
                [-1,+1]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>lfo</category>
            <keywords>lfo oscillator pulse train</keywords>
            <since>0.6</since>
            <also>
                <see>lfo.+pulse~</see>
                <see>lfo.square~</see>
                <see>lfo.impulse~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="0" maxvalue="1000">
                <tr lang="en">initial frequency</tr>
                <tr lang="ru" finished="false">Начальная частота</tr>
            </argument>
            <argument name="DUTY" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">duty cycle</tr>
                <tr lang="ru" finished="false">дежурный цикл</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @duty -->
            <property name="@duty" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">duty cycle</tr>
                <tr lang="ru" finished="false">дежурный цикл</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" default="0" minvalue="0" maxvalue="1000"
            units="hertz">
                <tr lang="en">initial frequency</tr>
                <tr lang="ru" finished="false">Начальная частота</tr>
            </property>
            <!-- @pause -->
            <property name="@pause" type="bool" default="0">
                <tr lang="en">pause oscillator at current value</tr>
                <tr lang="ru" finished="false">осциллятор паузы при текущем значении</tr>
            </property>
            <!-- @phase -->
            <property name="@phase" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">initial phase</tr>
                <tr lang="ru" finished="false">начальный этап</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                    <tr lang="ru" finished="false">Перезагрузка в начальное состояние</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">frequency in Hz</tr>
                    <tr lang="ru" finished="false">частота в Гц</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">reset phase</tr>
                    <tr lang="ru" finished="false">фаза сброса</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">pulsetrain wave in [-1, +1] range</tr>
                    <tr lang="ru" finished="false">импульсная волна в [-1, +1] диапазоне</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]      [ui.knob]                   [ui.dsp~]
|        |
|        |
|        [@duty $1(
|        |
[lfo.pulse~ 46]
|
|
[ui.scope~ @size=300x100 @max=1.25 @min=-1.25]







[lfo.pulse~-sound]
]]>
            </pdascii>
            <pdascii id="sound">
<![CDATA[
[osc.saw~ 100]          [ui.knob]
|                       |
[ui.gain~ @size 120 14] |
|                       |
|              [F]      [@duty $1(
|              |        |
|              [lfo.pulse~ 2]
|          .___/
[pan.linsig~]           [ui.dsp~]
|  ^|.
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
