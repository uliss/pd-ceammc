<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="lfo.pulse~">
        <title>lfo.pulse~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">full-range unit-amplitude low frequency pulse train</tr>
                <tr lang="ru">прямоугольная низкочастотная волна единичной амплитуды в диапазоне
                [-1,+1]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>lfo</category>
            <keywords>lfo oscillator pulse train</keywords>
            <since>0.6</since>
            <also>
                <see>lfo.+pulse~</see>
                <see>lfo.square~</see>
                <see>lfo.impulse~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="0" maxvalue="1000">initial
            frequency</argument>
            <argument name="DUTY" type="float" minvalue="0" maxvalue="1">duty cycle</argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1">on/off dsp processing</property>
            <!-- @duty -->
            <property name="@duty" type="float" minvalue="0" maxvalue="1" default="0.5">duty
            cycle</property>
            <!-- @freq -->
            <property name="@freq" type="float" default="0" minvalue="0" maxvalue="1000"
            units="hertz">initial frequency</property>
            <!-- @pause -->
            <property name="@pause" type="bool" default="0">pause oscillator at current
            value</property>
            <!-- @phase -->
            <property name="@phase" type="float" minvalue="0" maxvalue="1" default="0">initial
            phase</property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">reset to initial state</method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>frequency in Hz</xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">reset phase</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">pulsetrain wave in [-1, +1] range</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]      [ui.knob]                   [ui.dsp~]
|        |
|        |
|        [@duty $1(
|        |
[lfo.pulse~ 46]
|
|
[ui.scope~ @size=300x100 @max=1.25 @min=-1.25]







[lfo.pulse~-sound]
]]>
            </pdascii>
            <pdascii id="sound">
<![CDATA[
[osc.saw~ 100]          [ui.knob]
|                       |
[ui.gain~ @size 120 14] |
|                       |
|              [F]      [@duty $1(
|              |        |
|              [lfo.pulse~ 2]
|          .___/
[pan.linsig~]           [ui.dsp~]
|  ^|.
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
