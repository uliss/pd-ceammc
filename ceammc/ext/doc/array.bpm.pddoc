<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="array.bpm">
        <title>array.bpm</title>
        <meta>
            <authors>
                <author>Olli Parviainen</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">BPM calculator</tr>
                <tr lang="ru">вычисление BPM</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array bpm</keywords>
            <since>0.4</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Calculates BPM (Beats Per Minute) rate using SoundTouch library</tr>
                <tr lang="ru">Расчет BPM (Beats Per Minute) с помощью библиотеки SoundTouch</tr>
            </par>
        </info>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">starts calculation</tr>
                    <tr lang="ru" finished="false">Начинается расчет</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">float value - BPM</tr>
                    <tr lang="ru" finished="false">Поплавковая стоимость - BPM</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]                                 [array A1]
|
[openpanel]
|
[load $1 @to A1 @resize(
|
[snd.file]
|
[bng]
|
[array.bpm A1]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
