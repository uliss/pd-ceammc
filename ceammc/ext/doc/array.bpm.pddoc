<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.bpm">
    <title>array.bpm</title>
    <meta>
      <authors>
        <author>Olli Parviainen</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">BPM calculator</tr>
        <tr lang="ru">вычисление BPM</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array bpm</keywords>
      <since>0.4</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Calculates the BPM (Beats Per Minute) rate using the SoundTouch library. The
        audio data is taken from the specified array. On bang, the object analyzes the array and
        outputs the detected tempo as a float.</tr>
        <tr lang="ru">Вычисляет темп в BPM (Beats Per Minute) с помощью библиотеки SoundTouch.
        Аудиоданные берутся из указанного массива. При получении bang объект анализирует массив и
        выводит определённый темп в виде числа с плавающей точкой.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">starts the BPM calculation on the current array</tr>
          <tr lang="ru">запускает вычисление BPM по текущему массиву</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">beats per minute</tr>
          <tr lang="ru">BPM — количество ударов в минуту</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                                 [array A1]
|
[openpanel]
|
[load $1 @to A1 @resize(
|
[snd.file]
|
[bng]
|
[array.bpm A1]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
