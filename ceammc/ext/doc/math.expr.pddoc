<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="math.expr">
        <title>math.expr</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">dynamic version of [expr] object</tr>
                <tr lang="ru">динамическая версия объекта [expr]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math expr</keywords>
            <since>0.6</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Operators: +, -, *, /, %, &lt;, &lt;=, &gt;=, &gt;, ==, !=</tr>
            </par>
            <par>
                <tr lang="en">Functions: sin(), cos(), tan(), atan(), sqrt(), ln(), log2(),
                log10(), exp(), round(), ceil(), float(), fact(), min(), max(), sign(), abs()</tr>
            </par>
            <par>
                <tr lang="en">Constants: $pi, $e</tr>
            </par>
            <par>
                <tr lang="en">Variables: $f, $f0, $f1 ... $f9</tr>
            </par>
            <par>
                <tr lang="en">Array access: array1[$f]</tr>
            </par>
        </info>
        <arguments>
            <argument name="EXPR" type="list">
                <tr lang="en">expression</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @expr -->
            <property name="@expr" type="list" default="">
                <tr lang="en">expression</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">input value (referenced as $f0 or $f in expression)</xinfo>
                <xinfo on="list">input values (referenced as $f0 ... $f9 in expression)</xinfo>
            </inlet>
            <inlet>
                <xinfo>change expression</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>calculated expression</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]          [$f * 2( [$f*$pi/180( /*change expression*/
|            |        |
| [@expr?(   [list    ]
| |          |.
[math.expr sin($f)]
|
[prop-> @expr  ]
|     ^|
|     [ui.dt]
|
[F digits=10]


[14 2 1( [1 3 4( /*lists*/
|        |
[math.expr $f0^2 + $f0 * $f1 + $f2]
|
[F]

[F]                 [F]                  [F]
|                   |                    |
[math.expr abs($f)] [math.expr sign($f)] [math.expr sqrt($f)]
|                   |                    |
[F]                 [F]                  [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
