<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.serial">
    <title>hw.serial</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">serial port device</tr>
        <tr lang="ru">устройство последовательного порта</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>serial</keywords>
      <since>0.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Reads and writes data over a serial port. The object can send byte values
        to a connected device (as a single float or as a list of floats in the [0, 255] range) and
        outputs each byte received from the port. The port and baud rate can be set with arguments
        or properties; the list of available serial devices is available in @devices.</tr>
        <tr lang="ru">Читает и записывает данные через последовательный порт. Объект может
        отправлять байтовые значения подключённому устройству (как одно число или как список
        чисел в диапазоне [0, 255]) и выводит каждый байт, полученный из порта. Порт и скорость
        передачи задаются аргументами или свойствами; список доступных устройств доступен в
        @devices.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Arduino and microcontroller control — sending and receiving byte commands
        from an Arduino, Teensy or similar board, for example to drive motors, relays or LEDs, or
        to read sensor values.</tr>
        <tr lang="ru">• Управление Arduino и микроконтроллерами — отправка и приём байтовых команд
        от Arduino, Teensy или аналогичной платы, например для управления моторами, реле или
        светодиодами, либо для чтения значений с сенсоров.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Hardware synthesizers and MIDI interfaces — communicating with devices
        that use serial protocols, for example some older synthesizers, DMX controllers or custom
        hardware over USB-serial converters.</tr>
        <tr lang="ru">• Аппаратные синтезаторы и MIDI-интерфейсы — обмен данными с устройствами,
        использующими последовательные протоколы, например с некоторыми старыми синтезаторами,
        DMX-контроллерами или собственным оборудованием через USB-serial переходники.</tr>
      </par>
    </info>
    <arguments>
      <argument name="RATE" type="int"
      enum="110 115200 1200 128000 14400 19200 2400 256000 300 38400 4800 56000 57600 600 9600">
        <tr lang="en">serial baud rate</tr>
        <tr lang="ru">скорость передачи (baud rate)</tr>
      </argument>
      <argument name="PORT" type="symbol">
        <tr lang="en">serial device or port name, e.g. COM3 on Windows, /dev/ttyACM0 on Linux and
        /dev/cu.usbmodem411 on macOS</tr>
        <tr lang="ru">последовательное устройство или имя порта, например COM3 на Windows,
        /dev/ttyACM0 на Linux и /dev/cu.usbmodem411 на macOS</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @devices -->
      <property name="@devices" type="list" access="readonly" default="">
        <tr lang="en">list of found serial devices</tr>
        <tr lang="ru">список найденных последовательных устройств</tr>
      </property>
      <!-- @port -->
      <property name="@port" type="symbol" default="">
        <tr lang="en">name of serial port, e.g. COM3 on Windows, /dev/ttyACM0 on Linux and
        /dev/cu.usbmodem411 on macOS</tr>
        <tr lang="ru">имя последовательного порта, например COM3 на Windows, /dev/ttyACM0 на
        Linux и /dev/cu.usbmodem411 на macOS</tr>
      </property>
      <!-- @rate -->
      <property name="@rate" type="int" default="57600"
      enum="110 300 600 1200 2400 4800 9600 14400 19200 38400 56000 57600 115200 128000 256000">
        <tr lang="en">serial baud rate</tr>
        <tr lang="ru">скорость передачи (baud rate)</tr>
      </property>
    </properties>
    <methods>
      <!-- close -->
      <method name="close">
        <info>
          <tr lang="en">disconnects from the device</tr>
          <tr lang="ru">отключается от устройства</tr>
        </info>
      </method>
      <!-- open -->
      <method name="open">
        <info>
          <tr lang="en">connects to the device</tr>
          <tr lang="ru">подключается к устройству</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">sends a float value in the byte range [0, 255] to the serial port</tr>
          <tr lang="ru">отправляет числовое значение в байтовом диапазоне [0, 255] в
          последовательный порт</tr>
        </in>
        <in on="list">
          <tr lang="en">sends a list of floats in the byte range [0, 255] to the serial port</tr>
          <tr lang="ru">отправляет список чисел в байтовом диапазоне [0, 255] в последовательный
          порт</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">outputs the received byte from the serial port</tr>
          <tr lang="ru">выводит полученный из последовательного порта байт</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[@devices?(
|
[hw.serial]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
