<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="hw.serial">
        <title>hw.serial</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">serial port device</tr>
                <tr lang="ru">серийный порт устройства</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>serial</keywords>
            <since>0.5</since>
        </meta>
        <arguments>
            <argument name="RATE" type="int"
            enum="110 115200 1200 128000 14400 19200 2400 256000 300 38400 4800 56000 57600 600 9600">

                <tr lang="en">serial baud rate</tr>
                <tr lang="ru" finished="false">серийный бауд</tr>
            </argument>
            <argument name="PORT" type="symbol">
                <tr lang="en">serial device or port name, eg.: COM3 on Windows, /dev/ttyACM0 on
                Linux and /dev/cu.usbmodem411 on MacOSX</tr>
                <tr lang="ru">последовательное устройство или название порта, например: COM3 на
                Windows, /dev/ttyACM0 на Linux и /dev/cu.usbmodem411 на MacOSX</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @devices -->
            <property name="@devices" type="list" access="readonly" default="">
                <tr lang="en">list of found serial devices</tr>
                <tr lang="ru">список найденных серийных устройств</tr>
            </property>
            <!-- @port -->
            <property name="@port" type="symbol" default="">
                <tr lang="en">name of serial port, eg.: COM3 on Windows, /dev/ttyACM0 on Linux and
                /dev/cu.usbmodem411 on MacOSX</tr>
                <tr lang="ru">последовательное устройство или название порта: COM3 на Windows,
                /dev/ttyACM0 на Linux и /dev/cu.usbmodem411 на MacOSX</tr>
            </property>
            <!-- @rate -->
            <property name="@rate" type="int" default="57600"
            enum="110 300 600 1200 2400 4800 9600 14400 19200 38400 56000 57600 115200 128000 256000">

                <tr lang="en">serial baud rate</tr>
                <tr lang="ru">скорость передачи</tr>
            </property>
        </properties>
        <methods>
            <!-- close -->
            <method name="close">disconnect from device</method>
            <!-- open -->
            <method name="open">connect to device</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">sends float value in byte range [0-255] to serial port</xinfo>
                <xinfo on="list">sends list of floats in byte range [0-255] to serial port</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>outputs received byte from serial port</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[@devices?(
|
[hw.serial]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
