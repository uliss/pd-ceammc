<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="math.atanh">
        <title>math.atanh</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">inverse hyperbolic tangent function</tr>
                <tr lang="ru">обратный гиперболический тангенс</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math atanh</keywords>
            <also>
                <see>math.acosh</see>
                <see>math.asinh</see>
                <see>math.exp</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The atanh() function computes the inverse hyperbolic tangent of the
                real argument input value.</tr>
                <!-- old: Функция Atanh() вычисляет обратный гиперболический
                тангенс реального входного значения аргумента. -->
                <tr lang="ru" finished="false">Функция Atanh() вычисляет обратный гиперболический
                тангенс реального входного значения аргумента.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
                <tr lang="ru" finished="false">Особые ценности:</tr>
            </par>
            <par>
                <tr lang="en">atanh(+-0) returns +-0.</tr>
                <tr lang="ru" finished="false">Atanh (+-0) возвращается +-0.</tr>
            </par>
            <par>
                <tr lang="en">atanh(+-1) returns +-infinity and raises the "divide-by-zero"
                floating- point exception.</tr>
                <!-- old: Atanh(+-1) возвращает +-бесконечность и поднимает
                «раздел на ноль» исключение из плавающей точки. -->
                <tr lang="ru" finished="false">Atanh(+-1) возвращает +-бесконечность и поднимает
                «раздел на ноль» исключение из плавающей точки.</tr>
            </par>
            <par>
                <tr lang="en">atanh(x) returns a NaN and raises the "invalid" floating-point
                exception for |x| &gt; 1.</tr>
                <!-- old: Atanh(x) возвращает NaN и поднимает
                «недействительное» исключение с плавающей точкой для |x | > 1. -->
                <tr lang="ru" finished="false">Atanh(x) возвращает NaN и поднимает
                «недействительное» исключение с плавающей точкой для |x | &gt; 1.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">input value</tr>
                    <tr lang="ru" finished="false">входная стоимость</tr>
                </in>
                <in on="list">
                    <tr lang="en">apply to all numeric values</tr>
                    <tr lang="ru" finished="false">применяется ко всем числовым значениям</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result value</tr>
                    <tr lang="ru" finished="false">значение результата</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[math.atanh]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
