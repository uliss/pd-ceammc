<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="hw.rpi.display.hd44780">
        <title>hw.rpi.display.hd44780</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">LCD display driver for Raspberry Pi (1602 or 2004 module)</tr>
                <tr lang="ru">драйвер для ЖКИ дисплея (1602 или 2004 модуль) для Raspberry Pi</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display 1602 2004 lcd i2c rpi</keywords>
            <since>0.9.8</since>
            <aliases>
                <alias>hw.rpi.display.lcd1602</alias>
                <alias>hw.rpi.display.lcd2004</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: display can be configured in single line mode.</tr>
                <!-- old: Примечание: дисплей может быть настроен в
                однострочном режиме. -->
                <tr lang="ru" finished="false">Примечание: дисплей может быть настроен в
                однострочном режиме.</tr>
            </par>
        </info>
        <properties>
            <!-- @i2c_addr -->
            <property name="@i2c_addr" type="int" default="-1" access="initonly" minvalue="-4"
            maxvalue="119">
                <tr lang="en">I²C address. Values 'default' (for addr 0x27), 'alt' (for addr 0x3f)
                are also accepted</tr>
                <!-- old: Адрес I²C. Также принимаются значения «default» (для
                адреса 0x27), «alt» (для адреса 0x3f). -->
                <!-- old: Адрес I2C. Также принимаются значения «по умолчанию»
                (для добавления 0x27), «альт» (для добавления 0x3f). -->
                <tr lang="ru" finished="false">Адрес I2C. Также принимаются значения «по умолчанию»
                (для добавления 0x27), «альт» (для добавления 0x3f).</tr>
            </property>
            <!-- @i2c_bus -->
            <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none"
            access="initonly">
                <tr lang="en">I²C bus</tr>
                <tr lang="ru">шина I²C</tr>
            </property>
            <!-- @rows -->
            <property name="@rows" type="int" default="1" enum="1 2 4" access="initonly">
                <tr lang="en">number of display rows</tr>
                <tr lang="ru" finished="false">Количество строк дисплея</tr>
            </property>
        </properties>
        <methods>
            <!-- backlight -->
            <method name="backlight">
                <info>
                    <tr lang="en">turn on/off the display backlight</tr>
                    <tr lang="ru" finished="false">включить/выключить подсветку дисплея</tr>
                </info>
                <param name="STATE" type="bool" required="true">
                    <tr lang="en">new state</tr>
                    <tr lang="ru" finished="false">Новое государство</tr>
                </param>
            </method>
            <!-- char -->
            <method name="char">
                <info>
                    <tr lang="en">write character to the display and move cursor to the next
                    position</tr>
                    <!-- old: Напишите символ на дисплей и переместите курсор
                    в следующую позицию -->
                    <tr lang="ru" finished="false">Напишите символ на дисплей и переместите курсор
                    в следующую позицию</tr>
                </info>
                <param name="CHAR" type="int" required="true" minvalue="0" maxvalue="255">
                    <tr lang="en">char code</tr>
                    <tr lang="ru" finished="false">Код Шара</tr>
                </param>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clear all display data and set cursor position to 0, 0</tr>
                    <!-- old: очистить все данные отображения и установить
                    положение курсора до 0, 0 -->
                    <tr lang="ru" finished="false">очистить все данные отображения и установить
                    положение курсора до 0, 0</tr>
                </info>
            </method>
            <!-- clear_line -->
            <method name="clear_line">
                <info>
                    <tr lang="en">clear only specified line</tr>
                    <tr lang="ru" finished="false">четкая только указанная линия</tr>
                </info>
                <param name="LINE" type="int" required="true" minvalue="0" maxvalue="3">
                    <tr lang="en">line index</tr>
                    <tr lang="ru" finished="false">линейный индекс</tr>
                </param>
            </method>
            <!-- cursor_blink -->
            <method name="cursor_blink">
                <info>
                    <tr lang="en">turn on/off cursor blinking</tr>
                    <tr lang="ru" finished="false">Включить/выключить мерцающий курсор</tr>
                </info>
                <param name="STATE" type="bool" required="true">
                    <tr lang="en">new state</tr>
                    <tr lang="ru" finished="false">Новое государство</tr>
                </param>
            </method>
            <!-- cursor_on -->
            <method name="cursor_on">
                <info>
                    <tr lang="en">turn on/off display cursor</tr>
                    <tr lang="ru" finished="false">Включить/выключить курсор дисплея</tr>
                </info>
                <param name="STATE" type="bool" required="true">
                    <tr lang="en">new state</tr>
                    <tr lang="ru" finished="false">Новое государство</tr>
                </param>
            </method>
            <!-- cursor_pos -->
            <method name="cursor_pos">
                <info>
                    <tr lang="en">set cursor potision</tr>
                    <tr lang="ru" finished="false">Обсуждение Cursor potision</tr>
                </info>
                <param name="LINE" type="int" required="true" minvalue="0">
                    <tr lang="en">cursor line</tr>
                    <tr lang="ru" finished="false">линия курсора</tr>
                </param>
                <param name="COL" type="int" required="true" minvalue="0" maxvalue="20">
                    <tr lang="en">cursor line character position</tr>
                    <tr lang="ru" finished="false">положение символа линии курсора</tr>
                </param>
            </method>
            <!-- font -->
            <method name="font">
                <info>
                    <tr lang="en">choose font</tr>
                    <tr lang="ru" finished="false">Выберите шрифт</tr>
                </info>
            </method>
            <!-- move_cursor -->
            <method name="move_cursor">
                <info>
                    <tr lang="en">move cursor horizontally</tr>
                    <tr lang="ru" finished="false">перемещать курсор горизонтально</tr>
                </info>
                <param name="SHIFT" type="int" required="true">
                    <tr lang="en">relative cursor shift. Negative values move the cursor leftwards,
                    positive values - rightwards</tr>
                    <!-- old: относительный сдвиг курсора. Отрицательные
                    значения перемещают курсор влево, положительные — вправо -->
                    <tr lang="ru" finished="false">относительный сдвиг курсора. Отрицательные
                    значения перемещают курсор влево, положительные — вправо</tr>
                </param>
            </method>
            <!-- move_display -->
            <method name="move_display">
                <info>
                    <tr lang="en">move display content horizontally</tr>
                    <tr lang="ru" finished="false">перемещать контент дисплея горизонтально</tr>
                </info>
                <param name="SHIFT" type="int" required="true">
                    <tr lang="en">relative display move, not altering the display content</tr>
                    <!-- old: относительное движение дисплея, не изменяя
                    содержимое дисплея -->
                    <tr lang="ru" finished="false">относительное движение дисплея, не изменяя
                    содержимое дисплея</tr>
                </param>
            </method>
            <!-- write -->
            <method name="write">
                <info>
                    <tr lang="en">write the message at the current cursor position and then move
                    the cursor to the next position after last written character</tr>
                    <!-- old: Запишите сообщение в текущей позиции курсора, а
                    затем переместите курсор в следующую позицию после последнего написанного
                    символа. -->
                    <tr lang="ru" finished="false">Запишите сообщение в текущей позиции курсора, а
                    затем переместите курсор в следующую позицию после последнего написанного
                    символа.</tr>
                </info>
                <param name="MSG" type="list" required="true">
                    <tr lang="en">value list</tr>
                    <tr lang="ru" finished="false">список ценностей</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">control input</tr>
                    <tr lang="ru" finished="false">контрольный вход</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">no output</tr>
                    <tr lang="ru" finished="false">нет выхода</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]                [clear #d(
|
[backlight $1 #a(  [cursor_pos 0 0 #e(

 [T]               [cursor_pos 1 0 #f(
 |
 [cursor_on $1 #b( [move_cursor 1 #g(

 [T]               [move_cursor -1 #h(
 |
 [cursor_blink $1 #c(  [L]
                       |
                       [msg write #i]

[hw.rpi.display.hd44780 @i2c_bus default @i2c_addr auto @rows 2 #x]


[ui.link @url=ceammc://img/conn_ws2812.png @title='Connection_Scheme']
[X a->x] [X b->x] [X c->x] [X d->x] [X e->x] [X f->x] [X g->x] [X h->x]
[X i->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
