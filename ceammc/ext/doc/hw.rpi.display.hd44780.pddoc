<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="hw.rpi.display.hd44780">
        <title>hw.rpi.display.hd44780</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">LCD display driver for Raspberry Pi (1602 or 2004 module)</tr>
                <tr lang="ru">драйвер для ЖКИ дисплея (1602 или 2004 модуль) для Raspberry Pi</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display 1602 2004 lcd i2c rpi</keywords>
            <since>0.9.8</since>
            <aliases>
                <alias>hw.rpi.display.lcd1602</alias>
                <alias>hw.rpi.display.lcd2004</alias>
            </aliases>
        </meta>
        <info>
            <par>Note: display can be configured in single line mode.</par>
        </info>
        <properties>
            <!-- @i2c_addr -->
            <property name="@i2c_addr" type="int" default="-1" access="initonly" minvalue="-4"
            maxvalue="119">
                <tr lang="en">I²C address. Values 'default' (for addr 0x27), 'alt' (for addr 0x3f)
                are also accepted</tr>
                <tr lang="ru" finished="false">Адрес I²C. Также принимаются значения «default» (для
                адреса 0x27), «alt» (для адреса 0x3f).</tr>
            </property>
            <!-- @i2c_bus -->
            <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none"
            access="initonly">
                <tr lang="en">I²C bus</tr>
                <tr lang="ru">шина I²C</tr>
            </property>
            <!-- @rows -->
            <property name="@rows" type="int" default="1" enum="1 2 4" access="initonly">
                <tr lang="en">number of display rows</tr>
                <tr lang="ru" finished="false">Количество строк дисплея</tr>
            </property>
        </properties>
        <methods>
            <!-- backlight -->
            <method name="backlight">turn on/off the display backlight 
            <param name="STATE" type="bool" required="true">
                <tr lang="en">new state</tr>
            </param></method>
            <!-- char -->
            <method name="char">write character to the display and move cursor to the next position
            
            <param name="CHAR" type="int" required="true" minvalue="0" maxvalue="255">
                <tr lang="en">char code</tr>
            </param></method>
            <!-- clear -->
            <method name="clear">clear all display data and set cursor position to 0, 0</method>
            <!-- clear_line -->
            <method name="clear_line">clear only specified line 
            <param name="LINE" type="int" required="true" minvalue="0" maxvalue="3">
                <tr lang="en">line index</tr>
            </param></method>
            <!-- cursor_blink -->
            <method name="cursor_blink">turn on/off cursor blinking 
            <param name="STATE" type="bool" required="true">
                <tr lang="en">new state</tr>
            </param></method>
            <!-- cursor_on -->
            <method name="cursor_on">turn on/off display cursor 
            <param name="STATE" type="bool" required="true">
                <tr lang="en">new state</tr>
            </param></method>
            <!-- cursor_pos -->
            <method name="cursor_pos">set cursor potision 
            <param name="LINE" type="int" required="true" minvalue="0">
                <tr lang="en">cursor line</tr>
            </param>
            <param name="COL" type="int" required="true" minvalue="0" maxvalue="20">
                <tr lang="en">cursor line character position</tr>
            </param></method>
            <!-- font -->
            <method name="font">choose font</method>
            <!-- move_cursor -->
            <method name="move_cursor">move cursor horizontally 
            <param name="SHIFT" type="int" required="true">
                <tr lang="en">relative cursor shift. Negative values move the cursor leftwards,
                positive values - rightwards</tr>
            </param></method>
            <!-- move_display -->
            <method name="move_display">move display content horizontally 
            <param name="SHIFT" type="int" required="true">
                <tr lang="en">relative display move, not altering the display content</tr>
            </param></method>
            <!-- write -->
            <method name="write">write the message at the current cursor position and then move the
            cursor to the next position after last written character 
            <param name="MSG" type="list" required="true">
                <tr lang="en">value list</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>control input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>no output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]                [clear #d(
|
[backlight $1 #a(  [cursor_pos 0 0 #e(

 [T]               [cursor_pos 1 0 #f(
 |
 [cursor_on $1 #b( [move_cursor 1 #g(

 [T]               [move_cursor -1 #h(
 |
 [cursor_blink $1 #c(  [L]
                       |
                       [msg write #i]

[hw.rpi.display.hd44780 @i2c_bus default @i2c_addr auto @rows 2 #x]


[ui.link @url=ceammc://img/conn_ws2812.png @title='Connection_Scheme']
[X a->x] [X b->x] [X c->x] [X d->x] [X e->x] [X f->x] [X g->x] [X h->x]
[X i->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
