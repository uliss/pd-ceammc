<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.pass">
    <title>flow.pass</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">pass specified values</tr>
        <tr lang="ru">пропускает указанные значения</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>pass functional</keywords>
      <since>0.3</since>
      <aliases>
        <alias>ceammc/pass</alias>
        <alias>pass</alias>
      </aliases>
      <also>
        <see>flow.pass_if</see>
        <see>flow.reject</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object passes the input value only if it is found in the pass list, otherwise nothing is output</tr>
        <tr lang="ru">объект пропускает входное значение только если оно найдено в списке пропуска, иначе на выход ничего не поступает</tr>
      </par>
      <par>
        <tr lang="en">the pass list is set by the VALUES argument, the @values property, or by sending a list to the right inlet</tr>
        <tr lang="ru">список пропуска задаётся аргументом VALUES, свойством @values или подачей списка на правый вход</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to filter a stream by a fixed set of allowed values, for example to pass only specific note numbers</tr>
        <tr lang="ru">объект можно использовать для фильтрации потока по фиксированному набору разрешённых значений, например чтобы пропускать только определённые ноты</tr>
      </par>
    </info>
    <arguments>
      <argument name="VALUES" type="list">
        <tr lang="en">atoms to pass</tr>
        <tr lang="ru">атомы для пропуска</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @values -->
      <property name="@values" type="list" default="">
        <tr lang="en">atoms to pass</tr>
        <tr lang="ru">атомы для пропуска</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">pass</tr>
          <tr lang="ru">пропустить</tr>
        </in>
        <in on="float">
          <tr lang="en">pass if float found in pass list</tr>
          <tr lang="ru">пропустить, если число найдено в списке пропуска</tr>
        </in>
        <in on="symbol">
          <tr lang="en">pass if symbol found in pass list</tr>
          <tr lang="ru">пропустить, если символ найден в списке пропуска</tr>
        </in>
        <in on="list">
          <tr lang="en">pass if first atom found in pass list</tr>
          <tr lang="ru">пропустить, если первый атом найден в списке пропуска</tr>
        </in>
        <in on="any">
          <tr lang="en">pass if message selector found in pass list</tr>
          <tr lang="ru">пропустить, если селектор сообщения найден в списке пропуска</tr>
        </in>
      </inlet>
      <inlet>
        <in on="list">
          <tr lang="en">set pass list</tr>
          <tr lang="ru">задать список пропуска</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">passed values</tr>
          <tr lang="ru">переданные значения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]    [S]    [list 1 2 9 10(
|      |      |
|  [B] |      | [a b c d(
|  |   |      | |
|  |   |      | |
[flow.pass 1 10 100 a z]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
