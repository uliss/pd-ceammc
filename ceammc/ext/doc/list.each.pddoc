<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="list.each">
    <title>list.each</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">maps a list value via an external side-chain</tr>
        <tr lang="ru">отображает каждое значение списка через внешнюю боковую цепь</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>list</category>
      <keywords>list functional map iterate</keywords>
      <since>0.1</since>
      <also>
        <see>list.do</see>
        <see>list.apply_to</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object passes each element (or a group of @step elements) of the input
        list through the rightmost outlet to an external object, which is expected to return the
        processed value back to the rightmost inlet</tr>
        <tr lang="ru">объект передаёт каждый элемент (или группу из @step элементов) входного
        списка через правый выход во внешний объект, который должен вернуть обработанное значение
        обратно на правый вход</tr>
      </par>
      <par>
        <tr lang="en">this allows arbitrary mapping, transformation and filtering of list values
        via a side-chain, for example applying a function to every element or grouping elements
        before processing</tr>
        <tr lang="ru">это позволяет произвольно отображать, преобразовывать и фильтровать значения
        списка через боковую цепь, например применять функцию к каждому элементу или группировать
        элементы перед обработкой</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to apply the same operation to every list element, for
        example to square all values or to multiply every third element</tr>
        <tr lang="ru">объект можно использовать для применения одной операции ко всем элементам
        списка, например чтобы возвести все значения в квадрат или умножить каждый третий
        элемент</tr>
      </par>
    </info>
    <arguments>
      <argument name="STEP" type="int" minvalue="1" maxvalue="1024">
        <tr lang="en">see the @step property</tr>
        <tr lang="ru">см. свойство @step</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @step -->
      <property name="@step" type="int" minvalue="1" maxvalue="1024" default="1">
        <tr lang="en">number of elements output to the rightmost outlet on each iteration</tr>
        <tr lang="ru">количество элементов, выводимых на правый выход за одну итерацию</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">input list</tr>
          <tr lang="ru">входной список</tr>
        </in>
        <in on="data:mlist">
          <tr lang="en">input MList</tr>
          <tr lang="ru">входной MList</tr>
        </in>
      </inlet>
      <inlet>
        <in>
          <tr lang="en">new modified value from the applied object</tr>
          <tr lang="ru">новое изменённое значение от применённого объекта</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">new modified list (or MList)</tr>
          <tr lang="ru">новый изменённый список (или MList)</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">single element or list of values (if @step property &gt; 1)</tr>
          <tr lang="ru">один элемент или список значений (если свойство @step &gt; 1)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[1 2 3 4 5 6 7 8 9(   [1 2 3 4 5 6 7 8 9(
|                     |
[list.each] X [pow 2] [list.each 2] X [*]
|                     |
[ui.dt]               [ui.dt]

/* more complex example: multiply by three element in list */

[1 2 3 4 5 6 7 8 9(
|
|  [hradio]
|  |
|  [@step $1(
|  |
[list.each 3] X [list.reduce] X [*]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
