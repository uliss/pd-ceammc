<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="data.path">
    <title>data.path</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">filesystem path datatype</tr>
        <tr lang="ru">тип данных: путь в файловой системе</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data map container path file</keywords>
      <since>0.9.8</since>
    </meta>
    <arguments>
      <argument name="PATH" type="atom">
        <tr lang="en">see @path</tr>
        <tr lang="ru">см. @path</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @async -->
      <property name="@async" type="bool" default="1">
        <tr lang="en">use asynchronous operations</tr>
        <tr lang="ru">использовать асинхронные операции</tr>
      </property>
      <!-- @norm -->
      <property name="@norm" type="bool" default="1">
        <tr lang="en">normalize the path</tr>
        <tr lang="ru">нормализовать путь</tr>
      </property>
      <!-- @path -->
      <property name="@path" type="atom" default="">
        <tr lang="en">current path value</tr>
        <tr lang="ru">текущее значение пути</tr>
      </property>
    </properties>
    <methods>
      <!-- exists -->
      <method name="exists">
        <info>
          <tr lang="en">checks whether the path exists. Outputs an [exists VALUE( message</tr>
          <tr lang="ru">проверяет, существует ли путь. Выводит сообщение [exists VALUE(</tr>
        </info>
      </method>
      <!-- info -->
      <method name="info">
        <info>
          <tr lang="en">requests path information. Outputs an [info DICT( message</tr>
          <tr lang="ru">запрашивает информацию о пути. Выводит сообщение [info DICT(</tr>
        </info>
      </method>
      <!-- permissions -->
      <method name="permissions">
        <info>
          <tr lang="en">requests path permissions. Outputs a [permissions VALUE( message</tr>
          <tr lang="ru">запрашивает права доступа к пути. Выводит сообщение [permissions VALUE(</tr>
        </info>
      </method>
      <!-- size -->
      <method name="size">
        <info>
          <tr lang="en">requests the file size in bytes. Outputs a [size BYTES( message</tr>
          <tr lang="ru">запрашивает размер файла в байтах. Выводит сообщение [size BYTES(</tr>
        </info>
      </method>
      <!-- type -->
      <method name="type">
        <info>
          <tr lang="en">requests the path type. Outputs a [type TYPE( message, where type is one of:
          regular, dir, symlink, char, block, fifo, socket</tr>
          <tr lang="ru">запрашивает тип пути. Выводит сообщение [type TYPE(, где тип — один из:
          regular, dir, symlink, char, block, fifo, socket</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output the current path</tr>
          <tr lang="ru">вывести текущий путь</tr>
        </in>
        <in on="symbol">
          <tr lang="en">set the current path and output</tr>
          <tr lang="ru">установить текущий путь и вывести</tr>
        </in>
        <in on="data">
          <tr lang="en">set the current path and output</tr>
          <tr lang="ru">установить текущий путь и вывести</tr>
        </in>
      </inlet>
      <inlet>
        <in on="symbol">
          <tr lang="en">set the current path without output</tr>
          <tr lang="ru">установить текущий путь без вывода</tr>
        </in>
        <in on="data">
          <tr lang="en">set the current path without output</tr>
          <tr lang="ru">установить текущий путь без вывода</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">data output</tr>
          <tr lang="ru">вывод данных</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[exists( [info #a( [type #b( [permissions #c( [size #d(
|
|  [B]
|  |
|  [openpanel]
|  |
|  |  [B]
|  |  |
[data.path Path(.) #x]
|
|
[ui.dt]

[X a->x] [X b->x] [X c->x] [X d->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
