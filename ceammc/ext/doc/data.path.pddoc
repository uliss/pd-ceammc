<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="data.path">
        <title>data.path</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">filesystem path datatype</tr>
                <tr lang="ru">тип данных: путь в файловой системе</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data map container path file</keywords>
            <since>0.9.8</since>
        </meta>
        <arguments>
            <argument name="PATH" type="atom">
                <tr lang="en">See @path</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @async -->
            <property name="@async" type="bool" default="1">
                <tr lang="en">use async operations</tr>
            </property>
            <!-- @norm -->
            <property name="@norm" type="bool" default="1">
                <tr lang="en">normalize path</tr>
            </property>
            <!-- @path -->
            <property name="@path" type="atom" default="">
                <tr lang="en">current path value</tr>
            </property>
        </properties>
        <methods>
            <!-- exists -->
            <method name="exists">
                <info>
                    <tr lang="en">checks if path exists. Output [exists VALUE( message</tr>
                </info>
            </method>
            <!-- info -->
            <method name="info">
                <info>
                    <tr lang="en">request path information. Output [info DICT(</tr>
                </info>
            </method>
            <!-- permissions -->
            <method name="permissions">
                <info>
                    <tr lang="en">request path permissions. Output [permissions VALUE(</tr>
                </info>
            </method>
            <!-- size -->
            <method name="size">
                <info>
                    <tr lang="en">request file size in bytes. Output [size BYTES(</tr>
                </info>
            </method>
            <!-- type -->
            <method name="type">
                <info>
                    <tr lang="en">request path type. Output [type TYPE( message, where type is one
                    of: regular, dir, symlink, char, block, fifo, socket</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output current path</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">set current path and output</tr>
                </xinfo>
                <xinfo on="data">
                    <tr lang="en">set current path and output</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">set current path and without output</tr>
                </xinfo>
                <xinfo on="data">
                    <tr lang="en">set current path and without output</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>data output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[exists( [info #a( [type #b( [permissions #c( [size #d(
|
|  [B]
|  |
|  [openpanel]
|  |
|  |  [B]
|  |  |
[data.path Path(.) #x]
|
|
[ui.dt]

[X a->x] [X b->x] [X c->x] [X d->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
