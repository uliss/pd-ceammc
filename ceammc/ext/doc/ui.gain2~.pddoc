<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.gain2~" type="gui">
    <title>ui.gain2~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">stereo gain control</tr>
        <tr lang="ru">стерео-регулятор громкости</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui gain</keywords>
      <since>0.7</since>
      <aliases>
        <alias view="link">ui.hgain2~</alias>
        <alias view="link">ui.vgain2~</alias>
      </aliases>
    </meta>
    <mouse>
      <event type="left-click" editmode="false">jump to click position if @relative property is
      off</event>
      <event type="drag" editmode="false">relative gain change if @relative is on, otherwise
      follows mouse pointer</event>
      <event type="drag" editmode="false" keys="Shift">slow relative gain change if @relative is
      on</event>
      <event type="wheel" editmode="false">change the knob value</event>
      <event type="wheel" editmode="false" keys="Shift">change the knob value slowly</event>
      <event type="right-click" editmode="false">open popup menu</event>
      <event type="right-click" editmode="false" keys="Shift">open object help</event>
      <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
      <event type="drag" editmode="true" keys="Cmd">relative gain change</event>
      <event type="double-click" editmode="true" keys="Cmd">toggle horizontal/vertical
      orientation</event>
      <event type="double-click" editmode="0" keys="Shift">toggle MIDI-learn mode (red border
      displayed)</event>
      <event type="right-click" editmode="true" keys="Shift">open object help</event>
      <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
    </mouse>
    <properties>
      <xi:include href="props_background_color.xml" />
      <xi:include href="props_border_color.xml" />
      <xi:include href="props_fontname.xml" />
      <xi:include href="props_fontsize.xml" />
      <xi:include href="props_fontslant.xml" />
      <xi:include href="props_fontweight.xml" />
      <xi:include href="props_pinned.xml" />
      <xi:include href="props_ui_receive.xml" />
      <xi:include href="props_ui_send.xml" />
      <xi:include href="props_midi_channel.xml" />
      <xi:include href="props_preset.xml" />
      <!-- @amp -->
      <property name="@amp" type="float" default="0">
        <tr lang="en">gain as amplitude ratio</tr>
        <tr lang="ru">коэффициент усиления как отношение амплитуд</tr>
      </property>
      <!-- @db -->
      <property name="@db" type="float" units="decibel" default="-60">
        <tr lang="en">gain in dBFS scale</tr>
        <tr lang="ru">усиление в шкале dBFS</tr>
      </property>
      <!-- @knob_color -->
      <property name="@knob_color" type="list" default="0 0.75 1 1">
        <tr lang="en">knob color (list of red, green, blue values in the 0-1 range)</tr>
        <tr lang="ru">цвет ручки (список значений красного, зелёного, синего в диапазоне 0-1)</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="int" minvalue="-12" maxvalue="12" default="0" units="decibel">
        <tr lang="en">maximum gain value</tr>
        <tr lang="ru">максимальное значение усиления</tr>
      </property>
      <!-- @midi_control -->
      <property name="@midi_control" type="int" minvalue="-1" maxvalue="127" default="-1">
        <tr lang="en">bound MIDI controller number. -1 means not bound to any controller.</tr>
        <tr lang="ru">привязанный номер MIDI-контроллера. -1 означает отсутствие привязки.</tr>
      </property>
      <!-- @midi_pickup -->
      <property name="@midi_pickup" type="bool" default="1">
        <tr lang="en">pickup current value. If the slider is bound to a value, you must first pass
        over this value to make the binding. This prevents sudden value changes on the first
        control change.</tr>
        <tr lang="ru">подхват текущего значения. Если слайдер привязан к значению, вы должны
        сначала пройти через это значение, чтобы установить привязку. Это предотвращает резкое
        изменение значения при первом изменении управления.</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="int" minvalue="-90" maxvalue="-15" default="-60" units="decibel">
        <tr lang="en">minimum gain value</tr>
        <tr lang="ru">минимальное значение усиления</tr>
      </property>
      <!-- @mouse_events -->
      <property name="@mouse_events" type="bool" default="0">
        <tr lang="en">mouse events output mode. If on, outputs @mouse_down, @mouse_up and
        @mouse_drag events.</tr>
        <tr lang="ru">режим вывода событий мыши. Если включён, выводит события @mouse_down,
        @mouse_up и @mouse_drag.</tr>
      </property>
      <!-- @output_value -->
      <property name="@output_value" type="bool" default="0">
        <tr lang="en">flag to output the @db property after each knob movement</tr>
        <tr lang="ru">флаг вывода свойства @db после каждого движения ручки</tr>
      </property>
      <!-- @relative -->
      <property name="@relative" type="bool" default="1">
        <tr lang="en">relative input mode. When set, does not jump to the value on click.</tr>
        <tr lang="ru">режим относительного ввода. При установке не перескакивает к значению по
        клику.</tr>
      </property>
      <!-- @show_range -->
      <property name="@show_range" type="bool" default="1">
        <tr lang="en">show slider range</tr>
        <tr lang="ru">показывать диапазон слайдера</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="15 120">
        <tr lang="en">object size (width, height pair)</tr>
        <tr lang="ru">размер объекта (пара: ширина высота)</tr>
      </property>
    </properties>
    <methods>
      <!-- + N -->
      <method name="+ N">
        <info>
          <tr lang="en">increase current gain by N dB</tr>
          <tr lang="ru">увеличить текущее усиление на N дБ</tr>
        </info>
      </method>
      <!-- ++ -->
      <method name="++">
        <info>
          <tr lang="en">increase current gain by 1 dB</tr>
          <tr lang="ru">увеличить текущее усиление на 1 дБ</tr>
        </info>
      </method>
      <!-- - N -->
      <method name="- N">
        <info>
          <tr lang="en">decrease current gain by N dB</tr>
          <tr lang="ru">уменьшить текущее усиление на N дБ</tr>
        </info>
      </method>
      <method name="--">
        <info>
          <tr lang="en">decrease current gain by 1 dB</tr>
          <tr lang="ru">уменьшить текущее усиление на 1 дБ</tr>
        </info>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clear the specified preset</tr>
          <tr lang="ru">очистить указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- interp -->
      <method name="interp">
        <info>
          <tr lang="en">interpolate between presets</tr>
          <tr lang="ru">интерполировать между пресетами</tr>
        </info>
        <param name="IDX" type="float" required="true">
          <tr lang="en">preset fractional index</tr>
          <tr lang="ru">дробный индекс пресета</tr>
        </param>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">load the specified preset</tr>
          <tr lang="ru">загрузить указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set UI element position</tr>
          <tr lang="ru">установить положение элемента интерфейса</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top-left x-coordinate</tr>
          <tr lang="ru">координата x верхнего левого угла</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top-left y-coordinate</tr>
          <tr lang="ru">координата y верхнего левого угла</tr>
        </param>
      </method>
      <!-- set N -->
      <method name="set N">
        <info>
          <tr lang="en">set current gain to N dB</tr>
          <tr lang="ru">установить текущее усиление в N дБ</tr>
        </info>
      </method>
      <!-- store -->
      <method name="store">
        <info>
          <tr lang="en">store the specified preset</tr>
          <tr lang="ru">сохранить указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">left input signal</tr>
          <tr lang="ru">левый входной сигнал</tr>
        </in>
        <in on="bang">
          <tr lang="en">output the current gain @db property</tr>
          <tr lang="ru">вывести текущее значение усиления (@db)</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">right input signal</tr>
          <tr lang="ru">правый входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left output signal</tr>
          <tr lang="ru">левый выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right output signal</tr>
          <tr lang="ru">правый выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env]
|
[readsf~]
|
[fx.zita_rev1~]
| ^|.
[ui.gain2~ @size 120 14] [ui.dsp~]
| ^|.
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
