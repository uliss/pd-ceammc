<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="net.osc.send">
    <title>net.osc.send</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">sending messages via the OSC protocol</tr>
        <tr lang="ru">отправляет сообщения по протоколу OSC</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>net</category>
      <keywords>osc net send</keywords>
      <since>0.9.5</since>
      <also>
        <see>net.osc.server</see>
        <see>net.osc.receive</see>
      </also>
      <aliases>
        <alias>net.osc.s</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">OSC (Open Sound Control) is a protocol for communication among computers, sound synthesizers and other multimedia devices, optimized for modern networking technology</tr>
        <tr lang="ru">OSC (Open Sound Control) — протокол обмена данными между компьютерами, синтезаторами и другими мультимедийными устройствами, оптимизированный для современных сетевых технологий</tr>
      </par>
    </info>
    <arguments>
      <argument name="URL" type="atom">
        <tr lang="en">OSC server url (like osc.udp://localhost:12345)</tr>
        <tr lang="ru">URL OSC-сервера (например, osc.udp://localhost:12345)</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @host -->
      <property name="@host" type="symbol" default="" access="readonly">
        <tr lang="en">destination host</tr>
        <tr lang="ru">хост назначения</tr>
      </property>
      <!-- @path -->
      <property name="@path" type="symbol" default="" access="readonly">
        <tr lang="en">socket filesystem path (if using unix proto)</tr>
        <tr lang="ru">путь файловой системы сокета (при использовании протокола unix)</tr>
      </property>
      <!-- @port -->
      <property name="@port" type="int" default="0" access="readonly">
        <tr lang="en">destination port</tr>
        <tr lang="ru">порт назначения</tr>
      </property>
      <!-- @proto -->
      <property name="@proto" type="symbol" default="udp" access="readonly">
        <tr lang="en">sending protocol</tr>
        <tr lang="ru">протокол отправки</tr>
      </property>
      <!-- @url -->
      <property name="@url" type="atom" default="">
        <tr lang="en">destination url</tr>
        <tr lang="ru">URL назначения</tr>
      </property>
    </properties>
    <methods>
      <!-- send -->
      <method name="send">
        <info>
          <tr lang="en">send input values (autotyped)</tr>
          <tr lang="ru">отправить входные значения (с автоопределением типов)</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
        <param name="VALUES" type="list" required="true">
          <tr lang="en">values</tr>
          <tr lang="ru">значения</tr>
        </param>
      </method>
      <!-- send_blob -->
      <method name="send_blob">
        <info>
          <tr lang="en">send blob value</tr>
          <tr lang="ru">отправить значение blob</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
        <param name="VAL" type="list" required="true">
          <tr lang="en">list of bytes</tr>
          <tr lang="ru">список байтов</tr>
        </param>
      </method>
      <!-- send_bool -->
      <method name="send_bool">
        <info>
          <tr lang="en">send boolean value</tr>
          <tr lang="ru">отправить булево значение</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
        <param name="VAL" type="int" enum="0 1" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- send_char -->
      <method name="send_char">
        <info>
          <tr lang="en">send character</tr>
          <tr lang="ru">отправить символ</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
        <param name="VAL" type="atom" required="true">
          <tr lang="en">ASCII code in 0-127 range or single symbol</tr>
          <tr lang="ru">ASCII-код в диапазоне 0–127 или один символ</tr>
        </param>
      </method>
      <!-- send_double -->
      <method name="send_double">
        <info>
          <tr lang="en">send double value</tr>
          <tr lang="ru">отправить значение double</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
        <param name="VAL" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- send_float -->
      <method name="send_float">
        <info>
          <tr lang="en">send float value</tr>
          <tr lang="ru">отправить значение float</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
        <param name="VAL" type="float" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- send_i32 -->
      <method name="send_i32">
        <info>
          <tr lang="en">send int32 value</tr>
          <tr lang="ru">отправить значение int32</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
        <param name="VAL" type="int" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- send_i64 -->
      <method name="send_i64">
        <info>
          <tr lang="en">send int64 value</tr>
          <tr lang="ru">отправить значение int64</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
        <param name="VAL" type="int" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- send_inf -->
      <method name="send_inf">
        <info>
          <tr lang="en">send inf value</tr>
          <tr lang="ru">отправить значение inf</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
      </method>
      <!-- send_midi -->
      <method name="send_midi">
        <info>
          <tr lang="en">send MIDI message (4 bytes)</tr>
          <tr lang="ru">отправить MIDI-сообщение (4 байта)</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
        <param name="VAL" type="list" required="true">
          <tr lang="en">hex symbol (0xAAFF1122) or list of 4 bytes</tr>
          <tr lang="ru">шестнадцатеричный символ (0xAAFF1122) или список из 4 байтов</tr>
        </param>
      </method>
      <!-- send_null -->
      <method name="send_null">
        <info>
          <tr lang="en">send null value</tr>
          <tr lang="ru">отправить значение null</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
      </method>
      <!-- send_string -->
      <method name="send_string">
        <info>
          <tr lang="en">send string value</tr>
          <tr lang="ru">отправить строковое значение</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
        <param name="VAL" type="list" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- send_typed -->
      <method name="send_typed">
        <info>
          <tr lang="en">send list of typed values</tr>
          <tr lang="ru">отправить список типизированных значений</tr>
        </info>
        <param name="PATH" type="symbol" required="true">
          <tr lang="en">OSC path</tr>
          <tr lang="ru">OSC-путь</tr>
        </param>
        <param name="TYPES" type="symbol" required="true">
          <tr lang="en">type string, 'i': int32, 'f': 32-bit float, 's': string, 'h': int64, 'd': 64-bit float, 'T': #true value, 'F': #false value, 'N': #null value, 'I': #inf value</tr>
          <tr lang="ru">строка типов, 'i': int32, 'f': 32-битный float, 's': строка, 'h': int64, 'd': 64-битный float, 'T': значение #true, 'F': значение #false, 'N': значение #null, 'I': значение #inf</tr>
        </param>
        <param name="VAL" type="list" required="true">
          <tr lang="en">values</tr>
          <tr lang="ru">значения</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">message input</tr>
          <tr lang="ru">вход сообщений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">none</tr>
          <tr lang="ru">нет</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*default receive OSC server: osc.udp://:9000*/

[tgl]
|
[@dump $1(  /*open Pd window to see OSC dump output*/
|
[net.osc.server]

/*send list of floats*/

[send /l 1 2 3 4 #a( [send_typed /t ifs 0.5 -100 symbol #i(

 [T]                 [F]                   [F]
 |                   |                     |
[send_bool /b $1 #b( [send_float /f $1 #e( [send_double /d $1 #g(

[send_inf /inf #c(   [F]                   [F]
                     |                     |
[send_null /null #d( [send_i32 /i32 $1 #f( [send_i64 /i64 $1 #h(

                                           [send_string /s with spaces #j(


[net.osc.send osc.udp://localhost:9000 #x]

[X a->x]
[X b->x]
[X c->x]
[X d->x]
[X e->x]
[X f->x]
[X g->x]
[X h->x]
[X i->x]
[X j->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
