<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="array.play~">
        <title>array.play~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">array player with variable speed and amplitude</tr>
                <tr lang="ru">проигрывание массива с изменяемой скоростью и амплитудой</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array play</keywords>
            <since>0.9.1</since>
            <aliases>
                <alias>array.p~</alias>
            </aliases>
            <also>
                <see>tabplay~</see>
            </also>
        </meta>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
            <argument name="SPEED" type="float">
                <tr lang="en">play speed</tr>
                <tr lang="ru">скорость воспроизведения</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @amp -->
            <property name="@amp" type="float" default="1" minvalue="0">
                <tr lang="en">playback amplitude</tr>
                <tr lang="ru">амплитуда воспроизведения</tr>
            </property>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </property>
            <!-- @begin -->
            <property name="@begin" type="float" default="0" units="sample">
                <tr lang="en">playback start position. Negative value means position relative to
                the end of the array</tr>
                <tr lang="ru">позиция начала воспроизведения. Отрицательное значение означает
                положение относительно конца массива</tr>
            </property>
            <!-- @cfmt -->
            <property name="@cfmt" type="symbol" default="sec" enum="sec ms samp phase">
                <tr lang="en">clock output format</tr>
                <tr lang="ru">выходной формат времени</tr>
            </property>
            <!-- @clock -->
            <property name="@clock" type="float" default="0" minvalue="0" maxvalue="20"
            units="second">
                <tr lang="en">clock output period. Zero means: no clock output (by default).</tr>
                <tr lang="ru">период вывода значения времени. Ноль означает: отсутствие вывода
                времени (по умолчанию).</tr>
            </property>
            <!-- @cursor_ms -->
            <property name="@cursor_ms" type="float" default="0" units="millisecond">
                <tr lang="en">current play position</tr>
                <tr lang="ru">текущая позиция воспроизведения</tr>
            </property>
            <!-- @cursor_phase -->
            <property name="@cursor_phase" type="float" default="0">
                <tr lang="en">current play position</tr>
                <tr lang="ru">текущая позиция воспроизведения</tr>
            </property>
            <!-- @cursor_samp -->
            <property name="@cursor_samp" type="float" default="0" units="sample">
                <tr lang="en">current play position</tr>
                <tr lang="ru">текущая позиция воспроизведения</tr>
            </property>
            <!-- @cursor_sec -->
            <property name="@cursor_sec" type="float" default="0" units="second">
                <tr lang="en">current play position</tr>
                <tr lang="ru">текущая позиция воспроизведения</tr>
            </property>
            <!-- @end -->
            <property name="@end" type="float" default="-1" units="sample">
                <tr lang="en">playback end position. Negative value means position relative to the
                end of the array</tr>
                <tr lang="ru">позиция конца воспроизведения. Отрицательное значение означает
                положение относительно конца массива</tr>
            </property>
            <!-- @interp -->
            <property name="@interp" type="int" enum="0 1 3" default="1">
                <tr lang="en">interpolation type. 0: no interpolation 1: linear, 3: cubic.</tr>
                <tr lang="ru">тип интерполяции. 0: без интерполяции 1: линейная, 3:
                кубическая.</tr>
            </property>
            <!-- @loop -->
            <property name="@loop" type="bool" default="0">
                <tr lang="en">samplewise loop playing mode</tr>
                <tr lang="ru" finished="false">семпл-петля play mode</tr>
            </property>
            <!-- @select_ms -->
            <property name="@select_ms" type="list" default="0 0" units="millisecond">
                <tr lang="en">selection range</tr>
                <tr lang="ru">диапазон выбора</tr>
            </property>
            <!-- @select_phase -->
            <property name="@select_phase" type="list" default="0 0">
                <tr lang="en">selection range in [0, 1] range</tr>
                <tr lang="ru" finished="false">Диапазон выбора в [0, 1] диапазоне</tr>
            </property>
            <!-- @select_samp -->
            <property name="@select_samp" type="list" default="0 0" units="sample">
                <tr lang="en">selection range</tr>
                <tr lang="ru">диапазон выбора</tr>
            </property>
            <!-- @select_sec -->
            <property name="@select_sec" type="list" default="0 0" units="second">
                <tr lang="en">selection range</tr>
                <tr lang="ru">диапазон выбора</tr>
            </property>
            <!-- @speed -->
            <property name="@speed" type="float" default="1">
                <tr lang="en">playback speed. Negative value means reversed playback</tr>
                <tr lang="ru">скорость воспроизведения. Отрицательное значение означает обратное
                воспроизведение</tr>
            </property>
            <!-- @state -->
            <property name="@state" type="int" default="0" access="readonly">
                <tr lang="en">playing state. 0: stopped, 1: playing, 2: paused.</tr>
                <tr lang="ru">состояние воспроизведения. 0: остановка, 1: воспроизведение, 2:
                пауза</tr>
            </property>
        </properties>
        <methods>
            <!-- pause -->
            <method name="pause">pause/resume playback 
            <param type="int" enum="0 1" default="1">
                <tr lang="en">if true: pause, else resume playing</tr>
                <tr lang="ru">если истинно: ставит на паузу, иначе возобновляет
                воспроизведение</tr>
            </param></method>
            <!-- play -->
            <method name="play">start playback from current play position</method>
            <!-- range -->
            <method name="range">set @begin and @end property 
            <param name="BEGIN" type="atom" required="true">
                <tr lang="en">begin position. If float value given: interpret as phase in [0..1]
                range. Otherwise unit value expected. Examples: 10ms, 5%, 4sec, 20samp etc.</tr>
                <tr lang="ru">начальная позиция. Если дано числовое значение: интерпретировать как
                фазу в [0..1] диапазоне. В противном случае ожидается значение с единицами времени.
                Примеры: 10ms, 5%, 4sec, 20samp и т.д.</tr>
            </param>
            <param name="END" type="atom" required="true">
                <tr lang="en">end position. Value type same as for first argument</tr>
                <tr lang="ru">конечная позиция. Тип значения, аналогичный первому аргументу</tr>
            </param></method>
            <!-- stop -->
            <method name="stop">stop playback and reset play position</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">resets play position and starts playback</xinfo>
                <xinfo on="float">starts playback from the specified sample. Negative offsets are
                also supported: -10 means play last 10 samples of array till the end</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">played signal</outlet>
            <outlet>output current playing position according to @cfmt property. By default output
            seconds</outlet>
            <outlet>output bang when finished</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav(  [array APLAY]
|
[expand_env]
|
[load $1 @to APLAY @resize(
|
[snd.file]

[bng]
|
[array.play~ APLAY] [ui.dsp~]
|
[ui.hgain~]
|\
[dac~]

[array.play~-speed]   [array.play~-range]

[array.play~-speed2]  [array.play~-clock]

[array.play~-amp]
]]>
            </pdascii>
            <pdascii id="speed">
<![CDATA[
[@speed 1, bang #a( [@speed 0.5, bang #b( [@speed -1, bang #c(

[@speed 1.5, bang #d( [@speed -0.5, bang #e( [@speed -1.5, bang #f(



[array.play~ APLAY #x]
|
[ui.hgain~]
|\
[dac~]

[X a->x]
[X b->x]
[X c->x]
[X d->x]
[X e->x]
[X f->x]
]]>
            </pdascii>
            <pdascii id="speed2">
<![CDATA[
[stop #b(

[@speed * 0.9, bang #a(
|
[array.play~ APLAY #x]
|
[ui.hgain~]
|\
[dac~]

[X b->x]
[X x:2->a]
]]>
            </pdascii>
            <pdascii id="amp">
<![CDATA[
[stop #b(

[@amp * 0.9, bang #a(
|
[array.play~ APLAY #x]
|
[ui.hgain~]
|\
[dac~]

[X b->x]
[X x:2->a]
]]>
            </pdascii>
            <pdascii id="range">
<![CDATA[
[stop #b(

/*phase range 0..1*/ /*percent range 0..100*/

[ui.rslider]         [ui.rslider]
|                    |
[range $1 $2 (       [math.* 100]
|                    |
|          [bang #a( [range $1% $2%(
|                    |
[array.play~ APLAY #x]
|
[ui.hgain~]
|\
[dac~]

[X a->x]
[X b->x]
[X x:2->a]
]]>
            </pdascii>
            <pdascii id="clock">
<![CDATA[
[play( [stop(  [@speed 0.5, bang(  [@speed -2, bang(
|      |       |                   |
[array.play~ APLAY @clock 0.1      ]
^|
[sec->str @symbol @ms]
|
[S digits=15]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
