<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="noise.chua~">
        <title>noise.chua~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Chua's diode circuit</tr>
                <tr lang="ru">диодная схема цепи Чуа</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>noise</category>
            <keywords>noise chua chaos</keywords>
            <since>0.9.6</since>
        </meta>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @C1 -->
            <property name="@C1" type="float" default="5.5" minvalue="5.2" maxvalue="6">
                <tr lang="en">C1 capacity in nF</tr>
            </property>
            <!-- @C2 -->
            <property name="@C2" type="float" default="49.5" minvalue="40" maxvalue="60">
                <tr lang="en">C2 capacity in nF</tr>
            </property>
            <!-- @L -->
            <property name="@L" type="float" default="7.07" minvalue="6.5" maxvalue="7.3">
                <tr lang="en">L in mH</tr>
            </property>
            <!-- @R -->
            <property name="@R" type="float" default="1.6" minvalue="1.252" maxvalue="1.7">
                <tr lang="en">R resistance in kOhm</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">play trigger &gt;0: on, 0: off. To set output gain to 0.5 you can 0.5
                as trigger value</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">reset generator</method>
            <!-- start -->
            <method name="start">start generator</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">play with default duration and full gain</xinfo>
                <xinfo on="float">play with default duration and specified gain</xinfo>
                <xinfo on="list">GAIN(0..1) DUR(ms) pair expected</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">X output (C1 Vout)</outlet>
            <outlet type="audio">Y output (C2 Vout)</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[gnoise.chua~ {o=2}]
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
[ui.hgain2~]     [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
