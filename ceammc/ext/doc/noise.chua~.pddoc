<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="noise.chua~">
    <title>noise.chua~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Chua's diode circuit</tr>
        <tr lang="ru">диодная схема цепи Чуа</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>noise</category>
      <keywords>noise chua chaos</keywords>
      <since>0.9.6</since>
    </meta>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @C1 -->
      <property name="@C1" type="float" default="5.5" minvalue="5.2" maxvalue="6">
        <tr lang="en">C1 capacity in nF</tr>
        <tr lang="ru" finished="false">Вместимость C1 в nF</tr>
      </property>
      <!-- @C2 -->
      <property name="@C2" type="float" default="49.5" minvalue="40" maxvalue="60">
        <tr lang="en">C2 capacity in nF</tr>
        <tr lang="ru" finished="false">Емкость C2 в nF</tr>
      </property>
      <!-- @L -->
      <property name="@L" type="float" default="7.07" minvalue="6.5" maxvalue="7.3">
        <tr lang="en">L in mH</tr>
        <tr lang="ru" finished="false">L в mH</tr>
      </property>
      <!-- @R -->
      <property name="@R" type="float" default="1.6" minvalue="1.252" maxvalue="1.7">
        <tr lang="en">R resistance in kOhm</tr>
        <tr lang="ru" finished="false">Сопротивление R в kOhm</tr>
      </property>
      <!-- @gate -->
      <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
        <tr lang="en">play trigger &gt;0: on, 0: off. To set output gain to 0.5 you can 0.5 as
        trigger value</tr>
        <!-- old: играть триггер >0: on, 0: off. Чтобы установить
                выходной коэффициент усиления до 0,5, вы можете 0,5 как триггерное значение. -->
        <tr lang="ru" finished="false">играть триггер &gt;0: on, 0: off. Чтобы установить выходной
        коэффициент усиления до 0,5, вы можете 0,5 как триггерное значение.</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset generator</tr>
          <tr lang="ru" finished="false">генератор сброса</tr>
        </info>
      </method>
      <!-- start -->
      <method name="start">
        <info>
          <tr lang="en">start generator</tr>
          <tr lang="ru" finished="false">стартовый генератор</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">play with default duration and full gain</tr>
          <!-- old: Играйте с продолжительностью по умолчанию и
                    полным выигрышем -->
          <tr lang="ru" finished="false">Играйте с продолжительностью по умолчанию и полным
          выигрышем</tr>
        </in>
        <in on="float">
          <tr lang="en">play with default duration and specified gain</tr>
          <!-- old: Играйте с продолжительностью по умолчанию и
                    определенным выигрышем -->
          <tr lang="ru" finished="false">Играйте с продолжительностью по умолчанию и определенным
          выигрышем</tr>
        </in>
        <in on="list">
          <tr lang="en">GAIN(0..1) DUR(ms) pair expected</tr>
          <tr lang="ru" finished="false">ГАИН(0) ..1) Ожидаемая пара DUR(ms)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">X output (C1 Vout)</tr>
          <tr lang="ru" finished="false">X выход (C1 Vout)</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">Y output (C2 Vout)</tr>
          <tr lang="ru" finished="false">Y выход (C2 Vout)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[gnoise.chua~ {o=2}]
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
[ui.hgain2~]     [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
