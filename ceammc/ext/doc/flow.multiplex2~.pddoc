<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.multiplex2~">
    <title>flow.multiplex2~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">audio stream stereo multiplexer</tr>
        <tr lang="ru">мультиплексор стереофонического аудиопотока</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow multiplex</keywords>
      <since>0.6</since>
      <aliases>
        <alias>flow.mux2~</alias>
        <alias>ceammc/mux2~</alias>
        <alias>mux2~</alias>
      </aliases>
      <also>
        <see>flow.multiplex~</see>
        <see>flow.multiplex</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object selects one of N stereo input pairs and sends it to the stereo
        output, the selection is controlled by the last (control) inlet</tr>
        <tr lang="ru">объект выбирает одну из N входных стереопар и отправляет её на стереовыход,
        выбор управляется последним (управляющим) входом</tr>
      </par>
      <par>
        <tr lang="en">the control value is the index of the selected stereo pair, starting from
        0</tr>
        <tr lang="ru">управляющее значение — индекс выбранной стереопары, начиная с 0</tr>
      </par>
      <par>
        <tr lang="en">@value sets the gain coefficients for each input</tr>
        <tr lang="ru">@value задаёт коэффициенты усиления для каждого входа</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to switch between several stereo sources, for example
        to select one of several stereo effects or audio streams</tr>
        <tr lang="ru">объект можно использовать для переключения между несколькими
        стереоисточниками, например для выбора одного из нескольких стереоэффектов или
        аудиопотоков</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="2" maxvalue="8">
        <tr lang="en">number of input stereo-pairs</tr>
        <tr lang="ru">количество входных стереопар</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @value -->
      <property name="@value" type="list" default="1 0">
        <tr lang="en">gain coefficients for each input</tr>
        <tr lang="ru">коэффициенты усиления для каждого входа</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet type="audio" number="1">
        <in>
          <tr lang="en">first left input signal</tr>
          <tr lang="ru">первый левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="2">
        <in>
          <tr lang="en">first right input signal</tr>
          <tr lang="ru">первый правый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... left input signal</tr>
          <tr lang="ru">... левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... right input signal</tr>
          <tr lang="ru">... правый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">last left input signal</tr>
          <tr lang="ru">последний левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">last right input signal</tr>
          <tr lang="ru">последний правый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="control" number="n+1">
        <in>
          <tr lang="en">multiplexer control</tr>
          <tr lang="ru">управление мультиплексором</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left output</tr>
          <tr lang="ru">левый выход</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right output</tr>
          <tr lang="ru">правый выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[osc~ 440]             [ui.radio @nitems 2] [ui.dsp~]
|                      |
| [osc~ 442]           |
| |                    |
| |  [osc~ 660]        |
| |  |                 |
| |  |   [osc~ 662]    |
| |  |   |             |
| |. |.. |...          |....
[flow.multiplex2~ 2         ]
*|*
[ui.hgain2~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
