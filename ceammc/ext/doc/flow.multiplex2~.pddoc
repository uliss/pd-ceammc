<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="flow.multiplex2~">
        <title>flow.multiplex2~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">audio stream stereo multiplexer</tr>
                <tr lang="ru">мультиплексор стерео аудиопотока</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>flow multiplex</keywords>
            <since>0.6</since>
            <aliases>
                <alias>flow.mux2~</alias>
                <alias>ceammc/mux2~</alias>
                <alias>mux2~</alias>
            </aliases>
            <also>
                <see>flow.multiplex~</see>
                <see>flow.multiplex</see>
            </also>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="2" maxvalue="8">
                <tr lang="en">number of input stereo-pairs</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @value -->
            <property name="@value" type="list" default="1 0">
                <tr lang="en">gain coefficients per each input</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet type="audio" number="1">
                <xinfo>
                    <tr lang="en">first left input signal</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="2">
                <xinfo>
                    <tr lang="en">first right input signal</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>
                    <tr lang="en">... left input signal</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>
                    <tr lang="en">... right input signal</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="n">
                <xinfo>
                    <tr lang="en">last left input signal</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="n">
                <xinfo>
                    <tr lang="en">last right input signal</tr>
                </xinfo>
            </inlet>
            <inlet type="control" number="n+1">
                <xinfo>
                    <tr lang="en">multiplexer control</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">left output</outlet>
            <outlet type="audio">right output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[osc~ 440]             [ui.radio @nitems 2] [ui.dsp~]
|                      |
| [osc~ 442]           |
| |                    |
| |  [osc~ 660]        |
| |  |                 |
| |  |   [osc~ 662]    |
| |  |   |             |
| |. |.. |...          |....
[flow.multiplex2~ 2         ]
*|*
[ui.hgain2~]
*|*
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
