<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="fx.zita_rev1~">
        <title>fx.zita_rev1~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">zita stereo reverb</tr>
                <tr lang="ru">zita стерео ревербератор</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx reverb</keywords>
            <since>0.2</since>
        </meta>
        <arguments>
            <argument name="DECAY_LOW" type="float" minvalue="1" maxvalue="60" units="second">
                <tr lang="en">time (in seconds) to decay 60dB in low-frequency band</tr>
                <tr lang="ru" finished="false">время (в секундах) распада 60dB в низкочастотном
                диапазоне</tr>
            </argument>
            <argument name="DECAY_MID" type="float" minvalue="1" maxvalue="60" units="second">
                <tr lang="en">time (in seconds) to decay 60dB in mid-frequency band</tr>
                <tr lang="ru" finished="false">время (в секундах) распада 60dB в диапазоне средних
                частот</tr>
            </argument>
            <argument name="DRYWET" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">ratio between source signal (dry) and processed signal (wet)</tr>
                <tr lang="ru" finished="false">Соотношение между исходным сигналом (сухим) и
                обработанным сигналом (мокрым)</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
                <tr lang="ru" finished="false">Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал.</tr>
            </property>
            <!-- @damp_hf -->
            <property name="@damp_hf" type="float" minvalue="1500" maxvalue="47040" default="6000"
            units="hertz">
                <tr lang="en">Frequency (Hz) at which the high-frequency T60 is half the
                middle-band's T60</tr>
                <tr lang="ru" finished="false">Частота (Гц), при которой высокочастотный T60
                составляет половину T60 среднего диапазона</tr>
            </property>
            <!-- @decay_low -->
            <property name="@decay_low" type="float" minvalue="1" maxvalue="60" default="3"
            units="second">
                <tr lang="en">time (in seconds) to decay 60dB in low-frequency band</tr>
                <tr lang="ru" finished="false">время (в секундах) распада 60dB в низкочастотном
                диапазоне</tr>
            </property>
            <!-- @decay_mid -->
            <property name="@decay_mid" type="float" minvalue="1" maxvalue="60" default="2"
            units="second">
                <tr lang="en">time (in seconds) to decay 60dB in mid-frequency band</tr>
                <tr lang="ru" finished="false">время (в секундах) распада 60dB в диапазоне средних
                частот</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">Ratio between source signal (dry) and processed signal (wet)</tr>
                <tr lang="ru" finished="false">Соотношение между исходным сигналом (сухим) и
                обработанным сигналом (мокрым)</tr>
            </property>
            <!-- @fr_ldecay -->
            <property name="@fr_ldecay" type="float" minvalue="0" maxvalue="60" default="40"
            units="second">
                <tr lang="en">time (in seconds) to decay 60dB in low-frequency band</tr>
                <tr lang="ru" finished="false">время (в секундах) распада 60dB в низкочастотном
                диапазоне</tr>
            </property>
            <!-- @fr_mdecay -->
            <property name="@fr_mdecay" type="float" minvalue="0" maxvalue="60" default="40"
            units="second">
                <tr lang="en">time (in seconds) to decay 60dB in mid-frequency band</tr>
                <tr lang="ru" finished="false">время (в секундах) распада 60dB в диапазоне средних
                частот</tr>
            </property>
            <!-- @fr_time -->
            <property name="@fr_time" type="float" minvalue="0" maxvalue="1000" default="100"
            units="millisecond">
                <tr lang="en">length of freeze tail</tr>
                <tr lang="ru" finished="false">Длина замораживающего хвоста</tr>
            </property>
            <!-- @freeze -->
            <property name="@freeze" type="bool" default="0">
                <tr lang="en">freeze reverberation tail</tr>
                <tr lang="ru" finished="false">замораживание реверберации хвоста</tr>
            </property>
            <!-- @freq_low -->
            <property name="@freq_low" type="float" minvalue="50" maxvalue="1000" default="200"
            units="hertz">
                <tr lang="en">Crossover frequency (Hz) separating low and middle frequencies</tr>
                <tr lang="ru" finished="false">Перекрестная частота (Гц), разделяющая низкие и
                средние частоты</tr>
            </property>
            <!-- @predelay -->
            <property name="@predelay" type="float" minvalue="0" maxvalue="100" default="40"
            units="millisecond">
                <tr lang="en">a delay operating on the 'wet' signal. Large values will provide the
                impression of a larger room</tr>
                <tr lang="ru" finished="false">Задержка работы по сигналу «мокрый». Большие
                значения обеспечат впечатление большой комнаты</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">same as reset</tr>
                    <tr lang="ru" finished="false">То же самое, что Reset</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">left channel</tr>
                    <tr lang="ru" finished="false">левый канал</tr>
                </xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">right channel</tr>
                    <tr lang="ru" finished="false">Правый канал</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output left</tr>
                </out>
            </outlet>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output right</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bell.aiff( [voice.wav(                  [array array1 w=150 h=100]
|           |
[symbol     ]
|
[load %DOC%/sound/$1 @to array1 @resize(
|
[expand_env]
|
[snd.file]


[bang(
|
[tabplay~ array1]          [ui.dsp~]
|
|              [F]
|              |
| [T]          [@delay $1( [F]             [F]
| |            |           |               |
| [@bypass $1( | [dump(    [@decay_mid $1( [@decay_low $1(
| |            | |         |               |
| |            | |         |               | [T]
| |            | |         |               | |
| |            | |         |               | [@freeze $1(
| |            | |         |               | |
[fx.zita_rev1~  3 4                          ]
*|*
[ui.hgain2~]
*|*
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
