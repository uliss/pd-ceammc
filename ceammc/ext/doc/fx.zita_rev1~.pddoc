<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fx.zita_rev1~">
    <title>fx.zita_rev1~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Zita stereo reverb</tr>
        <tr lang="ru">стереоревербератор Zita</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>fx</category>
      <keywords>fx reverb</keywords>
      <since>0.2</since>
    </meta>
    <arguments>
      <argument name="DECAY_LOW" type="float" minvalue="1" maxvalue="60" units="second">
        <tr lang="en">time (in seconds) for a 60dB decay in the low-frequency band</tr>
        <tr lang="ru">время (в секундах) спада на 60 дБ в низкочастотном диапазоне</tr>
      </argument>
      <argument name="DECAY_MID" type="float" minvalue="1" maxvalue="60" units="second">
        <tr lang="en">time (in seconds) for a 60dB decay in the mid-frequency band</tr>
        <tr lang="ru">время (в секундах) спада на 60 дБ в среднечастотном диапазоне</tr>
      </argument>
      <argument name="DRYWET" type="float" minvalue="0" maxvalue="1">
        <tr lang="en">ratio between the source signal (dry) and the processed signal (wet)</tr>
        <tr lang="ru">соотношение между исходным сигналом (dry) и обработанным сигналом (wet)</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypasses the processed signal.</tr>
        <tr lang="ru">флаг обхода. Если true: пропускает обработанный сигнал.</tr>
      </property>
      <!-- @damp_hf -->
      <property name="@damp_hf" type="float" minvalue="1500" maxvalue="47040" default="6000" units="hertz">
        <tr lang="en">frequency (in Hz) at which the high-frequency T60 is half the mid-band T60</tr>
        <tr lang="ru">частота (в Гц), на которой высокочастотный T60 составляет половину среднечастотного T60</tr>
      </property>
      <!-- @decay_low -->
      <property name="@decay_low" type="float" minvalue="1" maxvalue="60" default="3" units="second">
        <tr lang="en">time (in seconds) for a 60dB decay in the low-frequency band</tr>
        <tr lang="ru">время (в секундах) спада на 60 дБ в низкочастотном диапазоне</tr>
      </property>
      <!-- @decay_mid -->
      <property name="@decay_mid" type="float" minvalue="1" maxvalue="60" default="2" units="second">
        <tr lang="en">time (in seconds) for a 60dB decay in the mid-frequency band</tr>
        <tr lang="ru">время (в секундах) спада на 60 дБ в среднечастотном диапазоне</tr>
      </property>
      <!-- @drywet -->
      <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="1">
        <tr lang="en">ratio between the source signal (dry) and the processed signal (wet)</tr>
        <tr lang="ru">соотношение между исходным сигналом (dry) и обработанным сигналом (wet)</tr>
      </property>
      <!-- @fr_ldecay -->
      <property name="@fr_ldecay" type="float" minvalue="0" maxvalue="60" default="40" units="second">
        <tr lang="en">time (in seconds) for a 60dB decay in the low-frequency band (in freeze mode)</tr>
        <tr lang="ru">время (в секундах) спада на 60 дБ в низкочастотном диапазоне (в режиме заморозки)</tr>
      </property>
      <!-- @fr_mdecay -->
      <property name="@fr_mdecay" type="float" minvalue="0" maxvalue="60" default="40" units="second">
        <tr lang="en">time (in seconds) for a 60dB decay in the mid-frequency band (in freeze mode)</tr>
        <tr lang="ru">время (в секундах) спада на 60 дБ в среднечастотном диапазоне (в режиме заморозки)</tr>
      </property>
      <!-- @fr_time -->
      <property name="@fr_time" type="float" minvalue="0" maxvalue="1000" default="100" units="millisecond">
        <tr lang="en">freeze tail duration</tr>
        <tr lang="ru">длительность хвоста в режиме заморозки</tr>
      </property>
      <!-- @freeze -->
      <property name="@freeze" type="bool" default="0">
        <tr lang="en">freeze the reverb tail</tr>
        <tr lang="ru">заморозить хвост реверберации</tr>
      </property>
      <!-- @freq_low -->
      <property name="@freq_low" type="float" minvalue="50" maxvalue="1000" default="200" units="hertz">
        <tr lang="en">crossover frequency (in Hz) separating low and mid frequencies</tr>
        <tr lang="ru">частота кроссовера (в Гц), разделяющая низкие и средние частоты</tr>
      </property>
      <!-- @predelay -->
      <property name="@predelay" type="float" minvalue="0" maxvalue="100" default="40" units="millisecond">
        <tr lang="en">a delay applied to the 'wet' signal. Large values give the impression of a larger room.</tr>
        <tr lang="ru">задержка, применяемая к сигналу 'wet'. Большие значения создают ощущение более крупного помещения.</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the reverb state</tr>
          <tr lang="ru">сбрасывает состояние ревербератора</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">left channel input</tr>
          <tr lang="ru">левый входной канал</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">right channel input</tr>
          <tr lang="ru">правый входной канал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left channel output</tr>
          <tr lang="ru">левый выходной канал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right channel output</tr>
          <tr lang="ru">правый выходной канал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bell.aiff( [voice.wav(                  [array array1 w=150 h=100]
|           |
[symbol     ]
|
[load %DOC%/sound/$1 @to array1 @resize(
|
[expand_env]
|
[snd.file]


[bang(
|
[tabplay~ array1]          [ui.dsp~]
|
|              [F]
|              |
| [T]          [@delay $1( [F]             [F]
| |            |           |               |
| [@bypass $1( | [dump(    [@decay_mid $1( [@decay_low $1(
| |            | |         |               |
| |            | |         |               | [T]
| |            | |         |               | |
| |            | |         |               | [@freeze $1(
| |            | |         |               | |
[fx.zita_rev1~  3 4                          ]
*|*
[ui.hgain2~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
