<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.meter~" type="gui">
    <title>ui.meter~</title>
    <meta>
      <authors>
        <author>Pierre Guillot</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">peak and RMS signal level</tr>
        <tr lang="ru">пиковый и RMS уровень сигнала</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui meter</keywords>
      <since>0.1</since>
      <aliases>
        <alias view="link">ui.m~</alias>
        <alias view="link">ui.hm~</alias>
        <alias view="link">ui.vm~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Each cell has 3db range. Full meter range is 39 db.</tr>
        <tr lang="ru" finished="false">Каждая ячейка имеет 3db диапазон. Дальность полного метра
        составляет 39 дБ.</tr>
      </par>
      <par>
        <tr lang="en">Values &gt; -3db are red, range [-12, -3) db is hot, [-21, -12) db is warm,
        [-30, -21) is tepid, values &lt; 30 are cold.</tr>
        <tr lang="ru" finished="false">Значения &gt; -3db красные, диапазон [-12, -3) db горячий,
        [-21, -12) db теплый, [-30, -21) прохладный, значения &lt;30 холодные.</tr>
      </par>
      <par>
        <tr lang="en">[ui.hm~] - alias for horizontal meter</tr>
        <tr lang="ru" finished="false">[ui.hm~] - псевдоним для горизонтального метра</tr>
      </par>
    </info>
    <mouse>
      <event type="double-click" editmode="true" keys="Cmd">changes slider orientation</event>
      <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
      <event type="right-click" editmode="false" keys="Shift">open object help</event>
      <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
      <event type="right-click" editmode="true" keys="Shift">open the object help</event>
      <event type="right-click" editmode="true">open Pd popup menu</event>
    </mouse>
    <properties>
      <xi:include href="props_background_color.xml" />
      <xi:include href="props_border_color.xml" />
      <xi:include href="props_fontname.xml" />
      <xi:include href="props_fontsize.xml" />
      <xi:include href="props_fontslant.xml" />
      <xi:include href="props_fontweight.xml" />
      <xi:include href="props_pinned.xml" />
      <xi:include href="props_ui_receive.xml" />
      <xi:include href="props_ui_send.xml" />
      <!-- @cold_color -->
      <property name="@cold_color" type="list" default="0 0.6 0 1">
        <tr lang="en">extra low-level signal color &lt;-31db (list of red, green, blue values in
        0-1 range)</tr>
        <tr lang="ru" finished="false">дополнительный низкоуровневый цвет сигнала &lt;-31db (список
        значений красного, зеленого, синего в диапазоне 0-1)</tr>
      </property>
      <!-- @hot_color -->
      <property name="@hot_color" type="list" default="1 0.6 0 1">
        <tr lang="en">loud level signal color &lt;-3db (list of red, green, blue values in 0-1
        range)</tr>
        <tr lang="ru" finished="false">цвет сигнала громкого уровня &lt;-3db (список красных,
        зеленых, синих значений в диапазоне 0-1)</tr>
      </property>
      <!-- @interval -->
      <property name="@interval" type="int" units="millisecond" minvalue="20" default="50">
        <tr lang="en">refresh interval</tr>
        <tr lang="ru" finished="false">интервал обновления</tr>
      </property>
      <!-- @over_color -->
      <property name="@over_color" type="list" default="1 0 0 1">
        <tr lang="en">extra-loud level signal color &gt;-3db (list of red, green, blue values in
        0-1 range)</tr>
        <tr lang="ru" finished="false">цвет сигнала сверхгромкого уровня &gt;-3db (список красных,
        зеленых, синих значений в диапазоне 0-1)</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="15 120">
        <tr lang="en">object size (width, height pair)</tr>
        <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
      </property>
      <!-- @tepid_color -->
      <property name="@tepid_color" type="list" default="0.6 0.73 0 1">
        <tr lang="en">low-level signal color &lt;-21db (list of red, green, blue values in 0-1
        range)</tr>
      </property>
      <!-- @warm_color -->
      <property name="@warm_color" type="list" default="0.85 0.85 0 1">
        <tr lang="en">normal level signal color &lt;-9db (list of red, green, blue values in 0-1
        range)</tr>
      </property>
    </properties>
    <methods>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set UI element position</tr>
          <tr lang="ru" finished="false">Установите положение элемента UI</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top left x-coord</tr>
          <tr lang="ru" finished="false">верхний левый x-coord</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top right y-coord</tr>
          <tr lang="ru" finished="false">верхняя правая y-coord</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru" finished="false">входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output pair of values: rms and peak in decibels (dbfs)</tr>
          <tr lang="ru" finished="false">выходная пара значений: rms и пик в децибелах (dbfs)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[lfo.tri~ 0.2] [phasor~ 0.2]
|              |
|              [env~]
|              |
|              [dbtorms]
|              |
[ui.meter~]    [ui.hm~]
|
|
|
|
|
|              [ui.dsp~]
|
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
