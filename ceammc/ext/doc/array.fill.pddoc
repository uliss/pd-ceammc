<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.fill">
    <title>array.fill</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">fill the array with a single value, pattern or function</tr>
        <tr lang="ru">заполнение массива одним значением, шаблоном или функцией</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array fill</keywords>
      <also>
        <see>array.each</see>
      </also>
      <since>0.3</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object fills the specified array with data. Several filling methods are
        available: a single value, a repeated pattern, or a generated waveform. When the fill is
        complete, a bang is sent out to the outlet.</tr>
        <tr lang="ru">Объект заполняет указанный массив данными. Доступно несколько способов
        заполнения: одним значением, повторяющимся шаблоном или сгенерированной волновой формой.
        По завершении заполнения на выход отправляется bang.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array to fill</tr>
        <tr lang="ru">имя массива для заполнения</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array to fill</tr>
        <tr lang="ru">имя массива для заполнения</tr>
      </property>
      <!-- @redraw -->
      <property name="@redraw" type="bool" default="1">
        <tr lang="en">redraw the array after change</tr>
        <tr lang="ru">перерисовывать массив после изменения</tr>
      </property>
    </properties>
    <methods>
      <!-- fill -->
      <method name="fill">
        <info>
          <tr lang="en">fills the entire array with the specified value or repeating pattern</tr>
          <tr lang="ru">заполняет весь массив заданным значением или повторяющимся шаблоном</tr>
        </info>
        <param name="@from" type="int">
          <tr lang="en">start index of the fill range. If not specified, 0 is used</tr>
          <tr lang="ru">начальный индекс диапазона заполнения. Если не указан, используется 0</tr>
        </param>
        <param name="@to" type="int">
          <tr lang="en">end index of the fill range. Can be negative to address from the array end.
          For example, -1 means the last element (not including it). If not specified, the array
          length is used</tr>
          <tr lang="ru">конечный индекс диапазона заполнения. Может быть отрицательным для
          адресации с конца массива. Например, -1 означает последний элемент (не включая его).
          Если не указан, используется длина массива</tr>
        </param>
        <param name="VAL1" type="float" required="true">
          <tr lang="en">first value</tr>
          <tr lang="ru">первое значение</tr>
        </param>
        <param name="VAL..." type="float">
          <tr lang="en">additional values</tr>
          <tr lang="ru">дополнительные значения</tr>
        </param>
      </method>
      <!-- gauss -->
      <method name="gauss">
        <info>
          <tr lang="en">fills the entire array with random values following a normal (Gaussian)
          distribution</tr>
          <tr lang="ru">заполняет весь массив случайными значениями с нормальным (гауссовым)
          распределением</tr>
        </info>
        <param name="MEAN" type="float" default="0">
          <tr lang="en">mean value</tr>
          <tr lang="ru">среднее значение</tr>
        </param>
        <param name="SIGMA" type="float" default="1" minvalue="0">
          <tr lang="en">standard deviation</tr>
          <tr lang="ru">стандартное отклонение</tr>
        </param>
      </method>
      <!-- pulse -->
      <method name="pulse">
        <info>
          <tr lang="en">fills the entire array with a pulse wave</tr>
          <tr lang="ru">заполняет весь массив прямоугольной волной</tr>
        </info>
        <param name="T" type="float" required="true" minvalue="1" units="sample">
          <tr lang="en">wave period</tr>
          <tr lang="ru">период волны</tr>
        </param>
        <param name="A" type="float" default="1">
          <tr lang="en">wave amplitude</tr>
          <tr lang="ru">амплитуда волны</tr>
        </param>
        <param name="D" type="float" default="0.5" minvalue="0.001" maxvalue="0.999">
          <tr lang="en">duty cycle</tr>
          <tr lang="ru">коэффициент заполнения</tr>
        </param>
      </method>
      <!-- saw -->
      <method name="saw">
        <info>
          <tr lang="en">fills the entire array with a saw wave</tr>
          <tr lang="ru">заполняет весь массив пилообразной волной</tr>
        </info>
        <param name="T" type="float" required="true" minvalue="1" units="sample">
          <tr lang="en">wave period</tr>
          <tr lang="ru">период волны</tr>
        </param>
        <param name="A" type="float" default="1">
          <tr lang="en">wave amplitude</tr>
          <tr lang="ru">амплитуда волны</tr>
        </param>
        <param name="PHASE" type="float" default="0" minvalue="0" maxvalue="1">
          <tr lang="en">wave phase</tr>
          <tr lang="ru">фаза волны</tr>
        </param>
      </method>
      <!-- sin -->
      <method name="sin">
        <info>
          <tr lang="en">fills the entire array with a sine wave</tr>
          <tr lang="ru">заполняет весь массив синусоидальной волной</tr>
        </info>
        <param name="T" type="float" minvalue="0" required="true" units="sample">
          <tr lang="en">wave period. Must be &gt;0</tr>
          <tr lang="ru">период волны. Должен быть &gt;0</tr>
        </param>
        <param name="A" type="float" default="1">
          <tr lang="en">amplitude</tr>
          <tr lang="ru">амплитуда</tr>
        </param>
        <param name="PHASE" type="float" default="0" minvalue="0" maxvalue="1">
          <tr lang="en">phase in the 0...1 range</tr>
          <tr lang="ru">фаза в диапазоне 0...1</tr>
        </param>
      </method>
      <!-- tri -->
      <method name="tri">
        <info>
          <tr lang="en">fills the entire array with a triangle wave</tr>
          <tr lang="ru">заполняет весь массив треугольной волной</tr>
        </info>
        <param name="T" type="float" required="true" minvalue="1" units="sample">
          <tr lang="en">wave period</tr>
          <tr lang="ru">период волны</tr>
        </param>
        <param name="AMP" type="float" default="1">
          <tr lang="en">wave amplitude</tr>
          <tr lang="ru">амплитуда волны</tr>
        </param>
      </method>
      <!-- uniform -->
      <method name="uniform">
        <info>
          <tr lang="en">fills the entire array with random values following a uniform
          distribution</tr>
          <tr lang="ru">заполняет весь массив случайными значениями с равномерным
          распределением</tr>
        </info>
        <param name="A" type="float" default="0">
          <tr lang="en">minimum value</tr>
          <tr lang="ru">минимальное значение</tr>
        </param>
        <param name="B" type="float" default="1">
          <tr lang="en">maximum value</tr>
          <tr lang="ru">максимальное значение</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">sets the array name</tr>
          <tr lang="ru">устанавливает имя массива</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="bang">
          <tr lang="en">sent when the fill is finished</tr>
          <tr lang="ru">отправляется по завершении заполнения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[array afill size=300 w=300 h=90]






[fill 0.1 #a1(   [gauss 0 0.4 #a5( [gauss 0.5 0.2 #a6(

[fill -0.2 0 1 0.5 0.6 #a2(  [uniform -0.2 0.5 #a7(

[fill @from 50 0.5 0.6 0.7 0.7 0.8 #a3( [pulse 50 0.7 0.3 #a8(

[fill @from 20 @to -10 -0.5 #a4( [saw 60 0.9 #a9( [tri 80 0.6 #a10(

           [ui.knob]
           |
           |
           |
           [sin 100 0.8 $1(
           |
[array.fill @array afill #b]
|
[B]

[X a1->b]
[X a2->b]
[X a3->b]
[X a4->b]
[X a5->b]
[X a6->b]
[X a7->b]
[X a8->b]
[X a9->b]
[X a10->b]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
