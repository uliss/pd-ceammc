<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="ui.incdec" type="gui">
        <title>ui.incdec</title>
        <meta>
            <authors>
                <author>Pierre Guillot</author>
            </authors>
            <description>
                <tr lang="en">value increment or decrement widget</tr>
                <tr lang="ru">виджет увеличения или уменьшения значения</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui increment decrement</keywords>
            <since>0.1</since>
            <also>
                <see view="link">ui.number</see>
            </also>
        </meta>
        <mouse>
            <event type="left-click" editmode="false">click in the upper half increments object
            state, in the lower half - decrements</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_pinned.xml" />
            <xi:include href="props_ui_receive.xml" />
            <xi:include href="props_ui_send.xml" />
            <xi:include href="props_preset.xml" />
            <!-- @arrow_color -->
            <property name="@arrow_color" type="list" default="0.6 0.6 0.6 1">
                <tr lang="en">arrow color (list of red, green, blue values in 0-1 range)</tr>
                <tr lang="ru" finished="false">цвет стрелки (список красных, зеленых, синих
                значений в диапазоне 0-1)</tr>
            </property>
            <!-- @bind_down -->
            <property name="@bind_down" type="list" default="">
                <tr lang="en">MIDI/keyboard bind expression for down action</tr>
                <tr lang="ru" finished="false">MIDI/клавиатура связывает выражение с действием
                вниз</tr>
            </property>
            <!-- @bind_up -->
            <property name="@bind_up" type="list" default="">
                <tr lang="en">MIDI/keyboard bind expression for up action</tr>
                <tr lang="ru" finished="false">MIDI/клавиатура связывает выражение up action</tr>
            </property>
            <!-- @max -->
            <property name="@max" type="float" default="8192">
                <tr lang="en">maximum inc value</tr>
                <tr lang="ru" finished="false">Максимальное значение inc</tr>
            </property>
            <!-- @min -->
            <property name="@min" type="float" default="-8192">
                <tr lang="en">minimum inc value</tr>
                <tr lang="ru" finished="false">Минимальное значение inc</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="15 20">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
            <!-- @step -->
            <property name="@step" type="float" default="1" minvalue="0">
                <tr lang="en">increment step</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="float" default="0">
                <tr lang="en">current widget value</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clears specified preset</tr>
                    <tr lang="ru" finished="false">заданный заранее</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
            <!-- dec -->
            <method name="dec">
                <info>
                    <tr lang="en">decrements widget with output</tr>
                    <tr lang="ru" finished="false">Decrements Виджет с выходом</tr>
                </info>
            </method>
            <!-- inc -->
            <method name="inc">
                <info>
                    <tr lang="en">increments widget with output</tr>
                    <tr lang="ru" finished="false">Increments Виджет с выходом</tr>
                </info>
            </method>
            <!-- interp -->
            <method name="interp">
                <info>
                    <tr lang="en">for this object acts as *load*, no interpolation performed</tr>
                    <tr lang="ru" finished="false">для этого объекта действует как *load*,
                    интерполяция не выполняется</tr>
                </info>
            </method>
            <!-- load -->
            <method name="load">
                <info>
                    <tr lang="en">loads specified preset</tr>
                    <tr lang="ru" finished="false">заданный заранее заданный</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
            <!-- pos -->
            <method name="pos">
                <info>
                    <tr lang="en">set UI element position</tr>
                    <tr lang="ru" finished="false">Установите положение элемента UI</tr>
                </info>
                <param name="X" type="float" required="true">
                    <tr lang="en">top left x-coord</tr>
                    <tr lang="ru" finished="false">верхний левый x-coord</tr>
                </param>
                <param name="Y" type="float" required="true">
                    <tr lang="en">top right y-coord</tr>
                    <tr lang="ru" finished="false">верхняя правая y-coord</tr>
                </param>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">set widget value with no output</tr>
                    <tr lang="ru" finished="false">значение виджета без выхода</tr>
                </info>
                <param name="VAL" type="float" required="true">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- store -->
            <method name="store">
                <info>
                    <tr lang="en">stores specified preset</tr>
                    <tr lang="ru" finished="false">магазины, указанные Preset</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">outputs current widget value</tr>
                    <tr lang="ru" finished="false">значение текущего виджета</tr>
                </in>
                <in on="float">
                    <tr lang="en">change widget value and output it</tr>
                    <tr lang="ru" finished="false">изменить значение виджета и вывести его</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output value</tr>
                    <tr lang="ru" finished="false">выходная стоимость</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B] [inc( [dec(                [F]
|   |     |                    |
|   |     | [@value?( [set 10( [@step $1(
|   |     | |         |        |
|   |     | |  [F]    |        |
|   |     | |  |      |        |
[ui.incdec            @step 0.1]
|
[prop-> @value]
|         ^|
[F]       [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
