<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="midi.sysex">
        <title>midi.sysex</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">output sysex input messages as a list</tr>
                <tr lang="ru">выводит входные sysex сообщения в виде списка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>midi</category>
            <keywords>midi sysexin</keywords>
            <since>0.9.2</since>
        </meta>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset internal parser state</tr>
                    <!-- old: Перезагрузка внутреннего парсерного
                    состояния -->
                    <tr lang="ru" finished="false">Перезагрузка внутреннего парсерного
                    состояния</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in>
                    <tr lang="en">control input</tr>
                    <tr lang="ru" finished="false">контрольный вход</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">list of sysex bytes</tr>
                    <tr lang="ru" finished="false">Список sysex bytes</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[midi.sysex]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
