<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="lfo.tri~">
        <title>lfo.tri~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">zero-mean unit-amplitude low frequency triangle wave</tr>
                <tr lang="ru">низкочастотная треугольная волна единичной амплитуды с нулевым
                средним значением</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>lfo</category>
            <keywords>lfo oscillator triangle</keywords>
            <since>0.1</since>
            <also>
                <see>lfo.+tri~</see>
                <see>lfo.square~</see>
                <see>lfo.impulse~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="0" maxvalue="1000">
                <tr lang="en">frequency</tr>
                <tr lang="ru" finished="false">частота</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" default="0" minvalue="0" maxvalue="1000"
            units="hertz">
                <tr lang="en">initial frequency</tr>
                <tr lang="ru" finished="false">Начальная частота</tr>
            </property>
            <!-- @pause -->
            <property name="@pause" type="bool" default="0">
                <tr lang="en">pause oscillator at current value</tr>
                <tr lang="ru" finished="false">осциллятор паузы при текущем значении</tr>
            </property>
            <!-- @phase -->
            <property name="@phase" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">initial phase</tr>
                <tr lang="ru" finished="false">начальный этап</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                    <tr lang="ru" finished="false">Перезагрузка в начальное состояние</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">frequency in Hz (can be zero or negative)</tr>
                    <!-- old: частота в Гц (может быть нулевой или
                    отрицательной) -->
                    <tr lang="ru" finished="false">частота в Гц (может быть нулевой или
                    отрицательной)</tr>
                </in>
            </inlet>
            <inlet>
                <in on="bang">
                    <tr lang="en">reset phase</tr>
                    <tr lang="ru" finished="false">фаза сброса</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">triangle wave in [1,-1] range</tr>
                    <tr lang="ru" finished="false">Треугольная волна в [1,-1] диапазоне</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[osc.saw~ 40]             [ui.dsp~]
|
[ui.hgain~]
|
|        [F]         [bang(
|        |           |.
|        [lfo.tri~ 0.5]
|        |.
[pan.linsig~]
|  ^|.
[dac~ ]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
