<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="proto.inscore">
        <title>proto.inscore</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">creation of messages for the INScore program</tr>
                <tr lang="ru">создание сообщений для программы INScore</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>proto</category>
            <keywords>inscore</keywords>
            <since>0.9.6</since>
        </meta>
        <properties>
            <!-- @scene -->
            <property name="@scene" type="int" minvalue="0" default="0">
                <tr lang="en">scene id</tr>
            </property>
        </properties>
        <methods>
            <!-- alpha -->
            <method name="alpha">
                <info>
                    <tr lang="en">set object alpha opacity</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="VAL" type="float" required="true">
                    <tr lang="en">alpha value</tr>
                </param>
            </method>
            <!-- angle -->
            <method name="angle">
                <info>
                    <tr lang="en">rotate object</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="ANGLE" type="float" required="true" units="degree">
                    <tr lang="en">rotation angle (clockwise)</tr>
                </param>
            </method>
            <!-- color -->
            <method name="color">
                <info>
                    <tr lang="en">set object color</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="VAL" type="list" required="true">
                    <tr lang="en">color: RGB list of floats in [0-1] range or color name</tr>
                </param>
            </method>
            <!-- del -->
            <method name="del">
                <info>
                    <tr lang="en">remove object</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
            </method>
            <!-- dscale -->
            <method name="dscale">
                <info>
                    <tr lang="en">relative object scale</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="VAL" type="float" required="true">
                    <tr lang="en">value</tr>
                </param>
            </method>
            <!-- dx -->
            <method name="dx">
                <info>
                    <tr lang="en">move object horizontally by specified X offset</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="POS" type="float">
                    <tr lang="en">X offset</tr>
                </param>
            </method>
            <!-- dy -->
            <method name="dy">
                <info>
                    <tr lang="en">move object vertically by specified Y offset</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="POS" type="float">
                    <tr lang="en">Y offset</tr>
                </param>
            </method>
            <!-- dz -->
            <method name="dz">
                <info>
                    <tr lang="en">move object vertically by specified Z offset</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="POS" type="float">
                    <tr lang="en">Z offset</tr>
                </param>
            </method>
            <!-- ellipse -->
            <method name="ellipse">
                <info>
                    <tr lang="en">create ellipse</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="W" type="float" required="true">
                    <tr lang="en">width</tr>
                </param>
                <param name="H" type="float" required="true">
                    <tr lang="en">height</tr>
                </param>
            </method>
            <!-- file -->
            <method name="file">
                <info>
                    <tr lang="en">set object from file content</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="URL" type="symbol" required="true">
                    <tr lang="en">url</tr>
                </param>
            </method>
            <!-- font_size -->
            <method name="font_size">
                <info>
                    <tr lang="en">set object fontsize</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="SIZE" type="float" required="true">
                    <tr lang="en">fontsize</tr>
                </param>
            </method>
            <!-- font_weight -->
            <method name="font_weight">
                <info>
                    <tr lang="en">set object font weight</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="SIZE" type="symbol" required="true"
                enum="light|demibold|normal|bold|black">
                    <tr lang="en">weight</tr>
                </param>
            </method>
            <!-- gmn -->
            <method name="gmn">
                <info>
                    <tr lang="en">create Guido Music notation</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="NOTES" type="list">
                    <tr lang="en">Guido Music Notation</tr>
                </param>
            </method>
            <!-- gmn<< -->
            <method name="gmn&lt;&lt;">
                <info>
                    <tr lang="en">append Guido Music notation to object, can be called several
                    times</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="NOTES" type="list" required="true">
                    <tr lang="en">Guido Music Notation</tr>
                </param>
            </method>
            <!-- height -->
            <method name="height">
                <info>
                    <tr lang="en">set object width</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="WD" type="float">
                    <tr lang="en">height</tr>
                </param>
            </method>
            <!-- make_chord -->
            <method name="make_chord">
                <info>
                    <tr lang="en">output guido chord as symbol</tr>
                </info>
                <param name="NOTES" type="list">
                    <tr lang="en">guido notation</tr>
                </param>
            </method>
            <!-- make_cluster -->
            <method name="make_cluster">
                <info>
                    <tr lang="en">output guido cluster as symbol</tr>
                </info>
                <param name="NOTES" type="list">
                    <tr lang="en">guido notation</tr>
                </param>
            </method>
            <!-- rect -->
            <method name="rect">
                <info>
                    <tr lang="en">create rectangle</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="W" type="float" required="true">
                    <tr lang="en">width</tr>
                </param>
                <param name="H" type="float" required="true">
                    <tr lang="en">height</tr>
                </param>
            </method>
            <!-- scale -->
            <method name="scale">
                <info>
                    <tr lang="en">scale object</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="VAL" type="float" required="true">
                    <tr lang="en">value</tr>
                </param>
            </method>
            <!-- show -->
            <method name="show">
                <info>
                    <tr lang="en">show/hide object</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="VAL" type="int" required="true" enum="0 1">
                    <tr lang="en">object state</tr>
                </param>
            </method>
            <!-- text -->
            <method name="text">
                <info>
                    <tr lang="en">create text object at (0,0) position</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="ARGS" type="list">
                    <tr lang="en">content</tr>
                </param>
            </method>
            <!-- width -->
            <method name="width">
                <info>
                    <tr lang="en">set object width</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="WD" type="float">
                    <tr lang="en">width</tr>
                </param>
            </method>
            <!-- write -->
            <method name="write">
                <info>
                    <tr lang="en">text objects support writing in a stream-like way.</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="ITEMS" type="list" required="true">
                    <tr lang="en">added content</tr>
                </param>
            </method>
            <!-- write_chord -->
            <method name="write_chord">
                <info>
                    <tr lang="en">add chord to INScore</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="NOTES" type="list">
                    <tr lang="en">guido notation</tr>
                </param>
            </method>
            <!-- x -->
            <method name="x">
                <info>
                    <tr lang="en">move object to new Y-coord</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="POS" type="float">
                    <tr lang="en">new X position</tr>
                </param>
            </method>
            <!-- xorigin -->
            <method name="xorigin">
                <info>
                    <tr lang="en">set object X origin</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="POS" type="float" required="true">
                    <tr lang="en">X origin position</tr>
                </param>
            </method>
            <!-- y -->
            <method name="y">
                <info>
                    <tr lang="en">move object to new Y-coord</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="POS" type="float">
                    <tr lang="en">new Y position</tr>
                </param>
            </method>
            <!-- yorigin -->
            <method name="yorigin">
                <info>
                    <tr lang="en">set object Y origin</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="POS" type="float" required="true">
                    <tr lang="en">Y origin position</tr>
                </param>
            </method>
            <!-- z -->
            <method name="z">
                <info>
                    <tr lang="en">move object to new Z-coord</tr>
                </info>
                <param name="NAME" type="symbol" required="true">
                    <tr lang="en">object name</tr>
                </param>
                <param name="POS" type="float">
                    <tr lang="en">new Z position</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">control input</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">osc send command</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[text LABEL text message(
|
| [ui.hsl -1 1]     [ui.hsl 0 360]
| |                 |
| [x LABEL $1(      [angle LABEL $1(
| |                 |
| | [dx LABEL 0.1(  | [gmn M \[f b d# g#\](
| | |               | |
| | | [del LABEL(   | |
| | | |             | |
[proto.inscore        ]
|  |
|  [print INSCORE]
|
[net.osc.send osc.udp://localhost:7000 {i=1}]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
