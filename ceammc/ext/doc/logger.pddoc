<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="logger">
    <title>logger</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">advanced data logger for the Pd window</tr>
        <tr lang="ru">расширенный логгер данных для окна Pd</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>log</keywords>
      <since>0.9.1</since>
      <aliases>
        <alias>ceammc/logger</alias>
        <alias>log.error</alias>
        <alias>log.post</alias>
        <alias>log.debug</alias>
        <alias>log.verbose</alias>
        <alias>log.stdout</alias>
        <alias>log.stderr</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object outputs messages to the Pd window with an optional prefix</tr>
        <tr lang="ru">объект выводит сообщения в окно Pd с необязательным префиксом</tr>
      </par>
      <par>
        <tr lang="en">several aliases are provided for different log levels: log.error, log.debug, log.post, log.verbose, log.stdout and log.stderr</tr>
        <tr lang="ru">предусмотрено несколько псевдонимов для разных уровней логирования: log.error, log.debug, log.post, log.verbose, log.stdout и log.stderr</tr>
      </par>
      <par>
        <tr lang="en">logging can be enabled or disabled with the @active property or by sending 1 or 0 to the right inlet</tr>
        <tr lang="ru">логирование можно включать и выключать свойством @active или подачей 1 или 0 на правый вход</tr>
      </par>
    </info>
    <arguments>
      <argument name="PREFIX" type="list">
        <tr lang="en">log message prefix</tr>
        <tr lang="ru">префикс сообщения лога</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @active -->
      <property name="@active" type="bool" default="1">
        <tr lang="en">enabled/disabled logging state</tr>
        <tr lang="ru">состояние логирования: включено/выключено</tr>
      </property>
      <!-- @prefix -->
      <property name="@prefix" type="list" default="">
        <tr lang="en">log message prefix</tr>
        <tr lang="ru">префикс сообщения лога</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">log input</tr>
          <tr lang="ru">вход лога</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">1: enable logging, 0: disable logging</tr>
          <tr lang="ru">1: включить логирование, 0: выключить логирование</tr>
        </in>
      </inlet>
    </inlets>
    <outlets />
    <example>
      <pdascii>
<![CDATA[
[F]   [1 2 3(   [T]
|     |         |.
[log.error ERROR!]

[F]   [message( [T]
|     |         |.
[log.debug        ]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
