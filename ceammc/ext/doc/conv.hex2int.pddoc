<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.hex2int">
    <title>conv.hex2int</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts hex symbol into an integer value</tr>
        <tr lang="ru">преобразует шестнадцатеричный символ в целое число</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv int hex</keywords>
      <since>0.9.1</since>
      <aliases>
        <alias>ceammc/hex-&gt;int</alias>
        <alias>hex-&gt;int</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts a hexadecimal value given as a symbol (with or without
        the 0x prefix) into an integer. A single symbol or a list of symbols can be sent to the
        inlet. By default the object reports parsing errors; if the @strict flag is set, parsing
        errors are silently ignored.</tr>
        <tr lang="ru">Объект преобразует шестнадцатеричное значение, заданное символом (с префиксом
        0x или без него), в целое число. На вход можно подать один символ или список символов. По
        умолчанию объект сообщает об ошибках разбора; если установлен флаг @strict, ошибки разбора
        молча игнорируются.</tr>
      </par>
    </info>
    <properties>
      <!-- @strict -->
      <property name="@strict" type="flag" access="initonly">
        <tr lang="en">ignore parsing errors</tr>
        <tr lang="ru">игнорировать ошибки разбора</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">input value</tr>
          <tr lang="ru">входное значение</tr>
        </in>
        <in on="list">
          <tr lang="en">input values</tr>
          <tr lang="ru">входные значения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">converted value: int</tr>
          <tr lang="ru">преобразованное значение: целое число</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[symbol 0xFF(
|
[hex->int]
|
[F]

[list 0xFF 0xFFFF DEADBEEF(
|
[hex->int]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
