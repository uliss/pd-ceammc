<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.apple_sms">
    <title>hw.apple_sms</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">query the sudden motion sensor in Apples</tr>
        <tr lang="ru">опрос датчика внезапного движения (Sudden Motion Sensor) в Mac</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>motion sensor</keywords>
      <since>0.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">In raw output mode, values can be in various output ranges and signs.
        Otherwise, output data are normalized to float range, where positive *x* means rightwards,
        positive *y* means rearwards, positive *z* means upwards, but not all devices are in the
        database.</tr>
        <tr lang="ru">В режиме «сырого» вывода значения могут быть в различных диапазонах и с
        разными знаками. В противном случае выходные данные нормализуются в диапазон чисел с
        плавающей точкой, где положительный *x* означает вправо, положительный *y* — назад,
        положительный *z* — вверх, но не все устройства внесены в базу данных.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Tilt and shake control — using the orientation of an Apple laptop or a
        device with SMS to control parameters (pitch, filter, pan) by physically tilting or shaking
        the machine.</tr>
        <tr lang="ru">• Управление наклоном и встряхиванием — использование ориентации ноутбука
        Apple или устройства с SMS для управления параметрами (высота тона, фильтр, панорама) с
        помощью физического наклона или встряхивания.</tr>
      </par>
    </info>
    <properties>
      <!-- @raw -->
      <property name="@raw" type="bool" default="0">
        <tr lang="en">raw data output mode</tr>
        <tr lang="ru">режим вывода «сырых» данных</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the current motion sensor information</tr>
          <tr lang="ru">выводит текущую информацию датчика движения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">list of three values: x-rotation, y-rotation, z-acceleration</tr>
          <tr lang="ru">список из трёх значений: x-вращение, y-вращение, z-ускорение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[metro 300] [T]
|           |
|           [@raw $1(
|           |
[hw.apple_sms]
|
[unpack    0 0 0]
|      ^|     ^^|
[F]    [F]    [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
