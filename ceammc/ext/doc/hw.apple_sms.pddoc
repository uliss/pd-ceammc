<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.apple_sms">
    <title>hw.apple_sms</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">query the sudden motion sensor in Apples</tr>
        <tr lang="ru">опрос датчика внезапного движения в Apple</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>motion sensor</keywords>
      <since>0.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">In raw output mode output values can be in various output range and sign,
        otherwise output data are normalized to float range, where positive *x* mean rightwards,
        positive *y* means rearwards, positive *z* mean upwards, but not all devices are in
        database. It it occures with your device (wrong direction), please, send us this
        information</tr>
        <!-- old: В режиме необработанного вывода выходные значения
                могут быть в различных диапазонах и знаках, в противном случае выходные данные
                нормализуются до диапазона плавания, где положительные *x * означают вправо,
                положительные *y * означают взад, положительные *z * означают в сторону вверх, но
                не все устройства находятся в базе данных. Это происходит с вашим устройством
                (неправильное направление), пожалуйста, отправьте нам эту информацию -->
        <tr lang="ru" finished="false">В режиме необработанного вывода выходные значения могут быть
        в различных диапазонах и знаках, в противном случае выходные данные нормализуются до
        диапазона плавания, где положительные *x * означают вправо, положительные *y * означают
        взад, положительные *z * означают в сторону вверх, но не все устройства находятся в базе
        данных. Это происходит с вашим устройством (неправильное направление), пожалуйста,
        отправьте нам эту информацию</tr>
      </par>
    </info>
    <properties>
      <!-- @raw -->
      <property name="@raw" type="bool" default="0">
        <tr lang="en">raw data output mode</tr>
        <tr lang="ru">режим вывода необработанных данных</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the current motion sensor information</tr>
          <tr lang="ru">выводит текущую информацию датчика движения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">list of three values: x-rotation, y-rotation, z-acceleration</tr>
          <tr lang="ru">список из трех значений: x-вращение, y-вращение,
          z-ускорение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[metro 300] [T]
|           |
|           [@raw $1(
|           |
[hw.apple_sms]
|
[unpack    0 0 0]
|      ^|     ^^|
[F]    [F]    [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
