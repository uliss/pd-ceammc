<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="hw.printer">
        <title>hw.printer</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">basic document printing support</tr>
                <tr lang="ru">базовая поддержка печати документов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display brightness</keywords>
            <since>0.9.8</since>
        </meta>
        <info>
            <par>
                <tr lang="en">MacOs: supports only text, PDF and images files.</tr>
            </par>
            <par>
                <tr lang="en">Windows: supports only PDF files.</tr>
            </par>
        </info>
        <arguments>
            <argument name="NAME" type="symbol">
                <tr lang="en">printer name. If not specified, it uses the default system
                printer.</tr>
                <tr lang="ru">имя принтера. Если не указано - использует системный принтер по
                умолчанию</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @name -->
            <property name="@name" type="symbol" default="">
                <tr lang="en">printer name, if empty - use default system printer</tr>
                <tr lang="ru" finished="false">Имя принтера, если пусто - используйте системный
                принтер по умолчанию</tr>
            </property>
        </properties>
        <methods>
            <!-- choose -->
            <method name="choose">choose printer by index 
            <param name="IDX" type="int" minvalue="0">
                <tr lang="en">printer index in device list</tr>
            </param></method>
            <!-- devices -->
            <method name="devices">list printers</method>
            <!-- print -->
            <method name="print">print file 
            <param name="FILE" type="symbol" required="true">
                <tr lang="en">file to print</tr>
            </param>
            <param name="@landscape" type="bool" required="false">
                <tr lang="en">print in landscape mode</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>dict: printer info output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[devices(  [B]
|          |
| [choose( [openpanel]
| |        |
| |        [print $1 @landscape 0(
| |        |
[hw.printer]/*using default printer*/
|
[print]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
