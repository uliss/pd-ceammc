<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.printer">
    <title>hw.printer</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">basic document printing support</tr>
        <tr lang="ru">базовая поддержка печати документов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>printer print document</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">macOS: supports only text, PDF and image files.</tr>
        <tr lang="ru">macOS: поддерживаются только текстовые, PDF- и графические файлы.</tr>
      </par>
      <par>
        <tr lang="en">Windows: supports only PDF files.</tr>
        <tr lang="ru">Windows: поддерживаются только PDF-файлы.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Printing scores and documents — sending a generated PDF or a text file (for
        example, a score, a list of parameters or an event log) directly to a printer from a Pd
        patch.</tr>
        <tr lang="ru">• Печать партитур и документов — отправка сгенерированного PDF- или
        текстового файла (например, партитуры, списка параметров или журнала событий) на принтер
        прямо из патча Pd.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Printed output from installations — physically printing a document as part
        of an art installation or a performance, for example to print a receipt, a label or a score
        at the moment of an event.</tr>
        <tr lang="ru">• Печатный вывод в инсталляциях — физическая печать документа как часть
        арт-инсталляции или перформанса, например чтобы распечатать чек, этикетку или партитуру в
        момент события.</tr>
      </par>
    </info>
    <arguments>
      <argument name="NAME" type="symbol">
        <tr lang="en">printer name. If not specified, the default system printer is used.</tr>
        <tr lang="ru">имя принтера. Если не указано, используется системный принтер по
        умолчанию</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @name -->
      <property name="@name" type="symbol" default="">
        <tr lang="en">printer name. If empty, the default system printer is used</tr>
        <tr lang="ru">имя принтера. Если пусто — используется системный принтер по умолчанию</tr>
      </property>
    </properties>
    <methods>
      <!-- choose -->
      <method name="choose">
        <info>
          <tr lang="en">chooses a printer by index</tr>
          <tr lang="ru">выбирает принтер по индексу</tr>
        </info>
        <param name="IDX" type="int" minvalue="0">
          <tr lang="en">printer index in device list</tr>
          <tr lang="ru">индекс принтера в списке устройств</tr>
        </param>
      </method>
      <!-- devices -->
      <method name="devices">
        <info>
          <tr lang="en">lists printers</tr>
          <tr lang="ru">выводит список принтеров</tr>
        </info>
      </method>
      <!-- print -->
      <method name="print">
        <info>
          <tr lang="en">prints a file</tr>
          <tr lang="ru">печатает файл</tr>
        </info>
        <param name="FILE" type="symbol" required="true">
          <tr lang="en">file to print</tr>
          <tr lang="ru">файл для печати</tr>
        </param>
        <param name="@landscape" type="bool" required="false">
          <tr lang="en">print in landscape mode</tr>
          <tr lang="ru">печать в ландшафтной ориентации</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input</tr>
          <tr lang="ru">вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">dict: printer info output</tr>
          <tr lang="ru">словарь: вывод информации о принтере</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[devices(  [B]
|          |
| [choose( [openpanel]
| |        |
| |        [print $1 @landscape 0(
| |        |
[hw.printer]/*using default printer*/
|
[print]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
