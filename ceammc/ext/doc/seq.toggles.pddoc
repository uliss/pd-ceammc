<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="seq.toggles">
        <title>seq.toggles</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">toggle sequencer</tr>
                <tr lang="ru">секвенсор переключающих событий</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>seq</category>
            <keywords>seq sequencer toggle pattern rhythm</keywords>
            <since>0.9.1</since>
            <aliases>
                <alias>seq.t</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Output 1 on event start and 0 on event end</tr>
                <tr lang="ru" finished="false">Результат 1 на начало события и 0 на конец
                события</tr>
            </par>
            <par>
                <tr lang="en">The event length is controlled via @length property. It can be fixed,
                percent or subtractive. Percent values are calculated from whole event duration.
                Positive values &gt;=0 treated as fixed event length. Values &lt;0 are calculated
                as EVENT_DUR-value</tr>
                <tr lang="ru" finished="false">Длина события контролируется через @length. Она
                может быть фиксированной, процентной или субтрактивной. Процентное значение
                рассчитывается по всей продолжительности события. Положительные значения &gt;=0
                рассматриваются как фиксированная длина события. Значения &lt;0 рассчитываются как
                EVENT_DUR-значение</tr>
            </par>
            <par>
                <tr lang="en">• 'percent': @length 60% and @t 100ms - for event value '2', event
                duration is 200ms, event length is 120ms</tr>
                <tr lang="ru" finished="false">• «%»: @length 60% и @t 100ms - для значения события
                «2», продолжительность события составляет 200 мс, длина события составляет 120
                мс</tr>
            </par>
            <par>
                <tr lang="en">• 'fixed': @length 10 or @length 10ms and @t 100ms - event any
                duration, event length is fixed: 10ms</tr>
                <tr lang="ru" finished="false">• «фиксированный»: @length 10 или @length 10ms и @t
                100ms — событие любой продолжительности, длина события фиксирована: 10ms</tr>
            </par>
            <par>
                <tr lang="en">• 'subtract': @length -40 and @t 100ms - for event value '2', event
                duration is 200ms, event length is 160 (200-40). For event value '1', event
                duration is 100ms, event length is 60 (100-40)</tr>
                <tr lang="ru" finished="false">• 'subtract': @length -40 и @t 100ms - для значения
                события '2', продолжительность события 200ms, длина события 160 (200-40). Для
                значения события «1» продолжительность события составляет 100 мс, длина события
                составляет 60 (100-40)</tr>
            </par>
        </info>
        <arguments>
            <argument name="P" type="list">
                <tr lang="en">sequencer pattern in beat duration units</tr>
                <tr lang="ru" finished="false">шаблон секвенсора в битовых единицах
                продолжительности</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @div -->
            <property name="@div" type="int" minvalue="1" default="1" maxvalue="64">
                <tr lang="en">beat subdivision</tr>
                <tr lang="ru" finished="false">Победить подразделение</tr>
            </property>
            <!-- @dur -->
            <property name="@dur" type="float" default="0" minvalue="0" units="millisecond">
                <tr lang="en">whole sequence duration. (Recalculates @t property accordingly)</tr>
                <tr lang="ru" finished="false">Продолжительность всей последовательности.
                (Соответственно пересчитывает имущество @t)</tr>
            </property>
            <!-- @i -->
            <property name="@i" type="int" access="readonly" default="0">
                <tr lang="en">current sequence iteration</tr>
                <tr lang="ru" finished="false">итерация текущей последовательности</tr>
            </property>
            <!-- @inf -->
            <property name="@inf" type="alias">
                <tr lang="en">alias to @r -1, repeats infinitely</tr>
                <tr lang="ru" finished="false">alias to @r-1, повторяется бесконечно</tr>
            </property>
            <!-- @length -->
            <property name="@length" type="float" default="75">
                <tr lang="en">event length. In case of float or float wuth 'ms' suffix - event
                length is fixed for any event duration. In case of V% - @length expected to be in
                0..100 range and event length is percent of duration. In case of negative @length
                event duration is calculated as duration+@length, but not less then 1</tr>
                <tr lang="ru" finished="false">Длина события. В случае поплавка или поплавка wuth
                'ms' суффикс - длина события фиксируется на любую продолжительность события. В
                случае V% - @length ожидается в диапазоне 0..100, а длина события составляет
                процент от продолжительности. В случае отрицательного @length продолжительность
                события рассчитывается как продолжительность + @length, но не менее 1</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" enum="inc dec tri" default="inc">
                <tr lang="en">sequencer mode. 'inc': from first to last, 'dec': from last to first,
                'tri': from first to last, then back</tr>
                <tr lang="ru" finished="false">"inc": от первого до последнего, "dec": от
                последнего до первого, "tri": от первого до последнего, затем обратно</tr>
            </property>
            <!-- @once -->
            <property name="@once" type="alias">
                <tr lang="en">alias to @r 1, play once</tr>
                <tr lang="ru" finished="false">alias to @r 1, играть один раз</tr>
            </property>
            <!-- @p -->
            <property name="@p" type="list" default="">
                <tr lang="en">sequencer pattern in beat duration units</tr>
                <tr lang="ru" finished="false">шаблон секвенсора в битовых единицах
                продолжительности</tr>
            </property>
            <!-- @r -->
            <property name="@r" type="int" minvalue="-1" default="1">
                <tr lang="en">number of whole sequence repeats. If -1: repeat infinitely</tr>
                <tr lang="ru" finished="false">Количество повторений целой последовательности. Если
                -1: повторять бесконечно</tr>
            </property>
            <!-- @ri -->
            <property name="@ri" type="int" access="readonly" default="0">
                <tr lang="en">current repeat iteration</tr>
                <tr lang="ru" finished="false">Текущая повторная итерация</tr>
            </property>
            <!-- @t -->
            <property name="@t" type="float" default="100" minvalue="1" maxvalue="20000"
            units="millisecond">
                <tr lang="en">time between beats. Unit values like 100ms, 240bpm or 60|4bpm also
                can be used</tr>
                <tr lang="ru" finished="false">Время между ударами. Значения единицы, такие как 100
                мс, 240bpm или 60 | 4bpm, также могут использоваться.</tr>
            </property>
            <!-- @upbeat -->
            <property name="@upbeat" type="float" default="0" minvalue="0">
                <tr lang="en">wait specified number of beats before sequence start</tr>
                <tr lang="ru" finished="false">ожидание определенного количества ударов перед
                началом последовательности</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset all counters and stop</tr>
                    <tr lang="ru" finished="false">Сбросить все счетчики и остановиться</tr>
                </info>
            </method>
            <!-- rewind -->
            <method name="rewind">
                <info>
                    <tr lang="en">reset all counters without stopping</tr>
                    <tr lang="ru" finished="false">Сбросить все счетчики без остановки</tr>
                </info>
            </method>
            <!-- start -->
            <method name="start">
                <info>
                    <tr lang="en">start sequencer from current position</tr>
                    <tr lang="ru" finished="false">стартовый секвенсор с текущей позиции</tr>
                </info>
            </method>
            <!-- stop -->
            <method name="stop">
                <info>
                    <tr lang="en">stop sequencer</tr>
                    <tr lang="ru" finished="false">остановить секвенсор</tr>
                </info>
            </method>
            <!-- tick -->
            <method name="tick">
                <info>
                    <tr lang="en">output current sequence element and move to next</tr>
                    <tr lang="ru" finished="false">вывести элемент текущей последовательности и
                    перейти к следующему</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">reset sequence and repeat counters and start sequencer</tr>
                    <tr lang="ru" finished="false">перезагрузить последовательность и повторить
                    счетчики и запустить секвенсор</tr>
                </in>
            </inlet>
            <inlet>
                <in on="list">
                    <tr lang="en">set new pattern value</tr>
                    <tr lang="ru" finished="false">Устанавливает новое значение шаблона</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">1 and 0</tr>
                    <tr lang="ru" finished="false">1 и 0</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">[i IDX N( - sequence iteration, [ri IDX N( - repeat iteration,
                    [ed MS( - event duration, [el MS( event length or [done( when done</tr>
                    <tr lang="ru" finished="false">[i IDX N( - итерация последовательности, [ri IDX
                    N( - повторная итерация, [ed MS( - продолжительность события, [el MS(длина
                    события) или [сделано)]]</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B] [start([stop( [reset( [F]           [F]
|   |       |      |      |             |
|   |       |      |      [@length $1%( [@length $1ms(
|   |       |      |      |             |
|   |       |      |      |             |
[seq.toggles 3 1 2 1 1 @t 120ms @inf    ]
|                          ^|
[lop~ 50] [osc~ 1000]      [route done i ri ed el ]
|         |.               |   ^|   ^^|  ^^^| ^^^^|
[*~        ]               [B]  [F]  [F]  [F]   [F]
|
[ui.hgain~]                [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
