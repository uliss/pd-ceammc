<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="seq.toggles">
    <title>seq.toggles</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">toggle sequencer</tr>
        <tr lang="ru">секвенсор переключающих событий (toggle)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>seq</category>
      <keywords>seq sequencer toggle pattern rhythm</keywords>
      <since>0.9.1</since>
      <aliases>
        <alias>seq.t</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Toggle sequencer: outputs 1 when an event starts and 0 when it ends. The
        pattern is given in beat duration units (relative to @t), and the duration of each event
        is controlled by @length. This makes it convenient for driving gates, envelopes or any
        object that expects an on/off control signal.</tr>
        <tr lang="ru">Секвенсор переключающих событий (toggle): выводит 1 в начале события и 0 в
        его конце. Паттерн задаётся в единицах длительности доли (относительно @t), а
        длительность каждого события управляется свойством @length. Это удобно для управления
        gate-сигналами, огибающими и любыми объектами, ожидающими управляющий сигнал вкл/выкл.</tr>
      </par>
      <par>
        <tr lang="en">Event length (@length) can be specified in three forms:</tr>
        <tr lang="ru">Длительность события (@length) может задаваться в трёх формах:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• percent: @length 60% with @t 100ms — for an event value of 2 (duration
        200ms), the event length will be 120ms.</tr>
        <tr lang="ru">• процент: @length 60% при @t 100ms — для значения события 2
        (длительность 200ms) длина события составит 120ms.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• fixed: @length 10 or @length 10ms with @t 100ms — the event length is
        fixed at 10ms regardless of how long the event lasts.</tr>
        <tr lang="ru">• фиксированная: @length 10 или @length 10ms при @t 100ms — длина события
        фиксирована на 10ms независимо от длительности самого события.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• subtract: @length -40 with @t 100ms — for an event value of 2 (duration
        200ms), the event length is 160ms (200−40), for an event value of 1 (duration 100ms), the
        event length is 60ms (100−40).</tr>
        <tr lang="ru">• вычитание: @length -40 при @t 100ms — для значения события 2
        (длительность 200ms) длина события составит 160ms (200−40), для значения события 1
        (длительность 100ms) длина события составит 60ms (100−40).</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Gate patterns for envelopes — driving the gate input of an envelope
        generator (for example, [env.adsr~]) with rhythmic on/off events, so that each note has
        the correct attack and release behaviour.</tr>
        <tr lang="ru">• Паттерны gate для огибающих — управление входом gate генератора огибающей
        (например, [env.adsr~]) ритмическими событиями вкл/выкл, чтобы каждая нота имела
        правильные атаку и восстановление.</tr>
      </par>
    </info>
    <arguments>
      <argument name="P" type="list">
        <tr lang="en">sequencer pattern in beat duration units</tr>
        <tr lang="ru">паттерн секвенсора в единицах длительности доли</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @div -->
      <property name="@div" type="int" minvalue="1" default="1" maxvalue="64">
        <tr lang="en">beat subdivision</tr>
        <tr lang="ru">дробление доли</tr>
      </property>
      <!-- @dur -->
      <property name="@dur" type="float" default="0" minvalue="0" units="millisecond">
        <tr lang="en">whole sequence duration (recalculates the @t property accordingly)</tr>
        <tr lang="ru">длительность всей последовательности (соответственно пересчитывает свойство
        @t)</tr>
      </property>
      <!-- @i -->
      <property name="@i" type="int" access="readonly" default="0">
        <tr lang="en">current sequence iteration</tr>
        <tr lang="ru">текущая итерация последовательности</tr>
      </property>
      <!-- @inf -->
      <property name="@inf" type="alias">
        <tr lang="en">alias for @r -1, repeats infinitely</tr>
        <tr lang="ru">сокращение для @r -1, повторяется бесконечно</tr>
      </property>
      <!-- @length -->
      <property name="@length" type="float" default="75">
        <tr lang="en">event length. A plain number or a number with the 'ms' suffix fixes the
        event length for any event duration. A value with the '%' suffix is treated as a percentage
        of the event duration (expected in the 0..100 range). A negative value is subtracted from
        the event duration (duration + @length), but the result is never less than 1</tr>
        <tr lang="ru">длительность события. Обычное число или число с суффиксом 'ms' фиксирует
        длительность события для любой продолжительности события. Значение с суффиксом '%'
        трактуется как процент от длительности события (ожидается в диапазоне 0..100).
        Отрицательное значение вычитается из длительности события (duration + @length), но
        результат никогда не меньше 1</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" enum="inc dec tri" default="inc">
        <tr lang="en">sequencer mode. 'inc' — from first to last, 'dec' — from last to first,
        'tri' — from first to last, then back</tr>
        <tr lang="ru">режим секвенсора. 'inc' — от первого к последнему, 'dec' — от последнего к
        первому, 'tri' — от первого к последнему, затем обратно</tr>
      </property>
      <!-- @once -->
      <property name="@once" type="alias">
        <tr lang="en">alias for @r 1, play once</tr>
        <tr lang="ru">сокращение для @r 1, играть один раз</tr>
      </property>
      <!-- @p -->
      <property name="@p" type="list" default="">
        <tr lang="en">sequencer pattern in beat duration units</tr>
        <tr lang="ru">паттерн секвенсора в единицах длительности доли</tr>
      </property>
      <!-- @r -->
      <property name="@r" type="int" minvalue="-1" default="1">
        <tr lang="en">number of whole sequence repeats. If -1 — repeats infinitely</tr>
        <tr lang="ru">число повторов всей последовательности. Если -1 — повторяется бесконечно</tr>
      </property>
      <!-- @ri -->
      <property name="@ri" type="int" access="readonly" default="0">
        <tr lang="en">current repeat iteration</tr>
        <tr lang="ru">текущая итерация повтора</tr>
      </property>
      <!-- @t -->
      <property name="@t" type="float" default="100" minvalue="1" maxvalue="20000"
      units="millisecond">
        <tr lang="en">time between beats. Unit values like 100ms, 240bpm or 60|4bpm can also be
        used</tr>
        <tr lang="ru">время между долями. Можно также использовать значения с единицами, например
        100ms, 240bpm или 60|4bpm</tr>
      </property>
      <!-- @upbeat -->
      <property name="@upbeat" type="float" default="0" minvalue="0">
        <tr lang="en">wait the specified number of beats before the sequence starts</tr>
        <tr lang="ru">ждать заданное число долей перед запуском последовательности</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets all counters and stops</tr>
          <tr lang="ru">сбрасывает все счётчики и останавливает секвенсор</tr>
        </info>
      </method>
      <!-- rewind -->
      <method name="rewind">
        <info>
          <tr lang="en">resets all counters without stopping</tr>
          <tr lang="ru">сбрасывает все счётчики без остановки</tr>
        </info>
      </method>
      <!-- start -->
      <method name="start">
        <info>
          <tr lang="en">starts the sequencer from the current position</tr>
          <tr lang="ru">запускает секвенсор с текущей позиции</tr>
        </info>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stops the sequencer</tr>
          <tr lang="ru">останавливает секвенсор</tr>
        </info>
      </method>
      <!-- tick -->
      <method name="tick">
        <info>
          <tr lang="en">outputs the current sequence element and moves to the next</tr>
          <tr lang="ru">выводит текущий элемент последовательности и переходит к следующему</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">resets the sequence and repeat counters and starts the sequencer</tr>
          <tr lang="ru">сбрасывает счётчики последовательности и повторов и запускает
          секвенсор</tr>
        </in>
      </inlet>
      <inlet>
        <in on="list">
          <tr lang="en">sets a new pattern value</tr>
          <tr lang="ru">устанавливает новое значение паттерна</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">1 and 0</tr>
          <tr lang="ru">1 и 0</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">[i IDX N( — sequence iteration, [ri IDX N( — repeat iteration,
          [ed MS( — event duration, [el MS( — event length, or [done( when done</tr>
          <tr lang="ru">[i IDX N( — итерация последовательности, [ri IDX N( — итерация повтора,
          [ed MS( — длительность события, [el MS( — длина события, или [done( по
          завершении</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B] [start([stop( [reset( [F]           [F]
|   |       |      |      |             |
|   |       |      |      [@length $1%( [@length $1ms(
|   |       |      |      |             |
|   |       |      |      |             |
[seq.toggles 3 1 2 1 1 @t 120ms @inf    ]
|                          ^|
[lop~ 50] [osc~ 1000]      [route done i ri ed el ]
|         |.               |   ^|   ^^|  ^^^| ^^^^|
[*~        ]               [B]  [F]  [F]  [F]   [F]
|
[ui.hgain~]                [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
