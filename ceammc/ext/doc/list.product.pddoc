<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="list.product">
    <title>list.product</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">calculates the product of all numbers in a list</tr>
        <tr lang="ru">вычисляет произведение всех чисел в списке</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>list</category>
      <keywords>list product</keywords>
      <since>0.1</since>
      <also>
        <see>list.sum</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Note: symbol values are treated as 0. So if list contains at least one
        symbol, product will be always equal to zero</tr>
        <!-- old: Примечание: значения символов рассматриваются как 0.
                Если список содержит хотя бы один символ, продукт всегда будет равен нулю. -->
        <tr lang="ru" finished="false">Примечание: значения символов рассматриваются как 0. Если
        список содержит хотя бы один символ, продукт всегда будет равен нулю.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">input list</tr>
          <tr lang="ru" finished="false">вводный список</tr>
        </in>
        <in on="data:mlist">
          <tr lang="en">input mlist</tr>
          <tr lang="ru" finished="false">входной млечный</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">float list product</tr>
          <tr lang="ru" finished="false">листовой продукт</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[1 2 3 4 5 -6(   [1 2 a b c(
|                |
|  [1 2 3(       |
|  |             |
|  |             |
[list.product    ]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
