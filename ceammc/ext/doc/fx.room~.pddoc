<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="fx.room~">
        <title>fx.room~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Gardners room emulation algorithm</tr>
                <tr lang="ru">алгоритм Гарднера для эмуляции комнаты</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx room reverb</keywords>
            <since>0.9.4</since>
        </meta>
        <arguments>
            <argument name="SIZE" type="float" minvalue="0" maxvalue="3">
                <tr lang="en">echo time</tr>
                <tr lang="ru" finished="false">время эхо</tr>
            </argument>
            <argument name="FB" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">feedback coefficient</tr>
                <tr lang="ru" finished="false">коэффициент обратной связи</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
                <!-- old: Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал. -->
                <tr lang="ru" finished="false">Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал.</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet</tr>
                <!-- old: пропорция смеси между исходными (сухими) и
                "влажными" сигналами. 0 - сухой сигнал, 1 - влажный -->
                <tr lang="ru" finished="false">пропорция смеси между исходными (сухими) и
                "влажными" сигналами. 0 - сухой сигнал, 1 - влажный</tr>
            </property>
            <!-- @fb -->
            <property name="@fb" type="float" minvalue="0" maxvalue="1" default="0.3">
                <tr lang="en">feedback coefficient</tr>
                <tr lang="ru" finished="false">коэффициент обратной связи</tr>
            </property>
            <!-- @hfdamp -->
            <property name="@hfdamp" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">damping factor for high frequencies</tr>
                <tr lang="ru" finished="false">Фактор демпфирования для высоких частот</tr>
            </property>
            <!-- @predelay -->
            <property name="@predelay" type="float" minvalue="1" maxvalue="200" default="20"
            units="millisecond">
                <tr lang="en">pre delay</tr>
                <tr lang="ru" finished="false">Предварительная задержка</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="float" minvalue="0" maxvalue="3" default="1">
                <tr lang="en">room size (0: no room, 1: small, 2: medium, 3: large). Non-integer
                values are interpolated betweed neighbours, for example 1.3 is interpoltation
                between first and second room size with 0.3 ratio.</tr>
                <!-- old: Размер комнаты (0: без комнаты, 1: маленький, 2:
                средний, 3: большой). не Целые значения интерполируются между соседними
                букмекерскими конями, например, 1.3 - интерполтация между первым и вторым размером
                комнаты с соотношением 0.3. -->
                <tr lang="ru" finished="false">Размер комнаты (0: без комнаты, 1: маленький, 2:
                средний, 3: большой). не Целые значения интерполируются между соседними
                букмекерскими конями, например, 1.3 - интерполтация между первым и вторым размером
                комнаты с соотношением 0.3.</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                    <tr lang="ru" finished="false">Перезагрузка в начальное состояние</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
            <inlet>
                <in on="float">
                    <tr lang="en">set room size</tr>
                    <tr lang="ru" finished="false">размер комнаты</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal</tr>
                    <tr lang="ru" finished="false">выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 1000]
|
[60(
|
[makenote 127 100] [ui.hsl 0 3 @show_value 1 #a]
*|*
[pack f f]         [ui.hrd 4]    [T]
|                  |             |
[synth.eguitar~]   [@size $1 #b( [@bypass $1(
|                  |             |
[fx.room~                        ]
|
[ui.hgain~]        [ui.dsp~]
|\
[dac~]
[X a->b]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
