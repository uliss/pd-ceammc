<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fx.room~">
    <title>fx.room~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Gardner's room emulation algorithm</tr>
        <tr lang="ru">алгоритм Гарднера для эмуляции комнаты</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>fx</category>
      <keywords>fx room reverb</keywords>
      <since>0.9.4</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object emulates room acoustics using the algorithm proposed by William G. Gardner, based on a network of delay lines with feedback</tr>
        <tr lang="ru">объект эмулирует акустику помещения по алгоритму, предложенному Уильямом Г. Гарднером, на основе сети линий задержки с обратной связью</tr>
      </par>
      <par>
        <tr lang="en">@size selects one of four room presets (none, small, medium, large), non-integer values are interpolated between neighbouring presets</tr>
        <tr lang="ru">@size выбирает один из четырёх пресетов помещения (нет, маленькое, среднее, большое), нецелые значения интерполируются между соседними пресетами</tr>
      </par>
      <par>
        <tr lang="en">@predelay sets the time before the first reflection, @hfdamp controls the damping of high frequencies, @fb sets the feedback coefficient</tr>
        <tr lang="ru">@predelay задаёт время до первого отражения, @hfdamp управляет демпфированием высоких частот, @fb задаёт коэффициент обратной связи</tr>
      </par>
      <par>
        <tr lang="en">@drywet controls the balance between the original (dry) and processed (wet) signal, @bypass disables processing entirely</tr>
        <tr lang="ru">@drywet управляет балансом между исходным (сухим) и обработанным (влажным) сигналом, @bypass полностью отключает обработку</tr>
      </par>
    </info>
    <arguments>
      <argument name="SIZE" type="float" minvalue="0" maxvalue="3">
        <tr lang="en">echo time</tr>
        <tr lang="ru">время эха</tr>
      </argument>
      <argument name="FB" type="float" minvalue="0" maxvalue="1">
        <tr lang="en">feedback coefficient</tr>
        <tr lang="ru">коэффициент обратной связи</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypass the processed signal</tr>
        <tr lang="ru">флаг обхода. Если true: пропускать обработанный сигнал без изменений</tr>
      </property>
      <!-- @drywet -->
      <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.5">
        <tr lang="en">proportion of mix between the original (dry) and processed (wet) signals. 0 — dry signal, 1 — wet</tr>
        <tr lang="ru">пропорция смеси между исходным (сухим) и обработанным (влажным) сигналами. 0 — сухой сигнал, 1 — влажный</tr>
      </property>
      <!-- @fb -->
      <property name="@fb" type="float" minvalue="0" maxvalue="1" default="0.3">
        <tr lang="en">feedback coefficient</tr>
        <tr lang="ru">коэффициент обратной связи</tr>
      </property>
      <!-- @hfdamp -->
      <property name="@hfdamp" type="float" minvalue="0" maxvalue="1" default="1">
        <tr lang="en">damping factor for high frequencies</tr>
        <tr lang="ru">коэффициент демпфирования высоких частот</tr>
      </property>
      <!-- @predelay -->
      <property name="@predelay" type="float" minvalue="1" maxvalue="200" default="20"
      units="millisecond">
        <tr lang="en">pre-delay</tr>
        <tr lang="ru">предзадержка</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="float" minvalue="0" maxvalue="3" default="1">
        <tr lang="en">room size (0: no room, 1: small, 2: medium, 3: large). Non-integer values are interpolated between neighbouring sizes, for example 1.3 is interpolation between the first and second room size with a 0.3 ratio.</tr>
        <tr lang="ru">размер комнаты (0: без комнаты, 1: маленькая, 2: средняя, 3: большая). Нецелые значения интерполируются между соседними размерами, например 1.3 — интерполяция между первым и вторым размером комнаты с коэффициентом 0.3</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset to initial state</tr>
          <tr lang="ru">сбросить в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set room size</tr>
          <tr lang="ru">задать размер комнаты</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru">выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[metro 1000]
|
[60(
|
[makenote 127 100] [ui.hsl 0 3 @show_value 1 #a]
*|*
[pack f f]         [ui.hrd 4]    [T]
|                  |             |
[synth.eguitar~]   [@size $1 #b( [@bypass $1(
|                  |             |
[fx.room~                        ]
|
[ui.hgain~]        [ui.dsp~]
|\
[dac~]
[X a->b]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
