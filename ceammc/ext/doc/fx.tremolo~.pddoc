<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="fx.tremolo~">
        <title>fx.tremolo~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">tremolo effect from Guitarix project</tr>
                <tr lang="ru">эффект тремоло от проекта Guitarix</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx tremolo</keywords>
            <since>0.9.7</since>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" minvalue="0.1" maxvalue="50" units="hertz">
                <tr lang="en">tremolo frequency</tr>
            </argument>
            <argument name="DEPTH" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">effect depth</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
            </property>
            <!-- @depth -->
            <property name="@depth" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">effect depth</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.75">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="0.1" maxvalue="50" units="hertz"
            default="5">
                <tr lang="en">tremolo frequency</tr>
            </property>
            <!-- @src -->
            <property name="@src" type="int" minvalue="0" maxvalue="2" default="0">
                <tr lang="en">modulation source: 0 (triangle), 1 (sin) or 2 (square)</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>input signal</xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">set frequency (Hz)</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env] [ui.hsl #a]  [ui.hsl #b]   [ui.tab #c]
|            |            |             |
[readsf~]    [@freq $1(   [@depth $1(   [@src $1(
|            |            |             |
|            |            |             |
|            |            |             |
[fx.tremolo~                            ]
|
[ui.gain~ @size 120 16]  [ui.dsp~]
|\
[dac~]
#a 0.5 10 @show_value 1
#b @show_value 1
#c tri osc square @size 140 15
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
