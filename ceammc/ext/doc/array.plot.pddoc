<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="array.plot">
        <title>array.plot</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">array data plotter</tr>
                <tr lang="ru">построение числовых графиков данных на массиве</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array plot</keywords>
            <also>
                <see>array.plot~</see>
            </also>
            <since>0.9.2</since>
        </meta>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
            <argument name="YMIN" type="float" minvalue="-2048" maxvalue="2048">
                <tr lang="en">minimal y-axis value</tr>
                <tr lang="ru">минимальное значение y-оси</tr>
            </argument>
            <argument name="YMAX" type="float" minvalue="-2048" maxvalue="2048">
                <tr lang="en">maximum y-axis value</tr>
                <tr lang="ru">максимальное значение y-оси</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru" finished="false">имя массива</tr>
            </property>
            <!-- @nan -->
            <property name="@nan" type="float" default="+inf">
                <tr lang="en">value to replace nan on plot</tr>
                <tr lang="ru" finished="false">Значение для замены няни на участке</tr>
            </property>
            <!-- @yauto -->
            <property name="@yauto" type="bool" default="1">
                <tr lang="en">calculate y-axis range automatically</tr>
                <tr lang="ru" finished="false">Вычислить диапазон y-оси автоматически</tr>
            </property>
            <!-- @ymax -->
            <property name="@ymax" type="float" minvalue="-2048" maxvalue="2048" default="1">
                <tr lang="en">maximum y-axis value</tr>
                <tr lang="ru" finished="false">Максимальное значение y-оси</tr>
            </property>
            <!-- @ymin -->
            <property name="@ymin" type="float" minvalue="-2048" maxvalue="2048" default="-1">
                <tr lang="en">minimal y-axis value</tr>
                <tr lang="ru" finished="false">Минимальное значение y-оси</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">single input sample</xinfo>
                <xinfo on="list">resizes array to list size and plot all list values</xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">plot all samples fitted to specified array</xinfo>
                <xinfo on="float">plot specified number of samples, resizes array</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>bang on done</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 100 3(                         [array APLT size=10 w=300 h=160]
|
[list.seq @closed 1]
| |
| [ui.dt]
|
|
|
|
[math.sqrt]
|
[array.plot APLT]
|
[B]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
