<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="fx.pitchshift~">
        <title>fx.pitchshift~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">simple pitch shifter based on 2 delay lines</tr>
                <tr lang="ru">простой питчшифтер на основе 2 линий задержки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx pitchshift</keywords>
            <since>0.1</since>
        </meta>
        <arguments>
            <argument name="PITCH" type="float" minvalue="-38" maxvalue="60">
                <tr lang="en">pitch shift in semitones</tr>
                <tr lang="ru" finished="false">смещение шага в полутонах</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
                <!-- old: Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал. -->
                <tr lang="ru" finished="false">Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал.</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet.</tr>
                <!-- old: пропорция смеси между исходным (сухим) и «влажным»
                сигналами. 0 - сухой сигнал, 1 - влажный. -->
                <tr lang="ru" finished="false">пропорция смеси между исходным (сухим) и «влажным»
                сигналами. 0 - сухой сигнал, 1 - влажный.</tr>
            </property>
            <!-- @fade -->
            <property name="@fade" type="float" units="millisecond" minvalue="0" maxvalue="1000"
            default="100">
                <tr lang="en">crossfade duration</tr>
                <tr lang="ru" finished="false">продолжительность кроссфейда</tr>
            </property>
            <!-- @pitch -->
            <property name="@pitch" type="float" minvalue="-38" maxvalue="60" default="0">
                <tr lang="en">pitchshift in semitones</tr>
                <tr lang="ru" finished="false">смена высоты в полутонах</tr>
            </property>
            <!-- @window -->
            <property name="@window" type="float" units="millisecond" minvalue="10" maxvalue="2000"
            default="200">
                <tr lang="en">the window size</tr>
                <tr lang="ru" finished="false">Размер окна</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset object state</tr>
                    <tr lang="ru" finished="false">Сброс состояния объекта</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
            <inlet>
                <in minvalue="-38" maxvalue="60" on="float">
                    <tr lang="en">pitch shift in semitones</tr>
                    <tr lang="ru" finished="false">смещение шага в полутонах</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal</tr>
                    <tr lang="ru" finished="false">выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env #a] [ui.knob]    [ui.knob]
|               |            |
|               |            |          [ui.knob]
|               |            |          |
[readsf~]       [* 2000]     [* 1000]   |
|               |            |          |
|               [@window $1( [@fade $1( [@drywet $1( [F]
|               |            |          |            |
|               |            |          |            |.
[fx.pitchshift~                         -12 @drywet 0.5]
|
[ui.gain~ @size 120 14] [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
