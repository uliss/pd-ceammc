<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="midi.pitch.quantize">
    <title>midi.pitch.quantize</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">quantize MIDI pitch to the specified range</tr>
        <tr lang="ru">квантует MIDI-ноту в заданный диапазон</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>midi</category>
      <keywords>midi pitch quantize range fold clamp reject</keywords>
      <since>0.9.5</since>
      <aliases>
        <alias>midi.pitch.q</alias>
      </aliases>
    </meta>
    <arguments>
      <argument name="MIN" type="int" minvalue="0" maxvalue="127">
        <tr lang="en">minimum pitch value</tr>
        <tr lang="ru">минимальное значение ноты</tr>
      </argument>
      <argument name="MAX" type="int" minvalue="0" maxvalue="127">
        <tr lang="en">maximum pitch value</tr>
        <tr lang="ru">максимальное значение ноты</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @clamp -->
      <property name="@clamp" type="alias">
        <tr lang="en">alias to @mode clamp. Clamp to the nearest bound</tr>
        <tr lang="ru">псевдоним для @mode clamp. Прижимает к ближайшей границе</tr>
      </property>
      <!-- @fold -->
      <property name="@fold" type="alias">
        <tr lang="en">alias to @mode fold. Shift by whole octaves until inside the range (preserves
        pitch class)</tr>
        <tr lang="ru">псевдоним для @mode fold. Сдвигает на целые октавы до попадания в диапазон
        (сохраняет класс звуковысотности)</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="int" minvalue="0" maxvalue="127" default="127">
        <tr lang="en">maximum pitch value</tr>
        <tr lang="ru">максимальное значение ноты</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="int" minvalue="0" maxvalue="127" default="0">
        <tr lang="en">minimum pitch value</tr>
        <tr lang="ru">минимальное значение ноты</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" default="reject" enum="reject fold clamp">
        <tr lang="en">quantization mode. reject — discard pitches outside the range. clamp — clamp
        to the nearest bound. fold — shift by whole octaves until inside the range (preserves pitch
        class)</tr>
        <tr lang="ru">режим квантования. reject — отбрасывает ноты вне диапазона. clamp — прижимает
        к ближайшей границе. fold — сдвигает на целые октавы до попадания в диапазон (сохраняет
        класс звуковысотности)</tr>
      </property>
      <!-- @reject -->
      <property name="@reject" type="alias">
        <tr lang="en">alias to @mode reject. Discard pitches outside the range</tr>
        <tr lang="ru">псевдоним для @mode reject. Отбрасывает ноты вне диапазона</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">MIDI pitch</tr>
          <tr lang="ru">MIDI-нота</tr>
        </in>
        <in on="list">
          <tr lang="en">NOTE VELOCITY [DUR] list</tr>
          <tr lang="ru">список НОТА СКОРОСТЬ [ДЛИТ]</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">quantized NOTE VELOCITY [DUR] list</tr>
          <tr lang="ru">квантованный список НОТА СКОРОСТЬ [ДЛИТ]</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.hk]
|
|
|
|
|        [ui.tab reject fold clamp]
|        |
|        [@mode $2(
|        |
[midi.pitch.quantize 60 72 @mode fold]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
