<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.tanh~">
        <title>math.tanh~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">hyperbolic tangent for signals</tr>
                <tr lang="ru">гиперболический тангенс для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math hyperbolic tangent</keywords>
            <also>
                <see>math.atanh~</see>
                <see>math.tanh</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Outputs hyperbolic tangent of input signal</tr>
                <!-- old: Выходы гиперболического касательного входного
                сигнала -->
                <tr lang="ru" finished="false">Выходы гиперболического касательного входного
                сигнала</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Hyperbolic_functions">wiki: Hyperbolic
            functions</a>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">result signal</tr>
                    <tr lang="ru" finished="false">результат сигнала</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[plot.linspace~ -5 5]
|                 ^|
[math.tanh~]       |
|                  |.
[ui.plot~ @xlabels 1 @ylabels 1 @ymin -1 @ymax 1 @ymin_ticks 0 @ymaj_ticks 0 @xmin_grid 1 @size 400 200]














[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
