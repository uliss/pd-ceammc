<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="string.substr">
        <title>string.substr</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">extract a substring from the input string</tr>
                <tr lang="ru">извлечение подстроки из входной строки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>string</category>
            <keywords>substring</keywords>
            <since>0.3</since>
            <aliases>
                <alias>str.substr</alias>
            </aliases>
            <also>
                <see>string.split</see>
            </also>
        </meta>
        <arguments>
            <argument name="FROM" type="int">
                <tr lang="en">substring position. May be relative: -1 means one character from the
                end of stirng</tr>
            </argument>
            <argument name="LEN" type="int" minvalue="-1">
                <tr lang="en">substring length. If -1 given (by default), means 'till string
                end'.</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @from -->
            <property name="@from" type="int" default="0">
                <tr lang="en">substring position. Can be negative - to address string from the
                end</tr>
            </property>
            <!-- @len -->
            <property name="@len" type="int" default="-1" minvalue="-1">
                <tr lang="en">substring length. If equal to -1, substring to the end of string</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">input string</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">from</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">to</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output substring</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[symbol PureData(
|
[str.substr 4]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
