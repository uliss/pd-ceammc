<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flt.notch~">
    <title>flt.notch~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">band-rejection filter</tr>
        <tr lang="ru">режекторный фильтр</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flt</category>
      <keywords>filter lowshelf</keywords>
      <since>0.1</since>
      <also>
        <see>flt.bpf12~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">filter that passes most frequencies unaltered, but attenuates those in a
        specific range to very low levels. It is the opposite of a band-pass filter.</tr>
        <!-- old: фильтр, который передает большинство частот без
                изменений, но ослабляет их в определенном диапазоне до очень низких уровней. Это
                противоположность полосового фильтра. -->
        <tr lang="ru" finished="false">фильтр, который передает большинство частот без изменений,
        но ослабляет их в определенном диапазоне до очень низких уровней. Это противоположность
        полосового фильтра.</tr>
      </par>
    </info>
    <arguments>
      <argument name="FREQ" type="float" units="hertz" minvalue="20" maxvalue="20000">
        <tr lang="en">center frequency</tr>
        <tr lang="ru" finished="false">центральная частота</tr>
      </argument>
      <argument name="WIDTH" type="float" units="hertz" minvalue="1" maxvalue="10000">
        <tr lang="en">band width (approximate)</tr>
        <tr lang="ru" finished="false">Ширина полосы (приблизительно)</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @freq -->
      <property name="@freq" type="float" minvalue="20" maxvalue="20000" default="1000"
      units="hertz">
        <tr lang="en">center frequency</tr>
        <tr lang="ru" finished="false">центральная частота</tr>
      </property>
      <!-- @width -->
      <property name="@width" type="float" default="50" units="hertz" minvalue="1"
      maxvalue="10000">
        <tr lang="en">band width (approximate)</tr>
        <tr lang="ru" finished="false">Ширина полосы (приблизительно)</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru" finished="false">входной сигнал</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set frequency</tr>
          <tr lang="ru" finished="false">установленная частота</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">filtered signal</tr>
          <tr lang="ru" finished="false">фильтрованный сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[osc~ 1000] [T]
|  .________/
[*~]
|
|     [F]
|     |
|     [@freq $1(
|     |
[flt.notch~ 1000 10]
|
[ui.gain~ @size 120 16]
|\
[dac~]

[ui.dsp~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
