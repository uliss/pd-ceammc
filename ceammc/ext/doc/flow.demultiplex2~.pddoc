<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.demultiplex2~">
    <title>flow.demultiplex2~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">audio stream stereo demultiplexer</tr>
        <tr lang="ru">демультиплексор стереофонического аудиопотока</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow demultiplex</keywords>
      <since>0.6</since>
      <aliases>
        <alias>flow.demux2~</alias>
        <alias>ceammc/demux2~</alias>
        <alias>demux2~</alias>
      </aliases>
      <also>
        <see>flow.demultiplex~</see>
        <see>flow.demultiplex</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes the stereo input to one of N stereo output pairs, the
        selection is controlled by the last (control) inlet</tr>
        <tr lang="ru">объект направляет стереовход на одну из N выходных стереопар, выбор
        управляется последним (управляющим) входом</tr>
      </par>
      <par>
        <tr lang="en">the control value is the index of the selected output pair, starting from
        0</tr>
        <tr lang="ru">управляющее значение — индекс выбранной выходной пары, начиная с 0</tr>
      </par>
      <par>
        <tr lang="en">@value sets the gain coefficients for each output</tr>
        <tr lang="ru">@value задаёт коэффициенты усиления для каждого выхода</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to switch a stereo signal between several
        destinations, for example to send it to different effects or to different pairs of
        speakers</tr>
        <tr lang="ru">объект можно использовать для переключения стереосигнала между несколькими
        получателями, например чтобы направить его в разные эффекты или на разные пары колонок</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="2" maxvalue="16">
        <tr lang="en">number of output stereo pairs</tr>
        <tr lang="ru">количество выходных стереопар</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @n -->
      <property name="@n" type="int" minvalue="2" default="2" maxvalue="16" access="initonly">
        <tr lang="en">number of output stereo channels</tr>
        <tr lang="ru">количество выходных стереоканалов</tr>
      </property>
      <!-- @value -->
      <property name="@value" type="list" default="">
        <tr lang="en">gain coefficients for each output</tr>
        <tr lang="ru">коэффициенты усиления для каждого выхода</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">left input signal</tr>
          <tr lang="ru">левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">right input signal</tr>
          <tr lang="ru">правый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="control">
        <in>
          <tr lang="en">demultiplexer control</tr>
          <tr lang="ru">управление демультиплексором</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet type="audio" number="1">
        <out type="any">
          <tr lang="en">first left output</tr>
          <tr lang="ru">первый левый выход</tr>
        </out>
      </outlet>
      <outlet type="audio" number="2">
        <out type="any">
          <tr lang="en">first right output</tr>
          <tr lang="ru">первый правый выход</tr>
        </out>
      </outlet>
      <outlet type="audio" number="...">
        <out type="any">
          <tr lang="en">... left output</tr>
          <tr lang="ru">... левый выход</tr>
        </out>
      </outlet>
      <outlet type="audio" number="...">
        <out type="any">
          <tr lang="en">... right output</tr>
          <tr lang="ru">... правый выход</tr>
        </out>
      </outlet>
      <outlet type="audio" number="n-1">
        <out type="any">
          <tr lang="en">last left output</tr>
          <tr lang="ru">последний левый выход</tr>
        </out>
      </outlet>
      <outlet type="audio" number="n">
        <out type="any">
          <tr lang="en">last right output</tr>
          <tr lang="ru">последний правый выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[sig~ 1]            [ui.radio @nitems 2] [ui.dsp~]
|                   |
|    [sig~ 0.125]   |
|    |              |
|    |              |
|    |              |    [@value?(
|    |.             |..  |
[flow.demultiplex2~ 2 #a   ]
|
[~->]
| ^|
|  [ui.display @display_type 1]
|
[env~]   [env~ #b] [env~ #c] [env~ #d]
|        |         |         |
[F]      [F]       [F]       [F]

[X a:1->b]
[X a:2->c]
[X a:3->d]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
