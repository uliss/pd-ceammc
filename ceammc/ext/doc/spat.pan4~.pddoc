<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="spat.pan4~">
        <title>spat.pan4~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">GMEM SPAT: 4-outputs spatializer</tr>
                <tr lang="ru">GMEM SPAT: управление 4-х канальным пространственным звуком</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>spat span</keywords>
            <since>0.6</since>
            <aliases>
                <alias>ceammc/pan4~</alias>
                <alias>pan4~</alias>
            </aliases>
            <also>
                <see>pan8~</see>
            </also>
        </meta>
        <arguments>
            <argument name="RADIUS" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">panning radius</tr>
            </argument>
            <argument name="ANGLE" type="float" minvalue="0" units="radian" maxvalue="2π">
                <tr lang="en">circle panning position in radians</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @angle -->
            <property name="@angle" type="float" minvalue="0" default="0" maxvalue="2π"
            units="radian">
                <tr lang="en">panning position in radians</tr>
            </property>
            <!-- @radius -->
            <property name="@radius" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">distance from circle center</tr>
            </property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">set radius and angle</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">1st output channel</outlet>
            <outlet type="audio">2nd output channel</outlet>
            <outlet type="audio">3rd output channel</outlet>
            <outlet type="audio">4th output channel</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[osc~ 1000] [ui.knob]     [ui.knob]
|           |             |
|           |             |
|           [phase->rad]  |
|           |             |
|           [@angle $1(   [@radius $1(
|           |             |
|           |             |
|           |             |
[spat.pan4~ 0.8 pi()       ]
|       ^|      ^^|     ^^^|
[ui.m~] [ui.m~] [ui.m~] [ui.m~]








[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
