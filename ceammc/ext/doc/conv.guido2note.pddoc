<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.guido2note">
    <title>conv.guido2note</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">convert the Guido notation into a MIDI pitch and duration</tr>
        <tr lang="ru">конвертер из Guido-нотации в MIDI ноту и длительность</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv guido midi</keywords>
      <since>0.9.8</since>
      <also>
        <see>conv.note2guido</see>
      </also>
      <aliases>
        <alias>ceammc/guido-&gt;note</alias>
        <alias>guido-&gt;note</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts a note written in GUIDO music notation into a MIDI pitch
        and a note duration in milliseconds. The output consists of two values: the integer MIDI
        pitch (from the first outlet) and the float duration in milliseconds (from the second
        outlet). The duration depends on the current tempo, which can be set with the TEMPO argument
        or the @tempo property.</tr>
        <tr lang="ru">Объект преобразует ноту, записанную в нотации GUIDO, в MIDI-номер и
        длительность ноты в миллисекундах. На выход подаются два значения: целочисленный
        MIDI-номер (из первого выхода) и длительность в миллисекундах (из второго выхода).
        Длительность зависит от текущего темпа, который можно задать аргументом TEMPO или
        свойством @tempo.</tr>
      </par>
      <a href="https://en.wikipedia.org/wiki/GUIDO_music_notation">GUIDO music notation</a>
    </info>
    <arguments>
      <argument name="TEMPO" type="atom" units="bpm">
        <tr lang="en">current tempo. If a number — treated as quarter notes per minute. If a symbol
        — BPM format is expected, for example: 120bpm, 60|1/8_bpm, 90|4._bpm etc.</tr>
        <tr lang="ru">текущий темп. Если число — рассматривается как четверти в минуту. Если
        символ — ожидается формат BPM, например: 120bpm (120 четвертных ударов в минуту),
        60|1/8_bpm (60 восьмых ударов в минуту), 90|4._bpm (90 ударов в минуту с длительностью
        четверть с точкой) и т. д.</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @tempo -->
      <property name="@tempo" type="atom" default="60|4bpm" units="bpm">
        <tr lang="en">current tempo</tr>
        <tr lang="ru">текущий темп</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">Guido note</tr>
          <tr lang="ru">нота в нотации GUIDO</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">MIDI pitch</tr>
          <tr lang="ru">MIDI-номер ноты</tr>
        </out>
      </outlet>
      <outlet>
        <out type="float">
          <tr lang="en">note duration in milliseconds</tr>
          <tr lang="ru">длительность ноты в миллисекундах</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[symbol c#0/4.(    [F]   [60( [120(
|                  |     |    |
[S digits=10]      [prop.set @tempo]
|                  |
[conv.guido2note @tempo 80bpm]
|                    ^|
[ui.dt]              [ui.dt]


/*// music example*/

[bang #a( [reset(
|         |
[list.walk b&2/8. g2/16 e2/16 d2/16 c#2/8 e2/8. cis2/16 a1/16 g1/16 f/4]
|
|
[guido->note #x]
|     ^|..
[makenote 120 {w=22} #b]
|
[pack f f {i=2,o=1,w=18} #d] [sel 0 {x=16} #c]
|
[msg note]     [del {x=16} #e]
|
[sfizz~ \#sine]
*|*
[ui.hgain2~]         [ui.dsp~]
*|*
[dac~]

[X b:1->d:1] [X b:1->c] [X e->a] [X c->e]
#x @tempo 144
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
