#X msg 110 786 @id;
#X text 245 786 (initonly) Get/Set OSC address id. If specified \,
bind all properties to /ID/dyn_comp_peak2/PROP_NAME osc address \,
if empty bind to /dyn_comp_peak2/PROP_NAME. Type: symbol.;
#X msg 110 843 @osc;
#X text 245 843 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 110 873 @active;
#X text 245 873 Turn on/off dsp processing. Type: bool. Default value:
1\.;
#X msg 110 903 @attack;
#X text 245 903 Get/Set time constant when level & compression going
up. Type: float. Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 110 960 @bypass;
#X text 245 960 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 110 1002 @gain;
#X text 245 1002 Get/Set make up gain: applied to the signal after
the compression takes place. Type: float. Units: 'db'. Default value:
0\. Range: -18\...18\.;
#X msg 110 1059 @knee;
#X text 245 1059 Get/Set a gradual increase in gain reduction around
the threshold: below thresh-(knee/2) there is no gain reduction \,
above thresh+(knee/2) there is the same gain reduction as without a
knee \, and in between there is a gradual increase in gain reduction.
Type: float. Units: 'db'. Default value: 3\. Range: 0\...6\.;
#X msg 110 1177 @link;
#X text 245 1177 Get/Set the amount of linkage between the channels:
0 = each channel is independent \, 1 = all channels have the same amount
of gain reduction. Type: float. Default value: 1\. Range: 0\...1\.;
#X msg 110 1264 @refresh;
#X text 245 1264 Get/Set compression level output time interval. If
0 - no output. Type: int. Units: 'ms'. Default value: 100\. Range:
0\...1000\.;
#X msg 110 1321 @release;
#X text 245 1321 Get/Set release time = time constant coming out of
compression. Type: float. Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 110 1378 @strength;
#X text 245 1378 Get/Set strength of the compression (0 = no compression
\, 1 means hard limiting \, >1 means over-compression). Type: float.
Default value: 0\. Range: 0\...2\.;
#X msg 110 1435 @threshold;
#X text 245 1435 Get/Set level threshold above which compression kicks
in (100 dB = max level). Type: float. Units: 'db'. Default value: -10\.
Range: -60\...0\.;
#X msg 110 1492 @level0?;
#X text 245 1492 (readonly) Get current level of compression of first
