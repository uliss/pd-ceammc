#X msg 110 741 @id;
#X text 245 741 (initonly) Get/Set OSC address id. If specified \,
bind all properties to /ID/dyn_comp_peak2/PROP_NAME osc address \,
if empty bind to /dyn_comp_peak2/PROP_NAME. Type: symbol.;
#X msg 110 798 @osc;
#X text 245 798 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 110 828 @active;
#X text 245 828 Turn on/off dsp processing. Type: bool. Default value:
1\.;
#X msg 110 858 @attack;
#X text 245 858 Get/Set time constant when level & compression going
up. Type: float. Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 110 915 @bypass;
#X text 245 915 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 110 957 @gain;
#X text 245 957 Get/Set make up gain: applied to the signal after the
compression takes place. Type: float. Units: 'db'. Default value: 0\.
Range: -18\...18\.;
#X msg 110 1014 @knee;
#X text 245 1014 Get/Set a gradual increase in gain reduction around
the threshold: below thresh-(knee/2) there is no gain reduction \,
above thresh+(knee/2) there is the same gain reduction as without a
knee \, and in between there is a gradual increase in gain reduction.
Type: float. Units: 'db'. Default value: 3\. Range: 0\...6\.;
#X msg 110 1117 @link;
#X text 245 1117 Get/Set the amount of linkage between the channels:
0 = each channel is independent \, 1 = all channels have the same amount
of gain reduction. Type: float. Default value: 1\. Range: 0\...1\.;
#X msg 110 1189 @refresh;
#X text 245 1189 Get/Set compression level output time interval. If
0 - no output. Type: int. Units: 'ms'. Default value: 100\. Range:
0\...1000\.;
#X msg 110 1246 @release;
#X text 245 1246 Get/Set release time = time constant coming out of
compression. Type: float. Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 110 1303 @strength;
#X text 245 1303 Get/Set strength of the compression (0 = no compression
\, 1 means hard limiting \, >1 means over-compression). Type: float.
Default value: 0\. Range: 0\...2\.;
#X msg 110 1360 @threshold;
#X text 245 1360 Get/Set level threshold above which compression kicks
in (100 dB = max level). Type: float. Units: 'db'. Default value: -10\.
Range: -60\...0\.;
#X msg 110 1417 @level0?;
#X text 245 1417 (readonly) Get current level of compression of first
