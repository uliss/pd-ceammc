<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="math.abs~">
    <title>math.abs~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">absolute value function for signals</tr>
        <tr lang="ru">функция абсолютного значения для сигналов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>math</category>
      <keywords>math abs</keywords>
      <also>
        <see>math.abs</see>
      </also>
      <since>0.9</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Computes the absolute value of the input signal: negative values become
        positive, positive values stay unchanged. This is the audio-rate equivalent of the
        [math.abs] object.</tr>
        <tr lang="ru">Вычисляет абсолютное значение входного сигнала: отрицательные значения
        становятся положительными, положительные остаются без изменений. Это аудиоверсия объекта
        [math.abs].</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Rectifying a signal — converting a bipolar audio signal into a unipolar
        one, for example as a first step of an envelope follower or a full-wave rectifier.</tr>
        <tr lang="ru">• Выпрямление сигнала — преобразование двуполярного аудиосигнала в
        однополярный, например как первый шаг детектора огибающей или двухполупериодного
        выпрямителя.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Extracting amplitude — measuring how far a signal deviates from zero,
        regardless of its sign, for level detection or modulation purposes.</tr>
        <tr lang="ru">• Извлечение амплитуды — измерение отклонения сигнала от нуля независимо от
        его знака, для детектирования уровня или модуляции.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Waveform transformation — turning a sine or triangle wave into a "folded"
        waveform with a distinctive harmonic content, useful for creative waveshaping.</tr>
        <tr lang="ru">• Преобразование формы волны — превращение синусоидальной или треугольной
        волны в «сложенную» форму с характерным гармоническим составом, что удобно для творческого
        вейвшейпинга.</tr>
      </par>
    </info>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru">выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang(                        [array mabs {w=200,h=200}]
|
[plot.linspace~ -1 1]
|             ^|
[math.abs~]    |
|              |.
[array.plot~ mabs @yauto 1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
