<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.abs~">
        <title>math.abs~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">absolute value function for signals</tr>
                <tr lang="ru">функция абсолютного значения для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math abs</keywords>
            <also>
                <see>math.abs</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The abs() function computes the absolute value of the float
                input.</tr>
                <tr lang="ru" finished="false">Функция abs() вычисляет абсолютное значение
                поплавкового входа.</tr>
            </par>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(                        [array mabs {w=200,h=200}]
|
[plot.linspace~ -1 1]
|             ^|
[math.abs~]    |
|              |.
[array.plot~ mabs @yauto 1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
