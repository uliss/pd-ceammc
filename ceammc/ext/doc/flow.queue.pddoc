<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.queue">
    <title>flow.queue</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">multichannel message queue with sync capabilities</tr>
        <tr lang="ru">многоканальная очередь сообщений с возможностью синхронизации</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>counter</keywords>
      <since>0.9.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object stores incoming messages in N independent FIFO lanes and outputs
        them in sync</tr>
        <tr lang="ru">объект сохраняет входящие сообщения в N независимых очередях FIFO и выводит
        их синхронно</tr>
      </par>
      <par>
        <tr lang="en">a bang or pop on the last inlet outputs and removes the first message from
        every lane at once</tr>
        <tr lang="ru">bang или pop на последнем входе одновременно выводит и удаляет первое
        сообщение из каждой очереди</tr>
      </par>
      <par>
        <tr lang="en">@max_size limits the lane length, @auto_pop automatically drops the oldest
        element when the queue is full</tr>
        <tr lang="ru">@max_size ограничивает длину очереди, @auto_pop автоматически отбрасывает
        самый старый элемент при переполнении</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to synchronize parallel event streams, for example to
        keep note and velocity messages aligned</tr>
        <tr lang="ru">объект можно использовать для синхронизации параллельных потоков событий,
        например чтобы согласовать сообщения нот и сил нажатия</tr>
      </par>
    </info>
    <arguments>
      <argument name="MAX_SIZE" type="int" minvalue="1" maxvalue="1024">
        <tr lang="en">max queue lane size</tr>
        <tr lang="ru">максимальный размер очереди</tr>
      </argument>
      <argument name="N" type="int" minvalue="1" maxvalue="32">
        <tr lang="en">number of lanes</tr>
        <tr lang="ru">количество очередей</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @auto_pop -->
      <property name="@auto_pop" type="bool" default="0">
        <tr lang="en">auto pop mode. If true, automatically drops the oldest elements when the
        queue is full</tr>
        <tr lang="ru">режим автоизвлечения. Если true, при переполнении очереди автоматически
        отбрасываются самые старые элементы</tr>
      </property>
      <!-- @max_size -->
      <property name="@max_size" type="int" minvalue="1" default="32" maxvalue="1024">
        <tr lang="en">max queue lane size</tr>
        <tr lang="ru">максимальный размер очереди</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet number="1">
        <in on="any">
          <tr lang="en">1st queue input messages</tr>
          <tr lang="ru">входные сообщения 1-й очереди</tr>
        </in>
      </inlet>
      <inlet number="...">
        <in on="any">
          <tr lang="en">... queue input messages</tr>
          <tr lang="ru">... входные сообщения очереди</tr>
        </in>
      </inlet>
      <inlet number="n">
        <in on="any">
          <tr lang="en">n-th queue input messages</tr>
          <tr lang="ru">входные сообщения N-й очереди</tr>
        </in>
      </inlet>
      <inlet number="n+1">
        <in on="any">
          <tr lang="en">clear: remove all elements from all queues, output: output all elements
          from all queues, flush: output and clear all elements from all queues, bang or pop:
          output and remove the first message in all queues</tr>
          <tr lang="ru">clear: удалить все элементы из всех очередей, output: вывести все элементы
          из всех очередей, flush: вывести и очистить все элементы из всех очередей, bang или pop:
          вывести и удалить первое сообщение во всех очередях</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="any">
          <tr lang="en">1st queue output</tr>
          <tr lang="ru">выход 1-й очереди</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="any">
          <tr lang="en">... queue output</tr>
          <tr lang="ru">... выход очереди</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="any">
          <tr lang="en">n-th queue output</tr>
          <tr lang="ru">выход N-й очереди</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*single-lane sync message queue with size=5*/

[bang, 100, symbol S, 1 2 3, msg A B C( [ui.b #a]
|
|
|
[flow.queue 5 {w=30} #x]
|
[ui.dt]


/*single-lane async message queue with size=3, */

[B]
|
[flow.count]
| |
| [F]               [bang(
|                   |.
[flow.queue 3 @auto_pop 1]
|
[ui.dt]



[T]          [ui.dsp~]
|
[metro 200]
|
[random.i 48 72]
|
[makenote 127 180]
*|*
[pack f f]
|  |
|  [flow.queue 8 @auto_pop 1]
|            |
[msg note]   [msg note]
|            |
[synth.ks~]  [synth.ks~]
|            |.
[ui.hgain2~   ]
*|*
[dac~]

#a @label Pop
#y @auto_pop 1
[X a->x:1]
[X b->y:3]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
