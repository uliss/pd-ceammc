<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.bang" type="gui">
        <title>ui.bang</title>
        <meta>
            <authors>
                <author>Pierre Guillot</author>
            </authors>
            <description>
                <tr lang="en">a button that sends an empty event (bang)</tr>
                <tr lang="ru">кнопка отправляющая пустое событие (bang)</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui bang</keywords>
            <since>0.1</since>
            <aliases>
                <alias view="link">ui.b</alias>
            </aliases>
            <also>
                <see view="link">ui.toggle</see>
            </also>
        </meta>
        <info>
            <par>Bang on steroids: bind to MIDI and keyboard</par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">outputs bang on mouse down</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <!-- @active_color -->
            <property name="@active_color" type="list" default="0 0.75 1 1">
                <tr lang="en">element active color (list of red, green, blue values in 0-1
                range)</tr>
            </property>
            <!-- @background_color -->
            <property name="@background_color" type="list" default="0.93 0.93 0.93 1">
                <tr lang="en">element background color (list of red, green, blue values in 0-1
                range)</tr>
            </property>
            <!-- @bind -->
            <property name="@bind" type="list" default="">
                <tr lang="en">MIDI/keyboard bind expression</tr>
            </property>
            <!-- @border_color -->
            <property name="@border_color" type="list" default="0.6 0.6 0.6 1">
                <tr lang="en">border color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @fontname -->
            <property name="@fontname" type="symbol" default="Helvetica"
            enum="Courier DejaVu Helvetica Monaco Times">
                <tr lang="en">fontname</tr>
            </property>
            <!-- @fontsize -->
            <property name="@fontsize" type="int" minvalue="4" maxvalue="100" default="11">
                <tr lang="en">fontsize</tr>
            </property>
            <!-- @fontslant -->
            <property name="@fontslant" type="symbol" enum="roman italic" default="roman">
                <tr lang="en">font slant</tr>
            </property>
            <!-- @fontweight -->
            <property name="@fontweight" type="symbol" enum="normal bold" default="normal">
                <tr lang="en">font weight</tr>
            </property>
            <!-- @label -->
            <property name="@label" type="symbol" default="(null)">
                <tr lang="en">label text</tr>
            </property>
            <!-- @label_align -->
            <property name="@label_align" type="symbol" enum="left center right" default="left">
                <tr lang="en">label horizontal align</tr>
            </property>
            <!-- @label_color -->
            <property name="@label_color" type="list" default="0 0 0 1">
                <tr lang="en">label color in RGB format within 0-1 range, for example: 0.2 0.4
                0.1</tr>
            </property>
            <!-- @label_inner -->
            <property name="@label_inner" type="bool" default="0">
                <tr lang="en">label position (1 - inner, 0 - outer).</tr>
            </property>
            <!-- @label_margins -->
            <property name="@label_margins" type="list" default="0 0">
                <tr lang="en">label offset in pixels</tr>
            </property>
            <!-- @label_side -->
            <property name="@label_side" type="symbol" enum="left top right bottom" default="top">
                <tr lang="en">label snap side</tr>
            </property>
            <!-- @label_valign -->
            <property name="@label_valign" type="symbol" enum="top center bottom" default="top">
                <tr lang="en">label vertical align</tr>
            </property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="0">
                <tr lang="en">pin mode. if 1 - put element to the lowest level</tr>
            </property>
            <!-- @receive -->
            <property name="@receive" type="symbol" default="(null)">
                <tr lang="en">receive source</tr>
            </property>
            <!-- @send -->
            <property name="@send" type="symbol" default="(null)">
                <tr lang="en">send destination</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="15 15">
                <tr lang="en">element size (width, height pair)</tr>
            </property>
        </properties>
        <methods>
            <!-- dump -->
            <method name="dump">dumps all object info to Pd console window.</method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">outputs bang</xinfo>
                <xinfo on="float">outputs bang</xinfo>
                <xinfo on="symbol">outputs bang</xinfo>
                <xinfo on="list">outputs bang</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>bang output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[dump(
|
[ui.bang @size 40 40 @send b_out @receive b_in]
|
|      [B]
|      |
[B]    [s b_in]           [ui.bang-bind]
]]>
            </pdascii>
            <pdascii id="bind">
<![CDATA[
[ui.midi]

[65( [64(
|    |
[3 $1 0(
|
[s \#ctlin]

/*@bind cc[3]>64*/    /*@bind cc[3]<65*/

[ui.bang #a]          [ui.bang #b]



/*@bind key=32*/      /*@bind key[ctl]=32*/

[ui.bang #c]          [ui.bang #d]



/*@bind key[alt]=32*/ /*@bind key[shift]=32*/

[ui.bang #e]          [ui.bang #f]




#a @size 40 40 @bind cc\[3\]>64
#b @size 40 40 @bind cc\[3\]&lt;65
#c @size 40 40 @bind key=32
#d @size 40 40 @bind key\[ctl\]=32
#e @size 40 40 @bind key\[alt\]=32
#f @size 40 40 @bind key\[shift\]=32
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
