<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="ui.bang" type="gui">
        <title>ui.bang</title>
        <meta>
            <authors>
                <author>Pierre Guillot</author>
            </authors>
            <description>
                <tr lang="en">a button that sends an empty event (bang)</tr>
                <tr lang="ru">кнопка отправляющая пустое событие (bang)</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui bang</keywords>
            <since>0.1</since>
            <aliases>
                <alias view="link">ui.b</alias>
            </aliases>
            <also>
                <see view="link">ui.toggle</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Bang on steroids: bind to MIDI and keyboard</tr>
                <tr lang="ru" finished="false">Взрыв на стероидах: связываются с MIDI и
                клавиатурой</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">outputs bang on mouse down</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_active_color.xml" />
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_label.xml" />
            <xi:include href="props_label_align.xml" />
            <xi:include href="props_label_color.xml" />
            <xi:include href="props_label_inner.xml" />
            <xi:include href="props_label_margins.xml" />
            <xi:include href="props_label_side.xml" />
            <xi:include href="props_label_valign.xml" />
            <xi:include href="props_pinned.xml" />
            <xi:include href="props_ui_receive.xml" />
            <xi:include href="props_ui_send.xml" />
            <!-- @bind -->
            <property name="@bind" type="list" default="">
                <tr lang="en">MIDI/keyboard bind expression</tr>
                <tr lang="ru" finished="false">MIDI/клавиатура связывает экспрессию</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="15 15">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
        </properties>
        <methods>
            <!-- dump -->
            <method name="dump">
                <info>
                    <tr lang="en">dumps all object info to Pd console window.</tr>
                    <tr lang="ru" finished="false">Сбрасывает всю информацию об объекте в окно
                    консоли Pd.</tr>
                </info>
            </method>
            <!-- pos -->
            <method name="pos">
                <info>
                    <tr lang="en">set UI element position</tr>
                    <tr lang="ru" finished="false">Установите положение элемента UI</tr>
                </info>
                <param name="X" type="float" required="true">
                    <tr lang="en">top left x-coord</tr>
                    <tr lang="ru" finished="false">верхний левый x-coord</tr>
                </param>
                <param name="Y" type="float" required="true">
                    <tr lang="en">top right y-coord</tr>
                    <tr lang="ru" finished="false">верхняя правая y-coord</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">outputs bang</tr>
                    <tr lang="ru" finished="false">выходной бах</tr>
                </in>
                <in on="float">
                    <tr lang="en">outputs bang</tr>
                    <tr lang="ru" finished="false">выходной бах</tr>
                </in>
                <in on="symbol">
                    <tr lang="en">outputs bang</tr>
                    <tr lang="ru" finished="false">выходной бах</tr>
                </in>
                <in on="list">
                    <tr lang="en">outputs bang</tr>
                    <tr lang="ru" finished="false">выходной бах</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">bang output</tr>
                    <tr lang="ru" finished="false">взрывной выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[dump(
|
[ui.bang @size 40 40 @send b_out @receive b_in]
|
|      [B]
|      |
[B]    [s b_in]           [ui.bang-bind]
]]>
            </pdascii>
            <pdascii id="bind">
<![CDATA[
[ui.midi]

[65( [64(
|    |
[3 $1 0(
|
[s \#ctlin]

/*@bind cc[3]>64*/    /*@bind cc[3]<65*/

[ui.bang #a]          [ui.bang #b]



/*@bind key=32*/      /*@bind key[ctl]=32*/

[ui.bang #c]          [ui.bang #d]



/*@bind key[alt]=32*/ /*@bind key[shift]=32*/

[ui.bang #e]          [ui.bang #f]




#a @size 40 40 @bind cc\[3\]>64
#b @size 40 40 @bind cc\[3\]&lt;65
#c @size 40 40 @bind key=32
#d @size 40 40 @bind key\[ctl\]=32
#e @size 40 40 @bind key\[alt\]=32
#f @size 40 40 @bind key\[shift\]=32
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
