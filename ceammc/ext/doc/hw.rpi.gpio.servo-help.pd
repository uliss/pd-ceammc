value: 0\.;
#X obj 250 929 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 929 @freq;
#X text 270 929 PWM frequency. Type: float. Units: 'Hz'. Default value:
