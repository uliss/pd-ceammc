<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="lfo.+square~">
        <title>lfo.+square~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">positive low frequency square wave</tr>
                <tr lang="ru">низкочастотная квадратная волна единичной амплитуды в диапазоне
                [0,+1]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>lfo</category>
            <keywords>lfo oscillator square</keywords>
            <since>0.7</since>
            <also>
                <see>lfo.square~</see>
                <see>lfo.impulse~</see>
                <see>lfo.tri~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="0" maxvalue="1000">
                <tr lang="en">frequency</tr>
                <tr lang="ru" finished="false">частота</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" default="0" minvalue="0" maxvalue="1000"
            units="hertz">
                <tr lang="en">initial frequency</tr>
                <tr lang="ru" finished="false">Начальная частота</tr>
            </property>
            <!-- @pause -->
            <property name="@pause" type="bool" default="0">
                <tr lang="en">pause oscillator at current value</tr>
                <tr lang="ru" finished="false">осциллятор паузы при текущем значении</tr>
            </property>
            <!-- @phase -->
            <property name="@phase" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">initial phase</tr>
                <tr lang="ru" finished="false">начальный этап</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                    <tr lang="ru" finished="false">Перезагрузка в начальное состояние</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">frequency in Hz</tr>
                    <tr lang="ru" finished="false">частота в Гц</tr>
                </in>
            </inlet>
            <inlet>
                <in on="bang">
                    <tr lang="en">reset phase</tr>
                    <tr lang="ru" finished="false">фаза сброса</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal in [0, 1] range</tr>
                    <tr lang="ru" finished="false">выходной сигнал в [0, 1] диапазоне</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[osc.saw~ 100] [F]
|              |
|              [lfo.+square~ 10]
|  .___________/
[*~]
|
[ui.gain~ @size 120 14]  [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
