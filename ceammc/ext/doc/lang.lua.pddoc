<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="lang.lua">
    <title>lang.lua</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Lua JIT language bindings</tr>
        <tr lang="ru">привязки языка Lua JIT</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>lang</category>
      <keywords>lua jit</keywords>
      <since>0.9.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object embeds LuaJIT as a scripting language inside a Pd patch. Lua code
        is executed in a separate thread in async mode, so it does not block Pd's main thread.</tr>
        <tr lang="ru">Объект встраивает LuaJIT как язык сценариев внутрь патча Pd. Код Lua
        выполняется в отдельном потоке в асинхронном режиме и не блокирует основной поток
        Pd.</tr>
      </par>
      <par>
        <tr lang="en">Each lang.lua object has its own independent Lua context.</tr>
        <tr lang="ru">Каждый объект lang.lua имеет собственный независимый контекст Lua.</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="0">open Lua code in the editor</event>
    </mouse>
    <arguments>
      <argument name="IN" type="int" minvalue="1" maxvalue="16">
        <tr lang="en">number of inputs</tr>
        <tr lang="ru">число входов</tr>
      </argument>
      <argument name="OUT" type="int" minvalue="1" maxvalue="16">
        <tr lang="en">number of outputs</tr>
        <tr lang="ru">число выходов</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @in -->
      <property name="@in" type="int" default="1" minvalue="1" maxvalue="16" access="initonly">
        <tr lang="en">number of inputs</tr>
        <tr lang="ru">число входов</tr>
      </property>
      <!-- @out -->
      <property name="@out" type="int" default="1" minvalue="1" maxvalue="16" access="initonly">
        <tr lang="en">number of outputs</tr>
        <tr lang="ru">число выходов</tr>
      </property>
    </properties>
    <methods>
      <!-- call -->
      <method name="call">
        <info>
          <tr lang="en">calls a Lua function by name</tr>
          <tr lang="ru">вызывает функцию Lua по имени</tr>
        </info>
        <param name="FN" type="symbol" required="true">
          <tr lang="en">function name</tr>
          <tr lang="ru">имя функции</tr>
        </param>
        <param name="ARGS" type="list">
          <tr lang="en">function arguments</tr>
          <tr lang="ru">аргументы функции</tr>
        </param>
      </method>
      <!-- eval -->
      <method name="eval">
        <info>
          <tr lang="en">evaluates Lua code</tr>
          <tr lang="ru">выполняет код Lua</tr>
        </info>
        <param name="CODE" type="list" required="true">
          <tr lang="en">Lua code</tr>
          <tr lang="ru">код Lua</tr>
        </param>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">loads a Lua file and evaluates it</tr>
          <tr lang="ru">загружает файл Lua и выполняет его</tr>
        </info>
        <param name="PATH" type="list" required="true">
          <tr lang="en">path to the Lua file</tr>
          <tr lang="ru">путь к файлу Lua</tr>
        </param>
      </method>
      <!-- quit -->
      <method name="quit">
        <info>
          <tr lang="en">aborts Lua script execution</tr>
          <tr lang="ru">прерывает выполнение сценария Lua</tr>
        </info>
      </method>
    </methods>
    <inlets dynamic="true">
      <inlet number="1">
        <in>
          <tr lang="en">first Lua input</tr>
          <tr lang="ru">первый вход Lua</tr>
        </in>
      </inlet>
      <inlet number="...">
        <in>
          <tr lang="en">... Lua input</tr>
          <tr lang="ru">... вход Lua</tr>
        </in>
      </inlet>
      <inlet number="n">
        <in>
          <tr lang="en">n-th Lua input</tr>
          <tr lang="ru">n-й вход Lua</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="any">
          <tr lang="en">first Lua output</tr>
          <tr lang="ru">первый выход Lua</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="any">
          <tr lang="en">... Lua output</tr>
          <tr lang="ru">... выход Lua</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="any">
          <tr lang="en">n-th Lua output</tr>
          <tr lang="ru">n-й выход Lua</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[loadmsg load lua/basic.lua]
|
| [B] [F]  [1 2 3 4( [S]  [call fn ABC(
| |   |    |         |    |
| |   |.   |..       |... |
[lang.lua @in 4 @out 3    ]
|         ^|
[ui.dt]   [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
