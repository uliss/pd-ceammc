<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="lang.lua">
        <title>lang.lua</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Lua JIT language bindings</tr>
                <tr lang="ru">языковые привязки для Lua JIT</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>lang</category>
            <keywords>lua jit</keywords>
            <since>0.9.5</since>
        </meta>
        <info>
            <par>Lua code is executed in separated thread in async mode.</par>
            <par>Each lang.lua object has own independent context.</par>
        </info>
        <mouse>
            <event type="left-click" editmode="0">open Lua code in the editor</event>
        </mouse>
        <arguments>
            <argument name="IN" type="int" minvalue="1" maxvalue="16">
                <tr lang="en">number of inputs</tr>
            </argument>
            <argument name="OUT" type="int" minvalue="1" maxvalue="16">
                <tr lang="en">number of outputs</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @in -->
            <property name="@in" type="int" default="1" minvalue="1" maxvalue="16"
            access="initonly">
                <tr lang="en">number of inputs</tr>
            </property>
            <!-- @out -->
            <property name="@out" type="int" default="1" minvalue="1" maxvalue="16"
            access="initonly">
                <tr lang="en">number of outputs</tr>
            </property>
        </properties>
        <methods>
            <!-- call -->
            <method name="call">call lua function 
            <param name="FN" type="symbol" required="true">
                <tr lang="en">function name</tr>
            </param>
            <param name="ARGS" type="list">
                <tr lang="en">function arguments</tr>
            </param></method>
            <!-- eval -->
            <method name="eval">eval lua code 
            <param name="CODE" type="list" required="true">
                <tr lang="en">lua code</tr>
            </param></method>
            <!-- load -->
            <method name="load">load lua file and eval it 
            <param name="PATH" type="list" required="true">
                <tr lang="en">path to lua file</tr>
            </param></method>
            <!-- quit -->
            <method name="quit">abort lua script execution</method>
        </methods>
        <inlets dynamic="true">
            <inlet number="1">
                <xinfo>first lua input</xinfo>
            </inlet>
            <inlet number="...">
                <xinfo>... lua input</xinfo>
            </inlet>
            <inlet number="n">
                <xinfo>n-th lua input</xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">first lua output</outlet>
            <outlet number="...">... lua output</outlet>
            <outlet number="n">n-th lua output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[loadmsg load lua/basic.lua]
|
| [B] [F]  [1 2 3 4( [S]  [call fn ABC(
| |   |    |         |    |
| |   |.   |..       |... |
[lang.lua @in 4 @out 3    ]
|         ^|
[ui.dt]   [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
