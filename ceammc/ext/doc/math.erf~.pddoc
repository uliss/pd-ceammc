<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.erf~">
        <title>math.erf~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">error function for signals</tr>
                <tr lang="ru">функция ошибок для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math error gauss</keywords>
            <also>
                <see>math.erf</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">In statistics, for non-negative values of x, the error function has
                the following interpretation:</tr>
                <!-- old: В статистике для неотрицательных значений x функция
                ошибки имеет следующую интерпретацию: -->
                <tr lang="ru" finished="false">В статистике для неотрицательных значений x функция
                ошибки имеет следующую интерпретацию:</tr>
            </par>
            <par>
                <tr lang="en">for a random variable Y that is normally distributed with mean 0 and
                variance 1/2, erf x is the probability that Y falls in the range [−x, x]</tr>
                <!-- old: для случайной переменной Y, который обычно
                распределяется со средним 0 и дисперсией 1/2, erf x - вероятность того, что Y
                падает в диапазоне [-x, x] -->
                <tr lang="ru" finished="false">для случайной переменной Y, который обычно
                распределяется со средним 0 и дисперсией 1/2, erf x - вероятность того, что Y
                падает в диапазоне [-x, x]</tr>
            </par>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal</tr>
                    <tr lang="ru" finished="false">выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(
|
[plot.linspace~ -3 3 #a]
|
[math.erf~]
|
[ui.plot~ @xlabels 1 @ylabels 1 @size 400 160 @xmin_grid 1 #b]











[ui.dsp~]
[X a:1->b:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
