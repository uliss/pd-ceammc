<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="conv.ms2samp~">
        <title>conv.ms2samp~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert time in milliseconds to number of samples according to
                current sample rate</tr>
                <tr lang="ru">преобразовать время в миллисекундах в количество семплов в
                соответствии с текущей скоростью семплирования</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv samp ms</keywords>
            <since>0.9</since>
            <aliases>
                <alias>ceammc/ms-&gt;samp~</alias>
                <alias>ms-&gt;samp~</alias>
            </aliases>
            <also>
                <see>conv.samp2ms~</see>
            </also>
        </meta>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal</tr>
                    <tr lang="ru" finished="false">выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(
|
[plot.linspace~ 0 1000]
|                    ^|
[ms->samp~]           |
|                     |.
[ui.plot~ @size 400 170 @xlabels 1 @ylabels 1 @ymin 0 @ymax 1000 @yauto 1 @ymin_ticks 0]













[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
