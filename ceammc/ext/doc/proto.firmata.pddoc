<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="proto.firmata">
        <title>proto.firmata</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Firmata Arduino protocol support</tr>
                <tr lang="ru">поддержка протокола Firmata для Arduino</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>proto</category>
            <keywords>arduino firmata</keywords>
            <since>0.5</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Firmata basic protocol support.</tr>
            </par>
        </info>
        <methods>
            <!-- apin_mapping? -->
            <method name="apin_mapping?">
                <info>
                    <tr lang="en">query mapping between analog port number and digital pin. Analog
                    messages are numbered 0 to 15, which traditionally refer to the Arduino pins
                    labeled A0, A1, A2, etc. However, these pis are actually configured using
                    "normal" pin numbers in the pin mode message, and when those pins are used for
                    non-analog functions. The analog mapping query provides the information about
                    which pins (as used with Firmata's pin mode message) correspond to the analog
                    channels. Return sequence of messages like: [apin_mapping A# PIN#(, where # is
                    number</tr>
                </info>
            </method>
            <!-- capabilities? -->
            <method name="capabilities?">
                <info>
                    <tr lang="en">query pin capabilities. Return sequence of messages like:
                    [pin_info PIN# MODE RESOLUTION(, where # is pin number</tr>
                </info>
            </method>
            <!-- firmware? -->
            <method name="firmware?">
                <info>
                    <tr lang="en">query firmata protocol version. Returns message like: [firmware
                    ARDUINO_FIRMWARE_NAME.ino MAJOR MINOR(</tr>
                </info>
            </method>
            <!-- pin_mode -->
            <method name="pin_mode">
                <info>
                    <tr lang="en">sets pin mode.</tr>
                </info>
                <param name="PIN#" type="int" minvalue="0" required="true">
                    <tr lang="en">pin number</tr>
                </param>
                <param name="MODE" type="symbol"
                enum="INPUT OUTPUT ANALOG PWM SERVO SHIFT I2C ONEWIRE STEPPER ENCODER SERIAL PULLUP"
                required="true">
                    <tr lang="en">pin mode</tr>
                </param>
            </method>
            <!-- pin_state? -->
            <method name="pin_state?">
                <info>
                    <tr lang="en">query pin state. The pin state is any data written to the pin (it
                    is important to note that pin state != pin value). For output modes (digital
                    output, PWM, and Servo), the state is any value that has been previously
                    written to the pin. For input modes, typically the state is zero. However, for
                    digital inputs, the state is the status of the pull-up resistor which is 1 if
                    enabled, 0 if disabled. Returns message like [pin_state PIN# MODE state(, where
                    # is pin number</tr>
                </info>
                <param name="PIN#" type="int" required="true">
                    <tr lang="en">pin number</tr>
                </param>
            </method>
            <!-- report_apin -->
            <method name="report_apin">
                <info>
                    <tr lang="en">turns on/off analog pin (A0-A6) value reporting.</tr>
                </info>
                <param name="ANALOG_PIN" type="int" required="true">
                    <tr lang="en">analog pin number</tr>
                </param>
                <param name="VALUE" type="int" enum="0 1" required="true">
                    <tr lang="en">value. If 1 - activates analog reporting, messages like [apin
                    PIN# value( are returned every sampling interval (by default 19ms)</tr>
                </param>
            </method>
            <!-- report_dport -->
            <method name="report_dport">
                <info>
                    <tr lang="en">turns on/off digital port value reporting.</tr>
                </info>
                <param name="PORT#" type="int" required="true">
                    <tr lang="en">digital port number. Port is a group of pins, port 0 refers pins
                    0-8</tr>
                </param>
                <param name="VALUE" type="int" enum="0 1" required="true">
                    <tr lang="en">value. If 1 - activates digital port reporting, messages like
                    [dport PORT# value( are returned only on pin value change</tr>
                </param>
            </method>
            <!-- samp_interval -->
            <method name="samp_interval">
                <info>
                    <tr lang="en">sets sampling interval - how often analog data and i2c data is
                    reported to the client. The default for the arduino implementation is 19ms.
                    This means that every 19ms analog data will be reported and any i2c devices
                    with read continuous mode will be read.</tr>
                </info>
                <param name="TIME" type="int" units="millisecond" required="true" minvalue="10"
                maxvalue="10000">
                    <tr lang="en">time</tr>
                </param>
            </method>
            <!-- version? -->
            <method name="version?">
                <info>
                    <tr lang="en">query firmata protocol version. Returns message like: [version
                    MAJOR MINOR(</tr>
                </info>
            </method>
            <!-- write_dpin -->
            <method name="write_dpin">
                <info>
                    <tr lang="en">write 1 or 0 to digital pin. Pin mode should be OUTPUT.</tr>
                </info>
                <param name="PIN#" type="int" required="true">
                    <tr lang="en">pin number</tr>
                </param>
                <param name="VALUE" type="int" enum="0 1" required="true">
                    <tr lang="en">pin value</tr>
                </param>
            </method>
            <!-- write_pwm -->
            <method name="write_pwm">
                <info>
                    <tr lang="en">writes PWM (Pulse Width Modulation) value to specified pin.</tr>
                </info>
                <param name="PIN#" type="int" required="true">
                    <tr lang="en">pin number</tr>
                </param>
                <param name="VALUE" type="int" minvalue="0" maxvalue="256" required="true">
                    <tr lang="en">pin value</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">raw input of bytes from Arduino serial connection</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>raw byte output to Arduino serial connection and tagged parsed output from
            Arduino</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[report_apin 0 $1(
|
| [T]
| |
| [report_dport 0 $1(
| |
| | [T] /*blink onboard LED*/
| | |
| | [write_dpin 13 $1( [F]   /*attach servo to PIN10*/
| | |                  |
| | |            [write_pwm 10 $1(
| | |            |
| | | [version?( | [firmware?(
| | | |          | |
| | | |          | | [pin_mode 4 INPUT, pin_mode 10 SERVO(
| | | |          | | |
[proto.firmata       ]
|
[hw.arduino]
|
[proto.firmata]
|
[route version firmware apin dport]
|         ^|        ^^|
[ui.dt]   [ui.dt]   [ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
