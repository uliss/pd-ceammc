<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="flt.dcblock~">
        <title>flt.dcblock~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">mono DC blocker</tr>
                <tr lang="ru">одноканальный фильтр, блокирующий постоянную составляющую
                сигнала</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter dcblock</keywords>
            <since>0.1</since>
            <also>
                <see>flt.dcblock2~</see>
            </also>
        </meta>
        <info>
            <par>Mono DC blocker. It has -3dB point near 35 Hz (at 44.1 kHz) and high-frequency
            gain near 1.0025 (due to no scaling)</par>
        </info>
        <properties>
            <xi:include href="props_active.xml" />
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo>input signal</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[sig~ 2]
| |
| [env~]
| |
| [floatatom]
|
[flt.dcblock~]
|
[env~]
|
[floatatom]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
