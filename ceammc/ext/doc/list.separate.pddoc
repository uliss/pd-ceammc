<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="list.separate">
        <title>list.separate</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs each list item in turn as a separate message</tr>
                <tr lang="ru">поочередно выводит каждый элемент списка в виде отдельного
                сообщения</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list separate</keywords>
            <since>0.3</since>
            <also>
                <see>list.repack</see>
                <see>list.unpack</see>
            </also>
            <aliases>
                <alias>list.sep</alias>
            </aliases>
        </meta>
        <properties>
            <!-- @enumerate -->
            <property name="@enumerate" type="bool" default="0">
                <tr lang="en">enumeration mode. If enumeration is active output pairs: INDEX ATOM,
                otherwise single atoms</tr>
            </property>
            <!-- @from -->
            <property name="@from" type="int" default="0">
                <tr lang="en">enumeration starting index</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>outlet for single atoms (or pair: IDX ATOM in enumeration mode)</outlet>
            <outlet>outputs bang after last element in the list</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 4 5( [\(a b c d e\), bang(
|           |
|           [ml] [_]
|           |    |
|           |    [@enumerate $1(
|           |    |
[list.separate   ]
|
[print SEPARATE]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
