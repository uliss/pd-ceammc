<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.mul">
        <title>math.mul</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">multiplication</tr>
                <tr lang="ru">умножение</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math mul</keywords>
            <aliases>
                <alias>math.*</alias>
            </aliases>
            <since>0.6</since>
        </meta>
        <arguments>
            <argument name="MUL" type="float">
                <tr lang="en">multiplicand</tr>
                <tr lang="ru" finished="false">мультипликационный</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @mul -->
            <property name="@mul" type="float" default="1">
                <tr lang="en">multiplicand</tr>
                <tr lang="ru" finished="false">мультипликационный</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">multiplier</tr>
                    <tr lang="ru" finished="false">умножитель</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">list of multipliers (non float values are ignored)</tr>
                    <tr lang="ru" finished="false">список мультипликаторов (не поплавковые значения
                    игнорируются)</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">change multiplicand</tr>
                    <tr lang="ru" finished="false">изменить мультипликатор</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">float or list</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 A B C( [F]  [F]
|             |    |
|             |    |.
[math.* 2           ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
