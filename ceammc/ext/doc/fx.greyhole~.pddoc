<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fx.greyhole~">
    <title>fx.greyhole~</title>
    <meta>
      <authors>
        <author>Julian Parker</author>
        <author>Till Bovermann</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">a complex echo-like effect</tr>
        <tr lang="ru">сложный эхоподобный эффект</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>fx</category>
      <keywords>fx reverb echo</keywords>
      <since>0.5</since>
      <also>
        <see>fx.freeverb2~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">a complex echo-like effect inspired by the classic Eventide effect of a
        similar name, which consists of a diffuser (like a mini-reverb, structurally similar to the
        one used in JPverb) connected in a feedback system with a long modulated delay line</tr>
        <tr lang="ru">сложный эхоподобный эффект, вдохновлённый классическим эффектом Eventide с
        похожим названием, который состоит из диффузора (как мини-реверберация, структурно похожая
        на используемую в JPverb), соединённого в системе обратной связи с длинной модулированной
        линией задержки</tr>
      </par>
      <par>
        <tr lang="en">the effect excels at producing spacey washes of sound</tr>
        <tr lang="ru">эффект отлично подходит для создания пространственных звуковых «волн»</tr>
      </par>
      <par>
        <tr lang="en">@feedback sets the amount of feedback in the delay line, @delaytime sets the
        approximate delay time</tr>
        <tr lang="ru">@feedback задаёт величину обратной связи в линии задержки, @delaytime задаёт
        примерное время задержки</tr>
      </par>
      <par>
        <tr lang="en">@size, @diffusion and @damping shape the diffusion unit, @moddepth and
        @modfreq control the modulation of the delay line</tr>
        <tr lang="ru">@size, @diffusion и @damping формируют диффузионный блок, @moddepth и
        @modfreq управляют модуляцией линии задержки</tr>
      </par>
      <par>
        <tr lang="en">@drywet controls the balance between the original (dry) and processed signal,
        @bypass disables processing entirely</tr>
        <tr lang="ru">@drywet управляет балансом между исходным (сухим) и обработанным сигналом,
        @bypass полностью отключает обработку</tr>
      </par>
      <par>
        <tr lang="en">developed as part of the DEIND project</tr>
        <tr lang="ru">разработан в рамках проекта DEIND</tr>
      </par>
    </info>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypass the processed signal</tr>
        <tr lang="ru">флаг обхода. Если true: пропускать обработанный сигнал без изменений</tr>
      </property>
      <!-- @damping -->
      <property name="@damping" type="float" minvalue="0" maxvalue="0.99" default="0">
        <tr lang="en">controls damping of high frequencies as the delay decays. 0 is no damping, 1
        is very strong damping</tr>
        <tr lang="ru">управляет демпфированием высоких частот по мере затухания задержки. 0 — без
        демпфирования, 1 — очень сильное демпфирование</tr>
      </property>
      <!-- @delaytime -->
      <property name="@delaytime" type="float" units="second" minvalue="0.001" maxvalue="1.45"
      default="0.2">
        <tr lang="en">approximate delay time in seconds</tr>
        <tr lang="ru">примерное время задержки в секундах</tr>
      </property>
      <!-- @diffusion -->
      <property name="@diffusion" type="float" minvalue="0" maxvalue="0.99" default="0.5">
        <tr lang="en">shape of the diffusion unit. Values greater than 0.707 produce smooth
        exponential decay. Lower values produce a slower build-up of echoes</tr>
        <tr lang="ru">форма диффузионного блока. Значения больше 0.707 дают плавное
        экспоненциальное затухание. Меньшие значения дают более медленное нарастание эха</tr>
      </property>
      <!-- @drywet -->
      <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="1">
        <tr lang="en">proportion of mix between the original (dry) and processed signals. 0 — dry
        signal, 1 — processed</tr>
        <tr lang="ru">пропорция смеси между исходным (сухим) и обработанным сигналами. 0 — сухой
        сигнал, 1 — обработанный</tr>
      </property>
      <!-- @feedback -->
      <property name="@feedback" type="float" minvalue="0" maxvalue="1" default="0.9">
        <tr lang="en">amount of feedback for the delay line</tr>
        <tr lang="ru">величина обратной связи для линии задержки</tr>
      </property>
      <!-- @moddepth -->
      <property name="@moddepth" type="float" minvalue="0" maxvalue="1" default="0.1">
        <tr lang="en">depth of delay-line modulation. Use in combination with @modfreq to set the
        amount of chorusing within the structure</tr>
        <tr lang="ru">глубина модуляции линии задержки. Используйте вместе с @modfreq, чтобы задать
        величину хоруса в структуре</tr>
      </property>
      <!-- @modfreq -->
      <property name="@modfreq" type="float" minvalue="0" maxvalue="10" default="2">
        <tr lang="en">frequency of delay-line modulation. Use in combination with @moddepth to set
        the amount of chorusing within the structure</tr>
        <tr lang="ru">частота модуляции линии задержки. Используйте вместе с @moddepth, чтобы
        задать величину хоруса в структуре</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="float" minvalue="0.5" maxvalue="3" default="1">
        <tr lang="en">size of the delay lines within the diffusion unit, producing the impression
        of a larger or smaller space. Values below 1 can sound quite metallic</tr>
        <tr lang="ru">размер линий задержки внутри диффузионного блока, создающий впечатление
        большего или меньшего пространства. Значения ниже 1 могут звучать довольно
        металлически</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset to initial state</tr>
          <tr lang="ru">сбросить в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">left channel</tr>
          <tr lang="ru">левый канал</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">right channel</tr>
          <tr lang="ru">правый канал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru">выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru">выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[1000 1000 0, 300 300 1000, 3000 500 1300, 0 100 1400(
|
[vline~]
|
[osc.saw~]
| \
[fx.greyhole~]   [ui.hsl #c]
|       ^|
|        |
[*~ #a] [*~ #b]
|       |
|       |.
[dac~    ]

[X c->a:1]
[X c->b:1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
