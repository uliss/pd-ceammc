<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="modplug~">
    <title>modplug~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">MOD file player</tr>
        <tr lang="ru">проигрыватель MOD-файлов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>misc</category>
      <keywords>mod player</keywords>
      <since>0.4</since>
      <aliases>
        <alias>ceammc/modplug~</alias>
      </aliases>
    </meta>
    <properties>
      <!-- @done -->
      <property name="@done" type="symbol" default="">
        <tr lang="en">function called with a bang when playback finishes</tr>
        <tr lang="ru">функция, вызываемая с bang по завершении воспроизведения</tr>
      </property>
      <!-- @len -->
      <property name="@len" type="float" access="readonly" units="millisecond" default="0">
        <tr lang="en">length of the MOD file in milliseconds</tr>
        <tr lang="ru">длина MOD-файла в миллисекундах</tr>
      </property>
      <!-- @name -->
      <property name="@name" type="symbol" default="" access="readonly">
        <tr lang="en">MOD file name</tr>
        <tr lang="ru">имя MOD-файла</tr>
      </property>
      <!-- @play -->
      <property name="@play" type="bool" default="0">
        <tr lang="en">playback state (1 = playing, 0 = stopped)</tr>
        <tr lang="ru">состояние воспроизведения (1 = играет, 0 = остановлено)</tr>
      </property>
      <!-- @pos -->
      <property name="@pos" type="float" units="millisecond" default="-1">
        <tr lang="en">current playback position in milliseconds</tr>
        <tr lang="ru">текущая позиция воспроизведения в миллисекундах</tr>
      </property>
      <!-- @rpos -->
      <property name="@rpos" type="float" minvalue="0" maxvalue="1" default="0">
        <tr lang="en">relative playback position (0..1)</tr>
        <tr lang="ru">относительная позиция воспроизведения (0..1)</tr>
      </property>
    </properties>
    <methods>
      <!-- pause -->
      <method name="pause">
        <info>
          <tr lang="en">pause playback</tr>
          <tr lang="ru">приостановить воспроизведение</tr>
        </info>
      </method>
      <!-- play -->
      <method name="play">
        <info>
          <tr lang="en">start playback</tr>
          <tr lang="ru">запустить воспроизведение</tr>
        </info>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stop playback and move the play position to the end of the file</tr>
          <tr lang="ru">остановить воспроизведение и переместить позицию воспроизведения в конец файла</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">load a MOD file</tr>
          <tr lang="ru">загрузить MOD-файл</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left channel and property output</tr>
          <tr lang="ru">левый канал и вывод свойств</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right channel</tr>
          <tr lang="ru">правый канал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[symbol stargazing.mod(  [T]
|                        |
| [play( [pause( [stop(  [metro 100]
| |      |       |       |
| |      |       |       [@rpos?(
| |      |       |       |
[modplug~   @done on_done #x1]
|
[~->                          ]  [function on_done]
|                            ^|              ^|
[ui.gain2~ #x2 @size 120 16] [route @rpos]    [T]
| ^|.                        |
[dac~]  [ui.dsp~]            [F]

[X x1:1->x2:1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
