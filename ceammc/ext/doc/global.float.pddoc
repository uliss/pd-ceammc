<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="global.float">
        <title>global.float</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">global named float object</tr>
                <tr lang="ru">глобальной именованное число с плавающей точкой</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>global</category>
            <keywords>float global</keywords>
            <since>0.1</since>
            <also>
                <see>local.float</see>
                <see>global.int</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Defines global scope float variable, accessed by ID name.</tr>
            </par>
        </info>
        <arguments>
            <argument name="ID" type="symbol">
                <tr lang="en">object ID</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @id -->
            <property name="@id" type="symbol" access="initonly" default="default">
                <tr lang="en">global variable id</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="float" access="readonly" default="0">
                <tr lang="en">current value</tr>
            </property>
        </properties>
        <methods>
            <!-- * -->
            <method name="*">
                <info>
                    <tr lang="en">multiply to, no output</tr>
                </info>
            </method>
            <!-- + -->
            <method name="+">
                <info>
                    <tr lang="en">add to float, no output</tr>
                </info>
            </method>
            <method name="-">
                <info>
                    <tr lang="en">subtract from float, no output</tr>
                </info>
            </method>
            <!-- / -->
            <method name="/">
                <info>
                    <tr lang="en">divide by, no output</tr>
                </info>
                <param name="DIV" type="float">
                    <tr lang="en">divider value</tr>
                </param>
            </method>
            <!-- get -->
            <method name="get">
                <info>
                    <tr lang="en">get the value of global float variable (not only for connected
                    object)</tr>
                </info>
                <param name="NAME" type="symbol" required="false">
                    <tr lang="en">requested variable name. If ommitted: request the value from the
                    current connected object, if specified: output value from found global
                    variable</tr>
                </param>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">sets new value without output</tr>
                </info>
                <param name="VALUE" type="float" required="true">
                    <tr lang="en">new value</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">outputs variable</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">set variable to given float and outputs new value</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>float output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]   [+ 2, bang(    [* 3, bang(    [bang(
|     |              |              |
|     |              |              |
|     |  [- 3, bang( | [/ 2, bang(  |
|     |  |           | |            |
|     |  | [set 2(   | |            |
|     |  | |         | |            |
[global.float        f1]            [global.float f1]
|                                   |
[F]                                 [F]

[loadmsg 12345]
|
[global.float f2]

/*get current*/

[get( /*get f1*/
|
|     [get f1( /*get f2*/
|     |
|     |        [get f2( [get f3(
|     |        |        |
[global.float           ] /*default anonymouse global float*/
|
[ui.dt]

/*global dispatch name binding*/

[123(
|
[s f1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
