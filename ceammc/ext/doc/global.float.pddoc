<?xml version='1.0' encoding='utf-8'?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="global.float">
        <title>global.float</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>global named float object</description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>global</category>
            <keywords>float global</keywords>
            <since>0.1</since>
            <also>
                <see>local.float</see>
                <see>global.int</see>
            </also>
        </meta>
        <info>
            <par>Defines global scope float variable, accessed by ID name.</par>
        </info>
        <arguments>
            <argument name="ID" type="symbol">object ID</argument>
        </arguments>
        <properties>
            <property name="@id" type="symbol" access="initonly" default="default">global variable
            id</property>
            <property name="@value" type="float" access="readonly" default="0">current
            value</property>
        </properties>
        <methods>
            <!-- * -->
            <method name="*">multiply to, no output</method>
            <!-- + -->
            <method name="+">add to float, no output</method>
            <!-- - -->
            <method name="-">subtract from float, no output</method>
            <!-- / -->
            <method name="/">divide by, no output
            <param name="DIV" type="float">divider value</param></method>
            <!-- get -->
            <method name="get">get the value of global float variable (not only for connected object)
            <param name="NAME" type="symbol" required="false">requested variable name.
            If ommitted: request the value from the current connected object, if specified: output value from found global variable</param>
            </method>
            <!-- set -->
            <method name="set">sets new value without output
            <param name="VALUE" type="float" required="true">new value</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">outputs variable</xinfo>
                <xinfo on="float">set variable to given float and outputs new value</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>float output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]   [+ 2, bang(    [* 3, bang(    [bang(
|     |              |              |
|     |              |              |
|     |  [- 3, bang( | [/ 2, bang(  |
|     |  |           | |            |
|     |  | [set 2(   | |            |
|     |  | |         | |            |
[global.float        f1]            [global.float f1]
|                                   |
[F]                                 [F]

[loadmsg 12345]
|
[global.float f2]

/*get current*/

[get( /*get f1*/
|
|     [get f1( /*get f2*/
|     |
|     |        [get f2( [get f3(
|     |        |        |
[global.float           ] /*default anonymouse global float*/
|
[ui.dt]

/*global dispatch name binding*/

[123(
|
[s f1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
