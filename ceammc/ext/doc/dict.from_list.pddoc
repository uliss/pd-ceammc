<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="dict.from_list">
        <title>dict.from_list</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">creates dictionary from the list</tr>
                <tr lang="ru">создает словарь из списка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>dictionary</keywords>
            <since>0.7</since>
            <also>
                <see>data.dict</see>
            </also>
            <aliases>
                <alias>ceammc/list-&gt;dict</alias>
                <alias>list-&gt;dict</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Convertion depends on property @step, which means a length of
                key/value pair. First element of the pair becames a key, and other elements becames
                value.</tr>
            </par>
        </info>
        <arguments>
            <argument name="STEP" type="int" minvalue="2">
                <tr lang="en">key/value length in input list</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @step -->
            <property name="@step" type="int" minvalue="2" default="2">
                <tr lang="en">key/value length in input list</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>dict output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[list a b c d e f g h j k  (
|                          |
|                          |
|                          |
[list->dict]               [list->dict 3]
|                          |
[ui.d]                     [ui.d]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
