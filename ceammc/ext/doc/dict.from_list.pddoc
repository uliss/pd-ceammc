<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="dict.from_list">
    <title>dict.from_list</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">creates a dictionary from a list</tr>
        <tr lang="ru">создаёт словарь из списка</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>dictionary</keywords>
      <since>0.7</since>
      <also>
        <see>data.dict</see>
      </also>
      <aliases>
        <alias>ceammc/list-&gt;dict</alias>
        <alias>list-&gt;dict</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Conversion depends on the @step property, which sets the length of a
        key/value pair. The first element of each group becomes the key, and the remaining elements
        become the value.</tr>
        <tr lang="ru">Преобразование зависит от свойства @step, которое задаёт длину пары
        ключ/значение. Первый элемент каждой группы становится ключом, а остальные элементы —
        значением.</tr>
      </par>
    </info>
    <arguments>
      <argument name="STEP" type="int" minvalue="2">
        <tr lang="en">key/value length in the input list. Default is 2 (one key, one value per
        pair)</tr>
        <tr lang="ru">длина пары ключ/значение во входном списке. По умолчанию 2 (один ключ, одно
        значение на пару)</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @step -->
      <property name="@step" type="int" minvalue="2" default="2">
        <tr lang="en">key/value length in the input list. Can be set at creation time or changed
        later</tr>
        <tr lang="ru">длина пары ключ/значение во входном списке. Может быть задана при создании
        объекта или изменена позже</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input list to convert into a dictionary</tr>
          <tr lang="ru">входной список для преобразования в словарь</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">dict output</tr>
          <tr lang="ru">вывод словаря</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[list a b c d e f g h j k  (
|                          |
|                          |
|                          |
[list->dict]               [list->dict 3]
|                          |
[ui.d]                     [ui.d]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
