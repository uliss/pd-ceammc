<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.variance">
    <title>array.variance</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">calculates variance of array values</tr>
        <tr lang="ru">вычисляет дисперсию значений массива</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array deviation variance</keywords>
      <since>0.7.1</since>
      <also>
        <see>array.stddev</see>
      </also>
    </meta>
    <info>
      <wiki name="Variance">Variance</wiki>
      <par>
        <tr lang="en">The object computes the variance of all samples in the specified array and
        outputs it as a single float. The variance shows how far the sample values are spread out
        from their mean value and equals the square of the standard deviation.</tr>
        <tr lang="ru">Объект вычисляет дисперсию всех семплов указанного массива и выводит её одним
        числом с плавающей точкой. Дисперсия показывает, насколько значения семплов разбросаны
        относительно их среднего значения, и равна квадрату стандартного отклонения.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">calculates the variance and outputs it</tr>
          <tr lang="ru">вычисляет дисперсию и выводит её</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">variance</tr>
          <tr lang="ru">дисперсия</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                            [array avar size=200 w=200 h=100]
|
[array.variance avar]
|
[F digits=16]



[gauss 0 0.4( [sin 25 1( [fill 0(
|             |          |
[array.fill       avar   ]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
