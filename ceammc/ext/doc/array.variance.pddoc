<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="array.variance">
        <title>array.variance</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">calculates variance of array values</tr>
                <tr lang="ru">вычисляет дисперсию значений массива</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array deviation variance</keywords>
            <since>0.7.1</since>
            <also>
                <see>array.stddev</see>
            </also>
        </meta>
        <info>
            <wiki name="Variance">Variance</wiki>
        </info>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">calculates and outputs variance</tr>
                    <tr lang="ru" finished="false">вычисления и отклонения результатов</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">variance</tr>
                    <tr lang="ru" finished="false">дисперсия</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]                            [array avar size=200 w=200 h=100]
|
[array.variance avar]
|
[F digits=16]



[gauss 0 0.4( [sin 25 1( [fill 0(
|             |          |
[array.fill       avar   ]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
