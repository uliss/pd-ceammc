<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fx.jcrev~">
    <title>fx.jcrev~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Schroeder quad reverberator from 1972</tr>
        <tr lang="ru">квадрофонический ревербератор Шрёдера 1972 года</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>fx</category>
      <keywords>fx room reverb schroeder</keywords>
      <since>0.9.6</since>
    </meta>
    <info>
      <par>
        <tr lang="en">a four-channel (quad) algorithmic reverberator based on the architecture proposed by Manfred Schroeder</tr>
        <tr lang="ru">четырёхканальный (квадрофонический) алгоритмический ревербератор на основе архитектуры, предложенной Манфредом Шрёдером</tr>
      </par>
      <par>
        <tr lang="en">the classic Schroeder reverberator consists of parallel feedback comb filters followed by series allpass filters</tr>
        <tr lang="ru">классический ревербератор Шрёдера состоит из параллельных гребёнчатых фильтров с обратной связью и последовательных аллпасс-фильтров</tr>
      </par>
      <par>
        <tr lang="en">the four outputs provide a quadraphonic signal for a four-channel playback system</tr>
        <tr lang="ru">четыре выхода дают квадрофонический сигнал для четырёхканальной системы воспроизведения</tr>
      </par>
    </info>
    <arguments>
      <argument name="DRYWET" type="float" minvalue="0" maxvalue="1">
        <tr lang="en">drywet mix</tr>
        <tr lang="ru">соотношение сухого и обработанного сигнала</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypass the processed signal</tr>
        <tr lang="ru">флаг обхода. Если true: пропускать обработанный сигнал без изменений</tr>
      </property>
      <!-- @drywet -->
      <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.4">
        <tr lang="en">proportion of mix between the original (dry) and processed signals. 0 — dry signal, 1 — processed</tr>
        <tr lang="ru">пропорция смеси между исходным (сухим) и обработанным сигналами. 0 — сухой сигнал, 1 — обработанный</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset to initial state</tr>
          <tr lang="ru">сбросить в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set drywet</tr>
          <tr lang="ru">задать соотношение сухого и обработанного сигнала</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">first output signal</tr>
          <tr lang="ru">первый выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">second output signal</tr>
          <tr lang="ru">второй выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">third output signal</tr>
          <tr lang="ru">третий выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">fourth output signal</tr>
          <tr lang="ru">четвёртый выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]                [ui.dsp~]
|
[metro 250]
|
[random.a 68 26 84]
|
[makenote 127 200] [ui.k]
*|*                |
[pack f f]         |             [T]
|                  |             |
[synth.dubdub~]    [@drywet $1(  [@bypass $1(
|                  |             |
[fx.jcrev~                       ]
*|*
*|*                [ui.hsl -60 0 @show_value 1]
*|*                |
*|*                [dbfs->amp #a]
*|*
[gain~ 4 {i=5,o=4,w=20} #x]
*|*
[dac~ 1 2 3 4 {w=20}]
[X a->x:4]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
