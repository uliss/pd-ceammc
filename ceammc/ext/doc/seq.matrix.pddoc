<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="seq.matrix">
        <title>seq.matrix</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sequencer control for [ui.matrix] object</tr>
                <tr lang="ru">секвенсер для объекта [ui.matrix]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>seq</category>
            <keywords>seq sequencer bang pattern rhythm matrix</keywords>
            <since>0.9.1</since>
            <also>
                <see view="link">ui.matrix</see>
            </also>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="0">
                <tr lang="en">number of steps</tr>
                <tr lang="ru" finished="false">Количество шагов</tr>
            </argument>
            <argument name="T" type="float" minvalue="1" maxvalue="20000" units="millisecond">
                <tr lang="en">time interval between steps or bpm</tr>
                <tr lang="ru" finished="false">интервал времени между шагами или bpm</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @div -->
            <property name="@div" type="int" minvalue="1" default="1" maxvalue="64">
                <tr lang="en">beat subdivision</tr>
                <tr lang="ru" finished="false">Победить подразделение</tr>
            </property>
            <!-- @dur -->
            <property name="@dur" type="float" default="4000" minvalue="0" units="millisecond">
                <tr lang="en">whole sequence duration. (Recalculates @t property accordingly)</tr>
                <tr lang="ru" finished="false">Продолжительность всей последовательности.
                (Соответственно пересчитывает имущество @t)</tr>
            </property>
            <!-- @i -->
            <property name="@i" type="int" access="readonly" default="0">
                <tr lang="en">current sequence iteration</tr>
                <tr lang="ru" finished="false">итерация текущей последовательности</tr>
            </property>
            <!-- @inf -->
            <property name="@inf" type="alias">
                <tr lang="en">alias to @r -1, repeats infinitely</tr>
                <tr lang="ru" finished="false">alias to @r-1, повторяется бесконечно</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" enum="inc dec tri" default="inc">
                <tr lang="en">sequencer mode. 'inc': from first to last, 'dec': from last to first,
                'tri': from first to last, then back</tr>
                <tr lang="ru" finished="false">"inc": от первого до последнего, "dec": от
                последнего до первого, "tri": от первого до последнего, затем обратно</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" default="16" minvalue="0">
                <tr lang="en">number of cols in matrix</tr>
                <tr lang="ru" finished="false">Количество cols в матрице</tr>
            </property>
            <!-- @once -->
            <property name="@once" type="alias">
                <tr lang="en">alias to @r 1, play once</tr>
                <tr lang="ru" finished="false">alias to @r 1, играть один раз</tr>
            </property>
            <!-- @r -->
            <property name="@r" type="int" minvalue="-1" default="-1">
                <tr lang="en">number of whole sequence repeats. If -1: repeat infinitely</tr>
                <tr lang="ru" finished="false">Количество повторений целой последовательности. Если
                -1: повторять бесконечно</tr>
            </property>
            <!-- @ri -->
            <property name="@ri" type="int" access="readonly" default="0">
                <tr lang="en">current repeat iteration</tr>
                <tr lang="ru" finished="false">Текущая повторная итерация</tr>
            </property>
            <!-- @t -->
            <property name="@t" type="float" default="250" minvalue="1" maxvalue="20000" units="millisecond">
                <tr lang="en">time between beats. Unit values like 100ms or 240bpm also can be
                used</tr>
                <tr lang="ru" finished="false">Время между ударами. Значения единицы, такие как 100
                мс или 240bpm, также могут использоваться.</tr>
            </property>
            <!-- @upbeat -->
            <property name="@upbeat" type="float" default="0" minvalue="0">
                <tr lang="en">wait specified number of beats before sequence start</tr>
                <tr lang="ru" finished="false">ожидание определенного количества ударов перед
                началом последовательности</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset all counters and stop</tr>
                    <tr lang="ru" finished="false">Сбросить все счетчики и остановиться</tr>
                </info>
            </method>
            <!-- rewind -->
            <method name="rewind">
                <info>
                    <tr lang="en">reset all counters without stopping</tr>
                    <tr lang="ru" finished="false">Сбросить все счетчики без остановки</tr>
                </info>
            </method>
            <!-- start -->
            <method name="start">
                <info>
                    <tr lang="en">start sequencer from current position</tr>
                    <tr lang="ru" finished="false">стартовый секвенсор с текущей позиции</tr>
                </info>
            </method>
            <!-- stop -->
            <method name="stop">
                <info>
                    <tr lang="en">stop sequencer</tr>
                    <tr lang="ru" finished="false">остановить секвенсор</tr>
                </info>
            </method>
            <!-- tick -->
            <method name="tick">
                <info>
                    <tr lang="en">output current sequence element and move to next</tr>
                    <tr lang="ru" finished="false">вывести элемент текущей последовательности и
                    перейти к следующему</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">reset all counters and start sequencer</tr>
                    <tr lang="ru" finished="false">Сбросить все счетчики и запустить секвенсор</tr>
                </in>
                <in on="float">
                    <tr lang="en">if 1 reset then start, if 0 - stop</tr>
                    <tr lang="ru" finished="false">Если 1 сброс, то начинайте, если 0 -
                    остановитесь</tr>
                </in>
            </inlet>
            <inlet>
                <in on="bang">
                    <tr lang="en">reset</tr>
                    <tr lang="ru" finished="false">сброс</tr>
                </in>
                <in on="float">
                    <tr lang="en">set number of steps</tr>
                    <tr lang="ru" finished="false">Установить количество шагов</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output for ui.matrix</tr>
                    <tr lang="ru" finished="false">Источник: ui.matrix</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">[i IDX N( - sequence iteration, [ri IDX N( - repeat iteration or
                    [done( when done</tr>
                    <tr lang="ru" finished="false">[i IDX N( - итерация последовательностей, [ri
                    IDX N( - повторная итерация или [сделано, когда сделано)]</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T] [rewind(  [ui.tab inc dec tri]   [ui.dsp~]
|   |         |
|   |         [@mode $1(
|   |         |
[seq.matrix #m]        [loadmsg random]
|                      |
[ui.matrix 3 16 @size 320 51]
|
|
|
[route col]
|
[unpack f f f f #a]
|
[F]  [osc~ 400]    [synth.clap~  #e2]
     |
     | [@gate #g0( [synth.kick2~ #e1]
     | |
     [env.ar~ #e0]

[pan.spread~ 5 #s {w=16}]
*|*
[ui.hgain2~]
*|*
[dac~ {w=16}]
#e0 20 100
#e1 10 80
#e2 6 200
#g0 $1
#g1 $1
#g2 $1
#m 16 120bpm @div 4
[X a:1->g0]
[X a:2->e1]
[X a:3->e2]
[X e0->s:1]
[X e1->s:2]
[X e2->s:3]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
