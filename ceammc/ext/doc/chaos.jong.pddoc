<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="chaos.jong">
        <title>chaos.jong</title>
        <meta>
            <authors>
                <author>André Sier</author>
            </authors>
            <description>
                <tr lang="en">Peter de Jong attractor</tr>
                <tr lang="ru">аттрактор Питера де Йонга</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>chaos</category>
            <keywords>chaos peter de jong</keywords>
            <since>0.9</since>
            <also>
                <see>chaos.std0</see>
            </also>
            <aliases>
                <alias>noise.jong</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">A non-interpolating generator based on the difference equations:</tr>
                <!-- old: Неинтерполирующий генератор, основанный на
                разностных уравнениях: -->
                <tr lang="ru" finished="false">Неинтерполирующий генератор, основанный на
                разностных уравнениях:</tr>
            </par>
            <par>
                <tr lang="en">x[n+1] = sin(a * y[n]) - cos(b * x[n])</tr>
                <tr lang="ru" finished="false">x[n+1] = sin(a * y[n]) — cos(b * x[n])</tr>
            </par>
            <par>
                <tr lang="en">y[n+1] = sin(c * x[n]) - cos(d * y[n])</tr>
                <tr lang="ru" finished="false">y[n+1] ] = sin(c * x[n]) - cos(d * y[n])</tr>
            </par>
            <a href="http://paulbourke.net/fractals/peterdejong/">wiki: Peter de Jong
            Attractors</a>
        </info>
        <arguments>
            <argument name="A" type="float">
                <tr lang="en">a-value (default 1.4)</tr>
                <tr lang="ru" finished="false">a-значение (дефолт 1.4)</tr>
            </argument>
            <argument name="B" type="float">
                <tr lang="en">b-value (default -2.3)</tr>
                <tr lang="ru" finished="false">b-значение (дефолт -2,3)</tr>
            </argument>
            <argument name="C" type="float">
                <tr lang="en">c-value (default 2.4)</tr>
                <tr lang="ru" finished="false">c - значение (по умолчанию 2.4)</tr>
            </argument>
            <argument name="D" type="float">
                <tr lang="en">d-value (default -2.1)</tr>
                <tr lang="ru" finished="false">d-значение (дефолт -2.1)</tr>
            </argument>
            <argument name="X" type="float">
                <tr lang="en">x init value (default 0)</tr>
                <tr lang="ru" finished="false">x init значение (по умолчанию 0)</tr>
            </argument>
            <argument name="Y" type="float">
                <tr lang="en">y init value (default 0)</tr>
                <tr lang="ru" finished="false">y значение init (по умолчанию 0)</tr>
            </argument>
        </arguments>
        <methods>
            <!-- a -->
            <method name="a">
                <info>
                    <tr lang="en">set a-value, does not not change init state value</tr>
                    <!-- old: Устанавливает a-значение, не изменяет его
                    состояние -->
                    <tr lang="ru" finished="false">Устанавливает a-значение, не изменяет его
                    состояние</tr>
                </info>
            </method>
            <!-- b -->
            <method name="b">
                <info>
                    <tr lang="en">set b-value, does not not change init state value</tr>
                    <!-- old: Устанавливает b-значение, не изменяет его
                    состояние -->
                    <tr lang="ru" finished="false">Устанавливает b-значение, не изменяет его
                    состояние</tr>
                </info>
            </method>
            <!-- c -->
            <method name="c">
                <info>
                    <tr lang="en">set c-value, does not not change init state value</tr>
                    <!-- old: Устанавливается c-значение, не изменяется его
                    состояние -->
                    <tr lang="ru" finished="false">Устанавливается c-значение, не изменяется его
                    состояние</tr>
                </info>
            </method>
            <!-- d -->
            <method name="d">
                <info>
                    <tr lang="en">set d-value, does not not change init state value</tr>
                    <!-- old: заданная d-значение, не меняющая значения
                    состояния -->
                    <tr lang="ru" finished="false">заданная d-значение, не меняющая значения
                    состояния</tr>
                </info>
            </method>
            <!-- om -->
            <method name="om">
                <info>
                    <tr lang="en">turn on/off method output mode. If true (1) outputs new generated
                    value after each a,b,d,e,x,y method call, if 0 - change values without output.
                    Default is 0.</tr>
                    <!-- old: режим вывода метода включения/выключения. Если
                    истинное (1) выводит новое сгенерированное значение после каждого вызова метода
                    a,b,d,e,x,y, если 0 - изменяет значения без вывода. По умолчанию 0. -->
                    <tr lang="ru" finished="false">режим вывода метода включения/выключения. Если
                    истинное (1) выводит новое сгенерированное значение после каждого вызова метода
                    a,b,d,e,x,y, если 0 - изменяет значения без вывода. По умолчанию 0.</tr>
                </info>
                <param name="BOOL" type="int" required="true">
                    <tr lang="en">output mode</tr>
                    <tr lang="ru" finished="false">выходной режим</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">set to initial state</tr>
                    <tr lang="ru" finished="false">Установлено начальное состояние</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">set A B C D E X Y values. Also updates init state vars.</tr>
                    <!-- old: установить значения A B C D E X Y. Обновление
                    init state vars. -->
                    <tr lang="ru" finished="false">установить значения A B C D E X Y. Обновление
                    init state vars.</tr>
                </info>
            </method>
            <!-- x -->
            <method name="x">
                <info>
                    <tr lang="en">set current x-value, does not not change init state value</tr>
                    <!-- old: Устанавливает текущее x-значение, не изменяет
                    его состояние -->
                    <tr lang="ru" finished="false">Устанавливает текущее x-значение, не изменяет
                    его состояние</tr>
                </info>
            </method>
            <!-- y -->
            <method name="y">
                <info>
                    <tr lang="en">set current y-value, does not not change init state value</tr>
                    <!-- old: Устанавливает текущее значение y, не изменяет
                    его состояние -->
                    <tr lang="ru" finished="false">Устанавливает текущее значение y, не изменяет
                    его состояние</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">generate and output new value</tr>
                    <tr lang="ru" finished="false">генерировать и производить новую стоимость</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">new generated x-value</tr>
                    <tr lang="ru" finished="false">Новое генерируемое значение x</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">new generated y-value</tr>
                    <tr lang="ru" finished="false">Новая генерируемая y-значение</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]                        [r~ jong]
|                          |
[metro.random 100 400]     [ui.scope~ @size=360x100]
|
[chaos.jong #a]
|
[l->l -2 2 1 2]
|
[sig~]   [l->l -2 2 -0.7 0.8 #b]
|
[lop~ 40]       [l->l -2 2 -1 1 #c]
|               |
[osc.impulse~]  [sig~]
|               |
[*~ 20]         [lop~ 5 #d]
|
[cpole~ {w=23} #z]
|        ^|.
[pan.spread~ @spread 0.4]
|                    ^|
[fx.pitchshift~ -24]  |
|                     |
[clip~ -1 1]    [clip~ -1 1]
|                    |.   |
[ui.hgain2~ @size 20 164] [s~ jong]
| ^|.
[dac~ {w=23}]
[X a:0->b]
[X a:1->c]
[X b:0->z:2]
[X d:0->z:3]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
