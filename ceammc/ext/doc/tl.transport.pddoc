<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="tl.transport">
    <title>tl.transport</title>
    <meta>
      <authors>
        <author>Alex Nadzharov</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">timeline transport control</tr>
        <tr lang="ru">управление транспортной шкалой</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>tl</category>
      <keywords>timeline transport</keywords>
      <since>0.1</since>
      <also>
        <see view="link">tl.cue</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Transport control for the timeline system. Receives a cue index and, together
        with the associated [tl.cue] objects and the global transport object, determines which
        section of the timeline is currently active. Other timeline objects such as [tl.bang] and
        [tl.toggle] check this active cue to decide whether they should fire.</tr>
        <tr lang="ru">Управление транспортом для системы временной шкалы. Принимает индекс метки и
        вместе со связанными объектами [tl.cue] и глобальным объектом transport определяет, какая
        секция временной шкалы активна в данный момент. Другие объекты временной шкалы, например
        [tl.bang] и [tl.toggle], проверяют эту активную метку, чтобы решить, должны ли они
        срабатывать.</tr>
      </par>
    </info>
    <methods>
      <!-- cue -->
      <method name="cue">
        <info>
          <tr lang="en">sets the cue index</tr>
          <tr lang="ru">устанавливает индекс метки</tr>
        </info>
        <param name="N" type="int" minvalue="0">
          <tr lang="en">cue index</tr>
          <tr lang="ru">индекс метки</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control input</tr>
          <tr lang="ru">управляющий вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets />
    <example>
      <pdascii>
<![CDATA[
[tl.cue]           [tl.cue]

[HR number=2]    [tl.bang]
|                |
[cue $1(         [B]                      [tl.bang]
|                                         |
[tl.transport]                            [B]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
