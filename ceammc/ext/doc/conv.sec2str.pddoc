<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.sec2str">
    <title>conv.sec2str</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">formats time in seconds to symbol or string</tr>
        <tr lang="ru">форматирует время в секундах в символ или строку</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv time</keywords>
      <also>
        <see>conv.str2sec</see>
      </also>
      <since>0.1</since>
      <aliases>
        <alias>ceammc/sec-&gt;str</alias>
        <alias>sec-&gt;str</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes a time value in seconds and formats it as a human-readable
        time string in the form "HH:MM:SS" (or "HH:MM:SS.XXX" if the @ms flag is set). By default
        the result is output as a string object (that is, a symbol in Pd terms); with the @symbol
        flag, the result is sent through the outlet as a symbol. This is the inverse operation of
        [conv.str2sec].</tr>
        <tr lang="ru">Объект принимает значение времени в секундах и форматирует его в
        удобочитаемую строку времени вида "HH:MM:SS" (или "HH:MM:SS.XXX", если установлен флаг
        @ms). По умолчанию результат выводится как строковый объект (то есть символ в терминах Pd);
        при флаге @symbol результат отправляется через выход в виде символа. Это операция, обратная
        [conv.str2sec].</tr>
      </par>
    </info>
    <properties>
      <!-- @ms -->
      <property name="@ms" type="flag" default="0" access="initonly">
        <tr lang="en">output milliseconds as well</tr>
        <tr lang="ru">выводить также миллисекунды</tr>
      </property>
      <!-- @symbol -->
      <property name="@symbol" type="flag" default="0" access="initonly">
        <tr lang="en">if specified, output the formatted time as a symbol; otherwise as a
        string</tr>
        <tr lang="ru">если указан, выводить форматированное время как символ; иначе как строку</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">time in seconds to format</tr>
          <tr lang="ru">время в секундах для форматирования</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">time in the format "HH:MM:SS" or "HH:MM:SS.XXX"</tr>
          <tr lang="ru">время в формате "HH:MM:SS" или "HH:MM:SS.XXX"</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]                   [F]
|                     |
[metro 1000]          [sec->str @symbol @ms]
|                     |
[f] X [+ 1]           [S digits=14]
|                     |
[sec->str @symbol]    [str->sec]
|                     |
[S digits=12]         [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
