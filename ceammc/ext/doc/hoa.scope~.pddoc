<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="hoa.scope~" type="gui">
        <title>hoa.scope~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
                <author>Pierre Guillot</author>
                <author>Eliott Paris</author>
                <author>Thomas Le Meur</author>
            </authors>
            <description>
                <tr lang="en">a 2d ambisonic harmonic scope</tr>
                <tr lang="ru">отображение сферических гармоник в двумерном амбисоническом поле</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">spat</category>
            <keywords>hoa scope</keywords>
            <since>0.8</since>
            <aliases>
                <alias view="link">hoa.2d.scope~</alias>
            </aliases>
        </meta>
        <info>
            <par>displays the circular harmonics of an ambisonic sound field</par>
            <a href="hoa/hoa.2d.scope~-help.pd">CICM documentation</a>
        </info>
        <mouse>
            <event type="right-click" editmode="false" keys="Shift">open the object help</event>
            <event type="right-click" editmode="false" keys="Alt">open the properties
            dialog</event>
            <event type="right-click" editmode="true">opens the Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true" keys="Alt">open the properties dialog</event>
        </mouse>
        <arguments>
            <argument name="ORDER" type="int" minvalue="1">
                <tr lang="en">the order of decomposition</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @background_color -->
            <property name="@background_color" type="list" default="0.93 0.93 0.93 1">
                <tr lang="en">element background color (list of red, green, blue values in 0-1
                range)</tr>
            </property>
            <!-- @border_color -->
            <property name="@border_color" type="list" default="0.6 0.6 0.6 1">
                <tr lang="en">border color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @fontname -->
            <property name="@fontname" type="symbol" default="Helvetica"
            enum="Courier DejaVu Helvetica Monaco Times">
                <tr lang="en">fontname</tr>
            </property>
            <!-- @fontsize -->
            <property name="@fontsize" type="int" minvalue="4" maxvalue="100" default="11">
                <tr lang="en">fontsize</tr>
            </property>
            <!-- @fontslant -->
            <property name="@fontslant" type="symbol" enum="roman italic" default="roman">
                <tr lang="en">font slant</tr>
            </property>
            <!-- @fontweight -->
            <property name="@fontweight" type="symbol" enum="normal bold" default="normal">
                <tr lang="en">font weight</tr>
            </property>
            <!-- @gain -->
            <property name="@gain" type="float" default="1" minvalue="0">
                <tr lang="en">gain</tr>
            </property>
            <!-- @label -->
            <property name="@label" type="symbol" default="(null)">
                <tr lang="en">label text</tr>
            </property>
            <!-- @label_align -->
            <property name="@label_align" type="symbol" enum="left center right" default="left">
                <tr lang="en">label horizontal align</tr>
            </property>
            <!-- @label_color -->
            <property name="@label_color" type="list" default="0 0 0 1">
                <tr lang="en">label color in RGB format within 0-1 range, for example: 0.2 0.4
                0.1</tr>
            </property>
            <!-- @label_inner -->
            <property name="@label_inner" type="bool" default="0">
                <tr lang="en">label position (1 - inner, 0 - outer).</tr>
            </property>
            <!-- @label_margins -->
            <property name="@label_margins" type="list" default="0 0">
                <tr lang="en">label offset in pixels</tr>
            </property>
            <!-- @label_side -->
            <property name="@label_side" type="symbol" enum="left top right bottom" default="top">
                <tr lang="en">label snap side</tr>
            </property>
            <!-- @label_valign -->
            <property name="@label_valign" type="symbol" enum="top center bottom" default="top">
                <tr lang="en">label vertical align</tr>
            </property>
            <!-- @nh_color -->
            <property name="@nh_color" type="list" default="0 0 1 1">
                <tr lang="en">negative harmonics color</tr>
            </property>
            <!-- @order -->
            <property name="@order" type="int" minvalue="1" maxvalue="63" default="1">
                <tr lang="en">the order of decomposition</tr>
            </property>
            <!-- @ph_color -->
            <property name="@ph_color" type="list" default="1 0 0 1">
                <tr lang="en">positive harmonics color</tr>
            </property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="0">
                <tr lang="en">pin mode. if 1 - put element to the lowest level</tr>
            </property>
            <!-- @refresh -->
            <property name="@refresh" type="int" default="100" minvalue="20" maxvalue="1000"
            units="millisecond">
                <tr lang="en">redraw time</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="120 120">
                <tr lang="en">element size (width, height pair)</tr>
            </property>
            <!-- @view -->
            <property name="@view" type="float" default="0">
                <tr lang="en">view rotation</tr>
            </property>
        </properties>
        <methods>
            <!-- dump -->
            <method name="dump">dumps all object info to Pd console window.</method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
        </methods>
        <inlets dynamic="true">
            <inlet type="audio">
                <xinfo>first input harmonic</xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>... input harmonic</xinfo>
            </inlet>
            <inlet type="audio" number="n">
                <xinfo>n-th input harmonic</xinfo>
            </inlet>
        </inlets>
        <example>
            <pdascii>
<![CDATA[
[osc.square~ 0.15]      [phasor~ 0.15]
|                       |
[ui.gain~ @size 120 14] [phase->rad~]
|                       |.
[hoa.encoder~ 5 {w=17,i=11,o=11}]
*|*
[hoa.scope~ 5 {i=11}]








[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
