#N canvas 0 0 785 555 12;
#X declare -lib ceammc;
#X obj 559 50 cnv 1 206 23 empty empty empty 17 7 0 10 -245760 -1 0;
#X text 559 50 A complex echo-like effect;
#X obj 1 1 cnv 5 765 40 empty empty fx.greyhole~ 20 20 0 20 -104026
-4096 0;
#X obj 652 11 fx.greyhole~;
#X obj 210 80 cnv 1 555 120 empty empty empty 17 7 0 10 -257983 -1 0;
#X text 215 80 A complex echo-like effect \, inspired by the classic
Eventide effect of a similar name. The effect consists of a diffuser
(like a mini-reverb \, structurally similar to the one used in JPverb)
connected in a feedback system with a long \, modulated delay-line.
Excels at producing spacey washes of sound.;
#X text 215 165 Developed as part of the DEIND project.;
#X msg 50 228 1000 1000 0 \, 300 300 1000 \, 3000 500 1300 \, 0 100 1400;
#X obj 50 257 vline~;
#X obj 50 286 osc.saw~;
#X obj 50 315 fx.greyhole~;
#X obj 213 315 ui.hsl;
#X obj 50 358 *~;
#X obj 126 358 *~;
#X obj 50 401 dac~;
#X obj 20 451 cnv 1 745 1 empty empty empty 17 7 0 10 -203890 -1 0;
#X obj 20 456 cnv 5 81 25 empty empty свойства: 4 12 0 14 -262144
-49933 0;
#X obj 735 459 ui.link @background_color 0.98039 0.98039 0.98039
@title [?] @url ceammc.props-info.pd;
#X msg 110 491 @id;
#X text 245 491 (при инициализации) Получить/Установить OSC address
id. If specified \, bind all properties to /ID/fx_greyhole/PROP_NAME
osc address \, if empty bind to /fx_greyhole/PROP_NAME. Тип: symbol.;
#X msg 110 563 @osc;
#X text 245 563 (при инициализации) Получить/Установить OSC server
name to listen. Тип: symbol.;
#X msg 110 605 @active;
#X text 245 605 Turn on/off dsp processing. Тип: bool. Значение по
умолчанию: 1\.;
#X msg 110 647 @bypass;
#X text 245 647 Получить/Установить bypass flag. If true: bypass 'effected'
signal. Тип: bool. Значение по умолчанию: 0\.;
#X msg 110 689 @damping;
#X text 245 689 Получить/Установить controls damping of high-frequencies
as the delay decays. 0 is no damping \, 1 is very strong damping. Тип:
float. Значение по умолчанию: 0\. Диапазон: 0\...0.99\.;
#X msg 110 746 @delaytime;
#X text 245 746 Получить/Установить approximate delay time in seconds.
Тип: float. Единицы: 'sec'. Значение по умолчанию: 0.2\. Диапазон:
0.001\...1.45\.;
#X msg 110 803 @diffusion;
#X text 245 803 Получить/Установить shape of the diffusion unit. Values
greater than 0.707 produce smooth exponential decay. Lower values produce
a slower build-up of echoes. Тип: float. Значение по умолчанию: 0.5\.
Диапазон: 0\...0.99\.;
#X msg 110 875 @drywet;
#X text 245 875 Получить/Установить proportion of mix between the original
(dry) and 'effected' (wet) signals. 0 - dry signal \, 1 - wet. Тип:
float. Значение по умолчанию: 1\. Диапазон: 0\...1\.;
#X msg 110 932 @feedback;
#X text 245 932 Получить/Установить amount of feedback for the delay
line. Тип: float. Значение по умолчанию: 0.9\. Диапазон: 0\...1\.;
#X msg 110 974 @moddepth;
#X text 245 974 Получить/Установить depth of delay-line modulation.
Use in combination with *@modfreq* to set amount of chorusing within
the structure. Тип: float. Значение по умолчанию: 0.1\. Диапазон: 0\...1\.;
#X msg 110 1046 @modfreq;
#X text 245 1046 Получить/Установить frequency of delay-line modulation.
Use in combination with *@moddepth* to set amount of chorusing within
the structure. Тип: float. Значение по умолчанию: 2\. Диапазон: 0\...10\.;
#X msg 110 1118 @size;
#X text 245 1118 Получить/Установить size of delay-lines within the
diffusion unit \, producing the impression of a larger or smaller space.
Values below 1 can sound quite metallic. Тип: float. Значение по умолчанию:
1\. Диапазон: 0.5\...3\.;
