#X msg 110 631 @osc;
#X text 245 631 (при инициализации) Получить/Установить OSC server
name to listen. Тип: symbol.;
#X msg 110 673 @active;
#X text 245 673 Turn on/off dsp processing. Тип: bool. Значение по
умолчанию: 1\.;
#X msg 110 715 @bypass;
#X text 245 715 Получить/Установить bypass flag. If true: bypass 'effected'
signal. Тип: bool. Значение по умолчанию: 0\.;
#X msg 110 757 @control;
#X text 245 757 Получить/Установить envelope follower to pitch shifter
influence coefficient. Тип: float. Значение по умолчанию: 0.5\. Диапазон:
0\...1\.;
#X msg 110 814 @damp_hf;
#X text 245 814 Получить/Установить Frequency (Hz) at which the high-frequency
