<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.mouse_filter">
    <title>ui.mouse_filter</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">filter mouse events from UI objects</tr>
        <tr lang="ru">фильтр событий мыши из UI объектов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui mouse filter events</keywords>
      <since>0.8</since>
      <aliases>
        <alias>ui.mf</alias>
      </aliases>
      <also>
        <see>ui.mouse_route</see>
        <see view="link">ui.rslider</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">pass only specified mouse events from ui.* objects</tr>
        <tr lang="ru" finished="false">передавать только определенные события мыши из объектов
        ui.*</tr>
      </par>
    </info>
    <properties>
      <!-- @down -->
      <property name="@down" type="alias" default="0">
        <tr lang="en">alias to @mouse_down 1 property</tr>
        <tr lang="ru" finished="false">Оригинальное название: @mouse_down 1 Property</tr>
      </property>
      <!-- @drag -->
      <property name="@drag" type="alias" default="0">
        <tr lang="en">alias to @mouse_drag 1 property</tr>
        <tr lang="ru" finished="false">Оригинальное название: @mouse_drag 1 Property</tr>
      </property>
      <!-- @enter -->
      <property name="@enter" type="alias" default="0">
        <tr lang="en">alias to @mouse_enter 1 property</tr>
        <tr lang="ru" finished="false">Оригинальное название: @mouse_enter 1 Property</tr>
      </property>
      <!-- @leave -->
      <property name="@leave" type="alias" default="0">
        <tr lang="en">alias to @mouse_leave 1 property</tr>
        <tr lang="ru" finished="false">Оригинальное название: @mouse_leave 1 Property</tr>
      </property>
      <!-- @mouse_down -->
      <property name="@mouse_down" type="bool" default="0">
        <tr lang="en">passing a @mouse_down events</tr>
        <tr lang="ru" finished="false">Прохождение @mouse_down</tr>
      </property>
      <!-- @mouse_drag -->
      <property name="@mouse_drag" type="bool" default="0">
        <tr lang="en">passing a @mouse_drag events</tr>
        <tr lang="ru" finished="false">Обсуждение @mouse_drag</tr>
      </property>
      <!-- @mouse_enter -->
      <property name="@mouse_enter" type="bool" default="0">
        <tr lang="en">passing a @mouse_enter events</tr>
        <tr lang="ru" finished="false">Прохождение @mouse_enter</tr>
      </property>
      <!-- @mouse_leave -->
      <property name="@mouse_leave" type="bool" default="0">
        <tr lang="en">passing a @mouse_leave events</tr>
        <tr lang="ru" finished="false">Обсуждение @mouse_leave</tr>
      </property>
      <!-- @mouse_move -->
      <property name="@mouse_move" type="bool" default="0">
        <tr lang="en">passing a @mouse_move events</tr>
        <tr lang="ru" finished="false">Обсуждение @mouse_move</tr>
      </property>
      <!-- @mouse_up -->
      <property name="@mouse_up" type="bool" default="0">
        <tr lang="en">passing a @mouse_up events</tr>
        <tr lang="ru" finished="false">Прохождение @mouse_up</tr>
      </property>
      <!-- @move -->
      <property name="@move" type="alias" default="0">
        <tr lang="en">alias to @mouse_move 1 property</tr>
        <tr lang="ru" finished="false">Оригинальное название: @mouse_move 1 Property</tr>
      </property>
      <!-- @up -->
      <property name="@up" type="alias" default="0">
        <tr lang="en">alias to @mouse_up 1 property</tr>
        <tr lang="ru" finished="false">Оригинальное название: @mouse_up 1 Property</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input messages from ui object</tr>
          <tr lang="ru" finished="false">Входные сообщения от ui object</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">passed messages from ui object</tr>
          <tr lang="ru" finished="false">Переданные сообщения от объекта ui</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.rslider @mouse_events 1] [ui.rslider @mouse_events 1]
|                            |
[ui.mouse_filter @up]        [ui.mouse_filter @drag]
|                            |
[ui.display @display_type 1] [ui.display @display_type 1]

[ui.rslider @mouse_events 1]
|
[ui.mouse_filter @down]
|
[ui.display @display_type 1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
