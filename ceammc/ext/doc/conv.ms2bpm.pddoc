<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.ms2bpm">
    <title>conv.ms2bpm</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts period in milliseconds to BPM tempo</tr>
        <tr lang="ru">преобразует период в миллисекундах в темп BPM</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv time</keywords>
      <also>
        <see>conv.bpm2sec</see>
        <see>conv.sec2bpm</see>
      </also>
      <since>0.9.11</since>
      <aliases>
        <alias>ceammc/ms-&gt;bpm</alias>
        <alias>ms-&gt;bpm</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts a period in milliseconds (the time between two
        consecutive beats) to a BPM tempo. The conversion is simply 60000 / period_ms, but the
        object makes the patch more readable and self-documenting. This is the inverse operation of
        [conv.bpm2ms].</tr>
        <tr lang="ru">Объект преобразует период в миллисекундах (время между двумя последовательными
        ударными долями) в темп BPM. Преобразование сводится к 60000 / период_мс, но объект делает
        патч более читаемым и самодокументируемым. Это операция, обратная [conv.bpm2ms].</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">period in milliseconds</tr>
          <tr lang="ru">период в миллисекундах</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">tempo in BPM</tr>
          <tr lang="ru">темп в BPM</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[1000( [500(
|      |
[ms->bpm]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
