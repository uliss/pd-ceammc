<?xml version='1.0' encoding='utf-8'?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="hw.rpi.i2c.pca9685">
        <title>hw.rpi.i2c.pca9685</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>PCA9685: 16 Channel 12 Bit PWM Servo Driver for Raspberry Pi</description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display pwm raspberry servo</keywords>
            <since>0.9.8</since>
            <aliases>
                <alias>hw.rpi.pwm.pca9685</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="I2C_BUS" type="atom">See @i2c_bus property</argument>
        </arguments>
        <properties>
            <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none"
            access="initonly">I²C bus</property>
            <property name="@i2c_addr" type="int" default="-1" minvalue="-2" maxvalue="119"
            access="initonly">I²C address. If equal -1, use first</property>
        </properties>
        <methods>
            <!-- const -->
            <method name="const">set channel constant value 
            <param name="CHAN" type="int" minvalue="0" maxvalue="16" required="true">device PWM
            channel. If equals to 16 means all channels</param>
            <param name="VALUE" type="bool" required="true">value</param>
            <param name="DELAY" type="float" required="false" minvalue="0" maxvalue="1">the setting
            is delayed by the given phase value.</param></method>
            <!-- duty -->
            <method name="duty">set channel PWM duty cycle 
            <param name="CHAN" type="int" minvalue="0" maxvalue="16" required="true">device PWM
            channel. If equals to 16 means all channels</param>
            <param name="DUTY" type="float" required="true" minvalue="-1" maxvalue="1">duty cycle
            value</param>
            <param name="PHASE" type="float" required="false" minvalue="-1" maxvalue="1">phase
            offset</param></method>
            <!-- enable -->
            <method name="enable">enable/disable the device 
            <param name="STATE" type="bool" default="1">new state</param></method>
            <!-- freq -->
            <method name="freq">set PWM frequency 
            <param name="FREQ" type="float" units="hertz" required="true" minvalue="24"
            maxvalue="2048">new frequency</param></method>
            <!-- period -->
            <method name="period">set PWM period 
            <param name="PERIOD" type="float" units="millisecond" required="true" minvalue="0.5"
            maxvalue="40">new frequency</param></method>
            <!-- polarity -->
            <method name="polarity">set PWM inversed polarity 
            <param name="POLARITY" type="bool" required="true">polarity value: 0 - direct, 1 -
            inversed</param></method>
            <!-- set raw -->
            <method name="set_raw">set channel raw PWM frequency 
            <param name="CHAN" type="int" minvalue="0" maxvalue="16" required="true">device PWM
            channel. If equals to 16 means all channels</param>
            <param name="ON" type="int" minvalue="0" maxvalue="4095" required="true">ON counter
            time value</param>
            <param name="OFF" type="int" minvalue="0" maxvalue="4095" required="true">OFF counter
            time value</param></method>
            <!-- pwidth -->
            <method name="pwidth">set channel PWM pulse width 
            <param name="CHAN" type="int" minvalue="0" maxvalue="16" required="true">device PWM
            channel. If equals to 16 means all channels</param>
            <param name="WIDTH" type="float" required="true" minvalue="0.5" maxvalue="40"
            units="millisecond">pulse width</param>
            <param name="PHASE" type="float" required="false" minvalue="0" maxvalue="1">phase
            offset</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>control input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>control output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[loadbang]
|
[hw.rpi.pwm.pca9685 default]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
