<?xml version='1.0' encoding='utf-8'?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="hw.rpi.i2c.pca9685">
        <title>hw.rpi.i2c.pca9685</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>PCA9685: 16 Channel 12 Bit PWM Servo Driver for Raspberry Pi</description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display pwm raspberry servo</keywords>
            <since>0.9.8</since>
            <aliases>
                <alias>hw.rpi.pwm.pca9685</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="I2C_BUS" type="atom">See @i2c_bus property</argument>
        </arguments>
        <properties>
            <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none" access="initonly">I²C bus</property>
            <property name="@i2c_addr" type="int" default="-1" minvalue="-2" maxvalue="119" access="initonly">I²C address. If equal -1, use first</property>
        </properties>
        <methods>
            <method name="period">method</method>
            <method name="set_raw">method</method>
            <method name="freq">method</method>
            <method name="const">method</method>
            <method name="duty">method</method>
            <method name="width">method</method>
            <method name="enable">method</method>
            <method name="polarity">method</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>control input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>control output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[loadbang]
|
[hw.rpi.pwm.pca9685 default]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
