<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="hw.rpi.i2c.pca9685">
        <title>hw.rpi.i2c.pca9685</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">driver for 16-channel 12-bit PWM module on PCA9685 chip for Raspberry
                Pi</tr>
                <tr lang="ru">драйвер для 16-канального 12-битного ШИМ модуля на чипе PCA9685 для
                Raspberry Pi</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display pwm raspberry servo</keywords>
            <since>0.9.8</since>
            <aliases>
                <alias>hw.rpi.pwm.pca9685</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: default PWM freq is 50Hz</tr>
            </par>
            <par>
                <tr lang="en">*Servo Control*</tr>
            </par>
            <par>
                <tr lang="en">Many digital servos run on a 20ms pulse width (50Hz update frequency)
                based duty cycle, and do not utilize the entire pulse width for their control</tr>
            </par>
            <par>
                <tr lang="en">Typically, 2.5% of the 20ms pulse width (0.5ms) represents -90°
                offset, and 12.5% of the 20ms pulse width (2.5ms) represents +90° offset</tr>
            </par>
            <par>
                <tr lang="en">Be aware that driving some 180° servos too far past their -90°/+90°
                operational range can cause a little plastic limiter pin to break off and get stuck
                inside of the servo's gearing, which could potentially cause the servo to become
                jammed and no longer function</tr>
            </par>
            <par>
                <tr lang="en">Continuous servos operate in much the same fashion as 180° servos,
                but instead of the 2.5%/12.5% pulse width controlling a -90°/+90° offset it
                controls a -1x/+1x speed multiplier, with 0x being parked/no-movement and -1x/+1x
                being maximum speed in either direction.</tr>
            </par>
        </info>
        <arguments>
            <argument name="I2C_BUS" type="atom" enum="1 2 3 4 5 6 default none">
                <tr lang="en">See @i2c_bus property</tr>
                <tr lang="ru">См. @i2c_bus свойство</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @i2c_addr -->
            <property name="@i2c_addr" type="int" default="-1" minvalue="-4" maxvalue="119"
            access="initonly">
                <tr lang="en">I²C address. Also 'default' value is accepted (for addr 0x40)</tr>
                <tr lang="ru" finished="false">Адрес I²C. Также принимается значение «default» (для
                адреса 0x40)</tr>
            </property>
            <!-- @i2c_bus -->
            <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none"
            access="initonly">
                <tr lang="en">I²C bus</tr>
                <tr lang="ru" finished="false">шина I²C</tr>
            </property>
        </properties>
        <methods>
            <!-- const -->
            <method name="const">
                <info>
                    <tr lang="en">set channel constant value</tr>
                </info>
                <param name="CHAN" type="int" minvalue="0" maxvalue="16" required="true">
                    <tr lang="en">device PWM channel. If equals to 16 means all channels</tr>
                </param>
                <param name="VALUE" type="bool" required="true">
                    <tr lang="en">value</tr>
                </param>
                <param name="DELAY" type="float" required="false" minvalue="0" maxvalue="1">
                    <tr lang="en">the setting is delayed by the given phase value.</tr>
                </param>
            </method>
            <!-- disable_prog_addr -->
            <method name="disable_prog_addr">
                <info>
                    <tr lang="en">disable of using programmable address</tr>
                </info>
                <param name="TYPE" type="atom" enum="1 2 3 all" required="true">
                    <tr lang="en">prog address type</tr>
                </param>
            </method>
            <!-- duty -->
            <method name="duty">
                <info>
                    <tr lang="en">set channel PWM duty cycle</tr>
                </info>
                <param name="CHAN" type="int" minvalue="0" maxvalue="16" required="true">
                    <tr lang="en">device PWM channel. If equals to 16 means all channels</tr>
                </param>
                <param name="DUTY" type="float" required="true" minvalue="-1" maxvalue="1">
                    <tr lang="en">duty cycle value</tr>
                </param>
                <param name="PHASE" type="float" required="false" minvalue="-1" maxvalue="1">
                    <tr lang="en">phase offset</tr>
                </param>
            </method>
            <!-- enable -->
            <method name="enable">
                <info>
                    <tr lang="en">enable/disable the device. The disabled state is equal to sleep,
                    the device is keeping all current PWM setting, but just not responds to the new
                    settings.</tr>
                </info>
                <param name="STATE" type="bool" default="1">
                    <tr lang="en">new state</tr>
                </param>
            </method>
            <!-- enable_restart_and_disable -->
            <method name="enable_restart_and_disable">
                <info>
                    <tr lang="en">put the controller to sleep while keeping the PWM register
                    contents in preparation for a future restart</tr>
                </info>
            </method>
            <!-- freq -->
            <method name="freq">
                <info>
                    <tr lang="en">set PWM frequency</tr>
                </info>
                <param name="FREQ" type="float" units="hertz" required="true" minvalue="24"
                maxvalue="2048">
                    <tr lang="en">new frequency</tr>
                </param>
            </method>
            <!-- period -->
            <method name="period">
                <info>
                    <tr lang="en">set PWM period</tr>
                </info>
                <param name="PERIOD" type="float" units="millisecond" required="true"
                minvalue="0.5" maxvalue="40">
                    <tr lang="en">new frequency</tr>
                </param>
            </method>
            <!-- polarity -->
            <method name="polarity">
                <info>
                    <tr lang="en">set PWM inversed polarity. Applicable when OE = 0.</tr>
                </info>
                <param name="POLARITY" type="bool" required="true">
                    <tr lang="en">polarity value: 0 - direct, 1 - inversed</tr>
                </param>
            </method>
            <!-- pwidth -->
            <method name="pwidth">
                <info>
                    <tr lang="en">set channel PWM pulse width</tr>
                </info>
                <param name="CHAN" type="int" minvalue="0" maxvalue="16" required="true">
                    <tr lang="en">device PWM channel. If equals to 16 means all channels</tr>
                </param>
                <param name="WIDTH" type="float" required="true" minvalue="0.5" maxvalue="40"
                units="millisecond">
                    <tr lang="en">pulse width</tr>
                </param>
                <param name="PHASE" type="float" required="false" minvalue="0" maxvalue="1">
                    <tr lang="en">phase offset</tr>
                </param>
            </method>
            <!-- restart -->
            <method name="restart">
                <info>
                    <tr lang="en">re-enable the controller after a sleep with restart enabled so
                    that previously active PWM channels are restarted</tr>
                </info>
            </method>
            <!-- set_raw -->
            <method name="set_raw">
                <info>
                    <tr lang="en">set channel raw PWM frequency</tr>
                </info>
                <param name="CHAN" type="int" minvalue="0" maxvalue="16" required="true">
                    <tr lang="en">device PWM channel. If equals to 16 means all channels</tr>
                </param>
                <param name="ON" type="int" minvalue="0" maxvalue="4095" required="true">
                    <tr lang="en">ON counter time value</tr>
                </param>
                <param name="OFF" type="int" minvalue="0" maxvalue="4095" required="true">
                    <tr lang="en">OFF counter time value</tr>
                </param>
            </method>
            <!-- use_prog_addr -->
            <method name="use_prog_addr">
                <info>
                    <tr lang="en">set and use programmable address</tr>
                </info>
                <param name="TYPE" type="atom" enum="1 2 3 all" required="true">
                    <tr lang="en">prog address type</tr>
                </param>
                <param name="I2C_ADDR" type="int" required="true" minvalue="7" maxvalue="119">
                    <tr lang="en">new I²C address</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">control input</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>control output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
/*180° servo example*/

[T]
|
[enable $1(
|
| [ui.hsl]
| |
| [l->l 0 1 0.5 2.5]
| |
| [clip 0.5 2.5]
| |
| [pwidth 0 $1(
| |
| |
[hw.rpi.pwm.pca9685 default]

[ui.link @url=ceammc://img/conn_pca9685.png @title='Connection_scheme']

[ui.link @url=ceammc://img/info_pca9685.jpg @title='Address']
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
