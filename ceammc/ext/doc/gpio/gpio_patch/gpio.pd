#N canvas 0 0 800 500 12;
#X obj 200 10 ui.label Raspberry Pi GPIO;
#X obj 600 30 ui.b @label "Reset\ All" @background_color 1 0 0 @size
40 40;
#X msg 600 80 0;
#X obj 600 105 s \$0-all-menu;
#X obj 350 500 loadmsg 0;
