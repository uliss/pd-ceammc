<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.e">
        <title>math.e</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">mathematical constant, base of the natural logarithm</tr>
                <tr lang="ru">математическая константа, основание натурального логарифма</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math e</keywords>
            <also>
                <see>math.pi</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">It is approximately equal to 2.71828, and is the limit of (1 + 1/n)^n
                as n approaches infinity.</tr>
                <!-- old: Она приблизительно равна 2,71828 и является пределом
                (1 + 1/n)^n по мере приближения n к бесконечности. -->
                <tr lang="ru" finished="false">Она приблизительно равна 2,71828 и является пределом
                (1 + 1/n)^n по мере приближения n к бесконечности.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">outputs value</tr>
                    <tr lang="ru" finished="false">выходная стоимость</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output value</tr>
                    <tr lang="ru" finished="false">выходная стоимость</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[math.e]
|
[floatatom digits=10]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
