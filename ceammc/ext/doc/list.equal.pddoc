<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.equal">
        <title>list.equal</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">list equal check</tr>
                <tr lang="ru">проверка списков на равенство</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list compare equal</keywords>
            <since>0.1</since>
        </meta>
        <arguments>
            <argument name="PATTERN" type="list">
                <tr lang="en">initial value</tr>
                <tr lang="ru" finished="false">начальное значение</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @pattern -->
            <property name="@pattern" type="list" default="">
                <tr lang="en">current pattern</tr>
                <tr lang="ru" finished="false">Текущая модель</tr>
            </property>
        </properties>
        <methods>
            <!-- dump -->
            <method name="dump">
                <info>
                    <tr lang="en">dumps object state to PD console window</tr>
                    <tr lang="ru" finished="false">Сброс состояния объекта в окно консоли PD</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">First list</tr>
                    <tr lang="ru" finished="false">Первый список</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">First list</tr>
                    <tr lang="ru" finished="false">Первый список</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">Second list</tr>
                    <tr lang="ru" finished="false">Второй список</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">"1" if lists are equal, "0" otherwise</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3(  [list a b c(
|        |
|        |   [1 2 3( [list a b c(
|        |   |       |
|        |   |       |   [dump( [@pattern?(
|        |   |       |   |      |
|        |   |.      |.  |      |
[list.equal                a b c]
|     |
[F]   [print]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
