<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="list.length">
    <title>list.length</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">output the number of elements in the list</tr>
        <tr lang="ru">выводит количество элементов в списке</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>list</category>
      <keywords>list length size</keywords>
      <since>0.1</since>
      <also>
        <see>list.at</see>
      </also>
      <aliases>
        <alias>list.size</alias>
      </aliases>
    </meta>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">the list</tr>
          <tr lang="ru">список</tr>
        </in>
        <in on="data:mlist">
          <tr lang="en">the multi-level list (MList)</tr>
          <tr lang="ru">многоуровневый список (MList)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">the number of elements in the list</tr>
          <tr lang="ru">количество элементов в списке</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[list #a(   [\("a list" "of two elements"\), bang(
            |
            [ml #b]

 [1 2( [F]  [list 1 #c(
 |     |
 |     |
[list.length #x]
|
[ui.dt]
[X a->x] [X b->x] [X c->x]
#a a b c
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
