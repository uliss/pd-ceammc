<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fx.echo2~">
    <title>fx.echo2~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">stereo echo effect</tr>
        <tr lang="ru">стерео эхо-эффект</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>fx</category>
      <keywords>fx echo stereo delay</keywords>
      <since>0.9.4</since>
      <also>
        <see>fx.echo2~</see>
        <see>fx.sdelay~</see>
      </also>
    </meta>
    <arguments>
      <argument name="DELAY" type="float" minvalue="10" maxvalue="5000" units="millisecond">
        <tr lang="en">echo time</tr>
        <tr lang="ru" finished="false">время эхо</tr>
      </argument>
      <argument name="FEEDBACK" type="float" minvalue="0" maxvalue="0.99">
        <tr lang="en">feedback coefficient</tr>
        <tr lang="ru" finished="false">коэффициент обратной связи</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
        <!-- old: Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал. -->
        <tr lang="ru" finished="false">Обходной флаг. Если это правда, обойдите «эффективный»
        сигнал.</tr>
      </property>
      <!-- @delay -->
      <property name="@delay" type="float" minvalue="10" maxvalue="5000" units="millisecond"
      default="500">
        <tr lang="en">echo time</tr>
        <tr lang="ru" finished="false">время эхо</tr>
      </property>
      <!-- @drywet -->
      <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="1">
        <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet) signals. 0
        - dry signal, 1 - wet</tr>
        <!-- old: пропорция смеси между исходными (сухими) и
                "влажными" сигналами. 0 - сухой сигнал, 1 - влажный -->
        <tr lang="ru" finished="false">пропорция смеси между исходными (сухими) и "влажными"
        сигналами. 0 - сухой сигнал, 1 - влажный</tr>
      </property>
      <!-- @feedback -->
      <property name="@feedback" type="float" minvalue="0" maxvalue="0.99" default="0.3">
        <tr lang="en">feedback coefficient</tr>
        <tr lang="ru" finished="false">коэффициент обратной связи</tr>
      </property>
      <!-- @stereo -->
      <property name="@stereo" type="float" minvalue="0" maxvalue="1" default="1">
        <tr lang="en">The stereo parameter controls the amount of stereo spread. For stereo=0 you
        get a plain delay, without crosstalk between the channels. For stereo=1 you get a pure
        ping-pong delay where the echos from the left first appear on the right channel and vice
        versa</tr>
        <!-- old: Стереопараметр контролирует количество
                стереораспространения. Для стерео=0 вы получаете простую задержку, без перекрестных
                разговоров между каналами. Для стерео=1 вы получаете чистую задержку пинг-понга,
                когда эхо слева сначала появляется на правом канале и наоборот. -->
        <tr lang="ru" finished="false">Стереопараметр контролирует количество
        стереораспространения. Для стерео=0 вы получаете простую задержку, без перекрестных
        разговоров между каналами. Для стерео=1 вы получаете чистую задержку пинг-понга, когда эхо
        слева сначала появляется на правом канале и наоборот.</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset to initial state</tr>
          <tr lang="ru" finished="false">Перезагрузка в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">left input signal</tr>
          <tr lang="ru" finished="false">левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">right input signal</tr>
          <tr lang="ru" finished="false">правильный входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left output signal</tr>
          <tr lang="ru" finished="false">левый выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right output signal</tr>
          <tr lang="ru" finished="false">правильный выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env]
|
[readsf~]  [ui.hsl @show_value 1]
|          |
|          [@stereo $1(
|          |
[fx.echo2~ 500 0.3]
*|*
[ui.gain2~ @size 120 16]  [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
