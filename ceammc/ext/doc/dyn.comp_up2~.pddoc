<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="dyn.comp_up2~">
        <title>dyn.comp_up2~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">stereo upward compressor with channel linking</tr>
                <tr lang="ru">восходящий стерео-компрессор со связью каналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>dyn</category>
            <keywords>compressor</keywords>
            <since>0.9.7</since>
            <also>
                <see>dyn.comp_up~</see>
                <see>dyn.comp_peak2~</see>
            </also>
            <aliases>
                <alias>comp.up2~</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">It uses a strength parameter instead of the traditional ratio, in
                order to be able to function as a hard limiter or overcompressor</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Dynamic_range_compression">Dynamic range
            compression</a>
        </info>
        <arguments>
            <argument name="STRENGTH" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">compression strength (0: no compression, 1: increase level by @range
                db)</tr>
                <tr lang="ru">сила компрессии (0: без компрессии, 1: повышение уровня на @range
                децибел)</tr>
            </argument>
            <argument name="THRESHOLD" type="float" minvalue="-60" maxvalue="0" units="decibel">
                <tr lang="en">level threshold above which compression kicks in</tr>
                <tr lang="ru">пороговый уровень, ниже которого начинается компрессия</tr>
            </argument>
            <argument name="ATTACK" type="float" units="millisecond" minvalue="0.1" maxvalue="100">
                <tr lang="en">attack time = time constant when level &amp; compression going
                up</tr>
                <tr lang="ru" finished="false">время атаки - время начала компрессии после
                установления уровня ниже порогового уровня</tr>
            </argument>
            <argument name="RELEASE" type="float" units="millisecond" minvalue="1" maxvalue="500">
                <tr lang="en">release time = time constant coming out of compression</tr>
                <tr lang="ru">время спада - время выхода из компрессии после превышения порогового
                уровня</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @attack -->
            <property name="@attack" type="float" units="millisecond" default="10" minvalue="0.1"
            maxvalue="100">
                <tr lang="en">time constant when level &amp; compression going up</tr>
            </property>
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
            </property>
            <!-- @hold -->
            <property name="@hold" type="float" units="sample" default="128" minvalue="1"
            maxvalue="255">
                <tr lang="en">hold period</tr>
            </property>
            <!-- @knee -->
            <property name="@knee" type="float" units="decibel" default="3" minvalue="0"
            maxvalue="24">
                <tr lang="en">a gradual increase in gain reduction around the threshold: below
                thresh-(knee/2) there is no gain reduction, above thresh+(knee/2) there is the same
                gain reduction as without a knee, and in between there is a gradual increase in
                gain reduction</tr>
            </property>
            <!-- @level -->
            <property name="@level" type="float" units="decibel" default="0" minvalue="0"
            maxvalue="90" access="readonly">
                <tr lang="en">current level of compression</tr>
            </property>
            <!-- @link -->
            <property name="@link" type="float" default="1" minvalue="0" maxvalue="1">
                <tr lang="en">the amount of linkage between the channels: 0 = each channel is
                independent, 1 = all channels have the same amount of gain reduction</tr>
            </property>
            <!-- @range -->
            <property name="@range" type="float" units="decibel" default="12" minvalue="0"
            maxvalue="32">
                <tr lang="en">max upward compression range</tr>
            </property>
            <!-- @refresh -->
            <property name="@refresh" type="int" default="100" minvalue="0" maxvalue="1000"
            units="millisecond">
                <tr lang="en">compression level output time interval. If 0 - no output</tr>
            </property>
            <!-- @release -->
            <property name="@release" type="float" units="millisecond" default="50" minvalue="1"
            maxvalue="500">
                <tr lang="en">release time = time constant coming out of compression</tr>
            </property>
            <!-- @strength -->
            <property name="@strength" type="float" default="0" minvalue="0" maxvalue="1">
                <tr lang="en">compression strength (0: no compression, 1: increase level by @range
                db.)</tr>
            </property>
            <!-- @threshold -->
            <property name="@threshold" type="float" units="decibel" default="-32" minvalue="-60"
            maxvalue="0">
                <tr lang="en">level threshold above which compression kicks in (100 dB = max
                level)</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">left input signal</tr>
                </xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">right input signal</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">set compression strength</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">left output compressed signal</outlet>
            <outlet type="audio">right output compressed signal</outlet>
            <outlet>list: output current compression amount in db</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.hsl #a]  [ui.hsl #a]    [T]        [ui.hsl #a]
|            |              |          |
[dbfs->amp]  [dbfs->amp]    [@link $1( [@threshold $1(
|            |              |          |
[sig~]       [sig~]         [s up2     ]
|            |
|            |      [ui.knob @label STRENGTH @show_value 1]
|            |      |
| [r up2]    |      |
| |          |.     |..
[dyn.comp_up2~ 0 -60 10 100 #z]        [ui.dsp~]
|        ^|              ^^|
[env~]   [env~]          [unpack f f #p {o:2}]
|        |
[- 100]  [- 100]         [ui.hsl #ch1]
|        |
[F]      [F]             [ui.hsl #ch2]

#a -60 0 @show_value 1
#ch1 0 32 @active_scale 1 @show_value 1
#ch2 0 32 @active_scale 1 @show_value 1
[X p->ch1]
[X p:1->ch2]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
