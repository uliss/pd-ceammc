<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="random.discrete">
    <title>random.discrete</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">generate random weighted integers on the interval [0, n)</tr>
        <tr lang="ru">генерирует случайные взвешенные целые числа на интервале [0, n)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>random</category>
      <keywords>linear random discrete</keywords>
      <also>
        <see>random.linear</see>
        <see>random.pw_const</see>
      </also>
      <since>0.4</since>
    </meta>
    <info>
      <par>
        <tr lang="en">produces random integers on the interval [0, N), where the probability of
        each individual integer *i* is defined as Wⁱ/S, that is the weight of the i-th integer
        divided by the sum of all N weights</tr>
        <tr lang="ru">генерирует случайные целые числа на интервале [0, N), где вероятность каждого
        отдельного целого числа *i* определяется как Wⁱ/S, то есть вес i-го числа, делённый на
        сумму всех N весов</tr>
      </par>
      <par>
        <tr lang="en">use the @seed property to get reproducible sequences. If @seed is not set
        explicitly, a generator initialized with the current time is used</tr>
        <tr lang="ru">используйте свойство @seed для получения воспроизводимых последовательностей.
        Если @seed не задан явно, используется генератор, инициализированный текущим временем</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to generate weighted random choices, for example to
        pick notes with different probabilities or to simulate a loaded die</tr>
        <tr lang="ru">объект можно использовать для генерации взвешенных случайных выборов,
        например чтобы выбирать ноты с разной вероятностью или имитировать загруженную игральную
        кость</tr>
      </par>
    </info>
    <arguments>
      <argument name="WEIGHTS" type="list">
        <tr lang="en">weights (list of non-negative floats)</tr>
        <tr lang="ru">веса (список неотрицательных чисел)</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @seed -->
      <property name="@seed" type="int" minvalue="0" default="0">
        <tr lang="en">generator seed</tr>
        <tr lang="ru">начальное значение генератора</tr>
      </property>
      <!-- @weights -->
      <property name="@weights" type="list" default="">
        <tr lang="en">list of weights (non-negative floats)</tr>
        <tr lang="ru">список весов (неотрицательные числа)</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">generates a random number in the interval [0, N), where N is the number of
          weights</tr>
          <tr lang="ru">генерирует случайное число на интервале [0, N), где N — число весов</tr>
        </in>
        <in on="list">
          <tr lang="en">set new weights</tr>
          <tr lang="ru">задать новые веса</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">result value</tr>
          <tr lang="ru">значение результата</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                                          [array array1 size=9 yr=0..1]
|
[list.gen 1000]X[random.discrete 1 2 3 4 0 1 2 4 5]
|
[list.histogram @bins 9]
|
[list.normalize @range]
|
[list.enumerate @append]
|
[list.repack 2]
|
[tabwrite array1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
