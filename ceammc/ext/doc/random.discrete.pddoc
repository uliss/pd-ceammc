<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="random.discrete">
    <title>random.discrete</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">generate random weighted integers on the interval [0, n)</tr>
        <tr lang="ru">генерирует случайные взвешенные целые числа на интервале [0, n)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>random</category>
      <keywords>linear random discrete</keywords>
      <also>
        <see>random.linear</see>
        <see>random.pw_const</see>
      </also>
      <since>0.4</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Produces random integers on the interval [0, N), where the probability of
        each individual integer *i* defined as Wⁱ/S, that is the weight of the i-th integer divided
        by the sum of all N weights.</tr>
        <tr lang="ru" finished="false">Производит случайные целые числа на интервале [0, N], где
        вероятность каждого отдельного целого числа *i* определяется как Wi/S, то есть вес i-го
        целого числа, деленный на сумму всех N весов.</tr>
      </par>
      <par>
        <tr lang="en">Use @seed property to get reproducible sequences. If @seed property was not
        explicitly set or specified, uses generator initialized with current time.</tr>
        <tr lang="ru" finished="false">Используйте свойство @seed для получения воспроизводимых
        последовательностей. Если свойство @seed не было явно установлено или указано, используется
        генератор, инициализированный с текущим временем.</tr>
      </par>
    </info>
    <arguments>
      <argument name="WEIGHTS" type="list">
        <tr lang="en">weights (list of non-negative floats)</tr>
        <tr lang="ru" finished="false">Весы (список неотрицательных поплавков)</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @seed -->
      <property name="@seed" type="int" minvalue="0" default="0">
        <tr lang="en">generator seed</tr>
        <tr lang="ru" finished="false">генератор</tr>
      </property>
      <!-- @weights -->
      <property name="@weights" type="list" default="">
        <tr lang="en">list of weights (non-negative floats)</tr>
        <tr lang="ru" finished="false">Список весов (неотрицательные поплавки)</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">generates random number in interval [0, N), where N is number of
          weights.</tr>
          <tr lang="ru" finished="false">генерирует случайное число в интервале [0, N], где N —
          число весов.</tr>
        </in>
        <in on="list">
          <tr lang="en">set new weights</tr>
          <tr lang="ru" finished="false">установить новые весы</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">result value</tr>
          <tr lang="ru" finished="false">значение результата</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                                          [array array1 size=9 yr=0..1]
|
[list.gen 1000]X[random.discrete 1 2 3 4 0 1 2 4 5]
|
[list.histogram @bins 9]
|
[list.normalize @range]
|
[list.enumerate @append]
|
[list.repack 2]
|
[tabwrite array1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
