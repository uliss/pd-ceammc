<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="random.discrete">
        <title>random.discrete</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">generate random weighted integers on the interval [0, n)</tr>
                <tr lang="ru">генерирует случайные взвешенные целые числа на интервале [0, n)</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>random</category>
            <keywords>linear random discrete</keywords>
            <also>
                <see>random.linear</see>
                <see>random.pw_const</see>
            </also>
            <since>0.4</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Produces random integers on the interval [0, N), where the
                probability of each individual integer *i* defined as Wⁱ/S, that is the weight of
                the i-th integer divided by the sum of all N weights.</tr>
            </par>
            <par>
                <tr lang="en">Use @seed property to get reproducible sequences. If @seed property
                was not explicitly set or specified, uses generator initialized with current
                time.</tr>
            </par>
        </info>
        <arguments>
            <argument name="WEIGHTS" type="list">
                <tr lang="en">weights (list of non-negative floats)</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @seed -->
            <property name="@seed" type="int" minvalue="0" default="0">
                <tr lang="en">generator seed</tr>
            </property>
            <!-- @weights -->
            <property name="@weights" type="list" default="">
                <tr lang="en">list of weights (non-negative floats)</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">generates random number in interval [0, N), where N is number of
                weights.</xinfo>
                <xinfo on="list">set new weights</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]                                          [array array1 size=9 yr=0..1]
|
[list.gen 1000]X[random.discrete 1 2 3 4 0 1 2 4 5]
|
[list.histogram @bins 9]
|
[list.normalize @range]
|
[list.enumerate @append]
|
[list.repack 2]
|
[tabwrite array1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
