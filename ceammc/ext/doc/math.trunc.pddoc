<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.trunc">
        <title>math.trunc</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">truncate to integer value</tr>
                <tr lang="ru">усечение до целочисленного значения</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math trunc</keywords>
            <also>
                <see>math.ceil</see>
                <see>math.floor</see>
                <see>math.round</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Outputs the integral value nearest to but no larger in magnitude than
                x</tr>
                <tr lang="ru" finished="false">Выходит интегральное значение, близкое, но не
                большее по величине, чем x</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result signal</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(                 [array TRUNC yr=-4..4 w=320]
|
[list.seq -4 4 0.025]
|
[math.trunc]
|
[list->array TRUNC]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
