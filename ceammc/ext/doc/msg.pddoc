<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="msg">
        <title>msg</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">message constructor</tr>
                <tr lang="ru">конструктор сообщений</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>msg</category>
            <keywords>msg message</keywords>
            <aliases>
                <alias>ceammc/msg</alias>
                <alias>ceammc/m</alias>
                <alias>m</alias>
                <alias>ceammc/prepend</alias>
                <alias>prepend</alias>
            </aliases>
            <since>0.1</since>
        </meta>
        <arguments>
            <argument name="NAME" type="symbol">
                <tr lang="en">message selector</tr>
            </argument>
            <argument name="X" type="any">
                <tr lang="en">message content</tr>
            </argument>
        </arguments>
        <inlets>
            <inlet>
                <xinfo on="any">
                    <tr lang="en">appends all atoms to message content and outputs it</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">appends input list to message content and outputs it</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">appends float to message content and outputs it</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">appends symbol to message content and outputs it</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">change message selector</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">change message selector and first atoms</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>message output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]   [F]     [F]     [F]       [F]         [F]
|     |       |       |         |           |
[msg] [msg a] [msg 1] [msg 1 2] [msg a b c] [msg @a]
|     |       |       |         |           |
|     |       |       |         |           |
[ui.display                  @display_type 1]


[symbol A( [symbol A( [symbol A( [symbol A(
|          |          |          |
[msg]      [msg B]    [msg 1 2]  [msg a b c]
|          |          |          |
|          |          |          |
[ui.display                  @display_type 1]


[b c(  [b c(   [b c(   [b c(     [d e(       [b(
|      |       |       |         |           |
[msg]  [msg a] [msg 1] [msg 1 2] [msg a b c] [msg @a]
|      |       |       |         |           |
|      |       |       |         |           |
[ui.display                   @display_type 1]


[bang( [bang(  [bang(  [bang(    [bang(      [bang(
|      |       |       |         |           |
[msg]  [msg a] [msg 1] [msg 1 2] [msg a b c] [msg @a]
|      |       |       |         |           |
|      |       |       |         |           |
[ui.display                   @display_type 1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
