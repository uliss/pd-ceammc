<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="msg">
    <title>msg</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">message constructor</tr>
        <tr lang="ru">конструктор сообщений</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>msg</category>
      <keywords>msg message</keywords>
      <aliases>
        <alias>ceammc/msg</alias>
        <alias>ceammc/m</alias>
        <alias>m</alias>
        <alias>ceammc/prepend</alias>
        <alias>prepend</alias>
      </aliases>
      <since>0.1</since>
    </meta>
    <arguments>
      <argument name="NAME" type="symbol">
        <tr lang="en">message selector (name)</tr>
        <tr lang="ru">селектор сообщения (имя)</tr>
      </argument>
      <argument name="X" type="any">
        <tr lang="en">message content</tr>
        <tr lang="ru">содержимое сообщения</tr>
      </argument>
    </arguments>
    <inlets>
      <inlet>
        <in on="any">
          <tr lang="en">appends all elements to the message content and then outputs it</tr>
          <tr lang="ru">добавляет все элементы к содержимому сообщения и затем выводит его</tr>
        </in>
        <in on="list">
          <tr lang="en">appends all list elements to the message content and then outputs it</tr>
          <tr lang="ru">добавляет все элементы списка к содержимому сообщения и затем выводит
          его</tr>
        </in>
        <in on="float">
          <tr lang="en">appends a float number to the message content and then outputs it</tr>
          <tr lang="ru">добавляет число к содержимому сообщения и затем выводит его</tr>
        </in>
        <in on="symbol">
          <tr lang="en">appends a symbol to the message content and then outputs it</tr>
          <tr lang="ru">добавляет символ к содержимому сообщения и затем выводит его</tr>
        </in>
      </inlet>
      <inlet>
        <in on="symbol">
          <tr lang="en">changes the message selector</tr>
          <tr lang="ru">изменяет селектор сообщения</tr>
        </in>
        <in on="list">
          <tr lang="en">changes the message selector and the first atoms</tr>
          <tr lang="ru">изменяет селектор сообщения и первые элементы</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">message output</tr>
          <tr lang="ru">вывод сообщения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]   [F]     [F]     [F]       [F]         [F]
|     |       |       |         |           |
[msg] [msg a] [msg 1] [msg 1 2] [msg a b c] [msg @a]
|     |       |       |         |           |
|     |       |       |         |           |
[ui.display                  @display_type 1]


[symbol A( [symbol A( [symbol A( [symbol A(
|          |          |          |
[msg]      [msg B]    [msg 1 2]  [msg a b c]
|          |          |          |
|          |          |          |
[ui.display                  @display_type 1]


[b c(  [b c(   [b c(   [b c(     [d e(       [b(
|      |       |       |         |           |
[msg]  [msg a] [msg 1] [msg 1 2] [msg a b c] [msg @a]
|      |       |       |         |           |
|      |       |       |         |           |
[ui.display                   @display_type 1]


[bang( [bang(  [bang(  [bang(    [bang(      [bang(
|      |       |       |         |           |
[msg]  [msg a] [msg 1] [msg 1 2] [msg a b c] [msg @a]
|      |       |       |         |           |
|      |       |       |         |           |
[ui.display                   @display_type 1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
