<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="tl.timeline">
    <title>tl.timeline</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">timeline event scheduler</tr>
        <tr lang="ru">планировщик событий временной шкалы</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>tl</category>
      <keywords>timeline</keywords>
      <since>0.7</since>
      <also>
        <see view="link">tl.cue</see>
      </also>
      <aliases>
        <alias>ceammc/timeline</alias>
        <alias>timeline</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">With the timeline you can schedule your events and start, pause, stop or
        move time.</tr>
        <tr lang="ru">С помощью временной шкалы можно планировать события и запускать,
        приостанавливать, останавливать или перемещать время.</tr>
      </par>
      <par>
        <tr lang="en">The following time formats for events are supported: *clock format* —
        HH:MM:SS.MS, or value with a unit: 10 ms, 10 msec, 20 sec, 30.5s. Note: spaces are
        ignored.</tr>
        <tr lang="ru">Поддерживаются следующие форматы времени для событий: *clock format* —
        HH:MM:SS.MS, либо значение с единицей измерения: 10 ms, 10 msec, 20 sec, 30.5s. Примечание:
        пробелы игнорируются.</tr>
      </par>
      <par>
        <tr lang="en">An empty timeline always contains the "end" event, which cannot be removed.
        Events are referenced by name or by index. Negative indexes are supported: -1 means the
        last event (not the "end" event, but the last user event).</tr>
        <tr lang="ru">Пустая временная шкала всегда содержит событие "end", которое нельзя удалить.
        События адресуются по имени или по индексу. Поддерживаются отрицательные индексы: -1
        означает последнее событие (не событие "end", а последнее пользовательское
        событие).</tr>
      </par>
    </info>
    <arguments>
      <argument name="LENGTH" type="float" minvalue="0" units="second">
        <tr lang="en">timeline length</tr>
        <tr lang="ru">длительность временной шкалы</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @current -->
      <property name="@current" type="float" access="readonly" units="millisecond" default="0">
        <tr lang="en">current time</tr>
        <tr lang="ru">текущее время</tr>
      </property>
      <!-- @current_sec -->
      <property name="@current_sec" type="float" access="readonly" units="second" default="0">
        <tr lang="en">current time</tr>
        <tr lang="ru">текущее время</tr>
      </property>
      <!-- @events -->
      <property name="@events" type="list" access="readonly" default="end">
        <tr lang="en">list of event names in chronological order</tr>
        <tr lang="ru">список имён событий в хронологическом порядке</tr>
      </property>
      <!-- @is_running -->
      <property name="@is_running" type="bool" access="readonly" default="0">
        <tr lang="en">true if the timeline is running</tr>
        <tr lang="ru">истина, если временная шкала запущена</tr>
      </property>
      <!-- @length -->
      <property name="@length" type="float" minvalue="0" access="initonly" default="60"
      units="second">
        <tr lang="en">timeline length</tr>
        <tr lang="ru">длительность временной шкалы</tr>
      </property>
      <!-- @loop -->
      <property name="@loop" type="bool" default="0">
        <tr lang="en">loop mode</tr>
        <tr lang="ru">режим зацикливания</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" enum="fixed inf" default="fixed">
        <tr lang="en">timeline mode. If the timeline is fixed, it outputs the *end* event when
        reached and stops after that. An infinite timeline never stops by itself. A fixed timeline
        can have the @loop property set for repeats</tr>
        <tr lang="ru">режим временной шкалы. Если шкала фиксированная, по достижении конца она
        выводит событие *end* и после этого останавливается. Бесконечная шкала никогда не
        останавливается сама по себе. У фиксированной шкалы может быть установлено свойство
        @loop для повторов</tr>
      </property>
      <!-- @phase -->
      <property name="@phase" type="float" access="readonly" minvalue="0" maxvalue="1" default="0">
        <tr lang="en">current phase in the [0, 1) range</tr>
        <tr lang="ru">текущая фаза в диапазоне [0, 1)</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="int" access="readonly" default="1" minvalue="0">
        <tr lang="en">number of events in the timeline</tr>
        <tr lang="ru">число событий на временной шкале</tr>
      </property>
    </properties>
    <methods>
      <!-- add -->
      <method name="add">
        <info>
          <tr lang="en">adds an event to the timeline. You can use the simple syntax
          [add 10.1 sec( to create an event with a default name, or the advanced syntax:
          [add myEvent 510ms before end(</tr>
          <tr lang="ru">добавляет событие на временную шкалу. Можно использовать простой синтаксис
          [add 10.1 sec(, чтобы создать событие с именем по умолчанию, или расширенный:
          [add myEvent 510ms before end(</tr>
        </info>
        <param name="NAME" type="symbol" default="eventN" required="false">
          <tr lang="en">event name (if omitted, an autogenerated name is used: event1, event2
          etc.)</tr>
          <tr lang="ru">имя события (если не указано, используется автоматически сгенерированное
          имя: event1, event2 и т. д.)</tr>
        </param>
        <param name="TIME" type="list">
          <tr lang="en">event time: see the *info* section</tr>
          <tr lang="ru">время события: см. раздел *info*</tr>
        </param>
        <param name="relative" type="symbol" enum="before after" required="false">
          <tr lang="en">create a relative event before or after the target event</tr>
          <tr lang="ru">создать относительное событие до или после целевого события</tr>
        </param>
        <param name="REL_EVENT" type="symbol" required="false">
          <tr lang="en">relative event name</tr>
          <tr lang="ru">имя относительного события</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">removes all timeline events</tr>
          <tr lang="ru">удаляет все события с временной шкалы</tr>
        </info>
      </method>
      <!-- pause -->
      <method name="pause">
        <info>
          <tr lang="en">pauses the timeline at the current position</tr>
          <tr lang="ru">приостанавливает временную шкалу на текущей позиции</tr>
        </info>
      </method>
      <!-- remove -->
      <method name="remove">
        <info>
          <tr lang="en">removes an event by the given index or name: [remove event1( or
          [remove 3(</tr>
          <tr lang="ru">удаляет событие по указанному индексу или имени: [remove event1( или
          [remove 3(</tr>
        </info>
        <param name="NAME|IDX" type="atom">
          <tr lang="en">event name or index</tr>
          <tr lang="ru">имя события или индекс</tr>
        </param>
      </method>
      <!-- remove_at -->
      <method name="remove_at">
        <info>
          <tr lang="en">removes the event at the specified time</tr>
          <tr lang="ru">удаляет событие в указанное время</tr>
        </info>
        <param name="TIME" type="list">
          <tr lang="en">time in a supported format. See the *info* section</tr>
          <tr lang="ru">время в поддерживаемом формате. См. раздел *info*</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the timeline (call only when stopped)</tr>
          <tr lang="ru">сбрасывает временную шкалу (вызывать только когда остановлена)</tr>
        </info>
      </method>
      <!-- start -->
      <method name="start">
        <info>
          <tr lang="en">starts the timeline from the current position</tr>
          <tr lang="ru">запускает временную шкалу с текущей позиции</tr>
        </info>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stops the timeline and resets the current position to the beginning</tr>
          <tr lang="ru">останавливает временную шкалу и сбрасывает текущую позицию в начало</tr>
        </info>
      </method>
      <!-- to_event -->
      <method name="to_event">
        <info>
          <tr lang="en">moves time to the specified event</tr>
          <tr lang="ru">перемещает время к указанному событию</tr>
        </info>
        <param name="NAME|IDX" type="atom">
          <tr lang="en">event name or index</tr>
          <tr lang="ru">имя события или индекс</tr>
        </param>
      </method>
      <!-- to_time -->
      <method name="to_time">
        <info>
          <tr lang="en">moves time to the specified time</tr>
          <tr lang="ru">перемещает время к указанному моменту</tr>
        </info>
        <param name="TIME" type="list">
          <tr lang="en">time in a supported format. See the *info* section</tr>
          <tr lang="ru">время в поддерживаемом формате. См. раздел *info*</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">control inlet. A non-zero value starts the timeline, zero stops it.</tr>
          <tr lang="ru">управляющий вход. Ненулевое значение запускает временную шкалу, ноль —
          останавливает</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">list: event index, event name, current event time</tr>
          <tr lang="ru">список: индекс события, имя события, текущее время события</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[add 5.4 sec #b( [add middle 10s #c( [add last 5s before end #d(

 [T]
 |
 [metro 100]
 |
 [@current?(
 |
 |   [start( [pause( [stop( [T]
 |   |       |       |      |
 |   |       |       |      [@loop $1(
 |   |       |       |      |
[tl.timeline 20 @loop 1   #a]
|
[prop-> @current {w=20}   ]
|                        ^|
[sel 0 1 2 begin end   ] [/ 1000]
|    ^| ^^|  ^^^|  ^^^^| |
[B] [B] [B]   [B]    [B] [sec->str @symbol @ms]
                         |
[X b->a]                 [S digits=15]
[X c->a]
[X d->a]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
