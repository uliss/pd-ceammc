<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="msg.pack">
        <title>msg.pack</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">message pack</tr>
                <tr lang="ru">упаковка сообщений</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>msg</category>
            <keywords>message pack</keywords>
            <since>0.9.7</since>
            <also>
                <see>msg</see>
                <see>msg.unpack</see>
            </also>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="1" maxvalue="32">
                <tr lang="en">number of inputs</tr>
            </argument>
            <argument name="MSG" type="list">
                <tr lang="en">message prefix</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @msg -->
            <property name="@msg" type="list" default="">
                <tr lang="en">message prefix. Change value via [prop.set] object</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" minvalue="1" default="2" maxvalue="32"
            access="initonly">
                <tr lang="en">number of inlets</tr>
            </property>
            <!-- @sync -->
            <property name="@sync" type="bool" default="0">
                <tr lang="en">sync mode. If true: output value on each inlet value change</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet number="1">
                <xinfo>
                    <tr lang="en">first atom</tr>
                </xinfo>
            </inlet>
            <inlet number="...">
                <xinfo>
                    <tr lang="en">... atom</tr>
                </xinfo>
            </inlet>
            <inlet number="n">
                <xinfo>
                    <tr lang="en">n-th atom</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>message output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]           [F]   [T]
|             |     |
|             |     [prop.set @sync]
|             |.    |.
[msg.pack 2 the @msg ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
