<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="msg.pack">
    <title>msg.pack</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">message pack</tr>
        <tr lang="ru">упаковка сообщений</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>msg</category>
      <keywords>message pack</keywords>
      <since>0.9.7</since>
      <also>
        <see>msg</see>
        <see>msg.unpack</see>
      </also>
    </meta>
    <info>
      <par style="important">
        <tr lang="en">Properties in this object can only be changed through the connected object [prop.set]</tr>
        <tr lang="ru">Измененять свойства в этом объекте можно только через подключенный объект [prop.set]</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="1" maxvalue="32">
        <tr lang="en">number of inputs</tr>
        <tr lang="ru">количество входов</tr>
      </argument>
      <argument name="MSG" type="list">
        <tr lang="en">message prefix</tr>
        <tr lang="ru">префикс сообщения</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @msg -->
      <property name="@msg" type="list" default="">
        <tr lang="en">message prefix</tr>
        <tr lang="ru">префикс сообщения</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" minvalue="1" default="2" maxvalue="32" access="initonly">
        <tr lang="en">number of inlets</tr>
        <tr lang="ru">количество входов</tr>
      </property>
      <!-- @sync -->
      <property name="@sync" type="bool" default="0">
        <tr lang="en">sync mode. If true: outputs a message for every event on each of the inputs,
        otherwise it outputs a message only for the event on the first input.</tr>
        <tr lang="ru">режим синхронизации. Если true: выводит сообщение при каждом событии на каждом их входов,
        в противном случае выводит сообщение только при событии на первом входе.</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet number="1">
        <in>
          <tr lang="en">first message atom</tr>
          <tr lang="ru">первый атом сообщения</tr>
        </in>
      </inlet>
      <inlet number="...">
        <in>
          <tr lang="en">... message atom</tr>
          <tr lang="ru">... атом сообщения</tr>
        </in>
      </inlet>
      <inlet number="n">
        <in>
          <tr lang="en">n-th message atom</tr>
          <tr lang="ru">n-й атом сообщения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">message output</tr>
          <tr lang="ru">вывод сообщений</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]           [F]   [T]
|             |     |
|             |     [prop.set @sync]
|             |.    |.
[msg.pack 2 the @msg ]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
