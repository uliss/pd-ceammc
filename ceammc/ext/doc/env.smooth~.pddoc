<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env.smooth~">
    <title>env.smooth~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">envelope with an exponential attack and release</tr>
        <tr lang="ru">огибающая с экспоненциальной атакой и восстановлением</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>envelope smooth</keywords>
      <since>0.6</since>
      <also>
        <see>env.adsr~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">A simple envelope with an exponential attack and release. Unlike [env.ar~],
        both the attack and release use an exponential curve instead of a linear one, so the shape
        sounds smoother and more natural, especially for sustained sounds. The attack time and the
        release time are the same and are controlled by a single @duration property.</tr>
        <tr lang="ru">Простая огибающая с экспоненциальной атакой и восстановлением. В отличие от
        [env.ar~], и атака, и восстановление используют экспоненциальную кривую вместо линейной,
        поэтому форма звучит плавнее и естественнее, особенно для протяжных звуков. Время атаки и
        время восстановления одинаковы и управляются одним свойством @duration.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Smooth gating of a signal — fading a continuous sound source (oscillator,
        sample loop, noise) in and out without clicks or abrupt transitions.</tr>
        <tr lang="ru">• Плавное стробирование сигнала — появление и исчезновение непрерывного
        источника звука (осциллятора, зацикленного сэмпла, шума) без щелчков и резких
        переходов.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Soft attack and release for pads — shaping long, sustained textures with a
        natural-sounding exponential contour, so that notes fade in and out smoothly.</tr>
        <tr lang="ru">• Мягкая атака и восстановление для пэдов — формирование длинных протяжных
        текстур с естественным экспоненциальным контуром, чтобы ноты плавно появлялись и
        исчезали.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Avoiding clicks when switching audio — muting and unmuting a signal path
        with a short exponential ramp instead of a hard on/off, eliminating pops and clicks.</tr>
        <tr lang="ru">• Устранение щелчков при переключении аудио — включение и выключение
        аудиотракта короткой экспоненциальной огибающей вместо жёсткого вкл/выкл, что устраняет
        щелчки и хлопки.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Simple percussive shaping — providing an exponential decay tail for short
        percussive sounds, giving them a natural, "acoustic" fade-out.</tr>
        <tr lang="ru">• Простое формирование перкуссионных звуков — обеспечение экспоненциального
        затухания для коротких перкуссионных звуков, придающего им естественное «акустическое»
        затухание.</tr>
      </par>
    </info>
    <arguments>
      <argument name="DURATION" type="float" units="millisecond" minvalue="0" maxvalue="100000">
        <tr lang="en">attack/release time</tr>
        <tr lang="ru">время атаки/восстановления</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @duration -->
      <property name="@duration" type="float" units="millisecond" minvalue="0" maxvalue="100000"
      default="100">
        <tr lang="en">attack/release time (time to reach the -60 dB level)</tr>
        <tr lang="ru">время атаки/восстановления (время достижения уровня -60 дБ)</tr>
      </property>
      <!-- @gate -->
      <property name="@gate" type="bool" default="0">
        <tr lang="en">trigger signal</tr>
        <tr lang="ru">триггерный сигнал</tr>
      </property>
    </properties>
    <methods>
      <!-- play -->
      <method name="play">
        <info>
          <tr lang="en">runs the envelope and releases it after the specified time</tr>
          <tr lang="ru">запускает огибающую и снимает её через заданное время</tr>
        </info>
        <param name="DUR" type="float" minvalue="0" units="millisecond">
          <tr lang="en">duration</tr>
          <tr lang="ru">длительность</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the envelope to its initial state</tr>
          <tr lang="ru">возвращает огибающую в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal with the envelope applied</tr>
          <tr lang="ru">выходной сигнал с применённой огибающей</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">bang when the envelope is finished</tr>
          <tr lang="ru">bang по завершении огибающей</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[osc~ 440]    [ui.dsp~]
|
|         [T]
|         |
|         [@gate $1(
|         |
|         |
[env.smooth~ 100          ]
|                       ^|
[ui.gain~ @size 120 16] [B]
|\
[dac~]

[env.smooth~-plot]
]]>
      </pdascii>
      <pdascii id="plot">
<![CDATA[
[bang #a(
|
[plot.linspace~ 0 10 1024]
                        ^|
[sig~ 1] [play 10 #c(    |
|        |               |
[env.smooth~ 5]          |
|                        |.
[ui.plot~ @xlabels 1 @ylabels 1 @size 360 170 @ymin_ticks 0 @ymin 0 @ymax 1]












[ui.dsp~]
[X a->c]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
