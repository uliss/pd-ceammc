<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env.smooth~">
    <title>env.smooth~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">envelope with an exponential attack and release</tr>
        <tr lang="ru">огибающая с экспоненциальной атакой и отпусканием</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>envelope smooth</keywords>
      <since>0.6</since>
      <also>
        <see>env.adsr~</see>
      </also>
    </meta>
    <arguments>
      <argument name="DURATION" type="float" units="millisecond" minvalue="0" maxvalue="100000">
        <tr lang="en">attack time</tr>
        <tr lang="ru" finished="false">Время атаки</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @duration -->
      <property name="@duration" type="float" units="millisecond" minvalue="0" maxvalue="100000"
      default="100">
        <tr lang="en">attack/release time (time to get -60db level)</tr>
        <!-- old: время атаки/выпуска (время достижения уровня -60
                дБ) -->
        <tr lang="ru" finished="false">время атаки/выпуска (время достижения уровня -60 дБ)</tr>
      </property>
      <!-- @gate -->
      <property name="@gate" type="bool" default="0">
        <tr lang="en">trigger signal</tr>
        <tr lang="ru" finished="false">сигнальный сигнал</tr>
      </property>
    </properties>
    <methods>
      <!-- play -->
      <method name="play">
        <info>
          <tr lang="en">runs envelope and release it after specified time</tr>
          <!-- old: запускает конверт и выпускает его по истечении
                    определенного времени -->
          <tr lang="ru" finished="false">запускает конверт и выпускает его по истечении
          определенного времени</tr>
        </info>
        <param name="DUR" type="float" minvalue="0" units="millisecond">
          <tr lang="en">duration</tr>
          <tr lang="ru" finished="false">продолжительность</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset envelope to initial state</tr>
          <tr lang="ru" finished="false">Перезагрузить конверт в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru" finished="false">входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal with applied envelope</tr>
          <tr lang="ru" finished="false">выходной сигнал с нанесенной оболочкой</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">bang on done</tr>
          <tr lang="ru" finished="false">бахвальство</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[osc~ 440]    [ui.dsp~]
|
|         [T]
|         |
|         [@gate $1(
|         |
|         |
[env.smooth~ 100          ]
|                       ^|
[ui.gain~ @size 120 16] [B]
|\
[dac~]

[env.smooth~-plot]
]]>
      </pdascii>
      <pdascii id="plot">
<![CDATA[
[bang #a(
|
[plot.linspace~ 0 10 1024]
                        ^|
[sig~ 1] [play 10 #c(    |
|        |               |
[env.smooth~ 5]          |
|                        |.
[ui.plot~ @xlabels 1 @ylabels 1 @size 360 170 @ymin_ticks 0 @ymin 0 @ymax 1]












[ui.dsp~]
[X a->c]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
