<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="data.copy">
    <title>data.copy</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">makes a copy of any data type: MList, Set etc.</tr>
        <tr lang="ru">создаёт копию любого типа данных: MList, Set и т.д.</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data copy</keywords>
      <since>0.9.2</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Data types such as MList are internally passed by reference, not by
        value.</tr>
        <tr lang="en">This object makes a copy of the input data.</tr>
        <tr lang="ru">Типы данных, такие как MList, внутри передаются по ссылке, а не по
        значению.</tr>
        <tr lang="ru">Этот объект создаёт копию входных данных.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="data">
          <tr lang="en">input data</tr>
          <tr lang="ru">входные данные</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">data copy</tr>
          <tr lang="ru">копия данных</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*without copy*/

[B]
|
[list.gen 3 #a] [list.gen 3 #c]X[random 10]
|               |
|               [mlist #b]
|               |
[ui.dt]         [ui.dt]
[X b->a:1]
[X a:1->c]
/*with copy */

[B]
|
[list.gen 3 #d] [list.gen 3 #e]X[random 10]
|               |
|               [mlist]
|               |
|               [data.copy #f]
|               |
[ui.dt]         [ui.dt]
[X f->d:1]
[X d:1->e]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
