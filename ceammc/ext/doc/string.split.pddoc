<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="string.split">
        <title>string.split</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">splits the string or symbol into the list by the separator</tr>
                <tr lang="ru">разбивает строку или символ в список по разделителю</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>string</category>
            <keywords>split</keywords>
            <since>0.3</since>
            <aliases>
                <alias>str.split</alias>
                <alias>symbol.split</alias>
            </aliases>
            <also>
                <see>string.join</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: by default string or symbol splitted to list of data:String, to
                get list of Pd symbols use @sym flag or use alias [symbol.split]</tr>
                <tr lang="ru" finished="false">Примечание: по умолчанию строка или символ разделены
                на список данных: строка, чтобы получить список символов Pd использовать @sym flag
                или использовать псевдоним [symbol.split]</tr>
            </par>
        </info>
        <arguments>
            <argument name="SEP" type="symbol">
                <tr lang="en">separator. If nonspecified - separate by every char. To separate by
                space - use " " argument</tr>
                <tr lang="ru" finished="false">Разделитель. Если не указано - раздельно по каждому
                шару. Разделить по пространству - использовать аргумент</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @sep -->
            <property name="@sep" type="symbol" default="">
                <tr lang="en">separator</tr>
                <tr lang="ru" finished="false">разделитель</tr>
            </property>
            <!-- @sym -->
            <property name="@sym" type="flag" access="initonly">
                <tr lang="en">flag to output as list of Pd symbols</tr>
                <tr lang="ru" finished="false">Флаг для вывода в виде списка символов Pd</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="symbol">
                    <tr lang="en">input symbol</tr>
                    <tr lang="ru" finished="false">входной символ</tr>
                </in>
                <in on="data:string">
                    <tr lang="en">input symbol</tr>
                    <tr lang="ru" finished="false">входной символ</tr>
                </in>
            </inlet>
            <inlet>
                <in on="symbol">
                    <tr lang="en">set split symbol</tr>
                    <tr lang="ru" finished="false">Установить раздельный символ</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">list of data:Strings or symbols</tr>
                    <tr lang="ru" finished="false">Список данных: строки или символы</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[symbol A/B/C(      [symbol Sample(     [bang(
|                   |                   |
[string]            [string]            [string AB CD]
|                   |                   |
[string.split /]    [string.split]      [string.split " "]
|                   |                   |
[string.join " "]   [string.join "*"]   [string.join "-"]
|                   |                   |
[ui.dt]             [ui.dt]             [ui.dt]


/*Pd symbol split*/

[symbol A/B/C(
|
[string.split / @sym]
|
[unpack s s s ]
|     ^|    ^^|
[S]   [S]   [S]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
