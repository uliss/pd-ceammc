<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.bits2bang">
    <title>conv.bits2bang</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">convert list of bits to bang events</tr>
        <tr lang="ru">преобразует список битов в события bang</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv bits bangs</keywords>
      <since>0.9.2</since>
      <aliases>
        <alias>ceammc/bits-&gt;bang</alias>
        <alias>bits-&gt;bang</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes a list of bits (0s and 1s) and produces bang events for
        each bit that is set to 1. In the default mode each bit is associated with its own outlet,
        and a bang is sent to the outlet corresponding to each 1-bit. If the @rev flag is set, the
        bit order is reversed before processing.</tr>
        <tr lang="ru">Объект принимает список битов (0 и 1) и генерирует события bang для каждого
        бита, установленного в 1. В режиме по умолчанию каждому биту соответствует отдельный
        выход, и bang отправляется на выход, соответствующий каждому биту со значением 1. Если
        установлен флаг @rev, порядок битов перед обработкой инвертируется.</tr>
      </par>
      <par>
        <tr lang="en">In @poly mode a single outlet is used, and instead of a bare bang, a list
        (BIT_INDEX bang) is sent — this is convenient for use with the [clone] object, where the
        index identifies the clone instance.</tr>
        <tr lang="ru">В режиме @poly используется один выход, и вместо простого bang отправляется
        список (BIT_INDEX bang) — это удобно при работе с объектом [clone], где индекс определяет
        экземпляр клона.</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="1" maxvalue="64">
        <tr lang="en">number of outlets</tr>
        <tr lang="ru">количество выходов</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @n -->
      <property name="@n" type="int" minvalue="1" maxvalue="64" default="8" access="initonly">
        <tr lang="en">number of outlets</tr>
        <tr lang="ru">количество выходов</tr>
      </property>
      <!-- @poly -->
      <property name="@poly" type="flag" access="initonly">
        <tr lang="en">polyphonic mode for using with the [clone] object</tr>
        <tr lang="ru">полифонический режим для использования с объектом [clone]</tr>
      </property>
      <!-- @rev -->
      <property name="@rev" type="bool" default="0">
        <tr lang="en">reversed bit order</tr>
        <tr lang="ru">обратный порядок битов</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">input bit list</tr>
          <tr lang="ru">входной список битов</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet>
        <out type="any">
          <tr lang="en">output</tr>
          <tr lang="ru">выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[random(
|
[ui.hrd* @nitems 4]
|
[bits->bang 4 #x]

[osc~ 400]   [osc~ 800]   [osc~ 1200]  [osc~ 1600]
|            |            |            |
[env.ar~ #a] [env.ar~ #b] [env.ar~ #c] [env.ar~ #d]
|            |.           |..          |...
[pan.spread~ 4 {w=54}                      ]
*|*
[ui.hgain2~]
*|*
[dac~]

/*Poly version*/

[ui.hrd* 4]
|
[bits->bang @poly]
|
[clone conv.bits2bang-osc~ 4 400 800 1200 1600 {i=1,o=1}]
|
[ui.hgain~]
|\
[dac~]

[X x:0->a]
[X x:1->b]
[X x:2->c]
[X x:3->d]
#a 50 500
#b 50 500
#c 50 500
#d 50 500
]]>
      </pdascii>
      <pdascii id="osc~">
<![CDATA[
[inlet] [loadbang]
|       |
|       [patch.args @from expr($1+1)]
|       |
|       [f]
|       |
[b]     [osc~]
|       |
[env.ar~ 50 500]
|
[outlet~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
