<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="music.dur2time">
        <title>music.dur2time</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">transforms the list of musical durations into a list of time
                periods</tr>
                <tr lang="ru">преобразование списка музыкальных длительностей в список временных
                периодов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv music duration</keywords>
            <since>0.9.4</since>
            <aliases>
                <alias>music.d-&gt;t</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">duration can be specified</tr>
                <tr lang="ru" finished="false">продолжительность может быть определена</tr>
            </par>
            <par>
                <tr lang="en">- by denominator: 1 (whole), 2_. (dotted half), 8 (eight) etc.</tr>
                <tr lang="ru" finished="false">- по знаменателю: 1 (целый), 2_. (половина), 8
                (восемь) и т.д.</tr>
            </par>
            <par>
                <tr lang="en">or</tr>
                <tr lang="ru" finished="false">или</tr>
            </par>
            <par>
                <tr lang="en">- by ratio: 3/4 (three quaters), 1/8.(one dotted eight), 3/8 (three
                eights) etc.</tr>
                <tr lang="ru" finished="false">- в соотношении: 3/4 (три кватера), 1/8. (одна
                пунктирная восьмерка), 3/8 (три восьмерки) и т.д.</tr>
            </par>
        </info>
        <properties>
            <!-- @bpm -->
            <property name="@bpm" type="atom" default="60|4bpm" units="bpm">
                <tr lang="en">tempo</tr>
                <tr lang="ru" finished="false">темп</tr>
            </property>
            <!-- @seq -->
            <property name="@seq" type="bool" default="1">
                <tr lang="en">sequential durations</tr>
                <tr lang="ru" finished="false">последовательные длительности</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">duration list</tr>
                    <tr lang="ru" finished="false">Список продолжительности</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">converted value</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[list 2_. 4 8 8 16 16 16 1/16 3/2(
|
|    [T]
|    |
|    [@seq $1(
|    |
[music.d->t @bpm 120|4bpm @seq 0]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
