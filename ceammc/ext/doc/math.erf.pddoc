<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="math.erf">
        <title>math.erf</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">error function</tr>
                <tr lang="ru">функция ошибок</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math error gauss</keywords>
            <also>
                <see>math.erf~</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">In statistics, for non-negative values of x, the error function has
                the following interpretation:</tr>
            </par>
            <par>
                <tr lang="en">for a random variable Y that is normally distributed with mean 0 and
                variance 1/2, erf x is the probability that Y falls in the range [−x, x]</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input value</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">apply to all numeric values</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(                 [array ERF y=0..1 w=320]
|
[list.seq -4 4 0.025]
|
[math.erf]
|
[list->array ERF]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
