<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="prop">
        <title>prop</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">get/set the named property value for subpatch or abstraction</tr>
                <tr lang="ru">получить/установить именованное значение свойства для субпатча или
                абстракции</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>property</category>
            <keywords>property</keywords>
            <since>0.7</since>
            <also>
                <see>prop.declare</see>
                <see>patch.props</see>
            </also>
            <aliases>
                <alias>ceammc/prop</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">The property should be declared with [prop.declare]. Min/max limits
                can be set to the property</tr>
            </par>
        </info>
        <arguments>
            <argument name="@NAME" type="symbol">
                <tr lang="en">property name</tr>
            </argument>
        </arguments>
        <methods>
            <!-- default -->
            <method name="default">
                <info>
                    <tr lang="en">reset to default value and output</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">output property value</xinfo>
                <xinfo on="any">set property value and output it</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[prop.declare freq @min 20 @max 20000 @default 1000]

[prop.declare gain @min -60 @max 12 @default -3]

[F]
|
[prop @freq] [prop @gain]
|            |
[F]          [F]

[default(
|
[prop @freq]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
