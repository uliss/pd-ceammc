<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="prop">
    <title>prop</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">get/set the named property value for a subpatch or an abstraction</tr>
        <tr lang="ru">получает/устанавливает значение именованного свойства для субпатча или
        абстракции</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>property</category>
      <keywords>property</keywords>
      <since>0.7</since>
      <also>
        <see>prop.declare</see>
        <see>patch.props</see>
      </also>
      <aliases>
        <alias>ceammc/prop</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object gets or sets the value of a named property in the current subpatch
        or abstraction</tr>
        <tr lang="ru">объект читает или устанавливает значение именованного свойства в текущем
        субпатче или абстракции</tr>
      </par>
      <par>
        <tr lang="en">the property must be declared with [prop.declare] first. The min/max limits
        are set at declaration time</tr>
        <tr lang="ru">свойство должно быть предварительно объявлено через [prop.declare].
        Ограничения min/max задаются при объявлении</tr>
      </par>
      <par>
        <tr lang="en">a bang on the inlet outputs the current property value, an incoming value
        sets the property and outputs it</tr>
        <tr lang="ru">bang на входе выводит текущее значение свойства, входящее значение
        устанавливает свойство и выводит его</tr>
      </par>
    </info>
    <arguments>
      <argument name="@NAME" type="symbol">
        <tr lang="en">property name</tr>
        <tr lang="ru">имя свойства</tr>
      </argument>
    </arguments>
    <methods>
      <!-- default -->
      <method name="default">
        <info>
          <tr lang="en">reset to the default value and output</tr>
          <tr lang="ru">сбросить к значению по умолчанию и вывести</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output property value</tr>
          <tr lang="ru">вывести значение свойства</tr>
        </in>
        <in on="any">
          <tr lang="en">set property value and output it</tr>
          <tr lang="ru">установить значение свойства и вывести его</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output value</tr>
          <tr lang="ru">выходное значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[prop.declare freq @min 20 @max 20000 @default 1000]

[prop.declare gain @min -60 @max 12 @default -3]

[F]
|
[prop @freq] [prop @gain]
|            |
[F]          [F]

[default(
|
[prop @freq]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
