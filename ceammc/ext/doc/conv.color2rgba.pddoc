<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.color2rgba">
    <title>conv.color2rgba</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts the named or hex color into separate RGBA values</tr>
        <tr lang="ru">преобразует именованный или шестнадцатеричный цвет в отдельные значения
        RGBA</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv color hex rgb rgba</keywords>
      <since>0.9.7</since>
      <aliases>
        <alias>ceammc/color-&gt;rgba</alias>
        <alias>color-&gt;rgba</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts a color given as a name or a hex value into separate R,
        G, B and A channel values. By default the output values are integers in the range [0, 255].
        With the @float flag, the output values are in the range [0, 1] instead. By default the
        channel values are sent to four separate outlets. If the @pack flag is set, all four values
        are packed into a single list sent to the first outlet.</tr>
        <tr lang="ru">Объект преобразует цвет, заданный именем или hex-значением, в отдельные
        значения каналов R, G, B и A. По умолчанию выходные значения — целые числа в диапазоне
        [0, 255]. При флаге @float выходные значения находятся в диапазоне [0, 1]. По умолчанию
        значения каналов отправляются на четыре отдельных выхода. Если установлен флаг @pack, все
        четыре значения упаковываются в один список и отправляются на первый выход.</tr>
      </par>
      <par>
        <tr lang="en">Supported named colors: black, blue, cyan, gold, gray, green, lime, magenta,
        navy, olive, orange, pink, purple, red, white, yellow.</tr>
        <tr lang="ru">Поддерживаемые именованные цвета: black, blue, cyan, gold, gray, green,
        lime, magenta, navy, olive, orange, pink, purple, red, white, yellow.</tr>
      </par>
    </info>
    <properties>
      <!-- @float -->
      <property name="@float" type="alias">
        <tr lang="en">alias to @mode float. Output values in the [0, 1] range</tr>
        <tr lang="ru">сокращение для @mode float. Выходные значения в диапазоне [0, 1]</tr>
      </property>
      <!-- @int -->
      <property name="@int" type="alias">
        <tr lang="en">alias to @mode int. Output values in the [0, 255] range</tr>
        <tr lang="ru">сокращение для @mode int. Выходные значения в диапазоне [0, 255]</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" default="int" enum="int float">
        <tr lang="en">output mode</tr>
        <tr lang="ru">режим вывода</tr>
      </property>
      <!-- @pack -->
      <property name="@pack" type="flag" access="initonly">
        <tr lang="en">output as a list to the first outlet</tr>
        <tr lang="ru">выводить в виде списка в первый выход</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">color name or hex value in full (#RRGGBB or #RRGGBBAA) or short (#RGB or
          #RGBA) format</tr>
          <tr lang="ru">имя цвета или hex-значение в полном (#RRGGBB или #RRGGBBAA) либо коротком
          (#RGB или #RGBA) формате</tr>
        </in>
        <in on="any">
          <tr lang="en">use message selector as the color name</tr>
          <tr lang="ru">использовать селектор сообщения как имя цвета</tr>
        </in>
        <in on="data:color">
          <tr lang="en">Color data</tr>
          <tr lang="ru">данные цвета</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet>
        <out type="any">
          <tr lang="en">list if @pack flag is specified, or int[0, 255] / float[0, 1]: red channel
          value</tr>
          <tr lang="ru">список, если указан флаг @pack, иначе int[0, 255] / float[0, 1]: значение
          красного канала</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">int[0, 255] or float[0, 1]: green channel value</tr>
          <tr lang="ru">int[0, 255] или float[0, 1]: значение зелёного канала</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">int[0, 255] or float[0, 1]: blue channel value</tr>
          <tr lang="ru">int[0, 255] или float[0, 1]: значение синего канала</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">int[0, 255] or float[0, 1]: alpha channel value</tr>
          <tr lang="ru">int[0, 255] или float[0, 1]: значение альфа-канала</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.menu black blue cyan gold gray green lime magenta navy olive orange pink purple red white yellow]
|
| [\#FF3399 #a( [\#39F #b( [\#444A #c(
|
|    [L]                        [symbol green(
|    |                          |
[$2( [$1( [@float #d( [@int #e( [S digits=10]
|    |                          |
[color->rgba @float #x]         [color->rgba @pack]
|    ^|   ^^| ^^^|              |
[F]  [F]  [F]  [F]              [ui.dt]

[X a->x]
[X b->x]
[X c->x]
[X d->x]
[X e->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
