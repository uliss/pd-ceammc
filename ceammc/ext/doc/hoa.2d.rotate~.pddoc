<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hoa.2d.rotate~">
    <title>hoa.2d.rotate~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
        <author>Pierre Guillot</author>
        <author>Eliott Paris</author>
        <author>Thomas Le Meur</author>
      </authors>
      <description>
        <tr lang="en">a 2D ambisonic sound field rotation</tr>
        <tr lang="ru">вращение звукового поля двумерных амбисоников</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>spat</category>
      <keywords>hoa rotate</keywords>
      <since>0.8</since>
      <also>
        <see>hoa.encoder~</see>
      </also>
      <aliases>
        <alias>hoa.rotate~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Rotates the ambisonic sound field in the 2D plane. The rotation angle is set
        as an audio signal on the last inlet. The rotation is counter-clockwise and is wrapped
        between 0 and 2π.</tr>
        <tr lang="ru">Вращает звуковое поле амбисоников в двумерной плоскости. Угол поворота
        задаётся как звуковой сигнал на последнем входе. Вращение происходит против часовой стрелки
        и приводится к диапазону от 0 до 2π.</tr>
      </par>
      <a href="hoa/hoa.2d.rotate~-help.pd">CICM documentation</a>
    </info>
    <arguments>
      <argument name="ORDER" type="int" minvalue="1" maxvalue="63">
        <tr lang="en">the order of decomposition</tr>
        <tr lang="ru">порядок декомпозиции</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @order -->
      <property name="@order" type="int" minvalue="1" maxvalue="63" default="1" access="initonly">
        <tr lang="en">the order of decomposition</tr>
        <tr lang="ru">порядок декомпозиции</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet type="audio">
        <in>
          <tr lang="en">first input harmonic</tr>
          <tr lang="ru">первая входная гармоника</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... input harmonic</tr>
          <tr lang="ru">... входная гармоника</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">n-th input harmonic</tr>
          <tr lang="ru">n-я входная гармоника</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n+1">
        <in>
          <tr lang="en">rotation angle of the soundfield, in radians. The rotation is
          counter-clockwise and is wrapped between 0 and 2π.</tr>
          <tr lang="ru">угол поворота звукового поля, в радианах. Вращение происходит против
          часовой стрелки и приводится к диапазону от 0 до 2π.</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet type="audio">
        <out type="any">
          <tr lang="en">first output harmonic</tr>
          <tr lang="ru">первая выходная гармоника</tr>
        </out>
      </outlet>
      <outlet type="audio" number="...">
        <out type="any">
          <tr lang="en">... output harmonic</tr>
          <tr lang="ru">... выходная гармоника</tr>
        </out>
      </outlet>
      <outlet type="audio" number="n">
        <out type="any">
          <tr lang="en">n-th output harmonic</tr>
          <tr lang="ru">n-я выходная гармоника</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[sig~ 1]       [sig~ 1.62]        [sig~ -0.9]
|              |.                 |
[hoa.encoder~ 5 {w=21,i=11,o=11}] [hoa.encoder~ 5 {w=21,i=11,o=11}]
            *|*                   *|*
            *|*                   *|*           [lfo.saw~ 0.15]
            *|*                   *|*           |
            *|*                   *|*           [phase->rad~ #a]
            *|*                   *|*           |
            [hoa.rotate~ 5 {w=23,i=12,o=11} #b] [ui.n~]
            *|*
            [hoa.scope~ 5 @gain 4 @size 164 164 {i=11}]











[ui.dsp~]
[X a->b:11]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
