<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="osc.impulse~">
        <title>osc.impulse~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">bandlimited impulse train generator</tr>
                <tr lang="ru">генератор импульсного сигнала с ограниченным спектром</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>osc</category>
            <keywords>oscillator band-limited</keywords>
            <since>0.1</since>
            <also>
                <see>osc.saw~</see>
                <see>osc.tri~</see>
                <see>osc.square~</see>
                <see>lfo.impulse~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" minvalue="0.0" maxvalue="22050.0" units="hertz">See
            @freq</argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1">on/off dsp processing</property>
            <!-- @freq -->
            <property name="@freq" type="float" default="0" minvalue="0" maxvalue="22050"
            units="hertz">frequency</property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo minvalue="20" on="float">frequency in Hz</xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">reset phase</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[osc.impulse~ 20]
|
[ui.gain~ @size 120 16]
|\
[dac~]

[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
