<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="osc.impulse~">
    <title>osc.impulse~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">bandlimited impulse train generator</tr>
        <tr lang="ru">генератор импульсной последовательности с ограниченным спектром</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>osc</category>
      <keywords>oscillator band-limited</keywords>
      <since>0.1</since>
      <also>
        <see>osc.saw~</see>
        <see>osc.tri~</see>
        <see>osc.square~</see>
        <see>lfo.impulse~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">generates a bandlimited impulse train (BLIT), a series of narrow pulses with
        a controlled spectrum, free of aliasing artifacts</tr>
        <tr lang="ru">генерирует последовательность импульсов с ограниченным спектром (BLIT) —
        серию узких импульсов с контролируемым спектром без артефактов алиасинга</tr>
      </par>
      <par>
        <tr lang="en">the output signal is suitable as an excitation source for subtractive
        synthesis and physical modelling</tr>
        <tr lang="ru">выходной сигнал подходит в качестве источника возбуждения для субтрактивного
        синтеза и физического моделирования</tr>
      </par>
      <par>
        <tr lang="en">the left inlet receives the frequency in Hz, a bang on the right inlet resets
        the phase</tr>
        <tr lang="ru">левый вход принимает частоту в Гц, bang на правом входе сбрасывает фазу</tr>
      </par>
    </info>
    <arguments>
      <argument name="FREQ" type="float" minvalue="0.0" maxvalue="22050.0" units="hertz">
        <tr lang="en">see @freq</tr>
        <tr lang="ru">см. @freq</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @freq -->
      <property name="@freq" type="float" default="0" minvalue="0" maxvalue="22050" units="hertz">
        <tr lang="en">frequency</tr>
        <tr lang="ru">частота</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in minvalue="20" on="float">
          <tr lang="en">frequency in Hz</tr>
          <tr lang="ru">частота в Гц</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">reset phase</tr>
          <tr lang="ru">сбросить фазу</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru">выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]
|
[osc.impulse~ 20]
|
[ui.gain~ @size 120 16]
|\
[dac~]

[ui.dsp~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
