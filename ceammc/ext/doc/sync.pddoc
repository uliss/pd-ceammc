<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="sync">
        <title>sync</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">synchronization of multiple values without overflowing stack
                loops</tr>
                <tr lang="ru">синхронизация нескольких значений без переполняющих стек петель</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>sync</keywords>
            <since>0.9.1</since>
            <aliases>
                <alias>ceammc/sync</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">The value send to inlet repeated to all outlets except from the
                current one. This prevents infinite loops</tr>
                <tr lang="ru" finished="false">Значение, отправляемое на вход, повторяется во все
                выходы, кроме текущего. Это предотвращает бесконечные петли.</tr>
            </par>
        </info>
        <arguments>
            <argument name="N" type="int" minvalue="2" maxvalue="8">
                <tr lang="en">number of synchronized values</tr>
                <tr lang="ru" finished="false">Количество синхронизированных значений</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @n -->
            <property name="@n" type="int" minvalue="2" default="2" maxvalue="8" access="initonly">
                <tr lang="en">number of synced values</tr>
                <tr lang="ru" finished="false">Количество синхронизированных значений</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet number="1">
                <in>
                    <tr lang="en">first synchronized input</tr>
                    <tr lang="ru" finished="false">Первый синхронизированный вход</tr>
                </in>
            </inlet>
            <inlet number="...">
                <in>
                    <tr lang="en">... synchronized input</tr>
                    <tr lang="ru" finished="false">Синхронизированный вход</tr>
                </in>
            </inlet>
            <inlet number="n">
                <in>
                    <tr lang="en">n-th synchronized input</tr>
                    <tr lang="ru" finished="false">n-й синхронизированный вход</tr>
                </in>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="any">
                    <tr lang="en">first synchronized output</tr>
                    <tr lang="ru" finished="false">Первый синхронизированный выход</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">... synchronized output</tr>
                    <tr lang="ru" finished="false">... синхронизированный выход</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">n-th synchronized output</tr>
                    <tr lang="ru" finished="false">n-ый синхронизированный выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
/*simple example*/

[F #m]   [sync #n] [F #p]

/*more complex*/

[F #a]  [F #b]  [F #c]

[sync 3 #z {w=22,i=3,o=3}]
[X a->z]
[X z->a]
[X b->z:1]
[X z:1->b]
[X c->z:2]
[X z:2->c]
[X m->n]
[X n->m]
[X n:1->p]
[X p->n:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
