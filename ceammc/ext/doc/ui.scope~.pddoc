<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.scope~" type="gui">
        <title>ui.scope~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">waveform signal scope widget</tr>
                <tr lang="ru">виджет просмотра формы волны</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui scope</keywords>
            <since>0.1</since>
            <also>
                <see view="link">ui.spectroscope~</see>
            </also>
        </meta>
        <mouse>
            <event type="left-click" editmode="false" keys="Shift">Y-axis zoomin</event>
            <event type="left-click" editmode="false" keys="Alt">Y-axis zoomout</event>
            <event type="wheel" editmode="false">Y-axis zoom</event>
            <event type="wheel" editmode="false" keys="Shift">X-axis zoom</event>
            <event type="double-click" editmode="false">toggle freeze mode</event>
            <event type="right-click" editmode="false">open object popup menu with zoom
            options</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_active_color.xml" />
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <!-- @fontname -->
            <property name="@fontname" type="symbol" default="Helvetica"
            enum="Courier DejaVu Helvetica Monaco Times">
                <tr lang="en">fontname</tr>
            </property>
            <!-- @fontsize -->
            <property name="@fontsize" type="int" minvalue="4" maxvalue="100" default="11">
                <tr lang="en">fontsize</tr>
            </property>
            <!-- @fontslant -->
            <property name="@fontslant" type="symbol" enum="roman italic" default="roman">
                <tr lang="en">font slant</tr>
            </property>
            <!-- @fontweight -->
            <property name="@fontweight" type="symbol" enum="normal bold" default="normal">
                <tr lang="en">font weight</tr>
            </property>
            <!-- @max -->
            <property name="@max" type="float" default="1">
                <tr lang="en">maximum (top) graph value</tr>
            </property>
            <!-- @min -->
            <property name="@min" type="float" default="-1">
                <tr lang="en">minimum (bottom) graph value</tr>
            </property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="0">
                <tr lang="en">pin mode. if 1 - put element to the lowest level</tr>
            </property>
            <!-- @receive -->
            <property name="@receive" type="symbol" default="(null)">
                <tr lang="en">receive source</tr>
            </property>
            <!-- @refresh -->
            <property name="@refresh" type="int" minvalue="10" maxvalue="1000" default="40"
            units="millisecond">
                <tr lang="en">approximate refresh rate</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="150 100">
                <tr lang="en">element size (width, height pair)</tr>
            </property>
            <!-- @window -->
            <property name="@window" type="int" minvalue="512" maxvalue="4096" default="2048">
                <tr lang="en">window size</tr>
            </property>
        </properties>
        <methods>
            <!-- freeze -->
            <method name="freeze">stop/start processing 
            <param name="V" type="int" enum="0 1">1 - freeze, 0 - unfreeze</param></method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
            <!-- scale -->
            <method name="scale">sets widget scale 
            <param name="N" type="float" minvalue="0">1 - normal scale, 2 - range from -2..2
            (zoomout), 0.1 - range from -0.1..0.1 (zoomin)</param></method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>signal input</xinfo>
            </inlet>
        </inlets>
        <example>
            <pdascii>
<![CDATA[
[ui.dsp~ @size 40 40 @nosave 1]


[300( [660( [F]
|     |     |
|     |     |
[osc~ 440   ] [scale 0.5( [scale 1( [scale 2(
|             |           |         |
|             |           |         |
[ui.scope~   @size=450x200 @nosave=1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
