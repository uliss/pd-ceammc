<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="speech.flite">
        <title>speech.flite</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">render speech to array</tr>
                <tr lang="ru">рендеринг синтезатора речи в массив</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>misc</category>
            <keywords>speak speech flite</keywords>
            <since>0.6</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Renders floats, symbols and list to wavetables using flite TTS
                engine.</tr>
            </par>
            <par>
                <tr lang="en">Rendering is performed in separate thread.</tr>
            </par>
        </info>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">destination array name render to</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">destination array name</tr>
            </property>
            <!-- @pitch -->
            <property name="@pitch" type="float" default="-1">
                <tr lang="en">voice pitch (-1 - default value)</tr>
            </property>
            <!-- @speed -->
            <property name="@speed" type="float" minvalue="1" maxvalue="4" default="1">
                <tr lang="en">speaking speed</tr>
            </property>
            <!-- @voice -->
            <property name="@voice" type="symbol" default="kal16" enum="kal16 slt rms awb">
                <tr lang="en">default voice</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">render number to array</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">render text to array</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">render text to array</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">set target array name</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>bang on done</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[array arr_flite w=500 h=80]





[T]
|
[metro 1000]  [ui.menu kal16 slt rms awb] [ui.knob @min 1 @max 4]
|             |                           |
[flow.count]  [@voice $2( [F]             |
|             |           |               |
|             |           [@pitch $1(     [@speed $1(
|             |           |               |
[speech.flite arr_flite                   ]
|
[0(
|
[tabplay~ arr_flite]
|
[ui.gain~ @size 120 16]   [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
