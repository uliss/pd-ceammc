<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="proto.midi.sysex">
        <title>proto.midi.sysex</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">raw midi SYSex encoder/parser</tr>
                <tr lang="ru">декодер/энкодер исходных сообщений MIDI SYSex</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>proto</category>
            <keywords>parser midi</keywords>
            <since>0.9.4</since>
        </meta>
        <methods>
            <!-- id_request -->
            <method name="id_request">
                <info>
                    <tr lang="en">send Identity Request SysEx message</tr>
                    <tr lang="ru" finished="false">Отправить запрос SysEx</tr>
                </info>
            </method>
            <!-- mbal:f -->
            <method name="mbal:f">
                <info>
                    <tr lang="en">set device master balance</tr>
                    <tr lang="ru" finished="false">Настройка Master Balance</tr>
                </info>
                <param name="PAN" type="float" minvalue="-1" maxvalue="1" required="true">
                    <tr lang="en">balance</tr>
                    <tr lang="ru" finished="false">баланс</tr>
                </param>
            </method>
            <!-- mtune -->
            <method name="mtune">
                <info>
                    <tr lang="en">set device master tuning in float semitones (combination of
                    coarse and fine tune)</tr>
                    <tr lang="ru" finished="false">Настройка мастер-устройства в поплавковых
                    полутонах (комбинация грубой и тонкой мелодии)</tr>
                </info>
                <param name="V" type="float" minvalue="-64" maxvalue="63" required="true"
                units="semitone">
                    <tr lang="en">tuning</tr>
                    <tr lang="ru" finished="false">настройка</tr>
                </param>
            </method>
            <!-- mtune. -->
            <method name="mtune.">
                <info>
                    <tr lang="en">set device master fine tuning in cents</tr>
                    <tr lang="ru" finished="false">Настройка устройства мастер тонкой настройки в
                    центах</tr>
                </info>
                <param name="V" type="int" minvalue="-100" maxvalue="100" required="true"
                units="cent">
                    <tr lang="en">tuning</tr>
                    <tr lang="ru" finished="false">настройка</tr>
                </param>
            </method>
            <!-- mtune~ -->
            <method name="mtune~">
                <info>
                    <tr lang="en">set device master coarse tuning in semitones</tr>
                    <tr lang="ru" finished="false">сет-устройство мастер грубой настройки в
                    полутонах</tr>
                </info>
                <param name="V" type="int" minvalue="-64" maxvalue="63" required="true"
                units="semitone">
                    <tr lang="en">tuning</tr>
                    <tr lang="ru" finished="false">настройка</tr>
                </param>
            </method>
            <!-- mvolume -->
            <method name="mvolume">
                <info>
                    <tr lang="en">set device master volume</tr>
                    <tr lang="ru" finished="false">Настройка устройства Master Объем</tr>
                </info>
                <param name="LEVEL" type="float" minvalue="0" maxvalue="1" required="true">
                    <tr lang="en">volume level</tr>
                    <tr lang="ru" finished="false">объемный уровень</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">raw midi input bytes</tr>
                    <tr lang="ru" finished="false">необработанные промежуточные входные байты</tr>
                </in>
                <in on="list">
                    <tr lang="en">raw midi input bytes</tr>
                    <tr lang="ru" finished="false">необработанные промежуточные входные байты</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">float: raw midi output or parsed messages with selector (output
                    format is the same as for corresponding methods)</tr>
                    <tr lang="ru" finished="false">Поплавок: необработанный вывод миди или
                    парсированные сообщения с селектором (формат вывода такой же, как и для
                    соответствующих методов)</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[proto.midi.sysex-mvol]

[proto.midi.sysex-mbal]

[proto.midi.sysex-mtune]

[proto.midi.sysex-idreq]
]]>
            </pdascii>
            <pdascii id="mvol">
<![CDATA[
[ui.midi]

[midiin]  [ui.hsl]
|         |
|         [mvolume $1(
|         |
[proto.midi.sysex]
|
[midiout]
]]>
            </pdascii>
            <pdascii id="mtune">
<![CDATA[
/*coarse tuning*/       /*fine tuning*/        /*float tuning*/

[ui.midi]               [ui.midi]              [ui.midi]

[midiin]  [F]           [midiin]  [F]          [midiin]  [ui.hsl -12 12 @show_value 1]
|         |             |         |            |         |
|         [mtune~ $1(   |         [mtune. $1(  |         [mtune $1(
|         |             |         |            |         |
[proto.midi.sysex]      [proto.midi.sysex]     [proto.midi.sysex]
|                       |                      |
[midiout]               [midiout]              [midiout]
]]>
            </pdascii>
            <pdascii id="mbal">
<![CDATA[
[ui.midi]

[ui.hsl -1 1 @show_value 1]
|
[mbal:f $1(
|
[proto.midi.sysex]
|
[midiout]
]]>
            </pdascii>
            <pdascii id="idreq">
<![CDATA[
[ui.midi]

[midiin]
|
|         [id_request(
|         |
[proto.midi.sysex]
|
[midiout]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
