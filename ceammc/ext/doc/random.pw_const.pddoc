<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="random.pw_const">
    <title>random.pw_const</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">piecewise constant random distribution</tr>
        <tr lang="ru">кусочно-постоянное случайное распределение</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>random</category>
      <keywords>linear random piecewise const</keywords>
      <also>
        <see>random.linear</see>
        <see>random.pw_lin</see>
      </also>
      <since>0.4</since>
    </meta>
    <info>
      <par>
        <tr lang="en">produces random floating-point numbers that are uniformly distributed within
        each of several subintervals [b0, b1), each with its own weight</tr>
        <tr lang="ru">генерирует случайные числа с плавающей точкой, равномерно распределённые
        внутри каждого из нескольких подинтервалов [b0, b1), каждый со своим весом</tr>
      </par>
      <par>
        <tr lang="en">constant segments are specified as: bound0, weight0, bound1, weight1, bound2
        etc.</tr>
        <tr lang="ru">постоянные сегменты задаются как: bound0, weight0, bound1, weight1, bound2 и
        т.д.</tr>
      </par>
      <par>
        <tr lang="en">use the @seed property to get reproducible sequences. If @seed is not set
        explicitly, a generator initialized with the current time is used</tr>
        <tr lang="ru">используйте свойство @seed для получения воспроизводимых последовательностей.
        Если @seed не задан явно, используется генератор, инициализированный текущим временем</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to create a weighted random selection over several
        ranges, for example to make values near the center more likely than values at the
        edges</tr>
        <tr lang="ru">объект можно использовать для создания взвешенного случайного выбора по
        нескольким диапазонам, например чтобы значения ближе к центру выпадали чаще, чем по
        краям</tr>
      </par>
    </info>
    <arguments>
      <argument name="V" type="list">
        <tr lang="en">interleaved interval boundaries and boundary probabilities. Note: the number
        of arguments should be odd and &gt;=5. Boundaries should be in strictly increasing order
        and weights should be non-negative</tr>
        <tr lang="ru">чередующиеся границы интервалов и вероятности границ. Примечание: количество
        аргументов должно быть нечётным и &gt;=5. Границы должны идти строго по возрастанию, веса
        должны быть неотрицательными</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @bounds -->
      <property name="@bounds" type="list" access="readonly" default="">
        <tr lang="en">list of boundaries</tr>
        <tr lang="ru">список границ</tr>
      </property>
      <!-- @seed -->
      <property name="@seed" type="int" minvalue="0" default="0">
        <tr lang="en">generator seed</tr>
        <tr lang="ru">начальное значение генератора</tr>
      </property>
      <!-- @v -->
      <property name="@v" type="list" default="">
        <tr lang="en">interleaved interval boundaries and boundary probabilities</tr>
        <tr lang="ru">чередующиеся границы интервалов и вероятности границ</tr>
      </property>
      <!-- @weights -->
      <property name="@weights" type="list" access="readonly" default="">
        <tr lang="en">list of weights</tr>
        <tr lang="ru">список весов</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">generates a random number</tr>
          <tr lang="ru">генерирует случайное число</tr>
        </in>
        <in on="list">
          <tr lang="en">set new distribution values</tr>
          <tr lang="ru">задать новые значения распределения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">result value</tr>
          <tr lang="ru">значение результата</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                                         [array array1 size=100 yr=0..1]
|
[list.gen 1000]X[random.pw_const 0 1 1 0 2 2 3]
|
[list.histogram @bins 100]
|
[list.normalize @range]
|
[list.enumerate @append]
|
[list.repack 2]
|
[tabwrite array1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
