<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="random.pw_const">
        <title>random.pw_const</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">piecewise constant random distribution</tr>
                <tr lang="ru">кусочно-постоянное случайное распределение</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>random</category>
            <keywords>linear random piecewise const</keywords>
            <also>
                <see>random.linear</see>
                <see>random.pw_lin</see>
            </also>
            <since>0.4</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Produces random floating-point numbers, which are uniformly
                distributed within each of the several subintervals [b0, b1) , each with its own
                weight</tr>
            </par>
            <par>
                <tr lang="en">Const segments specified as: bound0, weight0, bound1, weight0, bound2
                etc</tr>
            </par>
            <par>
                <tr lang="en">Use @seed property to get reproducible sequences. If @seed property
                was not explicitly set or specified, uses generator initialized with current
                time.</tr>
            </par>
        </info>
        <arguments>
            <argument name="V" type="list">
                <tr lang="en">interleaved interval boundaries and boundary propabilities. Note:
                number of arguments should be odd and &gt;=5. Boundaries should be in strictly
                increasing order and weights should be non-negative</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @bounds -->
            <property name="@bounds" type="list" access="readonly" default="">
                <tr lang="en">list of boundaries</tr>
            </property>
            <!-- @seed -->
            <property name="@seed" type="int" minvalue="0" default="0">
                <tr lang="en">generator seed</tr>
            </property>
            <!-- @v -->
            <property name="@v" type="list" default="">
                <tr lang="en">interleaved interval boundaries and boundary propabilities.</tr>
            </property>
            <!-- @weights -->
            <property name="@weights" type="list" access="readonly" default="">
                <tr lang="en">list of weights</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">generates random number</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">set new distribution values</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result value</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]                                         [array array1 size=100 yr=0..1]
|
[list.gen 1000]X[random.pw_const 0 1 1 0 2 2 3]
|
[list.histogram @bins 100]
|
[list.normalize @range]
|
[list.enumerate @append]
|
[list.repack 2]
|
[tabwrite array1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
