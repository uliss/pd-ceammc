<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="system.screen_size">
    <title>system.screen_size</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">outputs the current screen size in pixels</tr>
        <tr lang="ru">выводит размер текущего экрана в пикселях</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>system</category>
      <keywords>screen info</keywords>
      <since>0.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">on bang, the object outputs a list of two integers: screen width and height
        in pixels</tr>
        <tr lang="ru">по bang объект выводит список из двух целых чисел: ширина и высота экрана в
        пикселях</tr>
      </par>
      <par>
        <tr lang="en">the screen size is reported by the operating system and corresponds to the
        primary display</tr>
        <tr lang="ru">размер экрана сообщается операционной системой и соответствует основному
        дисплею</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output screen size in pixels</tr>
          <tr lang="ru">вывести размер экрана в пикселях</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">list of two values: width and height</tr>
          <tr lang="ru">список из двух значений: ширина и высота</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bng]
|
[system.screen_size]
|
|
[ui.display]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
