<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="rhythm.hexbeat">
        <title>rhythm.hexbeat</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">hexbeat pattern generator</tr>
                <tr lang="ru">генератор ритмического паттерна по шестнадцатиричным значениям</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>music</category>
            <keywords>conv rhythm hexbeat</keywords>
            <since>0.9.7</since>
        </meta>
        <arguments>
            <argument name="HEX" type="symbol">
                <tr lang="en">init pattern value</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @hex -->
            <property name="@hex" type="symbol" default="">
                <tr lang="en">hex pattern</tr>
            </property>
            <!-- @pattern -->
            <property name="@pattern" type="list" default="" access="readonly">
                <tr lang="en">list pattern</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">output last pattern</xinfo>
                <xinfo on="symbol">set new pattern and output</xinfo>
                <xinfo on="list">output enumerated patterns for each list argument</xinfo>
            </inlet>
            <inlet>
                <xinfo on="symbol">set new pattern</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B] [symbol \#CEA4(             [T]
|   |                           |
|   [S digits=10]               [metro.pattern 100] [r hexpat]
|   |                           |                   |
[rhythm.hexbeat \#D1]           [list.walk @wrap    ]
|                               |
[t l l]                         [sel 1]
|   ^|                          |
|   [list.size]                 [click~]
|   |                           |
|   [@nitems $1, @size 150 15(  [flt.resonlp~ 1000 40]
|   |                           |
[ui.hrd* @nosave 1]             [ui.hgain~]         [ui.dsp~]
|                               |\
[s hexpat]                      [dac~]

[rhythm.hexbeat-list]
]]>
            </pdascii>
            <pdascii id="list">
<![CDATA[
[list \#1 \#2 \#4 \#8(
|
[rhythm.hexbeat]
|
[msg set row]
|
[ui.matrix 4 4]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
