<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="z~">
    <title>z~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">integer sample delay</tr>
        <tr lang="ru">целочисленная задержка сэмплов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>delay z</keywords>
      <since>0.9.5</since>
      <aliases>
        <alias>ceammc/z~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Delays the input audio signal by an integer number of samples. The delay
        length is set by the argument or by the @z property and can be changed at run time
        through the control inlet.</tr>
        <tr lang="ru">Задерживает входной аудиосигнал на целое число семплов. Длительность
        задержки задаётся аргументом или свойством @z и может изменяться во время выполнения
        через управляющий вход.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Sample-accurate alignment — compensating small timing offsets between two
        signals (for example, between a dry and a delayed path), with exact sample precision
        rather than millisecond resolution.</tr>
        <tr lang="ru">• Выравнивание с точностью до семпла — компенсация небольших смещений по
        времени между двумя сигналами (например, между прямым и задержанным трактом), с точностью
        именно до семпла, а не до миллисекунд.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Building feedback paths and comb filters — creating short comb-filter
        effects, Karplus-Strong strings or feedback delays by combining [z~] with a feedback
        loop.</tr>
        <tr lang="ru">• Построение цепей обратной связи и гребенчатых фильтров — создание коротких
        гребенчатых эффектов, струн Карплуса — Стронга или задержек с обратной связью путём
        комбинирования [z~] с петлёй обратной связи.</tr>
      </par>
    </info>
    <arguments>
      <argument name="Z" type="int" minvalue="0" maxvalue="512" units="sample">
        <tr lang="en">delay length</tr>
        <tr lang="ru">длительность задержки</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @z -->
      <property name="@z" type="int" minvalue="0" default="1" maxvalue="512" units="sample">
        <tr lang="en">delay length</tr>
        <tr lang="ru">длительность задержки</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="control">
        <in on="int">
          <tr lang="en">sets the delay length</tr>
          <tr lang="ru">устанавливает длительность задержки</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru">выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang #a(
|
[click~   ]
|         |
|         [z~ 1]
|         |
[*~ 0.5]  [*~ 0.5]
|         |
[plot.response~ 64 #b {i=2,o=3}]
*|*
*|*
[ui.plot~ {i=3} #z]














[ui.dsp~]
[X a->b:1]
#z @size 400 200 @xlabels 1 @ylabels 1 @xmin_grid 1 @ymin_ticks 0 @ymaj_ticks 0 @xmin_ticks 0 @ymin -2 @ymax 2 @n 2
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
