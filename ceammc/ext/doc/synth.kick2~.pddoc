<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="synth.kick2~">
        <title>synth.kick2~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">low-kick synth from Faust libraries</tr>
                <tr lang="ru">синтезатор бочки из библиотеки Faust</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>synth kick</keywords>
            <since>0.9.5</since>
            <also>
                <see>synth.kick~</see>
            </also>
        </meta>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @attack -->
            <property name="@attack" type="float" minvalue="5" maxvalue="400" default="20"
            units="millisecond">
                <tr lang="en">attack time</tr>
            </property>
            <!-- @click -->
            <property name="@click" type="float" default="20" minvalue="5" maxvalue="1000"
            units="millisecond">
                <tr lang="en">speed of the pitch envelope</tr>
            </property>
            <!-- @drive -->
            <property name="@drive" type="float" default="2.5" minvalue="1" maxvalue="10">
                <tr lang="en">gain multiplier going into the saturator</tr>
            </property>
            <!-- @envwait -->
            <property name="@envwait" type="bool" default="0">
                <tr lang="en">ignore new notes until previous note is not finished release
                time</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" default="44" minvalue="10" maxvalue="5000"
            units="hertz">
                <tr lang="en">base frequency</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">play trigger &gt;0: on, 0: off. To set output gain to 0.5 you can 0.5
                as trigger value</tr>
            </property>
            <!-- @release -->
            <property name="@release" type="float" minvalue="5" maxvalue="4000" default="100"
            units="millisecond">
                <tr lang="en">release time</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">reset synth</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">play with default duration and full gain</xinfo>
                <xinfo on="float">play with default duration and specified gain</xinfo>
                <xinfo on="list">GAIN(0..1) DUR(ms) pair expected</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">synth output</outlet>
            <outlet type="control">bang after release finished</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]    [F]   [ui.k #a]  [ui.k #b]    [ui.k #c]     [ui.k #d]   [ui.k #e]
|      |.    |          |            |             |           |
[metro 1000] |          |            |             |           |
|            |          |            |             |           |
|            [@freq $1( [@attack $1( [@release $1( [@drive $1( [@click $1(
|            |          |            |             |           |
|            |          |            |             |           |
|            |          |            |             |           |
[synth.kick2~                                                  ]
|               ^|
|               [B]
|
[ui.hgain~]     [ui.dsp~]
| \
[dac~]

#a 20 500 @show_value 1
#b 5 100 @show_value 1
#c 5 500 @show_value 1
#d 1 10  @show_value 1
#e 5 100 @show_value 1
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
