<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="xfade2~">
    <title>xfade2~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">multichannel cross-fade for stereo signals</tr>
        <tr lang="ru">многоканальный кроссфейд для стерео сигналов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>crossfade xfade</keywords>
      <also>
        <see>xfade~</see>
      </also>
      <since>0.6</since>
      <aliases>
        <alias>ceammc/xfade2~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">control float value in range [0-1) controls xfade between first and second
        signals, [1-2) between second and third etc.</tr>
        <tr lang="ru" finished="false">Управление значением поплавка в диапазоне [0-1] управляет
        xfade между первым и вторым сигналами, [1-2) между вторым и третьим и т.д.</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="2" maxvalue="16">
        <tr lang="en">number of signal inputs stereo pairs</tr>
        <tr lang="ru" finished="false">количество входных сигналов стереопар</tr>
      </argument>
      <argument name="X" type="float">
        <tr lang="en">crossfade init value. Valid value in [0..N-1] range. See @x property</tr>
        <tr lang="ru" finished="false">Crossfade init значение. Действительное значение в диапазоне
        [0..N-1]. См. @x Property</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @lin -->
      <property name="@lin" type="alias">
        <tr lang="en">alias to @type lin</tr>
        <tr lang="ru" finished="false">Исполнитель: @type lin</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" default="2" access="initonly" minvalue="2" maxvalue="16">
        <tr lang="en">number of xfade inputs stereo pairs</tr>
        <tr lang="ru" finished="false">Количество входов xfade стереопар</tr>
      </property>
      <!-- @pow -->
      <property name="@pow" type="alias">
        <tr lang="en">alias to @type pow</tr>
        <tr lang="ru" finished="false">Исполнитель: @type Pow</tr>
      </property>
      <!-- @smooth -->
      <property name="@smooth" type="float" minvalue="1" default="20" units="millisecond">
        <tr lang="en">signal change smooth time</tr>
        <tr lang="ru" finished="false">Изменение сигнала плавное время</tr>
      </property>
      <!-- @type -->
      <property name="@type" type="symbol" enum="lin pow" default="pow">
        <tr lang="en">fade curve type: linear or power</tr>
        <tr lang="ru" finished="false">Тип кривой выцветания: линейный или силовой</tr>
      </property>
      <!-- @x -->
      <property name="@x" type="float" default="0">
        <tr lang="en">crossfade property. Valid value in [0..N-1] range.</tr>
        <tr lang="ru" finished="false">Кроссфейд собственность. Действительное значение в диапазоне
        [0..N-1].</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet type="audio" number="1">
        <in>
          <tr lang="en">left input signal</tr>
          <tr lang="ru" finished="false">левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="2">
        <in>
          <tr lang="en">right input signal</tr>
          <tr lang="ru" finished="false">правильный входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">left input signal</tr>
          <tr lang="ru" finished="false">левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">right input signal</tr>
          <tr lang="ru" finished="false">правильный входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n-1">
        <in>
          <tr lang="en">left input signal</tr>
          <tr lang="ru" finished="false">левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">right input signal</tr>
          <tr lang="ru" finished="false">правильный входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="control" number="n+1">
        <in on="float">
          <tr lang="en">set crossfade value</tr>
          <tr lang="ru" finished="false">значение crossfade</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left output signal</tr>
          <tr lang="ru" finished="false">левый выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right output signal</tr>
          <tr lang="ru" finished="false">правильный выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[osc~ 440]    [osc~ 1000]   [ui.knob]
|             |             |
| [osc~ 441]  | [osc~ 1002] |
| |           |   |         |
| |           |   |         [F]
| |.          |.. |...      |....
[xfade2~ 2                        ]
|  ^|
|   |   [ui.slider @size 120 16]
|   |.  |..
[gain~   2]
| ^|.
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
