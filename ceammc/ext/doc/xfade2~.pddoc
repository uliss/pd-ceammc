<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="xfade2~">
    <title>xfade2~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">multichannel cross-fade for stereo signals</tr>
        <tr lang="ru">многоканальный кроссфейд для стереосигналов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>crossfade xfade</keywords>
      <also>
        <see>xfade~</see>
      </also>
      <since>0.6</since>
      <aliases>
        <alias>ceammc/xfade2~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Stereo version of [xfade~]. Each input is a stereo pair (left, right). The
        control float value in the range [0, N−1] selects the crossfade between the stereo
        inputs: [0, 1) fades between the first and second stereo pair, [1, 2) between the second
        and third, and so on. The output is a stereo signal.</tr>
        <tr lang="ru">Стереоверсия [xfade~]. Каждый вход — это стереопара (левый, правый).
        Управляющее значение на входе в диапазоне [0, N−1] задаёт кроссфейд между стереовходами:
        [0, 1) — переход между первой и второй стереопарой, [1, 2) — между второй и третьей,
        и т. д. На выходе — стереосигнал.</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="2" maxvalue="16">
        <tr lang="en">number of stereo input pairs</tr>
        <tr lang="ru">число стереопар на входе</tr>
      </argument>
      <argument name="X" type="float">
        <tr lang="en">crossfade initial value. Valid value in the [0, N−1] range. See the @x
        property</tr>
        <tr lang="ru">начальное значение кроссфейда. Допустимое значение в диапазоне [0, N−1].
        См. свойство @x</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @lin -->
      <property name="@lin" type="alias">
        <tr lang="en">alias for @type lin</tr>
        <tr lang="ru">сокращение для @type lin</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" default="2" access="initonly" minvalue="2" maxvalue="16">
        <tr lang="en">number of stereo input pairs</tr>
        <tr lang="ru">число стереопар на входе</tr>
      </property>
      <!-- @pow -->
      <property name="@pow" type="alias">
        <tr lang="en">alias for @type pow</tr>
        <tr lang="ru">сокращение для @type pow</tr>
      </property>
      <!-- @smooth -->
      <property name="@smooth" type="float" minvalue="1" default="20" units="millisecond">
        <tr lang="en">signal change smooth time</tr>
        <tr lang="ru">время сглаживания при изменении сигнала</tr>
      </property>
      <!-- @type -->
      <property name="@type" type="symbol" enum="lin pow" default="pow">
        <tr lang="en">fade curve type: linear or power</tr>
        <tr lang="ru">тип кривой кроссфейда: линейная или степенная</tr>
      </property>
      <!-- @x -->
      <property name="@x" type="float" default="0">
        <tr lang="en">crossfade value. Valid value in the [0, N−1] range.</tr>
        <tr lang="ru">значение кроссфейда. Допустимое значение в диапазоне [0, N−1]</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet type="audio" number="1">
        <in>
          <tr lang="en">left input signal</tr>
          <tr lang="ru">левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="2">
        <in>
          <tr lang="en">right input signal</tr>
          <tr lang="ru">правый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">left input signal</tr>
          <tr lang="ru">левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">right input signal</tr>
          <tr lang="ru">правый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n-1">
        <in>
          <tr lang="en">left input signal</tr>
          <tr lang="ru">левый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">right input signal</tr>
          <tr lang="ru">правый входной сигнал</tr>
        </in>
      </inlet>
      <inlet type="control" number="n+1">
        <in on="float">
          <tr lang="en">sets the crossfade value</tr>
          <tr lang="ru">устанавливает значение кроссфейда</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left output signal</tr>
          <tr lang="ru">левый выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right output signal</tr>
          <tr lang="ru">правый выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[osc~ 440]    [osc~ 1000]   [ui.knob]
|             |             |
| [osc~ 441]  | [osc~ 1002] |
| |           |   |         |
| |           |   |         [F]
| |.          |.. |...      |....
[xfade2~ 2                        ]
|  ^|
|   |   [ui.slider @size 120 16]
|   |.  |..
[gain~   2]
| ^|.
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
