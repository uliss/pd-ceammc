<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="list.slice">
        <title>list.slice</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs a sublist</tr>
                <tr lang="ru">выводит подсписок</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list slice sublist</keywords>
            <since>0.2</since>
            <also>
                <see>list.at</see>
            </also>
        </meta>
        <arguments>
            <argument name="FROM" type="int">
                <tr lang="en">@from property</tr>
            </argument>
            <argument name="TO" type="int">
                <tr lang="en">@to property</tr>
            </argument>
            <argument name="STEP" type="int" minvalue="0">
                <tr lang="en">@step property</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @from -->
            <property name="@from" type="int" default="0">
                <tr lang="en">start slice position. You can use negative index to address elements
                from the end</tr>
            </property>
            <!-- @step -->
            <property name="@step" type="int" default="1" minvalue="0">
                <tr lang="en">slice step</tr>
            </property>
            <!-- @to -->
            <property name="@to" type="int" default="-1">
                <tr lang="en">end slice position. You can use negative index to address elements
                from the end</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output sublist</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[list A B C D E(    [list A B C D E(   [list A B C D E(
|                   |                  |
[list.slice 2]      [list.slice 2 4]   [list.slice 0 5 2]
|                   |                  |
[ui.dt]             [ui.dt]            [ui.dt]

[list A B C D E(    [list A B C D E(
|                   |
[list.slice -2]     [list.slice -4 -1]
|                   |
[ui.dt]             [ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
