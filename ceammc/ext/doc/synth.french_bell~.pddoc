<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="synth.french_bell~">
    <title>synth.french_bell~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">french church bell modal model</tr>
        <tr lang="ru">модовый синтез модели французского церковного колокола</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>synth</category>
      <keywords>bell church french</keywords>
      <since>0.9.4</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Modeled after D. Bartocha and . Baron, Influence of Tin Bronze Melting and
        Pouring Parameters on Its Properties and Bell' Tone, Archives of Foundry Engineering,
        2016</tr>
        <tr lang="ru" finished="false">По образцу Д. Барточи и . Baron, Influence of Tin Bronze
        Melting and Pouring Parameters on Its Properties and Bell' Tone, Archives of Foundry
        Engineering, 2016</tr>
      </par>
      <par>
        <tr lang="en">Model height is 1m</tr>
        <tr lang="ru" finished="false">Высота модели 1м</tr>
      </par>
      <par>
        <tr lang="en">This model contains 7 excitation positions going linearly from the bottom to
        the top of the bell</tr>
        <tr lang="ru" finished="false">Эта модель содержит 7 положений возбуждения, линейно идущих
        от низа к верхней части колокола.</tr>
      </par>
    </info>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @cutoff -->
      <property name="@cutoff" type="float" minvalue="20" maxvalue="20000" default="4000"
      units="hertz">
        <tr lang="en">strike cutoff frequency</tr>
        <tr lang="ru" finished="false">частота остановки забастовки</tr>
      </property>
      <!-- @decay_ratio -->
      <property name="@decay_ratio" type="float" minvalue="0" maxvalue="1" default="1">
        <tr lang="en">decay ratio</tr>
        <tr lang="ru" finished="false">коэффициент разложения</tr>
      </property>
      <!-- @decay_slope -->
      <property name="@decay_slope" type="float" minvalue="0" maxvalue="10" default="3">
        <tr lang="en">decay slope</tr>
        <tr lang="ru" finished="false">склон</tr>
      </property>
      <!-- @gain -->
      <property name="@gain" type="float" minvalue="0" maxvalue="1" default="1">
        <tr lang="en">strike gain</tr>
        <tr lang="ru" finished="false">забастовка</tr>
      </property>
      <!-- @gate -->
      <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
        <tr lang="en">play trigger - 1: on, 0: off</tr>
        <tr lang="ru" finished="false">играть триггер - 1: on, 0: off</tr>
      </property>
      <!-- @pos -->
      <property name="@pos" type="int" minvalue="0" maxvalue="6" default="0">
        <tr lang="en">strike position (0 is on the bottom)</tr>
        <tr lang="ru" finished="false">Ударная позиция (0 находится внизу)</tr>
      </property>
      <!-- @sharp -->
      <property name="@sharp" type="float" minvalue="0.01" maxvalue="5" default="0.25">
        <tr lang="en">strike sharpness</tr>
        <tr lang="ru" finished="false">резкость удара</tr>
      </property>
      <!-- @t60 -->
      <property name="@t60" type="float" minvalue="0.1" maxvalue="30" default="20" units="second">
        <tr lang="en">time to decay to -60db level</tr>
        <tr lang="ru" finished="false">Время распада до уровня -60 дБ</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset synth</tr>
          <tr lang="ru" finished="false">Сбросить синтезатор</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">play</tr>
          <tr lang="ru" finished="false">играть</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru" finished="false">выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]            [ui.dsp~]
|
[metro 1000]
|
[@gate 1(
|
[msg.after 300 @gate 0]
|
[msg synth.french_bell]
|
[gsynth.french_bell~ {i=1,o=1}]
|
|
|
|
|
|
|
|
|
|
|
|
|
|
|
|
|
|
[ui.gain~ @size 120 16]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
