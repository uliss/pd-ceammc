<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="midi.cc">
    <title>midi.cc</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">enhanced version of vanilla [ctlin]</tr>
        <tr lang="ru">расширенная версия стандартного объекта [ctlin]</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>midi</category>
      <keywords>midi controller name cc ctlin</keywords>
      <since>0.9.2</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object receives the value of the specified MIDI controller and rescales
        it from the range 0..127 to the range @min..@max using the @curve response</tr>
        <tr lang="ru">объект принимает значение указанного MIDI-контроллера и пересчитывает его из
        диапазона 0..127 в диапазон @min..@max с учётом кривой @curve</tr>
      </par>
      <par>
        <tr lang="en">@ch selects the MIDI channel, @cc sets the controller number</tr>
        <tr lang="ru">@ch выбирает MIDI-канал, @cc задаёт номер контроллера</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to map a MIDI controller to any parameter range, for
        example to map a mod wheel to a filter cutoff or to a volume level</tr>
        <tr lang="ru">объект можно использовать для привязки MIDI-контроллера к любому диапазону
        параметра, например чтобы привязать колесо модуляции к срезу фильтра или к уровню
        громкости</tr>
      </par>
    </info>
    <arguments>
      <argument name="CC" type="int" minvalue="0" maxvalue="127">
        <tr lang="en">controller number</tr>
        <tr lang="ru">номер контроллера</tr>
      </argument>
      <argument name="MIN" type="float">
        <tr lang="en">@min value</tr>
        <tr lang="ru">значение @min</tr>
      </argument>
      <argument name="MAX" type="float">
        <tr lang="en">@max value</tr>
        <tr lang="ru">значение @max</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @cc -->
      <property name="@cc" type="int" default="0" minvalue="0" maxvalue="127">
        <tr lang="en">controller number</tr>
        <tr lang="ru">номер контроллера</tr>
      </property>
      <!-- @ch -->
      <property name="@ch" type="int" default="0" minvalue="0" maxvalue="16">
        <tr lang="en">MIDI channel</tr>
        <tr lang="ru">MIDI-канал</tr>
      </property>
      <!-- @curve -->
      <property name="@curve" type="float" default="0">
        <tr lang="en">output response curve. If @curve&lt;0 the response starts fast and ends slow,
        if @curve&gt;0 it starts slow and ends fast, if @curve==0 the response is linear</tr>
        <tr lang="ru">кривая отклика на выходе. Если @curve&lt;0, отклик начинается быстро и
        заканчивается медленно, если @curve&gt;0 — начинается медленно и заканчивается быстро, если
        @curve==0 — отклик линейный</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="float" default="127">
        <tr lang="en">output value when MIDI input is 127</tr>
        <tr lang="ru">выходное значение при входном MIDI-значении 127</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="float" default="0">
        <tr lang="en">output value when MIDI input is 0</tr>
        <tr lang="ru">выходное значение при входном MIDI-значении 0</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control input</tr>
          <tr lang="ru">вход управления</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">controller value</tr>
          <tr lang="ru">значение контроллера</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]      [F]
|        |
[@cc $1( [@curve $1(
|        |
[midi.cc 10 @min 0 @max 1 @curve -2]
|
[ui.hsl]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
