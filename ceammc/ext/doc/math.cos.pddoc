<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="math.cos">
    <title>math.cos</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">cosine function</tr>
        <tr lang="ru">функция косинуса</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>math</category>
      <keywords>math cos</keywords>
      <also>
        <see>math.sin</see>
        <see>math.tan</see>
        <see>math.asin</see>
        <see>math.acos</see>
      </also>
      <since>0.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The cos() function computes the cosine of input value (measured in
        radians).</tr>
        <tr lang="ru" finished="false">Функция cos() вычисляет косинус входного значения (в
        радианах).</tr>
      </par>
      <par>
        <tr lang="en">Special values:</tr>
        <tr lang="ru">Особые значения:</tr>
      </par>
      <par>
        <tr lang="en">cos(±0) returns 1.</tr>
        <tr lang="ru">cos(±0) возвращает 1.</tr>
      </par>
      <par>
        <tr lang="en">cos(±infinity) returns a NaN</tr>
        <tr lang="ru">cos(±infinity) возвращает NaN</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input value</tr>
          <tr lang="ru">входное значение</tr>
        </in>
        <in on="list">
          <tr lang="en">list of numeric values</tr>
          <tr lang="ru">список входных значений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">the result</tr>
          <tr lang="ru">результат</tr>
        </out>
        <out type="list">
          <tr lang="en">the result list</tr>
          <tr lang="ru">список результатов</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang(                 [array \$0-cos yr=-1..1 w=320]
|
[list.seq -6 6 0.025]
|
[math.cos]
|
[list->array \$0-cos]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
