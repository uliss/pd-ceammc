<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.cos">
        <title>math.cos</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">cosine function</tr>
                <tr lang="ru">функция косинуса</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math cos</keywords>
            <also>
                <see>math.sin</see>
                <see>math.tan</see>
                <see>math.asin</see>
                <see>math.acos</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The cos() function computes the cosine of input value (measured in
                radians).</tr>
                <!-- old: Функция cos() вычисляет косинус входного значения
                (измеряется в радианах). -->
                <tr lang="ru" finished="false">Функция cos() вычисляет косинус входного значения
                (измеряется в радианах).</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
                <tr lang="ru" finished="false">Особые ценности:</tr>
            </par>
            <par>
                <tr lang="en">cos(+-0) returns 1.</tr>
                <tr lang="ru" finished="false">cos(+-0) возвращается 1.</tr>
            </par>
            <par>
                <tr lang="en">cos(+-infinity) returns a NaN and raises the "invalid" floating-point
                exception.</tr>
                <!-- old: cos(+-infinity) возвращает NaN и поднимает
                «недействительное» исключение из плавающей точки. -->
                <tr lang="ru" finished="false">cos(+-infinity) возвращает NaN и поднимает
                «недействительное» исключение из плавающей точки.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input value</tr>
                    <tr lang="ru" finished="false">входная стоимость</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">apply to all numeric values</tr>
                    <tr lang="ru" finished="false">применяется ко всем числовым значениям</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result value</tr>
                    <tr lang="ru" finished="false">значение результата</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[math.cos]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
