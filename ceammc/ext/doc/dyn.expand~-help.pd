#X msg 110 678 @id;
#X text 245 678 (initonly) Get/Set OSC address id. If specified \,
bind all properties to /ID/dyn_expand/PROP_NAME osc address \, if empty
bind to /dyn_expand/PROP_NAME. Type: symbol.;
#X msg 110 735 @osc;
#X text 245 735 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 110 765 @active;
#X text 245 765 Turn on/off object dsp processing. Type: bool. Default
value: 1\.;
#X msg 110 807 @attack;
#X text 245 807 Get/Set time constant when expander is turning on.
Type: float. Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 110 849 @bypass;
#X text 245 849 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 110 891 @hold;
#X text 245 891 Get/Set hold period. Type: float. Units: 'samp'. Default
value: 128\. Range: 1\...255\.;
#X msg 110 933 @knee;
#X text 245 933 Get/Set a gradual increase in gain reduction around
the threshold: below thresh-(knee/2) there is no gain reduction \,
above thresh+(knee/2) there is the same gain reduction as without a
knee \, and in between there is a gradual increase in gain reduction.
Type: float. Units: 'db'. Default value: 3\. Range: 0\...6\.;
#X msg 110 1051 @range;
#X text 245 1051 Get/Set max expand range. Type: float. Units: 'db'.
Default value: -120\. Range: -120\...0\.;
#X msg 110 1093 @refresh;
#X text 245 1093 Get/Set expander level output time interval. If 0
- no output. Type: int. Units: 'ms'. Default value: 100\. Range: 0\...1000\.;
#X msg 110 1150 @release;
#X text 245 1150 Get/Set release time = time constant coming out of
expanding. Type: float. Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 110 1207 @strength;
#X text 245 1207 Get/Set expander strength (0: no expanding \, 1: increase
level by @range db.). Type: float. Default value: 0\. Range: 0\...10\.;
#X msg 110 1264 @threshold;
#X text 245 1264 Get/Set level threshold above which compression kicks
in (100 dB = max level). Type: float. Units: 'db'. Default value: -48\.
Range: -60\...0\.;
#X msg 110 1321 @level?;
#X text 245 1321 (readonly) Get current expander level. Type: float.
Units: 'db'. Default value: 0\. Range: 0\...90\.;
