#X msg 130 610 @id;
#X text 270 610 (initonly) Get/Set OSC address id. If specified \,
bind all properties to /ID/dyn_expand/PROP_NAME osc address \, if empty
bind to /dyn_expand/PROP_NAME. Type: symbol.;
#X msg 130 667 @osc;
#X text 270 667 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 130 697 @active;
#X text 270 697 Turn on/off object dsp processing. Type: bool. Default
value: 1\.;
#X msg 130 739 @attack;
#X text 270 739 Get/Set time constant when expander is turning on.
Type: float. Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 130 781 @bypass;
#X text 270 781 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 130 823 @hold;
#X text 270 823 Get/Set hold period. Type: float. Units: 'samp'. Default
value: 128\. Range: 1\...255\.;
#X msg 130 865 @knee;
#X text 270 865 Get/Set a gradual increase in gain reduction around
the threshold: below thresh-(knee/2) there is no gain reduction \,
above thresh+(knee/2) there is the same gain reduction as without a
knee \, and in between there is a gradual increase in gain reduction.
Type: float. Units: 'db'. Default value: 3\. Range: 0\...6\.;
#X msg 130 983 @range;
#X text 270 983 Get/Set max expand range. Type: float. Units: 'db'.
Default value: -120\. Range: -120\...0\.;
#X msg 130 1025 @refresh;
#X text 270 1025 Get/Set expander level output time interval. If 0
- no output. Type: int. Units: 'ms'. Default value: 100\. Range: 0\...1000\.;
#X msg 130 1082 @release;
#X text 270 1082 Get/Set release time = time constant coming out of
expanding. Type: float. Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 130 1139 @strength;
#X text 270 1139 Get/Set expander strength (0: no expanding \, 1: increase
level by @range db.). Type: float. Default value: 0\. Range: 0\...10\.;
#X msg 130 1196 @threshold;
#X text 270 1196 Get/Set level threshold above which compression kicks
in (100 dB = max level). Type: float. Units: 'db'. Default value: -48\.
Range: -60\...0\.;
#X msg 130 1253 @level?;
#X text 270 1253 (readonly) Get current expander level. Type: float.
Units: 'db'. Default value: 0\. Range: 0\...90\.;
