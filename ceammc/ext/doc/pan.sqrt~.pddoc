<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="pan.sqrt~">
    <title>pan.sqrt~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">two-channel equal power square root panner</tr>
        <tr lang="ru">двухканальный панорамный регулятор равной мощности на основе квадратного
        корня</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>spat</category>
      <keywords>pan span</keywords>
      <since>0.5</since>
      <also>
        <see>pan.lin~</see>
        <see>pan.cos~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Two-channel equal power panner. The center reduction is about 3dB. With
        linear panning ([pan.lin~]), the signal level decreases as it approaches the center using a
        straight line from ±1 (left or right) to 0 (center), resulting in a 6dB reduction in the
        middle.</tr>
        <tr lang="ru">Двухканальный панорамный регулятор равной мощности. Снижение уровня в центре
        составляет около 3 дБ. При линейном панорамировании ([pan.lin~]) уровень сигнала
        уменьшается по мере приближения к центру по прямой линии от ±1 (лево или право) до 0
        (центр), что приводит к снижению на 6 дБ в середине.</tr>
      </par>
      <par>
        <tr lang="en">A problem inherent to linear panning is that the perceived volume of the
        signal drops in the middle. [pan.sqrt~] solves this.</tr>
        <tr lang="ru">Проблема, присущая линейному панорамированию, заключается в том, что
        воспринимаемая громкость сигнала падает в центре. [pan.sqrt~] решает эту проблему.</tr>
      </par>
    </info>
    <arguments>
      <argument name="POS" type="float" minvalue="-1" maxvalue="1">
        <tr lang="en">panning position. -1 means left, 0 means center, +1 means right.</tr>
        <tr lang="ru">позиция панорамирования. -1 означает левый канал, 0 — центр, +1 — правый
        канал.</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @pos -->
      <property name="@pos" type="float" minvalue="-1" maxvalue="1" default="0">
        <tr lang="en">panning position. -1 means left, 0 means center, +1 means right.</tr>
        <tr lang="ru">позиция панорамирования. -1 означает левый канал, 0 — центр, +1 — правый
        канал.</tr>
      </property>
      <!-- @smooth -->
      <property name="@smooth" type="int" minvalue="0" maxvalue="100" default="20"
      access="initonly">
        <tr lang="en">smoothing of the control signal to avoid zipper noise.</tr>
        <tr lang="ru">сглаживание управляющего сигнала для предотвращения шума квантования.</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float" minvalue="-1" maxvalue="1">
          <tr lang="en">pan position</tr>
          <tr lang="ru">позиция панорамирования</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left output channel</tr>
          <tr lang="ru">левый выходной канал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right output channel</tr>
          <tr lang="ru">правый выходной канал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
          [hsl]
          |
          [lin->lin 0 127 -1 1]
          |
[sig~ 1]  [F]
|         |.
[pan.sqrt~  ]
|       ^|
[env~]   [env~]
|        |
[F]      [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
