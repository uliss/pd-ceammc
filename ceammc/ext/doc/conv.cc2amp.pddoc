<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.cc2amp">
    <title>conv.cc2amp</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts from MIDI Control Change range</tr>
        <tr lang="ru">преобразует из диапазона MIDI Control Change</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv cc amp</keywords>
      <since>0.3</since>
      <also>
        <see>lin-&gt;lin</see>
        <see>lin-&gt;curve</see>
      </also>
      <aliases>
        <alias>ceammc/cc-&gt;amp</alias>
        <alias>cc-&gt;amp</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts a value from the MIDI Control Change range [0, 127] to
        an arbitrary output range. By default the output range is [0, 1], which is convenient for
        using the result as an amplitude, gain or any other normalized control value. The output
        range can be changed with the FROM and TO arguments or the @from and @to properties.</tr>
        <tr lang="ru">Объект преобразует значение из диапазона MIDI Control Change [0, 127] в
        произвольный выходной диапазон. По умолчанию выходной диапазон — [0, 1], что удобно для
        использования результата в качестве амплитуды, усиления или любого другого
        нормализованного управляющего значения. Выходной диапазон можно изменить с помощью
        аргументов FROM и TO или свойств @from и @to.</tr>
      </par>
    </info>
    <arguments>
      <argument name="FROM" type="float">
        <tr lang="en">start value of the output range</tr>
        <tr lang="ru">начальное значение выходного диапазона</tr>
      </argument>
      <argument name="TO" type="float">
        <tr lang="en">end value of the output range</tr>
        <tr lang="ru">конечное значение выходного диапазона</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @from -->
      <property name="@from" type="float" default="0">
        <tr lang="en">start value of the output range</tr>
        <tr lang="ru">начальное значение выходного диапазона</tr>
      </property>
      <!-- @to -->
      <property name="@to" type="float" default="1">
        <tr lang="en">end value of the output range</tr>
        <tr lang="ru">конечное значение выходного диапазона</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">value in MIDI CC range [0, 127]</tr>
          <tr lang="ru">значение в диапазоне MIDI CC [0, 127]</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">converted value</tr>
          <tr lang="ru">преобразованное значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F min=0 max=127]
|
|   [ctlin 0]   [F min=0 max=127]
|   |           |
[cc->amp]       [cc->amp @from 1 @to -1]
|               |
[F]             [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
