<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="prop.route~">
        <title>prop.route~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">property extractor from audio connections</tr>
                <tr lang="ru">отделяет свойства от аудиосоединений</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>property</category>
            <keywords>property</keywords>
            <since>0.6</since>
            <aliases>
                <alias>prop~&gt;</alias>
                <alias>@~&gt;</alias>
                <alias>ceammc/prop~&gt;</alias>
                <alias>ceammc/@~&gt;</alias>
                <alias deprecated="true">prop.get~</alias>
            </aliases>
            <also>
                <see>prop-&gt;</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Extracts properties from audio stream with matching. Non property
                values are passed untouched.</tr>
            </par>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo on="any">
                    <tr lang="en">input values and sound</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">passed values and sound</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">first matched property output</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">others matched property output</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">unmatched property output</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[osc~ 440] [@db?( [@size?( [@amp?(
|          |      |        |
[ui.gain~ @size 160 16     ]   [ui.dsp~]
|
[prop~> @db  ]
|    ^|   ^^|
|    |      [ui.dt]
|    |
|   [ui.dt]
|
[ui.scope~ @size 200 40]



/*...*/
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
