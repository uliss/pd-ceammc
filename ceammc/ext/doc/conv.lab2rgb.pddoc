<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.lab2rgb">
    <title>conv.lab2rgb</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">convert LAB color values to RGB</tr>
        <tr lang="ru">преобразует цветовые значения из LAB в RGB</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv color lab rgb</keywords>
      <since>0.9.7</since>
      <aliases>
        <alias>ceammc/lab-&gt;rgb</alias>
        <alias>lab-&gt;rgb</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts CIELAB color values (L*, a*, b*) to RGB values. The L*
        component (lightness) is given in the range [0, 1], and the a* and b* components
        (chromaticity) are given in the range [-1, 1]. By default the RGB values are output as
        integers in the range [0, 255]; with the @float flag they are output as floats in the range
        [0, 1]. By default the three channel values are sent to three separate outlets; if the
        @pack flag is set, they are packed into a single list sent to the first outlet. With the
        @sync flag, the object outputs a new value whenever any inlet changes.</tr>
        <tr lang="ru">Объект преобразует цветовые значения CIELAB (L*, a*, b*) в значения RGB.
        Компонента L* (светлота) задаётся в диапазоне [0, 1], а компоненты a* и b* (цветность) —
        в диапазоне [-1, 1]. По умолчанию значения RGB выводятся как целые числа в диапазоне
        [0, 255]; при флаге @float они выводятся как числа с плавающей точкой в диапазоне
        [0, 1]. По умолчанию три значения каналов отправляются на три отдельных выхода; если
        установлен флаг @pack, они упаковываются в один список и отправляются на первый выход.
        При флаге @sync объект выводит новое значение при любом изменении на любом входе.</tr>
      </par>
      <wiki name="CIELAB_color_space">CIELAB color space</wiki>
    </info>
    <properties>
      <!-- @float -->
      <property name="@float" type="alias">
        <tr lang="en">alias to @mode float. Output float values in the [0, 1] range</tr>
        <tr lang="ru">сокращение для @mode float. Выводить значения с плавающей точкой в диапазоне
        [0, 1]</tr>
      </property>
      <!-- @int -->
      <property name="@int" type="alias">
        <tr lang="en">alias to @mode int. Output integer values in the [0, 255] range</tr>
        <tr lang="ru">сокращение для @mode int. Выводить целые числа в диапазоне [0, 255]</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" default="int" enum="int float">
        <tr lang="en">output mode</tr>
        <tr lang="ru">режим вывода</tr>
      </property>
      <!-- @pack -->
      <property name="@pack" type="flag" access="initonly">
        <tr lang="en">output as a list (creates a single-outlet object)</tr>
        <tr lang="ru">выводить в виде списка (создаёт объект с одним выходом)</tr>
      </property>
      <!-- @sync -->
      <property name="@sync" type="flag" access="initonly">
        <tr lang="en">output on any inlet change</tr>
        <tr lang="ru">выводить при любом изменении на входе</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output the current value</tr>
          <tr lang="ru">вывести текущее значение</tr>
        </in>
        <in on="float" minvalue="0" maxvalue="1">
          <tr lang="en">set color L* component and output</tr>
          <tr lang="ru">установить компоненту L* цвета и вывести</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float" minvalue="-1" maxvalue="1">
          <tr lang="en">set color a* component without output</tr>
          <tr lang="ru">установить компоненту a* цвета без вывода</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float" minvalue="-1" maxvalue="1">
          <tr lang="en">set color b* component without output</tr>
          <tr lang="ru">установить компоненту b* цвета без вывода</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet>
        <out type="any">
          <tr lang="en">list: R G B, or red channel value (int[0, 255] or float[0, 1])</tr>
          <tr lang="ru">список: R G B, или значение красного канала (int[0, 255] или float[0, 1])</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">int[0, 255] or float[0, 1]: green channel value</tr>
          <tr lang="ru">int[0, 255] или float[0, 1]: значение зелёного канала</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">int[0, 255] or float[0, 1]: blue channel value</tr>
          <tr lang="ru">int[0, 255] или float[0, 1]: значение синего канала</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.hsl #L]

         [ui.hsl #A]

 [bang(              [ui.hsl #B]
 |
[lab->rgb @sync @float @pack #z]
|  |
|  [ui.dt]
|
|
[msg @background_color]
|
[ui.t @size 40 40 @nosave 1]

[X L->z]
[X A->z:1]
[X B->z:2]

#L @label L*  @label_inner 1 @show_value 1 @label_color 0.1 0.25 1
#A -1 1 @label a*   @label_inner 1 @show_value 1 @label_color 0.1 0.25 1
#B -1 1 @label b*   @label_inner 1 @show_value 1 @label_color 0.1 0.25 1
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
