<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="conv.lab2rgb">
        <title>conv.lab2rgb</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert LAB color values to RGB</tr>
                <tr lang="ru">преобразование цветовых значений из LAB в RGB</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv color lab rgb</keywords>
            <since>0.9.7</since>
            <aliases>
                <alias>ceammc/lab-&gt;rgb</alias>
                <alias>lab-&gt;rgb</alias>
            </aliases>
        </meta>
        <info>
            <wiki name="CIELAB_color_space">CIELAB color space</wiki>
        </info>
        <properties>
            <!-- @float -->
            <property name="@float" type="alias">
                <tr lang="en">alias to @mode float. Output float values in [0-1] range</tr>
                <tr lang="ru" finished="false">Оригинальное название: Mode Float. Значения
                выходного поплавка в [0-1] диапазоне</tr>
            </property>
            <!-- @int -->
            <property name="@int" type="alias">
                <tr lang="en">alias to @mode int. Output integer values in [0-255] range</tr>
                <tr lang="ru" finished="false">@mode int. Вывод целых чисел в диапазоне
                [0-255]</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" default="int" enum="int float">
                <tr lang="en">output mode</tr>
                <tr lang="ru" finished="false">выходной режим</tr>
            </property>
            <!-- @pack -->
            <property name="@pack" type="flag" access="initonly">
                <tr lang="en">output as list (creates single outlet object)</tr>
                <tr lang="ru" finished="false">вывод в виде списка (создает единый выходной
                объект)</tr>
            </property>
            <!-- @sync -->
            <property name="@sync" type="flag" access="initonly">
                <tr lang="en">output at any inlet change</tr>
                <tr lang="ru" finished="false">выход при любом входном изменении</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output current value</tr>
                </xinfo>
                <xinfo on="float" minvalue="0" maxvalue="1">
                    <tr lang="en">set color L-component and output</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float" minvalue="-1" maxvalue="1">
                    <tr lang="en">set color a*-component</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float" minvalue="-1" maxvalue="1">
                    <tr lang="en">set color b*-component</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet>list: R G B or red channel value (int[0-255] or float[0-1])</outlet>
            <outlet>int[0-255] or float[0-1]: green channel value</outlet>
            <outlet>int[0-255] or float[0-1]: blue channel value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.hsl #L]

         [ui.hsl #A]

 [bang(              [ui.hsl #B]
 |
[lab->rgb @sync @float @pack #z]
|  |
|  [ui.dt]
|
|
[msg @background_color]
|
[ui.t @size 40 40 @nosave 1]

[X L->z]
[X A->z:1]
[X B->z:2]

#L @label L*  @label_inner 1 @show_value 1 @label_color 0.1 0.25 1
#A -1 1 @label a*   @label_inner 1 @show_value 1 @label_color 0.1 0.25 1
#B -1 1 @label b*   @label_inner 1 @show_value 1 @label_color 0.1 0.25 1
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
