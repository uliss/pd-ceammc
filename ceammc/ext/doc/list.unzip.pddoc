<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.unzip">
        <title>list.unzip</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">unpacks the input list into N lists of interleaved elements</tr>
                <tr lang="ru">распаковывает входной список на N списков из чередующихся
                элементов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list</keywords>
            <since>0.1</since>
            <also>
                <see>list.zip</see>
            </also>
            <aliases>
                <alias>list.deinterleave</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">For N = 2 and list elements [1 2 3 4] we get [1 3] on the first
                outlet and [2 4] on the second one</tr>
                <!-- old: Для N = 2 и элементов списка [1 2 3 4] мы получаем
                [1 3] на первой розетке и [2 4] на второй. -->
                <tr lang="ru" finished="false">Для N = 2 и элементов списка [1 2 3 4] мы получаем
                [1 3] на первой розетке и [2 4] на второй.</tr>
            </par>
            <par>
                <tr lang="en">If input value is [1 2 3 4 5] the output depends on split
                method.</tr>
                <!-- old: Если входное значение [1 2 3 4 5], выход зависит от
                метода разделения. -->
                <tr lang="ru" finished="false">Если входное значение [1 2 3 4 5], выход зависит от
                метода разделения.</tr>
            </par>
            <par>
                <tr lang="en">If @min method used, output is [1 3 5] and [2 4]. If @pad method used
                with value X, output if [1 3 5] and [2 4 X]</tr>
                <!-- old: Если используется метод @min, выход [1 3 5] и [2 4].
                Если метод @pad используется со значением X, выводим, если [1 3 5] и [2 4 X] -->
                <tr lang="ru" finished="false">Если используется метод @min, выход [1 3 5] и [2 4].
                Если метод @pad используется со значением X, выводим, если [1 3 5] и [2 4 X]</tr>
            </par>
        </info>
        <arguments>
            <argument name="N" type="int" minvalue="2">
                <tr lang="en">number of output outlets</tr>
                <tr lang="ru" finished="false">количество выходных точек</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @method -->
            <property name="@method" type="symbol" enum="min pad" default="min">
                <tr lang="en">split method if number element in the input list is not multiple of
                number of outputs</tr>
                <!-- old: метод разделения, если числовой элемент в списке
                ввода не является кратным числу выходов -->
                <tr lang="ru" finished="false">метод разделения, если числовой элемент в списке
                ввода не является кратным числу выходов</tr>
            </property>
            <!-- @min -->
            <property name="@min" type="alias">
                <tr lang="en">alias to @method min. No padding used</tr>
                <!-- old: псевдоним @method min. Не используется
                прокладка -->
                <tr lang="ru" finished="false">псевдоним @method min. Не используется
                прокладка</tr>
            </property>
            <!-- @pad -->
            <property name="@pad" type="atom" default="0">
                <tr lang="en">padding value. Pads result lists with specified value, if number of
                elements in the input list is not multiple of number of outputs</tr>
                <!-- old: ценность прокладки. Списки результатов падов с
                заданным значением, если количество элементов во входном списке не кратно числу
                выходов -->
                <tr lang="ru" finished="false">ценность прокладки. Списки результатов падов с
                заданным значением, если количество элементов во входном списке не кратно числу
                выходов</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                    <tr lang="ru" finished="false">вводный список</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet>
                <out type="any">
                    <tr lang="en">unzipped list</tr>
                    <tr lang="ru" finished="false">незапечатанный список</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 4( [1 2 3 4 5(
|         |
|         |
|  [dump( |     [@min( [@pad X(
|  |      |     |      |
|  |      |     |      |
|  |      |     |      |
[list.unzip           2]
|              ^|
[ui.dt]         [ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
