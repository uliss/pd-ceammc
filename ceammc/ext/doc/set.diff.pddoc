<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="set.diff">
    <title>set.diff</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">difference between two sets</tr>
        <tr lang="ru">разность двух множеств</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data difference set</keywords>
      <since>0.3</since>
      <also>
        <see>data.set</see>
        <see>set.union</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Computes the difference between the two incoming sets: outputs a new set that
        contains only the elements of the first set that are not present in the second set.</tr>
        <tr lang="ru">Вычисляет разность двух входящих множеств: выводит новое множество, которое
        содержит только те элементы первого множества, которых нет во втором.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARGS" type="any">
        <tr lang="en">elements of the second (subtracted) set</tr>
        <tr lang="ru">элементы второго (вычитаемого) множества</tr>
      </argument>
    </arguments>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">first set or list (converted to set). Other values are ignored</tr>
          <tr lang="ru">первое множество или список (преобразуется во множество). Остальные
          значения игнорируются</tr>
        </in>
      </inlet>
      <inlet>
        <in>
          <tr lang="en">second set or list (converted to set)</tr>
          <tr lang="ru">второе множество или список (преобразуется во множество)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output set with elements from the first set that are not in the second
          set</tr>
          <tr lang="ru">выходное множество с элементами из первого множества, которых нет во
          втором</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[data.set 1 2 3 4 5 6]
|
[set.diff 2 4 6]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
