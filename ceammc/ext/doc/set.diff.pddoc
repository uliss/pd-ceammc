<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="set.diff">
    <title>set.diff</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">difference between two sets</tr>
        <tr lang="ru">разность между множествами</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data difference set</keywords>
      <since>0.3</since>
      <also>
        <see>data.set</see>
        <see>set.union</see>
      </also>
    </meta>
    <arguments>
      <argument name="ARGS" type="any">
        <tr lang="en">right set elements</tr>
        <tr lang="ru" finished="false">Правильный набор элементов</tr>
      </argument>
    </arguments>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">first set or list (converted to set), other values are ignored</tr>
          <tr lang="ru" finished="false">первый набор или список (преобразуется в набор), другие
          значения игнорируются;</tr>
        </in>
      </inlet>
      <inlet>
        <in>
          <tr lang="en">second set or list (converted to set)</tr>
          <tr lang="ru" finished="false">Второй набор или список (преобразуется в набор)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output set with elements from first set, that are not in second set</tr>
          <tr lang="ru" finished="false">выходной набор с элементами из первого набора, которые не
          находятся во втором наборе</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[data.set 1 2 3 4 5 6]
|
[set.diff 2 4 6]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
