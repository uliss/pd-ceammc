<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="set.diff">
        <title>set.diff</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">difference between two sets</tr>
                <tr lang="ru">разность между множествами</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data difference set</keywords>
            <since>0.3</since>
            <also>
                <see>data.set</see>
                <see>set.union</see>
            </also>
        </meta>
        <arguments>
            <argument name="ARGS" type="any">
                <tr lang="en">right set elements</tr>
            </argument>
        </arguments>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">first set or list (converted to set), other values are
                    ignored</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">second set or list (converted to set)</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output set with elements from first set, that are not in second
                    set</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[data.set 1 2 3 4 5 6]
|
[set.diff 2 4 6]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
