<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="path.normalize">
    <title>path.normalize</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">normalize file paths</tr>
        <tr lang="ru">нормализует пути файлов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>path</category>
      <keywords>path normalize</keywords>
      <since>0.9.4</since>
      <aliases>
        <alias>path.norm</alias>
      </aliases>
      <also>
        <see>path.split</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object normalizes a file path: removes redundant separators and '.' components, and resolves '..' components</tr>
        <tr lang="ru">объект нормализует путь к файлу: удаляет лишние разделители и компоненты '.', а также раскрывает компоненты '..'</tr>
      </par>
      <par>
        <tr lang="en">these conversions are purely lexical: they do not check that the paths exist, do not follow symlinks and do not access the filesystem at all</tr>
        <tr lang="ru">эти преобразования чисто лексические: они не проверяют существование путей, не переходят по симлинкам и вообще не обращаются к файловой системе</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to clean up paths before comparing them or passing them to other objects</tr>
        <tr lang="ru">объект можно использовать для очистки путей перед их сравнением или передачей другим объектам</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">file path</tr>
          <tr lang="ru">путь к файлу</tr>
        </in>
        <in on="data:string">
          <tr lang="en">file path</tr>
          <tr lang="ru">путь к файлу</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">symbol or data:string: normalized path</tr>
          <tr lang="ru">символ или data:string: нормализованный путь</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[symbol /path///./to/normalize/../file.txt(
|
[path.normalize]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
