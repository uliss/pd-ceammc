#X msg 110 572 @osc;
#X text 245 572 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 110 602 @active;
#X text 245 602 Turn on/off object dsp processing. Type: bool. Default
value: 1\.;
#X msg 110 644 @bypass;
#X text 245 644 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 110 686 @c_attack;
#X text 245 686 Get/Set feedback compression attack time. Type: float.
Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 110 728 @c_release;
#X text 245 728 Get/Set feedback compression release time. Type: float.
Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 110 770 @c_thresh;
#X text 245 770 Get/Set feedback compression threshold level. Type:
float. Units: 'db'. Default value: 0\. Range: -60\...0\.;
#X msg 110 812 @compress;
#X text 245 812 Get/Set feedback compression factor. 0: means no compression
\, 1: limit feedback level. Type: float. Default value: 0.5\. Range:
0\...1\.;
#X msg 110 869 @delay;
#X text 245 869 Get/Set echo time. Type: float. Units: 'ms'. Default
value: 500\. Range: 10\...10000\.;
#X msg 110 911 @drywet;
#X text 245 911 Get/Set proportion of mix between the original (dry)
and 'effected' (wet) signals. 0 - dry signal \, 1 - wet. Type: float.
Default value: 1\. Range: 0\...1\.;
#X msg 110 968 @f_hpf;
#X text 245 968 Get/Set feedback high-pass filter cutoff frequency.
Type: float. Units: 'Hz'. Default value: 300\. Range: 20\...20000\.;
#X msg 110 1010 @f_lpf;
#X text 245 1010 Get/Set feedback low-pass filter cutoff frequency.
Type: float. Units: 'Hz'. Default value: 9000\. Range: 20\...20000\.;
#X msg 110 1067 @feedback;
#X text 245 1067 Get/Set feedback coefficient. Type: float. Default
value: 0.3\. Range: 0\...0.99\.;
#X msg 110 1109 @filter;
#X text 245 1109 Get/Set if true - apply filter to feedback signal.
Type: bool. Default value: 0\.;
#X msg 110 1151 @smooth;
#X text 245 1151 Get/Set interpolation time on delay time change \,
that prevents click and transpose \, if equal to 0 produces artifacts
on delay change. Type: float. Units: 'ms'. Default value: 50\. Range:
0\...500\.;
