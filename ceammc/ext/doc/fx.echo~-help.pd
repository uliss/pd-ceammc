#X msg 130 618 @c_attack;
#X text 270 618 Get/Set feedback compression attack time. Type: float.
Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 130 660 @c_release;
#X text 270 660 Get/Set feedback compression release time. Type: float.
Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 130 702 @c_thresh;
#X text 270 702 Get/Set feedback compression threshold level. Type:
float. Units: 'db'. Default value: 0\. Range: -60\...0\.;
#X msg 130 744 @compress;
#X text 270 744 Get/Set feedback compression factor. 0: means no compression
\, 1: limit feedback level. Type: float. Default value: 0.5\. Range:
0\...1\.;
#X msg 130 801 @delay;
#X text 270 801 Get/Set echo time. Type: float. Units: 'ms'. Default
value: 500\. Range: 10\...10000\.;
#X msg 130 843 @drywet;
#X text 270 843 Get/Set proportion of mix between the original (dry)
and 'effected' (wet) signals. 0 - dry signal \, 1 - wet. Type: float.
Default value: 1\. Range: 0\...1\.;
#X msg 130 900 @f_hpf;
#X text 270 900 Get/Set feedback high-pass filter cutoff frequency.
Type: float. Units: 'Hz'. Default value: 300\. Range: 20\...20000\.;
#X msg 130 942 @f_lpf;
#X text 270 942 Get/Set feedback low-pass filter cutoff frequency.
Type: float. Units: 'Hz'. Default value: 9000\. Range: 20\...20000\.;
#X msg 130 999 @feedback;
#X text 270 999 Get/Set feedback coefficient. Type: float. Default
