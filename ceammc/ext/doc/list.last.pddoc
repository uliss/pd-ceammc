<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.last">
        <title>list.last</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">output the last list element</tr>
                <tr lang="ru">выводит последний элемент списка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list last back</keywords>
            <since>0.1</since>
            <also>
                <see>list.first</see>
                <see>list.at</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                    <tr lang="ru" finished="false">вводный список</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                    <tr lang="ru" finished="false">входной млечный</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">last list element</tr>
                    <tr lang="ru" finished="false">элемент последнего списка</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 60 120 b 11( [list a b( [\(a b c\), bang(
|               |          |
|               |          [ml]
|               |          |
[list.last                 ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
