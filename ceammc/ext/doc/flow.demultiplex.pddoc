<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flow.demultiplex">
        <title>flow.demultiplex</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">demultiplex of the control flow</tr>
                <tr lang="ru">демультиплексор управляющего потока</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>demultiplex</keywords>
            <aliases>
                <alias>flow.demux</alias>
            </aliases>
            <since>0.6</since>
            <also>
                <see>flow.multiplex</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: you can get/set object properties only via prop.set/prop.get
                objects</tr>
                <!-- old: Примечание: Вы можете получить/установить свойства
                объекта только через prop.set/prop.get объекты -->
                <tr lang="ru" finished="false">Примечание: Вы можете получить/установить свойства
                объекта только через prop.set/prop.get объекты</tr>
            </par>
        </info>
        <arguments>
            <argument name="N" type="int" minvalue="2" maxvalue="24">
                <tr lang="en">number of outlets</tr>
                <tr lang="ru" finished="false">количество торговых точек</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @index -->
            <property name="@index" type="int" minvalue="0" default="0">
                <tr lang="en">current demultiplexer output index</tr>
                <tr lang="ru" finished="false">Текущий выходной индекс демультиплексора</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" minvalue="2" default="2" maxvalue="24"
            access="initonly">
                <tr lang="en">number of outlets</tr>
                <tr lang="ru" finished="false">количество торговых точек</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="any">
                    <tr lang="en">input flow inlet</tr>
                    <tr lang="ru" finished="false">входной входной поток</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="int">
                    <tr lang="en">output selector</tr>
                    <tr lang="ru" finished="false">выходной селектор</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet>
                <out type="any">
                    <tr lang="en">demultiplexer first output</tr>
                    <tr lang="ru" finished="false">демультиплексор первый выход</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">demultiplexer N-th output</tr>
                    <tr lang="ru" finished="false">демультиплексор N-й выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
|                 [ui.radio @nitems 4]
|                 |
|                 |.
[flow.demultiplex 4]
|   ^|   ^^|   ^^^|
[F]  [F]   [F]   [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
