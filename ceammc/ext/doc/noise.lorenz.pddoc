<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="noise.lorenz">
        <title>noise.lorenz</title>
        <meta>
            <authors>
                <author>Richard Dudas</author>
                <author>Mikhail Malt</author>
                <author>André Sier</author>
            </authors>
            <description>
                <tr lang="en">Lorenz chaos attractor</tr>
                <tr lang="ru">хаотический атрактор Лоренца</tr>
            </description>
            <license>%</license>
            <library>ceammc</library>
            <category>noise</category>
            <keywords>noise</keywords>
            <since>0.5</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Lorenz chaos by Heuns method - extra accuracy</tr>
                <!-- old: Lorenz chaos by Heuns method - дополнительная
                точность -->
                <tr lang="ru" finished="false">Lorenz chaos by Heuns method - дополнительная
                точность</tr>
            </par>
            <par>
                <tr lang="en">sigma replaced with a</tr>
                <tr lang="ru" finished="false">Сигма заменена на</tr>
            </par>
            <par>
                <tr lang="en">b replaced with c</tr>
                <tr lang="ru" finished="false">b заменить на c</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Lorenz_system">wiki: Lorenz system</a>
        </info>
        <arguments>
            <argument name="X" type="float">
                <tr lang="en">x value (optional)</tr>
                <tr lang="ru" finished="false">x значение (необязательно)</tr>
            </argument>
            <argument name="Y" type="float">
                <tr lang="en">y value (optional)</tr>
                <tr lang="ru" finished="false">y значение (факультативно)</tr>
            </argument>
            <argument name="Z" type="float">
                <tr lang="en">z value (optional)</tr>
                <tr lang="ru" finished="false">z значение (факультативно)</tr>
            </argument>
            <argument name="A" type="float">
                <tr lang="en">a value (optional)</tr>
                <tr lang="ru" finished="false">значение (факультативно)</tr>
            </argument>
            <argument name="R" type="float">
                <tr lang="en">r value (optional)</tr>
                <tr lang="ru" finished="false">r значение (факультативно)</tr>
            </argument>
            <argument name="C" type="float">
                <tr lang="en">c value (optional)</tr>
                <tr lang="ru" finished="false">c значение (факультативно)</tr>
            </argument>
            <argument name="DT" type="float">
                <tr lang="en">dt value (optional)</tr>
                <tr lang="ru" finished="false">dt значение (факультативно)</tr>
            </argument>
        </arguments>
        <methods>
            <!-- a -->
            <method name="a">
                <param name="A" type="float" required="true">
                    <tr lang="en">a value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- c -->
            <method name="c">
                <param name="B" type="float" required="true">
                    <tr lang="en">b value</tr>
                    <tr lang="ru" finished="false">b значение</tr>
                </param>
            </method>
            <!-- dt -->
            <method name="dt">
                <param name="DT" type="float" required="true">
                    <tr lang="en">dt value</tr>
                    <tr lang="ru" finished="false">значение dt</tr>
                </param>
            </method>
            <!-- om -->
            <method name="om">
                <param name="OM" type="int" required="true">
                    <tr lang="en">enables output when cut or fold value is changed</tr>
                    <!-- old: позволяет вывод при изменении значения разреза
                    или сгиба -->
                    <tr lang="ru" finished="false">позволяет вывод при изменении значения разреза
                    или сгиба</tr>
                </param>
            </method>
            <!-- r -->
            <method name="r">
                <param name="R" type="float" required="true">
                    <tr lang="en">r value</tr>
                    <tr lang="ru" finished="false">r значение</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset state</tr>
                    <tr lang="ru" finished="false">состояние сброса</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <param name="SET" type="float" required="true">
                    <tr lang="en">set to value</tr>
                    <tr lang="ru" finished="false">установить ценность</tr>
                </param>
            </method>
            <!-- x -->
            <method name="x">
                <param name="NX" type="float" required="true">
                    <tr lang="en">x value</tr>
                    <tr lang="ru" finished="false">x значение</tr>
                </param>
            </method>
            <!-- y -->
            <method name="y">
                <param name="NY" type="float" required="true">
                    <tr lang="en">y value</tr>
                    <tr lang="ru" finished="false">y значение</tr>
                </param>
            </method>
            <!-- z -->
            <method name="z">
                <param name="NZ" type="float" required="true">
                    <tr lang="en">z value</tr>
                    <tr lang="ru" finished="false">z значение</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">output value</tr>
                    <tr lang="ru" finished="false">выходная стоимость</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">x outlet</tr>
                    <tr lang="ru" finished="false">х выход</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">y outlet</tr>
                    <tr lang="ru" finished="false">выход</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">z outlet</tr>
                    <tr lang="ru" finished="false">выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 50 #metro]


  [T]         [F]
  |           |
  [om $1 #om( [set $1 #set( [reset #reset(

 [F]           [F]
 |             |
 [r $1 #r(     [dt $1 #dt(  

    [F]       [F]       
    |         |                  
    [a $1 #a( [c $1 #c(  

        [F]       [F]       [F]       
        |         |         |         
        [x $1 #x( [y $1 #y( [z $1 #z(   

[noise.lorenz #noise-obj]
|
[ui.display {i=1,o=0}]

[X r:0->noise-obj:0]  
[X dt:0->noise-obj:0] 

[X a:0->noise-obj:0]
[X c:0->noise-obj:0]

[X x:0->noise-obj:0] 
[X y:0->noise-obj:0] 
[X z:0->noise-obj:0] 

[X om:0->noise-obj:0]
[X set:0->noise-obj:0]
[X reset:0->noise-obj:0]

[X metro->noise-obj]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
