<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="synth.eguitar~">
        <title>synth.eguitar~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">simple electric guitar model with steel strings</tr>
                <tr lang="ru">простая модель электрогитары со стальными струнами</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>guitar electric</keywords>
            <since>0.6</since>
        </meta>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" units="hertz" default="130.8128">
                <tr lang="en">frequency</tr>
            </property>
            <!-- @gain -->
            <property name="@gain" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">pluck gain</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">play trigger - 1: on, 0: off</tr>
            </property>
            <!-- @mute -->
            <property name="@mute" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">mute coefficient (0 for no mute and 1 for instant mute)</tr>
            </property>
            <!-- @pitch -->
            <property name="@pitch" type="float" minvalue="36" maxvalue="84" default="48">
                <tr lang="en">midi pitch</tr>
            </property>
            <!-- @pos -->
            <property name="@pos" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">pluck position (1 is on the bridge)</tr>
            </property>
        </properties>
        <methods>
            <!-- note -->
            <method name="note">
                <info>
                    <tr lang="en">note on/off message</tr>
                </info>
                <param name="NOTE" type="float" required="true">
                    <tr lang="en">midi note</tr>
                </param>
                <param name="VEL" type="float" minvalue="0" maxvalue="127" required="true">
                    <tr lang="en">velocity</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">NOTE VEL</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio" />
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]                  [ui.dsp~]
|
[metro 130]
|
[0 12 0 36 7 12(
|
[list.choice]        [ui.knob]    [ui.knob]
|                    |            |
[+ 36]               |            |
|                    |            |
[makenote 127 100]   [@pos $1 #b( [@mute $1 #c(
*|*
[pack f f]
|
[msg note]
|
[synth.eguitar~ #a]
|
[ui.gain~ @size 120 16]
|\
[dac~]
[X b->a] [X c->a]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
