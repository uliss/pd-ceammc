<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="is_prop">
        <title>is_prop</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks if the input message is a *property* message</tr>
                <tr lang="ru">проверка, является ли входное сообщение *свойством*</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>predicates</category>
            <keywords>predicate float</keywords>
            <also>
                <see>is_any</see>
                <see>is_bang</see>
                <see>is_symbol</see>
                <see>is_list</see>
            </also>
            <since>0.9.6</since>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="any">
                    <tr lang="en">outputs '1' to 1st outlet, otherwise '0'</tr>
                    <tr lang="ru" finished="false">выходы "1" - 1-й выход, иначе "0"</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">0 or 1</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">passes only *property* messages</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B #a]  [100 #b(  [symbol TEST #c(

 [list 1 2 3 #d(  [some message #e(

  [@prop A B #f(  [@prop? #g(



[is_prop #x]
|       ^|
[ui.d]  [ui.dt]

[X a->x]
[X b->x]
[X c->x]
[X d->x]
[X e->x]
[X f->x]
[X g->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
