<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="global.bimap">
        <title>global.bimap</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">global bidirectional map</tr>
                <tr lang="ru">глобальное двунаправленное отображение</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data global map container bidirectional</keywords>
            <since>0.9.7</since>
            <also>
                <see>data.bimap</see>
                <see>local.bimap</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">NOTE: all object inlets are 'hot'</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">open data editor</event>
        </mouse>
        <arguments>
            <argument name="ID" type="symbol">
                <tr lang="en">bimap ID</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @empty -->
            <property name="@empty" type="bool" default="1" access="readonly">
                <tr lang="en">true if empty</tr>
            </property>
            <!-- @id -->
            <property name="@id" type="symbol" access="initonly" default="default">
                <tr lang="en">global variable id</tr>
            </property>
            <!-- @keys_left -->
            <property name="@keys_left" type="list" default="" access="readonly">
                <tr lang="en">list of left map keys</tr>
            </property>
            <!-- @keys_right -->
            <property name="@keys_right" type="list" default="" access="readonly">
                <tr lang="en">list of right map keys</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="int" default="0" access="readonly">
                <tr lang="en">number of left-right pairs in map</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="list" default="">
                <tr lang="en">value, list of pairs: LEFT_KEY1 RIGHT_KEY1 LEFT_KEY2 RIGHT_KEY2
                etc.</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">clear bidirectional map content</method>
            <!-- insert -->
            <method name="insert">insert new left-right map entry 
            <param name="PAIR" type="list" required="true">
                <tr lang="en">list: LEFT_KEY RIGHT_KEY</tr>
            </param></method>
            <!-- read -->
            <method name="read">read bimap from JSON file. Array of array pairs expected. 
            <param name="FNAME" type="symbol" required="true">
                <tr lang="en">path to file, absolute or relative</tr>
            </param></method>
            <!-- set -->
            <method name="set">set bidirectional map content 
            <param name="DATA" type="list" required="true">
                <tr lang="en">new value list</tr>
            </param></method>
            <!-- write -->
            <method name="write">write to JSON file, to overwrite existing file use @force flag 
            <param name="FNAME" type="symbol" required="true">
                <tr lang="en">path to file, absolute or relative</tr>
            </param>
            <param name="@force" type="symbol" required="false">
                <tr lang="en">force flag to overwrite existing files</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="atom">try to find left key in the map and output the right value on
                success</xinfo>
                <xinfo on="list">try to find each left key of the list in the map and output the
                result list of right values</xinfo>
            </inlet>
            <inlet>
                <xinfo on="atom">try to find right key in the map and output the left value on
                success</xinfo>
                <xinfo on="list">try to find each right key of the list in the map and output the
                result list of left values</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>atom or list: right value output</outlet>
            <outlet>atom or list: left value output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[loadmsg 1 2 3 4 5 6]
|
[L]
|
[msg set] [@size?(
|         |
[global.bimap GBM]
|
[ui.dt]

[global.bimap-sp] /*open subpatch*/
]]>
            </pdascii>
            <pdascii id="sp">
<![CDATA[
[1( [1 3 5( [2( [2 4 6(
|   |       |.  |.
[global.bimap  GBM] /*click to view/edit*/
|            ^|
[ui.dt]      [ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
