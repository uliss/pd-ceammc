<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="global.bimap">
        <title>global.bimap</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">global bidirectional map</tr>
                <tr lang="ru">глобальное двунаправленное отображение</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data global map container bidirectional</keywords>
            <since>0.9.7</since>
            <also>
                <see>data.bimap</see>
                <see>local.bimap</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">NOTE: all object inlets are 'hot'</tr>
                <!-- old: ПРИМЕЧАНИЕ: все входы объекта являются
                «горячими» -->
                <tr lang="ru" finished="false">ПРИМЕЧАНИЕ: все входы объекта являются
                «горячими»</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">open data editor</event>
        </mouse>
        <arguments>
            <argument name="ID" type="symbol">
                <tr lang="en">bimap ID</tr>
                <tr lang="ru" finished="false">удостоверение личности</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @empty -->
            <property name="@empty" type="bool" default="1" access="readonly">
                <tr lang="en">true if empty</tr>
                <tr lang="ru" finished="false">Правда, пустая</tr>
            </property>
            <!-- @id -->
            <property name="@id" type="symbol" access="initonly" default="default">
                <tr lang="en">global variable id</tr>
                <tr lang="ru" finished="false">Глобальная переменная id</tr>
            </property>
            <!-- @keys_left -->
            <property name="@keys_left" type="list" default="" access="readonly">
                <tr lang="en">list of left map keys</tr>
                <tr lang="ru" finished="false">Список левой карты ключей</tr>
            </property>
            <!-- @keys_right -->
            <property name="@keys_right" type="list" default="" access="readonly">
                <tr lang="en">list of right map keys</tr>
                <tr lang="ru" finished="false">Список правильных ключей карты</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="int" default="0" access="readonly">
                <tr lang="en">number of left-right pairs in map</tr>
                <tr lang="ru" finished="false">Количество лево-правых пар на карте</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="list" default="">
                <tr lang="en">value, list of pairs: LEFT_KEY1 RIGHT_KEY1 LEFT_KEY2 RIGHT_KEY2
                etc.</tr>
                <!-- old: LEFT_KEY1 RIGHT_KEY1 LEFT_KEY2 RIGHT_KEY2 и
                т.д. -->
                <tr lang="ru" finished="false">LEFT_KEY1 RIGHT_KEY1 LEFT_KEY2 RIGHT_KEY2 и
                т.д.</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clear bidirectional map content</tr>
                    <tr lang="ru" finished="false">четкое двунаправленное содержание карты</tr>
                </info>
            </method>
            <!-- insert -->
            <method name="insert">
                <info>
                    <tr lang="en">insert new left-right map entry</tr>
                    <tr lang="ru" finished="false">вставить новую лево-правую карту</tr>
                </info>
                <param name="PAIR" type="list" required="true">
                    <tr lang="en">list: LEFT_KEY RIGHT_KEY</tr>
                    <tr lang="ru" finished="false">Оригинальное название: Left_KEY Right_KEY</tr>
                </param>
            </method>
            <!-- read -->
            <method name="read">
                <info>
                    <tr lang="en">read bimap from JSON file. Array of array pairs expected.</tr>
                    <!-- old: Читать карту из файла JSON. Ожидалось множество
                    пар массивов. -->
                    <tr lang="ru" finished="false">Читать карту из файла JSON. Ожидалось множество
                    пар массивов.</tr>
                </info>
                <param name="FNAME" type="symbol" required="true">
                    <tr lang="en">path to file, absolute or relative</tr>
                    <tr lang="ru" finished="false">Путь к файлу, абсолютный или относительный</tr>
                </param>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">set bidirectional map content</tr>
                    <tr lang="ru" finished="false">двунаправленный контент карты</tr>
                </info>
                <param name="DATA" type="list" required="true">
                    <tr lang="en">new value list</tr>
                    <tr lang="ru" finished="false">Новый список ценностей</tr>
                </param>
            </method>
            <!-- write -->
            <method name="write">
                <info>
                    <tr lang="en">write to JSON file, to overwrite existing file use @force
                    flag</tr>
                    <!-- old: писать в файл JSON, перезаписывать существующий
                    файл с помощью флага @force -->
                    <tr lang="ru" finished="false">писать в файл JSON, перезаписывать существующий
                    файл с помощью флага @force</tr>
                </info>
                <param name="FNAME" type="symbol" required="true">
                    <tr lang="en">path to file, absolute or relative</tr>
                    <tr lang="ru" finished="false">Путь к файлу, абсолютный или относительный</tr>
                </param>
                <param name="@force" type="symbol" required="false">
                    <tr lang="en">force flag to overwrite existing files</tr>
                    <!-- old: Заставить флаг перезаписывать существующие
                    файлы -->
                    <tr lang="ru" finished="false">Заставить флаг перезаписывать существующие
                    файлы</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="atom">
                    <tr lang="en">try to find left key in the map and output the right value on
                    success</tr>
                    <!-- old: Попробуйте найти левый ключ на карте и вывести
                    правильное значение успеха. -->
                    <tr lang="ru" finished="false">Попробуйте найти левый ключ на карте и вывести
                    правильное значение успеха.</tr>
                </in>
                <in on="list">
                    <tr lang="en">try to find each left key of the list in the map and output the
                    result list of right values</tr>
                    <!-- old: Попробуйте найти каждый левый ключ списка на
                    карте и выведите список результатов правильных значений. -->
                    <tr lang="ru" finished="false">Попробуйте найти каждый левый ключ списка на
                    карте и выведите список результатов правильных значений.</tr>
                </in>
            </inlet>
            <inlet>
                <in on="atom">
                    <tr lang="en">try to find right key in the map and output the left value on
                    success</tr>
                    <!-- old: Попробуйте найти правильный ключ на карте и
                    вывести левое значение успеха. -->
                    <tr lang="ru" finished="false">Попробуйте найти правильный ключ на карте и
                    вывести левое значение успеха.</tr>
                </in>
                <in on="list">
                    <tr lang="en">try to find each right key of the list in the map and output the
                    result list of left values</tr>
                    <!-- old: Попробуйте найти каждый правый ключ списка на
                    карте и выведите список результатов левых значений. -->
                    <tr lang="ru" finished="false">Попробуйте найти каждый правый ключ списка на
                    карте и выведите список результатов левых значений.</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">atom or list: right value output</tr>
                    <tr lang="ru" finished="false">Атом или список: выход правильного значения</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">atom or list: left value output</tr>
                    <tr lang="ru" finished="false">Атом или список: выходное значение слева</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[loadmsg 1 2 3 4 5 6]
|
[L]
|
[msg set] [@size?(
|         |
[global.bimap GBM]
|
[ui.dt]

[global.bimap-sp] /*open subpatch*/
]]>
            </pdascii>
            <pdascii id="sp">
<![CDATA[
[1( [1 3 5( [2( [2 4 6(
|   |       |.  |.
[global.bimap  GBM] /*click to view/edit*/
|            ^|
[ui.dt]      [ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
