<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.lin2lin">
    <title>conv.lin2lin</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts from the one linear range into another</tr>
        <tr lang="ru">преобразует один линейный диапазон в другой</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>convert linear</keywords>
      <also>
        <see>conv.cc2amp</see>
      </also>
      <since>0.1</since>
      <aliases>
        <alias>ceammc/lin-&gt;lin</alias>
        <alias>lin-&gt;lin</alias>
        <alias>ceammc/l-&gt;l</alias>
        <alias>l-&gt;l</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object maps a value from one linear input range to another linear output
        range. If the input value exceeds the input range, the behavior is determined by the @clip
        property (by default clipping is applied to both ends).</tr>
        <tr lang="ru">Объект отображает значение из одного линейного входного диапазона в другой
        линейный выходной диапазон. Если входное значение выходит за пределы входного диапазона,
        поведение определяется свойством @clip (по умолчанию ограничение применяется с обеих
        сторон).</tr>
      </par>
    </info>
    <arguments>
      <argument name="IN_FROM" type="float">
        <tr lang="en">beginning of the input range</tr>
        <tr lang="ru">начало входного диапазона</tr>
      </argument>
      <argument name="IN_TO" type="float">
        <tr lang="en">end of the input range</tr>
        <tr lang="ru">конец входного диапазона</tr>
      </argument>
      <argument name="OUT_FROM" type="float">
        <tr lang="en">beginning of the output range</tr>
        <tr lang="ru">начало выходного диапазона</tr>
      </argument>
      <argument name="OUT_TO" type="float">
        <tr lang="en">end of the output range</tr>
        <tr lang="ru">конец выходного диапазона</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @clip -->
      <property name="@clip" type="symbol" default="minmax" enum="noclip min max minmax">
        <tr lang="en">noclip (do not clip), max (clip ceiling), min (clip floor), minmax (clip
        both)</tr>
        <tr lang="ru">noclip (не ограничивать), max (ограничить сверху), min (ограничить снизу),
        minmax (ограничить с обеих сторон)</tr>
      </property>
      <!-- @in_from -->
      <property name="@in_from" type="float" default="0">
        <tr lang="en">beginning of the input range</tr>
        <tr lang="ru">начало входного диапазона</tr>
      </property>
      <!-- @in_to -->
      <property name="@in_to" type="float" default="127">
        <tr lang="en">end of the input range</tr>
        <tr lang="ru">конец входного диапазона</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="alias">
        <tr lang="en">alias to @clip max</tr>
        <tr lang="ru">сокращение для @clip max</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="alias">
        <tr lang="en">alias to @clip min</tr>
        <tr lang="ru">сокращение для @clip min</tr>
      </property>
      <!-- @minmax -->
      <property name="@minmax" type="alias">
        <tr lang="en">alias to @clip minmax</tr>
        <tr lang="ru">сокращение для @clip minmax</tr>
      </property>
      <!-- @noclip -->
      <property name="@noclip" type="alias">
        <tr lang="en">alias to @clip noclip</tr>
        <tr lang="ru">сокращение для @clip noclip</tr>
      </property>
      <!-- @out_from -->
      <property name="@out_from" type="float" default="0">
        <tr lang="en">beginning of the output range</tr>
        <tr lang="ru">начало выходного диапазона</tr>
      </property>
      <!-- @out_to -->
      <property name="@out_to" type="float" default="1">
        <tr lang="en">end of the output range</tr>
        <tr lang="ru">конец выходного диапазона</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input float</tr>
          <tr lang="ru">входное число</tr>
        </in>
        <in on="list">
          <tr lang="en">input list</tr>
          <tr lang="ru">входной список</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">converted float/list</tr>
          <tr lang="ru">преобразованное число или список</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]   [T]
|     |
|     [@clip $1(
|     |
[lin->lin 0 127 -1 1]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
