<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flt.fb_comb~">
        <title>flt.fb_comb~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">feedback comb filter</tr>
                <tr lang="ru">гребенчатый фильтр с обратной связью (БИХ)</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter comb</keywords>
            <since>0.9.1</since>
            <also>
                <see>flt.ff_comb~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Frequency response of a comb filter consists of a series of regularly
                spaced notches, giving the appearance of a comb</tr>
                <!-- old: Частотный отклик гребневого фильтра состоит из серии
                регулярно расположенных выемок, придающих вид гребневому фильтру -->
                <tr lang="ru" finished="false">Частотный отклик гребневого фильтра состоит из серии
                регулярно расположенных выемок, придающих вид гребневому фильтру</tr>
            </par>
            <par>
                <tr lang="en">Structure of a feedforward comb filter may be described by the
                following difference equation: y[n]=x[n]+αy[n-K]} where K is the delay length
                (measured in samples), and α is a scaling factor applied to the delayed sum</tr>
                <!-- old: Структура фильтра для расчесывания вперед может быть
                описана следующим дифференциальным уравнением: y[n]=x[n]+αy[n-K], где K — длина
                задержки (измеряется в образцах), а α — коэффициент масштабирования, применяемый к
                отложенной сумме -->
                <tr lang="ru" finished="false">Структура фильтра для расчесывания вперед может быть
                описана следующим дифференциальным уравнением: y[n]=x[n]+αy[n-K], где K — длина
                задержки (измеряется в образцах), а α — коэффициент масштабирования, применяемый к
                отложенной сумме</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Comb_filter">wiki: Comb filter</a>
        </info>
        <arguments>
            <argument name="A" type="float" minvalue="-1" maxvalue="1">
                <tr lang="en">scaling factor of delayed sum</tr>
                <tr lang="ru" finished="false">Коэффициент масштабирования отложенной суммы</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @a -->
            <property name="@a" type="float" minvalue="-1" maxvalue="1" default="0.75">
                <tr lang="en">scaling factor of delayed signal sum</tr>
                <!-- old: Коэффициент масштабирования отсроченной суммы
                сигнала -->
                <tr lang="ru" finished="false">Коэффициент масштабирования отсроченной суммы
                сигнала</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset filter state</tr>
                    <tr lang="ru" finished="false">состояние фильтра сброса</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">filter notch frequency</tr>
                    <tr lang="ru" finished="false">частота выемки фильтра</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">filtered signal</tr>
                    <tr lang="ru" finished="false">фильтрованный сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B #a]   [msg.onload]   [ui.knob @min -1 @max 1 #c]
|        |              |       |
[click~] [samplerate~]  |       |
|        |              |       |
|        [/ 8]          [@a $1( [F]
|        |.             |
[flt.fb_comb~           ]
|
[plot.response~             #b]
|                          ^^|.
[ui.plot~ @xlabels 1 @ylabels 1 @ymin 0 @ymax 4 @ymin_ticks 0 @ymaj_ticks 0 @size 400 200]














[ui.dsp~]
[X a->b:1]
[X c->a]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
