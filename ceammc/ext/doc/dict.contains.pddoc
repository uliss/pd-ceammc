<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="dict.contains">
    <title>dict.contains</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">check if the dictionary contains the key</tr>
        <tr lang="ru">проверка, содержит ли словарь указанный ключ</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>contains dictionary</keywords>
      <since>0.6</since>
      <also>
        <see>data.dict</see>
        <see>dict.keys</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes a dictionary on the left inlet and a list of keys to check on
        the right inlet (or via the KEYS argument). For every key in the list it outputs 1 if the
        dictionary contains that key, and 0 otherwise. The result is a list of 1s and 0s in the same
        order as the checked keys.</tr>
        <tr lang="ru">Объект принимает словарь в левый вход, а список проверяемых ключей — в правый
        вход (или через аргумент KEYS). Для каждого ключа из списка выводится 1, если словарь
        содержит этот ключ, и 0 в противном случае. Результат — список из 1 и 0 в том же порядке,
        что и проверяемые ключи.</tr>
      </par>
    </info>
    <arguments>
      <argument name="KEYS" type="list">
        <tr lang="en">list of keys to check against the dictionary. Each key produces a
        corresponding 1 or 0 in the output</tr>
        <tr lang="ru">список ключей для проверки в словаре. Для каждого ключа в выводе появляется
        соответствующая 1 или 0</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @keys -->
      <property name="@keys" type="list" default="">
        <tr lang="en">current list of keys to check. Can be set at creation time or changed
        later</tr>
        <tr lang="ru">текущий список проверяемых ключей. Может быть задан при создании объекта или
        изменён позже</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="data">
          <tr lang="en">dictionary to check (a data.dict value is expected). When a dictionary is
          received, the object immediately outputs the check result for the current list of
          keys</tr>
          <tr lang="ru">словарь для проверки (ожидается значение data.dict). При получении словаря
          объект сразу выводит результат проверки для текущего списка ключей</tr>
        </in>
      </inlet>
      <inlet>
        <in on="list">
          <tr lang="en">set the list of keys to search for in the dictionary</tr>
          <tr lang="ru">задать список ключей, наличие которых нужно проверить в словаре</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">outputs a list of 1 and 0. One means the dict contains the key, zero - it
          does not</tr>
          <tr lang="ru">выводит список из 1 и 0. Единица означает, что словарь содержит ключ, ноль
          — не содержит</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[data.dict \[a: 1 b: 2 c: 3 d: 4\]]
|
[dict.contains c d e]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
