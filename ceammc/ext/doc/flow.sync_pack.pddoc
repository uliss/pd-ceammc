<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.sync_pack">
    <title>flow.sync_pack</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">[flow.pack] with all hot inlets</tr>
        <tr lang="ru">[flow.pack] со всеми «горячими» входами</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow pack hot</keywords>
      <since>0.8</since>
      <aliases>
        <alias>flow.pack'</alias>
      </aliases>
      <also>
        <see>pack</see>
        <see>flow.pack</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object works like [flow.pack], but all its inlets are hot, meaning that
        any inlet triggers the output of the whole packed list</tr>
        <tr lang="ru">объект работает как [flow.pack], но все его входы «горячие», то есть любой
        вход запускает вывод всего упакованного списка</tr>
      </par>
      <par>
        <tr lang="en">@init sets the initial values for all inlets, missing values default to
        0</tr>
        <tr lang="ru">@init задаёт начальные значения для всех входов, отсутствующие значения по
        умолчанию равны 0</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="1" maxvalue="255">
        <tr lang="en">number of inputs</tr>
        <tr lang="ru">количество входов</tr>
      </argument>
      <argument name="INIT" type="list">
        <tr lang="en">default values for all inlets. If not enough default values are given, the
        rest is set to 0</tr>
        <tr lang="ru">значения по умолчанию для всех входов. Если значений по умолчанию не хватает,
        остальные устанавливаются в 0</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @init -->
      <property name="@init" type="list" access="initonly" default="">
        <tr lang="en">default init values</tr>
        <tr lang="ru">значения инициализации по умолчанию</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" minvalue="1" default="1" maxvalue="255" access="initonly">
        <tr lang="en">number of inlets</tr>
        <tr lang="ru">количество входов</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet number="1">
        <in on="bang">
          <tr lang="en">output current value</tr>
          <tr lang="ru">вывести текущее значение</tr>
        </in>
        <in on="float">
          <tr lang="en">change first packed value and output</tr>
          <tr lang="ru">изменить первое упакованное значение и вывести</tr>
        </in>
        <in on="symbol">
          <tr lang="en">change first packed value and output</tr>
          <tr lang="ru">изменить первое упакованное значение и вывести</tr>
        </in>
        <in on="list">
          <tr lang="en">propagate list values to other inlets and output</tr>
          <tr lang="ru">распространить значения списка на другие входы и вывести</tr>
        </in>
        <in on="any">
          <tr lang="en">propagate message values to other inlets and output</tr>
          <tr lang="ru">распространить значения сообщения на другие входы и вывести</tr>
        </in>
      </inlet>
      <inlet number="...">
        <in on="bang">
          <tr lang="en">output current value</tr>
          <tr lang="ru">вывести текущее значение</tr>
        </in>
        <in on="float">
          <tr lang="en">change ... packed value and output</tr>
          <tr lang="ru">изменить ... упакованное значение и вывести</tr>
        </in>
        <in on="symbol">
          <tr lang="en">change ... packed value and output</tr>
          <tr lang="ru">изменить ... упакованное значение и вывести</tr>
        </in>
        <in on="list">
          <tr lang="en">propagate ... list values among rest inlets and output</tr>
          <tr lang="ru">распространить ... значения списка на остальные входы и вывести</tr>
        </in>
      </inlet>
      <inlet number="n">
        <in on="bang">
          <tr lang="en">output current value</tr>
          <tr lang="ru">вывести текущее значение</tr>
        </in>
        <in on="float">
          <tr lang="en">change n-th packed value and output</tr>
          <tr lang="ru">изменить N-е упакованное значение и вывести</tr>
        </in>
        <in on="symbol">
          <tr lang="en">change n-th packed value and output</tr>
          <tr lang="ru">изменить N-е упакованное значение и вывести</tr>
        </in>
        <in on="list">
          <tr lang="en">propagate n-th list values among rest inlets and output</tr>
          <tr lang="ru">распространить значения N-го списка на остальные входы и вывести</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">packed list or message (if message input)</tr>
          <tr lang="ru">упакованный список или сообщение (если на вход подан message)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]  [F]   [F]  [1 2(   [1 2 3( [F]
|    |     |    |       |       |
|    |     |.   |       |       |..
[flow.pack' 3 0 0 ABC {w=20}       ]
|
[ui.display @display_type 1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
