<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="canvas.top">
        <title>canvas.top</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">verbose information about top-level canvas of the object</tr>
                <tr lang="ru">подробная информация о холсте верхнего уровня у объекта</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>patch</category>
            <keywords>canvas</keywords>
            <also>
                <see>patch.args</see>
                <see>canvas.current</see>
            </also>
            <since>0.4</since>
        </meta>
        <properties>
            <!-- @abs -->
            <property name="@abs" type="bool" default="1">
                <tr lang="en">if false: using toplevel canvas, if true: using abstraction
                canvas</tr>
            </property>
            <!-- @dir -->
            <property name="@dir" type="symbol" access="readonly" default="/">
                <tr lang="en">canvas directory</tr>
            </property>
            <!-- @font -->
            <property name="@font" type="int" access="readonly" default="10">
                <tr lang="en">window font</tr>
            </property>
            <!-- @height -->
            <property name="@height" type="int" access="readonly" default="400">
                <tr lang="en">window height</tr>
            </property>
            <!-- @name -->
            <property name="@name" type="symbol" access="readonly" default="test_canvas">
                <tr lang="en">canvas name</tr>
            </property>
            <!-- @paths -->
            <property name="@paths" type="list" access="readonly" default="">
                <tr lang="en">search paths</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" access="readonly" default="600 400">
                <tr lang="en">window size</tr>
            </property>
            <!-- @width -->
            <property name="@width" type="int" access="readonly" default="600">
                <tr lang="en">window width</tr>
            </property>
            <!-- @x -->
            <property name="@x" type="int" access="readonly" default="0">
                <tr lang="en">window x-pos</tr>
            </property>
            <!-- @y -->
            <property name="@y" type="int" access="readonly" default="0">
                <tr lang="en">window y-pos</tr>
            </property>
        </properties>
        <methods>
            <!-- postscript -->
            <method name="postscript">save patch to postscript 
            <param name="FNAME" type="symbol" required="false">
                <tr lang="en">file. If not specified patch name used with .ps extension</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>property request</xinfo>
                <xinfo on="bang">output as dict</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>dict/property output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[@name?(    [@dir?( [@width?(
|           |       |
|           |       | [@height?(
|           |       | |
| [@x?( [B] | [@y?( | |
| |     |   | |     | |
[canvas.top           ]
|
[ui.dt]

[canvas.top-abs]
]]>
            </pdascii>
            <pdascii id="abs">
<![CDATA[
[bang(                       [bang(
|                            |
[canvas.top-abs0]            [canvas.top-abs1]
|                            |
[ui.dt]                      [ui.dt]
]]>
            </pdascii>
            <pdascii id="abs0">
<![CDATA[
[inlet]
|
[canvas.top @abs 0]
|
[outlet]
]]>
            </pdascii>
            <pdascii id="abs1">
<![CDATA[
[inlet]
|
[canvas.top @abs 1]
|
[outlet]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
