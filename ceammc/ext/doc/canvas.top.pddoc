<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="canvas.top">
    <title>canvas.top</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">verbose information about top-level canvas of the object</tr>
        <tr lang="ru">подробная информация о холсте верхнего уровня объекта</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>patch</category>
      <keywords>canvas</keywords>
      <also>
        <see>patch.args</see>
        <see>canvas.current</see>
      </also>
      <since>0.4</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object provides detailed information about the top-level canvas that
        contains the object. A bang outputs a dictionary with all available properties. A property
        name (such as @name, @width, @height) sent to the inlet outputs the value of that single
        property. With the @abs flag set to 1, information about the abstraction canvas is used
        instead of the top-level window.</tr>
        <tr lang="ru">Объект предоставляет подробную информацию о холсте верхнего уровня, который
        содержит объект. Bang выводит словарь со всеми доступными свойствами. Имя свойства
        (например, @name, @width, @height), отправленное на вход, выводит значение только этого
        свойства. Если флаг @abs равен 1, вместо окна верхнего уровня используется холст
        абстракции.</tr>
      </par>
    </info>
    <properties>
      <!-- @abs -->
      <property name="@abs" type="bool" default="1">
        <tr lang="en">if 0: use the top-level canvas, if 1: use the abstraction canvas</tr>
        <tr lang="ru">если 0: использовать холст верхнего уровня, если 1: использовать холст
        абстракции</tr>
      </property>
      <!-- @dir -->
      <property name="@dir" type="symbol" access="readonly" default="/">
        <tr lang="en">canvas directory</tr>
        <tr lang="ru">директория холста</tr>
      </property>
      <!-- @font -->
      <property name="@font" type="int" access="readonly" default="10">
        <tr lang="en">window font</tr>
        <tr lang="ru">шрифт окна</tr>
      </property>
      <!-- @height -->
      <property name="@height" type="int" access="readonly" default="400">
        <tr lang="en">window height</tr>
        <tr lang="ru">высота окна</tr>
      </property>
      <!-- @name -->
      <property name="@name" type="symbol" access="readonly" default="test_canvas">
        <tr lang="en">canvas name</tr>
        <tr lang="ru">имя холста</tr>
      </property>
      <!-- @paths -->
      <property name="@paths" type="list" access="readonly" default="">
        <tr lang="en">search paths</tr>
        <tr lang="ru">пути поиска</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" access="readonly" default="600 400">
        <tr lang="en">window size</tr>
        <tr lang="ru">размер окна</tr>
      </property>
      <!-- @width -->
      <property name="@width" type="int" access="readonly" default="600">
        <tr lang="en">window width</tr>
        <tr lang="ru">ширина окна</tr>
      </property>
      <!-- @x -->
      <property name="@x" type="int" access="readonly" default="0">
        <tr lang="en">window x-position</tr>
        <tr lang="ru">x-позиция окна</tr>
      </property>
      <!-- @y -->
      <property name="@y" type="int" access="readonly" default="0">
        <tr lang="en">window y-position</tr>
        <tr lang="ru">y-позиция окна</tr>
      </property>
    </properties>
    <methods>
      <!-- postscript -->
      <method name="postscript">
        <info>
          <tr lang="en">saves the patch as a PostScript file</tr>
          <tr lang="ru">сохраняет патч в виде файла PostScript</tr>
        </info>
        <param name="FNAME" type="symbol" required="false">
          <tr lang="en">file name. If not specified, the patch name with the .ps extension is
          used</tr>
          <tr lang="ru">имя файла. Если не указано, используется имя патча с расширением .ps</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">property request</tr>
          <tr lang="ru">запрос свойства</tr>
        </in>
        <in on="bang">
          <tr lang="en">output as dict</tr>
          <tr lang="ru">выводит словарь</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">dict/property output</tr>
          <tr lang="ru">вывод словаря или значения свойства</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[@name?(    [@dir?( [@width?(
|           |       |
|           |       | [@height?(
|           |       | |
| [@x?( [B] | [@y?( | |
| |     |   | |     | |
[canvas.top           ]
|
[ui.dt]

[canvas.top-abs]
]]>
      </pdascii>
      <pdascii id="abs">
<![CDATA[
[bang(                       [bang(
|                            |
[canvas.top-abs0]            [canvas.top-abs1]
|                            |
[ui.dt]                      [ui.dt]
]]>
      </pdascii>
      <pdascii id="abs0">
<![CDATA[
[inlet]
|
[canvas.top @abs 0]
|
[outlet]
]]>
      </pdascii>
      <pdascii id="abs1">
<![CDATA[
[inlet]
|
[canvas.top @abs 1]
|
[outlet]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
