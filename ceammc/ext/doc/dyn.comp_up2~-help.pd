#X msg 110 726 @id;
#X text 245 726 (initonly) Get/Set OSC address id. If specified \,
bind all properties to /ID/dyn_comp_up2/PROP_NAME osc address \, if
empty bind to /dyn_comp_up2/PROP_NAME. Type: symbol.;
#X msg 110 783 @osc;
#X text 245 783 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 110 813 @active;
#X text 245 813 Turn on/off dsp processing. Type: bool. Default value:
1\.;
#X msg 110 843 @attack;
#X text 245 843 Get/Set time constant when level & compression going
up. Type: float. Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 110 900 @bypass;
#X text 245 900 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 110 942 @hold;
#X text 245 942 Get/Set hold period. Type: float. Units: 'samp'. Default
value: 128\. Range: 1\...255\.;
#X msg 110 984 @knee;
#X text 245 984 Get/Set a gradual increase in gain reduction around
the threshold: below thresh-(knee/2) there is no gain reduction \,
above thresh+(knee/2) there is the same gain reduction as without a
knee \, and in between there is a gradual increase in gain reduction.
Type: float. Units: 'db'. Default value: 3\. Range: 0\...24\.;
#X msg 110 1102 @link;
#X text 245 1102 Get/Set the amount of linkage between the channels:
0 = each channel is independent \, 1 = all channels have the same amount
of gain reduction. Type: float. Default value: 1\. Range: 0\...1\.;
#X msg 110 1189 @range;
#X text 245 1189 Get/Set max upward compression range. Type: float.
Units: 'db'. Default value: 12\. Range: 0\...32\.;
#X msg 110 1231 @refresh;
#X text 245 1231 Get/Set compression level output time interval. If
0 - no output. Type: int. Units: 'ms'. Default value: 100\. Range:
0\...1000\.;
#X msg 110 1288 @release;
#X text 245 1288 Get/Set release time = time constant coming out of
compression. Type: float. Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 110 1345 @strength;
#X text 245 1345 Get/Set compression strength (0: no compression \,
1: increase level by @range db.). Type: float. Default value: 0\. Range:
0\...1\.;
#X msg 110 1402 @threshold;
#X text 245 1402 Get/Set level threshold above which compression kicks
in (100 dB = max level). Type: float. Units: 'db'. Default value: -32\.
Range: -60\...0\.;
#X msg 110 1459 @level?;
#X text 245 1459 (readonly) Get current level of compression. Type:
float. Units: 'db'. Default value: 0\. Range: 0\...90\.;
