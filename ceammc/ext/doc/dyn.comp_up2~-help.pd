#X msg 130 658 @id;
#X text 270 658 (initonly) Get/Set OSC address id. If specified \,
bind all properties to /ID/dyn_comp_up2/PROP_NAME osc address \, if
empty bind to /dyn_comp_up2/PROP_NAME. Type: symbol.;
#X msg 130 715 @osc;
#X text 270 715 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 130 745 @active;
#X text 270 745 Turn on/off object dsp processing. Type: bool. Default
value: 1\.;
#X msg 130 787 @attack;
#X text 270 787 Get/Set time constant when level & compression going
up. Type: float. Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 130 844 @bypass;
#X text 270 844 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 130 886 @hold;
#X text 270 886 Get/Set hold period. Type: float. Units: 'samp'. Default
value: 128\. Range: 1\...255\.;
#X msg 130 928 @knee;
#X text 270 928 Get/Set a gradual increase in gain reduction around
the threshold: below thresh-(knee/2) there is no gain reduction \,
above thresh+(knee/2) there is the same gain reduction as without a
knee \, and in between there is a gradual increase in gain reduction.
Type: float. Units: 'db'. Default value: 3\. Range: 0\...24\.;
#X msg 130 1046 @link;
#X text 270 1046 Get/Set the amount of linkage between the channels:
0 = each channel is independent \, 1 = all channels have the same amount
of gain reduction. Type: float. Default value: 1\. Range: 0\...1\.;
#X msg 130 1133 @range;
#X text 270 1133 Get/Set max upward compression range. Type: float.
Units: 'db'. Default value: 12\. Range: 0\...32\.;
#X msg 130 1175 @refresh;
#X text 270 1175 Get/Set compression level output time interval. If
0 - no output. Type: int. Units: 'ms'. Default value: 100\. Range:
0\...1000\.;
#X msg 130 1232 @release;
#X text 270 1232 Get/Set release time = time constant coming out of
compression. Type: float. Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 130 1289 @strength;
#X text 270 1289 Get/Set compression strength (0: no compression \,
1: increase level by @range db.). Type: float. Default value: 0\. Range:
0\...1\.;
#X msg 130 1346 @threshold;
#X text 270 1346 Get/Set level threshold above which compression kicks
in (100 dB = max level). Type: float. Units: 'db'. Default value: -32\.
Range: -60\...0\.;
#X msg 130 1403 @level?;
#X text 270 1403 (readonly) Get current level of compression. Type:
float. Units: 'db'. Default value: 0\. Range: 0\...90\.;
