<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="data.float">
        <title>data.float</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">a multi-functional float object</tr>
                <tr lang="ru">многофункциональный объект числа с плавающей точкой</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data float</keywords>
            <since>0.6</since>
            <also>
                <see>data.int</see>
            </also>
            <aliases>
                <alias>.float</alias>
                <alias>.f</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="VALUE" type="float">
                <tr lang="en">set initial value</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @value -->
            <property name="@value" type="float" access="readonly" default="0">
                <tr lang="en">current value</tr>
            </property>
        </properties>
        <methods>
            <!-- * -->
            <method name="*">
                <info>
                    <tr lang="en">multiply to, no output</tr>
                </info>
            </method>
            <!-- + -->
            <method name="+">
                <info>
                    <tr lang="en">add to float, no output</tr>
                </info>
            </method>
            <method name="-">
                <info>
                    <tr lang="en">subtract from float, no output</tr>
                </info>
            </method>
            <!-- / -->
            <method name="/">
                <info>
                    <tr lang="en">divide by, no output</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">sets new value without output</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output value</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">set new value and outputs</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">set new value without output</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>set output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
| [+ 1.1, bang( [10, bang(
| |             |
| | [* 2, bang( | [/ 3.1, bang(
| | |           | |
| | | [bang(    | |  [F]
| | | |         | |  |.
[.float              100]
|
[F digits=10]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
