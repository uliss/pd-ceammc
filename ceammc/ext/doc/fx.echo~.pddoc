<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="fx.echo~">
        <title>fx.echo~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">enhanced echo effect</tr>
                <tr lang="ru">улучшенный эхо-эффект</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx echo delay</keywords>
            <since>0.6</since>
            <also>
                <see>fx.sdelay~</see>
            </also>
            <aliases>
                <alias>fx.secho~</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: difference between fx.echo~ and fx.delay~ is that echo passes
                original signal with delayed repeats, but fx.delay~ passes only delayed
                repeats.</tr>
            </par>
        </info>
        <arguments>
            <argument name="DELAY" type="float" minvalue="10" maxvalue="10000" units="millisecond">
                <tr lang="en">echo time</tr>
            </argument>
            <argument name="FEEDBACK" type="float" minvalue="0" maxvalue="0.99">
                <tr lang="en">feedback coefficient</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
            </property>
            <!-- @c_attack -->
            <property name="@c_attack" type="float" minvalue="0.1" maxvalue="100" default="10"
            units="millisecond">
                <tr lang="en">feedback compression attack time</tr>
            </property>
            <!-- @c_release -->
            <property name="@c_release" type="float" minvalue="1" maxvalue="500" default="50"
            units="millisecond">
                <tr lang="en">feedback compression release time</tr>
            </property>
            <!-- @c_thresh -->
            <property name="@c_thresh" type="float" minvalue="-60" maxvalue="0" default="0"
            units="decibel">
                <tr lang="en">feedback compression threshold level</tr>
            </property>
            <!-- @compress -->
            <property name="@compress" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">feedback compression factor. 0: means no compression, 1: limit
                feedback level.</tr>
            </property>
            <!-- @delay -->
            <property name="@delay" type="float" minvalue="10" maxvalue="10000" units="millisecond"
            default="500">
                <tr lang="en">echo time</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet</tr>
            </property>
            <!-- @f_hpf -->
            <property name="@f_hpf" type="float" units="hertz" minvalue="20" maxvalue="20000"
            default="300">
                <tr lang="en">feedback high-pass filter cutoff frequency</tr>
            </property>
            <!-- @f_lpf -->
            <property name="@f_lpf" type="float" units="hertz" minvalue="20" maxvalue="20000"
            default="9000">
                <tr lang="en">feedback low-pass filter cutoff frequency</tr>
            </property>
            <!-- @feedback -->
            <property name="@feedback" type="float" minvalue="0" maxvalue="0.99" default="0.3">
                <tr lang="en">feedback coefficient</tr>
            </property>
            <!-- @filter -->
            <property name="@filter" type="bool" default="0">
                <tr lang="en">if true - apply filter to feedback signal</tr>
            </property>
            <!-- @smooth -->
            <property name="@smooth" type="float" default="50" minvalue="0" maxvalue="500"
            units="millisecond">
                <tr lang="en">interpolation time on delay time change, that prevents click and
                transpose, if equal to 0 produces artifacts on delay change</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">set delay time</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env]  [ui.hsl 0 1000]
|             |
[readsf~]     [@delay $1(
|             |
[fx.echo~ 500 0.8]
|
[ui.gain~ @size 120 16]  [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
