<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="is_file">
        <title>is_file</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks if the file exists and accessible</tr>
                <tr lang="ru">проверка существования и доступности файла</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>predicates</category>
            <keywords>predicate filesystem</keywords>
            <since>0.2</since>
            <aliases>
                <alias>ceammc/is_file</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">If relative path is given file searched under patch directory</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">outputs '1' if file exists and can be opened, otherwise '0'</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>0 or 1</outlet>
            <outlet>symbol os String: pass filename if file exists</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[symbol is_file-help.pd(
|
|   [symbol not-exists(
|   |
[is_file]
|
[_]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
