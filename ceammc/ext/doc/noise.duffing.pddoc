<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="noise.duffing">
        <title>noise.duffing</title>
        <meta>
            <authors>
                <author>Paul Bourke</author>
                <author>André Sier</author>
            </authors>
            <description>
                <tr lang="en">chaotic generator based on a Duffing oscillator</tr>
                <tr lang="ru">хаотический генератор на основе осциллятора Дуффинга</tr>
            </description>
            <license>%</license>
            <library>ceammc</library>
            <category>noise</category>
            <keywords>noise</keywords>
            <since>0.5</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Duffing Attractor</tr>
                <tr lang="ru" finished="false">Даффинг аттрактор</tr>
            </par>
            <par>
                <tr lang="en">Written by Paul Bourke</tr>
                <tr lang="ru" finished="false">Автор: Paul Bourke</tr>
            </par>
            <par>
                <tr lang="en">---</tr>
                <tr lang="ru" finished="false">-</tr>
            </par>
            <par>
                <tr lang="en">The solution to the Duffing equations is often used as an example of
                a classic chaotic system.</tr>
                <!-- old: Решение уравнений Даффинга часто используется в
                качестве примера классической хаотической системы. -->
                <tr lang="ru" finished="false">Решение уравнений Даффинга часто используется в
                качестве примера классической хаотической системы.</tr>
            </par>
            <par>
                <tr lang="en">The Duffing system of differential equations is:</tr>
                <tr lang="ru" finished="false">Система Даффинга дифференциальных уравнений:</tr>
            </par>
            <par>
                <tr lang="en">===========</tr>
                <tr lang="ru" finished="false">= = = = = = = = = = =</tr>
            </par>
            <par>
                <tr lang="en">dx / dt = y</tr>
                <tr lang="ru" finished="false">dx/dt = y</tr>
            </par>
            <par>
                <tr lang="en">dy / dt = x - x3 - a y + b cos(w t)</tr>
                <tr lang="ru" finished="false">dy/dt = x - x3 - a y + b cos(w t)</tr>
            </par>
            <par>
                <tr lang="en">===================================</tr>
                <!-- old: = = = = = = = = = = = = = = = = = = = = = = = = = =
                = = = = = = = = = -->
                <tr lang="ru" finished="false">= = = = = = = = = = = = = = = = = = = = = = = = = =
                = = = = = = = = =</tr>
            </par>
            <par>
                <tr lang="en">where typically, a = 0.25, b = 0.3, w = 1</tr>
                <tr lang="ru" finished="false">где обычно a = 0,25, b = 0,3, w = 1</tr>
            </par>
            <par>
                <tr lang="en">The following shows a "typical" segment of (x,y) values.</tr>
                <tr lang="ru" finished="false">Ниже показан «типичный» сегмент (x,y) значений.</tr>
            </par>
        </info>
        <arguments>
            <argument name="A" type="float">
                <tr lang="en">a value (default 0.25), optional</tr>
                <tr lang="ru" finished="false">значение (по умолчанию 0,25), факультативное</tr>
            </argument>
            <argument name="B" type="float">
                <tr lang="en">b value (default 0.3), optional</tr>
                <tr lang="ru" finished="false">b значение (по умолчанию 0,3), факультативное</tr>
            </argument>
            <argument name="W" type="float">
                <tr lang="en">w value (default 1.0), optional</tr>
                <tr lang="ru" finished="false">w значение (по умолчанию 1.0), факультативное</tr>
            </argument>
            <argument name="DT" type="float">
                <tr lang="en">dt value (default 0.01), optional</tr>
                <tr lang="ru" finished="false">dt значение (по умолчанию 0,01), факультативное</tr>
            </argument>
        </arguments>
        <methods>
            <!-- a -->
            <method name="a">
                <param name="A" type="float" required="true">
                    <tr lang="en">a value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- b -->
            <method name="b">
                <param name="B" type="float" required="true">
                    <tr lang="en">b value</tr>
                    <tr lang="ru" finished="false">b значение</tr>
                </param>
            </method>
            <!-- dt -->
            <method name="dt">
                <param name="DT" type="float" required="true">
                    <tr lang="en">dt value</tr>
                    <tr lang="ru" finished="false">значение dt</tr>
                </param>
            </method>
            <!-- om -->
            <method name="om">
                <param name="OM" type="int" required="true">
                    <tr lang="en">enables output when cut or fold value is changed</tr>
                    <!-- old: позволяет вывод при изменении значения разреза
                    или сгиба -->
                    <tr lang="ru" finished="false">позволяет вывод при изменении значения разреза
                    или сгиба</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset state</tr>
                    <tr lang="ru" finished="false">состояние сброса</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <param name="SET" type="float" required="true">
                    <tr lang="en">set to value</tr>
                    <tr lang="ru" finished="false">установить ценность</tr>
                </param>
            </method>
            <!-- w -->
            <method name="w">
                <param name="W" type="float" required="true">
                    <tr lang="en">w value</tr>
                    <tr lang="ru" finished="false">значение</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output value</tr>
                    <tr lang="ru" finished="false">выходная стоимость</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">dx output</tr>
                    <tr lang="ru" finished="false">выход dx</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">dy output</tr>
                    <tr lang="ru" finished="false">выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 50 #metro]

  [T]         [F]
  |           |
  [om $1 #om( [set $1 #set( [reset #reset(

    [F]       [F]       [F]       [F]
    |         |         |         |
    [a $1 #a( [b $1 #b( [w $1 #w( [dt $1 #dt(

[noise.duffing #noise-obj]
|
[ui.display {i=1,o=0}]

[X a:0->noise-obj:0]
[X b:0->noise-obj:0]
[X w:0->noise-obj:0]
[X dt:0->noise-obj:0] 

[X om:0->noise-obj:0]
[X set:0->noise-obj:0]
[X reset:0->noise-obj:0]

[X metro->noise-obj]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
