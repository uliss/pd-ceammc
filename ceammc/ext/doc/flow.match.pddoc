<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flow.match">
        <title>flow.match</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">routes the control flow by the regular expression match</tr>
                <tr lang="ru">маршрутизатор управляющего потока с помощью совпадений с регулярным
                выражением</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>regexp</keywords>
            <since>0.7.1</since>
            <also>
                <see>string.match</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Use backtick ` instead of backslash in regexp syntax</tr>
                <!-- old: Используйте backtick вместо backslash в синтаксисе
                regexp -->
                <tr lang="ru" finished="false">Используйте backtick вместо backslash в синтаксисе
                regexp</tr>
            </par>
            <par>
                <tr lang="en">if you want to match property - use double quotes in arg list:
                "@prop+"</tr>
                <!-- old: если вы хотите сопоставить недвижимость -
                используйте двойные котировки в списке arg: "@prop+" -->
                <tr lang="ru" finished="false">если вы хотите сопоставить недвижимость -
                используйте двойные котировки в списке arg: "@prop+"</tr>
            </par>
            <a href="https://github.com/google/re2">Regexp library: RE2</a>
        </info>
        <arguments>
            <argument name="PATTERNS" type="list" required="true">
                <tr lang="en">list of regular expressions</tr>
                <tr lang="ru" finished="false">Список регулярных выражений</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @cut -->
            <property name="@cut" type="bool" default="0">
                <tr lang="en">cut or pass message selector</tr>
                <tr lang="ru" finished="false">Вырезать или передать селектор сообщений</tr>
            </property>
            <!-- @patterns -->
            <property name="@patterns" type="list" access="initonly" default="">
                <tr lang="en">list of regular expressions</tr>
                <tr lang="ru" finished="false">Список регулярных выражений</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet number="1">
                <in on="any">
                    <tr lang="en">input message</tr>
                    <tr lang="ru" finished="false">вводное сообщение</tr>
                </in>
                <in on="symbol">
                    <tr lang="en">input symbol</tr>
                    <tr lang="ru" finished="false">входной символ</tr>
                </in>
                <in on="data:string">
                    <tr lang="en">input symbol</tr>
                    <tr lang="ru" finished="false">входной символ</tr>
                </in>
            </inlet>
            <inlet number="2">
                <in on="symbol">
                    <tr lang="en">set first regexp</tr>
                    <tr lang="ru" finished="false">Установить первый regexp</tr>
                </in>
            </inlet>
            <inlet number="...">
                <in on="symbol">
                    <tr lang="en">set ... regexp</tr>
                    <tr lang="ru" finished="false">Исполнитель: Regexp</tr>
                </in>
            </inlet>
            <inlet number="n+1">
                <in on="symbol">
                    <tr lang="en">set n-th regexp</tr>
                    <tr lang="ru" finished="false">Настройка n-го regexp</tr>
                </in>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="any">
                    <tr lang="en">output match to first regexp</tr>
                    <tr lang="ru" finished="false">Выходной матч для первого regexp</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">output match to ... regexp</tr>
                    <tr lang="ru" finished="false">Производитель: Regexp</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">output match to n-th regexp</tr>
                    <tr lang="ru" finished="false">выходной матч для n-го regexp</tr>
                </out>
            </outlet>
            <outlet number="n+1">
                <out type="any">
                    <tr lang="en">unmatched output</tr>
                    <tr lang="ru" finished="false">непревзойденный выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[amp2( [amp3( [freq0( [freq1( [unmatched(     [F]
|      |      |       |       |               |
|      |      |       |       |               [@prop $1(
|      |      |       |       |               |
[symbol                       ]               [flow.match "@p.+"]
|                                             |
[S digits=16] [freq3 X( [amp4 Y(              [ui.dt]
|             |         |
|             |         |
[flow.match freq`d amp`d]
|          ^|        ^^|
|           |          |
[ui.dt]     [ui.dt]    [ui.dt]

[flow.match-syntax]
]]>
            </pdascii>
            <pdascii id="syntax">
<![CDATA[
/***general***/

/*`  - escape symbol (instead of \\) */
/*(( - open curly braces (not allowed character in Pd)*/
/*)) - close curly braces (not allowed character in Pd)*/

/***kinds of single-character expressions***/

/*any character:           */       /*.*/
/*character class:         */       /*[xyz]*/
/*negated character class: */       /*[^xyz]*/
/*Perl character class:    */       /*`d*/
/*negated Perl character class: */  /*`D*/

/***composites***/

/*xy  */            /*x followed by y   */
/*x|y */            /*x or y (prefer x) */

/***repetitions***/

/*x*       */       /*zero or more x, prefer more         */
/*x+       */       /*one or more x, prefer more          */
/*x?       */       /*zero or one x, prefer one           */
/*x((n`.m))*/       /*n or n+1 or ... or m x, prefer more */
/*x((n`.)) */       /*n or more x, prefer more            */
/*x((n))   */       /*exactly n x                         */
/*x*?      */       /*zero or more x, prefer fewer        */
/*x+?      */       /*one or more x, prefer fewer         */
/*x??      */       /*zero or one x, prefer zero          */

/***empty strings***/

/*^        */       /*at beginning of text                                                   */
/*$        */       /*at end of text (like `z)                                               */
/*`A       */       /*at beginning of text                                                   */
/*`b       */       /*at ASCII word boundary (`w on one side and `W, `A, or `z on the other) */

/*`B       */       /*not at ASCII word boundary                                             */
/*`z       */       /*at end of text                                                         */

/***escape sequences***/

/*`*           */   /*literal *, for any punctuation character * */
/*`123         */   /*octal character code (up to three digits)  */
/*`x7F         */   /*hex character code (exactly two digits)    */
/*`x((10FFFF)) */   /*hex character code*/

/***perl character classes (all ASCII-only)***/

/*`d */             /*digits (≡ [0-9])                           */
/*`D */             /*not digits (≡ [^0-9])                      */
/*`s */             /*whitespace                                 */
/*`S */             /*not whitespace                             */
/*`w */             /*word characters (≡ [0-9A-Za-z_])           */
/*`W */             /*not word characters (≡ [^0-9A-Za-z_])      */
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
