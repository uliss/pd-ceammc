<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.append">
    <title>flow.append</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">append message to flow stream</tr>
        <tr lang="ru">добавляет сообщение в поток</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow append</keywords>
      <since>0.9</since>
      <also>
        <see>flow.prepend</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Passes the incoming message unchanged and appends the specified message afterward
        (possibly with a delay)</tr>
        <tr lang="ru">Пропускает входное сообщение без изменений и выводит после него добавляемое сообщение
        (возможно через задержку)</tr>
      </par>
      <par>
        <tr lang="en">Note: if you want to specify property message in the init argument, you have
        to quote it with double-quotes</tr>
        <tr lang="ru">Примечание: если вы хотите указать сообщение свойства в начальном
        аргументе, вы должны заключить его в двойные кавычки.</tr>
      </par>
    </info>
    <arguments>
      <argument name="MSG" type="list">
        <tr lang="en">the appended message</tr>
        <tr lang="ru">добавляемое сообщение</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @delay -->
      <property name="@delay" type="float" default="-1" minvalue="-1" units="millisecond">
        <tr lang="en">delay of the output of the added message.
        If &lt;0: outputs immediately, at the same logical time.
        If 0 - outputs after the next DSP block.
        If &gt;0: outputs after the specified time.</tr>
        <tr lang="ru">задержка вывода добавляемого сообщения.
        Если &lt;0: выводит немедленно, в одно и то же логическое время.
        Если: 0 - выводит после следующего блока DSP.
        Если &gt;0: выводит спустя указанное время.</tr>
      </property>
      <!-- @msg -->
      <property name="@msg" type="list" default="">
        <tr lang="en">message appended after incoming one</tr>
        <tr lang="ru">добавляемое сообщение</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="any">
          <tr lang="en">input message</tr>
          <tr lang="ru">входное сообщение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="any">
          <tr lang="en">set the message to append</tr>
          <tr lang="ru">установить добавляемое сообщение</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output messages</tr>
          <tr lang="ru">выходные сообщения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[10(
|
[flow.append APPEND]
|
[print]


[flow.append-more]

[flow.append-delay]
]]>
      </pdascii>
      <pdascii id="delay">
<![CDATA[
/*output after delay:*/

[1 2 3(
|
[flow.append 4 5 6 @delay 500]
|
[print]

/*if the input messages arrive at the same logical time, it outputs the appended message after the last one when delay is specified:*/



[1, 2, 3(
|
[flow.append 4 5 6 @delay 100]
|
[print]

/*no delay:*/

[1, 2, 3(
|
[flow.append 4 5 6]
|
[print]
]]>
      </pdascii>
      <pdascii id="more">
<![CDATA[
/*append the bang (empty message):*/

[symbol A(
|
[flow.append]
|
[print]

/*append the float:*/

[symbol A(
|
[flow.append 10]
|
[print]

/*append the list:*/

[symbol A(
|
[flow.append list B C D]
|
[print]

/*append the message:*/

[symbol A(
|
[flow.append message 1 2 3]
|
[print]

/*append the property message:*/

[symbol A(
|
[flow.append "@property" 1]
|
[print]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
