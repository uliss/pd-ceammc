<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.stack">
    <title>flow.stack</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">message stack</tr>
        <tr lang="ru">стек сообщений</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>stack</keywords>
      <since>0.9.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object stores incoming messages in a LIFO stack: the last pushed message is the first to be popped</tr>
        <tr lang="ru">объект хранит входящие сообщения в стеке LIFO: последнее добавленное сообщение извлекается первым</tr>
      </par>
      <par>
        <tr lang="en">messages on the left inlet are pushed onto the stack, a bang on the right inlet outputs and removes the top element</tr>
        <tr lang="ru">сообщения на левом входе добавляются в стек, bang на правом входе выводит и удаляет верхний элемент</tr>
      </par>
      <par>
        <tr lang="en">the selectors [top(, [pop(, [clear( and [flush( allow to peek, remove, clear or drain the stack</tr>
        <tr lang="ru">селекторы [top(, [pop(, [clear( и [flush( позволяют посмотреть, удалить, очистить или опустошить стек</tr>
      </par>
      <par>
        <tr lang="en">@max_size limits the stack size, @on_empty and @on_full send a message when the stack becomes empty or full</tr>
        <tr lang="ru">@max_size ограничивает размер стека, @on_empty и @on_full отправляют сообщение, когда стек становится пустым или полным</tr>
      </par>
    </info>
    <arguments>
      <argument name="MAX_SIZE" type="int" minvalue="1">
        <tr lang="en">max stack size</tr>
        <tr lang="ru">максимальный размер стека</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @empty -->
      <property name="@empty" type="bool" default="1" access="readonly">
        <tr lang="en">if stack is empty</tr>
        <tr lang="ru">если стек пуст</tr>
      </property>
      <!-- @max_size -->
      <property name="@max_size" type="int" default="100" minvalue="1">
        <tr lang="en">maximum stack grow size</tr>
        <tr lang="ru">максимальный размер стека</tr>
      </property>
      <!-- @on_empty -->
      <property name="@on_empty" type="list" default="">
        <tr lang="en">message sent to the destination address when the stack becomes empty. The first list element is the address to send, other additional elements are treated as a message or bang if not specified.</tr>
        <tr lang="ru">сообщение, отправляемое на адрес назначения, когда стек становится пустым. Первый элемент списка — адрес для отправки, остальные дополнительные элементы трактуются как сообщение или bang, если не указаны</tr>
      </property>
      <!-- @on_full -->
      <property name="@on_full" type="list" default="">
        <tr lang="en">message sent to the destination address when the stack becomes full. The first list element is the address to send, other additional elements are treated as a message or bang if not specified.</tr>
        <tr lang="ru">сообщение, отправляемое на адрес назначения, когда стек становится полным. Первый элемент списка — адрес для отправки, остальные дополнительные элементы трактуются как сообщение или bang, если не указаны</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="int" default="0" access="readonly">
        <tr lang="en">current number of elements in stack</tr>
        <tr lang="ru">текущее количество элементов в стеке</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input: push to stack</tr>
          <tr lang="ru">вход: добавить в стек</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">output and remove top element</tr>
          <tr lang="ru">вывести и удалить верхний элемент</tr>
        </in>
        <in on="any" selector="top">
          <tr lang="en">output top element</tr>
          <tr lang="ru">вывести верхний элемент</tr>
        </in>
        <in on="any" selector="pop">
          <tr lang="en">remove top element (no output)</tr>
          <tr lang="ru">удалить верхний элемент (без вывода)</tr>
        </in>
        <in on="any" selector="clear">
          <tr lang="en">remove all elements (no output)</tr>
          <tr lang="ru">удалить все элементы (без вывода)</tr>
        </in>
        <in on="any" selector="flush">
          <tr lang="en">output and remove all elements</tr>
          <tr lang="ru">вывести и удалить все элементы</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output</tr>
          <tr lang="ru">выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang( [1024( [symbol ABC( [1 2 3( [@any message(
|      |      |            |       |
|      |      |            |       |   [bang( [clear(
|      |      |            |       |   |.     |.
[flow.stack                              {w=53}]
|
[print STACK]

[flow.stack-1]
]]>
      </pdascii>
      <pdascii id="1">
<![CDATA[
[ui.keyboard]
|
|
|
|
|                                     [r \$0-fs]
|                                     |
[list.at 0]                           [T]
|                                     |
[flow.change]                         [metro 110]
| |                                   |.
| [flow.stack 6 @on_empty \$0-fs 0 @on_full \$0-fs 1]
| |
[@pitch $1, @gate 1(
|
[msg synth.dubdub]
|
[gsynth.dubdub~ d1 {i=1,o=1}] [ui.dsp~]
|
|
|
|
|
|
|
|
|
|
[ui.hgain~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
