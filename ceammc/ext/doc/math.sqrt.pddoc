<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.sqrt">
        <title>math.sqrt</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">square root function</tr>
                <tr lang="ru">функция квадратного корня</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math sqrt</keywords>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The sqrt() function compute the non-negative square root of x.</tr>
                <!-- old: Функция sqrt() вычисляет неотрицательный квадратный
                корень x. -->
                <tr lang="ru" finished="false">Функция sqrt() вычисляет неотрицательный квадратный
                корень x.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
                <tr lang="ru" finished="false">Особые ценности:</tr>
            </par>
            <par>
                <tr lang="en">sqrt(-0) returns -0.</tr>
                <tr lang="ru" finished="false">sqrt(-0) возвращается -0.</tr>
            </par>
            <par>
                <tr lang="en">sqrt(x) returns a NaN and generates a domain error for x &lt; 0.</tr>
                <!-- old: sqrt(x) возвращает NaN и генерирует ошибку домена
                для x < 0. -->
                <tr lang="ru" finished="false">sqrt(x) возвращает NaN и генерирует ошибку домена
                для x &lt; 0.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">input value</tr>
                    <tr lang="ru" finished="false">входная стоимость</tr>
                </in>
                <in on="list">
                    <tr lang="en">apply to all numeric values</tr>
                    <tr lang="ru" finished="false">применяется ко всем числовым значениям</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result value</tr>
                    <tr lang="ru" finished="false">значение результата</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[math.sqrt]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
