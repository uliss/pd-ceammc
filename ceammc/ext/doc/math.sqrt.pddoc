<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="math.sqrt">
    <title>math.sqrt</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">square root function</tr>
        <tr lang="ru">функция квадратного корня</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>math</category>
      <keywords>math sqrt</keywords>
      <since>0.1</since>
    </meta>
    <info>
      <par style="info">
        <tr lang="en">compute the non-negative square root</tr>
        <tr lang="ru">вычисляет неотрицательный квадратный корень</tr>
      </par>
      <par style="warning">
        <tr lang="en">Special values:</tr>
        <tr lang="ru">Особые значения:</tr>
      </par>
      <par indent="1" style="warning">
        <tr lang="en">sqrt(-0) returns -0. (negative 0)</tr>
        <tr lang="ru">sqrt(-0) возвращает -0. (отрицательный ноль)</tr>
      </par>
      <par indent="1" style="warning">
        <tr lang="en">sqrt(x) returns a NaN for x&lt;0.</tr>
        <tr lang="ru">sqrt(x) возвращает NaN для x&lt;0.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input number</tr>
          <tr lang="ru">входное число</tr>
        </in>
        <in on="list">
          <tr lang="en">input list, the function is applied only to numbers, the other elements are
          passed unchanged, as is</tr>
          <tr lang="ru">входной список, функция применяется только к числам, остальные элементы
          передаются без изменений, как есть</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">result value</tr>
          <tr lang="ru">значение результата</tr>
        </out>
        <out type="list">
          <tr lang="en">result value</tr>
          <tr lang="ru">значение результата</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]  [-3( [-0(          [array \$0-sqrt yr=0..3 w=320]
|    |    |
[math.sqrt]
|
[F]

[bang(
|
[list.seq 0 9 0.025]
|
[math.sqrt]
|
[list->array \$0-sqrt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
