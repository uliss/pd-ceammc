<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="chaos.gbman0">
        <title>chaos.gbman0</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">gingerbreadman map chaotic generator</tr>
                <tr lang="ru">хаотический генератор на основе отображения Пряничного человечка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>chaos</category>
            <keywords>chaos generator gingerbreadman</keywords>
            <since>0.9</since>
            <also>
                <see>chaos.gbman0</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">A non-interpolating generator based on the difference equations:</tr>
                <!-- old: Неинтерполирующий генератор, основанный на
                разностных уравнениях: -->
                <tr lang="ru" finished="false">Неинтерполирующий генератор, основанный на
                разностных уравнениях:</tr>
            </par>
            <par>
                <tr lang="en">x(n+1) = 1 - y(n) + |x(n)|</tr>
                <tr lang="ru" finished="false">x(n+1) = 1 - y(n) + |x(n) |</tr>
            </par>
            <par>
                <tr lang="en">y(n+1) = x(n)</tr>
                <tr lang="ru" finished="false">y(n+1) = x(n)</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Gingerbreadman_map">wiki: Gingerbreadman map</a>
        </info>
        <arguments>
            <argument name="X" type="float">
                <tr lang="en">initial x value, default 1.2</tr>
                <tr lang="ru" finished="false">начальное значение x, по умолчанию 1.2</tr>
            </argument>
            <argument name="Y" type="float">
                <tr lang="en">initial y value, default 2.1</tr>
                <tr lang="ru" finished="false">начальное значение y, по умолчанию 2.1</tr>
            </argument>
        </arguments>
        <properties />
        <methods />
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">generates and outputs next x-value</tr>
                    <tr lang="ru" finished="false">генерирует и выводит следующее x-значение</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">outputs x-value</tr>
                    <tr lang="ru" finished="false">выходы x-значения</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">outputs y-value</tr>
                    <tr lang="ru" finished="false">выход y-значения</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]         [ui.dsp~]             [r~ gbman~  ]
|                                 |           |
[metro 100]                       [rzero~ -1] [rzero~ 1]
|                                 |           |
[3(                               [clip~ #a]  [clip~ #b]
|                                 |
[list.gen] X [chaos.gbman0]       [flt.resonbp~ 62 40 #c]
|
[l->l -2 7 60 250]                [pan.spread~ 4 {w=18} #z]
|                                 |   ^|.
[list.unpack 3         ]          [ui.hgain2~ @size 15 129]
|          ^|        ^^|          |   ^|.
[sig~]     [* 600]   [/ 250]      [dac~ {w=18}]
|          |         |
[lop~ 25]  [sig~]    [@res $1(
|          |         |
[osc.saw~] [lop~ 6]  |
|          |.        |
[flt.moog_vcf~       ]
|
[s~ gbman~]
[X a->z:1] [X b->z:2]
[X c->z:0] [X c->z:3]
#a -1 1
#b -1 1
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
