<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fx.infrev~">
    <title>fx.infrev~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">port of Infinity VST plugin from "airwindows"</tr>
        <tr lang="ru">порт плагина Infinity VST из "airwindows"</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>fx</category>
      <keywords>fx reverb airwindows infinity</keywords>
      <since>0.9.3</since>
      <also>
        <see>fx.freeverb~</see>
        <see>fx.zita_rev1~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Infinity is a MatrixVerb specifically designed to sustain and layer sounds forever</tr>
        <tr lang="ru">Infinity — это MatrixVerb, специально разработанный для бесконечного удержания и наслоения звуков</tr>
      </par>
      <par>
        <tr lang="en">the object is a stereo reverb with a feedback matrix, which allows very long decay times up to infinite sustain</tr>
        <tr lang="ru">объект представляет собой стереофонический ревербератор с матрицей обратной связи, что позволяет получать очень долгое затухание вплоть до бесконечного удержания</tr>
      </par>
      <par>
        <tr lang="en">@size sets the room size, @filter and @damp control the tone of the reverb, @drywet mixes the original (dry) and processed signals</tr>
        <tr lang="ru">@size задаёт размер комнаты, @filter и @damp управляют тембром реверберации, @drywet смешивает исходный (сухой) и обработанный сигналы</tr>
      </par>
      <a href="https://www.airwindows.com/infinity/">More info</a>
    </info>
    <arguments>
      <argument name="SIZE" type="float" minvalue="0" maxvalue="1">
        <tr lang="en">room size</tr>
        <tr lang="ru">размер комнаты</tr>
      </argument>
      <argument name="DRYWET" type="float" minvalue="0" maxvalue="1">
        <tr lang="en">proportion of mix between the original (dry) and processed signals</tr>
        <tr lang="ru">пропорция смеси между исходным (сухим) и обработанным сигналами</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypass the processed signal</tr>
        <tr lang="ru">флаг обхода. Если true: пропускать обработанный сигнал без изменений</tr>
      </property>
      <!-- @damp -->
      <property name="@damp" type="float" minvalue="0" maxvalue="1" default="0">
        <tr lang="en">damping of the lowpass comb filter</tr>
        <tr lang="ru">демпфирование низкочастотного гребёнчатого фильтра</tr>
      </property>
      <!-- @drywet -->
      <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="1">
        <tr lang="en">proportion of mix between the original (dry) and processed signals. 0 — dry signal, 1 — processed</tr>
        <tr lang="ru">пропорция смеси между исходным (сухим) и обработанным сигналами. 0 — сухой сигнал, 1 — обработанный</tr>
      </property>
      <!-- @filter -->
      <property name="@filter" type="float" minvalue="0" maxvalue="1" default="1">
        <tr lang="en">filter coefficient</tr>
        <tr lang="ru">коэффициент фильтра</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="float" minvalue="0" maxvalue="1" default="0.5">
        <tr lang="en">room size</tr>
        <tr lang="ru">размер комнаты</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset reverb</tr>
          <tr lang="ru">сбросить реверберацию</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input Left signal</tr>
          <tr lang="ru">входной левый сигнал</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">input Right signal</tr>
          <tr lang="ru">входной правый сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output Left signal</tr>
          <tr lang="ru">выходной левый сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output Right signal</tr>
          <tr lang="ru">выходной правый сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(        [loadmsg 0.5 0.2 0.9 0.7 #c]
|
[expand_env] [open %DOC%/sound/voice.wav, 1(
|            |
| [reset #a( [expand_env]             [ui.sliders 4 #x]
|            |                        |
[readsf~]    [readsf~]                |
|            |.        [r $0-r #b]    |
[fx.infrev~ #z]                       |
*|*                                   |
[ui.hgain2~]       [ui.dsp~]          [#l2m(
*|*                                   |
[dac~]                                [s $0-r]
[X a->z]
[X b->z]
[X c->x]
#x @size 125 70
#l2m @filter $1, @damp $2, @size $3, @drywet $4
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
