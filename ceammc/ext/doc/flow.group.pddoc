<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.group">
    <title>flow.group</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">group input atoms in lists of specified size</tr>
        <tr lang="ru">группирует входные атомы в списки заданного размера</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow group</keywords>
      <since>0.3</since>
      <aliases>
        <alias>ceammc/group</alias>
        <alias>group</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object collects incoming atoms into groups of @by elements and outputs each group as a list when it is full</tr>
        <tr lang="ru">объект собирает входящие атомы в группы по @by элементов и выводит каждую группу в виде списка, когда она заполнена</tr>
      </par>
      <par>
        <tr lang="en">the group size is set by the BY argument or the @by property, and can be changed by sending an integer to the right inlet</tr>
        <tr lang="ru">размер группы задаётся аргументом BY или свойством @by и может быть изменён подачей целого числа на правый вход</tr>
      </par>
      <par>
        <tr lang="en">the [flush( method outputs the current incomplete group, the [clear( method discards it</tr>
        <tr lang="ru">метод [flush( выводит текущую незавершённую группу, метод [clear( отбрасывает её</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to reassemble a stream of atoms into fixed-size lists, for example to build note pairs from a stream of pitch and velocity values</tr>
        <tr lang="ru">объект можно использовать для сборки потока атомов в списки фиксированного размера, например чтобы собрать пары нот из потока значений высоты и скорости</tr>
      </par>
    </info>
    <arguments>
      <argument name="BY" type="int" minvalue="1">
        <tr lang="en">group size (the length of the output list)</tr>
        <tr lang="ru">размер группы (длина выходного списка)</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @by -->
      <property name="@by" type="int" minvalue="1" default="1">
        <tr lang="en">group size (the length of the output list)</tr>
        <tr lang="ru">размер группы (длина выходного списка)</tr>
      </property>
      <!-- @free -->
      <property name="@free" type="int" access="readonly" default="0" minvalue="0">
        <tr lang="en">free space left in the current group</tr>
        <tr lang="ru">свободное место, оставшееся в текущей группе</tr>
      </property>
    </properties>
    <methods>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clear the current group without output</tr>
          <tr lang="ru">очистить текущую группу без вывода</tr>
        </info>
      </method>
      <!-- flush -->
      <method name="flush">
        <info>
          <tr lang="en">outputs and clears the current group</tr>
          <tr lang="ru">вывести и очистить текущую группу</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">add float to group and flush if the group is full</tr>
          <tr lang="ru">добавить число в группу и вывести, если группа заполнена</tr>
        </in>
        <in on="symbol">
          <tr lang="en">add symbol to group and flush if the group is full</tr>
          <tr lang="ru">добавить символ в группу и вывести, если группа заполнена</tr>
        </in>
        <in on="list">
          <tr lang="en">add list atoms to group and flush if needed</tr>
          <tr lang="ru">добавить атомы списка в группу и вывести, если нужно</tr>
        </in>
        <in on="data">
          <tr lang="en">add data to group and flush if needed</tr>
          <tr lang="ru">добавить данные в группу и вывести, если нужно</tr>
        </in>
      </inlet>
      <inlet>
        <in on="int">
          <tr lang="en">set group size</tr>
          <tr lang="ru">задать размер группы</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">regrouped input elements</tr>
          <tr lang="ru">перегруппированные входные элементы</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]  [1 2 3(
|    |
|    |
[flow.group @by 5]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
