<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hoa.2d.exchanger~">
    <title>hoa.2d.exchanger~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
        <author>Pierre Guillot</author>
        <author>Eliott Paris</author>
        <author>Thomas Le Meur</author>
      </authors>
      <description>
        <tr lang="en">renumbers and normalizes the channels in 2d ambisonics</tr>
        <tr lang="ru">перенумеровывает и нормализует каналы в двумерных амбисониках</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>spat</category>
      <keywords>hoa exchanger</keywords>
      <since>0.9.7</since>
      <also>
        <see>hoa.3d.exchanger~</see>
      </also>
      <aliases>
        <alias>hoa.exchanger~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Converts between different channel numbering and normalization schemes used
        in 2D ambisonics. The library uses SN2D normalization and ACN numbering as its default
        standard (see the CICM tutorials).</tr>
        <tr lang="ru">Преобразует между различными схемами нумерации каналов и нормализации,
        используемыми в двумерных амбисониках. Библиотека использует нормализацию SN2D и
        нумерацию ACN в качестве стандарта по умолчанию (см. учебные материалы CICM).</tr>
      </par>
      <par>
        <tr lang="en">Supported numbering schemes:</tr>
        <tr lang="ru">Поддерживаемые схемы нумерации:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• ACN (Ambisonic Channel Number, the default). Channels are ordered by
        increasing harmonic degree and, within each degree, by increasing order. This is the
        standard used by most modern ambisonics tools (IRCAM, IEM, Google, Facebook).</tr>
        <tr lang="ru">• ACN (Ambisonic Channel Number — стандарт по умолчанию). Каналы
        упорядочены по возрастанию степени гармоники, а внутри каждой степени — по возрастанию
        порядка. Это стандарт, используемый большинством современных инструментов для
        амбисоников (IRCAM, IEM, Google, Facebook).</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Furse-Malham (also known as FuMa or B-format). Traditional ordering used
        in the original B-format recordings: W, X, Y, Z, R, S, T, U, ... Only the first three
        channels (W, X, Y) are used for 2D. To convert from Furse-Malham, use
        'fromFurseMalham'; to convert to it, use 'toFurseMalham'.</tr>
        <tr lang="ru">• Furse-Malham (также известная как FuMa или B-format). Традиционный
        порядок, использовавшийся в первых записях в формате B: W, X, Y, Z, R, S, T, U, ... В
        2D-амбисониках используются только первые три канала (W, X, Y). Для преобразования из
        Furse-Malham используйте 'fromFurseMalham', для преобразования в неё —
        'toFurseMalham'.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• SID (Single Index Designation). A single-number indexing scheme where
        each channel is identified by a unique integer index computed from the degree and order.
        To convert from SID, use 'fromSID'; to convert to it, use 'toSID'.</tr>
        <tr lang="ru">• SID (Single Index Designation — обозначение одним индексом). Схема, в
        которой каждый канал идентифицируется одним целочисленным индексом, вычисляемым из
        степени и порядка гармоники. Для преобразования из SID используйте 'fromSID', для
        преобразования в неё — 'toSID'.</tr>
      </par>
      <par>
        <tr lang="en">Supported normalization schemes:</tr>
        <tr lang="ru">Поддерживаемые схемы нормализации:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• SN2D (Schmidt semi-normalized 2D, the default). Semi-normalized
        convention for 2D ambisonics, which keeps the spherical harmonic functions orthogonal
        while preserving the directivity pattern of the soundfield.</tr>
        <tr lang="ru">• SN2D (Schmidt semi-normalized 2D — полунормированная схема Шмидта для 2D,
        по умолчанию). Полунормированное соглашение для двумерных амбисоников, при котором
        сферические гармонические функции остаются ортогональными, а направленность звукового
        поля сохраняется.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• MaxN (also known as N3D or fully normalized). Full normalization of
        spherical harmonics, often used in higher-order ambisonics processing. To convert from
        MaxN, use 'fromMaxN'; to convert to it, use 'toMaxN'.</tr>
        <tr lang="ru">• MaxN (также известная как N3D или полная нормализация). Полная
        нормализация сферических гармоник, часто применяемая при обработке амбисоников высших
        порядков. Для преобразования из MaxN используйте 'fromMaxN', для преобразования в неё —
        'toMaxN'.</tr>
      </par>
      <a href="hoa/hoa.2d.exchanger~-help.pd">CICM documentation</a>
    </info>
    <arguments>
      <argument name="ORDER" type="int" minvalue="1" maxvalue="63">
        <tr lang="en">the order of decomposition</tr>
        <tr lang="ru">порядок декомпозиции</tr>
      </argument>
      <argument name="NUM" type="symbol" enum="ACN fromFurseMalham fromSID toFurseMalham toSID">
        <tr lang="en">numbering scheme</tr>
        <tr lang="ru">схема нумерации</tr>
      </argument>
      <argument name="NORM" type="symbol" enum="SN2D fromMaxN toMaxN">
        <tr lang="en">normalization</tr>
        <tr lang="ru">нормализация</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @fromB -->
      <property name="@fromB" type="alias">
        <tr lang="en">alias for @num fromFurseMalham and @norm fromMaxN</tr>
        <tr lang="ru">сокращение для @num fromFurseMalham и @norm fromMaxN</tr>
      </property>
      <!-- @norm -->
      <property name="@norm" type="symbol" default="SN2D" enum="SN2D fromMaxN toMaxN">
        <tr lang="en">normalization</tr>
        <tr lang="ru">нормализация</tr>
      </property>
      <!-- @num -->
      <property name="@num" type="symbol" default="ACN"
      enum="ACN fromFurseMalham fromSID toFurseMalham toSID">
        <tr lang="en">numbering scheme</tr>
        <tr lang="ru">схема нумерации</tr>
      </property>
      <!-- @order -->
      <property name="@order" type="int" minvalue="1" maxvalue="63" default="1" access="initonly">
        <tr lang="en">the order of decomposition</tr>
        <tr lang="ru">порядок декомпозиции</tr>
      </property>
      <!-- @toB -->
      <property name="@toB" type="alias">
        <tr lang="en">alias for @num toFurseMalham and @norm toMaxN</tr>
        <tr lang="ru">сокращение для @num toFurseMalham и @norm toMaxN</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet type="audio">
        <in>
          <tr lang="en">first input harmonic</tr>
          <tr lang="ru">первая входная гармоника</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... input harmonic</tr>
          <tr lang="ru">... входная гармоника</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">n-th input harmonic</tr>
          <tr lang="ru">n-я входная гармоника</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet type="audio">
        <out type="any">
          <tr lang="en">first loudspeaker output</tr>
          <tr lang="ru">выход первого громкоговорителя</tr>
        </out>
      </outlet>
      <outlet type="audio" number="...">
        <out type="any">
          <tr lang="en">... loudspeaker output</tr>
          <tr lang="ru">... выход громкоговорителя</tr>
        </out>
      </outlet>
      <outlet type="audio" number="n">
        <out type="any">
          <tr lang="en">n-th loudspeaker output</tr>
          <tr lang="ru">выход n-го громкоговорителя</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[hoa.2d.exchanger~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
