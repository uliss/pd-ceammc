<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="hoa.2d.exchanger~">
        <title>hoa.2d.exchanger~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
                <author>Pierre Guillot</author>
                <author>Eliott Paris</author>
                <author>Thomas Le Meur</author>
            </authors>
            <description>
                <tr lang="en">renumbers and normalizes the channels in 2d ambisonics</tr>
                <tr lang="ru">перенумерование и нормализация каналов в двумерных амбисониках</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>hoa exchanger</keywords>
            <since>0.9.7</since>
            <also>
                <see>hoa.3d.exchanger~</see>
            </also>
            <aliases>
                <alias>hoa.exchanger~</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">The library default normalization is SN2D and the numbering is ACN
                (cf tutorials). The exchangers will always convert from or to the standard.</tr>
            </par>
            <a href="hoa/hoa.2d.exchanger~-help.pd">CICM documentation</a>
        </info>
        <arguments>
            <argument name="ORDER" type="int" minvalue="1" maxvalue="63">
                <tr lang="en">the order of decomposition</tr>
            </argument>
            <argument name="NUM" type="symbol"
            enum="ACN fromFurseMalham fromSID toFurseMalham toSID">
                <tr lang="en">numbering scheme</tr>
            </argument>
            <argument name="NORM" type="symbol" enum="SN2D fromMaxN toMaxN">
                <tr lang="en">normalization</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @fromB -->
            <property name="@fromB" type="alias">
                <tr lang="en">alias to @num fromFurseMalham and @norm fromMaxN</tr>
            </property>
            <!-- @norm -->
            <property name="@norm" type="symbol" default="SN2D" enum="SN2D fromMaxN toMaxN">
                <tr lang="en">normalization</tr>
            </property>
            <!-- @num -->
            <property name="@num" type="symbol" default="ACN"
            enum="ACN fromFurseMalham fromSID toFurseMalham toSID">
                <tr lang="en">numbering scheme</tr>
            </property>
            <!-- @order -->
            <property name="@order" type="int" minvalue="1" maxvalue="63" default="1"
            access="initonly">
                <tr lang="en">the order of decomposition</tr>
            </property>
            <!-- @toB -->
            <property name="@toB" type="alias">
                <tr lang="en">alias to @num toFurseMalham and @norm toMaxN</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet type="audio">
                <xinfo>first input harmonic</xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>... input harmonic</xinfo>
            </inlet>
            <inlet type="audio" number="n">
                <xinfo>n-th input harmonic</xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio">first loudspeaker output</outlet>
            <outlet type="audio" number="...">... loudspeaker output</outlet>
            <outlet type="audio" number="n">n-th loudspeaker output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[hoa.2d.exchanger~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
