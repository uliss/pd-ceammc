<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="canvas.dir">
    <title>canvas.dir</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">outputs the current canvas directory of the object and the nesting level</tr>
        <tr lang="ru">выводит директорию холста у объекта и уровень его вложенности</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>patch</category>
      <keywords>canvas directory</keywords>
      <also>
        <see>canvas.name</see>
        <see>canvas.path</see>
      </also>
      <since>0.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object outputs the directory of the canvas that contains it, together
        with the nesting level of that canvas. The first outlet sends the directory as a symbol and
        the second outlet sends the nesting level as an integer. The behavior with abstractions is
        controlled by the @abs property.</tr>
        <tr lang="ru">Объект выводит директорию холста, который его содержит, а также уровень
        вложенности этого холста. Из первого выхода отправляется директория в виде символа, из
        второго — уровень вложенности в виде целого числа. Поведение при работе с абстракциями
        управляется свойством @abs.</tr>
      </par>
    </info>
    <properties>
      <!-- @abs -->
      <property name="@abs" type="bool" default="1">
        <tr lang="en">abstraction mode. If 1: outputs the abstraction catalog if the object is
        located within an abstraction, or the path of the top-level parent catalog of the canvas if
        the object was not created within an abstraction. If 0: outputs the topmost parent canvas
        directory even if the object was created inside an abstraction subpatch.</tr>
        <tr lang="ru">режим абстракции. Если 1: выводит каталог абстракции, если объект находится
        внутри абстракции, или путь верхнего родительского каталога холста, если объект не был
        создан внутри абстракции. Если 0: выводит путь верхнего родительского каталога холста, даже
        если объект был создан внутри субпатча абстракции.</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the current canvas directory</tr>
          <tr lang="ru">выводит текущую директорию холста</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="symbol">
          <tr lang="en">current canvas directory</tr>
          <tr lang="ru">текущая директория холста</tr>
        </out>
      </outlet>
      <outlet>
        <out type="int">
          <tr lang="en">nesting level</tr>
          <tr lang="ru">уровень вложенности</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[canvas.dir #a {i=1,o=2}]
|
[ui.dt @auto_size 0 @size 400 45]



        [F #b]

[canvas.dir-abs0] [canvas.dir-abs1]

[X a:1->b]
]]>
      </pdascii>
      <pdascii id="abs0">
<![CDATA[
[B]
|
[canvas.dir-sp0 #a {i=1,o=2}]
|
[ui.dt @auto_size 0 @size 400 45]



        [F #b]

[X a:1->b]
]]>
      </pdascii>
      <pdascii id="abs1">
<![CDATA[
[B]
|
[canvas.dir @abs 0 #a {i=1,o=2}]
|
[ui.dt @auto_size 0 @size 400 45]



        [F #b]

[X a:1->b]
]]>
      </pdascii>
      <pdascii id="sp0">
<![CDATA[
[inlet]
|
[canvas.dir @abs 0]
|         ^|
[outlet]  [outlet]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
