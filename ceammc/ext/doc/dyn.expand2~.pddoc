<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="dyn.expand2~">
        <title>dyn.expand2~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">stereo dynamic range expander with channel linking</tr>
                <tr lang="ru">расширение динамического стерео-диапазона</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>dyn</category>
            <keywords>expander mono</keywords>
            <since>0.9.7</since>
            <also>
                <see>dyn.expand~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">It uses a strength parameter instead of the traditional ratio</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Dynamic_range_compression">Dynamic range
            compression</a>
        </info>
        <arguments>
            <argument name="STRENGTH" type="float" minvalue="0" maxvalue="10">
                <tr lang="en">expander strength (0: no expanding, 10: almost gating)</tr>
                <tr lang="ru">сила экспандера (0: без расширения, 10: практически гейт)</tr>
            </argument>
            <argument name="THRESHOLD" type="float" minvalue="-60" maxvalue="0" units="decibel">
                <tr lang="en">level threshold below which expander kicks in</tr>
                <tr lang="ru">пороговый уровень, ниже которого срабатывает экспандер</tr>
            </argument>
            <argument name="ATTACK" type="float" units="millisecond" minvalue="0.1" maxvalue="100">
                <tr lang="en">attack time = time constant when expander is turning on</tr>
                <tr lang="ru">время атаки - время включения экспандера</tr>
            </argument>
            <argument name="RELEASE" type="float" units="millisecond" minvalue="1" maxvalue="500">
                <tr lang="en">release time = time constant coming out of expanding</tr>
                <tr lang="ru">время спада - время выключения экспандера</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @attack -->
            <property name="@attack" type="float" units="millisecond" default="10" minvalue="0.1"
            maxvalue="100">
                <tr lang="en">time constant when expander is turning on</tr>
            </property>
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
            </property>
            <!-- @hold -->
            <property name="@hold" type="float" units="sample" default="128" minvalue="1"
            maxvalue="255">
                <tr lang="en">hold period</tr>
            </property>
            <!-- @knee -->
            <property name="@knee" type="float" units="decibel" default="3" minvalue="0"
            maxvalue="6">
                <tr lang="en">a gradual increase in gain reduction around the threshold: below
                thresh-(knee/2) there is no gain reduction, above thresh+(knee/2) there is the same
                gain reduction as without a knee, and in between there is a gradual increase in
                gain reduction</tr>
            </property>
            <!-- @level -->
            <property name="@level" type="float" units="decibel" default="0" minvalue="0"
            maxvalue="90" access="readonly">
                <tr lang="en">current expander level</tr>
            </property>
            <!-- @link -->
            <property name="@link" type="float" default="1" minvalue="0" maxvalue="1">
                <tr lang="en">the amount of linkage between the channels: 0 = each channel is
                independent, 1 = all channels have the same amount of gain reduction</tr>
            </property>
            <!-- @range -->
            <property name="@range" type="float" units="decibel" default="-120" minvalue="-120"
            maxvalue="0">
                <tr lang="en">max expand range</tr>
            </property>
            <!-- @refresh -->
            <property name="@refresh" type="int" default="100" minvalue="0" maxvalue="1000"
            units="millisecond">
                <tr lang="en">expander level output time interval. If 0 - no output</tr>
            </property>
            <!-- @release -->
            <property name="@release" type="float" units="millisecond" default="50" minvalue="1"
            maxvalue="500">
                <tr lang="en">release time = time constant coming out of expanding</tr>
            </property>
            <!-- @strength -->
            <property name="@strength" type="float" default="0" minvalue="0" maxvalue="10">
                <tr lang="en">expander strength (0: no expanding, 1: increase level by @range
                db.)</tr>
            </property>
            <!-- @threshold -->
            <property name="@threshold" type="float" units="decibel" default="-48" minvalue="-60"
            maxvalue="0">
                <tr lang="en">level threshold above which compression kicks in (100 dB = max
                level)</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">reset to initial state</method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>left input signal</xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo>right input signal</xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">set expander strength</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">left expanded signal</outlet>
            <outlet type="audio">right expanded signal</outlet>
            <outlet>list: output current expander level in db</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.hsl #a]  [ui.hsl #a]     [T]        [ui.hsl #a]       [ui.dsp~]
|            |               |          |
[dbfs->amp]  [dbfs->amp]     [@link $1( [@threshold $1 #c(
|            |               |          |
[sig~]       [sig~]          [s exp2    ]
|            |
|            |
|            |               [ui.knob 0 10 @label STRENGTH @show_value 1]
| [r exp2]   |               |
| |          |.              |..
[dyn.expand2~ 1 -40 10 100   #x]
|          |                 ^^|
[env~]     [env~]            [unpack f f {o:2} #p]
|          |
[- 100]    [- 100]           [ui.hsl #ch1]
|          |
[F]        [F]               [ui.hsl #ch2]

#a -60 0 @active_scale 1 @show_value 1
#ch1 -60 0 @active_scale 1 @show_value 1
#ch2 -60 0 @active_scale 1 @show_value 1
[X p->ch1]
[X p:1->ch2]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
