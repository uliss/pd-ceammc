<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="lfo.+saw~">
        <title>lfo.+saw~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">positive unit-amplitude low frequency saw wave</tr>
                <tr lang="ru">низкочастотная пилообразная волна в диапазоне [0,+1]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>lfo</category>
            <keywords>lfo oscillator saw</keywords>
            <since>0.7</since>
            <also>
                <see>lfo.saw~</see>
                <see>lfo.+square~</see>
                <see>lfo.impulse~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="0" maxvalue="1000">
                <tr lang="en">frequency</tr>
                <tr lang="ru" finished="false">частота</tr>
            </argument>
            <argument name="INVERT" type="bool">
                <tr lang="en">invert saw</tr>
                <tr lang="ru" finished="false">перевернутая пила</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" default="0" minvalue="0" maxvalue="1000"
            units="hertz">
                <tr lang="en">initial frequency</tr>
                <tr lang="ru" finished="false">Начальная частота</tr>
            </property>
            <!-- @invert -->
            <property name="@invert" type="bool" default="0">
                <tr lang="en">wave inversion</tr>
                <tr lang="ru" finished="false">волновая инверсия</tr>
            </property>
            <!-- @pause -->
            <property name="@pause" type="bool" default="0">
                <tr lang="en">pause oscillator at current value</tr>
                <tr lang="ru" finished="false">осциллятор паузы при текущем значении</tr>
            </property>
            <!-- @phase -->
            <property name="@phase" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">initial phase</tr>
                <tr lang="ru" finished="false">начальный этап</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                    <tr lang="ru" finished="false">Перезагрузка в начальное состояние</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">frequency in Hz (can be negative and zero)</tr>
                    <!-- old: частота в Гц (может быть отрицательной и
                    нулевой) -->
                    <tr lang="ru" finished="false">частота в Гц (может быть отрицательной и
                    нулевой)</tr>
                </in>
            </inlet>
            <inlet>
                <in on="bang">
                    <tr lang="en">reset phase to initial value (@phase)</tr>
                    <tr lang="ru" finished="false">фаза сброса до начального значения (@phase)</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">sawtooth wave in [0-1) range</tr>
                    <tr lang="ru" finished="false">Зенитная волна в [0-1] диапазоне</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]      [T]             [T]
|        |               |
|        [@invert $1 #a( [@pause $1 #b( [bang #c(
|
[lfo.+saw~ 1 #x]
|
[*~ 3000]
|
[+~ 100]
|
[osc~]
|
[ui.gain~ @size 120 14]  [ui.dsp~]
|\
[dac~]

[X a->x]
[X b->x]
[X c->x:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
