<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="hw.kbd_light">
        <title>hw.kbd_light</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
                <author>Hans-Christoph Steiner</author>
            </authors>
            <description>
                <tr lang="en">controlling the keyboard backlight on some devices</tr>
                <tr lang="ru">управление подсветкой клавиатуры на некоторых устройствах</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>keyboard</keywords>
            <since>0.8</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Only Apple keyboards are supported at this moment</tr>
                <!-- old: На данный момент поддерживаются только клавиатуры
                Apple -->
                <tr lang="ru" finished="false">На данный момент поддерживаются только клавиатуры
                Apple</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <in on="float" minvalue="0" maxvalue="1">
                    <tr lang="en">sets current keyboards light level (no output)</tr>
                    <!-- old: устанавливает текущий уровень освещенности
                    клавиатуры (без выхода) -->
                    <tr lang="ru" finished="false">устанавливает текущий уровень освещенности
                    клавиатуры (без выхода)</tr>
                </in>
                <in on="bang">
                    <tr lang="en">outputs current keyboard light level</tr>
                    <tr lang="ru" finished="false">выходы текущего уровня освещения клавиатуры</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">keyboard light level in range 0...1</tr>
                    <tr lang="ru" finished="false">Уровень освещения клавиатуры в диапазоне
                    0...1</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 250] [ui.knob]
|           |
|           |
|           |
[hw.kbd_light]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
