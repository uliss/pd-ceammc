<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.kbd_light">
    <title>hw.kbd_light</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
        <author>Hans-Christoph Steiner</author>
      </authors>
      <description>
        <tr lang="en">controlling the keyboard backlight on some devices</tr>
        <tr lang="ru">управление подсветкой клавиатуры на некоторых устройствах</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>keyboard</keywords>
      <since>0.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Note: only Apple keyboards are supported at this moment.</tr>
        <tr lang="ru">Примечание: в настоящее время поддерживаются только клавиатуры Apple.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Automatic keyboard backlight control — adjusting the backlight brightness
        from a patch, for example reducing it during a performance or matching it to the ambient
        light in the room.</tr>
        <tr lang="ru">• Автоматическое управление подсветкой клавиатуры — изменение яркости
        подсветки из патча, например уменьшение во время выступления или согласование с
        освещённостью помещения.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Reacting to sound with the backlight — using the keyboard backlight as a
        simple visual indicator that follows the sound, for example pulsing in time with the music
        or brightening on loud moments.</tr>
        <tr lang="ru">• Реакция подсветки на звук — использование подсветки клавиатуры как
        простого визуального индикатора, следующего за звуком, например пульсация в такт музыке
        или увеличение яркости на громких моментах.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="float" minvalue="0" maxvalue="1">
          <tr lang="en">sets the current keyboard light level (no output)</tr>
          <tr lang="ru">устанавливает текущий уровень подсветки клавиатуры (без вывода)</tr>
        </in>
        <in on="bang">
          <tr lang="en">outputs the current keyboard light level</tr>
          <tr lang="ru">выводит текущий уровень подсветки клавиатуры</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">keyboard light level in the range 0...1</tr>
          <tr lang="ru">уровень подсветки клавиатуры в диапазоне 0...1</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[metro 250] [ui.knob]
|           |
|           |
|           |
[hw.kbd_light]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
