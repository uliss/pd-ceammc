<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="patch.deps">
    <title>patch.deps</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">output the patch dependencies: used objects and abstractions</tr>
        <tr lang="ru">выводит зависимости патча: используемые объекты и абстракции</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>patch</category>
      <keywords>patch canvas deps</keywords>
      <since>0.9.0</since>
      <also>
        <see>patch.tree</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object scans the patch (or subpatch) and collects the external objects and abstractions used in it</tr>
        <tr lang="ru">объект просматривает патч (или субпатч) и собирает используемые в нём внешние объекты и абстракции</tr>
      </par>
      <par>
        <tr lang="en">the result is output as data:Dict, where keys are library external paths or abstraction full paths and values are external or abstraction names</tr>
        <tr lang="ru">результат выводится как data:Dict, где ключи — это пути к внешним библиотекам или полные пути абстракций, а значения — имена внешних объектов или абстракций</tr>
      </par>
      <par>
        <tr lang="en">Pure Data core objects are listed under the "_core" key</tr>
        <tr lang="ru">объекты ядра Pure Data перечислены под ключом "_core"</tr>
      </par>
    </info>
    <methods>
      <!-- dump -->
      <method name="dump">
        <info>
          <tr lang="en">output dependency tree to the Pd window</tr>
          <tr lang="ru">вывести дерево зависимостей в окно Pd</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="control">
        <in on="bang">
          <tr lang="en">output patch dependencies as Dict. Keys are library external paths or abstraction full paths, values are external or abstraction names. Pure Data core objects are listed under the "_core" key.</tr>
          <tr lang="ru">вывести зависимости патча как Dict. Ключи — это пути к внешним библиотекам или полные пути абстракций, значения — имена внешних объектов или абстракций. Объекты ядра Pure Data перечислены под ключом "_core".</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="control">
        <out type="any">
          <tr lang="en">patch dependency</tr>
          <tr lang="ru">зависимость патча</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang(
|
[patch.deps  ]
|            |
[print DEPS] [dict.reject _core]
             |
             [dict.values]
             |
             [ui.dt]



[patch.deps-abs]
]]>
      </pdascii>
      <pdascii id="abs">
<![CDATA[
[hsl]
|
[F]
|
[ui.hsl]

[patch.deps-abs1]
]]>
      </pdascii>
      <pdascii id="abs1">
<![CDATA[
[hsl]
|
[F]
|
[ui.hsl]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
