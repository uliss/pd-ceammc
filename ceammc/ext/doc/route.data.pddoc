<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="route.data">
    <title>route.data</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">separates data messages from others</tr>
        <tr lang="ru">отделяет сообщения с данными от остальных</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>route any</keywords>
      <since>0.9.6</since>
      <also>
        <see>route.float</see>
        <see>route.list</see>
        <see>route.random</see>
        <see>route.any</see>
      </also>
      <aliases>
        <alias>route.d</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes data messages (such as data:Dict, data:MList or
        data:String) to the first outlet, and all other messages to the second outlet</tr>
        <tr lang="ru">объект направляет сообщения с данными (например, data:Dict, data:MList или
        data:String) на первый выход, а все остальные сообщения — на второй выход</tr>
      </par>
      <par>
        <tr lang="en">the optional TYPE argument or the @type property restricts routing to a
        specific data type, for example MList</tr>
        <tr lang="ru">необязательный аргумент TYPE или свойство @type ограничивает маршрутизацию
        конкретным типом данных, например MList</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to separate data objects from control messages, for
        example to route dictionaries to a data processing chain and plain numbers elsewhere</tr>
        <tr lang="ru">объект можно использовать для отделения объектов данных от управляющих
        сообщений, например чтобы направлять словари в цепочку обработки данных, а простые числа —
        в другое место</tr>
      </par>
    </info>
    <arguments>
      <argument name="TYPE" type="symbol">
        <tr lang="en">routed data type name (optional)</tr>
        <tr lang="ru">имя маршрутизируемого типа данных (необязательно)</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @type -->
      <property name="@type" type="symbol" default="" access="initonly">
        <tr lang="en">routed data type name</tr>
        <tr lang="ru">имя маршрутизируемого типа данных</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="data">
          <tr lang="en">data to the first outlet</tr>
          <tr lang="ru">данные на первый выход</tr>
        </in>
        <in on="any">
          <tr lang="en">any message to the second outlet</tr>
          <tr lang="ru">сообщение any на второй выход</tr>
        </in>
        <in on="bang">
          <tr lang="en">bang to the second outlet</tr>
          <tr lang="ru">bang на второй выход</tr>
        </in>
        <in on="float">
          <tr lang="en">float to the second outlet</tr>
          <tr lang="ru">число на второй выход</tr>
        </in>
        <in on="list">
          <tr lang="en">list to the second outlet</tr>
          <tr lang="ru">список на второй выход</tr>
        </in>
        <in on="symbol">
          <tr lang="en">symbol to the second outlet</tr>
          <tr lang="ru">символ на второй выход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">data output</tr>
          <tr lang="ru">выход данных</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">other messages</tr>
          <tr lang="ru">другие сообщения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                       [route.data-datatype]
|
[data.dict \[a: 1\] #a]

 [bang #b( [L #e]

  [1 #c(

   [S #d]

[route.data  #z]
|       ^|
[ui.dt]  |
         |
         [ui.dt]

[X a->z] [X b->z] [X c->z] [X d->z] [X e->z]
]]>
      </pdascii>
      <pdascii id="datatype">
<![CDATA[
[B]
|
[data.dict \[a: 1\] #a]

  [B]
  |
  [data.mlist (1 2 3) #b]


[route.data MList #z]
|       ^|
[ui.dt]  |
         |
         [ui.dt]

[X a->z] [X b->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
