<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="route.data">
        <title>route.data</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">separates data messages from others</tr>
                <tr lang="ru">отделяет сообщения с данными от других</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>route any</keywords>
            <since>0.9.6</since>
            <also>
                <see>route.float</see>
                <see>route.list</see>
                <see>route.random</see>
                <see>route.any</see>
            </also>
            <aliases>
                <alias>route.d</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="TYPE" type="symbol">
                <tr lang="en">routed data type name (optional)</tr>
                <tr lang="ru" finished="false">имя маршрутизируемого типа данных
                (факультативно)</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @type -->
            <property name="@type" type="symbol" default="" access="initonly">
                <tr lang="en">routed data type name</tr>
                <tr lang="ru" finished="false">имя маршрутизируемого типа данных</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="data">
                    <tr lang="en">data to *first* outlet</tr>
                    <tr lang="ru" finished="false">Данные для *First* Outlet</tr>
                </xinfo>
                <xinfo on="any">
                    <tr lang="en">any to second outlet</tr>
                    <tr lang="ru" finished="false">любой второй выход</tr>
                </xinfo>
                <xinfo on="bang">
                    <tr lang="en">bang to second outlet</tr>
                    <tr lang="ru" finished="false">Bang to Second Outlet (альбом)</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">float to second outlet</tr>
                    <tr lang="ru" finished="false">Поплавать на второй выход</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">list to second outlet</tr>
                    <tr lang="ru" finished="false">Список для второго выхода</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">symbol to second outlet</tr>
                    <tr lang="ru" finished="false">Символ для второго выхода</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">data output</tr>
                    <tr lang="ru" finished="false">выход данных</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">other messages</tr>
                    <tr lang="ru" finished="false">Другие сообщения</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]                       [route.data-datatype]
|
[data.dict \[a: 1\] #a]

 [bang #b( [L #e]

  [1 #c(

   [S #d]

[route.data  #z]
|       ^|
[ui.dt]  |
         |
         [ui.dt]

[X a->z] [X b->z] [X c->z] [X d->z] [X e->z]
]]>
            </pdascii>
            <pdascii id="datatype">
<![CDATA[
[B]
|
[data.dict \[a: 1\] #a]

  [B]
  |
  [data.mlist (1 2 3) #b]


[route.data MList #z]
|       ^|
[ui.dt]  |
         |
         [ui.dt]

[X a->z] [X b->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
