<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="array.convolve">
        <title>array.convolve</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">FFT convolution of the array</tr>
                <tr lang="ru">FFT свертка массива</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array fft convolution</keywords>
            <since>0.9.5</since>
        </meta>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">target array</tr>
                <tr lang="ru">целевой массив</tr>
            </argument>
            <argument name="IR" type="symbol">
                <tr lang="en">array with impulse response</tr>
                <tr lang="ru">массив с импульсным откликом</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">target array</tr>
            </property>
            <!-- @ir -->
            <property name="@ir" type="symbol" default="">
                <tr lang="en">impulse response source array</tr>
            </property>
            <!-- @norm -->
            <property name="@norm" type="bool" default="0">
                <tr lang="en">impulse response normalization</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">start convolution process</xinfo>
            </inlet>
            <inlet>
                <xinfo on="symbol">set array name</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>bang: on done</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[array A-CONV #a]      [array A-IR size=10 w=40 h=130]










[B]
|
[array.convolve A-CONV A-IR]
|
[B]
#a size=100 w=200 h=130
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
