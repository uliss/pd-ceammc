<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.convolve">
    <title>array.convolve</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">FFT convolution of the array</tr>
        <tr lang="ru">FFT-свёртка массива</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array fft convolution</keywords>
      <since>0.9.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object performs an FFT convolution of the target array with an impulse
        response array. The target array is set with the first argument (or the @array property),
        and the impulse response is taken from the array given by the second argument (or the @ir
        property). The convolution is started by a bang on the left inlet. When the process
        finishes, a bang is sent out through the outlet. If the @norm flag is enabled, the impulse
        response is normalized before convolution.</tr>
        <tr lang="ru">Объект выполняет FFT-свёртку целевого массива с массивом импульсного отклика.
        Целевой массив задаётся первым аргументом (или свойством @array), а импульсный отклик
        берётся из массива, указанного вторым аргументом (или свойством @ir). Свёртка запускается
        по bang на левом входе. Когда процесс завершается, через выход отправляется bang. Если
        включён флаг @norm, импульсный отклик нормализуется перед свёрткой.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the target array to write the convolution result into</tr>
        <tr lang="ru">имя целевого массива, в который записывается результат свёртки</tr>
      </argument>
      <argument name="IR" type="symbol">
        <tr lang="en">name of the array that holds the impulse response</tr>
        <tr lang="ru">имя массива, содержащего импульсный отклик</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the target array to write the convolution result into</tr>
        <tr lang="ru">имя целевого массива, в который записывается результат свёртки</tr>
      </property>
      <!-- @ir -->
      <property name="@ir" type="symbol" default="">
        <tr lang="en">name of the array that holds the impulse response</tr>
        <tr lang="ru">имя массива, содержащего импульсный отклик</tr>
      </property>
      <!-- @norm -->
      <property name="@norm" type="bool" default="0">
        <tr lang="en">normalize the impulse response before convolution</tr>
        <tr lang="ru">нормализовать импульсный отклик перед свёрткой</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">starts the convolution process</tr>
          <tr lang="ru">запускает процесс свёртки</tr>
        </in>
      </inlet>
      <inlet>
        <in on="symbol">
          <tr lang="en">sets the array name</tr>
          <tr lang="ru">устанавливает имя массива</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="bang">
          <tr lang="en">sent when the convolution is finished</tr>
          <tr lang="ru">отправляется по завершении свёртки</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[array A-CONV #a]      [array A-IR size=10 w=40 h=130]










[B]
|
[array.convolve A-CONV A-IR]
|
[B]
#a size=100 w=200 h=130
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
