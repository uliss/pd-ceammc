<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="midi.key2str">
        <title>midi.key2str</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">converts the MIDI-key into the SPN name format</tr>
                <tr lang="ru">преобразует номер MIDI-клавиши в имя ноты в формате SPN</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>midi</category>
            <keywords>midi key name spn pitch notation</keywords>
            <aliases>
                <alias>midi.key-&gt;str</alias>
            </aliases>
            <since>0.4</since>
        </meta>
        <arguments>
            <argument name="TONALITY" type="list">
                <tr lang="en">initial tomality</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @symbol -->
            <property name="@symbol" type="flag" default="0" access="initonly">output as symbol
            instead of string by default</property>
            <!-- @tonality -->
            <property name="@tonality" type="list" default="C major">current tonality</property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">standart MIDI key number [0-127]</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output key name</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]  [@tonality F minor( [@tonality E( [@tonality C(
|    |                   |             |
|    |                   |             |
|    |                   |             |
[midi.key->str @symbol                ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
