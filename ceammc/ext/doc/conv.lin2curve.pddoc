<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.lin2curve">
    <title>conv.lin2curve</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">map linear to exponential range with 0 allowed</tr>
        <tr lang="ru">отображает линейный диапазон в экспоненциальный с допустимым нулём</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>convert exponential curve</keywords>
      <also>
        <see>conv.lin2exp</see>
      </also>
      <since>0.1</since>
      <aliases>
        <alias>ceammc/lin-&gt;curve</alias>
        <alias>lin-&gt;curve</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object maps a value from a linear input range to an exponential (curved)
        output range. Unlike [conv.lin2exp], the output range may include zero. If the input value
        exceeds the input range, the behavior is determined by the @clip property.</tr>
        <tr lang="ru">Объект отображает значение из линейного входного диапазона в экспоненциальный
        (изогнутый) выходной диапазон. В отличие от [conv.lin2exp], выходной диапазон может
        включать ноль. Если входное значение выходит за пределы входного диапазона, поведение
        определяется свойством @clip.</tr>
      </par>
      <par>
        <tr lang="en">The @curve property controls the shape of the mapping (following the
        SuperCollider convention): 0 gives a linear response, values less than 0 give a convex
        curve (exponential-like: rises slowly at first and faster toward the upper end of the
        range), and values greater than 0 give a concave curve (logarithmic-like: rises quickly at
        first and slower toward the upper end).</tr>
        <tr lang="ru">Свойство @curve управляет формой отображения (по соглашению SuperCollider):
        0 даёт линейный отклик, значения меньше 0 — выпуклую кривую (похожую на экспоненту:
        сначала растёт медленно, а к верхнему краю диапазона — быстрее), значения больше 0 —
        вогнутую кривую (похожую на логарифм: сначала растёт быстро, а к верхнему краю диапазона
        — медленнее).</tr>
      </par>
    </info>
    <arguments>
      <argument name="IN_FROM" type="float">
        <tr lang="en">beginning of the input range</tr>
        <tr lang="ru">начало входного диапазона</tr>
      </argument>
      <argument name="IN_TO" type="float">
        <tr lang="en">end of the input range</tr>
        <tr lang="ru">конец входного диапазона</tr>
      </argument>
      <argument name="OUT_FROM" type="float">
        <tr lang="en">beginning of the output range</tr>
        <tr lang="ru">начало выходного диапазона</tr>
      </argument>
      <argument name="OUT_TO" type="float">
        <tr lang="en">end of the output range</tr>
        <tr lang="ru">конец выходного диапазона</tr>
      </argument>
      <argument name="CURVE" type="float">
        <tr lang="en">curve shape (see @curve for details)</tr>
        <tr lang="ru">форма кривой (подробности см. в @curve)</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @clip -->
      <property name="@clip" type="symbol" default="minmax" enum="noclip min max minmax">
        <tr lang="en">noclip (do not clip), max (clip ceiling), min (clip floor), minmax (clip
        both)</tr>
        <tr lang="ru">noclip (не ограничивать), max (ограничить сверху), min (ограничить снизу),
        minmax (ограничить с обеих сторон)</tr>
      </property>
      <!-- @curve -->
      <property name="@curve" type="float" default="-4">
        <tr lang="en">0 (linear), &lt;0 (convex, rises slowly at first then faster), &gt;0
        (concave, rises quickly at first then slower)</tr>
        <tr lang="ru">0 (линейная), &lt;0 (выпуклая: сначала растёт медленно, затем быстрее), &gt;0
        (вогнутая: сначала растёт быстро, затем медленнее)</tr>
      </property>
      <!-- @in_from -->
      <property name="@in_from" type="float" default="0">
        <tr lang="en">beginning of the input range</tr>
        <tr lang="ru">начало входного диапазона</tr>
      </property>
      <!-- @in_to -->
      <property name="@in_to" type="float" default="127">
        <tr lang="en">end of the input range</tr>
        <tr lang="ru">конец входного диапазона</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="alias">
        <tr lang="en">alias to @clip max</tr>
        <tr lang="ru">сокращение для @clip max</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="alias">
        <tr lang="en">alias to @clip min</tr>
        <tr lang="ru">сокращение для @clip min</tr>
      </property>
      <!-- @minmax -->
      <property name="@minmax" type="alias">
        <tr lang="en">alias to @clip minmax</tr>
        <tr lang="ru">сокращение для @clip minmax</tr>
      </property>
      <!-- @noclip -->
      <property name="@noclip" type="alias">
        <tr lang="en">alias to @clip noclip</tr>
        <tr lang="ru">сокращение для @clip noclip</tr>
      </property>
      <!-- @out_from -->
      <property name="@out_from" type="float" default="0">
        <tr lang="en">beginning of the output range</tr>
        <tr lang="ru">начало выходного диапазона</tr>
      </property>
      <!-- @out_to -->
      <property name="@out_to" type="float" default="1">
        <tr lang="en">end of the output range</tr>
        <tr lang="ru">конец выходного диапазона</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input value</tr>
          <tr lang="ru">входное значение</tr>
        </in>
        <in on="list">
          <tr lang="en">input list</tr>
          <tr lang="ru">входной список</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">converted value</tr>
          <tr lang="ru">преобразованное значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[loadbang]     [F]              [array l2c size=255 w=250 h=180 yr=0..1]
|              |
[0 256 #d(     [t b f #a]
|              ^|
[list.seq]     [@curve $1 #b(
|
[list.separate             ]
|
[t f f               {w=12}]
|                         ^|
[lin->curve 0 256  0 1 #c] |
|                          |.
[tabwrite                l2c]

[X b->c]
[X a->d]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
