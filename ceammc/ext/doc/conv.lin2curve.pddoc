<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="conv.lin2curve">
        <title>conv.lin2curve</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">map linear to exponential range with 0 allowed</tr>
                <tr lang="ru">отображает линейный диапазон в экспоненциальный с разрешенным 0</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>convert exponential curve</keywords>
            <also>
                <see>conv.lin2exp</see>
            </also>
            <since>0.1</since>
            <aliases>
                <alias>ceammc/lin-&gt;curve</alias>
                <alias>lin-&gt;curve</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">map the receiver from an assumed linear input range to an exponential
                curve output range. Unlike with [conv.lin2exp], the output range may include zero.
                If the input exceeds the input range, the following behaviours are specified by the
                clip property.</tr>
            </par>
        </info>
        <arguments>
            <argument name="IN_FROM" type="float">
                <tr lang="en">begin of input range</tr>
                <tr lang="ru">начало входного диапазона</tr>
            </argument>
            <argument name="IN_TO" type="float">
                <tr lang="en">end of input range</tr>
                <tr lang="ru">конец входного диапазона</tr>
            </argument>
            <argument name="OUT_FROM" type="float">
                <tr lang="en">begin of output range</tr>
                <tr lang="ru">начало выходного диапазона</tr>
            </argument>
            <argument name="OUT_TO" type="float">
                <tr lang="en">end of output range</tr>
                <tr lang="ru">конец выходного диапазона</tr>
            </argument>
            <argument name="CURVE" type="float">
                <tr lang="en">curve shape</tr>
                <tr lang="ru">форма кривой</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @clip -->
            <property name="@clip" type="symbol" default="minmax" enum="noclip min max minmax">
                <tr lang="en">noclip (don't clip) max (clip ceiling) min (clip floor) minmax (clip
                both).</tr>
                <tr lang="ru" finished="false">noclip (Don't Clip) max (clip ceiling) min (clip
                floor) minmax (clip both).</tr>
            </property>
            <!-- @curve -->
            <property name="@curve" type="float" default="-4">
                <tr lang="en">0 (linear) &lt;0 (concave, negatively curved) &gt;0 (convex,
                positively curved)</tr>
                <tr lang="ru" finished="false">0 (линейный) &lt;0 (вогнутый, отрицательно
                изогнутый) &gt;0 (выпуклый, положительно изогнутый)</tr>
            </property>
            <!-- @in_from -->
            <property name="@in_from" type="float" default="0">
                <tr lang="en">begin of input range</tr>
                <tr lang="ru" finished="false">начало входного диапазона</tr>
            </property>
            <!-- @in_to -->
            <property name="@in_to" type="float" default="127">
                <tr lang="en">end of input range</tr>
                <tr lang="ru" finished="false">конец входного диапазона</tr>
            </property>
            <!-- @max -->
            <property name="@max" type="alias">
                <tr lang="en">alias to @clip max</tr>
                <tr lang="ru" finished="false">Исполнитель: @clip max</tr>
            </property>
            <!-- @min -->
            <property name="@min" type="alias">
                <tr lang="en">alias to @clip min</tr>
                <tr lang="ru" finished="false">Исполнитель: @clip Min</tr>
            </property>
            <!-- @minmax -->
            <property name="@minmax" type="alias">
                <tr lang="en">alias to @clip minmax</tr>
                <tr lang="ru" finished="false">Исполнитель: @clip Minmax</tr>
            </property>
            <!-- @noclip -->
            <property name="@noclip" type="alias">
                <tr lang="en">alias to @clip noclip</tr>
                <tr lang="ru" finished="false">Исполнитель: @clip noclip</tr>
            </property>
            <!-- @out_from -->
            <property name="@out_from" type="float" default="0">
                <tr lang="en">begin of output range</tr>
                <tr lang="ru" finished="false">начало выходного диапазона</tr>
            </property>
            <!-- @out_to -->
            <property name="@out_to" type="float" default="1">
                <tr lang="en">end of output range</tr>
                <tr lang="ru" finished="false">предельный выходной диапазон</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">input value</xinfo>
                <xinfo on="list">input list</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>converted value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[loadbang]     [F]              [array l2c size=255 w=250 h=180 yr=0..1]
|              |
[0 256 #d(     [t b f #a]
|              ^|
[list.seq]     [@curve $1 #b(
|
[list.separate             ]
|
[t f f               {w=12}]
|                         ^|
[lin->curve 0 256  0 1 #c] |
|                          |.
[tabwrite                l2c]

[X b->c]
[X a->d]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
