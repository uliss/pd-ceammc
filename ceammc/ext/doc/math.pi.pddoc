<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="math.pi">
    <title>math.pi</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">the mathematical constant π and its multiples</tr>
        <tr lang="ru">математическая константа π и её произведения</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>math</category>
      <keywords>math pi</keywords>
      <also>
        <see>math.e</see>
        <see>math.pi~</see>
      </also>
      <since>0.1</since>
      <aliases>
        <alias>ceammc/pi</alias>
        <alias>pi</alias>
      </aliases>
    </meta>
    <info>
      <par style="info">
        <tr lang="en">The number PI is a mathematical constant, the ratio of a circle's
        circumference to its diameter, commonly approximated as 3.14159.</tr>
        <tr lang="ru">Число Пи — математическая константа, отношение окружности
        круга к его диаметру, обычно аппроксимируемое как 3.14159.</tr>
      </par>
    </info>
    <arguments>
      <argument name="K" type="float">
        <tr lang="en">multiplier - default 1</tr>
        <tr lang="ru">множитель - по умолчанию 1</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @k -->
      <property name="@k" type="float" default="1" access="initonly">
        <tr lang="en">multiplier</tr>
        <tr lang="ru">множитель</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">calculates the value</tr>
          <tr lang="ru">вычисляет значение</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">output value</tr>
          <tr lang="ru">выходное значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]             [B]
|               |
[math.pi]       [math.pi 2]
|               |
[F digits=10]   [F digits=10]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
