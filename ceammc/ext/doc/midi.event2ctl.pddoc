<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="midi.event2ctl">
        <title>midi.event2ctl</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">converts the MidiEvent message into the controller channel/value
                pair</tr>
                <tr lang="ru">конвертирует сообщение MidiEvent в пару канал/значение</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>midi</category>
            <keywords>midi event control</keywords>
            <since>0.4</since>
            <aliases>
                <alias>midi.ev-&gt;ctl</alias>
            </aliases>
        </meta>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">MidiEvent message</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output pair: controller number, value</outlet>
            <outlet>track number</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[openpanel]
|
[read $1, bang(
|
[midi.file]
|
|  [play( [stop(
|  |      |
[midi.track @join @speed 0.7]
|
[midi.ev->ctl]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
