<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="conv.amp2dbfs">
        <title>conv.amp2dbfs</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert from the amplitude to a decibel full scale</tr>
                <tr lang="ru">преобразование из амплитуды в децибелы полной шкалы</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv amp dbfs decibel</keywords>
            <since>0.6</since>
            <also>
                <see>dbfs-&gt;amp</see>
            </also>
            <aliases>
                <alias>ceammc/amp-&gt;dbfs</alias>
                <alias>amp-&gt;dbfs</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: amplitude value 0 is converted to -144 db (24-bit range)</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">input value</xinfo>
                <xinfo on="list">input values</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>converted value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.hsl]
|
[F]
|
[amp->dbfs]
|
[F]

[0 0.5 1 2(
|
[amp->dbfs]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
