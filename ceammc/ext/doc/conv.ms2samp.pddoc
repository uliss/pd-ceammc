<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="conv.ms2samp">
        <title>conv.ms2samp</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">convert time in milliseconds to number of samples according to
                current sample rate</tr>
                <tr lang="ru">преобразовать время в миллисекундах в количество семплов в
                соответствии с текущей скоростью семплирования</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv samp ms</keywords>
            <since>0.2</since>
            <aliases>
                <alias>ceammc/ms-&gt;samp</alias>
                <alias>ms-&gt;samp</alias>
            </aliases>
            <also>
                <see>conv.samp2ms</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">time in milliseconds</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">list of times in milliseconds</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>converted value (float or list)</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F digits=10]
|
[ms->samp]
|
[F digits=10]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
