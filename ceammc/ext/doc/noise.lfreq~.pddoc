<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="noise.lfreq~">
        <title>noise.lfreq~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">[noise.lfreq0~] smoothed with no overshoot</tr>
                <tr lang="ru">сглаженный шум объекта [noise.lfreq0~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>noise</category>
            <keywords>noise lfreq</keywords>
            <since>0.2</since>
            <also>
                <see>noise.lfreq0~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" minvalue="5" maxvalue="22050" units="hertz">
                <tr lang="en">noise generation freq</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="5" maxvalue="22050" default="1000"
            units="hertz">
                <tr lang="en">noise generation freq</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">set average frequency</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[@freq 5000( [@freq 2000(
|            |
[noise.lfreq~ 1000]
|  |
|  [ui.gain~ @size 120 16]
|  |
|  [dac~]
|
|
[ui.scope~ @size=300x100]







[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
