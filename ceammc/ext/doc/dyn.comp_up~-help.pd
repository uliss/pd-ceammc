#X msg 110 765 @osc;
#X text 245 765 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 110 795 @active;
#X text 245 795 Turn on/off object dsp processing. Type: bool. Default
value: 1\.;
#X msg 110 837 @attack;
#X text 245 837 Get/Set time constant when level & compression going
up. Type: float. Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 110 894 @bypass;
#X text 245 894 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 110 936 @hold;
#X text 245 936 Get/Set hold period. Type: float. Units: 'samp'. Default
value: 128\. Range: 1\...255\.;
#X msg 110 978 @knee;
#X text 245 978 Get/Set a gradual increase in gain reduction around
the threshold: below thresh-(knee/2) there is no gain reduction \,
above thresh+(knee/2) there is the same gain reduction as without a
knee \, and in between there is a gradual increase in gain reduction.
Type: float. Units: 'db'. Default value: 3\. Range: 0\...6\.;
#X msg 110 1096 @range;
#X text 245 1096 Get/Set max upward compression range. Type: float.
Units: 'db'. Default value: 32\. Range: 0\...32\.;
#X msg 110 1138 @refresh;
#X text 245 1138 Get/Set compression level output time interval. If
0 - no output. Type: int. Units: 'ms'. Default value: 100\. Range:
0\...1000\.;
#X msg 110 1195 @release;
#X text 245 1195 Get/Set release time = time constant coming out of
compression. Type: float. Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 110 1252 @strength;
#X text 245 1252 Get/Set compression strength (0: no compression \,
1: increase level by @range db.). Type: float. Default value: 0\. Range:
0\...1\.;
#X msg 110 1309 @threshold;
#X text 245 1309 Get/Set level threshold above which compression kicks
in (100 dB = max level). Type: float. Units: 'db'. Default value: -32\.
Range: -60\...0\.;
#X msg 110 1366 @level?;
#X text 245 1366 (readonly) Get current level of compression. Type:
float. Units: 'db'. Default value: 0\. Range: 0\...90\.;
