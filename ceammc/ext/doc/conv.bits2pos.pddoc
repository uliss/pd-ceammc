<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="conv.bits2pos">
        <title>conv.bits2pos</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">converts the list of bits into the list of checked bit position</tr>
                <tr lang="ru">преобразует список битов в список позиций установленных битов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv bits position</keywords>
            <since>0.9.2</since>
            <aliases>
                <alias>ceammc/bits-&gt;pos</alias>
                <alias>bits-&gt;pos</alias>
            </aliases>
            <also>
                <see>conv.bits2int</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: byte default the least significant bit is the rightmost, this
                can be changed with @rev property</tr>
                <!-- old: Примечание: по умолчанию байт наименее значимый бит
                является самым правильным, это может быть изменено свойством @rev -->
                <tr lang="ru" finished="false">Примечание: по умолчанию байт наименее значимый бит
                является самым правильным, это может быть изменено свойством @rev</tr>
            </par>
        </info>
        <properties>
            <!-- @rev -->
            <property name="@rev" type="bool" default="0">
                <tr lang="en">reversed bit order</tr>
                <tr lang="ru">обратный порядок битов</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">input bit list</tr>
                    <tr lang="ru" finished="false">Список входных бит</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">list of bit positions</tr>
                    <tr lang="ru" finished="false">Список битовых позиций</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 0 1 1 0 0 0 0( [T]
|                 |
|                 [@rev $1(
|                 |
[bits->pos        ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
