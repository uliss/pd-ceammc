<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.bits2pos">
    <title>conv.bits2pos</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts the list of bits into the list of checked bit positions</tr>
        <tr lang="ru">преобразует список битов в список позиций установленных битов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv bits position</keywords>
      <since>0.9.2</since>
      <aliases>
        <alias>ceammc/bits-&gt;pos</alias>
        <alias>bits-&gt;pos</alias>
      </aliases>
      <also>
        <see>conv.bits2int</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes a list of bits (0s and 1s) and outputs a list of positions
        of the bits that are set to 1. By default, positions are counted from the rightmost element
        of the input list, so the least significant bit is the rightmost. This can be changed with
        the @rev property, which reverses the bit order.</tr>
        <tr lang="ru">Объект принимает список битов (0 и 1) и выводит список позиций битов,
        установленных в 1. По умолчанию позиции отсчитываются от самого правого элемента входного
        списка — таким образом, младший значащий бит находится справа. Это можно изменить свойством
        @rev, которое инвертирует порядок битов.</tr>
      </par>
    </info>
    <properties>
      <!-- @rev -->
      <property name="@rev" type="bool" default="0">
        <tr lang="en">reversed bit order</tr>
        <tr lang="ru">обратный порядок битов</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">input bit list</tr>
          <tr lang="ru">входной список битов</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">list of bit positions</tr>
          <tr lang="ru">список позиций битов</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[1 0 1 1 0 0 0 0( [T]
|                 |
|                 [@rev $1(
|                 |
[bits->pos        ]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
