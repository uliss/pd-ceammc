<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.sort_with">
        <title>list.sort_with</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sorts the list using a side processing chain</tr>
                <tr lang="ru">сортирует список при помощи боковой цепи обработки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list sort_with</keywords>
            <since>0.2</since>
            <also>
                <see>list.sort</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="int">
                    <tr lang="en">output from compare object (1 or 0)</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>sorted list (or mlist)</outlet>
            <outlet>output list with two element to compare side-chain</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[3 4 1 0 6(  [\(1 2 3 4 5\), bang(
|            |
|            [ml]
|            |
[list.sort_with] X [>]
|
[ui.display @display_type 1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
