<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="synth.sitar~">
        <title>synth.sitar~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">STK sitar</tr>
                <tr lang="ru">синтезатор ситара из библиотеки STK</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>sitar string pluck karplus</keywords>
            <since>0.9.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Implements a sitar plucked string physical model based on the
                Karplus-Strong algorithm</tr>
                <tr lang="ru" finished="false">Внедряет физическую модель ситара, основанную на
                алгоритме Karplus-Strong</tr>
            </par>
        </info>
        <properties>
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="0" maxvalue="480" default="220"
            units="hertz">
                <tr lang="en">maximum speed of whistles</tr>
                <tr lang="ru" finished="false">Максимальная скорость свистка</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">synth gate (&gt;0 - play)</tr>
                <tr lang="ru" finished="false">Synth Gate (&gt;0 - игра)</tr>
            </property>
            <!-- @pitch -->
            <property name="@pitch" type="float" minvalue="36" maxvalue="84" default="57">
                <tr lang="en">midi pitch</tr>
                <tr lang="ru" finished="false">миди-питч</tr>
            </property>
        </properties>
        <methods>
            <!-- cc -->
            <method name="cc">
                <info>
                    <tr lang="en">control change message</tr>
                    <tr lang="ru" finished="false">Контроль изменения сообщения</tr>
                </info>
                <param name="CTL" type="int" required="true">
                    <tr lang="en">control number</tr>
                    <tr lang="ru" finished="false">контрольный номер</tr>
                </param>
                <param name="VAL" type="float" required="true">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- note -->
            <method name="note">
                <info>
                    <tr lang="en">note on/off message</tr>
                    <tr lang="ru" finished="false">примечание/выключение сообщения</tr>
                </info>
                <param name="NOTE" type="float" required="true">
                    <tr lang="en">midi note</tr>
                    <tr lang="ru" finished="false">нота миди</tr>
                </param>
                <param name="VEL" type="float" minvalue="0" maxvalue="127" required="true">
                    <tr lang="en">velocity</tr>
                    <tr lang="ru" finished="false">скорость</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">NOTE VEL</tr>
                    <tr lang="ru" finished="false">Примечание VEL</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">synth output</tr>
                    <tr lang="ru" finished="false">синтетический выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
[note $1 $2( [dump(
|            |
[synth.sitar~]
|
[ui.gain~ @size 120 16]  [ui.dsp~]
| \
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
