<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.matrix" type="gui">
    <title>ui.matrix</title>
    <meta>
      <authors>
        <author>Pierre Guillot</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">toggle matrix</tr>
        <tr lang="ru">матрица переключателей</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui matrix</keywords>
      <since>0.1</since>
      <also>
        <see view="link">ui.radio</see>
        <see view="link">ui.toggle</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">a rectangular matrix of toggle cells. Note: all matrix operations use the
        following cell address format — ROW COL</tr>
        <tr lang="ru">прямоугольная матрица ячеек-переключателей. Примечание: все операции с
        матрицей используют следующий формат адреса ячейки — СТРОКА СТОЛБЕЦ</tr>
      </par>
      <par>
        <tr lang="en">on a click, outputs a message in the format [cell ROW COL VALUE(</tr>
        <tr lang="ru">по клику выводит сообщение в формате [cell ROW COL VALUE(</tr>
      </par>
      <par>
        <tr lang="en">the number of rows and columns is set by the ROW and COL arguments or by the
        @rows and @cols properties</tr>
        <tr lang="ru">количество строк и столбцов задаётся аргументами ROW и COL или свойствами
        @rows и @cols</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to build a step sequencer grid, to route signals
        between several inputs and outputs, or to toggle groups of parameters</tr>
        <tr lang="ru">объект можно использовать для построения сетки шагового секвенсора, для
        маршрутизации сигналов между несколькими входами и выходами или для переключения групп
        параметров</tr>
      </par>
    </info>
    <mouse>
      <event type="drag" editmode="false">toggle cells under cursor</event>
      <event type="left-click" editmode="false">toggle cell under cursor</event>
      <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
      <event type="right-click" editmode="false" keys="Shift">open object help</event>
      <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
      <event type="right-click" editmode="true" keys="Shift">open the object help</event>
      <event type="right-click" editmode="true">open Pd popup menu</event>
    </mouse>
    <arguments>
      <argument name="ROW" type="int" minvalue="1" maxvalue="64">
        <tr lang="en">matrix rows</tr>
        <tr lang="ru">количество строк матрицы</tr>
      </argument>
      <argument name="COL" type="int" minvalue="1" maxvalue="64">
        <tr lang="en">matrix columns</tr>
        <tr lang="ru">количество столбцов матрицы</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_active_color.xml" />
      <xi:include href="props_background_color.xml" />
      <xi:include href="props_border_color.xml" />
      <xi:include href="props_fontname.xml" />
      <xi:include href="props_fontsize.xml" />
      <xi:include href="props_fontslant.xml" />
      <xi:include href="props_fontweight.xml" />
      <xi:include href="props_pinned.xml" />
      <xi:include href="props_ui_receive.xml" />
      <xi:include href="props_ui_send.xml" />
      <xi:include href="props_preset.xml" />
      <!-- @cols -->
      <property name="@cols" type="int" minvalue="1" maxvalue="64" default="8">
        <tr lang="en">number of matrix columns</tr>
        <tr lang="ru">количество столбцов матрицы</tr>
      </property>
      <!-- @current_col -->
      <property name="@current_col" type="int" minvalue="-1" default="-1">
        <tr lang="en">current column index. -1 if not specified. This property is not saved in the
        patch</tr>
        <tr lang="ru">текущий индекс столбца. -1, если не указан. Это свойство не сохраняется в
        патче</tr>
      </property>
      <!-- @current_color -->
      <property name="@current_color" type="list" default="1 0.75 0 1">
        <tr lang="en">current row/column color (list of red, green, blue values in 0–1 range)</tr>
        <tr lang="ru">текущий цвет строки/столбца (список значений красного, зелёного, синего в
        диапазоне 0–1)</tr>
      </property>
      <!-- @current_row -->
      <property name="@current_row" type="int" minvalue="-1" default="-1">
        <tr lang="en">current row index. -1 if not specified. This property is not saved in the
        patch</tr>
        <tr lang="ru">текущий индекс строки. -1, если не указан. Это свойство не сохраняется в
        патче</tr>
      </property>
      <!-- @rows -->
      <property name="@rows" type="int" minvalue="1" maxvalue="64" default="4">
        <tr lang="en">number of matrix rows</tr>
        <tr lang="ru">количество строк матрицы</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="105 53">
        <tr lang="en">object size (width, height pair)</tr>
        <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
      </property>
    </properties>
    <methods>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clears the specified preset</tr>
          <tr lang="ru">очищает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- dump -->
      <method name="dump">
        <info>
          <tr lang="en">dumps all object info to the Pd console window</tr>
          <tr lang="ru">выводит всю информацию об объекте в окно консоли Pd</tr>
        </info>
      </method>
      <!-- flip -->
      <method name="flip">
        <info>
          <tr lang="en">flips all matrix cells</tr>
          <tr lang="ru">переключает все ячейки матрицы</tr>
        </info>
      </method>
      <!-- flip R C -->
      <method name="flip R C">
        <info>
          <tr lang="en">flips a single cell</tr>
          <tr lang="ru">переключает одну ячейку</tr>
        </info>
        <param name="R" type="int" minvalue="0" required="true">
          <tr lang="en">row index</tr>
          <tr lang="ru">индекс строки</tr>
        </param>
        <param name="C" type="int" minvalue="0" required="true">
          <tr lang="en">column index</tr>
          <tr lang="ru">индекс столбца</tr>
        </param>
      </method>
      <!-- flip col N -->
      <method name="flip col N">
        <info>
          <tr lang="en">flips the cells in the specified column</tr>
          <tr lang="ru">переключает ячейки в указанном столбце</tr>
        </info>
        <param name="N" type="int" minvalue="0" required="true">
          <tr lang="en">column index</tr>
          <tr lang="ru">индекс столбца</tr>
        </param>
      </method>
      <!-- flip row N -->
      <method name="flip row N">
        <info>
          <tr lang="en">flips the cells in the specified row</tr>
          <tr lang="ru">переключает ячейки в указанной строке</tr>
        </info>
        <param name="N" type="int" minvalue="0" required="true">
          <tr lang="en">row index</tr>
          <tr lang="ru">индекс строки</tr>
        </param>
      </method>
      <!-- get cell R C -->
      <method name="get cell R C">
        <info>
          <tr lang="en">outputs a single cell value as a message [cell ROW COL VALUE(</tr>
          <tr lang="ru">выводит значение одной ячейки в виде сообщения [cell ROW COL VALUE(</tr>
        </info>
        <param name="R" type="int" minvalue="0" required="true">
          <tr lang="en">row index</tr>
          <tr lang="ru">индекс строки</tr>
        </param>
        <param name="C" type="int" minvalue="0" required="true">
          <tr lang="en">column index</tr>
          <tr lang="ru">индекс столбца</tr>
        </param>
      </method>
      <!-- get cells -->
      <method name="get cells">
        <info>
          <tr lang="en">outputs all cells as separate messages [cell R C VALUE(</tr>
          <tr lang="ru">выводит все ячейки в виде отдельных сообщений [cell R C VALUE(</tr>
        </info>
      </method>
      <!-- get col N -->
      <method name="get col N">
        <info>
          <tr lang="en">outputs the column cells as a message [col N V0 V1...(</tr>
          <tr lang="ru">выводит ячейки столбца в виде сообщения [col N V0 V1...(</tr>
        </info>
        <param name="N" type="int" minvalue="0" required="true">
          <tr lang="en">column index</tr>
          <tr lang="ru">индекс столбца</tr>
        </param>
      </method>
      <!-- get cols -->
      <method name="get cols">
        <info>
          <tr lang="en">outputs all columns as separate messages [col N V0 V1...(</tr>
          <tr lang="ru">выводит все столбцы в виде отдельных сообщений [col N V0 V1...(</tr>
        </info>
      </method>
      <!-- get list -->
      <method name="get list">
        <info>
          <tr lang="en">outputs all cell values as a list, row by row, for example [0 1 1 1
          0...(</tr>
          <tr lang="ru">выводит все значения ячеек в виде списка, строка за строкой, например [0 1
          1 1 0...(</tr>
        </info>
      </method>
      <!-- get matrix -->
      <method name="get matrix">
        <info>
          <tr lang="en">outputs as a matrix [matrix NROWS NCOLS DATA...(</tr>
          <tr lang="ru">выводит в виде матрицы [matrix NROWS NCOLS DATA...(</tr>
        </info>
      </method>
      <!-- get row N -->
      <method name="get row N">
        <info>
          <tr lang="en">outputs the row cells as a message [row N V0 V1...(</tr>
          <tr lang="ru">выводит ячейки строки в виде сообщения [row N V0 V1...(</tr>
        </info>
        <param name="N" type="int" minvalue="0" required="true">
          <tr lang="en">row index</tr>
          <tr lang="ru">индекс строки</tr>
        </param>
      </method>
      <!-- get rows -->
      <method name="get rows">
        <info>
          <tr lang="en">outputs all rows as separate messages [row N V0 V1...(</tr>
          <tr lang="ru">выводит все строки в виде отдельных сообщений [row N V0 V1...(</tr>
        </info>
      </method>
      <!-- interp -->
      <method name="interp">
        <info>
          <tr lang="en">for this object acts as *load*, no interpolation performed</tr>
          <tr lang="ru">для этого объекта действует как *load*, интерполяция не выполняется</tr>
        </info>
      </method>
      <!-- load -->
      <method name="load">
        <info>
          <tr lang="en">loads the specified preset</tr>
          <tr lang="ru">загружает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set UI element position</tr>
          <tr lang="ru">задать положение элемента UI</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top left x-coord</tr>
          <tr lang="ru">x-координата верхнего левого угла</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top right y-coord</tr>
          <tr lang="ru">y-координата верхнего левого угла</tr>
        </param>
      </method>
      <!-- random -->
      <method name="random">
        <info>
          <tr lang="en">fills the matrix randomly and outputs it</tr>
          <tr lang="ru">заполняет матрицу случайными значениями и выводит её</tr>
        </info>
      </method>
      <!-- read -->
      <method name="read">
        <param name="FNAME" type="symbol">
          <tr lang="en">read matrix values from a text file (space separated). If the fname
          argument is not specified, opens a file chooser dialog</tr>
          <tr lang="ru">читает значения матрицы из текстового файла (через пробелы). Если аргумент
          fname не указан, открывается диалог выбора файла</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">unchecks all matrix cells. No output</tr>
          <tr lang="ru">снимает отметки со всех ячеек матрицы. Без вывода</tr>
        </info>
      </method>
      <!-- set col N ... -->
      <method name="set col N ...">
        <info>
          <tr lang="en">sets the specified column without output</tr>
          <tr lang="ru">устанавливает указанный столбец без вывода</tr>
        </info>
        <param name="N" type="int" minvalue="0" required="true">
          <tr lang="en">column index</tr>
          <tr lang="ru">индекс столбца</tr>
        </param>
        <param name="..." type="list" required="true">
          <tr lang="en">cell values (1 — checked, 0 — unchecked)</tr>
          <tr lang="ru">значения ячеек (1 — отмечено, 0 — не отмечено)</tr>
        </param>
      </method>
      <!-- set list ... -->
      <method name="set list ...">
        <info>
          <tr lang="en">sets the matrix data without output</tr>
          <tr lang="ru">устанавливает данные матрицы без вывода</tr>
        </info>
        <param name="..." type="list" required="true">
          <tr lang="en">cell values (1 — checked, 0 — unchecked), row by row</tr>
          <tr lang="ru">значения ячеек (1 — отмечено, 0 — не отмечено), строка за строкой</tr>
        </param>
      </method>
      <!-- set matrix R C ... -->
      <method name="set matrix R C ...">
        <info>
          <tr lang="en">sets the matrix without output</tr>
          <tr lang="ru">устанавливает матрицу без вывода</tr>
        </info>
        <param name="R" type="int" minvalue="1" required="true">
          <tr lang="en">number of rows in the matrix</tr>
          <tr lang="ru">количество строк в матрице</tr>
        </param>
        <param name="C" type="int" minvalue="1" required="true">
          <tr lang="en">number of columns in the matrix</tr>
          <tr lang="ru">количество столбцов в матрице</tr>
        </param>
        <param name="..." type="list" required="true">
          <tr lang="en">cell values (1 — checked, 0 — unchecked)</tr>
          <tr lang="ru">значения ячеек (1 — отмечено, 0 — не отмечено)</tr>
        </param>
      </method>
      <!-- set row N ... -->
      <method name="set row N ...">
        <info>
          <tr lang="en">sets the specified row without output</tr>
          <tr lang="ru">устанавливает указанную строку без вывода</tr>
        </info>
        <param name="N" type="int" minvalue="0" required="true">
          <tr lang="en">row index</tr>
          <tr lang="ru">индекс строки</tr>
        </param>
        <param name="..." type="list" required="true">
          <tr lang="en">cell values (1 — checked, 0 — unchecked)</tr>
          <tr lang="ru">значения ячеек (1 — отмечено, 0 — не отмечено)</tr>
        </param>
      </method>
      <!-- store -->
      <method name="store">
        <info>
          <tr lang="en">stores the specified preset</tr>
          <tr lang="ru">сохраняет указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- write -->
      <method name="write">
        <param name="FNAME" type="symbol">
          <tr lang="en">write matrix values to a text file (space separated). If the fname argument
          is not specified, opens a file chooser dialog</tr>
          <tr lang="ru">записывает значения матрицы в текстовый файл (через пробелы). Если аргумент
          fname не указан, открывается диалог выбора файла</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs all cells. Same as [get cells(</tr>
          <tr lang="ru">выводит все ячейки. То же, что [get cells(</tr>
        </in>
        <in on="list">
          <tr lang="en">sets matrix state. Input format: 0 and 1, row by row</tr>
          <tr lang="ru">устанавливает состояние матрицы. Формат входа: 0 и 1, строка за
          строкой</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output</tr>
          <tr lang="ru">выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
          [F]          [F]
[dump(    |            |
|         [get row $1( [get col $1(
| [reset( |            |
| |       | [bang(     | [flip( [get list( [set matrix 2 2 1 0 0 1 #a(
| |       | |          | |      |
| |       | |          | |      |
[ui.matrix                      #x]
|
|
|
|
[route cell row col]
|    ^|  ^^|   ^^^|
|     |    |      [ui.d]
|     |    |
|     |    [ui.d]
|     |
|     [ui.d]
|
[ui.d]
[X a->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
