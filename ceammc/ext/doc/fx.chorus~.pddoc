<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="fx.chorus~">
        <title>fx.chorus~</title>
        <meta>
            <authors>
                <author>Albert Graef</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">chorus effect</tr>
                <tr lang="ru">хорус-эффект</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx chorus</keywords>
            <since>0.7</since>
        </meta>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
                <!-- old: Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал. -->
                <tr lang="ru" finished="false">Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал.</tr>
            </property>
            <!-- @delay -->
            <property name="@delay" type="float" minvalue="0" maxvalue="200" default="25"
            units="millisecond">
                <tr lang="en">delay amount</tr>
                <tr lang="ru" finished="false">Сумма задержки</tr>
            </property>
            <!-- @depth -->
            <property name="@depth" type="float" minvalue="0" maxvalue="1" default="0.02">
                <tr lang="en">effect depth</tr>
                <tr lang="ru" finished="false">Эффект глубины</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">Ratio between processed signal (wet) and source signal</tr>
                <!-- old: Соотношение между обработанным сигналом (мокрым) и
                исходным сигналом -->
                <tr lang="ru" finished="false">Соотношение между обработанным сигналом (мокрым) и
                исходным сигналом</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="0" maxvalue="10" default="3"
            units="hertz">
                <tr lang="en">effect freq</tr>
                <tr lang="ru" finished="false">эффект freq</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset object</tr>
                    <tr lang="ru" finished="false">сбрасывать объект</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output</tr>
                    <tr lang="ru" finished="false">выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env] [ui.knob]   [F]         [F]
|            |           |           |
|            |           |           |
|            |           |           |
[readsf~]    [@depth $1( [@delay $1( [@freq $1(
|            |           |           |
|            |           |           |
|            |           |           |
[fx.chorus~                          ]
|
[ui.gain~ @size 120 14] [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
