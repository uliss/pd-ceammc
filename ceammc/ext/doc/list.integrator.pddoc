<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="list.integrator">
        <title>list.integrator</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs and stores the list of sums between the previously stored
                list and the current one</tr>
                <tr lang="ru">выводит и сохраняет список сумм между ранее сохраненным списком и
                текущим</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list integrator</keywords>
            <since>0.1</since>
            <also>
                <see>list.delta</see>
            </also>
        </meta>
        <properties>
            <!-- @clip -->
            <property name="@clip" type="alias">
                <tr lang="en">alias for "@oversize min" property. Truncates lists to minimal common
                size.</tr>
            </property>
            <!-- @clip -->
            <property name="@clip" type="alias">
                <tr lang="en">alias for "@oversize clip" property. Pad shortest list with last
                element to conform longest list</tr>
            </property>
            <!-- @fold -->
            <property name="@fold" type="alias">
                <tr lang="en">alias for "@oversize fold" property. Pad shortest list with repeated
                values from the end to the beginning, then back and so on.</tr>
            </property>
            <!-- @min -->
            <property name="@min" type="alias">
                <tr lang="en">alias for "@oversize min" property. Truncates lists to minimal common
                size</tr>
            </property>
            <!-- @oversize -->
            <property name="@oversize" type="symbol" enum="min padz clip wrap fold" default="padz">
                <tr lang="en">behavior, if list have different sizes</tr>
            </property>
            <!-- @padz -->
            <property name="@padz" type="alias">
                <tr lang="en">alias for "@oversize padz" property. Pad shortest list with
                zeroes.</tr>
            </property>
            <!-- @wrap -->
            <property name="@wrap" type="alias">
                <tr lang="en">alias for "@oversize wrap" property. Pad shortest list with repeated
                values from the beginning.</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clear integrator state</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="list">Input list</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>new integrated list</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3(   [-1 -2 -3(
|         |
|  [dump( | [clear(
|  |      | |
|  |      | |
|  |      | |
[list.integrator]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
