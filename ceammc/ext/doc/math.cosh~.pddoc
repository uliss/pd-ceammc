<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="math.cosh~">
    <title>math.cosh~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">hyperbolic cosine for signals</tr>
        <tr lang="ru">гиперболический косинус для сигналов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>math</category>
      <keywords>math cosh hyperbolic</keywords>
      <also>
        <see>math.cosh</see>
        <see>math.acosh~</see>
      </also>
      <since>0.9</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Outputs hyperbolic cosine of input signal</tr>
        <!-- old: Выходы гиперболического косинуса входного
                сигнала -->
        <tr lang="ru" finished="false">Выходы гиперболического косинуса входного сигнала</tr>
      </par>
      <par>
        <tr lang="en">cosh x = (ℯˣ + ℯ⁻ˣ)/2</tr>
        <tr lang="ru" finished="false">cosh x = (ex + e-x)/2</tr>
      </par>
      <a href="https://en.wikipedia.org/wiki/Hyperbolic_functions">wiki: Hyperbolic functions</a>
    </info>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru" finished="false">входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">result signal</tr>
          <tr lang="ru" finished="false">результат сигнала</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[plot.linspace~ -3 3  {w=50} #a]
|            |           |
|            |           [*~ -1]
|            |           |
[math.cosh~] [math.exp~] [math.exp~]
|            |.          |..
[ui.plot~ @xlabels 1 @ylabels 1 @ymin 0 @ymax 20 @size 400 200 @n 3 #b]














[ui.dsp~]
[X a:1->b:3]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
