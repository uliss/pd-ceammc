<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="noise.collatz">
        <title>noise.collatz</title>
        <meta>
            <authors>
                <author>André Sier</author>
            </authors>
            <description>
                <tr lang="en">collatz conjecture output</tr>
                <tr lang="ru">выводит число последовательности Коллаца</tr>
            </description>
            <license>%</license>
            <library>ceammc</library>
            <category>noise</category>
            <keywords>noise</keywords>
            <since>0.5</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Collatz conjecture output</tr>
                <tr lang="ru" finished="false">Вывод гипотезы Коллаца</tr>
            </par>
        </info>
        <arguments/>
        <methods>
            <!-- mode -->
            <method name="mode">
                <param name="MODE" type="int" required="true">
                    <tr lang="en">mode value. 0 for Collatz, 1 for Terras</tr>
                    <!-- old: значение режима. 0 для Collatz, 1 для
                    Terras -->
                    <tr lang="ru" finished="false">значение режима. 0 для Collatz, 1 для
                    Terras</tr>
                </param>
            </method>
            <!-- offset -->
            <method name="offset">
                <param name="OFFSET" type="float" required="true">
                    <tr lang="en">offset value</tr>
                    <tr lang="ru" finished="false">смещенная стоимость</tr>
                </param>
            </method>
            <!-- om -->
            <method name="om">
                <param name="OM" type="int" required="true">
                    <tr lang="en">enables output when cut or fold value is changed</tr>
                    <!-- old: позволяет вывод при изменении значения разреза
                    или сгиба -->
                    <tr lang="ru" finished="false">позволяет вывод при изменении значения разреза
                    или сгиба</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">output value</tr>
                    <tr lang="ru" finished="false">выходная стоимость</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">main outlet</tr>
                    <tr lang="ru" finished="false">главный выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 50 #metro]

  [T]         
  |           
  [om $1 #om( 

 [F]                 [T]
 |                   |
 [offset $1 #offset( [mode $1 #mode(  


[noise.collatz #noise-obj]
|
[ui.display {i=1,o=0}]


[X om:0->noise-obj:0]

[X offset:0->noise-obj:0]
[X mode:0->noise-obj:0]

[X metro->noise-obj]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
