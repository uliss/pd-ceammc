<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env.adsr~">
    <title>env.adsr~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">ADSR (Attack, Decay, Sustain, Release) envelope generator</tr>
        <tr lang="ru">генератор огибающей ADSR (атака, спад, удержание, восстановление)</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>envelope adsr</keywords>
      <since>0.7</since>
    </meta>
    <info>
      <par>
        <tr lang="en">A classic ADSR envelope generator with four stages: Attack (rise from 0 to
        1), Decay (fall from 1 to the sustain level), Sustain (hold at the sustain level while the
        gate is on), and Release (fall back to 0 after the gate is turned off). The envelope
        multiplies the incoming audio signal by its current value, so it is normally used as an
        amplitude envelope for oscillators, samples or other sound sources.</tr>
        <tr lang="ru">Классический генератор огибающей ADSR с четырьмя фазами: атака (рост от 0 до
        1), спад (падение от 1 до уровня удержания), удержание (сигнал держится на уровне
        удержания, пока открыт gate) и восстановление (возврат к 0 после закрытия gate). Огибающая
        умножает входящий аудиосигнал на своё текущее значение, поэтому она обычно используется как
        амплитудная огибающая для осцилляторов, сэмплов и других источников звука.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ATTACK" type="float" units="millisecond" minvalue="0" maxvalue="100000">
        <tr lang="en">attack time</tr>
        <tr lang="ru">время атаки</tr>
      </argument>
      <argument name="DECAY" type="float" units="millisecond" minvalue="0" maxvalue="100000">
        <tr lang="en">decay time</tr>
        <tr lang="ru">время спада</tr>
      </argument>
      <argument name="SUSTAIN" type="float" units="percent" minvalue="0" maxvalue="100">
        <tr lang="en">sustain level (percentage of trigger)</tr>
        <tr lang="ru">уровень удержания (в процентах от триггера)</tr>
      </argument>
      <argument name="RELEASE" type="float" units="millisecond" minvalue="0" maxvalue="100000">
        <tr lang="en">release time</tr>
        <tr lang="ru">время восстановления</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @adsr -->
      <property name="@adsr" type="list" access="readonly">
        <tr lang="en">attack decay sustain release tuple</tr>
        <tr lang="ru">кортеж «атака, спад, удержание, восстановление»</tr>
      </property>
      <!-- @attack -->
      <property name="@attack" type="float" units="millisecond" minvalue="0" maxvalue="100000"
      default="10">
        <tr lang="en">attack time</tr>
        <tr lang="ru">время атаки</tr>
      </property>
      <!-- @decay -->
      <property name="@decay" type="float" units="millisecond" minvalue="0" maxvalue="100000"
      default="10">
        <tr lang="en">decay time</tr>
        <tr lang="ru">время спада</tr>
      </property>
      <!-- @gate -->
      <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
        <tr lang="en">trigger. If &gt; 0 — starts the envelope</tr>
        <tr lang="ru">триггер. Если &gt; 0 — запускает огибающую</tr>
      </property>
      <!-- @release -->
      <property name="@release" type="float" units="millisecond" minvalue="0" maxvalue="100000"
      default="300">
        <tr lang="en">release time</tr>
        <tr lang="ru">время восстановления</tr>
      </property>
      <!-- @sustain -->
      <property name="@sustain" type="float" units="percent" minvalue="0" maxvalue="100"
      default="50">
        <tr lang="en">sustain level — percentage of the trigger signal</tr>
        <tr lang="ru">уровень удержания — в процентах от триггерного сигнала</tr>
      </property>
    </properties>
    <methods>
      <!-- play -->
      <method name="play">
        <info>
          <tr lang="en">runs the envelope and releases it after the specified time</tr>
          <tr lang="ru">запускает огибающую и снимает её через заданное время</tr>
        </info>
        <param name="DUR" type="float" minvalue="0">
          <tr lang="en">duration</tr>
          <tr lang="ru">длительность</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the envelope to its initial state</tr>
          <tr lang="ru">возвращает огибающую в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
        <in on="list">
          <tr lang="en">ATTACK, DECAY, SUSTAIN, RELEASE values are expected</tr>
          <tr lang="ru">ожидаются значения ATTACK, DECAY, SUSTAIN, RELEASE</tr>
        </in>
        <in on="data">
          <tr lang="en">envelope data type</tr>
          <tr lang="ru">тип данных огибающей</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal with the applied envelope</tr>
          <tr lang="ru">выходной сигнал с применённой огибающей</tr>
        </out>
      </outlet>
      <outlet>
        <out type="int">
          <tr lang="en">outputs 1 when the attack/decay phase is finished, 0 when the release phase
          is finished</tr>
          <tr lang="ru">выводит 1 при завершении фазы атаки/спада, 0 — при завершении фазы
          восстановления</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
[unpack                  ]
|                      ^|
|          [sig~ 8000] [cc->amp]  [ui.env @size 200 60 @length 2000]
|          |           |          |
[mtof]     |           [@gate $1( |
|          |           |          |
[osc.tri~] [env.adsr~ 10 50 20 600]
|          |
|          |                         [hsl]
|          |                         |
|          |                         [/ 20]
|          |.                        |..
[bob~                                   ]
|
[ui.gain~ @size 120 14] [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
