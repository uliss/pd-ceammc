<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.filter~" type="gui">
        <title>ui.filter~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sound filter widget</tr>
                <tr lang="ru">виджет звукового фильтра</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui filter biquad</keywords>
            <since>0.9.3</since>
            <also>
                <see view="link">ui.filter</see>
            </also>
        </meta>
        <mouse>
            <event type="left-click" editmode="false">jump to coord under mouse pointer</event>
            <event type="right-click" editmode="false">opens popup menu for filter type
            selection</event>
            <event type="drag" editmode="false">change frequency and Q/gain value</event>
            <event type="wheel" editmode="false">only for peakEq filter: change Q-factor</event>
        </mouse>
        <properties>
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" default="1000" minvalue="0" maxvalue="20000">
                <tr lang="en">filter frequency</tr>
            </property>
            <!-- @gain -->
            <property name="@gain" type="float" default="0" minvalue="-24" maxvalue="24"
            units="decibel">
                <tr lang="en">gain (for low/highshelf/peak filters)</tr>
            </property>
            <!-- @grid_color -->
            <property name="@grid_color" type="list" default="0.6 0.6 0.6 1">
                <tr lang="en">knob color</tr>
            </property>
            <!-- @knob_color -->
            <property name="@knob_color" type="list" default="0 0.75 1 1">
                <tr lang="en">knob color</tr>
            </property>
            <!-- @label_color -->
            <property name="@label_color" type="list" default="0.6 0.6 0.6 1">
                <tr lang="en">label color in RGB format within 0-1 range, for example: 0.2 0.4
                0.1</tr>
            </property>
            <xi:include href="props_label.xml" />
            <xi:include href="props_label_align.xml" />
            <xi:include href="props_label_inner.xml" />
            <xi:include href="props_label_margins.xml" />
            <xi:include href="props_label_side.xml" />
            <xi:include href="props_label_valign.xml" />
            <!-- @mouse_events -->
            <property name="@mouse_events" type="bool" default="0">
                <tr lang="en">mouse events output mode. If on outputs @mouse_down, @mouse_up and
                @mouse_drag events</tr>
            </property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="0">
                <tr lang="en">pin mode. if 1 - put element to the lowest level</tr>
            </property>
            <!-- @plot_color -->
            <property name="@plot_color" type="list" default="0 0 0 1">
                <tr lang="en">knob color</tr>
            </property>
            <!-- @presetname -->
            <property name="@presetname" type="symbol" default="(null)">
                <tr lang="en">preset name for using with [ui.preset]</tr>
            </property>
            <!-- @q -->
            <property name="@q" type="float" default="0.7071" minvalue="0.0156" maxvalue="64">
                <tr lang="en">quality factor</tr>
            </property>
            <!-- @receive -->
            <property name="@receive" type="symbol" default="(null)">
                <tr lang="en">receive source</tr>
            </property>
            <!-- @scale -->
            <property name="@scale" type="symbol" default="lin" enum="lin log rad">
                <tr lang="en">frequency scale</tr>
            </property>
            <!-- @send -->
            <property name="@send" type="symbol" default="(null)">
                <tr lang="en">send destination</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="300 100">
                <tr lang="en">element size (width, height pair)</tr>
            </property>
            <!-- @type -->
            <property name="@type" type="symbol" default="lpf"
            enum="lpf hpf bpf bpfq lowshelf highshelf peak notch">
                <tr lang="en">frequency scale</tr>
            </property>
        </properties>
        <methods>
            <!-- biquad -->
            <method name="biquad">set biquad coefficients (but not changes current filter
            properties) 
            <param name="b0 b1 b2 a1 a2" type="list" required="true">coefficients</param></method>
            <!-- clear -->
            <method name="clear">clears specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
            <!-- dump -->
            <method name="dump">dumps all object info to Pd console window</method>
            <!-- interp -->
            <method name="interp">for this object acts as *load*, no interpolation
            performed</method>
            <!-- load -->
            <method name="load">loads specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
            <!-- store -->
            <method name="store">stores specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>input signal</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">filtered signal</outlet>
            <outlet type="control">list: filter biquad coefficient</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[noise~] [ui.tab lin log rad] [ui.tab lpf hpf bpf bpfq @size 160 15]
|        |                    |
|        [@scale $2(          [@type $2(
|        |                    |
[ui.filter~                   ]
|                            ^|
|                            |
|                            |
|                            |
|                            |
|                            |
|                            |
[ui.hgain~]     [ui.dsp~]    [ui.dt]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
