<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="ui.lcd" type="gui">
        <title>ui.lcd</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">black and white bitmap display</tr>
                <tr lang="ru">черно-белый растровый дисплей</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui display</keywords>
            <since>0.9.7</since>
        </meta>
        <mouse>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_label.xml" />
            <xi:include href="props_label_align.xml" />
            <xi:include href="props_label_inner.xml" />
            <xi:include href="props_label_margins.xml" />
            <xi:include href="props_label_side.xml" />
            <xi:include href="props_label_valign.xml" />
            <xi:include href="props_pinned.xml" />
            <xi:include href="props_ui_receive.xml" />
            <xi:include href="props_ui_send.xml" />
            <!-- @background_color -->
            <property name="@background_color" type="list" default="1 1 1 1">
                <tr lang="en">element background color (list of red, green, blue values in 0-1
                range)</tr>
            </property>
            <!-- @cols -->
            <property name="@cols" type="int" minvalue="2" maxvalue="128" default="8">
                <tr lang="en">number of columns</tr>
            </property>
            <!-- @pixels -->
            <property name="@pixels" type="int" default="64" access="readonly">
                <tr lang="en">number of pixels</tr>
            </property>
            <!-- @rows -->
            <property name="@rows" type="int" minvalue="2" maxvalue="128" default="8">
                <tr lang="en">number of rows</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="64 64">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clear display</tr>
                </info>
            </method>
            <!-- draw down -->
            <method name="draw down">
                <info>
                    <tr lang="en">moves draw cursor down along y-asis ans draw single pixel</tr>
                </info>
                <param name="YOFF" type="int" required="false">
                    <tr lang="en">y-offset. If omitted: 1</tr>
                </param>
            </method>
            <!-- draw left -->
            <method name="draw left">
                <info>
                    <tr lang="en">moves draw cursor left along x-asis ans draw single pixel</tr>
                </info>
                <param name="XOFF" type="int" required="false">
                    <tr lang="en">x-offset. If omitted: 1</tr>
                </param>
            </method>
            <!-- draw right -->
            <method name="draw right">
                <info>
                    <tr lang="en">moves cursor right along x-asis ans draw single pixel</tr>
                </info>
                <param name="XOFF" type="int" required="false">
                    <tr lang="en">x-offset. If omitted: 1</tr>
                </param>
            </method>
            <!-- draw set -->
            <method name="draw set">
                <info>
                    <tr lang="en">set drawing value</tr>
                </info>
                <param name="VALUE" type="bool" required="true">
                    <tr lang="en">draw pixel value (1: black, 0: white)</tr>
                </param>
            </method>
            <!-- draw up -->
            <method name="draw up">
                <info>
                    <tr lang="en">moves draw cursor up along y-asis ans draw single pixel</tr>
                </info>
                <param name="YOFF" type="int" required="false">
                    <tr lang="en">y-offset. If omitted: 1</tr>
                </param>
            </method>
            <!-- dump -->
            <method name="dump">
                <info>
                    <tr lang="en">dumps all object info to Pd console window.</tr>
                </info>
            </method>
            <!-- invert -->
            <method name="invert">
                <info>
                    <tr lang="en">invert display</tr>
                </info>
            </method>
            <!-- pos -->
            <method name="pos">
                <info>
                    <tr lang="en">set UI element position</tr>
                </info>
                <param name="X" type="float" required="true">
                    <tr lang="en">top left x-coord</tr>
                </param>
                <param name="Y" type="float" required="true">
                    <tr lang="en">top right y-coord</tr>
                </param>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">set display content</tr>
                </info>
                <param name="PIXELS" type="list" required="true">
                    <tr lang="en">pixel values</tr>
                </param>
            </method>
            <!-- set col -->
            <method name="set col">
                <info>
                    <tr lang="en">set column content</tr>
                </info>
                <param name="N" type="int" required="true">
                    <tr lang="en">column index</tr>
                </param>
                <param name="PIXELS" type="list" required="true">
                    <tr lang="en">column pixel values</tr>
                </param>
            </method>
            <!-- set cursor -->
            <method name="set cursor">
                <info>
                    <tr lang="en">set draw cursor point</tr>
                </info>
                <param name="X" type="int" required="true">
                    <tr lang="en">X-position (from left)</tr>
                </param>
                <param name="Y" type="int" required="true">
                    <tr lang="en">Y-position (from top)</tr>
                </param>
            </method>
            <!-- set matrix -->
            <method name="set matrix">
                <info>
                    <tr lang="en">set matrix data</tr>
                </info>
                <param name="NROWS" type="int" required="true">
                    <tr lang="en">matrix row number</tr>
                </param>
                <param name="NCOLS" type="int" required="true">
                    <tr lang="en">matrix column numbers</tr>
                </param>
                <param name="VALUES" type="list" required="true">
                    <tr lang="en">pixel values</tr>
                </param>
            </method>
            <!-- set pixel -->
            <method name="set pixel">
                <info>
                    <tr lang="en">set single pixel</tr>
                </info>
                <param name="X" type="int" required="true">
                    <tr lang="en">X-position (from left)</tr>
                </param>
                <param name="Y" type="int" required="true">
                    <tr lang="en">Y-position (from top)</tr>
                </param>
                <param name="VALUE" type="bool" required="true">
                    <tr lang="en">pixel value</tr>
                </param>
            </method>
            <!-- set row -->
            <method name="set row">
                <info>
                    <tr lang="en">set row content</tr>
                </info>
                <param name="N" type="int" required="true">
                    <tr lang="en">row index</tr>
                </param>
                <param name="PIXELS" type="list" required="true">
                    <tr lang="en">row pixel values</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">command input</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>...</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[S digits=12]                               [clear, text 1 7 TEST, get matrix(
|                                           |
[qrcode         ]                           [bitmap 21 21]
|              ^|                           |
[msg set list] [@cols #b(                   [msg set #a]
|              |
|              |   [invert( [clear(
|              |   |        |
[ui.lcd @size 120 120 @nosave 1 #x]






/* */
[X a->x]
#b $1, @rows $1, @size 120 120
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
