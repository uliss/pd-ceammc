<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.lcd" type="gui">
        <title>ui.lcd</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">black and white bitmap display</tr>
                <tr lang="ru">черно-белый растровый дисплей</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui display</keywords>
            <since>0.9.7</since>
        </meta>
        <mouse>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <!-- @background_color -->
            <property name="@background_color" type="list" default="1 1 1 1">
                <tr lang="en">element background color (list of red, green, blue values in 0-1
                range)</tr>
            </property>
            <xi:include href="props_border_color.xml" />
            <!-- @cols -->
            <property name="@cols" type="int" minvalue="2" maxvalue="128" default="8">
                <tr lang="en">number of columns</tr>
            </property>
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <!-- @fontslant -->
            <property name="@fontslant" type="symbol" enum="roman italic" default="roman">
                <tr lang="en">font slant</tr>
            </property>
            <!-- @fontweight -->
            <property name="@fontweight" type="symbol" enum="normal bold" default="normal">
                <tr lang="en">font weight</tr>
            </property>
            <!-- @label -->
            <property name="@label" type="symbol" default="(null)">
                <tr lang="en">label text</tr>
            </property>
            <!-- @label_align -->
            <property name="@label_align" type="symbol" enum="left center right" default="left">
                <tr lang="en">label horizontal align</tr>
            </property>
            <!-- @label_color -->
            <property name="@label_color" type="list" default="0 0 0 1">
                <tr lang="en">label color in RGB format within 0-1 range, for example: 0.2 0.4
                0.1</tr>
            </property>
            <!-- @label_inner -->
            <property name="@label_inner" type="bool" default="0">
                <tr lang="en">label position (1 - inner, 0 - outer).</tr>
            </property>
            <!-- @label_margins -->
            <property name="@label_margins" type="list" default="0 0">
                <tr lang="en">label offset in pixels</tr>
            </property>
            <!-- @label_side -->
            <property name="@label_side" type="symbol" enum="left top right bottom" default="top">
                <tr lang="en">label snap side</tr>
            </property>
            <!-- @label_valign -->
            <property name="@label_valign" type="symbol" enum="top center bottom" default="top">
                <tr lang="en">label vertical align</tr>
            </property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="0">
                <tr lang="en">pin mode. if 1 - put element to the lowest level</tr>
            </property>
            <!-- @pixels -->
            <property name="@pixels" type="int" default="64" access="readonly">
                <tr lang="en">number of pixels</tr>
            </property>
            <!-- @receive -->
            <property name="@receive" type="symbol" default="(null)">
                <tr lang="en">receive source</tr>
            </property>
            <!-- @rows -->
            <property name="@rows" type="int" minvalue="2" maxvalue="128" default="8">
                <tr lang="en">number of rows</tr>
            </property>
            <!-- @send -->
            <property name="@send" type="symbol" default="(null)">
                <tr lang="en">send destination</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="64 64">
                <tr lang="en">element size (width, height pair)</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">clear display</method>
            <!-- draw down -->
            <method name="draw down">moves draw cursor down along y-asis ans draw single pixel 
            <param name="YOFF" type="int" required="false">y-offset. If omitted: 1</param></method>
            <!-- draw left -->
            <method name="draw left">moves draw cursor left along x-asis ans draw single pixel 
            <param name="XOFF" type="int" required="false">x-offset. If omitted: 1</param></method>
            <!-- draw right -->
            <method name="draw right">moves cursor right along x-asis ans draw single pixel 
            <param name="XOFF" type="int" required="false">x-offset. If omitted: 1</param></method>
            <!-- draw set -->
            <method name="draw set">set drawing value 
            <param name="VALUE" type="bool" required="true">draw pixel value (1: black, 0:
            white)</param></method>
            <!-- draw up -->
            <method name="draw up">moves draw cursor up along y-asis ans draw single pixel 
            <param name="YOFF" type="int" required="false">y-offset. If omitted: 1</param></method>
            <!-- dump -->
            <method name="dump">dumps all object info to Pd console window.</method>
            <!-- invert -->
            <method name="invert">invert display</method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
            <!-- set -->
            <method name="set">set display content 
            <param name="PIXELS" type="list" required="true">pixel values</param></method>
            <!-- set col -->
            <method name="set col">set column content 
            <param name="N" type="int" required="true">column index</param>
            <param name="PIXELS" type="list" required="true">column pixel values</param></method>
            <!-- set cursor -->
            <method name="set cursor">set draw cursor point 
            <param name="X" type="int" required="true">X-position (from left)</param>
            <param name="Y" type="int" required="true">Y-position (from top)</param></method>
            <!-- set matrix -->
            <method name="set matrix">set matrix data 
            <param name="NROWS" type="int" required="true">matrix row number</param>
            <param name="NCOLS" type="int" required="true">matrix column numbers</param>
            <param name="VALUES" type="list" required="true">pixel values</param></method>
            <!-- set pixel -->
            <method name="set pixel">set single pixel 
            <param name="X" type="int" required="true">X-position (from left)</param>
            <param name="Y" type="int" required="true">Y-position (from top)</param>
            <param name="VALUE" type="bool" required="true">pixel value</param></method>
            <!-- set row -->
            <method name="set row">set row content 
            <param name="N" type="int" required="true">row index</param>
            <param name="PIXELS" type="list" required="true">row pixel values</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>command input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>...</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[S digits=12]                               [clear, text 1 7 TEST, get matrix(
|                                           |
[qrcode         ]                           [bitmap 21 21]
|              ^|                           |
[msg set list] [@cols #b(                   [msg set #a]
|              |
|              |   [invert( [clear(
|              |   |        |
[ui.lcd @size 120 120 @nosave 1 #x]






/* */
[X a->x]
#b $1, @rows $1, @size 120 120
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
