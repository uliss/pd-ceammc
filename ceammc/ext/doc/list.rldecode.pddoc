<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="list.rldecode">
        <title>list.rldecode</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">run-length decoding lists</tr>
                <tr lang="ru">декодирование повторов в списках</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list rle decode</keywords>
            <since>0.1</since>
            <also>
                <see>list.rlencode</see>
            </also>
            <aliases>
                <alias>list.unwrap</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="L" type="list">
                <tr lang="en">initial element repeat list</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @l -->
            <property name="@l" type="list" default="">
                <tr lang="en">list of repeats</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">First list - single elements</xinfo>
            </inlet>
            <inlet>
                <xinfo on="list">Second list - count of each element</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result - elements repeated n times specified by corresponding values in second
            list</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 1 3(    [1 2 3 4(
|            |.
[list.rldecode 4 3 2 1]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
