<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="seq.nbangs">
    <title>seq.nbangs</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">outputs the specified number of bangs with a time intervals</tr>
        <tr lang="ru">выводит заданное число bang-ов через интервалы времени</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>seq</category>
      <keywords>seq bang until</keywords>
      <since>0.9.1</since>
      <also>
        <see>seq.bangs</see>
        <see>seq.toggles</see>
      </also>
      <aliases>
        <alias>seq.nb</alias>
      </aliases>
    </meta>
    <arguments>
      <argument name="N" type="int" minvalue="0">
        <tr lang="en">number of bangs</tr>
        <tr lang="ru">количество bang-ов</tr>
      </argument>
      <argument name="T" type="float" minvalue="1" maxvalue="20000" units="millisecond">
        <tr lang="en">time interval between bangs</tr>
        <tr lang="ru">временно́й интервал между bang-ами</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @accel -->
      <property name="@accel" type="float" minvalue="0.25" default="1" maxvalue="4">
        <tr lang="en">tempo acceleration. 1 - no acceleration, &gt;1 - speed up, &lt;1 - slow
        down</tr>
        <tr lang="ru">ускорение темпа. 1 - без ускорения, &gt;1 - ускорение, &lt;1 -
        замедление</tr>
      </property>
      <!-- @curve -->
      <property name="@curve" type="float" minvalue="-8" default="1" maxvalue="8">
        <tr lang="en">acceleration curve. Values &gt;&gt;0 - slow changes, then fast encrease.
        Values &lt;0 - fast changes, then slower</tr>
        <tr lang="ru">кривая ускорения. Значения &gt;0 - сначла медленные изменения, затем быстрое
        увеличение. Значения &lt;0 - сначла быстро меняется, затем становится медленнее</tr>
      </property>
      <!-- @div -->
      <property name="@div" type="int" minvalue="1" default="1" maxvalue="64">
        <tr lang="en">subdivision of beats</tr>
        <tr lang="ru">деление долей</tr>
      </property>
      <!-- @dur -->
      <property name="@dur" type="float" minvalue="0" default="0">
        <tr lang="en">sequence duration. Changing this property also changes @t interval between
        bangs.</tr>
        <tr lang="ru">продолжительность последовательности. Изменение этого свойства также изменяет
        интервал @t между bang-ами.</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" minvalue="0" default="0">
        <tr lang="en">number of bangs</tr>
        <tr lang="ru">количество bang-ов</tr>
      </property>
      <!-- @t -->
      <property name="@t" type="float" default="0" minvalue="1" maxvalue="20000"
      units="millisecond">
        <tr lang="en">time interval between bangs. You could also use units values like 100ms or
        120bpm.</tr>
        <tr lang="ru">временно́й интервал между bang-ами. Вы также можете использовать значения
        единиц времени или темпа, такие как 100мс или 120bpm.</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets and stops the sequence</tr>
          <tr lang="ru">сбрасывает и останавливает последовательность</tr>
        </info>
      </method>
      <!-- rewind -->
      <method name="rewind">
        <info>
          <tr lang="en">reset all counters without stopping</tr>
          <tr lang="ru" finished="false">Сбросить все счетчики без остановки</tr>
        </info>
      </method>
      <!-- start -->
      <method name="start">
        <info>
          <tr lang="en">start or stop playing the sequence</tr>
          <tr lang="ru">начать или остановить воспроизведение последовательности</tr>
        </info>
        <param name="on" type="int" enum="0 1" default="1" required="false">
          <tr lang="en">if true: starts playback, if false: stops it</tr>
          <tr lang="ru">если true: начинает воспроизведение, если false: останавливает его</tr>
        </param>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stops playback of the sequence</tr>
          <tr lang="ru">останавливает воспроизведение последовательности</tr>
        </info>
      </method>
      <!-- tick -->
      <method name="tick">
        <info>
          <tr lang="en">manually output the current element of the sequence and proceed to the next
          one</tr>
          <tr lang="ru">вручную вывести текущей элемент последовательности и перейти к
          следующему</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">starts outputting the sequence of bangs from the beginning</tr>
          <tr lang="ru">начинает сначала воспроизведение последовательности bang-ов</tr>
        </in>
        <in on="float">
          <tr lang="en">sets the number of bangs in the sequence and starts playing it</tr>
          <tr lang="ru">устанавливает количество bang-ов в последователности и начинает её
          воспроизведение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set the number of bangs in the sequence</tr>
          <tr lang="ru">устанавливает количество bang-ов в последователности (без
          воспроизведения)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="bang">
          <tr lang="en">bang sequence output</tr>
          <tr lang="ru">вывод последовательности bang-ов</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">[i IDX N( - bang index or [done( when done</tr>
          <tr lang="ru" finished="false">[i IDX N( - индекс взрыва или [сделано (когда
          сделано)]</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[10( [15( [2(         [ui.dsp~]
|    |    |
|    |    | [@div 2(
|    |    | |
[seq.nbangs @t 110]
|            ^|
|            [route done i]
|            |     ^|
[click~]     [B]   [F]
|
[flt.resonbp~ 1000 40]
|
[ui.hgain~]
|\
[dac~]

[seq.nbangs-accel]
]]>
      </pdascii>
      <pdascii id="accel">
<![CDATA[
[17( [ui.k #a]   [ui.k #b]
|    |           |
|    |           |
|    |           |
|    [@accel $1( [@curve $1(
|    |           |
[seq.nbangs @t 200]
|
[click~]
|
[flt.resonbp~ 1000 40]
|
[ui.hgain~]
|\
[dac~]

#a 0.25 4 @show_value 1
#b -8 8 @show_value 1
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
