<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="seq.nbangs">
        <title>seq.nbangs</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs the specified number of bangs with a time intervals</tr>
                <tr lang="ru">выводит заданное число пустых сообщений через интервалы времени</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>seq</category>
            <keywords>seq bang until</keywords>
            <since>0.9.1</since>
            <also>
                <see>seq.bangs</see>
                <see>seq.toggles</see>
            </also>
            <aliases>
                <alias>seq.nb</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="0">
                <tr lang="en">number of bangs</tr>
            </argument>
            <argument name="T" type="float" minvalue="1" maxvalue="20000" units="millisecond">
                <tr lang="en">time interval between bangs</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @accel -->
            <property name="@accel" type="float" minvalue="0.25" default="1" maxvalue="4">
                <tr lang="en">tempo acceleration. 1 - no acceleration, &gt;1 - speed up, &lt;1 -
                slow down</tr>
            </property>
            <!-- @curve -->
            <property name="@curve" type="float" minvalue="-8" default="1" maxvalue="8">
                <tr lang="en">acceleration curve. Values &gt;&gt;0 - slow changes, then fast
                encrease. Values &lt;0 - fast changes, then slower</tr>
            </property>
            <!-- @div -->
            <property name="@div" type="int" minvalue="1" default="1" maxvalue="64">
                <tr lang="en">beat subdivision</tr>
            </property>
            <!-- @dur -->
            <property name="@dur" type="float" minvalue="0" default="0">
                <tr lang="en">sequence duration. Changing this property also changes @t interval
                between bangs.</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" minvalue="0" default="0">
                <tr lang="en">number of bangs</tr>
            </property>
            <!-- @t -->
            <property name="@t" type="float" default="0" minvalue="1" maxvalue="20000"
            units="millisecond">
                <tr lang="en">time interval between bangs. You could also use units values like
                100ms or 120bpm.</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">stop bang output and reset bang counter</tr>
                </info>
            </method>
            <!-- rewind -->
            <method name="rewind">
                <info>
                    <tr lang="en">reset all counters without stopping</tr>
                </info>
            </method>
            <!-- start -->
            <method name="start">
                <info>
                    <tr lang="en">start/stop</tr>
                </info>
                <param name="on" type="int" enum="0 1" default="1" required="false">
                    <tr lang="en">if true - starts bang sequence, otherwise stops</tr>
                </param>
            </method>
            <!-- stop -->
            <method name="stop">
                <info>
                    <tr lang="en">stop bang output</tr>
                </info>
            </method>
            <!-- tick -->
            <method name="tick">
                <info>
                    <tr lang="en">manually output current sequence element and move to next</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">reset counter and starts output</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">sets number of bangs and starts output</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">set number of bangs</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>bang output</outlet>
            <outlet>[i IDX N( - bang index or [done( when done</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[10( [15( [2(         [ui.dsp~]
|    |    |
|    |    | [@div 2(
|    |    | |
[seq.nbangs @t 110]
|            ^|
|            [route done i]
|            |     ^|
[click~]     [B]   [F]
|
[flt.resonbp~ 1000 40]
|
[ui.hgain~]
|\
[dac~]

[seq.nbangs-accel]
]]>
            </pdascii>
            <pdascii id="accel">
<![CDATA[
[17( [ui.k #a]   [ui.k #b]
|    |           |
|    |           |
|    |           |
|    [@accel $1( [@curve $1(
|    |           |
[seq.nbangs @t 200]
|
[click~]
|
[flt.resonbp~ 1000 40]
|
[ui.hgain~]
|\
[dac~]

#a 0.25 4 @show_value 1
#b -8 8 @show_value 1
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
