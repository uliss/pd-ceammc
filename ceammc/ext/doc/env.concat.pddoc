<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="env.concat">
        <title>env.concat</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">envelope concatenation</tr>
                <tr lang="ru">конкатенация огибающих</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>env</category>
            <keywords>concat</keywords>
            <since>0.5</since>
            <also>
                <see>env.tshift</see>
                <see>envelope</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">output concatenated result (previous)</tr>
                    <tr lang="ru" finished="false">Конкатенированный результат (предыдущий)</tr>
                </in>
                <in on="data">
                    <tr lang="en">set first envelope and output concatenated result</tr>
                    <!-- old: установить первую оболочку и вывести сцепленный
                    результат -->
                    <tr lang="ru" finished="false">установить первую оболочку и вывести сцепленный
                    результат</tr>
                </in>
            </inlet>
            <inlet>
                <in on="data">
                    <tr lang="en">set second envelope (no output)</tr>
                    <tr lang="ru" finished="false">установленная вторая оболочка (без вывода)</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">new combined envelope</tr>
                    <tr lang="ru" finished="false">Новый комбинированный конверт</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(
|
[envelope adsr 10 40 20 50]
|
|      [loadbang]
|      |
|      [envelope ear 60 -4 30 2]
|      |.
[env.concat]
|
[env->array concat_array @resize]


[array concat_array w=300 h=100 yr=0..1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
