<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="route.random">
    <title>route.random</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">routes the input message into the random outlet</tr>
        <tr lang="ru">направляет входное сообщение в случайный выход</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>route</keywords>
      <since>0.9.6</since>
      <aliases>
        <alias>route.r</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes each incoming message to one of N outlets, chosen at
        random</tr>
        <tr lang="ru">объект направляет каждое входящее сообщение на один из N выходов, выбранный
        случайным образом</tr>
      </par>
      <par>
        <tr lang="en">use the @seed property to get reproducible sequences. If @seed is not set
        explicitly, a generator initialized with the current time is used</tr>
        <tr lang="ru">используйте свойство @seed для получения воспроизводимых последовательностей.
        Если @seed не задан явно, используется генератор, инициализированный текущим временем</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to distribute events randomly over several
        destinations, for example to trigger different sounds or effects at random</tr>
        <tr lang="ru">объект можно использовать для случайного распределения событий по нескольким
        получателям, например чтобы случайно запускать разные звуки или эффекты</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="2" maxvalue="64">
        <tr lang="en">number of outlets. See the @n property</tr>
        <tr lang="ru">количество выходов. См. свойство @n</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @n -->
      <property name="@n" type="int" default="2" minvalue="2" maxvalue="64" access="initonly">
        <tr lang="en">number of outlets</tr>
        <tr lang="ru">количество выходов</tr>
      </property>
      <!-- @seed -->
      <property name="@seed" type="int" minvalue="0" default="0">
        <tr lang="en">generator seed</tr>
        <tr lang="ru">начальное значение генератора</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">bang to a random outlet</tr>
          <tr lang="ru">bang на случайный выход</tr>
        </in>
        <in on="float">
          <tr lang="en">float to a random outlet</tr>
          <tr lang="ru">число на случайный выход</tr>
        </in>
        <in on="symbol">
          <tr lang="en">symbol to a random outlet</tr>
          <tr lang="ru">символ на случайный выход</tr>
        </in>
        <in on="list">
          <tr lang="en">list to a random outlet</tr>
          <tr lang="ru">список на случайный выход</tr>
        </in>
        <in on="any">
          <tr lang="en">any message to a random outlet</tr>
          <tr lang="ru">сообщение any на случайный выход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="any">
          <tr lang="en">first outlet</tr>
          <tr lang="ru">первый выход</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="any">
          <tr lang="en">... outlet</tr>
          <tr lang="ru">... выход</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="any">
          <tr lang="en">n-th outlet</tr>
          <tr lang="ru">N-й выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]
|
|  [1 2 3(
|  |
|  |  [bang( [any message(
|  |  |      |
[route.random 4]
|  ^| ^^| ^^^|
|   |   |  [ui.dt]
|   |   |
|   |   [ui.dt]
|   |
|   [ui.dt]
|
[ui.dt]

[route.random-chord]
]]>
      </pdascii>
      <pdascii id="chord">
<![CDATA[
[ui.keyboard 24 48]
|
|
|
|
[stripnote]
|
[$1(      [ui.dsp~]
|
[mtof]
|
[route.random  3]
|      ^|     ^^|
[F]    [F]    [F]
|      |      |
[osc~] [osc~] [osc~]
|      |.     |..
[pan.spread~ 3  ]
*|*
[ui.hgain2~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
