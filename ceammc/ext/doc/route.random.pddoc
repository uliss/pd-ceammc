<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="route.random">
        <title>route.random</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">routes the input message into the random outlet</tr>
                <tr lang="ru">направляет входное сообщение в случайный выход</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>route</keywords>
            <since>0.9.6</since>
            <aliases>
                <alias>route.r</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="N" type="int" minvalue="2" maxvalue="64">
                <tr lang="en">number of outlets. See @n property</tr>
                <tr lang="ru" finished="false">количество торговых точек. См. @n Property</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @n -->
            <property name="@n" type="int" default="2" minvalue="2" maxvalue="64"
            access="initonly">
                <tr lang="en">number of outlets</tr>
                <tr lang="ru" finished="false">количество торговых точек</tr>
            </property>
            <!-- @seed -->
            <property name="@seed" type="int" minvalue="0" default="0">
                <tr lang="en">generator seed</tr>
                <tr lang="ru" finished="false">генератор</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">bang to random outlet</tr>
                    <tr lang="ru" finished="false">bang to random outlet скачать</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">float to random outlet</tr>
                    <tr lang="ru" finished="false">плавать в случайном выходе</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">symbol to random outlet</tr>
                    <tr lang="ru" finished="false">Символ для случайного выхода</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">list to random outlet</tr>
                    <tr lang="ru" finished="false">Список случайных выходов</tr>
                </xinfo>
                <xinfo on="any">
                    <tr lang="en">any to random outlet</tr>
                    <tr lang="ru" finished="false">Любой случайный выход</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="any">
                    <tr lang="en">first outlet</tr>
                    <tr lang="ru" finished="false">первый выход</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">... outlet</tr>
                    <tr lang="ru" finished="false">... выход</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">n-th outlet</tr>
                    <tr lang="ru" finished="false">n-й выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
|  [1 2 3(
|  |
|  |  [bang( [any message(
|  |  |      |
[route.random 4]
|  ^| ^^| ^^^|
|   |   |  [ui.dt]
|   |   |
|   |   [ui.dt]
|   |
|   [ui.dt]
|
[ui.dt]

[route.random-chord]
]]>
            </pdascii>
            <pdascii id="chord">
<![CDATA[
[ui.keyboard 24 48]
|
|
|
|
[stripnote]
|
[$1(      [ui.dsp~]
|
[mtof]
|
[route.random  3]
|      ^|     ^^|
[F]    [F]    [F]
|      |      |
[osc~] [osc~] [osc~]
|      |.     |..
[pan.spread~ 3  ]
*|*
[ui.hgain2~]
*|*
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
