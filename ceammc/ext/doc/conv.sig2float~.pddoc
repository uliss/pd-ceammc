<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.sig2float~">
    <title>conv.sig2float~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts audio signal to control numeric stream</tr>
        <tr lang="ru">преобразует аудиосигнал в управляющий числовой поток</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv signal float snapshot</keywords>
      <since>0.9.2</since>
      <aliases>
        <alias>ceammc/sig-&gt;float~</alias>
        <alias>sig-&gt;float~</alias>
        <alias>ceammc/s-&gt;f~</alias>
        <alias>s-&gt;f~</alias>
      </aliases>
      <also>
        <see>snapshot~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes an audio signal on its audio inlet and outputs its current
        value as a float through the control outlet. Sampling can happen in two ways: periodically,
        at the interval set by the INTERVAL argument or @interval property (in milliseconds), or
        immediately on a bang sent to the inlet. The @offset property selects which sample inside
        the current DSP block is sampled.</tr>
        <tr lang="ru">Объект принимает аудиосигнал на звуковой вход и выводит его текущее значение
        в виде числа через управляющий выход. Выборка может происходить двумя способами:
        периодически, с интервалом, заданным аргументом INTERVAL или свойством @interval (в
        миллисекундах), либо немедленно по bang на входе. Свойство @offset выбирает, какой именно
        семпл внутри текущего блока DSP берётся для выборки.</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">sample immediately</event>
    </mouse>
    <arguments>
      <argument name="INTERVAL" type="float" minvalue="-1" units="millisecond">
        <tr lang="en">sampling interval</tr>
        <tr lang="ru">интервал выборки</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @interval -->
      <property name="@interval" type="float" minvalue="-1" default="50" units="millisecond">
        <tr lang="en">sampling interval</tr>
        <tr lang="ru">интервал выборки</tr>
      </property>
      <!-- @offset -->
      <property name="@offset" type="int" default="0" minvalue="0" maxvalue="8192" units="sample">
        <tr lang="en">sample offset inside the DSP block</tr>
        <tr lang="ru">смещение семпла внутри блока DSP</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
        <in on="bang">
          <tr lang="en">sample immediately</tr>
          <tr lang="ru">выполнить выборку немедленно</tr>
        </in>
      </inlet>
      <inlet type="control">
        <in on="float">
          <tr lang="en">set sampling interval</tr>
          <tr lang="ru">задать интервал выборки</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">float: sample</tr>
          <tr lang="ru">число: значение выборки</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[phasor~ 0.5] [bang(
|             |
[sig->float~ 500]
|
[F]           [ui.dsp~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
