<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.gamma">
        <title>math.gamma</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">gamma function</tr>
                <tr lang="ru">гамма-функция</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math gamma factorial</keywords>
            <also>
                <see>math.gamma</see>
                <see>math.lgamma~</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Extension of factorial function to real numbers</tr>
            </par>
            <par>
                <tr lang="en">For any positive integer n, Γ(n) = (n−1)!</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input value</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">apply to all numeric values</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result value or list</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(                   [array GAMMA size=161 w=300 h=150 yr=-40..40]
|
[list.seq -4 4 0.05]
|
[list.each #a] [math.gamma #b]
|              |
|              [clip -50 50 #c]
|
|
[list.sep @enumerate 1]
|
[swap]
|   ^|.
[tabwrite GAMMA]
[X a:1->b] [X c->a:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
