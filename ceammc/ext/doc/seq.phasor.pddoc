<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="seq.phasor">
        <title>seq.phasor</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">control rate phasor generator</tr>
                <tr lang="ru">генератор фазора (пилы) для контрольных сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>seq</category>
            <keywords>seq lfo phasor saw</keywords>
            <since>0.9.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Outputs saw signal in [0..1] or [0..1) range.</tr>
            </par>
            <par>
                <tr lang="en">Note: control rate in PureData depends on block size and samplerate.
                Do not rely on strict timing for this object, especially at high frequencies!</tr>
            </par>
        </info>
        <arguments>
            <argument name="FREQ" type="float" minvalue="0" maxvalue="100" units="hertz">
                <tr lang="en">frequency</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="0" default="0" maxvalue="100"
            units="hertz">
                <tr lang="en">frequency</tr>
            </property>
            <!-- @invert -->
            <property name="@invert" type="bool" default="0">
                <tr lang="en">saw inversion mode. If true, outputs descreasing waveform</tr>
            </property>
            <!-- @on -->
            <property name="@on" type="bool" default="0">
                <tr lang="en">on/off state</tr>
            </property>
            <!-- @open -->
            <property name="@open" type="bool" default="0">
                <tr lang="en">output in open [0..1) range, otherwise output range is [0..1]</tr>
            </property>
            <!-- @steps -->
            <property name="@steps" type="int" default="128" minvalue="3">
                <tr lang="en">numbers of steps</tr>
            </property>
        </properties>
        <methods>
            <!-- phase -->
            <method name="phase">
                <info>
                    <tr lang="en">set current phase</tr>
                </info>
                <param name="VALUE" type="float">
                    <tr lang="en">new phase value</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset phase and stop</tr>
                </info>
            </method>
            <!-- rewind -->
            <method name="rewind">
                <info>
                    <tr lang="en">reset phase without stopping</tr>
                </info>
            </method>
            <!-- start -->
            <method name="start">
                <info>
                    <tr lang="en">start from current position</tr>
                </info>
            </method>
            <!-- stop -->
            <method name="stop">
                <info>
                    <tr lang="en">stop</tr>
                </info>
            </method>
            <!-- tick -->
            <method name="tick">
                <info>
                    <tr lang="en">output current value and move to next</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">1: starts output, 0: stop</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="any">
                    <tr lang="en">reset phase to 0</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>float value in 0..1 range</outlet>
            <outlet>bang after full cycle</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]       [ui.dsp~]    [ui.knob @min 0.2 @max 2]
|                      |
|                      |
[metro 250]            [@freq $1( [@invert !( [T]
|                      |          |           |
[click~]               [seq.phasor 0.2 @on 1  ]
|                      |
[flt.resonbp~ 1000 40] [l->l 0 1 -1 1 #a]
|                      |
[pan.cos~ {w=20} #b]   [ui.knob @min -1 @max 1]
*|*
[ui.hgain2~ @size 16 143]
*|*
[dac~]
[X a->b:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
