<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="seq.phasor">
    <title>seq.phasor</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">control rate phasor generator</tr>
        <tr lang="ru">генератор фазора (пилы) для контрольных сигналов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>seq</category>
      <keywords>seq lfo phasor saw</keywords>
      <since>0.9.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Outputs a sawtooth control signal in the [0..1] or [0..1) range.</tr>
        <tr lang="ru">Выводит пилообразный управляющий сигнал в [0..1] или [0..1) диапазоне.</tr>
      </par>
      <par>
        <tr lang="en">Note: control rate in PureData depends on block size and samplerate. Do not
        rely on strict timing for this object, especially at high frequencies!</tr>
        <tr lang="ru">Примечание: частота обновления управляющего сигнала в PureData зависит от
        размера блока и частоты семплирования. Не полагайтесь на строгий тайминг для этого объекта,
        особенно на высоких частотах!</tr>
      </par>
    </info>
    <arguments>
      <argument name="FREQ" type="float" minvalue="0" maxvalue="100" units="hertz">
        <tr lang="en">frequency</tr>
        <tr lang="ru">частота</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @freq -->
      <property name="@freq" type="float" minvalue="0" default="0" maxvalue="100" units="hertz">
        <tr lang="en">frequency</tr>
        <tr lang="ru">частота</tr>
      </property>
      <!-- @invert -->
      <property name="@invert" type="bool" default="0">
        <tr lang="en">inversion sawtooth mode. If true: outputs descreasing waveform</tr>
        <tr lang="ru">режим инверсии пилообразного сигнала. Если true: выводит убывающую форму
        волны</tr>
      </property>
      <!-- @on -->
      <property name="@on" type="bool" default="0">
        <tr lang="en">turning the signal output on/off</tr>
        <tr lang="ru">включение/выключение вывода сигнала</tr>
      </property>
      <!-- @open -->
      <property name="@open" type="bool" default="0">
        <tr lang="en">output signal values in open [0..1) range, otherwise the output range is
        [0..1] (by default)</tr>
        <tr lang="ru">выходить значения сигнала в полуоткрытом диапазоне [0..1), в противном случае
        выходной диапазон составляет [0..1] (по умолчанию)</tr>
      </property>
      <!-- @steps -->
      <property name="@steps" type="int" default="128" minvalue="3">
        <tr lang="en">numbers of steps</tr>
        <tr lang="ru">количество шагов</tr>
      </property>
    </properties>
    <methods>
      <!-- phase -->
      <method name="phase">
        <info>
          <tr lang="en">set the current phase</tr>
          <tr lang="ru">установить текущую фазу</tr>
        </info>
        <param name="VALUE" type="float">
          <tr lang="en">new phase value</tr>
          <tr lang="ru" finished="false">Новая фазовая стоимость</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset the phase and stop the output</tr>
          <tr lang="ru">сбросить фазу и остановить вывод</tr>
        </info>
      </method>
      <!-- rewind -->
      <method name="rewind">
        <info>
          <tr lang="en">reset the phase without stopping the output</tr>
          <tr lang="ru">сброс фазы без остановки вывода</tr>
        </info>
      </method>
      <!-- start -->
      <method name="start">
        <info>
          <tr lang="en">start from current position</tr>
          <tr lang="ru" finished="false">Начните с текущей позиции</tr>
        </info>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stop the output</tr>
          <tr lang="ru">остановить вывод</tr>
        </info>
      </method>
      <!-- tick -->
      <method name="tick">
        <info>
          <tr lang="en">output the current value and move to the next</tr>
          <tr lang="ru">вывести текущее значение и перейти к следующему</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">1: starts output, 0: stop</tr>
          <tr lang="ru">1: начало вывода, 0: остановка</tr>
        </in>
      </inlet>
      <inlet>
        <in on="any">
          <tr lang="en">reset the phase to 0</tr>
          <tr lang="ru">сбросить фазу на 0</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">float value in 0..1 range</tr>
          <tr lang="ru">числовое значение в диапазоне 0..1</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">bang: after completing a full cycle</tr>
          <tr lang="ru">bang: после завершения полного цикла</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]       [ui.dsp~]    [ui.knob @min 0.2 @max 2]
|                      |
|                      |
[metro 250]            [@freq $1( [@invert !( [T]
|                      |          |           |
[click~]               [seq.phasor 0.2 @on 1  ]
|                      |
[flt.resonbp~ 1000 40] [l->l 0 1 -1 1 #a]
|                      |
[pan.cos~ {w=20} #b]   [ui.knob @min -1 @max 1]
*|*
[ui.hgain2~ @size 16 143]
*|*
[dac~]
[X a->b:1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
