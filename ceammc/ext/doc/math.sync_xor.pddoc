<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.sync_xor">
        <title>math.sync_xor</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sync logical XOR operation</tr>
                <tr lang="ru">логическая операция исключающее ИЛИ</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math sync logical xor</keywords>
            <aliases>
                <alias>math.^'</alias>
                <alias>ceammc/^'</alias>
                <alias>^'</alias>
            </aliases>
            <since>0.8</since>
            <also>
                <see>math.||'</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Only 1 and 0 values are accepted. Any other number treat as 1, but
                print error to console.</tr>
            </par>
        </info>
        <arguments>
            <argument name="V" type="int" enum="0 1">
                <tr lang="en">second value</tr>
            </argument>
        </arguments>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">set first value, calculate and output result</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">pair: set first and second values, calculate and output
                    result</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">change second value, calculate and output result</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output 1 or 0, according logical XOR operation</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[_]   [_]   /*0 0 | 0*/
|     |
|     |     /*0 1 | 1*/
|     |.
[^'    ]    /*1 0 | 1*/
|
[_]         /*1 1 | 0*/
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
