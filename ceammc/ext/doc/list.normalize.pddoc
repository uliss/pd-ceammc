<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.normalize">
        <title>list.normalize</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">normalizes numeric list values to get their sum equal to 1.0</tr>
                <tr lang="ru">нормализует числовые значения списка, чтобы их сумма была равна
                единице</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list normalize</keywords>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">There are two modes of normalization:</tr>
                <tr lang="ru" finished="false">Существует два способа нормализации:</tr>
            </par>
            <par>
                <tr lang="en">1. by sum - multiply all elements to such number to get total sum =
                1.0</tr>
                <!-- old: 1. по сумме - умножьте все элементы на такое число,
                чтобы получить общую сумму = 1,0 -->
                <tr lang="ru" finished="false">1. по сумме - умножьте все элементы на такое число,
                чтобы получить общую сумму = 1,0</tr>
            </par>
            <par>
                <tr lang="en">2. by value range - maps all values to range 0..1 lineary</tr>
                <!-- old: 2. по диапазону значений - отображает все значения в
                диапазоне 0,1 -->
                <tr lang="ru" finished="false">2. по диапазону значений - отображает все значения в
                диапазоне 0,1</tr>
            </par>
        </info>
        <properties>
            <!-- @by -->
            <property name="@by" type="symbol" enum="sum range" default="sum">
                <tr lang="en">normalization mode</tr>
                <tr lang="ru" finished="false">режим нормализации</tr>
            </property>
            <!-- @range -->
            <property name="@range" type="alias">
                <tr lang="en">alias to @by range</tr>
                <tr lang="ru" finished="false">Исполнитель: @by Range</tr>
            </property>
            <!-- @sum -->
            <property name="@sum" type="alias">
                <tr lang="en">alias to @by sum</tr>
                <tr lang="ru" finished="false">псевдоним @by sum</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">input list of floats. Non float values are rejected</tr>
                    <!-- old: Список входных поплавков. Неподвижные значения
                    отклонены -->
                    <tr lang="ru" finished="false">Список входных поплавков. Неподвижные значения
                    отклонены</tr>
                </in>
                <in on="data:mlist">
                    <tr lang="en">same as list</tr>
                    <tr lang="ru" finished="false">Тот же список</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output list</tr>
                    <tr lang="ru" finished="false">перечень мероприятий</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 4(
|
|  [1 2 a b c d( [@range( [@sum(
|  |             |        |
|  |             |        |
|  |             |        |
[list.normalize       @sum]
| |
| [ui.dt]
|
|
[list.sum]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
