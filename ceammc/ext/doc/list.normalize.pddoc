<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="list.normalize">
        <title>list.normalize</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">normalizes numeric list values to get their sum equal to 1.0</tr>
                <tr lang="ru">нормализует числовые значения списка, чтобы их сумма была равна
                единице</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list normalize</keywords>
            <since>0.1</since>
        </meta>
        <info>
            <par>There are two modes of normalization:</par>
            <par>1. by sum - multiply all elements to such number to get total sum = 1.0</par>
            <par>2. by value range - maps all values to range 0..1 lineary</par>
        </info>
        <properties>
            <!-- @by -->
            <property name="@by" type="symbol" enum="sum range" default="sum">
                <tr lang="en">normalization mode</tr>
            </property>
            <!-- @range -->
            <property name="@range" type="alias">
                <tr lang="en">alias to @by range</tr>
            </property>
            <!-- @sum -->
            <property name="@sum" type="alias">
                <tr lang="en">alias to @by sum</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">input list of floats. Non float values are rejected</xinfo>
                <xinfo on="data:mlist">same as list</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output list</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 4(
|
|  [1 2 a b c d( [@range( [@sum(
|  |             |        |
|  |             |        |
|  |             |        |
[list.normalize       @sum]
| |
| [ui.dt]
|
|
[list.sum]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
