<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="symbol2intlist">
        <title>symbol2intlist</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">converts the symbol into a list of character codes</tr>
                <tr lang="ru">преобразует символьный тип в список кодов составляющих его
                символов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>symbol</category>
            <keywords>symbol compare</keywords>
            <since>0.9.1</since>
            <aliases>
                <alias>ceammc/symbol2intlist</alias>
                <alias>ceammc/sym-&gt;ilist</alias>
                <alias>sym-&gt;ilist</alias>
            </aliases>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">first symbol</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">list of codes</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[A( [ABC( [АБВГД(
|   |     |
[symbol   ]
|
[symbol2intlist]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
