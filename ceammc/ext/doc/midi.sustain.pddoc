<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="midi.sustain">
    <title>midi.sustain</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">sustain pedal emulation</tr>
        <tr lang="ru">эмуляция педали сустейна</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>midi</category>
      <keywords>midi sustain</keywords>
      <since>0.9.3</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object stores the currently held notes and releases them when the pedal
        is turned off</tr>
        <tr lang="ru">объект запоминает удерживаемые ноты и отпускает их при выключении педали</tr>
      </par>
      <par>
        <tr lang="en">if @ctlin is enabled, the pedal state is controlled by MIDI CC64 (sustain
        pedal) from the controller</tr>
        <tr lang="ru">если включён @ctlin, состояние педали управляется MIDI CC64 (педаль сустейна)
        от контроллера</tr>
      </par>
      <par>
        <tr lang="en">the second inlet turns the pedal on/off manually: 1 — on, 0 — off</tr>
        <tr lang="ru">второй вход включает/выключает педаль вручную: 1 — вкл, 0 — выкл</tr>
      </par>
      <par>
        <tr lang="en">note off messages are passed through when the pedal is off, and suppressed
        when the pedal is on</tr>
        <tr lang="ru">сообщения note off проходят на выход, когда педаль выключена, и подавляются,
        когда педаль включена</tr>
      </par>
    </info>
    <arguments>
      <argument name="ON" type="bool">
        <tr lang="en">initial state</tr>
        <tr lang="ru">начальное состояние</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @ctlin -->
      <property name="@ctlin" type="bool" default="0">
        <tr lang="en">listen to CC64 from MIDI controller</tr>
        <tr lang="ru">слушать CC64 от MIDI-контроллера</tr>
      </property>
      <!-- @on -->
      <property name="@on" type="bool" default="0">
        <tr lang="en">pedal state</tr>
        <tr lang="ru">состояние педали</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">MIDI input: NOTE VEL</tr>
          <tr lang="ru">вход MIDI: НОТА СИЛА_НАЖАТИЯ</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">turn sustain on/off (1/0)</tr>
          <tr lang="ru">включить/выключить сустейн (1/0)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">MIDI output: NOTE VEL</tr>
          <tr lang="ru">выход MIDI: НОТА СИЛА_НАЖАТИЯ</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.hk 24]
|
|
|
|
|         [T]
|         |.
[midi.sustain]
|
[ui.hk 24]
|       |
|       |
|       |
|       |
[print] [ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
