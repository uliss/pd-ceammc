<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="hoa.3d.optim~">
        <title>hoa.3d.optim~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
                <author>Pierre Guillot</author>
                <author>Eliott Paris</author>
                <author>Thomas Le Meur</author>
            </authors>
            <description>
                <tr lang="en">a 3D ambisonic optimization tool</tr>
                <tr lang="ru">оптимизация трехмерных амбисоников высоких порядков</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>hoa optim 3d</keywords>
            <since>0.9.7</since>
            <also>
                <see>hoa.3d.decoder~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Weights the circular harmonics signals depending on the ambisonic
                optimization. It can be "basic" for no optimization, "maxre" or "inphase".</tr>
                <tr lang="ru" finished="false">Вес круговых гармонических сигналов зависит от
                амбисонической оптимизации. Он может быть «базовым» без оптимизации, «максимальным»
                или «инфазным».</tr>
            </par>
            <par>
                <tr lang="en">If no optimization mode is specified, the default mode will be
                inphase.</tr>
                <tr lang="ru" finished="false">Если режим оптимизации не указан, режим по умолчанию
                будет в фазе.</tr>
            </par>
            <par>
                <tr lang="en">Maxre optimization is used when audience is confined to the center of
                the circle.</tr>
                <tr lang="ru" finished="false">Оптимизация Максра используется, когда аудитория
                ограничена центром круга.</tr>
            </par>
            <par>
                <tr lang="en">Inphase optimization is used when the audience covers all the
                circle.</tr>
                <tr lang="ru" finished="false">Инфазная оптимизация используется, когда аудитория
                охватывает весь круг.</tr>
            </par>
            <par>
                <tr lang="en">NB: This is theoretical, the best choice is to trust your ears.</tr>
                <tr lang="ru" finished="false">NB: Это теоретически, лучший выбор - доверять своим
                ушам.</tr>
            </par>
            <a href="hoa/hoa.3d.optim~-help.pd">CICM documentation</a>
        </info>
        <arguments>
            <argument name="ORDER" type="int" minvalue="1" maxvalue="10">
                <tr lang="en">the order of decomposition</tr>
                <tr lang="ru" finished="false">Порядок разложения</tr>
            </argument>
            <argument name="MODE" type="symbol" enum="basic maxre inphase">
                <tr lang="en">optimization mode</tr>
                <tr lang="ru" finished="false">режим оптимизации</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @basic -->
            <property name="@basic" type="alias">
                <tr lang="en">alias for @mode basic (no optimization)</tr>
                <tr lang="ru" finished="false">alias for @mode basic (без оптимизации)</tr>
            </property>
            <!-- @inphase -->
            <property name="@inphase" type="alias">
                <tr lang="en">alias for @mode inphase.</tr>
                <tr lang="ru" finished="false">Оригинальное название: @mode inphase</tr>
            </property>
            <!-- @maxre -->
            <property name="@maxre" type="alias">
                <tr lang="en">alias for @mode maxre.</tr>
                <tr lang="ru" finished="false">Оригинальное название: @mode maxre</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" enum="basic maxre inphase" default="basic">
                <tr lang="en">optimization mode</tr>
                <tr lang="ru" finished="false">режим оптимизации</tr>
            </property>
            <!-- @order -->
            <property name="@order" type="int" minvalue="1" maxvalue="10" default="1"
            access="initonly">
                <tr lang="en">the order of decomposition</tr>
                <tr lang="ru" finished="false">Порядок разложения</tr>
            </property>
        </properties>
        <inlets dynamic="true">
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">first input harmonic</tr>
                    <tr lang="ru" finished="false">Первый вход гармоничный</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>
                    <tr lang="en">... input harmonic</tr>
                    <tr lang="ru" finished="false">Входная гармоника</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="n">
                <xinfo>
                    <tr lang="en">n-th input harmonic</tr>
                    <tr lang="ru" finished="false">n-я входная гармоника</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">first harmonic output</tr>
                </out>
            </outlet>
            <outlet type="audio" number="...">
                <out type="any">
                    <tr lang="en">... harmonic output</tr>
                </out>
            </outlet>
            <outlet type="audio" number="n">
                <out type="any">
                    <tr lang="en">n-th harmonic output</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[hoa/hoa.soundrone]     [phasor~ 0.15]
|                       |
[ui.gain~ @size 120 14] [phase->rad~] [ui.menu basic maxre inphase]
|                       |.            |
[hoa.3d.encoder~ 3 {w=30,i=16,o=16}]  [@mode $2(
*|*                                   |
[hoa.3d.optim~ 3 inphase {w=30,i=16,o=16}]
*|* *|*
*|* [hoa.3d.scope~ 3 @gain 4 {i=16} @size 164 164]
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
[hoa.3d.decoder~ 3 regular 16 {w=30,i=16,o=16}]
*|*
[xdac~ 1:16 {w=30,i=16}]

[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
