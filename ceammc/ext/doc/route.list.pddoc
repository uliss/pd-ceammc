<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="route.list">
    <title>route.list</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">separates list messages from other types</tr>
        <tr lang="ru">отделяет списки от сообщений других типов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>route list</keywords>
      <since>0.9.6</since>
      <aliases>
        <alias>route.l</alias>
      </aliases>
      <also>
        <see>route.float</see>
        <see>route.random</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes list messages to the first outlet and all other messages
        (bang, float, symbol, any) to the second outlet</tr>
        <tr lang="ru">объект направляет списки на первый выход, а все остальные сообщения (bang,
        числа, символы, any) — на второй выход</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="any">
          <tr lang="en">any message to the second outlet</tr>
          <tr lang="ru">сообщение any на второй выход</tr>
        </in>
        <in on="bang">
          <tr lang="en">bang to the second outlet</tr>
          <tr lang="ru">bang на второй выход</tr>
        </in>
        <in on="float">
          <tr lang="en">float to the second outlet</tr>
          <tr lang="ru">число на второй выход</tr>
        </in>
        <in on="list">
          <tr lang="en">list to the first outlet</tr>
          <tr lang="ru">список на первый выход</tr>
        </in>
        <in on="symbol">
          <tr lang="en">symbol to the second outlet</tr>
          <tr lang="ru">символ на второй выход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">list output</tr>
          <tr lang="ru">выход списков</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">other messages</tr>
          <tr lang="ru">другие сообщения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]  [bang( [symbol ABC #a(
|    |
|    |   [list 1 2 3(
|    |   |
|    |   |  [list(
|    |   |  |
|    |   |  | [@any( [other(
|    |   |  | |      |
[route.list        #z]
|       ^|
[ui.dt]  |
         |
         [ui.dt]

[X a->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
