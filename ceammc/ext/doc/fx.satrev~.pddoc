<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="fx.satrev~">
        <title>fx.satrev~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Schroeder reverberator from 1971</tr>
                <tr lang="ru">ревербератор Шрёдера 1971 года</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx room reverb schroeder</keywords>
            <since>0.9.6</since>
        </meta>
        <arguments>
            <argument name="DRYWET" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">drywet mix</tr>
                <tr lang="ru" finished="false">сухая смесь</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
                <!-- old: Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал. -->
                <tr lang="ru" finished="false">Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал.</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.25">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet</tr>
                <!-- old: пропорция смеси между исходными (сухими) и
                "влажными" сигналами. 0 - сухой сигнал, 1 - влажный -->
                <tr lang="ru" finished="false">пропорция смеси между исходными (сухими) и
                "влажными" сигналами. 0 - сухой сигнал, 1 - влажный</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                    <tr lang="ru" finished="false">Перезагрузка в начальное состояние</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
            <inlet>
                <in on="float">
                    <tr lang="en">set drywet</tr>
                    <tr lang="ru" finished="false">установленный сухой</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">left output signal</tr>
                    <tr lang="ru" finished="false">левый выходной сигнал</tr>
                </out>
            </outlet>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">right output signal</tr>
                    <tr lang="ru" finished="false">правильный выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 250]
|
[random.a 68 26 84]
|
[makenote 127 200] [ui.k]
*|*                |
[pack f f]         |             [T]
|                  |             |
[synth.dubdub~]    [@drywet $1(  [@bypass $1(
|                  |             |
[fx.satrev~                      ]
*|*
[ui.hgain2~]       [ui.dsp~]
*|*
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
