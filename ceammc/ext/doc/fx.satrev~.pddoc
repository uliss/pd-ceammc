<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fx.satrev~">
    <title>fx.satrev~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Schroeder reverberator from 1971</tr>
        <tr lang="ru">ревербератор Шрёдера 1971 года</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>fx</category>
      <keywords>fx room reverb schroeder</keywords>
      <since>0.9.6</since>
    </meta>
    <info>
      <par>
        <tr lang="en">a classic algorithmic reverberator based on the architecture proposed by Manfred Schroeder, built from parallel feedback comb filters followed by series allpass filters</tr>
        <tr lang="ru">классический алгоритмический ревербератор на основе архитектуры, предложенной Манфредом Шрёдером, состоящий из параллельных гребёнчатых фильтров с обратной связью и последовательных аллпасс-фильтров</tr>
      </par>
      <par>
        <tr lang="en">the parallel comb filters create the initial echo density, while the series allpass filters increase the density without adding coloration</tr>
        <tr lang="ru">параллельные гребёнчатые фильтры создают начальную плотность эха, а последовательные аллпасс-фильтры увеличивают её, не добавляя окраски</tr>
      </par>
      <par>
        <tr lang="en">this architecture became the foundation of many later reverberation algorithms, including the well-known Freeverb</tr>
        <tr lang="ru">эта архитектура стала основой многих последующих алгоритмов реверберации, включая известный Freeverb</tr>
      </par>
    </info>
    <arguments>
      <argument name="DRYWET" type="float" minvalue="0" maxvalue="1">
        <tr lang="en">dry/wet mix</tr>
        <tr lang="ru">баланс сухого/влажного сигнала</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypass the processed signal</tr>
        <tr lang="ru">флаг обхода. Если true: пропускать обработанный сигнал без изменений</tr>
      </property>
      <!-- @drywet -->
      <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.25">
        <tr lang="en">proportion of mix between the original (dry) and processed (wet) signals. 0 — dry signal, 1 — wet</tr>
        <tr lang="ru">пропорция смеси между исходным (сухим) и обработанным (влажным) сигналами. 0 — сухой сигнал, 1 — влажный</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset to initial state</tr>
          <tr lang="ru">сбросить в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set dry/wet mix</tr>
          <tr lang="ru">задать баланс сухого/влажного сигнала</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">left output signal</tr>
          <tr lang="ru">левый выходной сигнал</tr>
        </out>
      </outlet>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">right output signal</tr>
          <tr lang="ru">правый выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[metro 250]
|
[random.a 68 26 84]
|
[makenote 127 200] [ui.k]
*|*                |
[pack f f]         |             [T]
|                  |             |
[synth.dubdub~]    [@drywet $1(  [@bypass $1(
|                  |             |
[fx.satrev~                      ]
*|*
[ui.hgain2~]       [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
