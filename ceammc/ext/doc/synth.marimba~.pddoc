<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="synth.marimba~">
        <title>synth.marimba~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">simple marimba physical model implementing a single tone bar
                connected to tube</tr>
                <tr lang="ru">простая физическая модель маримбы, реализующая звуковой брусок,
                соединенный с трубой</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>synth</category>
            <keywords>marimba</keywords>
            <since>0.6</since>
        </meta>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @cutoff -->
            <property name="@cutoff" type="float" minvalue="1000" maxvalue="10000" default="7000">
                <tr lang="en">cuttoff frequency of the strike generator</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" units="hertz" default="130.8128">
                <tr lang="en">frequency</tr>
            </property>
            <!-- @gain -->
            <property name="@gain" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">strike gain</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="float" minvalue="0" maxvalue="1" default="0">
                <tr lang="en">play trigger - 1: on, 0: off</tr>
            </property>
            <!-- @pitch -->
            <property name="@pitch" type="float" minvalue="36" maxvalue="84" default="48">
                <tr lang="en">midi pitch</tr>
            </property>
            <!-- @pos -->
            <property name="@pos" type="float" minvalue="0" maxvalue="4" default="0">
                <tr lang="en">excitation position</tr>
            </property>
            <!-- @sharp -->
            <property name="@sharp" type="float" minvalue="0.01" maxvalue="1" default="0.25">
                <tr lang="en">sharpness of the strike</tr>
            </property>
        </properties>
        <methods>
            <!-- note -->
            <method name="note">
                <info>
                    <tr lang="en">note on/off message</tr>
                </info>
                <param name="NOTE" type="float" required="true">
                    <tr lang="en">midi note</tr>
                </param>
                <param name="VEL" type="float" minvalue="0" maxvalue="127" required="true">
                    <tr lang="en">velocity</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en" />
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]                  [ui.dsp~]
|
[metro 130]
|
[0 12 0 36 7 12(
|
[list.choice]        [ui.knob @min 0 @max 4] [ui.knob]
|                    |                       |
[+ 36]               |                       |
|                    |                       |
[makenote 127 100]   [@pos $1 #b(            [@sharp $1 #c(
*|*
[pack f f]
|
[msg note]
|
[synth.marimba~ #a]
|
[fx.freeverb~ @room 0.95 @drywet 0.015]
|
[ui.gain~ @size 120 16]
|\
[dac~]
[X b->a] [X c->a]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
