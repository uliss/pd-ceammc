<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.shuffle">
        <title>list.shuffle</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">rearranges the elements of the list in a random order</tr>
                <tr lang="ru">переставляет элементы списка в случайном порядке</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list shuffle random</keywords>
            <since>0.1</since>
            <also>
                <see>list.sort</see>
                <see>list.reverse</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>new shuffled list</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 a b c( [\(1 2 3 4 5 6 7 8 9\), bang(
|             |
|             [ml]
|             |
[list.shuffle ]
|
[ui.display @display_type 1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
