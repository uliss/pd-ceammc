<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.space">
    <title>flow.space</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">spaces in time messages received at the same logical time</tr>
        <tr lang="ru">распределяет во времени сообщения, полученные одновременно</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>space</keywords>
      <since>0.9.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object delays each incoming message by an increasing amount of time, so
        that messages received at the same logical time are spread out over time</tr>
        <tr lang="ru">объект задерживает каждое входящее сообщение на всё большее время, так что
        сообщения, полученные одновременно, распределяются во времени</tr>
      </par>
      <par>
        <tr lang="en">@delay sets the interval between consecutive messages, @dev adds random
        deviation to the interval</tr>
        <tr lang="ru">@delay задаёт интервал между последовательными сообщениями, @dev добавляет
        случайное отклонение к интервалу</tr>
      </par>
      <par>
        <tr lang="en">@done sets the time space after the last message, after which a bang is sent
        to the second outlet</tr>
        <tr lang="ru">@done задаёт задержку после последнего сообщения, по истечении которой на
        второй выход отправляется bang</tr>
      </par>
    </info>
    <arguments>
      <argument name="DELAY" type="float" units="millisecond" minvalue="1">
        <tr lang="en">time space between messages</tr>
        <tr lang="ru">интервал между сообщениями</tr>
      </argument>
      <argument name="DONE" type="int" minvalue="0">
        <tr lang="en">time space = N*space after the last outputted message</tr>
        <tr lang="ru">интервал = N*delay после последнего выведенного сообщения</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @delay -->
      <property name="@delay" type="float" default="1" minvalue="1" units="millisecond">
        <tr lang="en">time space between messages</tr>
        <tr lang="ru">интервал между сообщениями</tr>
      </property>
      <!-- @dev -->
      <property name="@dev" type="float" default="0" minvalue="0" maxvalue="1">
        <tr lang="en">random deviation</tr>
        <tr lang="ru">случайное отклонение</tr>
      </property>
      <!-- @done -->
      <property name="@done" type="int" default="1" minvalue="0">
        <tr lang="en">time space (=@done*@delay) after the last outputted message. After that delay
        a bang is output to the second outlet</tr>
        <tr lang="ru">интервал (=@done*@delay) после последнего выведенного сообщения. По истечении
        этой задержки на второй выход выводится bang</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">messages</tr>
          <tr lang="ru">сообщения</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set space interval (ms)</tr>
          <tr lang="ru">задать интервал (мс)</tr>
        </in>
        <in>
          <tr lang="en">reset: cancel all scheduled outputs and clear the message queue</tr>
          <tr lang="ru">reset: отменить все запланированные выводы и очистить очередь
          сообщений</tr>
        </in>
        <in>
          <tr lang="en">@delay: set @delay property</tr>
          <tr lang="ru">@delay: задать свойство @delay</tr>
        </in>
        <in>
          <tr lang="en">@done: set @done property</tr>
          <tr lang="ru">@done: задать свойство @done</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output</tr>
          <tr lang="ru">выход</tr>
        </out>
      </outlet>
      <outlet>
        <out type="bang">
          <tr lang="en">on finish (after @delay*@done ms after the last outputted message)</tr>
          <tr lang="ru">по завершении (через @delay*@done мс после последнего выведенного
          сообщения)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[1, 2, 3, 4, 5(
|
[flow.space 250]
|
[ui.dt]


[7, 2, 1, 2, 0, 2, 1, 2 #a( [reset(
|                           |
|   [ui.hsl @show_value 1]  |
|   |                       |
|   [prop.set @dev]         |
|   |                       |.
[flow.space 110            #b]
|
[degree->key minor {i=1,o=1}]
|
[+ 60]
|
[mtof  ]
|      |
[osc~] [b]
|      |
[env.ar~ 10 90]
|
[ui.hgain~]    [ui.dsp~]
|\
[dac~]

[flow.space-done]

[X b:1->a]
]]>
      </pdascii>
      <pdascii id="done">
<![CDATA[
[3 #a(       [ui.hrd]
|            |
[until]      [prop.set @done]  [reset(
|            |                 |.
[flow.space 150 #b              ]
|
[click~]
|
[flt.resonbp~ 1000 32]
|
[ui.hgain~]
|\
[dac~]

[X b:1->a]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
