<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flow.space">
        <title>flow.space</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">spaces in time messages received at the same logical time</tr>
                <tr lang="ru">распределить во времени сообщения, полученные одновременно</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>space</keywords>
            <since>0.9.1</since>
        </meta>
        <arguments>
            <argument name="DELAY" type="float" units="millisecond" minvalue="1">
                <tr lang="en">time space between messages</tr>
                <tr lang="ru" finished="false">Пространство времени между сообщениями</tr>
            </argument>
            <argument name="DONE" type="int" minvalue="0">
                <tr lang="en">time space = N*space after last outputted message</tr>
                <!-- old: Пространство времени = N* Пространство после
                последнего выведенного сообщения -->
                <tr lang="ru" finished="false">Пространство времени = N* Пространство после
                последнего выведенного сообщения</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @delay -->
            <property name="@delay" type="float" default="1" minvalue="1" units="millisecond">
                <tr lang="en">time-space between messages</tr>
                <tr lang="ru" finished="false">Пространство времени между сообщениями</tr>
            </property>
            <!-- @dev -->
            <property name="@dev" type="float" default="0" minvalue="0" maxvalue="1">
                <tr lang="en">random deviation</tr>
                <tr lang="ru" finished="false">случайное отклонение</tr>
            </property>
            <!-- @done -->
            <property name="@done" type="int" default="1" minvalue="0">
                <tr lang="en">time space (=@done*@delay) after last outputted message. After that
                delay output bang to second outlet</tr>
                <!-- old: Пространство времени (=@done*@delay) после
                последнего отправленного сообщения. После этого отсрочка выхода Bang на вторую
                розетку -->
                <tr lang="ru" finished="false">Пространство времени (=@done*@delay) после
                последнего отправленного сообщения. После этого отсрочка выхода Bang на вторую
                розетку</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">messages</tr>
                    <tr lang="ru" finished="false">сообщения</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">set space interval (ms)</tr>
                    <tr lang="ru" finished="false">установленный интервал пространства (ms)</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">reset: cancel all scheduled outputs and clear message queue</tr>
                    <!-- old: Сброс: отменить все запланированные выходы и
                    четкую очередь сообщений -->
                    <tr lang="ru" finished="false">Сброс: отменить все запланированные выходы и
                    четкую очередь сообщений</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">@delay: set @delay property</tr>
                    <tr lang="ru" finished="false">@delay: set @delay property</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">@done: set @done property</tr>
                    <tr lang="ru" finished="false">Оригинальное название: Set @done Property</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output</tr>
                    <tr lang="ru" finished="false">выход</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">bang on finish (after @delay*@done ms after last outputted
                    message)</tr>
                    <tr lang="ru" finished="false">bang on finish (после @delay*@done ms после
                    последнего отправленного сообщения)</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1, 2, 3, 4, 5(
|
[flow.space 250]
|
[ui.dt]


[7, 2, 1, 2, 0, 2, 1, 2 #a( [reset(
|                           |
|   [ui.hsl @show_value 1]  |
|   |                       |
|   [prop.set @dev]         |
|   |                       |.
[flow.space 110            #b]
|
[degree->key minor {i=1,o=1}]
|
[+ 60]
|
[mtof  ]
|      |
[osc~] [b]
|      |
[env.ar~ 10 90]
|
[ui.hgain~]    [ui.dsp~]
|\
[dac~]

[flow.space-done]

[X b:1->a]
]]>
            </pdascii>
            <pdascii id="done">
<![CDATA[
[3 #a(       [ui.hrd]
|            |
[until]      [prop.set @done]  [reset(
|            |                 |.
[flow.space 150 #b              ]
|
[click~]
|
[flt.resonbp~ 1000 32]
|
[ui.hgain~]
|\
[dac~]

[X b:1->a]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
