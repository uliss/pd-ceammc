<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="ceammc.search">
        <title>ceammc.search</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">search in the [ceammc] library</tr>
                <tr lang="ru">поиск в библиотеке [ceammc]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>base</category>
            <keywords>search</keywords>
            <since>0.9.1</since>
        </meta>
        <properties>
            <!-- @max -->
            <property name="@max" type="int" minvalue="1" maxvalue="50" default="10">
                <tr lang="en">maximum number of result</tr>
            </property>
        </properties>
        <methods>
            <!-- k -->
            <method name="k">
                <info>
                    <tr lang="en">alias to keywords method</tr>
                </info>
            </method>
            <!-- keywords -->
            <method name="keywords">
                <info>
                    <tr lang="en">search in keywords</tr>
                </info>
            </method>
            <!-- o -->
            <method name="o">
                <info>
                    <tr lang="en">alias to objects method</tr>
                </info>
            </method>
            <!-- objects -->
            <method name="objects">
                <info>
                    <tr lang="en">search in objects names</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="control">
                <xinfo on="symbol">search in descriptions</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="control">list of matched object names</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[S digits=10] [S digits=10]
|             |
[k $1(        [o $1( [S digits=10]
|             |      |
[ceammc.search       ]
|
[ui.display]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
