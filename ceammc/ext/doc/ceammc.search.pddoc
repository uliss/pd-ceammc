<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ceammc.search">
    <title>ceammc.search</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">search in the [ceammc] library</tr>
        <tr lang="ru">поиск в библиотеке [ceammc]</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>search</keywords>
      <since>0.9.1</since>
    </meta>
    <properties>
      <!-- @max -->
      <property name="@max" type="int" minvalue="1" maxvalue="50" default="10">
        <tr lang="en">maximum number of result</tr>
        <tr lang="ru" finished="false">Максимальное количество результата</tr>
      </property>
    </properties>
    <methods>
      <!-- k -->
      <method name="k">
        <info>
          <tr lang="en">alias to keywords method</tr>
          <tr lang="ru" finished="false">псевдоним метода ключевых слов</tr>
        </info>
      </method>
      <!-- keywords -->
      <method name="keywords">
        <info>
          <tr lang="en">search in keywords</tr>
          <tr lang="ru" finished="false">Поиск по ключевым словам</tr>
        </info>
      </method>
      <!-- o -->
      <method name="o">
        <info>
          <tr lang="en">alias to objects method</tr>
          <tr lang="ru" finished="false">alias to objects метод</tr>
        </info>
      </method>
      <!-- objects -->
      <method name="objects">
        <info>
          <tr lang="en">search in objects names</tr>
          <tr lang="ru" finished="false">Поиск по именам объектов</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="control">
        <in on="symbol">
          <tr lang="en">search in descriptions</tr>
          <tr lang="ru" finished="false">Поиск в описаниях</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="control">
        <out type="any">
          <tr lang="en">list of matched object names</tr>
          <tr lang="ru" finished="false">Список совпадающих названий объектов</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[S digits=10] [S digits=10]
|             |
[k $1(        [o $1( [S digits=10]
|             |      |
[ceammc.search       ]
|
[ui.display]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
