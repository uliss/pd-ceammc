<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ceammc.search">
    <title>ceammc.search</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">search in the [ceammc] library</tr>
        <tr lang="ru">поиск в библиотеке [ceammc]</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>search</keywords>
      <since>0.9.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object searches the [ceammc] library by object names, keywords or
        descriptions. The search methods are: 'objects' (or its short alias 'o') — search by object
        names, 'keywords' (or 'k') — search by keywords, and the default inlet behavior (on a
        symbol) — search by descriptions. The maximum number of results is limited by the @max
        property. The list of matched object names is sent to the outlet.</tr>
        <tr lang="ru">Объект выполняет поиск по библиотеке [ceammc] по именам объектов, ключевым
        словам или описаниям. Методы поиска: 'objects' (или его краткий псевдоним 'o') — поиск по
        именам объектов, 'keywords' (или 'k') — поиск по ключевым словам, а поведение входа по
        умолчанию (при подаче символа) — поиск по описаниям. Максимальное число результатов
        ограничено свойством @max. Список совпавших имён объектов отправляется на выход.</tr>
      </par>
    </info>
    <properties>
      <!-- @max -->
      <property name="@max" type="int" minvalue="1" maxvalue="50" default="10">
        <tr lang="en">maximum number of results</tr>
        <tr lang="ru">максимальное количество результатов</tr>
      </property>
    </properties>
    <methods>
      <!-- k -->
      <method name="k">
        <info>
          <tr lang="en">alias to the keywords method</tr>
          <tr lang="ru">псевдоним метода keywords</tr>
        </info>
      </method>
      <!-- keywords -->
      <method name="keywords">
        <info>
          <tr lang="en">search by keywords</tr>
          <tr lang="ru">поиск по ключевым словам</tr>
        </info>
      </method>
      <!-- o -->
      <method name="o">
        <info>
          <tr lang="en">alias to the objects method</tr>
          <tr lang="ru">псевдоним метода objects</tr>
        </info>
      </method>
      <!-- objects -->
      <method name="objects">
        <info>
          <tr lang="en">search by object names</tr>
          <tr lang="ru">поиск по именам объектов</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="control">
        <in on="symbol">
          <tr lang="en">search by descriptions</tr>
          <tr lang="ru">поиск по описаниям</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="control">
        <out type="any">
          <tr lang="en">list of matched object names</tr>
          <tr lang="ru">список совпавших имён объектов</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[S digits=10] [S digits=10]
|             |
[k $1(        [o $1( [S digits=10]
|             |      |
[ceammc.search       ]
|
[ui.display]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
