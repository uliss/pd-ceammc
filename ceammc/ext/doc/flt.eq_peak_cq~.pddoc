<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flt.eq_peak_cq~">
    <title>flt.eq_peak_cq~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">constant-Q second order peaking equalizer section</tr>
        <tr lang="ru">секция эквалайзера: пиковый фильтр второго порядка c constant-Q</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flt</category>
      <keywords>filter equalizer</keywords>
      <since>0.6</since>
      <also>
        <see>flt.eq_peak~</see>
      </also>
    </meta>
    <arguments>
      <argument name="FREQ" type="float" units="hertz" minvalue="20" maxvalue="20000">
        <tr lang="en">center frequency</tr>
        <tr lang="ru" finished="false">центральная частота</tr>
      </argument>
      <argument name="GAIN" type="float" minvalue="-15" maxvalue="+15" units="decibel">
        <tr lang="en">filter gain</tr>
        <tr lang="ru" finished="false">коэффициент усиления фильтра</tr>
      </argument>
      <argument name="Q" type="float" minvalue="0.1" maxvalue="100">
        <tr lang="en">quality factory</tr>
        <tr lang="ru" finished="false">Качественный завод</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @freq -->
      <property name="@freq" type="float" minvalue="20" maxvalue="20000" default="1000"
      units="hertz">
        <tr lang="en">center frequency</tr>
        <tr lang="ru" finished="false">центральная частота</tr>
      </property>
      <!-- @gain -->
      <property name="@gain" type="float" minvalue="-15" maxvalue="15" default="0" units="decibel">
        <tr lang="en">filter gain</tr>
        <tr lang="ru" finished="false">коэффициент усиления фильтра</tr>
      </property>
      <!-- @q -->
      <property name="@q" type="float" minvalue="0.1" maxvalue="100" default="3">
        <tr lang="en">quality factor: @freq/BANDWIDTH</tr>
        <tr lang="ru" finished="false">Коэффициент качества: @freq/BANDWIDTH</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru" finished="false">входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">filtered signal</tr>
          <tr lang="ru" finished="false">фильтрованный сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[noise~] [F]        [F]        [F]
|        |          |          |
|        [@freq $1( [@gain $1( [@q $1(
|        |          |          |
[flt.eq_peak_cq~ 3000 15 3     ]
|
[ui.ssc~ @size 500 120 @log_scale 1]








[ui.dsp~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
