<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="flow.count">
        <title>flow.count</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">control flow event counter</tr>
                <tr lang="ru">счетчик числа сообщений в управляющем потоке</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>counter</keywords>
            <since>0.4</since>
        </meta>
        <arguments>
            <argument name="VALUE" type="int" minvalue="0">
                <tr lang="en">counter init value</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @value -->
            <property name="@value" type="int" minvalue="0" default="0">
                <tr lang="en">current counter state. Can be set via message to second(!) inlet or
                [prop.set] object.</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="any">
                    <tr lang="en">input messages</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">reset counter to init value (no output)</tr>
                </xinfo>
                <xinfo on="int">
                    <tr lang="en">set current value (no output)</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">@value X - set current value (no output)</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">@value? - output current value</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">+ X - add specified value (no output)</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">- X - subtract specified value (no output)</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>outputs event number</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 300]   [F]
|             |
|      [bang( [@value $1(
|      |.     |.
[flow.count    ]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
