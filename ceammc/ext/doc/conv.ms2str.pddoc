<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="conv.ms2str">
        <title>conv.ms2str</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">formats time in milliseconds to symbol or string</tr>
                <tr lang="ru">форматирует время в миллисекундах в символ или строку</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv time</keywords>
            <also>
                <see>conv.sec2str</see>
            </also>
            <since>0.9.7</since>
            <aliases>
                <alias>ceammc/ms-&gt;str</alias>
                <alias>ms-&gt;str</alias>
            </aliases>
        </meta>
        <properties>
            <!-- @ms -->
            <property name="@ms" type="flag" default="0" access="initonly">
                <tr lang="en">output milliseconds</tr>
                <tr lang="ru" finished="false">выход миллисекунд</tr>
            </property>
            <!-- @symbol -->
            <property name="@symbol" type="flag" default="0" access="initonly">
                <tr lang="en">if specified - output formatted time as symbol, otherwise as
                string.</tr>
                <!-- old: Если указано - выходное отформатированное время как
                символ, иначе как строка. -->
                <tr lang="ru" finished="false">Если указано - выходное отформатированное время как
                символ, иначе как строка.</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">converts float value in milliseconds to formatted symbol</tr>
                    <tr lang="ru" finished="false">Преобразует значение плавания в миллисекундах в
                    отформатированный символ</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">time in format "HH:MM::SS" or "HH:MM:SS.XXX"</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 200]
|
[f] X [+ 200]
|
[ms->str @symbol @ms]
|
[S digits=12]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
