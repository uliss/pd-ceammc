<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.ms2str">
    <title>conv.ms2str</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">formats time in milliseconds to symbol or string</tr>
        <tr lang="ru">форматирует время в миллисекундах в символ или строку</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv time</keywords>
      <also>
        <see>conv.sec2str</see>
      </also>
      <since>0.9.7</since>
      <aliases>
        <alias>ceammc/ms-&gt;str</alias>
        <alias>ms-&gt;str</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes a time value in milliseconds and formats it as a
        human-readable time string in the form "HH:MM:SS" (or "HH:MM:SS.XXX" if the @ms flag is
        set). By default the result is output as a String object, with the @symbol flag, the result is sent through the right outlet as a
        symbol.</tr>
        <tr lang="ru">Объект принимает значение времени в миллисекундах и форматирует его в
        удобочитаемую строку времени вида "HH:MM:SS" (или "HH:MM:SS.XXX", если установлен флаг
        @ms). По умолчанию результат выводится как String объект, при флаге @symbol результат отправляется через правый выход в виде символа.</tr>
      </par>
    </info>
    <properties>
      <!-- @ms -->
      <property name="@ms" type="flag" default="0" access="initonly">
        <tr lang="en">output milliseconds as well</tr>
        <tr lang="ru">выводить также миллисекунды</tr>
      </property>
      <!-- @symbol -->
      <property name="@symbol" type="flag" default="0" access="initonly">
        <tr lang="en">if specified, output the formatted time as a symbol; otherwise as a
        string</tr>
        <tr lang="ru">если указан, выводить форматированное время как символ; иначе как
        строку</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">time in milliseconds to format</tr>
          <tr lang="ru">время в миллисекундах для форматирования</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">time in the format "HH:MM:SS" or "HH:MM:SS.XXX"</tr>
          <tr lang="ru">время в формате "HH:MM:SS" или "HH:MM:SS.XXX"</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[metro 200]
|
[f] X [+ 200]
|
[ms->str @symbol @ms]
|
[S digits=12]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
