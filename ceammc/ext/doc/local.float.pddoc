<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="local.float">
        <title>local.float</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">canvas-scoped named float variable</tr>
                <tr lang="ru">локальное для патча именованное число с плавающей точкой</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>local</category>
            <keywords>float local</keywords>
            <since>0.1</since>
            <also>
                <see>local.int</see>
                <see>global.int</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Defines named local float variable, accessed by name and available
                only within its patch (canvas). Note: it is not accessible even from subpatch.</tr>
            </par>
        </info>
        <arguments>
            <argument name="ID" type="symbol">
                <tr lang="en">object ID</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @id -->
            <property name="@id" type="symbol" access="initonly" default="default">
                <tr lang="en">local variable id</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="float" access="readonly" default="0">
                <tr lang="en">current value</tr>
            </property>
        </properties>
        <methods>
            <!-- * -->
            <method name="*">
                <info>
                    <tr lang="en">multiply to, no output</tr>
                </info>
            </method>
            <!-- + -->
            <method name="+">
                <info>
                    <tr lang="en">add to float, no output</tr>
                </info>
            </method>
            <method name="-">
                <info>
                    <tr lang="en">subtract from float, no output</tr>
                </info>
            </method>
            <!-- / -->
            <method name="/">
                <info>
                    <tr lang="en">divide by, no output</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">sets new value without output</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">output value</xinfo>
                <xinfo on="float">sets new value and outputs it ONLY at current object
                outlet</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>float output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]   [+ 2, bang(    [* 3, bang(    [bang(
|     |              |              |
|     |              |              |
|     |  [- 3, bang( | [/ 2, bang(  |
|     |  |           | |            |
|     |  |           | |            |
|     |  |           | |            |
[local.float         f1]            [local.float f1]
|                                   |
[F]                                 [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
