<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="dict.keys">
    <title>dict.keys</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">output the list of dictionary keys</tr>
        <tr lang="ru">выводит список ключей словаря</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>list keys dictionary</keywords>
      <since>0.6</since>
      <also>
        <see>data.dict</see>
        <see>dict.values</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes a dictionary on its inlet and outputs a flat list of all its
        keys. The order of keys matches the order in which they appear in the dictionary.</tr>
        <tr lang="ru">Объект принимает словарь на вход и выводит плоский список всех его ключей.
        Порядок ключей соответствует порядку их следования в словаре.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="data">
          <tr lang="en">dictionary to extract keys from. On receipt, the object immediately outputs
          the list of keys</tr>
          <tr lang="ru">словарь, из которого нужно извлечь ключи. При получении объект сразу
          выводит список ключей</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">list of dict keys</tr>
          <tr lang="ru">список ключей словаря</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[data.dict \[a: b c: 200 12: 15151\]]
|
[dict.keys]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
