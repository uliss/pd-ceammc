<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="speech.rhvoice~">
        <title>speech.rhvoice~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">RHVoice text to speech synthesis</tr>
                <tr lang="ru">синтезатор речи RHVoice</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>misc</category>
            <keywords>speak speech flite</keywords>
            <since>0.9.5</since>
            <aliases>
                <alias>ceammc/rhvoice~</alias>
                <alias>rhvoice~</alias>
            </aliases>
            <also>
                <see>speech.flite~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: voices are not distributed with PureData-ceammc, you have to
                install voice data manually</tr>
            </par>
            <par>
                <tr lang="en">Download language and voice datafiles and put them into
                ~/Documents/Pd/rhvoice directory</tr>
            </par>
            <a href="https://github.com/RHVoice/Russian">https://github.com/RHVoice/Russian</a>
            <a href="https://github.com/RHVoice/anna-rus">https://github.com/RHVoice/anna-rus</a>
        </info>
        <properties>
            <!-- @pitch -->
            <property name="@pitch" type="float" default="0" minvalue="-1" maxvalue="1">
                <tr lang="en">voice pitch</tr>
            </property>
            <!-- @punct -->
            <property name="@punct" type="symbol" default="">
                <tr lang="en">punctuation for pronunciation. If 'all' - pronounce all, otherwise
                pronounce only specified punctuation characters.</tr>
            </property>
            <!-- @rate -->
            <property name="@rate" type="float" minvalue="-1" maxvalue="1" default="0">
                <tr lang="en">speaking rate</tr>
            </property>
            <!-- @voice -->
            <property name="@voice" type="symbol" default="Anna">
                <tr lang="en">voice</tr>
            </property>
            <!-- @volume -->
            <property name="@volume" type="float" default="1" minvalue="0" maxvalue="1">
                <tr lang="en">voice volume</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clear TTS queue</tr>
                </info>
            </method>
            <!-- read -->
            <method name="read">
                <info>
                    <tr lang="en">read TTS file (text or SSML)</tr>
                </info>
                <param name="FILE" type="symbol" required="true">
                    <tr lang="en">absolute or relative path to the file</tr>
                </param>
            </method>
            <!-- ssml -->
            <method name="ssml">
                <info>
                    <tr lang="en">speak SSML text markup</tr>
                </info>
            </method>
            <!-- stop -->
            <method name="stop">
                <info>
                    <tr lang="en">stops speech and clear TTS queue</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">speak number</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">speak symbol</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">speak list of symbols</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">TTS output</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">bang on done, [word 1( on word start, [word 0( on word end,
                    [sentence 1( on sentence start, [sentence 0( on sentence end</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]          [speech.rhvoice~-voices]/*<-- see here*/
|
[metro 1000]
|
[flow.count] [ui.hsl #a]     [ui.hsl #a]
|            |               |
|            [@pitch $1(     [@rate $1(
|            |               |
|            |      [L]      |
|            |      |        |
[speech.rhvoice~             ]
|          ^|
|          [print RHVOICE]
|
[ui.gain~ @size 120 16]   [ui.dsp~]
|\
[dac~]

[speech.rhvoice~-extra]

#a -1 1 @show_value 1
]]>
            </pdascii>
            <pdascii id="voices">
<![CDATA[
/* Pd Documents directory structure for RHVoice */

/* rhvoice/ */
    /*| */
    /*languages/ */
    /*|       |*/
    /*|       English... etc. */
    /*| */
    /*voices/ */
        /*| */
        /*voice1... */

[symbol anna-rus(
|
[L digits=30]
|
[%CEAMMC%/rhvoice_download --voice $1(
|
|
| [%CEAMMC%/rhvoice_download --list-voices(
| |
| |
| | [%CEAMMC%/rhvoice_download --list-languages(
| | |
| | |
| | |
[expand_env @any]
|
|
[system.cmd]
          ^|
           |
           |
          [print OUT]
]]>
            </pdascii>
            <pdascii id="extra">
<![CDATA[
[ssml <speak><voice name="Pavel">Я Павел</voice><voice name="Anna">а я Анна</voice></speak>(
|
|                                         [all( [!(
|                                         |     |
|  [list з+амок и зам+ок(                 [symbol] [symbol(
|  |                                      |        |
|  |  [list казнить нельзя\, помиловать!( [@punct $1(
|  |  |                                   |
[speech.rhvoice~                          ]
|
[ui.hgain~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
