<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="speech.rhvoice~">
    <title>speech.rhvoice~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">RHVoice text to speech synthesis</tr>
        <tr lang="ru">синтезатор речи RHVoice</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>misc</category>
      <keywords>speak speech flite</keywords>
      <since>0.9.5</since>
      <aliases>
        <alias>ceammc/rhvoice~</alias>
        <alias>rhvoice~</alias>
      </aliases>
      <also>
        <see>speech.flite~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object synthesizes speech from text using the RHVoice engine and outputs
        it as an audio signal</tr>
        <tr lang="ru">объект синтезирует речь из текста с помощью движка RHVoice и выводит её как
        аудиосигнал</tr>
      </par>
      <par>
        <tr lang="en">note: voices are not distributed with Pure Data-ceammc, you have to install
        the voice data manually</tr>
        <tr lang="ru">примечание: голоса не поставляются вместе с Pure Data-ceammc, голосовые
        данные нужно устанавливать вручную</tr>
      </par>
      <par>
        <tr lang="en">download the language and voice data files and put them into the
        ~/Documents/Pd/rhvoice directory</tr>
        <tr lang="ru">скачайте файлы языковых и голосовых данных и поместите их в каталог
        ~/Documents/Pd/rhvoice</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to add voice prompts or spoken feedback to a patch,
        for example to announce parameter values or to read out messages</tr>
        <tr lang="ru">объект можно использовать для добавления голосовых подсказок или речевой
        обратной связи в патч, например чтобы озвучивать значения параметров или зачитывать
        сообщения</tr>
      </par>
      <a href="https://github.com/RHVoice/Russian">https://github.com/RHVoice/Russian</a>
      <a href="https://github.com/RHVoice/anna-rus">https://github.com/RHVoice/anna-rus</a>
    </info>
    <properties>
      <!-- @pitch -->
      <property name="@pitch" type="float" default="0" minvalue="-1" maxvalue="1">
        <tr lang="en">voice pitch</tr>
        <tr lang="ru">высота голоса</tr>
      </property>
      <!-- @punct -->
      <property name="@punct" type="symbol" default="">
        <tr lang="en">punctuation for pronunciation. If 'all' — pronounce all, otherwise pronounce
        only the specified punctuation characters</tr>
        <tr lang="ru">пунктуация для произношения. Если 'all' — произносить все знаки, иначе
        произносить только указанные знаки препинания</tr>
      </property>
      <!-- @rate -->
      <property name="@rate" type="float" minvalue="-1" maxvalue="1" default="0">
        <tr lang="en">speaking rate</tr>
        <tr lang="ru">скорость речи</tr>
      </property>
      <!-- @voice -->
      <property name="@voice" type="symbol" default="Anna">
        <tr lang="en">voice</tr>
        <tr lang="ru">голос</tr>
      </property>
      <!-- @volume -->
      <property name="@volume" type="float" default="1" minvalue="0" maxvalue="1">
        <tr lang="en">voice volume</tr>
        <tr lang="ru">громкость голоса</tr>
      </property>
    </properties>
    <methods>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clear the TTS queue</tr>
          <tr lang="ru">очистить очередь TTS</tr>
        </info>
      </method>
      <!-- read -->
      <method name="read">
        <info>
          <tr lang="en">read a TTS file (text or SSML)</tr>
          <tr lang="ru">прочитать файл TTS (текст или SSML)</tr>
        </info>
        <param name="FILE" type="symbol" required="true">
          <tr lang="en">absolute or relative path to the file</tr>
          <tr lang="ru">абсолютный или относительный путь к файлу</tr>
        </param>
      </method>
      <!-- ssml -->
      <method name="ssml">
        <info>
          <tr lang="en">speak SSML text markup</tr>
          <tr lang="ru">произнести текст с разметкой SSML</tr>
        </info>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stop speech and clear the TTS queue</tr>
          <tr lang="ru">остановить речь и очистить очередь TTS</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">speak a number</tr>
          <tr lang="ru">произнести число</tr>
        </in>
        <in on="symbol">
          <tr lang="en">speak a symbol</tr>
          <tr lang="ru">произнести символ</tr>
        </in>
        <in on="list">
          <tr lang="en">speak a list of symbols</tr>
          <tr lang="ru">произнести список символов</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">TTS output</tr>
          <tr lang="ru">выход TTS</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">bang on done, [word 1( on word start, [word 0( on word end, [sentence 1( on
          sentence start, [sentence 0( on sentence end</tr>
          <tr lang="ru">bang по завершении, [word 1( в начале слова, [word 0( в конце слова,
          [sentence 1( в начале предложения, [sentence 0( в конце предложения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]          [speech.rhvoice~-voices]/*<-- see here*/
|
[metro 1000]
|
[flow.count] [ui.hsl #a]     [ui.hsl #a]
|            |               |
|            [@pitch $1(     [@rate $1(
|            |               |
|            |      [L]      |
|            |      |        |
[speech.rhvoice~             ]
|          ^|
|          [print RHVOICE]
|
[ui.gain~ @size 120 16]   [ui.dsp~]
|\
[dac~]

[speech.rhvoice~-extra]

#a -1 1 @show_value 1
]]>
      </pdascii>
      <pdascii id="voices">
<![CDATA[
/* Pd Documents directory structure for RHVoice */

/* rhvoice/ */
    /*| */
    /*languages/ */
    /*|       |*/
    /*|       English... etc. */
    /*| */
    /*voices/ */
        /*| */
        /*voice1... */

[symbol anna-rus(
|
[L digits=30]
|
[%CEAMMC%/rhvoice_download --voice $1(
|
|
| [%CEAMMC%/rhvoice_download --list-voices(
| |
| |
| | [%CEAMMC%/rhvoice_download --list-languages(
| | |
| | |
| | |
[expand_env @any]
|
|
[system.cmd]
          ^|
           |
           |
          [print OUT]
]]>
      </pdascii>
      <pdascii id="extra">
<![CDATA[
[ssml <speak><voice name="Pavel">Я Павел</voice><voice name="Anna">а я Анна</voice></speak>(
|
|                                         [all( [!(
|                                         |     |
|  [list з+амок и зам+ок(                 [symbol] [symbol(
|  |                                      |        |
|  |  [list казнить нельзя\, помиловать!( [@punct $1(
|  |  |                                   |
[speech.rhvoice~                          ]
|
[ui.hgain~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
