<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="samp.time~">
        <title>samp.time~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sample counter</tr>
                <tr lang="ru">счетчик семплов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>samp</category>
            <keywords>base</keywords>
            <since>0.9.4</since>
            <aliases>
                <alias>samp.t~</alias>
            </aliases>
        </meta>
        <arguments>
            <argument name="STATE" type="int" enum="0 1">
                <tr lang="en">initial counter state: on or off</tr>
                <tr lang="ru" finished="false">Начальное встречное состояние: включено или
                выключено</tr>
            </argument>
        </arguments>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset sample counter to 0</tr>
                    <tr lang="ru" finished="false">сбрасывать счетчик выборки 0</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">set current value</tr>
                    <tr lang="ru" finished="false">Установить текущую стоимость</tr>
                </info>
                <param name="VAL" type="float" default="0">
                    <tr lang="en">new counter value</tr>
                    <tr lang="ru" finished="false">Новая встречная стоимость</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">on 0-&gt;1 change: start counter, on 1-&gt;0 stops.</tr>
                    <tr lang="ru" finished="false">на 0-&gt;1 изменение: стартовый счетчик, на
                    1-&gt;0 остановки.</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">reset sample counter</tr>
                    <tr lang="ru" finished="false">сбрасывать счетчик образцов</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">set current value</tr>
                    <tr lang="ru" finished="false">Установить текущую стоимость</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">current sample number</tr>
                    <tr lang="ru" finished="false">Текущий номер выборки</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]    [bang(    [lfo.+square~ 100]
|      |.        |
[samp.t~]        [samp.t~]
|                |
[ui.n~]          [ui.n~]

[T]
|
[samp.t~ 0]      [ui.dsp~]
|
[ui.n~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
