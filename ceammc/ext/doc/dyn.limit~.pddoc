<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="dyn.limit~">
        <title>dyn.limit~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">mono 1176LN Peak Limiter</tr>
                <tr lang="ru">пиковый моно-ограничитель сигнала в схемотехнике 1176LN</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>dyn</category>
            <keywords>limiter</keywords>
            <since>0.1</since>
            <also>
                <see>dyn.limit2~</see>
                <see>dyn.comp~</see>
            </also>
        </meta>
        <info>
            <a href="https://en.wikipedia.org/wiki/1176_Peak_Limiter">1176 Peak Limiter</a>
        </info>
        <properties>
            <xi:include href="props_active.xml" />
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset to initial state</tr>
                    <tr lang="ru" finished="false">Перезагрузка в начальное состояние</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal</tr>
                    <tr lang="ru" finished="false">выходной сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[osc~ 440]  [floatatom]
|           |.
[*~          ]
| |
| [env~]
| |
| [floatatom]
|
[dyn.limit~]
|
[env~]
|
[floatatom]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
