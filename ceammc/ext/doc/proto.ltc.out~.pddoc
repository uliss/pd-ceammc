<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="proto.ltc.out~">
        <title>proto.ltc.out~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">LTC encoder</tr>
                <tr lang="ru">LTC энкодер</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>proto</category>
            <keywords>parser ltc</keywords>
            <since>0.9.7</since>
            <aliases>
                <alias>ltc.out~</alias>
            </aliases>
            <also>
                <see>ltc.in~</see>
            </also>
        </meta>
        <properties>
            <!-- @filter -->
            <property name="@filter" type="float" default="0" minvalue="0" maxvalue="500">
                <tr lang="en">output signal filtering. LTC should have a rise time of 40us+/-10 us.
                If you want a perfect square wave, set to 0</tr>
            </property>
            <!-- @fps -->
            <property name="@fps" type="float" default="25">
                <tr lang="en">frames per second rate. Supported values are: 24, 25, 29.97, 30.</tr>
            </property>
            <!-- @on -->
            <property name="@on" type="bool" default="0">
                <tr lang="en">encoder state</tr>
            </property>
            <!-- @speed -->
            <property name="@speed" type="float" default="1">
                <tr lang="en">playing speed</tr>
            </property>
            <!-- @volume -->
            <property name="@volume" type="float" default="-3" minvalue="-42" maxvalue="0"
            units="decibel">
                <tr lang="en">output signal level</tr>
            </property>
        </properties>
        <methods>
            <!-- date -->
            <method name="date">set current date 
            <param name="YEAR" type="int" required="true" minvalue="0" maxvalue="3000">
                <tr lang="en">year</tr>
            </param>
            <param name="MONTH" type="int" required="true" minvalue="1" maxvalue="12">
                <tr lang="en">month</tr>
            </param>
            <param name="DAY" type="int" required="true" minvalue="1" maxvalue="31">
                <tr lang="en">day</tr>
            </param>
            <param name="TIMEZONE" type="symbol" required="false">
                <tr lang="en">timezone in +HHMM format</tr>
            </param></method>
            <!-- seek -->
            <method name="seek">time seek 
            <param name="UNIT" type="atom" required="true">
                <tr lang="en">relative position seek. If float or int - seek in frames, otherwise
                units are expected. Supported units are: day, hour, min, sec. E.g.: 1day, 3hour,
                5min, 11sec etc.</tr>
            </param></method>
            <!-- time -->
            <method name="time">set current time 
            <param name="HOUR" type="int" required="true" minvalue="0" maxvalue="23">
                <tr lang="en">hour</tr>
            </param>
            <param name="MIN" type="int" required="true" minvalue="0" maxvalue="59">
                <tr lang="en">minute</tr>
            </param>
            <param name="SEC" type="int" required="true" minvalue="0" maxvalue="59">
                <tr lang="en">second</tr>
            </param>
            <param name="FRAME" type="int" required="false" minvalue="0" maxvalue="30">
                <tr lang="en">frame number</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">output current time to second outlet</xinfo>
                <xinfo on="bool">switch on/off encoder process</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">LTC signal</outlet>
            <outlet>list: HOUR MINUTE SECOND FRAME</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]   [date 83 1 11(   [ui.hsl 0.5 4 @show_value 1]
|     |                |
|     |                |
|     | [time 0 4 15(  [@speed $1(    [ui.dsp~]
| [B] | |              |
| |   | | [seek 10sec( |
| |   | | |            |
[ltc.out~    {i=1,o=2} #z]
|     ^|
|     [ui.dt]
|
[ltc.in~ #y]
|
[ui.dt]       [ui.dt #x]

[X y:1->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
