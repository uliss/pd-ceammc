<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flow.reject">
        <title>flow.reject</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">reject specified values</tr>
                <tr lang="ru">не пропускает указанные значения</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>reject functional</keywords>
            <since>0.3</since>
            <aliases>
                <alias>ceammc/reject</alias>
                <alias>reject</alias>
                <alias>flow.!</alias>
            </aliases>
            <also>
                <see>flow.reject_if</see>
                <see>flow.pass</see>
            </also>
        </meta>
        <arguments>
            <argument name="VALUES" type="list">
                <tr lang="en">list of atoms to reject</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @values -->
            <property name="@values" type="list" default="">
                <tr lang="en">atoms to reject</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">pass</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">reject if float is in reject list</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">reject if symbol is in reject list</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">reject if first atom is in reject list</tr>
                </xinfo>
                <xinfo on="any">
                    <tr lang="en">reject if message selector is in reject list</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">set reject list</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>passed values</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[flow.reject 0]
|
[1/x]
|
[F digits=12]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
