<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.reject">
    <title>flow.reject</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">reject specified values</tr>
        <tr lang="ru">не пропускает указанные значения</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>reject functional</keywords>
      <since>0.3</since>
      <aliases>
        <alias>ceammc/reject</alias>
        <alias>reject</alias>
        <alias>flow.!</alias>
      </aliases>
      <also>
        <see>flow.reject_if</see>
        <see>flow.pass</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object passes the input value only if it is not found in the reject list,
        otherwise nothing is output</tr>
        <tr lang="ru">объект пропускает входное значение только если оно не найдено в списке
        отклонения, иначе на выход ничего не поступает</tr>
      </par>
      <par>
        <tr lang="en">the reject list is set by the VALUES argument, the @values property, or by
        sending a list to the right inlet</tr>
        <tr lang="ru">список отклонения задаётся аргументом VALUES, свойством @values или подачей
        списка на правый вход</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to filter out unwanted values from a stream, for
        example to remove zero values before a division or to block specific note numbers</tr>
        <tr lang="ru">объект можно использовать для отбрасывания нежелательных значений из потока,
        например чтобы убрать нули перед делением или заблокировать определённые номера нот</tr>
      </par>
    </info>
    <arguments>
      <argument name="VALUES" type="list">
        <tr lang="en">list of atoms to reject</tr>
        <tr lang="ru">список атомов для отклонения</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @values -->
      <property name="@values" type="list" default="">
        <tr lang="en">atoms to reject</tr>
        <tr lang="ru">атомы для отклонения</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">pass</tr>
          <tr lang="ru">пропустить</tr>
        </in>
        <in on="float">
          <tr lang="en">reject if the float is in the reject list</tr>
          <tr lang="ru">отклонить, если число есть в списке отклонения</tr>
        </in>
        <in on="symbol">
          <tr lang="en">reject if the symbol is in the reject list</tr>
          <tr lang="ru">отклонить, если символ есть в списке отклонения</tr>
        </in>
        <in on="list">
          <tr lang="en">reject if the first atom is in the reject list</tr>
          <tr lang="ru">отклонить, если первый атом есть в списке отклонения</tr>
        </in>
        <in on="any">
          <tr lang="en">reject if the message selector is in the reject list</tr>
          <tr lang="ru">отклонить, если селектор сообщения есть в списке отклонения</tr>
        </in>
      </inlet>
      <inlet>
        <in on="list">
          <tr lang="en">set the reject list</tr>
          <tr lang="ru">задать список отклонения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">passed values</tr>
          <tr lang="ru">переданные значения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]
|
[flow.reject 0]
|
[1/x]
|
[F digits=12]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
