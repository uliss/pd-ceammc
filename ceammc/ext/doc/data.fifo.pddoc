<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="data.fifo">
        <title>data.fifo</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">FIFO (First In First Out) - the queue data container</tr>
                <tr lang="ru">FIFO First In First Out) - контейнер данных "очередь"</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data fifo</keywords>
            <since>0.1</since>
            <also>
                <see>data.list</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">If size argument specified - creates queue with fixed size. When
                count of values exceed this limit, outputs and removes first value in queue.</tr>
            </par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">open data editor</event>
        </mouse>
        <arguments>
            <argument name="SIZE" type="int" minvalue="1" maxvalue="1024">
                <tr lang="en">if specified, creates fixed-size queue. See @size property</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @empty -->
            <property name="@empty" type="bool" access="readonly" default="1">
                <tr lang="en">if queue is empty</tr>
            </property>
            <!-- @filled -->
            <property name="@filled" type="int" minvalue="0" access="readonly" default="0">
                <tr lang="en">current number of elements in queue</tr>
            </property>
            <!-- @free -->
            <property name="@free" type="int" minvalue="0" access="readonly" default="32">
                <tr lang="en">number of elements you can add to queue until it full</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="int" minvalue="1" maxvalue="1024" default="32">
                <tr lang="en">size of queue</tr>
            </property>
        </properties>
        <methods>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">removes all queue values</tr>
                </info>
            </method>
            <!-- flush -->
            <method name="flush">
                <info>
                    <tr lang="en">outputs and removes all queue values</tr>
                </info>
            </method>
            <!-- pop -->
            <method name="pop">
                <info>
                    <tr lang="en">outputs and removes first values in queue</tr>
                </info>
            </method>
            <!-- resize -->
            <method name="resize">
                <param type="int" minvalue="0">
                    <tr lang="en">changes queue size. All previous values (if any) are silently
                    removed</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">same as *flush* message</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
                 [F]
                 |
    [pop(  [1 2( [resize $1(
    |      |         |        [@size?( [@free?( [@filled?(
[F] |  [B] | [clear( | [flush( |       |        |
|   |  |   | |       | |       |       |        |
[data.fifo                                     5]
|                |
[ui.dt]          [print]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
