<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.asin~">
        <title>math.asin~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">arc sine for signals</tr>
                <tr lang="ru">арксинус для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math asin</keywords>
            <also>
                <see>math.asin</see>
                <see>math.acos~</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Outputs the principle value of the arc sine of input signal. The
                result is in the range [-pi/2, +pi/2]</tr>
                <!-- old: Выходит принципиальное значение дугового синуса
                входного сигнала. Результат находится в диапазоне [-pi/2, +pi/2] -->
                <tr lang="ru" finished="false">Выходит принципиальное значение дугового синуса
                входного сигнала. Результат находится в диапазоне [-pi/2, +pi/2]</tr>
            </par>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">result signal</tr>
                    <tr lang="ru" finished="false">результат сигнала</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[plot.linspace~ -1 1 @pi]
|                 ^|
[math.asin~]       |
|                  |.
[ui.plot~ @xlabels 1 @ylabels 1 @ymin -1.6 @ymax 1.6 @ymin_ticks 0 @ymaj_ticks 0 @size 200 200]














[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
