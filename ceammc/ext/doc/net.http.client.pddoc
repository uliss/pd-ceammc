<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="net.http.client">
        <title>net.http.client</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">HTTP client</tr>
                <tr lang="ru">HTTP клиент</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>net</category>
            <keywords>net http</keywords>
            <since>0.9.8</since>
            <aliases>
                <alias>http.client</alias>
            </aliases>
        </meta>
        <methods>
            <!-- download -->
            <method name="download">
                <info>
                    <tr lang="en">download file</tr>
                </info>
                <param name="URL" type="symbol" required="true">
                    <tr lang="en">download URL</tr>
                </param>
                <param name="FILE" type="symbol" required="false">
                    <tr lang="en">save filename. If not specified, use HTTP document filename</tr>
                </param>
                <param name="@PARAMS" type="list" required="false">
                    <tr lang="en">see get method parameters</tr>
                </param>
            </method>
            <!-- get -->
            <method name="get">
                <info>
                    <tr lang="en">send GET request</tr>
                </info>
                <param name="URL" type="symbol" required="true">
                    <tr lang="en">request URL</tr>
                </param>
                <param name="@header" type="list" required="false">
                    <tr lang="en">additional http header: @header NAME VALUE</tr>
                </param>
                <param name="@form" type="list" required="false">
                    <tr lang="en">form key-value pair: @form KEY VALUE. For
                    application/x-www-form-urlencoded MIME type.</tr>
                </param>
                <param name="@auth" type="list" required="false">
                    <tr lang="en">basic auth username/password: @auth USER PASS</tr>
                </param>
                <param name="@css" type="list" required="false">
                    <tr lang="en">apply CSS selector to the request body: @css SEL OUTPUT_TYPE,
                    where OUTPUT_TYPE is one of: 'html', 'inner', 'text', 'href', 'none'. 'html' -
                    returns selected elenent HTML content, 'inner' - returns inner HTML content,
                    without element surrounding tags, 'text' returns element text without tags,
                    'href' - return href attribute of selected element, 'none' - returns empty
                    string</tr>
                </param>
                <param name="@strip_ws" type="symbol" required="false">
                    <tr lang="en">replace multiple whitespaces/newlines/tabs with single space</tr>
                </param>
                <param name="@json" type="symbol" required="false">
                    <tr lang="en">parse result as Json and output it as data:Dict()</tr>
                </param>
            </method>
            <!-- post -->
            <method name="post">
                <info>
                    <tr lang="en">send POST request</tr>
                </info>
                <param name="URL" type="symbol" required="true">
                    <tr lang="en">request URL</tr>
                </param>
                <param name="@PARAMS" type="list" required="false">
                    <tr lang="en">see get method parameters</tr>
                </param>
            </method>
            <!-- upload -->
            <method name="upload">
                <info>
                    <tr lang="en">updload file for the form</tr>
                </info>
                <param name="URL" type="symbol" required="true">
                    <tr lang="en">upload URL</tr>
                </param>
                <param name="FILE" type="symbol" required="true">
                    <tr lang="en">upload file path in the filesystem</tr>
                </param>
                <param name="FORM_KEY" type="symbol" required="true">
                    <tr lang="en">form entry key</tr>
                </param>
                <param name="@PARAMS" type="list" required="false">
                    <tr lang="en">see get method parameters</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>int: HTTP status code</outlet>
            <outlet>data:String: HTTP body or content of selected element</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[get http://puredata.info/ @css title text @strip_ws(
|
| [get https://github.com/uliss/pd-ceammc/releases @css a\[href$=".dmg"\] href #a(
|
|
|
|   [get http://ip.jsontest.com/ @json(
|   |
[net.http.client #z]
|            ^|
[F]          [print]

[X a->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
