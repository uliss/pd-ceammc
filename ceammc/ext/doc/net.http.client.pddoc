<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="net.http.client">
    <title>net.http.client</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">HTTP client</tr>
        <tr lang="ru">HTTP-клиент</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>net</category>
      <keywords>net http</keywords>
      <since>0.9.8</since>
      <aliases>
        <alias>http.client</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object sends HTTP requests (GET, POST) and downloads or uploads files</tr>
        <tr lang="ru">объект отправляет HTTP-запросы (GET, POST) и скачивает или загружает файлы</tr>
      </par>
      <par>
        <tr lang="en">the first outlet outputs the HTTP status code, the second — the response body or the content of the selected element</tr>
        <tr lang="ru">первый выход выдаёт код состояния HTTP, второй — тело ответа или содержимое выбранного элемента</tr>
      </par>
      <par>
        <tr lang="en">with @json the response is parsed and output as data:Dict()</tr>
        <tr lang="ru">при @json ответ разбирается и выводится как data:Dict()</tr>
      </par>
    </info>
    <methods>
      <!-- download -->
      <method name="download">
        <info>
          <tr lang="en">download file</tr>
          <tr lang="ru">скачать файл</tr>
        </info>
        <param name="URL" type="symbol" required="true">
          <tr lang="en">download URL</tr>
          <tr lang="ru">URL для скачивания</tr>
        </param>
        <param name="FILE" type="symbol" required="false">
          <tr lang="en">save filename. If not specified, use the HTTP document filename</tr>
          <tr lang="ru">имя файла для сохранения. Если не указано, используется имя файла из HTTP-документа</tr>
        </param>
        <param name="@PARAMS" type="list" required="false">
          <tr lang="en">see get method parameters</tr>
          <tr lang="ru">см. параметры метода get</tr>
        </param>
      </method>
      <!-- get -->
      <method name="get">
        <info>
          <tr lang="en">send GET request</tr>
          <tr lang="ru">отправить GET-запрос</tr>
        </info>
        <param name="URL" type="symbol" required="true">
          <tr lang="en">request URL</tr>
          <tr lang="ru">URL запроса</tr>
        </param>
        <param name="@header" type="list" required="false">
          <tr lang="en">additional HTTP header: @header NAME VALUE</tr>
          <tr lang="ru">дополнительный HTTP-заголовок: @header NAME VALUE</tr>
        </param>
        <param name="@form" type="list" required="false">
          <tr lang="en">form key-value pair: @form KEY VALUE, for the application/x-www-form-urlencoded MIME type</tr>
          <tr lang="ru">пара ключ-значение формы: @form KEY VALUE, для MIME-типа application/x-www-form-urlencoded</tr>
        </param>
        <param name="@auth" type="list" required="false">
          <tr lang="en">basic auth username/password: @auth USER PASS</tr>
          <tr lang="ru">basic-авторизация логин/пароль: @auth USER PASS</tr>
        </param>
        <param name="@css" type="list" required="false">
          <tr lang="en">apply CSS selector to the request body: @css SEL OUTPUT_TYPE, where OUTPUT_TYPE is one of "html", "inner", "text", "href", "none". "html" — returns the selected element HTML content, "inner" — returns inner HTML content without the element surrounding tags, "text" — returns element text without tags, "href" — returns the href attribute of the selected element, "none" — returns an empty string</tr>
          <tr lang="ru">применить CSS-селектор к телу запроса: @css SEL OUTPUT_TYPE, где OUTPUT_TYPE — одно из "html", "inner", "text", "href", "none". "html" — возвращает HTML-содержимое выбранного элемента, "inner" — возвращает внутреннее HTML-содержимое без окружающих тегов элемента, "text" — возвращает текст элемента без тегов, "href" — возвращает атрибут href выбранного элемента, "none" — возвращает пустую строку</tr>
        </param>
        <param name="@strip_ws" type="symbol" required="false">
          <tr lang="en">replace multiple whitespaces/newlines/tabs with a single space</tr>
          <tr lang="ru">заменить несколько пробелов/переводов строк/табуляций одним пробелом</tr>
        </param>
        <param name="@json" type="symbol" required="false">
          <tr lang="en">parse result as JSON and output it as data:Dict()</tr>
          <tr lang="ru">разобрать результат как JSON и вывести его как data:Dict()</tr>
        </param>
      </method>
      <!-- post -->
      <method name="post">
        <info>
          <tr lang="en">send POST request</tr>
          <tr lang="ru">отправить POST-запрос</tr>
        </info>
        <param name="URL" type="symbol" required="true">
          <tr lang="en">request URL</tr>
          <tr lang="ru">URL запроса</tr>
        </param>
        <param name="@PARAMS" type="list" required="false">
          <tr lang="en">see get method parameters</tr>
          <tr lang="ru">см. параметры метода get</tr>
        </param>
      </method>
      <!-- upload -->
      <method name="upload">
        <info>
          <tr lang="en">upload file for the form</tr>
          <tr lang="ru">загрузить файл для формы</tr>
        </info>
        <param name="URL" type="symbol" required="true">
          <tr lang="en">upload URL</tr>
          <tr lang="ru">URL для загрузки</tr>
        </param>
        <param name="FILE" type="symbol" required="true">
          <tr lang="en">upload file path in the filesystem</tr>
          <tr lang="ru">путь к загружаемому файлу в файловой системе</tr>
        </param>
        <param name="FORM_KEY" type="symbol" required="true">
          <tr lang="en">form entry key</tr>
          <tr lang="ru">ключ записи формы</tr>
        </param>
        <param name="@PARAMS" type="list" required="false">
          <tr lang="en">see get method parameters</tr>
          <tr lang="ru">см. параметры метода get</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input</tr>
          <tr lang="ru">вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">HTTP status code</tr>
          <tr lang="ru">код состояния HTTP</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">data:String: HTTP body or content of the selected element</tr>
          <tr lang="ru">data:String: тело HTTP-ответа или содержимое выбранного элемента</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[get http://puredata.info/ @css title text @strip_ws(
|
| [get https://github.com/uliss/pd-ceammc/releases @css a\[href$=".dmg"\] href #a(
|
|
|
|   [get http://ip.jsontest.com/ @json(
|   |
[net.http.client #z]
|            ^|
[F]          [print]

[X a->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
