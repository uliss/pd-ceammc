<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="msg.onload">
    <title>msg.onload</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">send the specified message upon patch loading</tr>
        <tr lang="ru">отправить указанное сообщение при загрузе патча</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>msg</category>
      <keywords>message loadbang onload</keywords>
      <aliases>
        <alias>ceammc/loadmsg</alias>
        <alias>loadmsg</alias>
      </aliases>
      <since>0.7</since>
      <also>
        <see>msg.onclose</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Like [loadbang], but with message and click support.</tr>
        <tr lang="ru">Как [loadbang], но с поддержкой сообщений и клика.</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">send message</event>
    </mouse>
    <arguments>
      <argument name="MSG" type="list">
        <tr lang="en">The message being sent. Messages separated by commas are also supported.</tr>
        <tr lang="ru">Отправляемое сообщение. Поддерживаются также сообщения, разделенные запятой.</tr>
      </argument>
    </arguments>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">message output</tr>
          <tr lang="ru">вывод сообщений</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*click me!*/

[loadmsg load message]
|   |       |
|   |       |
[B] [print] [ui.dt @auto_size 0]

[msg.onload-type]
]]>
      </pdascii>
      <pdascii id="type">
<![CDATA[
[msg.onload]             [msg.onload \$0]
|                        |
[ui.dt @auto_size 0]     [ui.dt @auto_size 0]

[msg.onload 1000]        [msg.onload symbol \$0-text]
|                        |
[ui.dt @auto_size 0]     [ui.dt @auto_size 0 @size 140 15]

[msg.onload symbol TEXT] [r \$0-test]    [msg.onload \; \$0-test 1 2 3]
|                        |
[ui.dt @auto_size 0]     [ui.dt @auto_size 0 @size 140 15]

[msg.onload 1 2 3 4 5]   /*<-- implicit list*/
|
[ui.dt @auto_size 0]

[msg.onload list A B @C] /*<-- explicit list*/
|
[ui.dt @auto_size 0]

[msg.onload TEXT]
|
[ui.dt @auto_size 0]

[msg.onload MSG ARG0 @ARG1]
|
[ui.dt @auto_size 0 @size 140 15]

[msg.onload A \, B \, C] /*<-- comma separated messages*/
|
[print]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
