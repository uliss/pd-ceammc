<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.tanh">
        <title>math.tanh</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">hyperbolic tangent function</tr>
                <tr lang="ru">гиперболический тангенс</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math tanh</keywords>
            <also>
                <see>math.acos</see>
                <see>math.asin</see>
                <see>math.atan</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The tanh() function computes the hyperbolic tangent of x.</tr>
                <tr lang="ru" finished="false">Функция tanh() вычисляет гиперболический тангенс
                x.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
                <tr lang="ru" finished="false">Особые ценности:</tr>
            </par>
            <par>
                <tr lang="en">tanh(+-0) returns +-0.</tr>
                <tr lang="ru" finished="false">танх (+-0) возвращается +-0.</tr>
            </par>
            <par>
                <tr lang="en">tanh(+-infinity) returns +-1.</tr>
                <tr lang="ru" finished="false">танх (+-бесконечность) возвращается +-1.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input value</tr>
                    <tr lang="ru" finished="false">входная стоимость</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">apply to all numeric values</tr>
                    <tr lang="ru" finished="false">применяется ко всем числовым значениям</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result value</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(                  [array TANH w=320]
|
[list.seq -5 5 0.1]
|
[math.tanh]
|
[list->array TANH]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
