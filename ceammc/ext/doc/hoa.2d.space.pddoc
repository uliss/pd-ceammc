<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hoa.2d.space" type="gui">
    <title>hoa.2d.space</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
        <author>Pierre Guillot</author>
        <author>Eliott Paris</author>
        <author>Thomas Le Meur</author>
      </authors>
      <description>
        <tr lang="en">2D planewaves amplitude control</tr>
        <tr lang="ru">управление амплитудой двумерных плоских волн</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">spat</category>
      <keywords>hoa space ui control circular</keywords>
      <since>0.9.7</since>
      <aliases>
        <alias view="link">hoa.space</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">A graphical user interface element for controlling processing in the plane
        wave domain. It shows the amplitudes of plane waves as points arranged around a circle and
        allows the user to modify them with the mouse.</tr>
        <tr lang="ru">Графический элемент управления для работы в области плоских волн. Отображает
        амплитуды плоских волн в виде точек, расположенных по окружности, и позволяет изменять их
        мышью.</tr>
      </par>
      <par>
        <tr lang="en">For one channel, drag with the mouse to change the amplitude of that channel.
        For all channels at once, hold Shift and drag. To rotate all values, hold Alt and
        drag.</tr>
        <tr lang="ru">Для одного канала перетаскивайте мышью, чтобы изменить амплитуду этого
        канала. Чтобы изменить сразу все каналы, удерживайте Shift при перетаскивании. Чтобы
        повернуть все значения, удерживайте Alt.</tr>
      </par>
      <a href="hoa/hoa.2d.space-help.pd">CICM documentation</a>
    </info>
    <mouse>
      <event type="drag" editmode="false">change the single amp value</event>
      <event type="drag" editmode="false" keys="Shift">change the all amp values</event>
      <event type="drag" editmode="false" keys="Alt">rotate all values</event>
      <event type="right-click" editmode="false">open popup menu</event>
      <event type="right-click" editmode="false" keys="Shift">open object help</event>
      <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
      <event type="drag" editmode="true" keys="Cmd">change the single amp value</event>
      <event type="right-click" editmode="true" keys="Shift">open object help</event>
      <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
    </mouse>
    <arguments>
      <argument name="N" type="int" minvalue="1">
        <tr lang="en">number of planewave channels</tr>
        <tr lang="ru">число каналов плоских волн</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @background_color -->
      <property name="@background_color" type="list" default="0.93 0.93 0.93 1">
        <tr lang="en">element background color (list of red, green, blue, alpha values in the
        0..1 range)</tr>
        <tr lang="ru">цвет фона элемента (список значений красного, зелёного, синего и альфа в
        диапазоне 0..1)</tr>
      </property>
      <!-- @border_color -->
      <property name="@border_color" type="list" default="0.6 0.6 0.6 1">
        <tr lang="en">border color (list of red, green, blue, alpha values in the 0..1 range)</tr>
        <tr lang="ru">цвет рамки (список значений красного, зелёного, синего и альфа в диапазоне
        0..1)</tr>
      </property>
      <!-- @fontname -->
      <property name="@fontname" type="symbol" default="Helvetica"
      enum="Courier DejaVu Helvetica Monaco Times">
        <tr lang="en">font name</tr>
        <tr lang="ru">имя шрифта</tr>
      </property>
      <!-- @fontsize -->
      <property name="@fontsize" type="int" minvalue="4" maxvalue="100" default="11">
        <tr lang="en">font size</tr>
        <tr lang="ru">размер шрифта</tr>
      </property>
      <!-- @fontslant -->
      <property name="@fontslant" type="symbol" enum="roman italic" default="roman">
        <tr lang="en">font slant</tr>
        <tr lang="ru">наклон шрифта</tr>
      </property>
      <!-- @fontweight -->
      <property name="@fontweight" type="symbol" enum="normal bold" default="normal">
        <tr lang="en">font weight</tr>
        <tr lang="ru">насыщенность шрифта</tr>
      </property>
      <!-- @label -->
      <property name="@label" type="symbol" default="(null)">
        <tr lang="en">label text</tr>
        <tr lang="ru">текст подписи</tr>
      </property>
      <!-- @label_align -->
      <property name="@label_align" type="symbol" enum="left center right" default="left">
        <tr lang="en">label horizontal align</tr>
        <tr lang="ru">горизонтальное выравнивание подписи</tr>
      </property>
      <!-- @label_color -->
      <property name="@label_color" type="list" default="0 0 0 1">
        <tr lang="en">label color in RGB format within the 0..1 range, for example: 0.2 0.4
        0.1</tr>
        <tr lang="ru">цвет подписи в формате RGB в диапазоне 0..1, например: 0.2 0.4 0.1</tr>
      </property>
      <!-- @label_inner -->
      <property name="@label_inner" type="bool" default="0">
        <tr lang="en">label position (1 — inner, 0 — outer)</tr>
        <tr lang="ru">положение подписи (1 — внутри, 0 — снаружи)</tr>
      </property>
      <!-- @label_margins -->
      <property name="@label_margins" type="list" default="0 0">
        <tr lang="en">label offset in pixels</tr>
        <tr lang="ru">смещение подписи в пикселях</tr>
      </property>
      <!-- @label_side -->
      <property name="@label_side" type="symbol" enum="left top right bottom" default="top">
        <tr lang="en">label snap side</tr>
        <tr lang="ru">сторона привязки подписи</tr>
      </property>
      <!-- @label_valign -->
      <property name="@label_valign" type="symbol" enum="top center bottom" default="top">
        <tr lang="en">label vertical align</tr>
        <tr lang="ru">вертикальное выравнивание подписи</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="float" default="1">
        <tr lang="en">maximum amp value</tr>
        <tr lang="ru">максимальное значение амплитуды</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="float" default="0">
        <tr lang="en">minimum amp value</tr>
        <tr lang="ru">минимальное значение амплитуды</tr>
      </property>
      <!-- @nch -->
      <property name="@nch" type="int" minvalue="1" maxvalue="128" default="4">
        <tr lang="en">number of channels</tr>
        <tr lang="ru">число каналов</tr>
      </property>
      <!-- @pinned -->
      <property name="@pinned" type="bool" default="0">
        <tr lang="en">pin mode. If 1 — put element to the lowest level</tr>
        <tr lang="ru">режим закрепления. Если 1 — поместить элемент на самый нижний слой</tr>
      </property>
      <!-- @presetname -->
      <property name="@presetname" type="symbol" category="basic" default="(null)">
        <tr lang="en">preset name for use with [ui.preset]</tr>
        <tr lang="ru">имя пресета для использования с [ui.preset]</tr>
      </property>
      <!-- @pt_color -->
      <property name="@pt_color" type="list" default="0 0 0 1">
        <tr lang="en">point color</tr>
        <tr lang="ru">цвет точки</tr>
      </property>
      <!-- @receive -->
      <property name="@receive" type="symbol" category="basic" default="(null)">
        <tr lang="en">receive source</tr>
        <tr lang="ru">источник приёма</tr>
      </property>
      <!-- @send -->
      <property name="@send" type="symbol" category="basic" default="(null)">
        <tr lang="en">send destination</tr>
        <tr lang="ru">назначение отправки</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="120 120">
        <tr lang="en">element size (width, height pair)</tr>
        <tr lang="ru">размер элемента (пара ширина, высота)</tr>
      </property>
      <!-- @sp_color -->
      <property name="@sp_color" type="list" default="0.27 0.43 0.54 1">
        <tr lang="en">space color</tr>
        <tr lang="ru">цвет пространства</tr>
      </property>
    </properties>
    <methods>
      <!-- clear -->
      <method name="clear" category="preset">
        <info>
          <tr lang="en">clears the specified preset</tr>
          <tr lang="ru">очищает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- dump -->
      <method name="dump">
        <info>
          <tr lang="en">dumps all object info to the Pd console window</tr>
          <tr lang="ru">выводит всю информацию об объекте в окно консоли Pd</tr>
        </info>
      </method>
      <!-- interp -->
      <method name="interp">
        <info>
          <tr lang="en">interpolates between presets</tr>
          <tr lang="ru">интерполирует между пресетами</tr>
        </info>
        <param name="IDX" type="float" required="true">
          <tr lang="en">preset fraction index</tr>
          <tr lang="ru">дробный индекс пресета</tr>
        </param>
      </method>
      <!-- load -->
      <method name="load" category="preset">
        <info>
          <tr lang="en">loads the specified preset</tr>
          <tr lang="ru">загружает указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">sets the UI element position</tr>
          <tr lang="ru">устанавливает положение элемента UI</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top-left x coordinate</tr>
          <tr lang="ru">координата X верхнего левого угла</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top-left y coordinate</tr>
          <tr lang="ru">координата Y верхнего левого угла</tr>
        </param>
      </method>
      <!-- store -->
      <method name="store" category="preset">
        <info>
          <tr lang="en">stores the specified preset</tr>
          <tr lang="ru">сохраняет указанный пресет</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">preset index</tr>
          <tr lang="ru">индекс пресета</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">list: amp values</tr>
          <tr lang="ru">список: значения амплитуды</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">list: amp values</tr>
          <tr lang="ru">список: значения амплитуды</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[hoa.2d.space 8 {0:]
|
|
|
|
|
|
|
|
|
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
