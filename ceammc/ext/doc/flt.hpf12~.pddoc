<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flt.hpf12~">
        <title>flt.hpf12~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">high-pass second order Butterworth filter</tr>
                <tr lang="ru">ФВЧ Баттерворта второго порядка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter highpass</keywords>
            <since>0.1</since>
            <also>
                <see>flt.hpf24~</see>
                <see>flt.lpf12~</see>
                <see>flt.c_hpf~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">A high-pass filter is an electronic filter that passes signals with a
                frequency higher than a certain cutoff frequency and attenuates signals with
                frequencies lower than the cutoff frequency.</tr>
            </par>
            <par>
                <tr lang="en">Butterworth filter is a type of filter designed to have a frequency
                response as flat as possible in the passband.</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Butterworth_filter">wiki: Butterworth filter</a>
        </info>
        <arguments>
            <argument name="FREQ" type="float" minvalue="20" maxvalue="20000" units="hertz">
                <tr lang="en">cutoff frequency</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" units="hertz" minvalue="20" maxvalue="20000"
            default="10000">
                <tr lang="en">cutoff frequency</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset filter state</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">set frequency</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">filtered signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 10] [ui.hsl]
|          |
[click~]   [lin->lin 0 1 500 15000]
|          |
[*~ 100]   [@freq $1(
|          |
[flt.hpf12~ 5000]
|
[ui.spectroscope~ @size 400 120]









[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
