<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.note2guido">
    <title>conv.note2guido</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts MIDI note number to Guido notation</tr>
        <tr lang="ru">преобразует MIDI-номер ноты в нотацию GUIDO</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv guido midi</keywords>
      <since>0.9.5</since>
      <also>
        <see>proto.inscore</see>
      </also>
      <aliases>
        <alias>ceammc/note-&gt;guido</alias>
        <alias>note-&gt;guido</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts a MIDI note number (pitch) with a duration to a note
        written in GUIDO music notation. The result is sent as a symbol from the outlet and can be
        fed to other objects such as [proto.inscore] or score renderers. A pitch value less than 0
        is treated as a rest.</tr>
        <tr lang="ru">Объект преобразует MIDI-номер ноты (высоту) вместе с длительностью в ноту,
        записанную в нотации GUIDO. Результат отправляется из выхода в виде символа и может быть
        подан в другие объекты, например [proto.inscore] или рендереры партитур. Значение высоты
        меньше 0 трактуется как пауза.</tr>
      </par>
    </info>
    <methods>
      <!-- note -->
      <method name="note">
        <param name="PITCH" type="int" required="true">
          <tr lang="en">note pitch (pitch &lt; 0 is treated as a rest)</tr>
          <tr lang="ru">высота ноты (значение &lt; 0 трактуется как пауза)</tr>
        </param>
        <param name="DUR" type="float" required="true">
          <tr lang="en">note duration</tr>
          <tr lang="ru">длительность ноты</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">pitch</tr>
          <tr lang="ru">высота</tr>
        </in>
        <in on="list">
          <tr lang="en">list of pitches</tr>
          <tr lang="ru">список высот</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">symbol: converted value</tr>
          <tr lang="ru">символ: преобразованное значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
[$1( [60 61 62( [note 61 4.5( [note 61 4.25(
|    |          |             |
|    |          |             |
[conv.note2guido              ]
|
[ui.dt]

[conv.note2guido-inscore]
]]>
      </pdascii>
      <pdascii id="inscore">
<![CDATA[
[ui.keyboard]
|
|
|
|
[note $1 4.125(
|
[conv.note2guido]
|
[gmn M \[ $1 \](
|
[proto.inscore     ]
|
[net.osc.send osc.udp://localhost:7000]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
