<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="conv.note2guido">
        <title>conv.note2guido</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">converts MIDI note number to Guido notation</tr>
                <tr lang="ru">преобразует MIDI ноту в Guido-нотацию</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>conv guido midi</keywords>
            <since>0.9.5</since>
            <also>
                <see>proto.inscore</see>
            </also>
            <aliases>
                <alias>ceammc/note-&gt;guido</alias>
                <alias>note-&gt;guido</alias>
            </aliases>
        </meta>
        <methods>
            <!-- note -->
            <method name="note">
                <param name="PITCH" type="int" required="true">
                    <tr lang="en">note pitch (pitch &lt;0 treated as rest)</tr>
                    <tr lang="ru" finished="false">нота шаг (pitch &lt;0 рассматривается как
                    отдых)</tr>
                </param>
                <param name="DUR" type="float" required="true">
                    <tr lang="en">note duration</tr>
                    <tr lang="ru" finished="false">отметка продолжительность</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">pitch</xinfo>
                <xinfo on="list">list of pitches</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>symbol: converted value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
[$1( [60 61 62( [note 61 4.5( [note 61 4.25(
|    |          |             |
|    |          |             |
[conv.note2guido              ]
|
[ui.dt]

[conv.note2guido-inscore]
]]>
            </pdascii>
            <pdascii id="inscore">
<![CDATA[
[ui.keyboard]
|
|
|
|
[note $1 4.125(
|
[conv.note2guido]
|
[gmn M \[ $1 \](
|
[proto.inscore     ]
|
[net.osc.send osc.udp://localhost:7000]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
