<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.readwrite~">
    <title>array.readwrite~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">simultaneous read/write signals to the array</tr>
        <tr lang="ru">одновременное чтение/запись сигналов в массив</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array read write</keywords>
      <since>0.9.7</since>
      <aliases>
        <alias>array.rw~</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object reads a signal from the array and writes a signal into the array
        at the same time. On each audio block it performs the following operations in order: read,
        write, output. The reading index, signal to write, and write index are provided on three
        separate audio inlets. The value read from the array is mixed with the written signal
        according to the @mix property and sent to the audio outlet.</tr>
        <tr lang="ru">Объект одновременно читает сигнал из массива и записывает сигнал в массив. На
        каждом аудиоблоке операции выполняются в следующем порядке: чтение, запись, вывод. Индекс
        чтения, сигнал для записи и индекс записи подаются на три отдельных звуковых входа.
        Считанное из массива значение смешивается с записываемым сигналом в соответствии со
        свойством @mix и отправляется на звуковой выход.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array to read from and write to</tr>
        <tr lang="ru">имя массива для чтения и записи</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array to read from and write to</tr>
        <tr lang="ru">имя массива для чтения и записи</tr>
      </property>
      <!-- @mix -->
      <property name="@mix" type="float" default="0" minvalue="0" maxvalue="1">
        <tr lang="en">mix amount between the read signal and the written signal</tr>
        <tr lang="ru">доля смешивания между считанным и записываемым сигналом</tr>
      </property>
    </properties>
    <methods>
      <!-- redraw -->
      <method name="redraw">
        <info>
          <tr lang="en">redraws the array</tr>
          <tr lang="ru">перерисовывает массив</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">reading index (in samples)</tr>
          <tr lang="ru">индекс чтения (в семплах)</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">signal to write into the array</tr>
          <tr lang="ru">сигнал для записи в массив</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">write index (in samples)</tr>
          <tr lang="ru">индекс записи (в семплах)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">reading output</tr>
          <tr lang="ru">выход чтения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]         [msg.onload symbol %CEAMMC%/guitar1.wav] [array arw 100]
|           |
[openpanel] [expand_env]
|           |
[load $1 to  arw @resize @resample(
|
[snd.file]            [T]
                      |
[phasor~ 0.22]        [metro.random 1000 1500]
|                     |
[expr~ $v1*120000]    [t b b b  #b]
|                     |          ^|
| [r~ arw]            [random.f] [random.i 400 1000]
| |                   |          |.
| |                   [pack f f #a]
| |
| |                   [vline~ #x] [random.i 120000 #c]
| |                   |
| |  [redraw(         [*~ #y]
| |. |                |..
[array.rw~ arw          ]
| |
| [s~ arw]
|
[ui.hgain~]
|\
[dac~]                    [ui.dsp~]

[X a->x] [X b:2->c] [X c->y:1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
