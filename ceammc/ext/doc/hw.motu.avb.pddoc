<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="hw.motu.avb">
        <title>hw.motu.avb</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">controls Motu AVB devices over HTTP requests</tr>
                <tr lang="ru">управление устройствами Motu AVB по HTTP</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>motu avb</keywords>
            <since>0.9.5</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Only basic support at this moment</tr>
            </par>
        </info>
        <arguments>
            <argument name="DEV" type="symbol">
                <tr lang="en">Motu device id</tr>
                <tr lang="ru">идентификатор устройства Motu</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @dev -->
            <property name="@dev" type="symbol" default="">
                <tr lang="en">Motu device id</tr>
                <tr lang="ru">идентификатор устройства Motu</tr>
            </property>
            <!-- @host -->
            <property name="@host" type="symbol" default="localhost">
                <tr lang="en">Motu HTTP host</tr>
                <tr lang="ru">Motu HTTP-хост</tr>
            </property>
            <!-- @port -->
            <property name="@port" type="int" default="1280">
                <tr lang="en">Motu HTTP port</tr>
                <tr lang="ru">Motu HTTP порт</tr>
            </property>
        </properties>
        <methods>
            <!-- comp_input_name -->
            <method name="comp_input_name">set input from computer channel name 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">channel (zero-based)</tr>
            </param>
            <param name="NAME" type="symbol" required="true">
                <tr lang="en">channel name</tr>
            </param></method>
            <!-- guitar->comp -->
            <method name="guitar-&gt;comp">set guitar input to computer routing 
            <param name="INCH" type="int" required="true" minvalue="0">
                <tr lang="en">guitar input channel (zero-based)</tr>
            </param>
            <param name="OUTCH" type="int" required="true" minvalue="0">
                <tr lang="en">computer input channel (zero-based)</tr>
            </param>
            <param name="STATE" type="int" required="true" enum="0 1">
                <tr lang="en">enable/disable routing</tr>
            </param></method>
            <!-- guitar->mix -->
            <method name="guitar-&gt;mix">set guitar input to mixer routing 
            <param name="INCH" type="int" required="true" minvalue="0">
                <tr lang="en">guitar input channel (zero-based)</tr>
            </param>
            <param name="OUTCH" type="int" required="true" minvalue="0">
                <tr lang="en">mixer input channel (zero-based)</tr>
            </param>
            <param name="STATE" type="int" required="true" enum="0 1">
                <tr lang="en">enable/disable routing</tr>
            </param></method>
            <!-- guitar->output -->
            <method name="guitar-&gt;output">set guitar input to analogue output routing 
            <param name="INCH" type="int" required="true" minvalue="0">
                <tr lang="en">guitar input channel (zero-based)</tr>
            </param>
            <param name="OUTCH" type="int" required="true" minvalue="0">
                <tr lang="en">analogue output channel (zero-based)</tr>
            </param>
            <param name="STATE" type="int" required="true" enum="0 1">
                <tr lang="en">enable/disable routing</tr>
            </param></method>
            <!-- guitar_gain -->
            <method name="guitar_gain">set guitar gain 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">guitar channel (zero-based)</tr>
            </param>
            <param name="DB" type="float" units="decibel" required="true" minvalue="0"
            maxvalue="60">
                <tr lang="en">value in decibel</tr>
            </param></method>
            <!-- guitar_name -->
            <method name="guitar_name">set guitar channel name 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">channel (zero-based)</tr>
            </param>
            <param name="NAME" type="symbol" required="true">
                <tr lang="en">channel name</tr>
            </param></method>
            <!-- guitar_phase -->
            <method name="guitar_phase">set guitar phase invert 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">guitar channel (zero-based)</tr>
            </param>
            <param name="VAL" type="int" required="true" enum="0 1">
                <tr lang="en">state</tr>
            </param></method>
            <!-- input->comp -->
            <method name="input-&gt;comp">set analogue input to computer routing 
            <param name="INCH" type="int" required="true" minvalue="0">
                <tr lang="en">analogue input channel (zero-based)</tr>
            </param>
            <param name="OUTCH" type="int" required="true" minvalue="0">
                <tr lang="en">computer input channel (zero-based)</tr>
            </param>
            <param name="STATE" type="int" required="true" enum="0 1">
                <tr lang="en">enable/disable routing</tr>
            </param></method>
            <!-- input->mix -->
            <method name="input-&gt;mix">set analogue input to mixer routing 
            <param name="INCH" type="int" required="true" minvalue="0">
                <tr lang="en">analogue input channel (zero-based)</tr>
            </param>
            <param name="OUTCH" type="int" required="true" minvalue="0">
                <tr lang="en">mixer input channel (zero-based)</tr>
            </param>
            <param name="STATE" type="int" required="true" enum="0 1">
                <tr lang="en">enable/disable routing</tr>
            </param></method>
            <!-- input->output -->
            <method name="input-&gt;output">set analogue input to analog output routing 
            <param name="INCH" type="int" required="true" minvalue="0">
                <tr lang="en">analogue input channel (zero-based)</tr>
            </param>
            <param name="OUTCH" type="int" required="true" minvalue="0">
                <tr lang="en">analogue output channel (zero-based)</tr>
            </param>
            <param name="STATE" type="int" required="true" enum="0 1">
                <tr lang="en">enable/disable routing</tr>
            </param></method>
            <!-- input_gain -->
            <method name="input_gain">set input gain 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">input channel (zero-based)</tr>
            </param>
            <param name="DB" type="float" units="decibel" required="true">
                <tr lang="en">value in decibel</tr>
            </param></method>
            <!-- input_name -->
            <method name="input_name">set analogue input channel name 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">channel (zero-based)</tr>
            </param>
            <param name="NAME" type="symbol" required="true">
                <tr lang="en">channel name</tr>
            </param></method>
            <!-- main_gain -->
            <method name="main_gain">set main output gain 
            <param name="DB" type="float" units="decibel" required="true" minvalue="-127"
            maxvalue="0">
                <tr lang="en">value in decibel</tr>
            </param></method>
            <!-- mic->comp -->
            <method name="mic-&gt;comp">set microphone input to computer routing 
            <param name="INCH" type="int" required="true" minvalue="0">
                <tr lang="en">microphone input channel (zero-based)</tr>
            </param>
            <param name="OUTCH" type="int" required="true" minvalue="0">
                <tr lang="en">computer channel (zero-based)</tr>
            </param>
            <param name="STATE" type="int" required="true" enum="0 1">
                <tr lang="en">enable/disable routing</tr>
            </param></method>
            <!-- mic->mix -->
            <method name="mic-&gt;mix">set microphone input to mixer routing 
            <param name="INCH" type="int" required="true" minvalue="0">
                <tr lang="en">microphone input channel (zero-based)</tr>
            </param>
            <param name="OUTCH" type="int" required="true" minvalue="0">
                <tr lang="en">mixer input channel (zero-based)</tr>
            </param>
            <param name="STATE" type="int" required="true" enum="0 1">
                <tr lang="en">enable/disable routing</tr>
            </param></method>
            <!-- mic->output -->
            <method name="mic-&gt;output">set microphone input to analog output routing 
            <param name="INCH" type="int" required="true" minvalue="0">
                <tr lang="en">microphone input channel (zero-based)</tr>
            </param>
            <param name="OUTCH" type="int" required="true" minvalue="0">
                <tr lang="en">analogue output channel (zero-based)</tr>
            </param>
            <param name="STATE" type="int" required="true" enum="0 1">
                <tr lang="en">enable/disable routing</tr>
            </param></method>
            <!-- mic_gain -->
            <method name="mic_gain">set mic gain 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">mic channel (zero-based)</tr>
            </param>
            <param name="DB" type="float" units="decibel" required="true" minvalue="0"
            maxvalue="60">
                <tr lang="en">value in decibel</tr>
            </param></method>
            <!-- mic_name -->
            <method name="mic_name">set microphone channel name 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">channel (zero-based)</tr>
            </param>
            <param name="NAME" type="symbol" required="true">
                <tr lang="en">channel name</tr>
            </param></method>
            <!-- mic_pad -->
            <method name="mic_pad">set mic -20db padding 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">mic channel (zero-based)</tr>
            </param>
            <param name="VAL" type="int" required="true" enum="0 1">
                <tr lang="en">state</tr>
            </param></method>
            <!-- mic_phase -->
            <method name="mic_phase">set mic phase invert 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">mic channel (zero-based)</tr>
            </param>
            <param name="VAL" type="int" required="true" enum="0 1">
                <tr lang="en">state</tr>
            </param></method>
            <!-- output_gain -->
            <method name="output_gain">set input gain 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">input channel (zero-based)</tr>
            </param>
            <param name="DB" type="float" units="decibel" required="true">
                <tr lang="en">value in decibel</tr>
            </param></method>
            <!-- phantom -->
            <method name="phantom">turns phantom on/off 
            <param name="CHAN" type="int" required="true" minvalue="0">
                <tr lang="en">phantom channel</tr>
            </param>
            <param name="VAL" type="int" required="true" enum="0 1">
                <tr lang="en">phantom state</tr>
            </param></method>
            <!-- phones_gain -->
            <method name="phones_gain">set phones output gain 
            <param name="DB" type="float" units="decibel" required="true" minvalue="-127"
            maxvalue="0">
                <tr lang="en">value in decibel</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>properties output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
/*Enter device ID*/

[S digits=20]
|
[@dev $1( [@dev 0001f2fffe00XXXX #a(
|
|  [T]            [ui.hsl -60 0 @show_value 1]
|  |              |
|  [phantom 0 $1( [main_gain $1(
|  |              |
|  |              |
[hw.motu.avb      #z]
[X a->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
