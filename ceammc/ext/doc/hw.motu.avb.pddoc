<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.motu.avb">
    <title>hw.motu.avb</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">controls Motu AVB devices over HTTP requests</tr>
        <tr lang="ru">управление устройствами MOTU AVB через HTTP-запросы</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>motu avb</keywords>
      <since>0.9.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Note: only basic support is available at this moment.</tr>
        <tr lang="ru">Примечание: в настоящее время доступна только базовая поддержка.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Remote control of an AVB audio interface — changing gain, phantom power,
        routing and channel names on a MOTU AVB device from a Pd patch, without using the web
        interface.</tr>
        <tr lang="ru">• Удалённое управление аудиоинтерфейсом AVB — изменение усиления, фантомного
        питания, маршрутизации и имён каналов на устройстве MOTU AVB из патча Pd, без использования
        веб-интерфейса.</tr>
      </par>
    </info>
    <arguments>
      <argument name="DEV" type="symbol">
        <tr lang="en">MOTU device ID</tr>
        <tr lang="ru">идентификатор устройства MOTU</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @dev -->
      <property name="@dev" type="symbol" default="">
        <tr lang="en">MOTU device ID</tr>
        <tr lang="ru">идентификатор устройства MOTU</tr>
      </property>
      <!-- @host -->
      <property name="@host" type="symbol" default="localhost">
        <tr lang="en">MOTU HTTP host</tr>
        <tr lang="ru">HTTP-хост MOTU</tr>
      </property>
      <!-- @port -->
      <property name="@port" type="int" default="1280">
        <tr lang="en">MOTU HTTP port</tr>
        <tr lang="ru">HTTP-порт MOTU</tr>
      </property>
    </properties>
    <methods>
      <!-- comp_input_name -->
      <method name="comp_input_name">
        <info>
          <tr lang="en">sets the input from computer channel name</tr>
          <tr lang="ru">устанавливает имя входного канала со стороны компьютера</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">channel (zero-based)</tr>
          <tr lang="ru">канал (нумерация с нуля)</tr>
        </param>
        <param name="NAME" type="symbol" required="true">
          <tr lang="en">channel name</tr>
          <tr lang="ru">имя канала</tr>
        </param>
      </method>
      <!-- guitar->comp -->
      <method name="guitar-&gt;comp">
        <info>
          <tr lang="en">sets guitar input to computer routing</tr>
          <tr lang="ru">устанавливает маршрутизацию гитарного входа на компьютер</tr>
        </info>
        <param name="INCH" type="int" required="true" minvalue="0">
          <tr lang="en">guitar input channel (zero-based)</tr>
          <tr lang="ru">гитарный входной канал (нумерация с нуля)</tr>
        </param>
        <param name="OUTCH" type="int" required="true" minvalue="0">
          <tr lang="en">computer input channel (zero-based)</tr>
          <tr lang="ru">входной канал компьютера (нумерация с нуля)</tr>
        </param>
        <param name="STATE" type="int" required="true" enum="0 1">
          <tr lang="en">enable/disable routing</tr>
          <tr lang="ru">включить или отключить маршрутизацию</tr>
        </param>
      </method>
      <!-- guitar->mix -->
      <method name="guitar-&gt;mix">
        <info>
          <tr lang="en">sets guitar input to mixer routing</tr>
          <tr lang="ru">устанавливает маршрутизацию гитарного входа на микшер</tr>
        </info>
        <param name="INCH" type="int" required="true" minvalue="0">
          <tr lang="en">guitar input channel (zero-based)</tr>
          <tr lang="ru">гитарный входной канал (нумерация с нуля)</tr>
        </param>
        <param name="OUTCH" type="int" required="true" minvalue="0">
          <tr lang="en">mixer input channel (zero-based)</tr>
          <tr lang="ru">входной канал микшера (нумерация с нуля)</tr>
        </param>
        <param name="STATE" type="int" required="true" enum="0 1">
          <tr lang="en">enable/disable routing</tr>
          <tr lang="ru">включить или отключить маршрутизацию</tr>
        </param>
      </method>
      <!-- guitar->output -->
      <method name="guitar-&gt;output">
        <info>
          <tr lang="en">sets guitar input to analogue output routing</tr>
          <tr lang="ru">устанавливает маршрутизацию гитарного входа на аналоговый выход</tr>
        </info>
        <param name="INCH" type="int" required="true" minvalue="0">
          <tr lang="en">guitar input channel (zero-based)</tr>
          <tr lang="ru">гитарный входной канал (нумерация с нуля)</tr>
        </param>
        <param name="OUTCH" type="int" required="true" minvalue="0">
          <tr lang="en">analogue output channel (zero-based)</tr>
          <tr lang="ru">аналоговый выходной канал (нумерация с нуля)</tr>
        </param>
        <param name="STATE" type="int" required="true" enum="0 1">
          <tr lang="en">enable/disable routing</tr>
          <tr lang="ru">включить или отключить маршрутизацию</tr>
        </param>
      </method>
      <!-- guitar_gain -->
      <method name="guitar_gain">
        <info>
          <tr lang="en">sets guitar gain</tr>
          <tr lang="ru">устанавливает усиление гитары</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">guitar channel (zero-based)</tr>
          <tr lang="ru">гитарный канал (нумерация с нуля)</tr>
        </param>
        <param name="DB" type="float" units="decibel" required="true" minvalue="0" maxvalue="60">
          <tr lang="en">value in decibels</tr>
          <tr lang="ru">значение в децибелах</tr>
        </param>
      </method>
      <!-- guitar_name -->
      <method name="guitar_name">
        <info>
          <tr lang="en">sets guitar channel name</tr>
          <tr lang="ru">устанавливает имя гитарного канала</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">channel (zero-based)</tr>
          <tr lang="ru">канал (нумерация с нуля)</tr>
        </param>
        <param name="NAME" type="symbol" required="true">
          <tr lang="en">channel name</tr>
          <tr lang="ru">имя канала</tr>
        </param>
      </method>
      <!-- guitar_phase -->
      <method name="guitar_phase">
        <info>
          <tr lang="en">sets guitar phase invert</tr>
          <tr lang="ru">устанавливает инверсию фазы гитары</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">guitar channel (zero-based)</tr>
          <tr lang="ru">гитарный канал (нумерация с нуля)</tr>
        </param>
        <param name="VAL" type="int" required="true" enum="0 1">
          <tr lang="en">state</tr>
          <tr lang="ru">состояние</tr>
        </param>
      </method>
      <!-- input->comp -->
      <method name="input-&gt;comp">
        <info>
          <tr lang="en">sets analogue input to computer routing</tr>
          <tr lang="ru">устанавливает маршрутизацию аналогового входа на компьютер</tr>
        </info>
        <param name="INCH" type="int" required="true" minvalue="0">
          <tr lang="en">analogue input channel (zero-based)</tr>
          <tr lang="ru">аналоговый входной канал (нумерация с нуля)</tr>
        </param>
        <param name="OUTCH" type="int" required="true" minvalue="0">
          <tr lang="en">computer input channel (zero-based)</tr>
          <tr lang="ru">входной канал компьютера (нумерация с нуля)</tr>
        </param>
        <param name="STATE" type="int" required="true" enum="0 1">
          <tr lang="en">enable/disable routing</tr>
          <tr lang="ru">включить или отключить маршрутизацию</tr>
        </param>
      </method>
      <!-- input->mix -->
      <method name="input-&gt;mix">
        <info>
          <tr lang="en">sets analogue input to mixer routing</tr>
          <tr lang="ru">устанавливает маршрутизацию аналогового входа на микшер</tr>
        </info>
        <param name="INCH" type="int" required="true" minvalue="0">
          <tr lang="en">analogue input channel (zero-based)</tr>
          <tr lang="ru">аналоговый входной канал (нумерация с нуля)</tr>
        </param>
        <param name="OUTCH" type="int" required="true" minvalue="0">
          <tr lang="en">mixer input channel (zero-based)</tr>
          <tr lang="ru">входной канал микшера (нумерация с нуля)</tr>
        </param>
        <param name="STATE" type="int" required="true" enum="0 1">
          <tr lang="en">enable/disable routing</tr>
          <tr lang="ru">включить или отключить маршрутизацию</tr>
        </param>
      </method>
      <!-- input->output -->
      <method name="input-&gt;output">
        <info>
          <tr lang="en">sets analogue input to analogue output routing</tr>
          <tr lang="ru">устанавливает маршрутизацию аналогового входа на аналоговый выход</tr>
        </info>
        <param name="INCH" type="int" required="true" minvalue="0">
          <tr lang="en">analogue input channel (zero-based)</tr>
          <tr lang="ru">аналоговый входной канал (нумерация с нуля)</tr>
        </param>
        <param name="OUTCH" type="int" required="true" minvalue="0">
          <tr lang="en">analogue output channel (zero-based)</tr>
          <tr lang="ru">аналоговый выходной канал (нумерация с нуля)</tr>
        </param>
        <param name="STATE" type="int" required="true" enum="0 1">
          <tr lang="en">enable/disable routing</tr>
          <tr lang="ru">включить или отключить маршрутизацию</tr>
        </param>
      </method>
      <!-- input_gain -->
      <method name="input_gain">
        <info>
          <tr lang="en">sets input gain</tr>
          <tr lang="ru">устанавливает усиление входа</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">input channel (zero-based)</tr>
          <tr lang="ru">входной канал (нумерация с нуля)</tr>
        </param>
        <param name="DB" type="float" units="decibel" required="true">
          <tr lang="en">value in decibels</tr>
          <tr lang="ru">значение в децибелах</tr>
        </param>
      </method>
      <!-- input_name -->
      <method name="input_name">
        <info>
          <tr lang="en">sets analogue input channel name</tr>
          <tr lang="ru">устанавливает имя аналогового входного канала</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">channel (zero-based)</tr>
          <tr lang="ru">канал (нумерация с нуля)</tr>
        </param>
        <param name="NAME" type="symbol" required="true">
          <tr lang="en">channel name</tr>
          <tr lang="ru">имя канала</tr>
        </param>
      </method>
      <!-- main_gain -->
      <method name="main_gain">
        <info>
          <tr lang="en">sets main output gain</tr>
          <tr lang="ru">устанавливает усиление основного выхода</tr>
        </info>
        <param name="DB" type="float" units="decibel" required="true" minvalue="-127" maxvalue="0">
          <tr lang="en">value in decibels</tr>
          <tr lang="ru">значение в децибелах</tr>
        </param>
      </method>
      <!-- mic->comp -->
      <method name="mic-&gt;comp">
        <info>
          <tr lang="en">sets microphone input to computer routing</tr>
          <tr lang="ru">устанавливает маршрутизацию микрофонного входа на компьютер</tr>
        </info>
        <param name="INCH" type="int" required="true" minvalue="0">
          <tr lang="en">microphone input channel (zero-based)</tr>
          <tr lang="ru">входной канал микрофона (нумерация с нуля)</tr>
        </param>
        <param name="OUTCH" type="int" required="true" minvalue="0">
          <tr lang="en">computer channel (zero-based)</tr>
          <tr lang="ru">канал компьютера (нумерация с нуля)</tr>
        </param>
        <param name="STATE" type="int" required="true" enum="0 1">
          <tr lang="en">enable/disable routing</tr>
          <tr lang="ru">включить или отключить маршрутизацию</tr>
        </param>
      </method>
      <!-- mic->mix -->
      <method name="mic-&gt;mix">
        <info>
          <tr lang="en">sets microphone input to mixer routing</tr>
          <tr lang="ru">устанавливает маршрутизацию микрофонного входа на микшер</tr>
        </info>
        <param name="INCH" type="int" required="true" minvalue="0">
          <tr lang="en">microphone input channel (zero-based)</tr>
          <tr lang="ru">входной канал микрофона (нумерация с нуля)</tr>
        </param>
        <param name="OUTCH" type="int" required="true" minvalue="0">
          <tr lang="en">mixer input channel (zero-based)</tr>
          <tr lang="ru">входной канал микшера (нумерация с нуля)</tr>
        </param>
        <param name="STATE" type="int" required="true" enum="0 1">
          <tr lang="en">enable/disable routing</tr>
          <tr lang="ru">включить или отключить маршрутизацию</tr>
        </param>
      </method>
      <!-- mic->output -->
      <method name="mic-&gt;output">
        <info>
          <tr lang="en">sets microphone input to analogue output routing</tr>
          <tr lang="ru">устанавливает маршрутизацию микрофонного входа на аналоговый выход</tr>
        </info>
        <param name="INCH" type="int" required="true" minvalue="0">
          <tr lang="en">microphone input channel (zero-based)</tr>
          <tr lang="ru">входной канал микрофона (нумерация с нуля)</tr>
        </param>
        <param name="OUTCH" type="int" required="true" minvalue="0">
          <tr lang="en">analogue output channel (zero-based)</tr>
          <tr lang="ru">аналоговый выходной канал (нумерация с нуля)</tr>
        </param>
        <param name="STATE" type="int" required="true" enum="0 1">
          <tr lang="en">enable/disable routing</tr>
          <tr lang="ru">включить или отключить маршрутизацию</tr>
        </param>
      </method>
      <!-- mic_gain -->
      <method name="mic_gain">
        <info>
          <tr lang="en">sets microphone gain</tr>
          <tr lang="ru">устанавливает усиление микрофона</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">microphone channel (zero-based)</tr>
          <tr lang="ru">канал микрофона (нумерация с нуля)</tr>
        </param>
        <param name="DB" type="float" units="decibel" required="true" minvalue="0" maxvalue="60">
          <tr lang="en">value in decibels</tr>
          <tr lang="ru">значение в децибелах</tr>
        </param>
      </method>
      <!-- mic_name -->
      <method name="mic_name">
        <info>
          <tr lang="en">sets microphone channel name</tr>
          <tr lang="ru">устанавливает имя микрофонного канала</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">channel (zero-based)</tr>
          <tr lang="ru">канал (нумерация с нуля)</tr>
        </param>
        <param name="NAME" type="symbol" required="true">
          <tr lang="en">channel name</tr>
          <tr lang="ru">имя канала</tr>
        </param>
      </method>
      <!-- mic_pad -->
      <method name="mic_pad">
        <info>
          <tr lang="en">sets microphone −20 dB padding</tr>
          <tr lang="ru">включает ослабление микрофона −20 дБ</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">microphone channel (zero-based)</tr>
          <tr lang="ru">канал микрофона (нумерация с нуля)</tr>
        </param>
        <param name="VAL" type="int" required="true" enum="0 1">
          <tr lang="en">state</tr>
          <tr lang="ru">состояние</tr>
        </param>
      </method>
      <!-- mic_phase -->
      <method name="mic_phase">
        <info>
          <tr lang="en">sets microphone phase invert</tr>
          <tr lang="ru">устанавливает инверсию фазы микрофона</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">microphone channel (zero-based)</tr>
          <tr lang="ru">канал микрофона (нумерация с нуля)</tr>
        </param>
        <param name="VAL" type="int" required="true" enum="0 1">
          <tr lang="en">state</tr>
          <tr lang="ru">состояние</tr>
        </param>
      </method>
      <!-- output_gain -->
      <method name="output_gain">
        <info>
          <tr lang="en">sets output gain</tr>
          <tr lang="ru">устанавливает усиление выхода</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">output channel (zero-based)</tr>
          <tr lang="ru">выходной канал (нумерация с нуля)</tr>
        </param>
        <param name="DB" type="float" units="decibel" required="true">
          <tr lang="en">value in decibels</tr>
          <tr lang="ru">значение в децибелах</tr>
        </param>
      </method>
      <!-- phantom -->
      <method name="phantom">
        <info>
          <tr lang="en">turns phantom power on or off</tr>
          <tr lang="ru">включает или выключает фантомное питание</tr>
        </info>
        <param name="CHAN" type="int" required="true" minvalue="0">
          <tr lang="en">phantom channel</tr>
          <tr lang="ru">канал фантомного питания</tr>
        </param>
        <param name="VAL" type="int" required="true" enum="0 1">
          <tr lang="en">phantom state</tr>
          <tr lang="ru">состояние фантомного питания</tr>
        </param>
      </method>
      <!-- phones_gain -->
      <method name="phones_gain">
        <info>
          <tr lang="en">sets phones output gain</tr>
          <tr lang="ru">устанавливает усиление выхода на наушники</tr>
        </info>
        <param name="DB" type="float" units="decibel" required="true" minvalue="-127" maxvalue="0">
          <tr lang="en">value in decibels</tr>
          <tr lang="ru">значение в децибелах</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input</tr>
          <tr lang="ru">вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">properties output</tr>
          <tr lang="ru">вывод свойств</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*Enter device ID*/

[S digits=20]
|
[@dev $1( [@dev 0001f2fffe00XXXX #a(
|
|  [T]            [ui.hsl -60 0 @show_value 1]
|  |              |
|  [phantom 0 $1( [main_gain $1(
|  |              |
|  |              |
[hw.motu.avb      #z]
[X a->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
