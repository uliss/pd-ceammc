<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="route.bang">
    <title>route.bang</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">separates the bang messages from others</tr>
        <tr lang="ru">отделяет bang от сообщений других типов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>route bang</keywords>
      <since>0.9.6</since>
      <aliases>
        <alias>route.b</alias>
      </aliases>
      <also>
        <see>route.float</see>
        <see>route.random</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes bang messages to the first outlet and all other messages (floats, symbols, lists, any) to the second outlet</tr>
        <tr lang="ru">объект направляет bang на первый выход, а все остальные сообщения (числа, символы, списки, any) — на второй выход</tr>
      </par>
      <par>
        <tr lang="en">by default an empty list is treated as a bang. Set @strict to true to disable this behavior and route empty lists to the second outlet</tr>
        <tr lang="ru">по умолчанию пустой список рассматривается как bang. Установите @strict в true, чтобы отключить это поведение и направлять пустые списки на второй выход</tr>
      </par>
      <par>
        <tr lang="en">to get properties, use the [prop.get] object, since all messages (including property requests) are passed through</tr>
        <tr lang="ru">для получения свойств используйте объект [prop.get], так как все сообщения (включая запросы свойств) проходят насквозь</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to separate bangs from other messages, for example to trigger an action only on a bang and ignore floats or symbols</tr>
        <tr lang="ru">объект можно использовать для отделения bang от других сообщений, например чтобы запускать действие только по bang и игнорировать числа или символы</tr>
      </par>
    </info>
    <properties>
      <!-- @strict -->
      <property name="@strict" type="bool" default="0">
        <tr lang="en">strict mode. By default an empty list is treated as a bang. Set to true to disable this behavior</tr>
        <tr lang="ru">строгий режим. По умолчанию пустой список рассматривается как bang. Установите true, чтобы отключить это поведение</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="any">
          <tr lang="en">any message to the second outlet</tr>
          <tr lang="ru">сообщение any на второй выход</tr>
        </in>
        <in on="bang">
          <tr lang="en">bang to the first outlet</tr>
          <tr lang="ru">bang на первый выход</tr>
        </in>
        <in on="float">
          <tr lang="en">float to the second outlet</tr>
          <tr lang="ru">число на второй выход</tr>
        </in>
        <in on="list">
          <tr lang="en">list to the second outlet. See the @strict property for more info.</tr>
          <tr lang="ru">список на второй выход. См. свойство @strict для получения дополнительной информации</tr>
        </in>
        <in on="symbol">
          <tr lang="en">symbol to the second outlet</tr>
          <tr lang="ru">символ на второй выход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="bang">
          <tr lang="en">bang output</tr>
          <tr lang="ru">выход bang</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">other messages</tr>
          <tr lang="ru">другие сообщения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]  [bang( [symbol ABC #a(
|    |
|    |   [list 1 2 3(   [T]
|    |   |              |
|    |   |  [list(      [prop.set @strict]
|    |   |  |           |
|    |   |  | [@any(    |
|    |   |  | |         |
[route.bang           #z]
|       ^|
[ui.dt]  |
         |
         [ui.dt]

[X a->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
