<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="seq.counter">
    <title>seq.counter</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">cyclic counter</tr>
        <tr lang="ru">циклический счётчик</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>seq</category>
      <keywords>counter modulo</keywords>
      <since>0.9.1</since>
    </meta>
    <arguments>
      <argument name="FROM" type="int">
        <tr lang="en">start value</tr>
        <tr lang="ru">начальное значение</tr>
      </argument>
      <argument name="TO" type="int">
        <tr lang="en">end value</tr>
        <tr lang="ru">конечное значение</tr>
      </argument>
      <argument name="R" type="int" minvalue="-1">
        <tr lang="en">number of repeats</tr>
        <tr lang="ru">количество повторений</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @fold -->
      <property name="@fold" type="alias">
        <tr lang="en">the alias to @mode fold</tr>
        <tr lang="ru">сокращение: @mode fold</tr>
      </property>
      <!-- @from -->
      <property name="@from" type="int" default="0">
        <tr lang="en">the start value. Setting this property resets @i to 0</tr>
        <tr lang="ru">начальное значение. Установка этого свойства сбрасывает @i до 0</tr>
      </property>
      <!-- @i -->
      <property name="@i" type="int" default="0">
        <tr lang="en">current iteration index within the cycle</tr>
        <tr lang="ru">индекс текущей итерации внутри цикла</tr>
      </property>
      <!-- @inf -->
      <property name="@inf" type="alias">
        <tr lang="en">alias to @r -1, repeats infinitely</tr>
        <tr lang="ru">сокращение: @r -1, повторять бесконечно</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" enum="wrap fold" default="wrap">
        <tr lang="en">counter repeat mode. If 'wrap': after reaching the final value, it starts a
        new count from the initial value. If 'fold': after reaching the final value, it starts
        counting in the opposite direction.</tr>
        <tr lang="ru">режим повтора счетчика. Если 'wrap': после достижения финального значения,
        начинает новый счет с начального значения. Если 'fold': после достижения финального
        значения, начинает счет в обратном направлении.</tr>
      </property>
      <!-- @once -->
      <property name="@once" type="alias">
        <tr lang="en">alias to @r 1, one pass with no repeats</tr>
        <tr lang="ru">сокращение: @r 1, один проход без повторов</tr>
      </property>
      <!-- @r -->
      <property name="@r" type="int" default="-1" minvalue="-1">
        <tr lang="en">the number of repeats. If -1: to repeat infinitely.</tr>
        <tr lang="ru">количество повторений. Если -1: повторять бесконечно.</tr>
      </property>
      <!-- @ri -->
      <property name="@ri" type="int" access="readonly" default="0">
        <tr lang="en">cycle repetition number</tr>
        <tr lang="ru">номер повтора всего цикла</tr>
      </property>
      <!-- @to -->
      <property name="@to" type="int" default="0">
        <tr lang="en">end value (inclusive)</tr>
        <tr lang="ru">конечное значение (включительно)</tr>
      </property>
      <!-- @value -->
      <property name="@value" type="int" default="0" access="readonly">
        <tr lang="en">current counter value</tr>
        <tr lang="ru">текущее значение счетчика</tr>
      </property>
      <!-- @wrap -->
      <property name="@wrap" type="alias">
        <tr lang="en">alias to @mode wrap</tr>
        <tr lang="ru">сокращение: @mode wrap</tr>
      </property>
    </properties>
    <methods>
      <!-- next -->
      <method name="next">
        <info>
          <tr lang="en">first increments the counter, then outputs the resulting next value</tr>
          <tr lang="ru">сначала увеличивает счетчик, потом выводит полученное новое значение</tr>
        </info>
      </method>
      <!-- prev -->
      <method name="prev">
        <info>
          <tr lang="en">first decrements the counter, then outputs the resulting value</tr>
          <tr lang="ru">сначала уменьшает счётчик, затем выводит полученное новое значение</tr>
        </info>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset the counter to the start value and reset a repeat counter to 0</tr>
          <tr lang="ru">сбросить счётчик до начального значения и сбросить счётчик повторов на
          0</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">first outputs the current value, then increments the counter</tr>
          <tr lang="ru">сначала выводит текущее значение, затем увеличивает счетчик</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">reset the counter to the start value</tr>
          <tr lang="ru">сбросить счетчик на начальное значение</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">the counter value</tr>
          <tr lang="ru">значение счетчика</tr>
        </out>
      </outlet>
      <outlet>
        <out type="int">
          <tr lang="en">number of full counter cycles</tr>
          <tr lang="ru">число повторов полного цикла счетчика</tr>
        </out>
        <out type="any">
          <tr lang="en">[done (after the last repetition (if there is a limited number of
          them)</tr>
          <tr lang="ru">[done( после последнего повтора (если их ограниченное количество)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]   [prev( [next(
|     |      |
[seq.counter 1 4]
|
[ui.dt]

[B]            [B]
|              |.
[seq.counter 1 4 @r 2]/*repeat two times*/
|              ^|
[F]            [ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
