<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.reverse">
        <title>list.reverse</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">reverses the order of the elements in the list</tr>
                <tr lang="ru">меняет порядок элементов в списке на обратный</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list reverse</keywords>
            <since>0.1</since>
            <also>
                <see>list.sort</see>
                <see>list.shuffle</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                    <tr lang="ru" finished="false">вводный список</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                    <tr lang="ru" finished="false">входной млечный</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">reversed list</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 4 5(  [list a b c d e( [\(5 4 3 2 1\), bang(
|            |                |
|            |                [ml]
|            |                |
[list.reverse                 ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
