<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="list.reverse">
    <title>list.reverse</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">reverses the order of the elements in the list</tr>
        <tr lang="ru">меняет порядок элементов в списке на обратный</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>list</category>
      <keywords>list reverse</keywords>
      <since>0.1</since>
      <also>
        <see>list.sort</see>
        <see>list.shuffle</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object outputs a new list with the elements in reverse order: the last
        element becomes the first, the first becomes the last, and so on</tr>
        <tr lang="ru">объект выводит новый список с элементами в обратном порядке: последний
        элемент становится первым, первый — последним и так далее</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to reverse the direction of a sequence, for example to
        play a list of notes backwards or to change the order of processing steps</tr>
        <tr lang="ru">объект можно использовать для изменения направления последовательности,
        например чтобы проиграть список нот в обратном порядке или изменить порядок шагов
        обработки</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">input list</tr>
          <tr lang="ru">входной список</tr>
        </in>
        <in on="data:mlist">
          <tr lang="en">input MList</tr>
          <tr lang="ru">входной MList</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">reversed list</tr>
          <tr lang="ru">список в обратном порядке</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[1 2 3 4 5(  [list a b c d e( [\(5 4 3 2 1\), bang(
|            |                |
|            |                [ml]
|            |                |
[list.reverse                 ]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
