<?xml version='1.0' encoding='utf-8'?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="hw.rpi.display.ssd1306">
        <title>hw.rpi.display.ssd1306</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>OLED ssd1306 display for Raspberry Pi</description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display ssd1306 spi i2c rpi</keywords>
            <since>0.9.8</since>
        </meta>
        <info>
            <par>Both I2C and SPI connections are supported</par>
            <par>Note! you should send [flush( message to transfer internal pixel buffer to the
            device</par>
        </info>
        <methods>
            <!-- rotation -->
            <method name="rotation">set display rotation 
            <param name="ANGLE" type="int" enum="0 90 180 270">rotation angle</param></method>
            <!-- invert -->
            <method name="invert">invert display 
            <param name="VALUE" type="bool" required="true">value</param></method>
            <!-- mirror -->
            <method name="mirror">mirror display 
            <param name="VALUE" type="bool" required="true">value</param></method>
            <!-- font -->
            <method name="font">set current font 
            <param name="FONT" type="symbol" required="true">font name</param></method>
            <method name="write">method</method>
            <!-- clear -->
            <method name="clear">clear display and optionally flush internal buffer 
            <param name="FLUSH" type="bool" default="0" required="false">flush internal buffer to
            the device</param></method>
            <!-- brightness -->
            <method name="brightness">set display brightness 
            <param name="LEVEL" type="int" enum="0 1 2 3 4" required="true">brightness level from 0
            (lowest) to 4 (brightest). Normal level is 2.</param></method>
            <!-- switch_on -->
            <method name="switch_on">switch on display (needed for SPI connection) 
            <param name="VALUE" type="bool" required="true">value</param></method>
            <!-- flush -->
            <method name="flush">flush internal buffer to the device</method>
            <!-- text -->
            <method name="text">draw text on the display 
            <param name="FONT" type="symbol" required="true">font name</param>
            <param name="X" type="int" required="true">X coordinate</param>
            <param name="Y" type="int" required="true">Y coordinate</param></method>
            <!-- pixel -->
            <method name="pixel">draw pixel 
            <param name="X" type="int" minvalue="0" required="true">X coord (from the left)</param>
            <param name="Y" type="int" minvalue="0" required="true">Y coord (from the top)</param>
            <param name="VALUE" type="bool" required="true">pixel value</param></method>
        </methods>
        <arguments>
            <argument name="MODE" type="symbol" enum="i2c spi">display connection. See
            @mode</argument>
        </arguments>
        <properties>
            <property name="@mode" type="symbol" default="i2c" enum="i2c spi" access="initonly">
            display connection</property>
            <property name="@size" type="list" default="128 64" access="initonly">display
            size</property>
            <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none"
            access="initonly">I²C bus</property>
            <property name="@i2c_addr" type="int" default="-1" access="initonly" minvalue="-2"
            maxvalue="119">I2C address. The value -1 means default device I2C address
            (0x3C)</property>
            <property name="@spi_freq" type="int" default="1000000" units="hertz" minvalue="100000"
            maxvalue="10000000" access="initonly">SPI frequency</property>
            <property name="@spi_cs" type="int" default="-1" minvalue="-1" maxvalue="127"
            access="initonly">CS (chip select) GPIO pin</property>
            <property name="@spi_dc" type="int" default="-1" minvalue="-1" maxvalue="127"
            access="initonly">DC (data/command) GPIO pin</property>
            <property name="@spi_rs" type="int" default="-1" minvalue="-1" maxvalue="127"
            access="initonly">RS (reset) GPIO pin</property>
            <property name="@spi_bus" type="int" default="0" minvalue="0" maxvalue="6"
            access="initonly">SPI bus</property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>control input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet></outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[flush #a( [T]  [text HELLO\ CEAM 2 32 #d(
           |
[clear #b( [invert $1 #c(







[hw.rpi.display.ssd1306 @mode i2c @i2c_bus default #x]

[X a->x] [X b->x] [X c->x] [X d->x]

[ui.link @url=ceammc://img/conn_spi_ssd1306.png @title='SPI_connection']

[ui.link @url=ceammc://img/conn_i2c_ssd1306.png @title='I2C_connection']
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
