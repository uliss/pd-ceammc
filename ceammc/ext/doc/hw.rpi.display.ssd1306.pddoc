<?xml version='1.0' encoding='utf-8'?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="hw.rpi.display.ssd1306">
        <title>hw.rpi.display.ssd1306</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>OLED ssd1306 display for Raspberry Pi</description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display ssd1306 spi i2c rpi</keywords>
            <since>0.9.9</since>
        </meta>
        <info>
            <par>Both I2C and SPI connections are supported</par>
        </info>
        <methods>
            <method name="rotation">method</method>
            <method name="invert">invert display 
            <param name="VALUE" type="bool" required="true">value</param></method>
            <method name="mirror">mirror display 
            <param name="VALUE" type="bool" required="true">value</param></method>
            <method name="font">set</method>
            <method name="write">method</method>
            <method name="clear">method</method>
            <method name="brightness">set display brightness 
            <param name="LEVEL" type="int" enum="0 1 2 3 4" required="true">brightness level from 0
            (lowest) to 4 (brightest). Normal level is 2.</param></method>
            <method name="switch_on">method</method>
            <method name="flush">flush internal buffer to device</method>
            <method name="text">method</method>
            <method name="pixel">method</method>
        </methods>
        <arguments>
            <argument name="MODE" type="symbol" enum="i2c spi">display connection. See
            @mode</argument>
        </arguments>
        <properties>
            <property name="@mode" type="symbol" default="i2c" enum="i2c spi" access="initonly">
            display connection</property>
            <property name="@spi" type="list" default="" access="initonly">SPI connection
            arguments: DC RS CS? SPI? FREQ?. DC: GPIO pin, RS: GPIO pin, CS: chip select pin
            (logical numbering, not GPIO!, default: 0 (GPIO8)), SPI: spi bus (default 1), FREQ: SPI
            clock frequency in hertz (default: 10_000_000)</property>
            <property name="@size" type="list" default="128 64" access="initonly">display
            size</property>
            <property name="@i2c_bus" type="int" default="-1" access="initonly" minvalue="-1"  maxvalue="15">I2C bus.
            Use it if you have several I2C buses in the system. The value -1 means a default system bus</property>
            <property name="@i2c_addr" type="int" default="-1" access="initonly" minvalue="-2"  maxvalue="119">I2C address.
            The value -1 means default device I2C address (0x3C)</property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>control input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet></outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[clear(
|
|
|
[hw.rpi.display.ssd1306 #x]

[ui.link @url=ceammc://img/conn_spi_ssd1306.png @title='SPI_connection']

[ui.link @url=ceammc://img/conn_i2c_ssd1306.png @title='I2C_connection']
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
