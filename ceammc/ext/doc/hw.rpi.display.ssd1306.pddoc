<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.display.ssd1306">
    <title>hw.rpi.display.ssd1306</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">driver for OLED display on SSD1306 chip for Raspberry Pi</tr>
        <tr lang="ru">драйвер для OLED-дисплея на чипе SSD1306 для Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>display ssd1306 spi i2c rpi</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Both I²C and SPI connections are supported. I²C connection is not fast.</tr>
        <tr lang="ru">Поддерживаются подключение по I²C и SPI. Подключение через I²C не является высокоскоростным.</tr>
      </par>
      <par>
        <tr lang="en">Note: you should send the [flush( message to transfer the internal pixel buffer to the device.</tr>
        <tr lang="ru">Примечание: необходимо отправить сообщение [flush( для передачи внутреннего буфера пикселей на устройство.</tr>
      </par>
    </info>
    <arguments>
      <argument name="MODE" type="symbol" enum="i2c spi">
        <tr lang="en">display connection mode. See @mode</tr>
        <tr lang="ru">режим подключения дисплея. См. @mode</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @i2c_addr -->
      <property name="@i2c_addr" type="int" default="-1" access="initonly" minvalue="-4"
      maxvalue="119">
        <tr lang="en">I²C address. The 'default' value is also accepted (for addr 0x3c) and 'alt' (for addr 0x3d).</tr>
        <tr lang="ru">Адрес I²C. Также принимаются значения «default» (для адреса 0x3c) и «alt» (для адреса 0x3d).</tr>
      </property>
      <!-- @i2c_bus -->
      <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none"
      access="initonly">
        <tr lang="en">I²C bus</tr>
        <tr lang="ru">шина I²C</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" default="i2c" enum="i2c spi" access="initonly">
        <tr lang="en">display connection mode</tr>
        <tr lang="ru">режим подключения дисплея</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="list" default="128 64" access="initonly">
        <tr lang="en">display size</tr>
        <tr lang="ru">размер дисплея</tr>
      </property>
      <!-- @spi_bus -->
      <property name="@spi_bus" type="int" default="-1" minvalue="-1" maxvalue="6"
      access="initonly">
        <tr lang="en">SPI bus</tr>
        <tr lang="ru">шина SPI</tr>
      </property>
      <!-- @spi_cs -->
      <property name="@spi_cs" type="int" default="-1" minvalue="-1" maxvalue="127"
      access="initonly">
        <tr lang="en">CS (chip select) GPIO pin</tr>
        <tr lang="ru">CS (Chip Select) пин GPIO</tr>
      </property>
      <!-- @spi_dc -->
      <property name="@spi_dc" type="int" default="-1" minvalue="-1" maxvalue="127"
      access="initonly">
        <tr lang="en">DC (data/command) GPIO pin</tr>
        <tr lang="ru">DC (data/command) пин GPIO</tr>
      </property>
      <!-- @spi_freq -->
      <property name="@spi_freq" type="int" default="1000000" units="hertz" minvalue="100000"
      maxvalue="10000000" access="initonly">
        <tr lang="en">SPI frequency</tr>
        <tr lang="ru">частота SPI</tr>
      </property>
      <!-- @spi_rs -->
      <property name="@spi_rs" type="int" default="-1" minvalue="-1" maxvalue="127"
      access="initonly">
        <tr lang="en">RS (reset) GPIO pin</tr>
        <tr lang="ru">RS (reset) пин GPIO</tr>
      </property>
    </properties>
    <methods>
      <!-- brightness -->
      <method name="brightness">
        <info>
          <tr lang="en">set display brightness</tr>
          <tr lang="ru">установить яркость дисплея</tr>
        </info>
        <param name="LEVEL" type="int" enum="0 1 2 3 4" required="true">
          <tr lang="en">brightness level from 0 (lowest) to 4 (brightest). The normal level is 2.</tr>
          <tr lang="ru">уровень яркости от 0 (самый низкий) до 4 (самый яркий). Нормальный уровень — 2.</tr>
        </param>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clear the display contents and optionally send the internal buffer to the device</tr>
          <tr lang="ru">очистить содержимое дисплея и опционально отправить внутренний буфер на устройство</tr>
        </info>
        <param name="FLUSH" type="bool" default="0" required="false">
          <tr lang="en">if 1: send the internal buffer to the device</tr>
          <tr lang="ru">если 1: отправить внутренний буфер на устройство</tr>
        </param>
      </method>
      <!-- flush -->
      <method name="flush">
        <info>
          <tr lang="en">send the internal buffer to the device</tr>
          <tr lang="ru">отправить внутренний буфер на устройство</tr>
        </info>
      </method>
      <!-- font -->
      <method name="font">
        <info>
          <tr lang="en">set the current font</tr>
          <tr lang="ru">установить текущий шрифт</tr>
        </info>
        <param name="FONT" type="symbol" required="true">
          <tr lang="en">font name</tr>
          <tr lang="ru">название шрифта</tr>
        </param>
      </method>
      <!-- invert -->
      <method name="invert">
        <info>
          <tr lang="en">invert the display</tr>
          <tr lang="ru">инвертировать дисплей</tr>
        </info>
        <param name="VALUE" type="bool" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- mirror -->
      <method name="mirror">
        <info>
          <tr lang="en">mirror the display</tr>
          <tr lang="ru">зеркально отразить дисплей</tr>
        </info>
        <param name="VALUE" type="bool" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- pixel -->
      <method name="pixel">
        <info>
          <tr lang="en">draw a pixel</tr>
          <tr lang="ru">нарисовать пиксель</tr>
        </info>
        <param name="X" type="int" minvalue="0" required="true">
          <tr lang="en">X coordinate (from the left)</tr>
          <tr lang="ru">координата X (слева)</tr>
        </param>
        <param name="Y" type="int" minvalue="0" required="true">
          <tr lang="en">Y coordinate (from the top)</tr>
          <tr lang="ru">координата Y (сверху)</tr>
        </param>
        <param name="VALUE" type="bool" required="true">
          <tr lang="en">pixel value</tr>
          <tr lang="ru">значение пикселя</tr>
        </param>
      </method>
      <!-- rotation -->
      <method name="rotation">
        <info>
          <tr lang="en">set up display rotation</tr>
          <tr lang="ru">настроить поворот дисплея</tr>
        </info>
        <param name="ANGLE" type="int" enum="0 90 180 270">
          <tr lang="en">rotation angle</tr>
          <tr lang="ru">угол поворота</tr>
        </param>
      </method>
      <!-- switch_on -->
      <method name="switch_on">
        <info>
          <tr lang="en">turn on the display (required when connecting via SPI)</tr>
          <tr lang="ru">включить дисплей (требуется при подключении по SPI)</tr>
        </info>
        <param name="VALUE" type="bool" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- text -->
      <method name="text">
        <info>
          <tr lang="en">draw text on the display</tr>
          <tr lang="ru">нарисовать текст на дисплее</tr>
        </info>
        <param name="TXT" type="symbol" required="true">
          <tr lang="en">text</tr>
          <tr lang="ru">текст</tr>
        </param>
        <param name="X" type="int" required="true">
          <tr lang="en">left text X coordinate</tr>
          <tr lang="ru">левая X-координата текста</tr>
        </param>
        <param name="Y" type="int" required="true">
          <tr lang="en">top text Y coordinate</tr>
          <tr lang="ru">верхняя Y-координата текста</tr>
        </param>
      </method>
      <!-- write bitmap -->
      <method name="write bitmap">
        <info>
          <tr lang="en">write a bitmap to the display buffer</tr>
          <tr lang="ru">записать растровое изображение в буфер дисплея</tr>
        </info>
        <param name="X" type="int" required="true">
          <tr lang="en">bitmap X coordinate</tr>
          <tr lang="ru">X-координата растрового изображения</tr>
        </param>
        <param name="Y" type="int" required="true">
          <tr lang="en">bitmap Y coordinate</tr>
          <tr lang="ru">Y-координата растрового изображения</tr>
        </param>
        <param name="WIDTH" type="int" minvalue="1" required="true">
          <tr lang="en">bitmap width in pixels</tr>
          <tr lang="ru">ширина растрового изображения в пикселях</tr>
        </param>
        <param name="PIXELS" type="list" required="true">
          <tr lang="en">list of pixels (0 or 1)</tr>
          <tr lang="ru">список пикселей (из 0 или 1)</tr>
        </param>
      </method>
      <!-- write bytes -->
      <method name="write bytes">
        <info>
          <tr lang="en">write a raw byte list to the display buffer and move the internal cursor position</tr>
          <tr lang="ru">записать список байтов в буфер дисплея и переместить внутреннюю позицию курсора</tr>
        </info>
        <param name="BYTES" type="list" required="true">
          <tr lang="en">list of bytes (integers in the 0..255 range). Each byte describes a single column of 8 pixels in height.</tr>
          <tr lang="ru">список байтов (целые числа в диапазоне 0..255). Каждый байт описывает один столбец высотой 8 пикселей.</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control input</tr>
          <tr lang="ru">управляющий вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">no output</tr>
          <tr lang="ru">ничего не выводит</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*I²C connection example:*/

[ui.hrd #k]     /*click several times!*/
|
[brightness #f( [write bytes #g(

 [flush #a( [T] [text HELLO\ ЦЭАМ! 3 10, flush #d(
            |
 [clear #b( [invert $1 #c(    [clear, line 0 0 127 31, bang #j(

            [T]                [load img/test_image_128x32.png, bang(
            |                  |
  [T]       [mirror $1 #e(    [bitmap 128 32 #y]
  |                           |
  [@connect $1(               [msg write bitmap 0 0 128 #h]
  |
  |                           /*call flush!*/
  |
[hw.rpi.display.ssd1306 @mode i2c @i2c_bus default #x]

[X a->x] [X b->x] [X c->x] [X d->x] [X e->x] [X f->x] [X g->x] [X h->x] [X j->y]
[ui.link @url=ceammc://img/conn_i2c_ssd1306.png @title='I2C_connection']

[ui.link @url=ceammc://img/conn_spi_ssd1306.png @title='SPI_connection']
#b 1
#f $1
#g 255 127 63 31 15 7 3 1, flush
#k @nitems 4
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
