<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="hw.rpi.display.ssd1306">
        <title>hw.rpi.display.ssd1306</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">driver for OLED display on ssd1306 chip for Raspberry Pi</tr>
                <tr lang="ru">драйвер для OLED дисплея на чипе ssd1306 для Raspberry Pi</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display ssd1306 spi i2c rpi</keywords>
            <since>0.9.8</since>
        </meta>
        <info>
            <par>Both I²C and SPI connections are supported. I²C connection is not fast.</par>
            <par>Note: you should send [flush( message to transfer internal pixel buffer to the
            device</par>
        </info>
        <arguments>
            <argument name="MODE" type="symbol" enum="i2c spi">
                <tr lang="en">display connection mode. See @mode</tr>
                <tr lang="ru">режим подключения дисплея. См. @mode</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @i2c_addr -->
            <property name="@i2c_addr" type="int" default="-1" access="initonly" minvalue="-4"
            maxvalue="119">
                <tr lang="en">I²C address. Also 'default' value is accepted (for addr 0x3c) and
                'alt' (for addr 0x3d)</tr>
                <tr lang="ru">Адрес I²C. Также принимается значение «default» (для адреса 0x3c) и
                «alt» (для адреса 0x3d).</tr>
            </property>
            <!-- @i2c_bus -->
            <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none"
            access="initonly">
                <tr lang="en">I²C bus</tr>
                <tr lang="ru">шина I²C</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" default="i2c" enum="i2c spi" access="initonly">
                <tr lang="en">display connection mode</tr>
                <tr lang="ru">режим подключения дисплея</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="128 64" access="initonly">
                <tr lang="en">display size</tr>
                <tr lang="ru">размер дисплея</tr>
            </property>
            <!-- @spi_bus -->
            <property name="@spi_bus" type="int" default="-1" minvalue="-1" maxvalue="6"
            access="initonly">
                <tr lang="en">SPI bus</tr>
                <tr lang="ru">шина SPI</tr>
            </property>
            <!-- @spi_cs -->
            <property name="@spi_cs" type="int" default="-1" minvalue="-1" maxvalue="127"
            access="initonly">
                <tr lang="en">CS (chip select) GPIO pin</tr>
                <tr lang="ru">CS (Chip Select) пин GPIO</tr>
            </property>
            <!-- @spi_dc -->
            <property name="@spi_dc" type="int" default="-1" minvalue="-1" maxvalue="127"
            access="initonly">
                <tr lang="en">DC (data/command) GPIO pin</tr>
                <tr lang="ru">DC (data/command) пин GPIO</tr>
            </property>
            <!-- @spi_freq -->
            <property name="@spi_freq" type="int" default="1000000" units="hertz" minvalue="100000"
            maxvalue="10000000" access="initonly">
                <tr lang="en">SPI frequency</tr>
                <tr lang="ru">частота SPI</tr>
            </property>
            <!-- @spi_rs -->
            <property name="@spi_rs" type="int" default="-1" minvalue="-1" maxvalue="127"
            access="initonly">
                <tr lang="en">RS (reset) GPIO pin</tr>
                <tr lang="ru">RS (reset) пин GPIO</tr>
            </property>
        </properties>
        <methods>
            <!-- brightness -->
            <method name="brightness">set display brightness 
            <param name="LEVEL" type="int" enum="0 1 2 3 4" required="true">
                <tr lang="en">brightness level from 0 (lowest) to 4 (brightest). Normal level is
                2.</tr>
            </param></method>
            <!-- clear -->
            <method name="clear">clear display and optionally flush internal buffer 
            <param name="FLUSH" type="bool" default="0" required="false">
                <tr lang="en">flush internal buffer to the device</tr>
            </param></method>
            <!-- flush -->
            <method name="flush">flush internal buffer to the device</method>
            <!-- font -->
            <method name="font">set current font 
            <param name="FONT" type="symbol" required="true">
                <tr lang="en">font name</tr>
            </param></method>
            <!-- invert -->
            <method name="invert">invert display 
            <param name="VALUE" type="bool" required="true">
                <tr lang="en">value</tr>
            </param></method>
            <!-- mirror -->
            <method name="mirror">mirror display 
            <param name="VALUE" type="bool" required="true">
                <tr lang="en">value</tr>
            </param></method>
            <!-- pixel -->
            <method name="pixel">draw pixel 
            <param name="X" type="int" minvalue="0" required="true">
                <tr lang="en">X coord (from the left)</tr>
            </param>
            <param name="Y" type="int" minvalue="0" required="true">
                <tr lang="en">Y coord (from the top)</tr>
            </param>
            <param name="VALUE" type="bool" required="true">
                <tr lang="en">pixel value</tr>
            </param></method>
            <!-- rotation -->
            <method name="rotation">set display rotation 
            <param name="ANGLE" type="int" enum="0 90 180 270">
                <tr lang="en">rotation angle</tr>
            </param></method>
            <!-- switch_on -->
            <method name="switch_on">switch on display (needed for SPI connection) 
            <param name="VALUE" type="bool" required="true">
                <tr lang="en">value</tr>
            </param></method>
            <!-- text -->
            <method name="text">draw text on the display 
            <param name="TXT" type="symbol" required="true">
                <tr lang="en">text</tr>
            </param>
            <param name="X" type="int" required="true">
                <tr lang="en">left text X coordinate</tr>
            </param>
            <param name="Y" type="int" required="true">
                <tr lang="en">top text Y coordinate</tr>
            </param></method>
            <!-- write bitmap -->
            <method name="write bitmap">write bitmap to the display buffer 
            <param name="X" type="int" required="true">
                <tr lang="en">bitmap X coordinate</tr>
            </param>
            <param name="Y" type="int" required="true">
                <tr lang="en">bitmap Y coordinate</tr>
            </param>
            <param name="WIDTH" type="int" minvalue="1" required="true">
                <tr lang="en">bitmap width in pixels</tr>
            </param>
            <param name="PIXELS" type="list" required="true">
                <tr lang="en">list of pixels (0 or 1)</tr>
            </param></method>
            <!-- write bytes -->
            <method name="write bytes">write raw byte list to the display buffer and move internal
            cursor position 
            <param name="BYTES" type="list" required="true">
                <tr lang="en">list of bytes (integers in 0..255 range). Each byte describes a
                single column of 8 pixels in height</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>control input</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>no output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
/*I²C connection example:*/

[ui.hrd #k]     /*click several times!*/
|
[brightness #f( [write bytes #g(

 [flush #a( [T] [text HELLO\ ЦЭАМ! 3 10, flush #d(
            |
 [clear #b( [invert $1 #c(    [clear, line 0 0 127 31, bang #j(

            [T]                [load img/test_image_128x32.png, bang(
            |                  |
            [mirror $1 #e(    [bitmap 128 32 #y]
                              |
                              [msg write bitmap 0 0 128 #h]

                              /*call flush!*/

[hw.rpi.display.ssd1306 @mode i2c @i2c_bus default #x]

[X a->x] [X b->x] [X c->x] [X d->x] [X e->x] [X f->x] [X g->x] [X h->x] [X j->y]
[ui.link @url=ceammc://img/conn_i2c_ssd1306.png @title='I2C_connection']

[ui.link @url=ceammc://img/conn_spi_ssd1306.png @title='SPI_connection']
#b 1
#f $1
#g 255 127 63 31 15 7 3 1, flush
#k @nitems 4
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
