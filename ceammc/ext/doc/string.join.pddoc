<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="string.join">
        <title>string.join</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">joins the list into a string with the element separator</tr>
                <tr lang="ru">объединяет список в строку с указанным разделителем элементов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>string</category>
            <keywords>join</keywords>
            <since>0.3</since>
            <aliases>
                <alias>str.join</alias>
            </aliases>
            <also>
                <see>string.split</see>
            </also>
        </meta>
        <arguments>
            <argument name="SEP" type="list">
                <tr lang="en">separator. For space use quotes.</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @sep -->
            <property name="@sep" type="list" default="">
                <tr lang="en">separator</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="symbol">symbol passed untouched</xinfo>
                <xinfo on="list">list to join</xinfo>
                <xinfo on="data:mlist">list to join</xinfo>
            </inlet>
            <inlet>
                <xinfo on="list">change separator to new</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result String</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[list A B C 1 2 3(
|
|               [symbol ":::"( [symbol ""(
|               |.             |.
[string.join _                  ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
