<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.gpio.servo">
    <title>hw.rpi.gpio.servo</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">servo control via GPIO pins on Raspberry Pi</tr>
        <tr lang="ru">управление сервоприводами через выводы GPIO на Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>display gpio raspberry servo pwm</keywords>
      <since>0.9.8</since>
      <aliases>
        <alias>hw.rpi.servo</alias>
      </aliases>
    </meta>
    <info>
      <par style="important">
        <tr lang="en">The specified GPIO pin is taken into exclusive ownership:
        only one entity can operate a servo motor through this pin.</tr>
        <tr lang="ru">указанный вывод GPIO забирается в эксклюзивное владение: только один объект может
        работать с сервоприводом через этот вывод.</tr>
      </par>
    </info>
    <arguments>
      <argument name="PIN" type="int" minvalue="-1" maxvalue="127">
        <tr lang="en">connected GPIO pin. See @pin property.</tr>
        <tr lang="ru">используемый GPIO контакт. См. свойство @pin</tr>
      </argument>
    </arguments>
    <methods>
      <!-- angle -->
      <method name="angle">
        <info>
          <tr lang="en">set the servo to the specified angle in degrees</tr>
          <tr lang="ru">установить сервопривод в указанный угол в градусах</tr>
        </info>
        <param name="ANGLE" type="float" required="true" units="degree" minvalue="0" maxvalue="180">
          <tr lang="en">angle in degrees</tr>
          <tr lang="ru">угол в градусах</tr>
        </param>
      </method>
      <!-- angle_rad -->
      <method name="angle_rad">
        <info>
          <tr lang="en">set the servo to the specified angle in radians</tr>
          <tr lang="ru">установить сервопривод в указанный угол в радианах</tr>
        </info>
        <param name="ANGLE" type="float" required="true" units="radian" minvalue="0" maxvalue="1π">
          <tr lang="en">angle in radians</tr>
          <tr lang="ru">угол в радианах</tr>
        </param>
      </method>
      <!-- angle_phase -->
      <method name="angle_phase">
        <info>
          <tr lang="en">set the servo to the specified phase position</tr>
          <tr lang="ru">установить сервопривод в указанную фазу</tr>
        </info>
        <param name="VALUE" type="float" required="true" minvalue="0" maxvalue="1">
          <tr lang="en">phase value</tr>
          <tr lang="ru">значение фазы</tr>
        </param>
      </method>
      <!-- rotate -->
      <method name="rotate">
        <info>
          <tr lang="en">rotate the servo to the specified angle in degrees.</tr>
          <tr lang="ru">повернуть сервопривод на указанный угол в градусах</tr>
        </info>
        <param name="ANGLE" type="float" required="true" units="degree" minvalue="-180" maxvalue="180">
          <tr lang="en">angle in degrees</tr>
          <tr lang="ru">угол в градусах</tr>
        </param>
      </method>
      <!-- rotate_rad -->
      <method name="rotate_rad">
        <info>
          <tr lang="en">rotate the servo to the specified angle in radians</tr>
          <tr lang="ru">повернуть сервопривод на указанный угол в радианах</tr>
        </info>
        <param name="ANGLE" type="float" required="true" units="radian" minvalue="-1π" maxvalue="1π">
          <tr lang="en">angle in radians</tr>
          <tr lang="ru">угол в радианах</tr>
        </param>
      </method>
      <!-- rotate_phase -->
      <method name="rotate_phase">
        <info>
          <tr lang="en">rotate the servo to the specified phase value.</tr>
          <tr lang="ru">повернуть сервопривод на указанное значение фазы</tr>
        </info>
        <param name="VALUE" type="float" required="true" minvalue="-1" maxvalue="1">
          <tr lang="en">phase value</tr>
          <tr lang="ru">значение фазы</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control message input</tr>
          <tr lang="ru">вход для управляющих сообщений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet/>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[@connect $1(
|
|
|    [0( [180( [90( [45(
|    |   |     |    |
|    [angle $1 #b   (
|
|
|    [-15( [15(            [ui.hsl @show_value 1]
|    |     |               |
|    [rotate $1 #c(        [angle_phase $1 #a(
|
|
|
[hw.rpi.servo #x]

[ui.link @url=ceammc://img/conn_gpio1.png @title='Connection_Scheme']

[ui.link @url=ceammc://hw.rpi.gpio-example.pd @title='GPIO_control']

[X a->x] [X b->x] [X c->x]

]]>
      </pdascii>
    </example>
  </object>
</pddoc>
