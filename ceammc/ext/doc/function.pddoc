<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="function" type="gui">
        <title>function</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">the named function</tr>
                <tr lang="ru">именованная функция</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">base</category>
            <keywords>function</keywords>
            <also>
                <see>function.call</see>
            </also>
            <aliases>
                <alias view="link">func</alias>
                <alias view="link">ceammc/func</alias>
                <alias view="link">ceammc/function</alias>
            </aliases>
            <since>0.3</since>
        </meta>
        <arguments>
            <argument name="NAME" type="symbol">
                <tr lang="en">function name, should be unique</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @name -->
            <property name="@name" type="symbol" default="" access="initonly">
                <tr lang="en">function name, should be unique and non-empty</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">input values</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">value from the side-chain</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result value</outlet>
            <outlet>value to the side-chain</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[function f1-$0 #f1]X[expr sqrt($f1 * $f1 - 1) #e1]

[F]
|
[func.call f1-$0]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
