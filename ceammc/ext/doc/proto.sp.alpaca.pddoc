<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="proto.sp.alpaca">
        <title>proto.sp.alpaca</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">protocol parser for Arduino-based CEAMMC footswitch</tr>
                <tr lang="ru">парсер протокола для ножной педали на базе Arduino CEAMMC</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>proto</category>
            <keywords>protocol diy alpaca footswitch</keywords>
            <since>0.8</since>
        </meta>
        <methods>
            <!-- brightness -->
            <method name="brightness">
                <info>
                    <tr lang="en">set LED brightness</tr>
                    <tr lang="ru" finished="false">установить LED яркость</tr>
                </info>
                <param name="VAL" type="float" required="true" minvalue="0" maxvalue="1">
                    <tr lang="en">value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- char -->
            <method name="char">
                <info>
                    <tr lang="en">draw char at specified position</tr>
                    <tr lang="ru" finished="false">char в указанном положении</tr>
                </info>
                <param name="CH" type="atom" required="true">
                    <tr lang="en">char symbol or int value from 0 to 9</tr>
                    <tr lang="ru" finished="false">символ или значение int от 0 до 9</tr>
                </param>
                <param name="XOFF" type="int" minvalue="0" maxvalue="7">
                    <tr lang="en">horizontal character offset</tr>
                    <tr lang="ru" finished="false">горизонтальное смещение</tr>
                </param>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clear LED display</tr>
                    <tr lang="ru" finished="false">прозрачный LED дисплей</tr>
                </info>
            </method>
            <!-- col -->
            <method name="col">
                <info>
                    <tr lang="en">draw column pixels</tr>
                    <tr lang="ru" finished="false">рисовать пиксели столбцов</tr>
                </info>
                <param name="N" type="int" required="true" minvalue="0" maxvalue="7">
                    <tr lang="en">column index</tr>
                    <tr lang="ru" finished="false">колоночный индекс</tr>
                </param>
                <param name="BITS" type="list" required="true">
                    <tr lang="en">list of 0 and 1</tr>
                    <tr lang="ru" finished="false">Список 0 и 1</tr>
                </param>
            </method>
            <!-- dump -->
            <method name="dump">
                <info>
                    <tr lang="en">dumps all object info to Pd console window.</tr>
                    <tr lang="ru" finished="false">Сбрасывает всю информацию об объекте в окно
                    консоли Pd.</tr>
                </info>
            </method>
            <!-- fill -->
            <method name="fill">
                <info>
                    <tr lang="en">fill LED display</tr>
                    <tr lang="ru" finished="false">Заполнить LED дисплей</tr>
                </info>
            </method>
            <!-- invert -->
            <method name="invert">
                <info>
                    <tr lang="en">invert LED display</tr>
                    <tr lang="ru" finished="false">Инвертированный светодиодный дисплей</tr>
                </info>
            </method>
            <!-- mode -->
            <method name="mode">
                <info>
                    <tr lang="en">set device jack mode</tr>
                    <tr lang="ru" finished="false">Настройка устройства Jack Mode</tr>
                </info>
                <param name="IDX" type="int" required="true" enum="0 1">
                    <tr lang="en">left (0) or right (1) device side</tr>
                    <tr lang="ru" finished="false">левая (0) или правая (1) сторона устройства</tr>
                </param>
                <param name="MODE" type="symbol" required="true"
                enum="digital1 digital2 digital analog analog_raw none">
                    <tr lang="en">output mode: none - no output, digital1 - send only first button
                    press, digital2 - send only second button press, digital - send both buttons
                    press, analog - send analog value (from pedal), analog_row - send raw analog
                    values (pair)</tr>
                    <tr lang="ru" finished="false">режим вывода: нет - нет вывода, digital1 -
                    отправить только первый нажатие кнопки, digital2 - отправить только второй
                    нажатие кнопки, digital - отправить обе кнопки нажатия, аналог - отправить
                    аналоговое значение (с педали), analog_row - отправить необработанные
                    аналоговые значения (пара)</tr>
                </param>
            </method>
            <!-- pixel -->
            <method name="pixel">
                <info>
                    <tr lang="en">draw/clear pixel on display matrix (6x8).</tr>
                    <tr lang="ru" finished="false">Рисунок/чистый пиксель на матрице дисплея
                    (6x8).</tr>
                </info>
                <param name="X" type="int" required="true" minvalue="0" maxvalue="7">
                    <tr lang="en">x-pixel coordinate</tr>
                    <tr lang="ru" finished="false">x-пиксельная координата</tr>
                </param>
                <param name="Y" type="int" required="true" minvalue="0" maxvalue="5">
                    <tr lang="en">y-pixel coordinate</tr>
                    <tr lang="ru" finished="false">координата пикселя</tr>
                </param>
                <param name="ON/OFF" type="int" required="true" enum="0 1">
                    <tr lang="en">draw (1) or clear (0)</tr>
                    <tr lang="ru" finished="false">рисовать (1) или ясно (0)</tr>
                </param>
            </method>
            <!-- row -->
            <method name="row">
                <info>
                    <tr lang="en">draw row pixels</tr>
                    <tr lang="ru" finished="false">рисовать пиксели строки</tr>
                </info>
                <param name="N" type="int" required="true" minvalue="0" maxvalue="5">
                    <tr lang="en">row index</tr>
                    <tr lang="ru" finished="false">строковый индекс</tr>
                </param>
                <param name="BITS" type="list" required="true">
                    <tr lang="en">list of 0 and 1</tr>
                    <tr lang="ru" finished="false">Список 0 и 1</tr>
                </param>
            </method>
            <!-- str -->
            <method name="str">
                <info>
                    <tr lang="en">draw string</tr>
                    <tr lang="ru" finished="false">ничья</tr>
                </info>
                <param name="STR" type="atom" required="true">
                    <tr lang="en">string or int value from -9 to 99</tr>
                    <tr lang="ru" finished="false">значение строки или int от -9 до 99</tr>
                </param>
            </method>
            <!-- sync -->
            <method name="sync">
                <info>
                    <tr lang="en">force device to send it's button and mode state</tr>
                    <tr lang="ru" finished="false">заставить устройство отправить его кнопку и
                    состояние режима</tr>
                </info>
            </method>
            <!-- version? -->
            <method name="version?">
                <info>
                    <tr lang="en">outputs device protocol version as message: [version N]</tr>
                    <tr lang="ru" finished="false">выводит версию протокола устройства в виде
                    сообщения: [версия N]</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">input byte value from arduino</tr>
                    <tr lang="ru" finished="false">значение байта от Arduino</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output parsed messages from device</tr>
                    <tr lang="ru" finished="false">вывод парсированных сообщений с устройства</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.knob] [version? #d(
|
|         [clear #a( [fill #b( [ui.hrd @mode 1] [F]         [S digits=5]
|                              |                |           |
[brightness $1(                [msg row 2 #c]   [str $1 #e( [char $1 #f(
|
|                              [ui.menu none digital1 digital2 analog]
|                              |
|                              [mode 0 $2 #g(
|
[proto.sp.alpaca #z]
|
[hw.arduino @rate 9600 @reconnect]
|
[proto.sp.alpaca]
|
[route digital analog]
|                  ^|
[route 0 1 2 3   ] [route 0 1]
|    ^|  ^^|  ^^^| |     ^|
[T]  [T]  [T]  [T] [F]   [F]

[X a->z]
[X b->z]
[X c->z]
[X d->z]
[X e->z]
[X f->z]
[X g->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
