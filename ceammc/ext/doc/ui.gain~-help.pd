#X msg 130 802 @amp;
#X text 270 802 Get/Set gain as amplitude ratio. Type: float. Default
value: 0\.;
#X msg 130 844 @db;
#X text 270 844 Get/Set gain in dbfs scale. Type: float. Units: 'db'.
Default value: -60\.;
#X msg 130 886 @max;
#X text 270 886 Get/Set maximum gain value. Type: int. Units: 'db'.
Default value: 0\. Range: -12\...12\.;
#X msg 130 928 @min;
#X text 270 928 Get/Set minimal gain value. Type: int. Units: 'db'.
Default value: -60\. Range: -90\...-15\.;
#X msg 130 970 @mouse_events;
#X text 270 970 Get/Set mouse events output mode. If on outputs @mouse_down
\, @mouse_up and @mouse_drag events. Type: bool. Default value: 0\.;
#X msg 130 1027 @output_value;
#X text 270 1027 Get/Set flag to output @db property after each knob
move. Type: bool. Default value: 0\.;
#X msg 130 1069 @receive;
#X text 270 1069 Get/Set source of message receive. Type: symbol. Default
value: (null).;
#X msg 130 1111 @relative;
#X text 270 1111 Get/Set relative input mode. When set do not jump
to value on click. Type: bool. Default value: 1\.;
#X msg 130 1153 @send;
#X text 270 1153 Get/Set address for sending messages. Type: symbol.
Default value: (null).;
#X msg 130 1195 @show_range;
#X text 270 1195 Get/Set if show slider range. Type: bool. Default
value: 1\.;
#X msg 130 1225 @midi_channel;
#X text 270 1225 Get/Set MIDI channel binding. If set to 0 \, it binds
to all channels. The values in the range [1\..16] are mapped to the
channels of the first Pd MIDI device \, [17\..32] to the channels of
the second \, and so on. Type: int. Default value: 0\. Range: 0\...255\.;
#X msg 130 1328 @midi_control;
#X text 270 1328 Get/Set binded MIDI controller number. -1 means not
binded to any controller. Type: int. Default value: -1\. Range: -1\...127\.;
#X msg 130 1385 @midi_pickup;
#X text 270 1385 Get/Set pickup current value. If slider is binded
to value \, first time you should pass over this value to make binding.
It prevents from sudden value change on first control change. Type:
bool. Default value: 1\.;
#X msg 130 1472 @background_color;
#X text 270 1472 Get/Set element background color (list of red \, green
\, blue values in 0-1 range). Type: list. Default value: 0.93 0.93
0.93 1\.;
#X msg 130 1529 @border_color;
#X text 270 1529 Get/Set border color (list of red \, green \, blue
values in 0-1 range). Type: list. Default value: 0.6 0.6 0.6 1\.;
#X msg 130 1571 @knob_color;
#X text 270 1571 Get/Set knob color (list of red \, green \, blue values
in 0-1 range). Type: list. Default value: 0 0.75 1 1\.;
#X msg 130 1613 @fontname;
#X text 270 1613 Get/Set font name. Type: symbol. Default value: Helvetica.
Allowed values: Courier \, DejaVu \, Helvetica \, Monaco \, Times.;
#X msg 130 1655 @fontsize;
#X text 270 1655 Get/Set font size. Type: int. Default value: 11\.
Range: 4\...100\.;
#X msg 130 1697 @fontslant;
#X text 270 1697 Get/Set font slant. Type: symbol. Default value: roman.
Allowed values: roman \, italic.;
#X msg 130 1739 @fontweight;
#X text 270 1739 Get/Set font weight. Type: symbol. Default value:
normal. Allowed values: normal \, bold.;
#X msg 130 1781 @pinned;
#X text 270 1781 Get/Set pin mode. If set to 1 \, it places the element
at the furthest level on the canvas behind other elements. Type: bool.
Default value: 0\.;
#X msg 130 1838 @presetname;
#X text 270 1838 Get/Set preset name for using with [ui.preset] or
[preset.storage] objects. Type: symbol. Default value: (null).;
#X msg 130 1895 @size;
#X text 270 1895 Get/Set object size (width \, height pair). Type:
list. Default value: 15 120\.;
