<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="dyn.gate2~">
        <title>dyn.gate2~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">stereo signal gate</tr>
                <tr lang="ru">стерео-сигнальный гейт</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>dyn</category>
            <keywords>gate</keywords>
            <since>0.1</since>
            <also>
                <see>dyn.gate~</see>
            </also>
        </meta>
        <info>
            <par>NOTE: the input level measured as sum of two input signals</par>
        </info>
        <arguments>
            <argument name="THRESHOLD" type="float" units="decibel" minvalue="-90" maxvalue="0">
                <tr lang="en">dB level threshold above which gate opens</tr>
                <tr lang="ru">пороговый уровень дБ, выше которого открывается гейт</tr>
            </argument>
            <argument name="ATTACK" type="float" units="millisecond" minvalue="0" maxvalue="500">
                <tr lang="en">attack time = time constant (ms) for gate to open</tr>
                <tr lang="ru">время атаки = постоянная времени (ms) для открытия гейта</tr>
            </argument>
            <argument name="HOLD" type="float" units="millisecond" minvalue="1" maxvalue="500">
                <tr lang="en">hold time = time (ms) gate stays open after signal level &lt;
                threshold</tr>
                <tr lang="ru">время удержания = время (ms), которое гейт остается открытым после
                уровня сигнала &lt; порог</tr>
            </argument>
            <argument name="RELEASE" type="float" units="millisecond" minvalue="1" maxvalue="500">
                <tr lang="en">release time = time constant (ms) for gate to close</tr>
                <tr lang="ru">время освобождения = постоянная времени (ms) для закрытия гейта</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @attack -->
            <property name="@attack" type="float" units="millisecond" minvalue="0" maxvalue="500"
            default="0.1">
                <tr lang="en">attack time = time constant (ms) for gate to open</tr>
            </property>
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
            </property>
            <!-- @hold -->
            <property name="@hold" type="float" units="millisecond" minvalue="1" maxvalue="500"
            default="100">
                <tr lang="en">hold time = time (ms) gate stays open after signal level &lt;
                threshold</tr>
            </property>
            <!-- @release -->
            <property name="@release" type="float" units="millisecond" default="20" minvalue="1"
            maxvalue="500">
                <tr lang="en">release time = time constant (ms) for gate to close</tr>
            </property>
            <!-- @threshold -->
            <property name="@threshold" type="float" units="decibel" minvalue="-90" maxvalue="0"
            default="-60">
                <tr lang="en">dB level threshold above which gate opens</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">reset to initial state</method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>left input signal</xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo>right input signal</xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">set threshold</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">left output signal</outlet>
            <outlet type="audio">right output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[osc~ 400]     [ui.hsl -60 0 @show_value 1]
|              |
|  [osc~ 900]  [dbfs->amp #a]
|  |.
[gain~ 2 #b]   [ui.hsl -60 0 @show_value 1]
|              |
|              [@threshold $1(
|              |
[dyn.gate2~ -10 #x]
*|*
[ui.hgain2~]   [ui.dsp~]
*|*
[dac~]

[X a->b:2]
[X b:1->x:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
