<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="env2vline">
        <title>env2vline</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">сonverts the envelope into the sequence of messages for [vline~]
                object</tr>
                <tr lang="ru">преобразует огибающую в последовательность сообщений для объекта
                [vline~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>env</category>
            <keywords>envelope vline</keywords>
            <since>0.5</since>
            <aliases>
                <alias>ceammc/env2vline</alias>
                <alias>ceammc/env-&gt;vline</alias>
                <alias>env-&gt;vline</alias>
            </aliases>
            <also>
                <see>vline-&gt;env</see>
                <see>env-&gt;array</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Supports stop-points for multisegment envelopes. Note: non-linear
                envelopes are outputted using linear approximation</tr>
            </par>
        </info>
        <properties>
            <!-- @sync -->
            <property name="@sync" type="bool" default="0">
                <tr lang="en">sync with input data. When set to 1 outputs envelope (as fixed) on
                every input data</tr>
            </property>
        </properties>
        <methods>
            <!-- next -->
            <method name="next">
                <info>
                    <tr lang="en">output segment until next stop-point or end of envelope is
                    reached</tr>
                </info>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset current segment position for multi-segment envelopes</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output as envelope of fixed length (no stop-points are
                    encountered)</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">output as attack (on 1) / release (on 0) envelope with one
                    stop-point</tr>
                </xinfo>
                <xinfo on="data">
                    <tr lang="en">output as fixed envelope* data</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>bunch of vline-compatible messages: VALUE, DURATION, OFFSET</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[loadbang]                            [r a1]
|                                     |
[envelope easr 20 -4 1000 -8]         [env->array env_a1]
| |
| [s a1] [bang( [T]
|        |      |
[env->vline     ]                     [array env_a1 w=110 h=80 yr=0..1]
|
[vline~] [osc~ 1000]
|        |.
[*~       ]
|
[ui.hgain~]
|\
[dac~]

[loadbang]
|
[line 0 100 1 400 0.2 1000 0.7 2000 0, set_stop_point 2 1, set_stop_point 3 1, bang(
|
|
[envelope] [next( [reset(             [r a2]
| |        |      |                   |
| [s a2]   |      |                   [env->array env_b1]
|          |      |
[env->vline       ]
|
[vline~] [osc~ 1200]                  [array env_b1 w=110 h=80 yr=0..1]
|        |.
[*~       ]
|
[ui.hgain~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
