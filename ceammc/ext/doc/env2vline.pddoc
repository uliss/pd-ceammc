<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env2vline">
    <title>env2vline</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Converts the envelope into the sequence of messages for [vline~] object</tr>
        <tr lang="ru">преобразует огибающую в последовательность сообщений для объекта
        [vline~]</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>envelope vline</keywords>
      <since>0.5</since>
      <aliases>
        <alias>ceammc/env2vline</alias>
        <alias>ceammc/env-&gt;vline</alias>
        <alias>env-&gt;vline</alias>
      </aliases>
      <also>
        <see>vline-&gt;env</see>
        <see>env-&gt;array</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Supports stop-points for multisegment envelopes. Note: non-linear envelopes
        are outputted using linear approximation</tr>
        <tr lang="ru">Поддерживает точки остановки для многосегментных огибающих. Примечание:
        нелинейные огибающие выводятся с использованием линейной аппроксимации</tr>
      </par>
    </info>
    <properties>
      <!-- @sync -->
      <property name="@sync" type="bool" default="0">
        <tr lang="en">sync with input data. When set to 1, outputs the envelope (as fixed) on every
        input message</tr>
        <tr lang="ru">синхронизация с входными данными. При значении 1 выводит огибающую (как
        фиксированную) на каждое входное сообщение</tr>
      </property>
    </properties>
    <methods>
      <!-- next -->
      <method name="next">
        <info>
          <tr lang="en">outputs the segment until the next stop-point or the end of the envelope is
          reached</tr>
          <tr lang="ru">выводит сегмент до достижения следующей точки остановки или конца
          огибающей</tr>
        </info>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the current segment position for multi-segment envelopes</tr>
          <tr lang="ru">сбрасывает текущее положение сегмента для многосегментных огибающих</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the envelope as a fixed-length shape (no stop-points are
          encountered)</tr>
          <tr lang="ru">выводит огибающую как форму фиксированной длины (точки остановки не
          встречаются)</tr>
        </in>
        <in on="float">
          <tr lang="en">outputs the envelope as attack (on 1) or release (on 0) with a single
          stop-point</tr>
          <tr lang="ru">выводит огибающую как атаку (при 1) или восстановление (при 0) с одной
          точкой остановки</tr>
        </in>
        <in on="data">
          <tr lang="en">outputs the envelope as fixed-length data</tr>
          <tr lang="ru">выводит огибающую как данные фиксированной длины</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">bunch of vline-compatible messages: VALUE, DURATION, OFFSET</tr>
          <tr lang="ru">набор совместимых с [vline~] сообщений: VALUE, DURATION, OFFSET</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[loadbang]                            [r a1]
|                                     |
[envelope easr 20 -4 1000 -8]         [env->array env_a1]
| |
| [s a1] [bang( [T]
|        |      |
[env->vline     ]                     [array env_a1 w=110 h=80 yr=0..1]
|
[vline~] [osc~ 1000]
|        |.
[*~       ]
|
[ui.hgain~]
|\
[dac~]

[loadbang]
|
[line 0 100 1 400 0.2 1000 0.7 2000 0, set_stop_point 2 1, set_stop_point 3 1, bang(
|
|
[envelope] [next( [reset(             [r a2]
| |        |      |                   |
| [s a2]   |      |                   [env->array env_b1]
|          |      |
[env->vline       ]
|
[vline~] [osc~ 1200]                  [array env_b1 w=110 h=80 yr=0..1]
|        |.
[*~       ]
|
[ui.hgain~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
