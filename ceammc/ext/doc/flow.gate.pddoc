<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="flow.gate">
        <title>flow.gate</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">control flow gate. [spigot] object analog</tr>
                <tr lang="ru">шлюз для потока сообщений. аналог объекта [spigot]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>gate</keywords>
            <since>0.4</since>
            <also>
                <see>flow.pass</see>
            </also>
            <aliases>
                <alias>ceammc/gate</alias>
                <alias>gate</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: property setting can be done only via [prop.set] object, since
                object accepts all incoming messages</tr>
            </par>
        </info>
        <arguments>
            <argument name="STATE" type="bool">
                <tr lang="en">init gate state. 1 means open, 0 - closed. By default gate is
                closed</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @state -->
            <property name="@state" type="bool" default="0">
                <tr lang="en">gate state. 1 means open, 0 - closed</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="any">input flow</xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">gate control inlet. Sending *1* opens gate, *0* - closes</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output flow</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]       [T] [T]
|         |   |
|         |   [prop.set @state]
|         |.  |.
[flow.gate 1   ]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
