<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flow.gate">
        <title>flow.gate</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">control flow gate. [spigot] object analog</tr>
                <tr lang="ru">шлюз для потока сообщений. аналог объекта [spigot]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>gate</keywords>
            <since>0.4</since>
            <also>
                <see>flow.pass</see>
            </also>
            <aliases>
                <alias>ceammc/gate</alias>
                <alias>gate</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: property setting can be done only via [prop.set] object, since
                object accepts all incoming messages</tr>
                <!-- old: Настройка свойств может быть выполнена только через
                объект [prop.set], так как объект принимает все входящие сообщения. -->
                <tr lang="ru" finished="false">Настройка свойств может быть выполнена только через
                объект [prop.set], так как объект принимает все входящие сообщения.</tr>
            </par>
        </info>
        <arguments>
            <argument name="STATE" type="bool">
                <tr lang="en">init gate state. 1 means open, 0 - closed. By default gate is
                closed</tr>
                <!-- old: Состояние врат. 1 означает открытый, 0 - закрытый.
                По умолчанию ворота закрыты -->
                <tr lang="ru" finished="false">Состояние врат. 1 означает открытый, 0 - закрытый.
                По умолчанию ворота закрыты</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @state -->
            <property name="@state" type="bool" default="0">
                <tr lang="en">gate state. 1 means open, 0 - closed</tr>
                <!-- old: Состояние ворот. 1 означает открытый, 0 -
                закрытый -->
                <tr lang="ru" finished="false">Состояние ворот. 1 означает открытый, 0 -
                закрытый</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="any">
                    <tr lang="en">input flow</tr>
                    <tr lang="ru" finished="false">входной поток</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">gate control inlet. Sending *1* opens gate, *0* - closes</tr>
                    <!-- old: Впуск управления воротами. отправка *1*
                    открывает ворота, *0* - закрывает -->
                    <tr lang="ru" finished="false">Впуск управления воротами. отправка *1*
                    открывает ворота, *0* - закрывает</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output flow</tr>
                    <tr lang="ru" finished="false">выходной поток</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]       [T] [T]
|         |   |
|         |   [prop.set @state]
|         |.  |.
[flow.gate 1   ]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
