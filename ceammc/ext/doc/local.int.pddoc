<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="local.int">
        <title>local.int</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">canvas-scoped named integer variable</tr>
                <tr lang="ru">локальное для патча именованное целое число</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>local</category>
            <keywords>int local</keywords>
            <since>0.1</since>
            <also>
                <see>local.float</see>
                <see>local.list</see>
                <see>global.int</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Defines named local integer variable, accessed by name and available
                only within its patch (canvas). Note: it is not accessible even from subpatch.</tr>
                <tr lang="ru" finished="false">Определение локальной целочисленной переменной,
                доступной по имени и доступной только в ее патче (канвасе). Примечание: он
                недоступен даже из субпатча.</tr>
            </par>
        </info>
        <arguments>
            <argument name="ID" type="symbol">
                <tr lang="en">object ID</tr>
                <tr lang="ru" finished="false">объект</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @id -->
            <property name="@id" type="symbol" access="initonly" default="default">
                <tr lang="en">local variable id</tr>
                <tr lang="ru" finished="false">локальная переменная id</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="int" access="readonly" default="0">
                <tr lang="en">current value</tr>
                <tr lang="ru" finished="false">Текущая стоимость</tr>
            </property>
        </properties>
        <methods>
            <!-- * -->
            <method name="*">
                <info>
                    <tr lang="en">multiply to, no output</tr>
                    <tr lang="ru" finished="false">Умножить на, не выход</tr>
                </info>
            </method>
            <!-- + -->
            <method name="+">
                <info>
                    <tr lang="en">add to int, no output</tr>
                    <tr lang="ru" finished="false">Добавить int, no output</tr>
                </info>
            </method>
            <method name="-">
                <info>
                    <tr lang="en">substruct from int, no output</tr>
                    <tr lang="ru" finished="false">Подструктура из int, отсутствие выхода</tr>
                </info>
            </method>
            <!-- / -->
            <method name="/">
                <info>
                    <tr lang="en">divide by, no output</tr>
                    <tr lang="ru" finished="false">делить на, не выход</tr>
                </info>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">sets new value without output</tr>
                    <tr lang="ru" finished="false">Новая стоимость без выхода</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output value</tr>
                    <tr lang="ru" finished="false">выходная стоимость</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">sets new value and outputs it ONLY at current object outlet</tr>
                    <tr lang="ru" finished="false">устанавливает новое значение и выводит его
                    ТОЛЬКО при текущем выходе объекта</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">integer output</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]   [+ 2, bang(    [* 3, bang(    [bang(
|     |              |              |
|     |              |              |
|     |  [- 3, bang( | [/ 2, bang(  |
|     |  |           | |            |
|     |  | [set 2(   | |            |
|     |  | |         | |            |
[local.int           f1]            [local.int f1]
|                                   |
[F]                                 [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
