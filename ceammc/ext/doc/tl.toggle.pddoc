<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="tl.toggle">
    <title>tl.toggle</title>
    <meta>
      <authors>
        <author>Alex Nadzharov</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">timeline toggle</tr>
        <tr lang="ru">переключатель на временной шкале</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>tl</category>
      <keywords>timeline toggle</keywords>
      <since>0.7</since>
      <also>
        <see>tl.bang</see>
        <see view="link">tl.cue</see>
      </also>
      <aliases>
        <alias>tl.t</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">Outputs 1 when the associated cue section is activated, and 0 when switches to a different cue section.</tr>
        <tr lang="ru">Выводит 1 при активации связанной секции метки и 0 при переключении
        воспроизведения на другую секцию.</tr>
      </par>
    </info>
    <properties>
      <!-- @cue -->
      <property name="@cue" type="symbol" access="readonly" default="">
        <tr lang="en">related cue</tr>
        <tr lang="ru">связанная метка</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control inlet</tr>
          <tr lang="ru">управляющий вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">1 on cue enter, 0 on cue out</tr>
          <tr lang="ru">1 при входе в метку, 0 при выходе из метки</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
            [tl.cue]           [tl.cue]

[HR number=2]    [tl.toggle]              [tl.toggle]
|                |                        |
[cue $1(         [T]                      [T]
|
[tl.transport]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
