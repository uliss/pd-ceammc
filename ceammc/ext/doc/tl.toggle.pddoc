<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="tl.toggle">
        <title>tl.toggle</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">timeline toggle</tr>
                <tr lang="ru">переключатель на временной шкале</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>tl</category>
            <keywords>timeline toggle</keywords>
            <since>0.7</since>
            <also>
                <see>tl.bang</see>
                <see view="link">tl.cue</see>
            </also>
            <aliases>
                <alias>tl.t</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Output 1 when cue section activated, 0 when switched to other cue
                section</tr>
            </par>
        </info>
        <properties>
            <!-- @cue -->
            <property name="@cue" type="symbol" access="readonly" default="">
                <tr lang="en">related cue</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">control inlet</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">1 on cue enter, 0 on cue out</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
            [tl.cue]           [tl.cue]

[HR number=3]    [tl.toggle]              [tl.toggle]
|                |                        |
[cue $1(         [T]                      [T]
|
[tl.transport]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
