<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="symbol.num_compare">
        <title>symbol.num_compare</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">numeric symbol compare</tr>
                <tr lang="ru">цифровое сравнение символов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>symbol</category>
            <keywords>symbol num_compare compare</keywords>
            <since>0.4</since>
        </meta>
        <arguments>
            <argument name="WITH" type="symbol">
                <tr lang="en">symbol to compare</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @with -->
            <property name="@with" type="symbol" default="">
                <tr lang="en">symbol to compare</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">first compare symbol. Unicode strings also supported</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">compare first and second list elements</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">second compare symbol. Unicode strings also supported</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>1 if first symbol less then second, otherwise 0</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
/* common sort */

[list 10.txt 1.txt 14.txt 2.txt 6.txt 7.txt 9.txt(
|
[list.sort]
|
[ui.dt]

/* numeric sort */

[list 10.txt 1.txt 14.txt 2.txt 6.txt 7.txt 9.txt(
|
[list.sort_with] X [symbol.num_compare]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
