<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="system.colorpanel">
        <title>system.colorpanel</title>
        <meta>
            <authors>
                <author>Hans-Christoph Steiner</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">system color panel dialog popup</tr>
                <tr lang="ru">системный диалог выбора цвета</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>system</category>
            <keywords>colorpanel</keywords>
            <since>0.1</since>
        </meta>
        <mouse>
            <event type="left-click" editmode="false" keys="Shift">open color chooser</event>
        </mouse>
        <properties>
            <!-- @color -->
            <property name="@color" type="atom">
                <tr lang="en">current color</tr>
            </property>
            <!-- @d -->
            <property name="@d" type="alias">
                <tr lang="en">alias for @mode data. Output value Color datatype.</tr>
            </property>
            <!-- @f -->
            <property name="@f" type="alias">
                <tr lang="en">alias for @mode float. Output values as RGB list in 0-1 range.</tr>
            </property>
            <!-- @float -->
            <property name="@float" type="list" default="1 1 1">
                <tr lang="en">RGB color value in float range (0-1)</tr>
            </property>
            <!-- @h -->
            <property name="@h" type="alias">
                <tr lang="en">alias for @mode hex. Output value as #RRGGBB symbol.</tr>
            </property>
            <!-- @hex -->
            <property name="@hex" type="symbol" default="#FFFFFF">
                <tr lang="en">color value as #RRGGBB symbol</tr>
            </property>
            <!-- @i -->
            <property name="@i" type="alias">
                <tr lang="en">alias for @mode int. Output values as RGB list in 0-255 range.</tr>
            </property>
            <!-- @int -->
            <property name="@int" type="list" default="255 255 255">
                <tr lang="en">RGB color value in int range (0-255)</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" enum="float int hex data" default="float">
                <tr lang="en">output mode</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">opens colorpanel</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">opens colorpanel with selected color. The hex format #RRGGBB is
                    expected.</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">opens colorpanel with selected color. RGB color triplet expected
                    in float (0-1) or int (0-255) range, depending from @mode</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>messages: hex color symbol in format #RRGGBB or RGB color triplet in float
            (0-1) or int (0-255) range depending from @mode</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang(                [ui.menu float int hex]
|                     |
|  [symbol \#FFAA77(  [@mode $2(
|  |                  |
[system.colorpanel  @f]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
