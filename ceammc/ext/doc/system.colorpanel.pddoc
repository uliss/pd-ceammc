<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="system.colorpanel">
    <title>system.colorpanel</title>
    <meta>
      <authors>
        <author>Hans-Christoph Steiner</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">system color panel dialog popup</tr>
        <tr lang="ru">системный диалог выбора цвета</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>system</category>
      <keywords>colorpanel</keywords>
      <since>0.1</since>
    </meta>
    <mouse>
      <event type="left-click" editmode="false" keys="Shift">open color chooser</event>
    </mouse>
    <properties>
      <!-- @color -->
      <property name="@color" type="atom">
        <tr lang="en">current color</tr>
        <tr lang="ru">текущий цвет</tr>
      </property>
      <!-- @d -->
      <property name="@d" type="alias">
        <tr lang="en">alias for @mode data. Sets the color output mode as a Color data type.</tr>
        <tr lang="ru">сокращение для @mode data. Устанавливает режим вывода цвета в виде типа
        данных Color.</tr>
      </property>
      <!-- @f -->
      <property name="@f" type="alias">
        <tr lang="en">alias for @mode float. Sets the color output mode as an RGB list in the range
        [0..1].</tr>
        <tr lang="ru">сокращение для @mode float. Устанавливает режим вывода цвета в виде списка
        RGB в диапазоне [0..1].</tr>
      </property>
      <!-- @float -->
      <property name="@float" type="list" default="1 1 1" item-type="float" minvalue="0"
      maxvalue="1">
        <tr lang="en">current color value in RGB list format</tr>
        <tr lang="ru">текущее цветовое значение в формате списка RGB</tr>
      </property>
      <!-- @h -->
      <property name="@h" type="alias">
        <tr lang="en">alias for @mode hex. Sets the color output mode as a symbol in #RRGGBB
        format.</tr>
        <tr lang="ru">сокращение для: @mode hex. Устанавливает режим вывода цвета в виде символа в
        формате #RRGGBB</tr>
      </property>
      <!-- @hex -->
      <property name="@hex" type="symbol" default="#FFFFFF">
        <tr lang="en">current color value in #RRGGBB format</tr>
        <tr lang="ru">текущее цветовое значение в формате #RRGGBB</tr>
      </property>
      <!-- @i -->
      <property name="@i" type="alias">
        <tr lang="en">alias for @mode int. Sets the color output mode as an RGB list in the range
        [0..255].</tr>
        <tr lang="ru">сокращение для @mode int. Устанавливает режим вывода цвета в виде списка RGB
        в диапазоне [0..255].</tr>
      </property>
      <!-- @int -->
      <property name="@int" type="list" num-items="3" minvalue="0" maxvalue="255"
      default="255 255 255" item-type="int">
        <tr lang="en">current color value in RGB list format</tr>
        <tr lang="ru">текущее цветовое значение в формате списка RGB</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" enum="float int hex data" default="float">
        <tr lang="en">color output mode</tr>
        <tr lang="ru">режим вывода цвета</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">opens the color panel dialog</tr>
          <tr lang="ru">открывает диалог выбора цвета</tr>
        </in>
        <in on="symbol">
          <tr lang="en">opens the color panel dialog with the selected color. The hex format
          #RRGGBB is expected.</tr>
          <tr lang="ru">открывает диалог выбора цвета с указанным цветом. Ожидается
          шестнадцатеричный формат #RRGGBB.</tr>
        </in>
        <in on="list">
          <tr lang="en">opens the color panel dialog with the selected color. An RGB color triplet
          is expected in the float [0..1] or int [0..255] range, depending on the @mode
          property.</tr>
          <tr lang="ru">открывает диалог выбора цвета с указанным цветом. Ожидается список из трёх
          RGB-компонент в диапазоне [0..1] или [0..255] в зависимости от свойства @mode.</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="symbol">
          <tr lang="en">hex color in #RRGGBB format</tr>
          <tr lang="ru">цвет в шестнадцатеричном формате #RRGGBB</tr>
        </out>
        <out type="list">
          <tr lang="en">RGB color triplet in the float [0..1] or int [0..255] range depending on
          the @mode property.</tr>
          <tr lang="ru">список из трёх цветовых компонент RGB в диапазоне [0..1] или [0..255] в
          зависимости от значения свойства @mode.</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang(                [ui.menu float int hex]
|                     |
|  [symbol \#FFAA77(  [@mode $2 #a(
|  |
|  |                  [255 0 255 #b(
|  |
|  |                  [0.0 1.0 0.5 #c(
|  |
[system.colorpanel  @f #z]
|
[ui.dt]
[X a->z]
[X b->z]
[X c->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
