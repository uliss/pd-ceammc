<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="chrono.datetime">
    <title>chrono.datetime</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">outputs the current date and time</tr>
        <tr lang="ru">выводит текущую дату и время</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>base</category>
      <keywords>base</keywords>
      <since>0.9.6</since>
      <aliases>
        <alias>ceammc/datetime</alias>
        <alias>datetime</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">When a bang is received, the object outputs the current date and time split
        into two lists: the first outlet outputs the date as YEAR MONTH DAY, and the second outlet
        outputs the time as HOUR MIN SEC. By default the local time is used, set the @utc flag to
        get the time in UTC instead.</tr>
        <tr lang="ru">При получении bang объект выводит текущую дату и время в виде двух списков:
        из первого выхода выводится дата в формате YEAR MONTH DAY, из второго — время в формате
        HOUR MIN SEC. По умолчанию используется местное время, установите флаг @utc, чтобы получить
        время в UTC.</tr>
      </par>
    </info>
    <properties>
      <!-- @utc -->
      <property name="@utc" type="bool" default="0">
        <tr lang="en">output in UTC instead of local time</tr>
        <tr lang="ru">выводить время в UTC, а не по местному времени</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs HOUR MIN SEC to the second outlet and YEAR MONTH DAY to the first
          outlet</tr>
          <tr lang="ru">выводит HOUR MIN SEC из второго выхода и YEAR MONTH DAY из первого
          выхода</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">list: YEAR MONTH DAY</tr>
          <tr lang="ru">список: YEAR MONTH DAY</tr>
        </out>
      </outlet>
      <outlet>
        <out type="list">
          <tr lang="en">list: HOUR MIN SEC</tr>
          <tr lang="ru">список: HOUR MIN SEC</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]           [T]
|             |
[metro 1000]  [@utc $1(
|             |
[datetime     ]
|     ^|
|     [ui.dt]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
