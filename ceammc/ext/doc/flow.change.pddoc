<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flow.change">
        <title>flow.change</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">rejects repeated input messages</tr>
                <tr lang="ru">удаляет повторяющиеся сообщения</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>flow change</keywords>
            <since>0.3</since>
            <also>
                <see>change</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">The object passes input values only when it's changed. You can "set"
                the current value, or bang to force output.</tr>
                <tr lang="ru" finished="false">Объект передает входные значения только при
                изменении. Вы можете «установить» текущее значение или ударить, чтобы заставить
                выход.</tr>
            </par>
            <par>
                <tr lang="en">Note: [list a b c( and [a b c( are different values!</tr>
                <tr lang="ru" finished="false">Примечание: [перечислить a b c() и a b c() - разные
                значения!</tr>
            </par>
        </info>
        <properties>
            <!-- @onrepeat -->
            <property name="@onrepeat" type="symbol" default="">
                <tr lang="en">function called when repeat occurs</tr>
                <tr lang="ru" finished="false">Функция, возникающая при повторении</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">force output current value</tr>
                    <tr lang="ru" finished="false">выходное значение текущей величины</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">reset: reset state</tr>
                    <tr lang="ru" finished="false">Обновление: Reset State</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">set: sets current value without output</tr>
                    <tr lang="ru" finished="false">Устанавливает текущее значение без выхода</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output only if input changed</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 #a(  [list a b #b(    [@prop 123 #c(

   [B]  [symbol ABC #d(  [reset #e(
   |
[flow.change #z]
|
[ui.dt]

[flow.change-repeats]

[X a->z]
[X b->z]
[X c->z]
[X d->z]
[X e->z:1]
]]>
            </pdascii>
            <pdascii id="repeats">
<![CDATA[
/*non repeated (from step to step) random values*/

[B] [func try_again]
|    ^|
[random.int 1 3]
|
[flow.change @onrepeat try_again]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
