<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="is_any">
        <title>is_any</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks if the input has a general message type</tr>
                <tr lang="ru">проверяет, является ли входное сообщение сообщением общего типа</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>predicates</category>
            <keywords>predicate any</keywords>
            <also>
                <see>is_bang</see>
                <see>is_float</see>
                <see>is_symbol</see>
                <see>is_list</see>
            </also>
            <since>0.1</since>
        </meta>
        <inlets>
            <inlet>
                <in on="any">
                    <tr lang="en">outputs '1' to 1st outlet, otherwise '0'</tr>
                    <tr lang="ru" finished="false">выходы "1" - 1-й выход, иначе "0"</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">0 or 1</tr>
                    <tr lang="ru" finished="false">0 или 1</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">passes *any* message</tr>
                    <tr lang="ru" finished="false">Сообщение *any*</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[message( [1( [symbol a( [list a b c(
|         |   |        ___/
[is_any                ]
|     ^|
[tgl]  [print passed]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
