<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="random.atom">
        <title>random.atom</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">weighed choosing of the random atom from the specified list</tr>
                <tr lang="ru">случайный взвешенный выбор атомов из указанного списка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>random</category>
            <keywords>random atom</keywords>
            <also>
                <see>random.float</see>
                <see>random.gauss</see>
            </also>
            <since>0.9.1</since>
            <aliases>
                <alias>random.a</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Choose random atom from specified list (with weights) and output
                it.</tr>
            </par>
            <par>
                <tr lang="en">If no weights specified, choose elements with random uniform
                distribution.</tr>
            </par>
            <par>
                <tr lang="en">Use @seed property to get reproducible sequences. If @seed property
                was not explicitly set or specified, uses generator initialized with current
                time.</tr>
            </par>
            <par>
                <tr lang="en">Note: when @nonrep property is set, distribution is not uniform or
                weighted.</tr>
            </par>
        </info>
        <arguments>
            <argument name="VALUE" type="list">
                <tr lang="en">list of atoms</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @nonrep -->
            <property name="@nonrep" type="bool" default="0">
                <tr lang="en">generate non-repeated adjacent values (note: distribution will
                changed!)</tr>
            </property>
            <!-- @seed -->
            <property name="@seed" type="int" minvalue="0" default="0">
                <tr lang="en">generator seed</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="list" default="">
                <tr lang="en">list of atoms</tr>
            </property>
            <!-- @w -->
            <property name="@w" type="list" default="">
                <tr lang="en">list of atom weights</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output random atom</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">set list of elements to choose from. Note: clear all
                    weights.</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>random atom value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]           [T]
|             |
[metro 110]   [@nonrep $1(
|             |
[random.atom C5 D5 C6 Eb4 @w 2 1 6 3]
|
[pitch->midi]
|      |
[mtof] |
|      |
[osc~] [b]
|      |
[env.ar~ 10 70]
|
[ui.hgain~]     [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
