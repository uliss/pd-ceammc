<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="random.atom">
    <title>random.atom</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">weighed choosing of the random atom from the specified list</tr>
        <tr lang="ru">случайный взвешенный выбор атома из заданного списка</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>random</category>
      <keywords>random atom</keywords>
      <also>
        <see>random.float</see>
        <see>random.gauss</see>
      </also>
      <since>0.9.1</since>
      <aliases>
        <alias>random.a</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">chooses a random atom from the specified list (with weights) and outputs it</tr>
        <tr lang="ru">выбирает случайный атом из заданного списка (с весами) и выводит его</tr>
      </par>
      <par>
        <tr lang="en">if no weights are specified, elements are chosen with a uniform random distribution</tr>
        <tr lang="ru">если веса не заданы, элементы выбираются с равномерным случайным распределением</tr>
      </par>
      <par>
        <tr lang="en">use the @seed property to get reproducible sequences. If @seed is not set explicitly, a generator initialized with the current time is used</tr>
        <tr lang="ru">используйте свойство @seed для получения воспроизводимых последовательностей. Если @seed не задан явно, используется генератор, инициализированный текущим временем</tr>
      </par>
      <par>
        <tr lang="en">note: when @nonrep is set, the distribution is not uniform or weighted</tr>
        <tr lang="ru">примечание: если задано @nonrep, распределение не является равномерным или взвешенным</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to generate random note sequences with a musical weighting, for example to make some notes more likely than others</tr>
        <tr lang="ru">объект можно использовать для генерации случайных нотных последовательностей с музыкальными весами, например чтобы одни ноты выпадали чаще других</tr>
      </par>
    </info>
    <arguments>
      <argument name="VALUE" type="list">
        <tr lang="en">list of atoms</tr>
        <tr lang="ru">список атомов</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @nonrep -->
      <property name="@nonrep" type="bool" default="0">
        <tr lang="en">generate non-repeated adjacent values (note: the distribution will change)</tr>
        <tr lang="ru">генерировать неповторяющиеся соседние значения (примечание: распределение изменится)</tr>
      </property>
      <!-- @seed -->
      <property name="@seed" type="int" minvalue="0" default="0">
        <tr lang="en">generator seed</tr>
        <tr lang="ru">начальное значение генератора</tr>
      </property>
      <!-- @value -->
      <property name="@value" type="list" default="">
        <tr lang="en">list of atoms</tr>
        <tr lang="ru">список атомов</tr>
      </property>
      <!-- @w -->
      <property name="@w" type="list" default="">
        <tr lang="en">list of atom weights</tr>
        <tr lang="ru">список весов атомов</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output random atom</tr>
          <tr lang="ru">вывести случайный атом</tr>
        </in>
      </inlet>
      <inlet>
        <in on="list">
          <tr lang="en">set list of elements to choose from. Note: clears all weights</tr>
          <tr lang="ru">задать список элементов для выбора. Примечание: очищает все веса</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">random atom value</tr>
          <tr lang="ru">случайное значение атома</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]           [T]
|             |
[metro 110]   [@nonrep $1(
|             |
[random.atom C5 D5 C6 Eb4 @w 2 1 6 3]
|
[pitch->midi]
|      |
[mtof] |
|      |
[osc~] [b]
|      |
[env.ar~ 10 70]
|
[ui.hgain~]     [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
