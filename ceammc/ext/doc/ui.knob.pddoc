<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.knob" type="gui">
        <title>ui.knob</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">knob widget</tr>
                <tr lang="ru">виджет ручки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui knob</keywords>
            <since>0.1</since>
            <also>
                <see view="link">ui.slider</see>
            </also>
            <aliases>
                <alias view="link">ui.k</alias>
            </aliases>
        </meta>
        <info>
            <par>Simple knob widget with default range 0-1.</par>
        </info>
        <mouse>
            <event type="drag" editmode="false">change the knob value (with ⇧ change
            slowly)</event>
            <event type="wheel" editmode="false">change the knob value (with ⇧ change
            slowly)</event>
            <event type="double-click" editmode="false">set knob to the middle position</event>
            <event type="double-click" editmode="false" keys="Shift">toggle MIDI-learn mode (red
            border displayed)</event>
            <event type="right-click" editmode="false">open popup menu</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="drag" editmode="true" keys="Cmd">change the knob value (with ⇧ change
            slowly)</event>
            <event type="wheel" editmode="true" keys="Cmd">change the knob value (with ⇧ change
            slowly)</event>
            <event type="right-click" editmode="true" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <arguments>
            <argument name="MIN" type="float">
                <tr lang="en">min value</tr>
            </argument>
            <argument name="MAX" type="float">
                <tr lang="en">max value</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @active_scale -->
            <property name="@active_scale" type="bool" default="0">
                <tr lang="en">if should draw active scale</tr>
            </property>
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <!-- @fontname -->
            <property name="@fontname" type="symbol" default="Helvetica"
            enum="Courier DejaVu Helvetica Monaco Times">
                <tr lang="en">fontname</tr>
            </property>
            <!-- @fontsize -->
            <property name="@fontsize" type="int" minvalue="4" maxvalue="100" default="11">
                <tr lang="en">fontsize</tr>
            </property>
            <!-- @fontslant -->
            <property name="@fontslant" type="symbol" enum="roman italic" default="roman">
                <tr lang="en">font slant</tr>
            </property>
            <!-- @fontweight -->
            <property name="@fontweight" type="symbol" enum="normal bold" default="normal">
                <tr lang="en">font weight</tr>
            </property>
            <!-- @knob_color -->
            <property name="@knob_color" type="list" category="color" default="0 0.75 1 1">
                <tr lang="en">knob color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @label -->
            <property name="@label" type="symbol" default="(null)">
                <tr lang="en">label text</tr>
            </property>
            <!-- @label_align -->
            <property name="@label_align" type="symbol" enum="left center right" default="left">
                <tr lang="en">label horizontal align</tr>
            </property>
            <!-- @label_color -->
            <property name="@label_color" type="list" default="0 0 0 1">
                <tr lang="en">label color in RGB format within 0-1 range, for example: 0.2 0.4
                0.1</tr>
            </property>
            <!-- @label_inner -->
            <property name="@label_inner" type="bool" default="0">
                <tr lang="en">label position (1 - inner, 0 - outer).</tr>
            </property>
            <!-- @label_margins -->
            <property name="@label_margins" type="list" default="0 0">
                <tr lang="en">label offset in pixels</tr>
            </property>
            <!-- @label_side -->
            <property name="@label_side" type="symbol" enum="left top right bottom" default="top">
                <tr lang="en">label snap side</tr>
            </property>
            <!-- @label_valign -->
            <property name="@label_valign" type="symbol" enum="top center bottom" default="top">
                <tr lang="en">label vertical align</tr>
            </property>
            <!-- @max -->
            <property name="@max" type="float" default="1">
                <tr lang="en">maximum knob value</tr>
            </property>
            <!-- @midi_channel -->
            <property name="@midi_channel" type="int" minvalue="0" maxvalue="16" default="0">
                <tr lang="en">binded MIDI channel. 0 means listen to all channels</tr>
            </property>
            <!-- @midi_control -->
            <property name="@midi_control" type="int" minvalue="-1" maxvalue="127" default="-1">
                <tr lang="en">binded MIDI controller number. -1 means not binded to any
                controller.</tr>
            </property>
            <!-- @midi_pickup -->
            <property name="@midi_pickup" type="bool" default="1">
                <tr lang="en">pickup current value. If slider is binded to value, first time you
                should pass over this value to make binding. It prevents from sudden value change
                on first control change</tr>
            </property>
            <!-- @min -->
            <property name="@min" type="float" default="0">
                <tr lang="en">minimum knob value</tr>
            </property>
            <!-- @mouse_events -->
            <property name="@mouse_events" type="bool" default="0">
                <tr lang="en">mouse events output mode. If on outputs @mouse_down, @mouse_up and
                @mouse_drag events</tr>
            </property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="0" category="basic">
                <tr lang="en">pin mode. if 1 - put element to the lowest level</tr>
            </property>
            <!-- @presetname -->
            <property name="@presetname" type="symbol" category="basic" default="(null)">
                <tr lang="en">preset name for using with [ui.preset]</tr>
            </property>
            <!-- @receive -->
            <property name="@receive" type="symbol" category="basic" default="(null)">
                <tr lang="en">receive source</tr>
            </property>
            <!-- @scale -->
            <property name="@scale" type="symbol" default="linear" enum="linear log">
                <tr lang="en">scale mode. Linear or logarithmic.</tr>
            </property>
            <!-- @scale_color -->
            <property name="@scale_color" type="list" category="color" default="0.6 0.6 0.6 1">
                <tr lang="en">scale color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @send -->
            <property name="@send" type="symbol" category="basic" default="(null)">
                <tr lang="en">send destination</tr>
            </property>
            <!-- @show_range -->
            <property name="@show_range" type="bool" default="0">
                <tr lang="en">show knob range</tr>
            </property>
            <!-- @show_value -->
            <property name="@show_value" type="bool" default="0">
                <tr lang="en">show value</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" category="basic" default="40 40">
                <tr lang="en">element size (width, height pair)</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="float" default="0">
                <tr lang="en">current value</tr>
            </property>
        </properties>
        <methods>
            <!-- * -->
            <method name="*">multiply knob value without output 
            <param name="V" type="float" required="true">multiplied value</param></method>
            <!-- + -->
            <method name="+">add value to knob without output 
            <param name="V" type="float" required="true">added value</param></method>
            <!-- ++ -->
            <method name="++">increment knob value without output</method>
            <method name="-">subtract value from knob without output 
            <param name="V" type="float" required="true">subtracted value</param></method>
            <method name="--">decrement knob value without output</method>
            <!-- / -->
            <method name="/">divide knob value without output 
            <param name="V" type="float" required="true">denominator value</param></method>
            <!-- clear -->
            <method name="clear" category="preset">clears specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
            <!-- dump -->
            <method name="dump">dumps all object info to Pd console window</method>
            <!-- interp -->
            <method name="interp">interplolates between presets 
            <param name="IDX" type="float" required="true">preset fraction index</param></method>
            <!-- load -->
            <method name="load" category="preset">loads specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
            <!-- pos -->
            <method name="pos" category="basic">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
            <!-- random -->
            <method name="random">set knob to random value and output</method>
            <!-- set -->
            <method name="set">sets knob value without output 
            <param name="V" type="atom" required="true">new float value or
            'random'</param></method>
            <!-- store -->
            <method name="store" category="preset">stores specified preset 
            <param name="IDX" type="int" required="true">preset index</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">outputs knob value</xinfo>
                <xinfo on="float">sets knob value and output it</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>knob output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[hsl min=0 max=10]
|
|
[F]   [+ 0.1( [- 0.1( [* 2( [/ 2( [++, bang( [--, bang(
|     |       |       |     |     |          |
|     |       |       |     |     |          |
|     |       |       |     |     |          |
[ui.knob @size 30 30 @max 10                 ]
|
|
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
