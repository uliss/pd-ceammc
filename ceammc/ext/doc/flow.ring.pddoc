<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.ring">
    <title>flow.ring</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">shifting queue with parallel output of all stored elements</tr>
        <tr lang="ru">очередь со сдвигом и параллельным выводом всех элементов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>ring buffer dataflow</keywords>
      <since>0.9.1</since>
      <aliases>
        <alias>flow.&gt;&gt;</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object stores the last N messages in a queue and, on each new input, shifts the queue and outputs all stored elements in parallel: the newest element goes to the first outlet, the oldest to the last</tr>
        <tr lang="ru">объект хранит последние N сообщений в очереди и при каждом новом входе сдвигает очередь и выводит все элементы параллельно: самый новый идёт на первый выход, самый старый — на последний</tr>
      </par>
      <par>
        <tr lang="en">a bang on the right inlet outputs all buffer values, [get IDX( outputs the value at the specified index, [fill ARGS...( fills the buffer without output</tr>
        <tr lang="ru">bang на правом входе выводит все значения буфера, [get IDX( выводит значение по указанному индексу, [fill ARGS...( заполняет буфер без вывода</tr>
      </par>
    </info>
    <arguments>
      <argument name="LENGTH" type="int" minvalue="1" maxvalue="24">
        <tr lang="en">buffer length</tr>
        <tr lang="ru">длина буфера</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @length -->
      <property name="@length" type="int" default="2" minvalue="1" maxvalue="24" access="initonly">
        <tr lang="en">buffer length</tr>
        <tr lang="ru">длина буфера</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input</tr>
          <tr lang="ru">вход</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">output all buffer values</tr>
          <tr lang="ru">вывести все значения буфера</tr>
        </in>
        <in>
          <tr lang="en">get IDX: output buffer value at the specified index</tr>
          <tr lang="ru">get IDX: вывести значение буфера по указанному индексу</tr>
        </in>
        <in>
          <tr lang="en">fill ARGS...: fill buffer with the specified values (no output)</tr>
          <tr lang="ru">fill ARGS...: заполнить буфер указанными значениями (без вывода)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="any">
          <tr lang="en">first output</tr>
          <tr lang="ru">первый выход</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="any">
          <tr lang="en">... output</tr>
          <tr lang="ru">... выход</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="any">
          <tr lang="en">n-th output</tr>
          <tr lang="ru">N-й выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                             [flow.ring-sound]
|
[f 1] X [+ 1]        [fill -1, bang(
|                    |.
[flow.ring 4        {w=29}]
|      ^|     ^^|    ^^^|
[F]    [F]    [F]    [F ]
]]>
      </pdascii>
      <pdascii id="sound">
<![CDATA[
[T]    [F]
|      |.
[metro 150]
|
[random.i 43 80 @seed 1]
|
[mtof]               [fill 0, bang(
|                    |.
[flow.ring 4        {w=29}]
|      ^|     ^^|    ^^^|
[osc~] [osc~] [osc~] [osc~]
|      |.     |..    |...
[pan.spread~ 4      {w=29}] [ui.dsp~]
*|*
[ui.hgain2~ @size 15 206]
*|*
[fx.zita_rev1~ @drywet 0.4 {w=29}]
*|*
[dac~ {w=29}]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
