#X obj 300 1327 cnv 1 37 21 empty empty empty 17 7 0 10 -245695 -1 0;
#X text 300 1327 PATH: path to the file to save. Type: symbol.;
#X obj 250 1360 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
