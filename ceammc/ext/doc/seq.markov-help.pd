#X obj 250 870 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 870 @backoff;
#X text 270 870 If true \, fall back to a lower-order chain when the
current order has no transition for the current state. Type: bool.
Default value: 1\.;
#X obj 250 927 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 927 @restart;
#X text 270 927 If true \, restart the sequence from the beginning
when the generator reaches a state with no outgoing transitions. Type:
bool. Default value: 1\.;
#X obj 250 984 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 984 @t;
#X text 270 984 Temperature for sampling. Values above 1 make the output
more random \, values below 1 make it more predictable. Type: float.
Default value: 1\. Range: [0\..1024].;
#X obj 250 1041 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 1041 @top_k;
