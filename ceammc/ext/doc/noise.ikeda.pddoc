<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="noise.ikeda">
        <title>noise.ikeda</title>
        <meta>
            <authors>
                <author>André Sier</author>
            </authors>
            <description>
                <tr lang="en">Ikeda attractor</tr>
                <tr lang="ru">генератор хаоса на основе отображения Икеды</tr>
            </description>
            <license>%</license>
            <library>ceammc</library>
            <category>noise</category>
            <keywords>noise</keywords>
            <since>0.5</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Ikeda attractor</tr>
            </par>
            <par>
                <tr lang="en">z[n+1] = a + b*z[n]*exp(kj - pj/(1+|z[n]^2|))</tr>
            </par>
            <par>
                <tr lang="en">where z is a complex number</tr>
            </par>
            <par>
                <tr lang="en">real number formula by euler returns:</tr>
            </par>
            <par>
                <tr lang="en">===</tr>
            </par>
            <par>
                <tr lang="en">x[n+1] = a + k*(x0*cos(t[n])) - y0*sin(t[n]) )</tr>
            </par>
            <par>
                <tr lang="en">y[n+1] = k*(x0*sin(t[n])) - y0*cos(t[n])</tr>
            </par>
            <par>
                <tr lang="en">===</tr>
            </par>
            <par>
                <tr lang="en">where t[n] = b - p/(1 + x[n]^2 + y[n]^2)</tr>
            </par>
            <par>
                <tr lang="en">a = 0.85, b = 0.9, k = 0.4, p = 7.7</tr>
            </par>
            <par>
                <tr lang="en">a = 1.0, b = 0.9, k = 0.4, p = 6.0</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Ikeda_map">wiki: Ikeda map</a>
        </info>
        <arguments>
            <argument name="A" type="float">
                <tr lang="en">a value (optional)</tr>
            </argument>
            <argument name="B" type="float">
                <tr lang="en">b value (optional)</tr>
            </argument>
            <argument name="K" type="float">
                <tr lang="en">k value (optional)</tr>
            </argument>
            <argument name="P" type="float">
                <tr lang="en">p value (optional)</tr>
            </argument>
            <argument name="NX" type="float">
                <tr lang="en">nx value (optional)</tr>
            </argument>
            <argument name="NY" type="float">
                <tr lang="en">ny value (optional)</tr>
            </argument>
        </arguments>
        <methods>
            <!-- a -->
            <method name="a">
                <param name="A" type="float" required="true">
                    <tr lang="en">a value</tr>
                </param>
            </method>
            <!-- b -->
            <method name="b">
                <param name="B" type="float" required="true">
                    <tr lang="en">b value</tr>
                </param>
            </method>
            <!-- c -->
            <method name="c">
                <param name="K" type="float" required="true">
                    <tr lang="en">k value (note the "c" method in original a-chaos library)</tr>
                </param>
            </method>
            <!-- om -->
            <method name="om">
                <param name="OM" type="int" required="true">
                    <tr lang="en">enables output when cut or fold value is changed</tr>
                </param>
            </method>
            <!-- p -->
            <method name="p">
                <param name="P" type="float" required="true">
                    <tr lang="en">p value</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">reset state</method>
            <!-- set -->
            <method name="set">
                <param name="SET" type="float" required="true">
                    <tr lang="en">set to value</tr>
                </param>
            </method>
            <!-- x -->
            <method name="x">
                <param name="NX" type="float" required="true">
                    <tr lang="en">x value</tr>
                </param>
            </method>
            <!-- y -->
            <method name="y">
                <param name="NY" type="float" required="true">
                    <tr lang="en">y value</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">output value</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>x outlet</outlet>
            <outlet>y outlet</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 50 #metro]

  [T]         [F]
  |           |
  [om $1 #om( [set $1 #set( [reset #reset(

 [F]           [F]
 |             |
 [x $1 #x(     [y $1 #y(  

    [F]       [F]       [F]       [F]
    |         |         |         |
    [a $1 #a( [b $1 #b( [c $1 #c( [p $1 #p(  

[noise.ikeda #noise-obj]
|
[ui.display {i=1,o=0}]

[X x:0->noise-obj:0]  
[X y:0->noise-obj:0] 

[X a:0->noise-obj:0]
[X b:0->noise-obj:0]
[X c:0->noise-obj:0]
[X p:0->noise-obj:0] 

[X om:0->noise-obj:0]
[X set:0->noise-obj:0]
[X reset:0->noise-obj:0]

[X metro->noise-obj]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
