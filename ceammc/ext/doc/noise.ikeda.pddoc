<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="noise.ikeda">
    <title>noise.ikeda</title>
    <meta>
      <authors>
        <author>André Sier</author>
      </authors>
      <description>
        <tr lang="en">Ikeda attractor</tr>
        <tr lang="ru">генератор хаоса на основе отображения Икеды</tr>
      </description>
      <license>%</license>
      <library>ceammc</library>
      <category>noise</category>
      <keywords>noise</keywords>
      <since>0.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Ikeda attractor</tr>
        <tr lang="ru" finished="false">Аттрактор Икеда</tr>
      </par>
      <par>
        <tr lang="en">z[n+1] = a + b*z[n]*exp(kj - pj/(1+|z[n]^2|))</tr>
        <!-- old: z[n+1] ] = a + b*z[n]*exp(kj - pj/(1+ |z[n]^2
                |)) -->
        <tr lang="ru" finished="false">z[n+1] ] = a + b*z[n]*exp(kj - pj/(1+ |z[n]^2 |))</tr>
      </par>
      <par>
        <tr lang="en">where z is a complex number</tr>
        <tr lang="ru" finished="false">где z - комплексное число</tr>
      </par>
      <par>
        <tr lang="en">real number formula by euler returns:</tr>
        <tr lang="ru" finished="false">Формула реального числа от юлера возвращается:</tr>
      </par>
      <par>
        <tr lang="en">===</tr>
        <tr lang="ru" finished="false">= = =</tr>
      </par>
      <par>
        <tr lang="en">x[n+1] = a + k*(x0*cos(t[n])) - y0*sin(t[n]) )</tr>
        <tr lang="ru" finished="false">x[n+1] = a + k*(x0*cos(t[n])) — y0*sin(t[n]) .</tr>
      </par>
      <par>
        <tr lang="en">y[n+1] = k*(x0*sin(t[n])) - y0*cos(t[n])</tr>
        <tr lang="ru" finished="false">y[n+1] ] = k*(x0*sin(t[n])) - y0*cos(t[n])</tr>
      </par>
      <par>
        <tr lang="en">===</tr>
        <tr lang="ru" finished="false">= = =</tr>
      </par>
      <par>
        <tr lang="en">where t[n] = b - p/(1 + x[n]^2 + y[n]^2)</tr>
        <tr lang="ru" finished="false">где t[n] = b - p/(1 + x[n]^2 + y[n]^2)</tr>
      </par>
      <par>
        <tr lang="en">a = 0.85, b = 0.9, k = 0.4, p = 7.7</tr>
        <tr lang="ru" finished="false">a = 0,85, b = 0,9, k = 0,4, p = 7,7</tr>
      </par>
      <par>
        <tr lang="en">a = 1.0, b = 0.9, k = 0.4, p = 6.0</tr>
        <tr lang="ru" finished="false">a = 1,0, b = 0,9, k = 0,4, p = 6,0</tr>
      </par>
      <a href="https://en.wikipedia.org/wiki/Ikeda_map">wiki: Ikeda map</a>
    </info>
    <arguments>
      <argument name="A" type="float">
        <tr lang="en">a value (optional)</tr>
        <tr lang="ru" finished="false">значение (факультативно)</tr>
      </argument>
      <argument name="B" type="float">
        <tr lang="en">b value (optional)</tr>
        <tr lang="ru" finished="false">b значение (факультативно)</tr>
      </argument>
      <argument name="K" type="float">
        <tr lang="en">k value (optional)</tr>
        <tr lang="ru" finished="false">k значение (факультативно)</tr>
      </argument>
      <argument name="P" type="float">
        <tr lang="en">p value (optional)</tr>
        <tr lang="ru" finished="false">p значение (факультативно)</tr>
      </argument>
      <argument name="NX" type="float">
        <tr lang="en">nx value (optional)</tr>
        <tr lang="ru" finished="false">nx значение (факультативно)</tr>
      </argument>
      <argument name="NY" type="float">
        <tr lang="en">ny value (optional)</tr>
        <tr lang="ru" finished="false">ny value (необязательно)</tr>
      </argument>
    </arguments>
    <methods>
      <!-- a -->
      <method name="a">
        <param name="A" type="float" required="true">
          <tr lang="en">a value</tr>
          <tr lang="ru" finished="false">ценность</tr>
        </param>
      </method>
      <!-- b -->
      <method name="b">
        <param name="B" type="float" required="true">
          <tr lang="en">b value</tr>
          <tr lang="ru" finished="false">b значение</tr>
        </param>
      </method>
      <!-- c -->
      <method name="c">
        <param name="K" type="float" required="true">
          <tr lang="en">k value (note the "c" method in original a-chaos library)</tr>
          <!-- old: k значение (обратите внимание на метод "c" в
                    оригинальной библиотеке a-chaos) -->
          <tr lang="ru" finished="false">k значение (обратите внимание на метод "c" в оригинальной
          библиотеке a-chaos)</tr>
        </param>
      </method>
      <!-- om -->
      <method name="om">
        <param name="OM" type="int" required="true">
          <tr lang="en">enables output when cut or fold value is changed</tr>
          <!-- old: позволяет вывод при изменении значения разреза
                    или сгиба -->
          <tr lang="ru" finished="false">позволяет вывод при изменении значения разреза или
          сгиба</tr>
        </param>
      </method>
      <!-- p -->
      <method name="p">
        <param name="P" type="float" required="true">
          <tr lang="en">p value</tr>
          <tr lang="ru" finished="false">p значение</tr>
        </param>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset state</tr>
          <tr lang="ru" finished="false">состояние сброса</tr>
        </info>
      </method>
      <!-- set -->
      <method name="set">
        <param name="SET" type="float" required="true">
          <tr lang="en">set to value</tr>
          <tr lang="ru" finished="false">установить ценность</tr>
        </param>
      </method>
      <!-- x -->
      <method name="x">
        <param name="NX" type="float" required="true">
          <tr lang="en">x value</tr>
          <tr lang="ru" finished="false">x значение</tr>
        </param>
      </method>
      <!-- y -->
      <method name="y">
        <param name="NY" type="float" required="true">
          <tr lang="en">y value</tr>
          <tr lang="ru" finished="false">y значение</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output value</tr>
          <tr lang="ru" finished="false">выходная стоимость</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">x outlet</tr>
          <tr lang="ru" finished="false">х выход</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">y outlet</tr>
          <tr lang="ru" finished="false">выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[metro 50 #metro]

  [T]         [F]
  |           |
  [om $1 #om( [set $1 #set( [reset #reset(

 [F]           [F]
 |             |
 [x $1 #x(     [y $1 #y(  

    [F]       [F]       [F]       [F]
    |         |         |         |
    [a $1 #a( [b $1 #b( [c $1 #c( [p $1 #p(  

[noise.ikeda #noise-obj]
|
[ui.display {i=1,o=0}]

[X x:0->noise-obj:0]  
[X y:0->noise-obj:0] 

[X a:0->noise-obj:0]
[X b:0->noise-obj:0]
[X c:0->noise-obj:0]
[X p:0->noise-obj:0] 

[X om:0->noise-obj:0]
[X set:0->noise-obj:0]
[X reset:0->noise-obj:0]

[X metro->noise-obj]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
