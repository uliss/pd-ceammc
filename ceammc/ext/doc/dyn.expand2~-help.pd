#X msg 110 696 @id;
#X text 245 696 (initonly) Get/Set OSC address id. If specified \,
bind all properties to /ID/dyn_expand2/PROP_NAME osc address \, if
empty bind to /dyn_expand2/PROP_NAME. Type: symbol.;
#X msg 110 753 @osc;
#X text 245 753 (initonly) Get/Set OSC server name to listen. Type:
symbol.;
#X msg 110 783 @active;
#X text 245 783 Turn on/off dsp processing. Type: bool. Default value:
1\.;
#X msg 110 813 @attack;
#X text 245 813 Get/Set time constant when expander is turning on.
Type: float. Units: 'ms'. Default value: 10\. Range: 0.1\...100\.;
#X msg 110 855 @bypass;
#X text 245 855 Get/Set bypass flag. If true: bypass 'effected' signal.
Type: bool. Default value: 0\.;
#X msg 110 897 @hold;
#X text 245 897 Get/Set hold period. Type: float. Units: 'samp'. Default
value: 128\. Range: 1\...255\.;
#X msg 110 939 @knee;
#X text 245 939 Get/Set a gradual increase in gain reduction around
the threshold: below thresh-(knee/2) there is no gain reduction \,
above thresh+(knee/2) there is the same gain reduction as without a
knee \, and in between there is a gradual increase in gain reduction.
Type: float. Units: 'db'. Default value: 3\. Range: 0\...6\.;
#X msg 110 1042 @link;
#X text 245 1042 Get/Set the amount of linkage between the channels:
0 = each channel is independent \, 1 = all channels have the same amount
of gain reduction. Type: float. Default value: 1\. Range: 0\...1\.;
#X msg 110 1114 @range;
#X text 245 1114 Get/Set max expand range. Type: float. Units: 'db'.
Default value: -120\. Range: -120\...0\.;
#X msg 110 1156 @refresh;
#X text 245 1156 Get/Set expander level output time interval. If 0
- no output. Type: int. Units: 'ms'. Default value: 100\. Range: 0\...1000\.;
#X msg 110 1213 @release;
#X text 245 1213 Get/Set release time = time constant coming out of
expanding. Type: float. Units: 'ms'. Default value: 50\. Range: 1\...500\.;
#X msg 110 1270 @strength;
#X text 245 1270 Get/Set expander strength (0: no expanding \, 1: increase
level by @range db.). Type: float. Default value: 0\. Range: 0\...10\.;
#X msg 110 1327 @threshold;
#X text 245 1327 Get/Set level threshold above which compression kicks
in (100 dB = max level). Type: float. Units: 'db'. Default value: -48\.
Range: -60\...0\.;
#X msg 110 1384 @level?;
#X text 245 1384 (readonly) Get current expander level. Type: float.
Units: 'db'. Default value: 0\. Range: 0\...90\.;
