<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="math.sign">
    <title>math.sign</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">sign function</tr>
        <tr lang="ru">знаковая функция</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>math</category>
      <keywords>math sign</keywords>
      <since>0.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Returns:</tr>
        <tr lang="ru">Возвращает:</tr>
      </par>
      <par indent="1" space-bottom="-7">
          <tr lang="en">-1, if x &lt; 0</tr>
          <tr lang="ru">-1, если x &lt; 0</tr>
      </par>
      <par indent="1" space-bottom="-7">
        <tr lang="en">±0, if x == ±0</tr>
        <tr lang="ru">±0, если x == 0</tr>
      </par>
      <par indent="1" space-bottom="-7">
        <tr lang="en">+1, if x &gt; 0</tr>
        <tr lang="ru">+1, если x &gt; 0</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">the number</tr>
          <tr lang="ru">входное число</tr>
        </in>
        <in on="list">
          <tr lang="en">the list of numbers</tr>
          <tr lang="ru">список чисел</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">the result</tr>
          <tr lang="ru">результат</tr>
        </out>
        <out type="list">
          <tr lang="en">the result</tr>
          <tr lang="ru">результат</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]  [-10 -0 0 100(     [array \$0-sign yr=-1..1 w=340]
|    |
[math.sign]
|
[ui.dt]

[bang(
|
[list.seq -2 2 0.025]
|
[math.sign]
|
[list->array \$0-sign]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
