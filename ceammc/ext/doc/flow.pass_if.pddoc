<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="flow.pass_if">
        <title>flow.pass_if</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">passes the message, accepted by the predicate side-chain</tr>
                <tr lang="ru">пропускает значение, принятое предикатом боковой цепи обработки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>pass functional</keywords>
            <since>0.3</since>
            <aliases>
                <alias>ceammc/pass_if</alias>
                <alias>pass_if</alias>
            </aliases>
            <also>
                <see>flow.pass</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">conditional value pass according to *predicate* side-chain.
                *predicate* should accept value and ouput 0 or 1, for value passing.</tr>
                <!-- old: Условное значение проходит в соответствии с
                *predicate* side-chain. *предикат* должен принимать значение и выдавать 0 или 1,
                для прохождения значения. -->
                <tr lang="ru" finished="false">Условное значение проходит в соответствии с
                *predicate* side-chain. *предикат* должен принимать значение и выдавать 0 или 1,
                для прохождения значения.</tr>
            </par>
            <par>
                <tr lang="en">[&gt;=] [is_even] [is_list] - examples of predicates.</tr>
                <!-- old: [>=] [is_even] [is_list] — примеры
                предикатов. -->
                <tr lang="ru" finished="false">[&gt;=] [is_even] [is_list] — примеры
                предикатов.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <in>
                    <tr lang="en">input value</tr>
                    <tr lang="ru" finished="false">входная стоимость</tr>
                </in>
            </inlet>
            <inlet>
                <in on="int" minvalue="0" maxvalue="1">
                    <tr lang="en">conditional output from predicate object. '1' means pass, '0'
                    means reject</tr>
                    <!-- old: Условный выход из объекта предиката. «1»
                    означает проход, «0» означает отказ -->
                    <tr lang="ru" finished="false">Условный выход из объекта предиката. «1»
                    означает проход, «0» означает отказ</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">passed values</tr>
                    <tr lang="ru" finished="false">переданные значения</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">output to predicate side-chain</tr>
                    <tr lang="ru" finished="false">Производитель: Predicate Side Chain</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]                  [F]  [B] [1 2 3 4 5(
|                    |    |   |
[pass_if]X[is_even]  [flow.pass_if]X[is_list]
|                    |
[ui.dt]              [ui.dt]

[hsl]
|
[pass_if]X[< 64]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
