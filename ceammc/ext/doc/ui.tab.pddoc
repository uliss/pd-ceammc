<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="ui.tab" type="gui">
        <title>ui.tab</title>
        <meta>
            <authors>
                <author>Pierre Guillot</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">displays a list of text buttons or text toggles</tr>
                <tr lang="ru">список текстовых кнопок или текстовых переключателей</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui tab</keywords>
            <since>0.1</since>
            <also>
                <see view="link">ui.menu</see>
            </also>
        </meta>
        <mouse>
            <event type="left-click" editmode="false">select and output current tab</event>
            <event type="move" editmode="false">highlight hover tab</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_active_color.xml" />
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_pinned.xml" />
            <xi:include href="props_ui_receive.xml" />
            <xi:include href="props_ui_send.xml" />
            <xi:include href="props_preset.xml" />
            <!-- @count -->
            <property name="@count" type="int" default="0" access="readonly">
                <tr lang="en">number of tabs</tr>
                <tr lang="ru" finished="false">Количество вкладок</tr>
            </property>
            <!-- @current -->
            <property name="@current" type="int" default="0" access="readonly">
                <tr lang="en">current selected index (in switch mode)</tr>
                <tr lang="ru" finished="false">текущий выбранный индекс (в режиме
                переключения)</tr>
            </property>
            <!-- @hover_color -->
            <property name="@hover_color" type="list" default="0.5 0.5 0.5 1">
                <tr lang="en">hover color (list of red, green, blue values in 0-1 range)</tr>
                <tr lang="ru" finished="false">цвет наведения (список красных, зеленых, синих
                значений в диапазоне 0-1)</tr>
            </property>
            <!-- @items -->
            <property name="@items" type="list" default="">
                <tr lang="en">list of tab names</tr>
                <tr lang="ru" finished="false">Список имен вкладок</tr>
            </property>
            <!-- @orientation -->
            <property name="@orientation" type="bool" default="0">
                <tr lang="en">tab orientation. 1 is vertical, 0 is horizontal</tr>
                <tr lang="ru" finished="false">Ориентация на вкладку. 1 вертикально, 0
                горизонтально</tr>
            </property>
            <!-- @selected -->
            <property name="@selected" type="list" access="readonly" default="">
                <tr lang="en">list of selected items (in toggle mode)</tr>
                <tr lang="ru" finished="false">список выбранных элементов (в режиме
                переключения)</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="100 15">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
            <!-- @text_color -->
            <property name="@text_color" type="list" default="0 0 0 1">
                <tr lang="en">text color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @toggle -->
            <property name="@toggle" type="bool" default="0">
                <tr lang="en">toggle mode. In toggle moe multiple selection is possible</tr>
            </property>
        </properties>
        <methods>
            <!-- + STEP -->
            <method name="+ STEP">
                <info>
                    <tr lang="en">moves several steps forward on a loop (single mode only), output
                    newly selected item</tr>
                    <tr lang="ru" finished="false">перемещается на несколько шагов вперед по петле
                    (только в одном режиме), выводит вновь выбранный элемент</tr>
                </info>
            </method>
            <!-- - STEP -->
            <method name="- STEP">
                <info>
                    <tr lang="en">moves several step backwards on a loop (single mode only), output
                    newly selected item</tr>
                    <tr lang="ru" finished="false">перемещается на несколько шагов назад по петле
                    (только в одном режиме), выводит вновь выбранный элемент</tr>
                </info>
            </method>
            <!-- append -->
            <method name="append">
                <info>
                    <tr lang="en">appends new tab item</tr>
                    <tr lang="ru" finished="false">Добавить новый элемент вкладки</tr>
                </info>
                <param name="ATOMS" type="list" required="true">
                    <tr lang="en">item name</tr>
                    <tr lang="ru" finished="false">название пункта</tr>
                </param>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">clears specified preset</tr>
                    <tr lang="ru" finished="false">заданный заранее</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
            <!-- delete -->
            <method name="delete">
                <info>
                    <tr lang="en">removes item from tab</tr>
                    <tr lang="ru" finished="false">Удалить элемент из вкладки</tr>
                </info>
                <param name="IDX" type="int" minvalue="0" required="true">
                    <tr lang="en">removed item index</tr>
                    <tr lang="ru" finished="false">Удаленный индекс</tr>
                </param>
            </method>
            <!-- erase -->
            <method name="erase">
                <info>
                    <tr lang="en">clears all tab menu</tr>
                    <tr lang="ru" finished="false">Очистить все меню вкладок</tr>
                </info>
            </method>
            <!-- flip -->
            <method name="flip">
                <info>
                    <tr lang="en">flips radio (only in checklist mode)</tr>
                    <tr lang="ru" finished="false">flips radio (только в режиме контрольного
                    списка)</tr>
                </info>
            </method>
            <!-- insert -->
            <method name="insert">
                <info>
                    <tr lang="en">inserts new tab item before specified position</tr>
                    <tr lang="ru" finished="false">вставить новый пункт вкладки перед указанной
                    позицией</tr>
                </info>
                <param name="IDX" type="int" minvalue="0" required="true">
                    <tr lang="en">item position</tr>
                    <tr lang="ru" finished="false">пункт повестки дня</tr>
                </param>
                <param name="ATOM" type="atom" required="true">
                    <tr lang="en">item name</tr>
                    <tr lang="ru" finished="false">название пункта</tr>
                </param>
            </method>
            <!-- interp -->
            <method name="interp">
                <info>
                    <tr lang="en">for this object acts as *load*, no preset interpolation
                    performed</tr>
                    <tr lang="ru" finished="false">для этого объекта действует как *load*, не
                    выполняется предустановленная интерполяция</tr>
                </info>
            </method>
            <!-- load -->
            <method name="load">
                <info>
                    <tr lang="en">loads specified preset</tr>
                    <tr lang="ru" finished="false">заданный заранее заданный</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
            <!-- next -->
            <method name="next">
                <info>
                    <tr lang="en">moves to next item until last item is reached (single mode only).
                    Output new item</tr>
                    <tr lang="ru" finished="false">переходит к следующему пункту, пока не будет
                    достигнут последний пункт (только один режим). Выпустить новый пункт</tr>
                </info>
            </method>
            <!-- pos -->
            <method name="pos">
                <info>
                    <tr lang="en">set UI element position</tr>
                    <tr lang="ru" finished="false">Установите положение элемента UI</tr>
                </info>
                <param name="X" type="float" required="true">
                    <tr lang="en">top left x-coord</tr>
                    <tr lang="ru" finished="false">верхний левый x-coord</tr>
                </param>
                <param name="Y" type="float" required="true">
                    <tr lang="en">top right y-coord</tr>
                    <tr lang="ru" finished="false">верхняя правая y-coord</tr>
                </param>
            </method>
            <!-- prev -->
            <method name="prev">
                <info>
                    <tr lang="en">moves to previous item until first item is reached (single mode
                    only). Output new item</tr>
                    <tr lang="ru" finished="false">переходит к предыдущему пункту до достижения
                    первого пункта (только в одном режиме). Выпустить новый пункт</tr>
                </info>
            </method>
            <!-- random -->
            <method name="random">
                <info>
                    <tr lang="en">select random item. If called [random move( moves to random item
                    (excluding the current one)</tr>
                    <tr lang="ru" finished="false">Выберите случайный элемент. Если называется
                    [случайный ход (переходит к случайному пункту (исключая текущий))</tr>
                </info>
            </method>
            <!-- select -->
            <method name="select">
                <info>
                    <tr lang="en">selects specified item in tab</tr>
                    <tr lang="ru" finished="false">выбирает указанный элемент во вкладке</tr>
                </info>
                <param name="IDX" type="int" minvalue="0" required="true">
                    <tr lang="en">item index</tr>
                    <tr lang="ru" finished="false">элемент индекса</tr>
                </param>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">silently sets tab state.</tr>
                    <tr lang="ru" finished="false">Тихо устанавливает состояние вкладки.</tr>
                </info>
                <param name="IDX" type="int" minvalue="0" required="true">
                    <tr lang="en">item index</tr>
                    <tr lang="ru" finished="false">элемент индекса</tr>
                </param>
            </method>
            <!-- set_item -->
            <method name="set_item">
                <info>
                    <tr lang="en">renames tab item</tr>
                    <tr lang="ru" finished="false">Переименовывать элемент вкладки</tr>
                </info>
                <param name="IDX" type="int" required="true" minvalue="0">
                    <tr lang="en">item index</tr>
                    <tr lang="ru" finished="false">элемент индекса</tr>
                </param>
                <param name="ATOMS" type="list" required="true">
                    <tr lang="en">item name</tr>
                    <tr lang="ru" finished="false">название пункта</tr>
                </param>
            </method>
            <!-- store -->
            <method name="store">
                <info>
                    <tr lang="en">stores specified preset</tr>
                    <tr lang="ru" finished="false">магазины, указанные Preset</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">preset index</tr>
                    <tr lang="ru" finished="false">предустановленный индекс</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">in single mode outputs tab state as list: INDEX TAB_NAME. In
                    toggle mode outputs current state like: @selected 0 1 0 1 0 etc. and list of
                    two values: [CHANGED_IDX CHANGED_VALUE]</tr>
                    <tr lang="ru" finished="false">в одном режиме выводит состояние вкладки в виде
                    списка: INDEX TAB_NAME. В режиме переключения выводит текущее состояние,
                    например: @selected 0 1 0 1 0 и т.д. и список из двух значений: [CHANGED_IDX
                    CHANGED_VALUE]</tr>
                </in>
                <in on="float">
                    <tr lang="en">only in single mode: change tab by index and output list: INDEX
                    TAB_NAME</tr>
                    <tr lang="ru" finished="false">только в одном режиме: изменить вкладку по
                    индексу и выходному списку: INDEX TAB_NAME</tr>
                </in>
                <in on="any">
                    <tr lang="en">selects item equal to given and output list: INDEX TAB_NAME</tr>
                    <tr lang="ru" finished="false">Выберите пункт, равный данному и выходному
                    списку: INDEX TAB_NAME</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output</tr>
                    <tr lang="ru" finished="false">выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[append sqrt( [set_item 0 white_noise(      [next #d(
|                |
| [insert 0 saw( | [delete 1(  [+ 1 #c(     [random move #e(
| |              | |
| | [erase( [F]  | | [B] [tri( [T]          [random #a(
| | |       |    | | |   |     |
| | |       |    | | |   |     [@toggle $1( [flip #b(
| | |       |    | | |   |     |
[ui.tab      @items sin tri @size 350 15 @nosave 1 #x]
|       |
[print] [ui.dt]
[X a->x]
[X b->x]
[X c->x]
[X d->x]
[X e->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
