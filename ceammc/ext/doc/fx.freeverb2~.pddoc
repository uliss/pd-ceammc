<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="fx.freeverb2~">
        <title>fx.freeverb2~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">a stereo version of [fx.freeverb~]</tr>
                <tr lang="ru">стерео версия [fx.freeverb~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx reverb</keywords>
            <since>0.2</since>
        </meta>
        <info>
            <par>A simple Schroeder reverberator primarily developed by "Jezar at Dreampoint" that
            is extensively used in the free-software world. It uses four Schroeder allpasses in
            series and eight parallel Schroeder-Moorer filtered-feedback comb-filters for each
            audio channel, and is said to be especially well tuned.</par>
        </info>
        <arguments>
            <argument name="ROOM" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">room size</tr>
            </argument>
            <argument name="DRYWET" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
            </property>
            <!-- @damp -->
            <property name="@damp" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">damping of the lowpass comb filter</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.33">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet</tr>
            </property>
            <!-- @fr_damp -->
            <property name="@fr_damp" type="float" minvalue="0" maxvalue="1" default="0.0001">
                <tr lang="en">freeze room damp</tr>
            </property>
            <!-- @fr_room -->
            <property name="@fr_room" type="float" minvalue="0" maxvalue="1" default="0.999">
                <tr lang="en">freeze room size</tr>
            </property>
            <!-- @fr_time -->
            <property name="@fr_time" type="float" minvalue="0" maxvalue="1000" default="100"
            units="millisecond">
                <tr lang="en">length of freeze tail</tr>
            </property>
            <!-- @freeze -->
            <property name="@freeze" type="bool" default="0">
                <tr lang="en">freeze reverberation tail</tr>
            </property>
            <!-- @room -->
            <property name="@room" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">room size</tr>
            </property>
            <!-- @spread -->
            <property name="@spread" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">spatial spread between 0 and 1 with 1 for maximum spread</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">reset reverb</method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>left channel</xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo>right channel</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output left</outlet>
            <outlet type="audio">output right</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open %CEAMMC%/guitar1.wav, 1(
|
[expand_env #a]
|
|            [ui.knob]  [ui.knob]  [ui.knob]
|            |          |          |
[readsf~ #b] |          |          |
|            |          |          |
|            [@room $1( [@damp $1( [@drywet $1(
|            |          |          |
|            |          |          | [T]
|            |          |          | |
|            |          |          | [@freeze $1(
|            |          |          | |
[fx.freeverb2~  0.95    0.125        ]
|
[ui.gain~ @size 120 16] [ui.dsp~]
| \
[dac~]

[X a->b]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
