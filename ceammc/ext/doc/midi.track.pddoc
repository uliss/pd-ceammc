<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="midi.track">
        <title>midi.track</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">extracts the track from MidiFile message</tr>
                <tr lang="ru">извлекает трек из сообщения MidiFile</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>midi</category>
            <keywords>midi track</keywords>
            <since>0.4</since>
        </meta>
        <arguments>
            <argument name="TRACK" type="int" minvalue="0">
                <tr lang="en">init track number</tr>
                <tr lang="ru" finished="false">номер пути init</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @current -->
            <property name="@current" type="int" access="readonly" default="0">
                <tr lang="en">current event tick index</tr>
                <tr lang="ru" finished="false">Текущий индекс событий</tr>
            </property>
            <!-- @join -->
            <property name="@join" type="flag" default="0" access="initonly">
                <tr lang="en">join all tracks into one</tr>
                <tr lang="ru" finished="false">Соедините все треки в один</tr>
            </property>
            <!-- @nevents -->
            <property name="@nevents" type="int" access="readonly" default="0">
                <tr lang="en">number of events in track</tr>
                <tr lang="ru" finished="false">Количество событий в треке</tr>
            </property>
            <!-- @speed -->
            <property name="@speed" type="float" minvalue="0.01" default="1">
                <tr lang="en">play speed factor</tr>
                <tr lang="ru" finished="false">коэффициент скорости игры</tr>
            </property>
            <!-- @state -->
            <property name="@state" type="int" access="readonly" default="0" enum="0 1 2">
                <tr lang="en">current state. 0: stopped, 1: playing, 2: paused</tr>
                <tr lang="ru" finished="false">текущего состояния. 0: остановился, 1: играл, 2:
                остановился</tr>
            </property>
            <!-- @tempo -->
            <property name="@tempo" type="int" access="readonly" default="120">
                <tr lang="en">current tempo in TPQ</tr>
                <tr lang="ru" finished="false">Текущий темп в TPQ</tr>
            </property>
            <!-- @track -->
            <property name="@track" type="int" default="0" minvalue="0">
                <tr lang="en">track number</tr>
                <tr lang="ru" finished="false">номер трека</tr>
            </property>
        </properties>
        <methods>
            <!-- next -->
            <method name="next">
                <info>
                    <tr lang="en">moves playing position to next event. No output</tr>
                    <tr lang="ru" finished="false">Переносит игровую позицию на следующее событие.
                    Нет выхода</tr>
                </info>
            </method>
            <!-- pause -->
            <method name="pause">
                <info>
                    <tr lang="en">pause playing</tr>
                    <tr lang="ru" finished="false">играть паузу</tr>
                </info>
            </method>
            <!-- play -->
            <method name="play">
                <info>
                    <tr lang="en">start playing</tr>
                    <tr lang="ru" finished="false">Начать играть</tr>
                </info>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">set current event index to zero and send All Notes Off event</tr>
                    <tr lang="ru" finished="false">Установите текущий индекс событий до нуля и
                    отправьте все заметки</tr>
                </info>
            </method>
            <!-- seek -->
            <method name="seek">
                <info>
                    <tr lang="en">seek to specified tick</tr>
                    <tr lang="ru" finished="false">Стремиться к указанному клещам</tr>
                </info>
            </method>
            <!-- stop -->
            <method name="stop">
                <info>
                    <tr lang="en">stop playing and send All Notes Off event</tr>
                    <tr lang="ru" finished="false">Прекратите играть и отправьте все заметки</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output current event</tr>
                    <tr lang="ru" finished="false">выход текущего события</tr>
                </xinfo>
                <xinfo on="data">
                    <tr lang="en">MidiStream object: set new mifi file</tr>
                    <tr lang="ru" finished="false">Объект MidiStream: установлен новый файл
                    mifi</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">MidiEvent message</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">time in milliseconds until next MIDI event</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[openpanel] [symbol midi/bach-wtk2-prelude2.mid(
|           |
[read $1, bang(
|
[midi.file]
|
|  [play( [stop(
|  |      |
[midi.track @join @speed 0.7]
|
[midi.ev->note]
|
[unpack f f]
|      ^|
[mtof] [/ 100]
|      |
[osc~] |
|      |.
[*~     ]
*|*
[ui.hgain2~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
