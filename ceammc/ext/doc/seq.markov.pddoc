<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="seq.markov">
    <title>seq.markov</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Markov chain melody generator</tr>
        <tr lang="ru">генератор мелодий на основе цепей Маркова</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>seq</category>
      <keywords>seq markov chain melody generator</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object generates melodies using a Markov chain. It learns note
        transitions from the incoming note messages and then generates new sequences based on the
        learned probabilities</tr>
        <tr lang="ru">объект генерирует мелодии на основе цепи Маркова. Он обучается переходам
        между нотами на входящих сообщениях, а затем генерирует новые последовательности на основе
        выученных вероятностей</tr>
      </par>
      <par>
        <tr lang="en">@order sets the order of the Markov chain: 0 — order 0 (random notes), 1 —
        order 1 (each note depends on the previous one), 2 — order 2 (each note depends on the two
        previous ones)</tr>
        <tr lang="ru">@order задаёт порядок цепи Маркова: 0 — порядок 0 (случайные ноты), 1 —
        порядок 1 (каждая нота зависит от предыдущей), 2 — порядок 2 (каждая нота зависит от двух
        предыдущих)</tr>
      </par>
      <par>
        <tr lang="en">the first outlet outputs the generated MIDI pitch, the second outlet outputs
        the duration bin</tr>
        <tr lang="ru">первый выход выдаёт сгенерированную MIDI-ноту, второй выход — код
        длительности</tr>
      </par>
    </info>
    <arguments>
      <argument name="ORDER" type="int" enum="0 1 2">
        <tr lang="en">Markov chain order. See the @order property</tr>
        <tr lang="ru">порядок цепи Маркова. См. свойство @order</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @backoff -->
      <property name="@backoff" type="bool" default="1">
        <tr lang="en">if true, fall back to a lower-order chain when the current order has no
        transition for the current state</tr>
        <tr lang="ru">если true, переходить к цепи меньшего порядка, когда для текущего состояния
        нет перехода в текущем порядке</tr>
      </property>
      <!-- @order -->
      <property name="@order" type="int" enum="0 1 2" default="1" access="initonly">
        <tr lang="en">Markov chain order: 0 — order 0 (random notes), 1 — order 1 (each note
        depends on the previous one), 2 — order 2 (each note depends on the two previous ones)</tr>
        <tr lang="ru">порядок цепи Маркова: 0 — порядок 0 (случайные ноты), 1 — порядок 1 (каждая
        нота зависит от предыдущей), 2 — порядок 2 (каждая нота зависит от двух предыдущих)</tr>
      </property>
      <!-- @restart -->
      <property name="@restart" type="bool" default="1">
        <tr lang="en">if true, restart the sequence from the beginning when the generator reaches a
        state with no outgoing transitions</tr>
        <tr lang="ru">если true, начинать последовательность заново, когда генератор достигает
        состояния без исходящих переходов</tr>
      </property>
      <!-- @seed -->
      <property name="@seed" type="int" default="0" access="initonly">
        <tr lang="en">random seed for reproducible generation</tr>
        <tr lang="ru">начальное значение генератора для воспроизводимой генерации</tr>
      </property>
      <!-- @t -->
      <property name="@t" type="float" default="1" minvalue="0" maxvalue="1024">
        <tr lang="en">temperature for sampling. Values above 1 make the output more random, values
        below 1 make it more predictable</tr>
        <tr lang="ru">температура сэмплирования. Значения больше 1 делают вывод более случайным,
        меньше 1 — более предсказуемым</tr>
      </property>
      <!-- @top_k -->
      <property name="@top_k" type="int" default="0" minvalue="0" maxvalue="12">
        <tr lang="en">top-K sampling: if greater than 0, only the K most probable notes are
        considered when generating the next note</tr>
        <tr lang="ru">top-K сэмплирование: если больше 0, при генерации следующей ноты
        рассматриваются только K наиболее вероятных нот</tr>
      </property>
    </properties>
    <methods>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">clears the learned transitions</tr>
          <tr lang="ru">очищает выученные переходы</tr>
        </info>
      </method>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the generator to its initial state without clearing the learned
          transitions</tr>
          <tr lang="ru">сбрасывает генератор в начальное состояние без очистки выученных
          переходов</tr>
        </info>
      </method>
      <!-- train -->
      <method name="train">
        <info>
          <tr lang="en">trains the Markov chain on a single note with the given duration</tr>
          <tr lang="ru">обучает цепь Маркова на одной ноте с заданной длительностью</tr>
        </info>
        <param name="PITCH" type="int" required="true" minvalue="0" maxvalue="127">
          <tr lang="en">MIDI pitch</tr>
          <tr lang="ru">MIDI-нота</tr>
        </param>
        <param name="DUR" type="atom" required="true">
          <tr lang="en">note duration</tr>
          <tr lang="ru">длительность ноты</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">generate the next note</tr>
          <tr lang="ru">сгенерировать следующую ноту</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">generated MIDI pitch</tr>
          <tr lang="ru">сгенерированная MIDI-нота</tr>
        </out>
      </outlet>
      <outlet>
        <out type="int">
          <tr lang="en">generated duration bin</tr>
          <tr lang="ru">код сгенерированной длительности</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.keyboard]
|
|
|
|
[stripnote]              [T]     [F]
|                        |       |.
[train $1 4( [clear(     [metro 200]
|            |           |
[seq.markov 1            ]
|      |
[mtof] [F]
|
[t b f     ]
|         ^|
[click~]  [@freq $1(
|         |
[flt.resonlp~ #b]     [ui.dsp~]
|
[ui.hgain~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
