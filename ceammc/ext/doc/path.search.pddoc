<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="path.search">
    <title>path.search</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">file search</tr>
        <tr lang="ru">поиск файлов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>path</category>
      <keywords>path environment</keywords>
      <since>0.9.4</since>
      <also>
        <see>file.size</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">searches for a file by name in user-defined paths or Pure Data system paths</tr>
        <tr lang="ru">ищет файл по имени в путях, заданных пользователем, или в системных путях Pure Data</tr>
      </par>
      <par>
        <tr lang="en">outputs the first found file</tr>
        <tr lang="ru">выводит первый найденный файл</tr>
      </par>
      <par>
        <tr lang="en">search order: 1. user-defined paths (@paths property), 2. current patch directory, 3. Pure Data system path, 4. home directory</tr>
        <tr lang="ru">порядок поиска: 1. заданные пользователем пути (свойство @paths), 2. текущий каталог патча, 3. системный путь Pure Data, 4. домашний каталог</tr>
      </par>
      <par>
        <tr lang="en">absolute paths are processed before relative ones</tr>
        <tr lang="ru">абсолютные пути обрабатываются перед относительными</tr>
      </par>
      <par>
        <tr lang="en">the home directory can be specified with the '~' symbol</tr>
        <tr lang="ru">домашний каталог можно указать символом '~'</tr>
      </par>
      <par>
        <tr lang="en">note: by default the search request is performed asynchronously, so there is a delay between input and output</tr>
        <tr lang="ru">примечание: по умолчанию поисковый запрос выполняется асинхронно, поэтому между входом и выходом возникает задержка</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to find a sample or a configuration file without knowing its full path</tr>
        <tr lang="ru">объект можно использовать для поиска сэмпла или файла конфигурации, не зная полного пути к нему</tr>
      </par>
    </info>
    <arguments>
      <argument name="PATHS" type="list">
        <tr lang="en">list of paths, can be quoted to handle whitespace</tr>
        <tr lang="ru">список путей, можно заключать в кавычки для обработки пробелов</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @async -->
      <property name="@async" type="bool" default="1">
        <tr lang="en">perform async search in a separate thread</tr>
        <tr lang="ru">выполнять асинхронный поиск в отдельном потоке</tr>
      </property>
      <!-- @depth -->
      <property name="@depth" type="int" minvalue="-1" default="0">
        <tr lang="en">search recursion depth (-1: infinite)</tr>
        <tr lang="ru">глубина рекурсии поиска (-1: бесконечная)</tr>
      </property>
      <!-- @home -->
      <property name="@home" type="bool" default="1">
        <tr lang="en">search in the home directory</tr>
        <tr lang="ru">искать в домашнем каталоге</tr>
      </property>
      <!-- @nohome -->
      <property name="@nohome" type="alias">
        <tr lang="en">alias to @home 0, do not search in the home directory</tr>
        <tr lang="ru">псевдоним для @home 0, не искать в домашнем каталоге</tr>
      </property>
      <!-- @nostd -->
      <property name="@nostd" type="alias">
        <tr lang="en">alias to @std 0, do not search in standard dirs</tr>
        <tr lang="ru">псевдоним для @std 0, не искать в стандартных каталогах</tr>
      </property>
      <!-- @paths -->
      <property name="@paths" type="list" default="">
        <tr lang="en">user-defined search paths</tr>
        <tr lang="ru">заданные пользователем пути поиска</tr>
      </property>
      <!-- @std -->
      <property name="@std" type="bool" default="1">
        <tr lang="en">search in the Pure Data standard directory</tr>
        <tr lang="ru">искать в стандартном каталоге Pure Data</tr>
      </property>
      <!-- @sync -->
      <property name="@sync" type="alias">
        <tr lang="en">alias to @async 0</tr>
        <tr lang="ru">псевдоним для @async 0</tr>
      </property>
    </properties>
    <methods>
      <!-- cancel -->
      <method name="cancel">
        <info>
          <tr lang="en">cancel the search process</tr>
          <tr lang="ru">отменить процесс поиска</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">filename</tr>
          <tr lang="ru">имя файла</tr>
        </in>
        <in on="data:string">
          <tr lang="en">filename</tr>
          <tr lang="ru">имя файла</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="symbol">
          <tr lang="en">full filename</tr>
          <tr lang="ru">полное имя файла</tr>
        </out>
      </outlet>
      <outlet>
        <out type="bang">
          <tr lang="en">if not found</tr>
          <tr lang="ru">если не найдено</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[symbol loop_breakbeat.flac #a(             [path.search-std]

[symbol guitar1.wav(                        [path.search-home]
|
|  [S digits=30]
|  |
|  |  [@paths sound(/*change search path*/
|  |  |
[path.search #z]
|          ^|
|          [not found(
|          |
[ui.dt @size 500 35 @auto_size 0]

[X a->z]
]]>
      </pdascii>
      <pdascii id="std">
<![CDATA[
[guitar1.wav(     [T]
|                 |
[symbol]          [@std $1(
|                 |
[path.search @std 0]
|          ^|
|          [not found(
|          |
[ui.dt @size 500 35 @auto_size 0]
]]>
      </pdascii>
      <pdascii id="home">
<![CDATA[
/*unix or macos*/

[symbol .zshrc(  [T]
|                 |
|                 [@home $1(
|                 |
[path.search @home 0]
|          ^|
|          [not found(
|          |
[ui.dt @size 500 35 @auto_size 0]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
