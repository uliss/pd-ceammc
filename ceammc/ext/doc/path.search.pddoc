<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="path.search">
        <title>path.search</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">file search</tr>
                <tr lang="ru">поиск файлов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>path</category>
            <keywords>path environment</keywords>
            <since>0.9.4</since>
            <also>
                <see>file.size</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Searches file by name in user specified or PureData system
                paths.</tr>
            </par>
            <par>
                <tr lang="en">Outputs first found file.</tr>
            </par>
            <par>
                <tr lang="en">Search order: 1. user defined paths (@path property), 2. current
                patch directory, 3. PureData system path, 4. home directory.</tr>
            </par>
            <par>
                <tr lang="en">Absolute paths processed before relative.</tr>
            </par>
            <par>
                <tr lang="en">Home directory can be specified with '~' symbol.</tr>
            </par>
            <par>
                <tr lang="en">Note: by default search request is performed asynchronously, so a
                delay will occured between input and output.</tr>
            </par>
        </info>
        <arguments>
            <argument name="PATHS" type="list">
                <tr lang="en">list of paths, can be quoted to handle whitespace.</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @async -->
            <property name="@async" type="bool" default="1">
                <tr lang="en">perform async search in separate thread</tr>
            </property>
            <!-- @depth -->
            <property name="@depth" type="int" minvalue="-1" default="0">
                <tr lang="en">search recursion depth (-1: infinite)</tr>
            </property>
            <!-- @home -->
            <property name="@home" type="bool" default="1">
                <tr lang="en">search in home directory</tr>
            </property>
            <!-- @nohome -->
            <property name="@nohome" type="alias">
                <tr lang="en">alias to @home 0, do not search in home directory</tr>
            </property>
            <!-- @nostd -->
            <property name="@nostd" type="alias">
                <tr lang="en">alias to @std 0, do not search in standard dirs</tr>
            </property>
            <!-- @paths -->
            <property name="@paths" type="list" default="">
                <tr lang="en">user defined search paths</tr>
            </property>
            <!-- @std -->
            <property name="@std" type="bool" default="1">
                <tr lang="en">search in PureData standard directory</tr>
            </property>
            <!-- @sync -->
            <property name="@sync" type="alias">
                <tr lang="en">alias to @async 0</tr>
            </property>
        </properties>
        <methods>
            <!-- cancel -->
            <method name="cancel">
                <info>
                    <tr lang="en">cancel search process</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="symbol">
                    <tr lang="en">filename</tr>
                </xinfo>
                <xinfo on="data:string">
                    <tr lang="en">filename</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>symbol: full filename</outlet>
            <outlet>bang: if not found</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[symbol loop_breakbeat.flac #a(             [path.search-std]

[symbol guitar1.wav(                        [path.search-home]
|
|  [S digits=30]
|  |
|  |  [@paths sound(/*change search path*/
|  |  |
[path.search #z]
|          ^|
|          [not found(
|          |
[ui.dt @size 500 35 @auto_size 0]

[X a->z]
]]>
            </pdascii>
            <pdascii id="std">
<![CDATA[
[guitar1.wav(     [T]
|                 |
[symbol]          [@std $1(
|                 |
[path.search @std 0]
|          ^|
|          [not found(
|          |
[ui.dt @size 500 35 @auto_size 0]
]]>
            </pdascii>
            <pdascii id="home">
<![CDATA[
/*unix or macos*/

[symbol .bashrc(  [T]
|                 |
|                 [@home $1(
|                 |
[path.search @home 0]
|          ^|
|          [not found(
|          |
[ui.dt @size 500 35 @auto_size 0]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
