<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="route.prop">
    <title>route.prop</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">separates property messages from other types</tr>
        <tr lang="ru">отделяет сообщения со свойствами от сообщений других типов</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>route</keywords>
      <since>0.9.6</since>
      <also>
        <see>route.float</see>
        <see>route.any</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes property messages (such as [prop VALUE( and [prop?( requests) to the first outlet, and all other messages to the second outlet</tr>
        <tr lang="ru">объект направляет сообщения со свойствами (например, [prop VALUE( и запросы [prop?() на первый выход, а все остальные сообщения — на второй выход</tr>
      </par>
      <par>
        <tr lang="en">property messages are recognized by the leading '@' in the selector, for example @freq or @prop?</tr>
        <tr lang="ru">сообщения со свойствами распознаются по ведущему символу '@' в селекторе, например @freq или @prop?</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to separate property changes from ordinary control messages, for example to route parameter automation to a preset system and plain values to a display</tr>
        <tr lang="ru">объект можно использовать для отделения изменений свойств от обычных управляющих сообщений, например чтобы направлять автоматизацию параметров в систему пресетов, а простые значения — на дисплей</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="any">
          <tr lang="en">property to the first outlet, any other messages to the second outlet</tr>
          <tr lang="ru">свойство на первый выход, любые другие сообщения — на второй выход</tr>
        </in>
        <in on="bang">
          <tr lang="en">bang to the second outlet</tr>
          <tr lang="ru">bang на второй выход</tr>
        </in>
        <in on="float">
          <tr lang="en">float to the second outlet</tr>
          <tr lang="ru">число на второй выход</tr>
        </in>
        <in on="list">
          <tr lang="en">list to the second outlet</tr>
          <tr lang="ru">список на второй выход</tr>
        </in>
        <in on="symbol">
          <tr lang="en">symbol to the second outlet</tr>
          <tr lang="ru">символ на второй выход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">property output</tr>
          <tr lang="ru">выход свойств</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">other messages</tr>
          <tr lang="ru">другие сообщения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B #a]  [100 #b(  [symbol TEST #c(

 [list 1 2 3 #d(  [some message #e(

  [@prop A B #f(  [@prop? #g(



[route.prop #z]
|       ^|
[ui.dt]  |
         |
         [ui.dt]
[X a->z]
[X b->z]
[X c->z]
[X d->z]
[X e->z]
[X f->z]
[X g->z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
