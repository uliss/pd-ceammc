<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="math.floor">
        <title>math.floor</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">round to the largest integral value not greater than input value</tr>
                <tr lang="ru">округление до наибольшего целого значения, не превышающего входное
                значение</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math floor</keywords>
            <also>
                <see>math.ceil</see>
                <see>math.round</see>
                <see>math.trunc</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The floor() functions return the largest integral value less than or
                equal to x.</tr>
                <!-- old: Функции пола возвращают наибольшее интегральное
                значение меньше или равно x. -->
                <tr lang="ru" finished="false">Функции пола возвращают наибольшее интегральное
                значение меньше или равно x.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
                <tr lang="ru" finished="false">Особые ценности:</tr>
            </par>
            <par>
                <tr lang="en">floor(+-0) returns +-0.</tr>
                <tr lang="ru" finished="false">Пол (+-0) возвращается +-0.</tr>
            </par>
            <par>
                <tr lang="en">floor(+-infinity) returns +-infinity.</tr>
                <!-- old: Пол (+-бесконечность) возвращается
                +-бесконечность. -->
                <tr lang="ru" finished="false">Пол (+-бесконечность) возвращается
                +-бесконечность.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">input value</tr>
                    <tr lang="ru" finished="false">входная стоимость</tr>
                </in>
                <in on="list">
                    <tr lang="en">apply to all numeric values</tr>
                    <tr lang="ru" finished="false">применяется ко всем числовым значениям</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result value</tr>
                    <tr lang="ru" finished="false">значение результата</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]    [2.3 3.8 5.5 -2.3 -3.8 -5.5(
|      |
[math.floor]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
