<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="math.floor">
    <title>math.floor</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">round to the largest integral value not greater than input value</tr>
        <tr lang="ru">округление до наибольшего целого значения, не превышающего входное</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>math</category>
      <keywords>math floor</keywords>
      <also>
        <see>math.ceil</see>
        <see>math.round</see>
        <see>math.trunc</see>
      </also>
      <since>0.1</since>
    </meta>
    <info>
      <par style="warning">
        <tr lang="en">Special values:</tr>
        <tr lang="ru">Специальные значения:</tr>
      </par>
      <par indent="1" space-bottom="-7">
        <tr lang="en">floor(±0) returns ±0.</tr>
        <tr lang="ru">floor(±0) возвращает ±0.</tr>
      </par>
      <par indent="1" space-bottom="-7">
        <tr lang="en">floor(±infinity) returns ±infinity.</tr>
        <tr lang="ru">floor(±бесконечность) возвращает ±бесконечность.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input number</tr>
          <tr lang="ru">входное число</tr>
        </in>
        <in on="list">
          <tr lang="en">list of numbers</tr>
          <tr lang="ru">список чисел</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">result</tr>
          <tr lang="ru">результат</tr>
        </out>
        <out type="list">
          <tr lang="en">result</tr>
          <tr lang="ru">результат</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]    [2.3 3.8 5.5 -2.3 -3.8 -5.5(  [array \$0-floor yr=-4..4 w=280]
|      |
[math.floor]
|
[ui.dt]


[bang(
|
[list.seq -4 4 0.025]
|
[math.floor]
|
[list->array \$0-floor]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
