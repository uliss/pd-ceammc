<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="math.floor">
        <title>math.floor</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">round to the largest integral value not greater than input value</tr>
                <tr lang="ru">округление до наибольшего целого значения, не превышающего входное
                значение</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math floor</keywords>
            <also>
                <see>math.ceil</see>
                <see>math.round</see>
                <see>math.trunc</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The floor() functions return the largest integral value less than or
                equal to x.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
            </par>
            <par>
                <tr lang="en">floor(+-0) returns +-0.</tr>
            </par>
            <par>
                <tr lang="en">floor(+-infinity) returns +-infinity.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">input value</xinfo>
                <xinfo on="list">apply to all numeric values</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]    [2.3 3.8 5.5 -2.3 -3.8 -5.5(
|      |
[math.floor]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
