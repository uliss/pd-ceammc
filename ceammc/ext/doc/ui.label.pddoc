<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.label" type="gui">
        <title>ui.label</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">simple label widget</tr>
                <tr lang="ru">простой виджет надписи</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui label</keywords>
            <since>0.5</since>
        </meta>
        <info>
            <par>Label object with spaces, text-align, font customization and word-wrap</par>
        </info>
        <mouse>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <arguments>
            <argument name="TEXT" type="list">
                <tr lang="en">label text</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_ui_receive.xml" />
            <xi:include href="props_ui_receive.xml" />
            <!-- @align -->
            <property name="@align" type="symbol" default="left" enum="left center right">
                <tr lang="en">text align</tr>
            </property>
            <!-- @background_color -->
            <property name="@background_color" type="list" default="1 1 1 1">
                <tr lang="en">element background color (list of red, green, blue values in 0-1
                range)</tr>
            </property>
            <!-- @fontsize -->
            <property name="@fontsize" type="int" minvalue="4" maxvalue="100" default="32">
                <tr lang="en">font size</tr>
                <tr lang="ru">размер шрифта</tr>
            </property>
            <!-- @margin_bottom -->
            <property name="@margin_bottom" type="int" default="5">
                <tr lang="en">text bottom margin</tr>
            </property>
            <!-- @margin_left -->
            <property name="@margin_left" type="int" default="5">
                <tr lang="en">text left margin</tr>
            </property>
            <!-- @margin_right -->
            <property name="@margin_right" type="int" default="5">
                <tr lang="en">text right margin</tr>
            </property>
            <!-- @margin_top -->
            <property name="@margin_top" type="int" default="5">
                <tr lang="en">text top margin</tr>
            </property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="1">
                <tr lang="en">pin mode. If set to 1, it places the element at the furthest level on
                the canvas behind other elements</tr>
                <tr lang="ru">режим закрепления. Если 1 - помещает элемент на самый дальний уровень
                на холсте за другими элементам</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="list" default="300 47">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
            <!-- @text -->
            <property name="@text" type="list" default="Label">
                <tr lang="en">label text</tr>
            </property>
            <!-- @text_color -->
            <property name="@text_color" type="list" default="0 0 0 1">
                <tr lang="en">text color (list of red, green, blue values in 0-1 range)</tr>
            </property>
        </properties>
        <methods>
            <!-- append -->
            <method name="append">appends to @text end</method>
            <!-- clear -->
            <method name="clear">clear label text and clear @text property</method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">
                <tr lang="en">top left x-coord</tr>
            </param>
            <param name="Y" type="float" required="true">
                <tr lang="en">top right y-coord</tr>
            </param></method>
            <!-- prepend -->
            <method name="prepend">insert into beginning of @text</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">[hidden inlet] set the label text to the given float without
                changing @text property</xinfo>
                <xinfo on="symbol">[hidden inlet] set the label text without changing @text
                property</xinfo>
                <xinfo on="list">[hidden inlet] set the label text to the given list separated by
                spaces without changing @text property</xinfo>
                <xinfo on="any">[hidden inlet] set the label text to the given message separated by
                spaces without changing @text property</xinfo>
            </inlet>
        </inlets>
        <example>
            <pdascii>
<![CDATA[
/*[ui.label test label]*/

[hidden inlet(
|
[ui.label test label @receive lbl1]



[ui.label test label @align center @background_color 0.8 0.9 0.4 1 @receive lbl1]



[ui.label test label @align right @receive lbl1 @background_color 0.4 0.9 0.8 1]




[1( [F]   [a b c( [S]     [append A(  [prepend C(
|   |     |       |       |           |
|   |     |       |       |           |
[s lbl1                               ]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
