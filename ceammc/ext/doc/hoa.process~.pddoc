<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="hoa.process~">
        <title>hoa.process~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
                <author>Pierre Guillot</author>
                <author>Eliott Paris</author>
                <author>Thomas Le Meur</author>
            </authors>
            <description>
                <tr lang="en">patcher loader for multichannel processing</tr>
                <tr lang="ru">загрузчик патчей для многоканальной обработки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>hoa process 2d</keywords>
            <since>0.8</since>
            <aliases>
                <alias>hoa.2d.process~</alias>
                <alias>hoa.3d.process~</alias>
            </aliases>
            <also>
                <see>hoa.2d.decoder~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">hoa.process~ helps the modularization of patches for ambisonic or
                plane waves processing.</tr>
            </par>
            <par>
                <tr lang="en">hoa.process~ is a kind of poly~ object particulary suitable for
                multichannel ambisonic or plane wave processing. Create a patch/effect/operator,
                then parallelize it with the hoa.process~</tr>
            </par>
            <par>
                <tr lang="en">Target selector examples:</tr>
            </par>
            <par>
                <tr lang="en">#* send to all instances</tr>
            </par>
            <par>
                <tr lang="en">#: send list values spreaded amoung all instances, one value per
                instance</tr>
            </par>
            <par>
                <tr lang="en">#:2 send list values spreaded amoung instances with id&gt;=2</tr>
            </par>
            <par>
                <tr lang="en">#1 send to second instance</tr>
            </par>
            <par>
                <tr lang="en">#&lt;2 send to instance #0 and #1</tr>
            </par>
            <par>
                <tr lang="en">#&gt;2 send to instances with id&gt;2</tr>
            </par>
            <par>
                <tr lang="en">#2-4 send to instances with id in [2, 4] range</tr>
            </par>
            <a href="hoa/hoa.2d.process~-help.pd">CICM documentation</a>
        </info>
        <mouse>
            <event type="left-click" editmode="false">open process patch window</event>
        </mouse>
        <arguments>
            <argument name="N" type="int" minvalue="0">
                <tr lang="en">the order of decomposition</tr>
            </argument>
            <argument name="PATCH" type="symbol">
                <tr lang="en">patch name</tr>
            </argument>
            <argument name="DOMAIN" type="symbol" enum="harmonics planewaves">
                <tr lang="en">process domain: harmonics or planewaves</tr>
            </argument>
            <argument name="ARGS" type="list">
                <tr lang="en">instance arguments</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @args -->
            <property name="@args" type="list" access="initonly" default="">
                <tr lang="en">arguments passed to instances</tr>
            </property>
            <!-- @domain -->
            <property name="@domain" type="symbol" access="initonly" default="harmonics"
            enum="harmonics planewaves">
                <tr lang="en">process domain: harmonics or planewaves</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" minvalue="0" maxvalue="63" default="0"
            access="initonly">
                <tr lang="en">the order of decomposition/number of planewaves</tr>
            </property>
            <!-- @patch -->
            <property name="@patch" type="symbol" access="initonly" default="">
                <tr lang="en">patch name</tr>
            </property>
        </properties>
        <methods>
            <!-- dump -->
            <method name="dump">
                <info>
                    <tr lang="en">dumps all object info to Pd console window.</tr>
                </info>
            </method>
            <!-- on -->
            <method name="on">
                <info>
                    <tr lang="en">switch on/off DSP instance processing. Usage: on all 0|1 - turn
                    on/off all instances, on IDX 0|1 - turn on/off specified instance.</tr>
                </info>
            </method>
            <!-- open -->
            <method name="open">
                <info>
                    <tr lang="en">open Pd window for specified instance</tr>
                </info>
                <param name="IDX" type="int" required="true">
                    <tr lang="en">instance index</tr>
                </param>
            </method>
        </methods>
        <inlets dynamic="true">
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">first input harmonic/planewave</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="...">
                <xinfo>
                    <tr lang="en">... input harmonic/planewave</tr>
                </xinfo>
            </inlet>
            <inlet type="audio" number="n">
                <xinfo>
                    <tr lang="en">n-th input harmonic/planewave</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet type="audio">first harmonic/planewave output</outlet>
            <outlet type="audio" number="...">... harmonic/planewave output</outlet>
            <outlet type="audio" number="n">n-th harmonic/planewave output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[hoa/hoa.soundrone]     [phasor~ 0.15]   [ui.sliders #a]
|                       |                |
[ui.gain~ @size 120 14] [phase->rad~]    |
|                       |.               |
[hoa.encoder~ 5 {w=33,i=11,o=11}]        [msg \#: @db #b]/*spread*/
*|*
[hoa.process~ 11 hoa/hoa.fx.gain~ planewaves {w=35,i=12,o=11} #z]
*|* *|*
*|* *|*
*|* *|*
*|* [hoa.scope~ 5 @gain 4 {i=11} @size 164 164]
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
[hoa.recomposer~ 5 11 {w=35,i=11,o=11}]
*|*
[hoa.decoder~ 5 binaural @crop 32 {w=35,i=11,o=11}]
*|*
[dac~ {w=35}]

/* multiple [osc~] */                 [hoa.process~-dsp]

[60 90 2.1( [50 120 4.1(
|           |
[list.seq   ]
|
[list.each] X [mtof]
|
[msg \#:]
|.
[hoa.process~ 11 hoa/hoa.syn.osc~ planewaves {w=45,i=12,o=11}]
*|*
[pan.spread~ 11 {w=45,i=12,o=2}]
*|*
[ui.hgain2~ @size 15 318]
*|*
[dac~ {w=45}]

[ui.dsp~]
[X b->z:11]
#a @count 11 @min -60 @max 0 @size 200 55
]]>
            </pdascii>
            <pdascii id="dsp">
<![CDATA[
[ui.hrd* 6]
|
[list.separate @enumerate 1]
|
[on $1 $2(
|
|             [msg.onload \#: 100 200 300 400 500 600]
|             |.
[hoa.process~ 6 hoa/hoa.syn.osc~ planewaves {w=45,i=2,o=6}]
*|*
[pan.spread~ 6 {w=45,i=7,o=2}]
*|*
[ui.hgain2~ @size 15 318]
*|*
[dac~ {w=45}]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
