<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hoa.process~">
    <title>hoa.process~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
        <author>Pierre Guillot</author>
        <author>Eliott Paris</author>
        <author>Thomas Le Meur</author>
      </authors>
      <description>
        <tr lang="en">patcher loader for multichannel processing</tr>
        <tr lang="ru">загрузчик патчей для многоканальной обработки</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>spat</category>
      <keywords>hoa process 2d</keywords>
      <since>0.8</since>
      <aliases>
        <alias>hoa.2d.process~</alias>
        <alias>hoa.3d.process~</alias>
      </aliases>
      <also>
        <see>hoa.2d.decoder~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">hoa.process~ helps modularize patches for ambisonic or plane wave
        processing.</tr>
        <tr lang="ru">hoa.process~ помогает модуляризовать патчи для обработки амбисоников или
        плоских волн.</tr>
      </par>
      <par>
        <tr lang="en">hoa.process~ is a kind of poly~ object, particularly suitable for
        multichannel ambisonic or plane wave processing. Create a patch, effect or operator, then
        parallelize it with hoa.process~.</tr>
        <tr lang="ru">hoa.process~ — это разновидность объекта poly~, особенно удобная для
        многоканальной обработки амбисоников или плоских волн. Создайте патч, эффект или оператор,
        а затем распараллельте его с помощью hoa.process~.</tr>
      </par>
      <par>
        <tr lang="en">Target selector examples:</tr>
        <tr lang="ru">Примеры селекторов цели:</tr>
      </par>
      <par>
        <tr lang="en">#* — send to all instances</tr>
        <tr lang="ru">#* — отправить всем экземплярам</tr>
      </par>
      <par>
        <tr lang="en">#: — send list values spread among all instances, one value per instance</tr>
        <tr lang="ru">#: — отправить значения списка, распределив их по всем экземплярам, по одному
        значению на экземпляр</tr>
      </par>
      <par>
        <tr lang="en">#:2 — send list values spread among instances with id &gt;= 2</tr>
        <tr lang="ru">#:2 — отправить значения списка, распределив их по экземплярам с id &gt;=
        2</tr>
      </par>
      <par>
        <tr lang="en">#1 — send to the second instance</tr>
        <tr lang="ru">#1 — отправить второму экземпляру</tr>
      </par>
      <par>
        <tr lang="en">#&lt;2 — send to instances #0 and #1</tr>
        <tr lang="ru">#&lt;2 — отправить экземплярам #0 и #1</tr>
      </par>
      <par>
        <tr lang="en">#&gt;2 — send to instances with id &gt; 2</tr>
        <tr lang="ru">#&gt;2 — отправить экземплярам с id &gt; 2</tr>
      </par>
      <par>
        <tr lang="en">#2-4 — send to instances with id in the [2, 4] range</tr>
        <tr lang="ru">#2-4 — отправить экземплярам с id в диапазоне [2, 4]</tr>
      </par>
      <a href="hoa/hoa.2d.process~-help.pd">CICM documentation</a>
    </info>
    <mouse>
      <event type="left-click" editmode="false">open process patch window</event>
    </mouse>
    <arguments>
      <argument name="N" type="int" minvalue="0">
        <tr lang="en">the order of decomposition</tr>
        <tr lang="ru">порядок декомпозиции</tr>
      </argument>
      <argument name="PATCH" type="symbol">
        <tr lang="en">patch name</tr>
        <tr lang="ru">имя патча</tr>
      </argument>
      <argument name="DOMAIN" type="symbol" enum="harmonics planewaves">
        <tr lang="en">process domain: harmonics or planewaves</tr>
        <tr lang="ru">область обработки: гармоники или плоские волны</tr>
      </argument>
      <argument name="ARGS" type="list">
        <tr lang="en">instance arguments</tr>
        <tr lang="ru">аргументы экземпляров</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @args -->
      <property name="@args" type="list" access="initonly" default="">
        <tr lang="en">arguments passed to instances</tr>
        <tr lang="ru">аргументы, передаваемые экземплярам</tr>
      </property>
      <!-- @domain -->
      <property name="@domain" type="symbol" access="initonly" default="harmonics"
      enum="harmonics planewaves">
        <tr lang="en">process domain: harmonics or planewaves</tr>
        <tr lang="ru">область обработки: гармоники или плоские волны</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" minvalue="0" maxvalue="63" default="0" access="initonly">
        <tr lang="en">the order of decomposition / number of planewaves</tr>
        <tr lang="ru">порядок декомпозиции / число плоских волн</tr>
      </property>
      <!-- @patch -->
      <property name="@patch" type="symbol" access="initonly" default="">
        <tr lang="en">patch name</tr>
        <tr lang="ru">имя патча</tr>
      </property>
    </properties>
    <methods>
      <!-- dump -->
      <method name="dump">
        <info>
          <tr lang="en">dumps all object info to the Pd console window</tr>
          <tr lang="ru">выводит всю информацию об объекте в окно консоли Pd</tr>
        </info>
      </method>
      <!-- on -->
      <method name="on">
        <info>
          <tr lang="en">turns DSP processing of instances on or off. Usage: 'on all 0|1' — turn all
          instances on/off, 'on IDX 0|1' — turn the specified instance on/off.</tr>
          <tr lang="ru">включает или выключает DSP-обработку экземпляров. Использование: 'on all
          0|1' — включить или выключить все экземпляры, 'on IDX 0|1' — включить или выключить
          указанный экземпляр.</tr>
        </info>
      </method>
      <!-- open -->
      <method name="open">
        <info>
          <tr lang="en">opens the Pd window for the specified instance</tr>
          <tr lang="ru">открывает окно Pd для указанного экземпляра</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">instance index</tr>
          <tr lang="ru">индекс экземпляра</tr>
        </param>
      </method>
    </methods>
    <inlets dynamic="true">
      <inlet type="audio">
        <in>
          <tr lang="en">first input harmonic/planewave</tr>
          <tr lang="ru">первая входная гармоника / плоская волна</tr>
        </in>
      </inlet>
      <inlet type="audio" number="...">
        <in>
          <tr lang="en">... input harmonic/planewave</tr>
          <tr lang="ru">... входная гармоника / плоская волна</tr>
        </in>
      </inlet>
      <inlet type="audio" number="n">
        <in>
          <tr lang="en">n-th input harmonic/planewave</tr>
          <tr lang="ru">n-я входная гармоника / плоская волна</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet type="audio">
        <out type="any">
          <tr lang="en">first harmonic/planewave output</tr>
          <tr lang="ru">выход первой гармоники / плоской волны</tr>
        </out>
      </outlet>
      <outlet type="audio" number="...">
        <out type="any">
          <tr lang="en">... harmonic/planewave output</tr>
          <tr lang="ru">... выход гармоники / плоской волны</tr>
        </out>
      </outlet>
      <outlet type="audio" number="n">
        <out type="any">
          <tr lang="en">n-th harmonic/planewave output</tr>
          <tr lang="ru">выход n-й гармоники / плоской волны</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[hoa/hoa.soundrone]     [phasor~ 0.15]   [ui.sliders #a]
|                       |                |
[ui.gain~ @size 120 14] [phase->rad~]    |
|                       |.               |
[hoa.encoder~ 5 {w=33,i=11,o=11}]        [msg \#: @db #b]/*spread*/
*|*
[hoa.process~ 11 hoa/hoa.fx.gain~ planewaves {w=35,i=12,o=11} #z]
*|* *|*
*|* *|*
*|* *|*
*|* [hoa.scope~ 5 @gain 4 {i=11} @size 164 164]
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
*|*
[hoa.recomposer~ 5 11 {w=35,i=11,o=11}]
*|*
[hoa.decoder~ 5 binaural @crop 32 {w=35,i=11,o=11}]
*|*
[dac~ {w=35}]

/* multiple [osc~] */                 [hoa.process~-dsp]

[60 90 2.1( [50 120 4.1(
|           |
[list.seq   ]
|
[list.each] X [mtof]
|
[msg \#:]
|.
[hoa.process~ 11 hoa/hoa.syn.osc~ planewaves {w=45,i=12,o=11}]
*|*
[pan.spread~ 11 {w=45,i=12,o=2}]
*|*
[ui.hgain2~ @size 15 318]
*|*
[dac~ {w=45}]

[ui.dsp~]
[X b->z:11]
#a @count 11 @min -60 @max 0 @size 200 55
]]>
      </pdascii>
      <pdascii id="dsp">
<![CDATA[
[ui.hrd* 6]
|
[list.separate @enumerate 1]
|
[on $1 $2(
|
|             [msg.onload \#: 100 200 300 400 500 600]
|             |.
[hoa.process~ 6 hoa/hoa.syn.osc~ planewaves {w=45,i=2,o=6}]
*|*
[pan.spread~ 6 {w=45,i=7,o=2}]
*|*
[ui.hgain2~ @size 15 318]
*|*
[dac~ {w=45}]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
