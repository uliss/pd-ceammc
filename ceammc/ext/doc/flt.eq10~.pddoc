<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="flt.eq10~">
        <title>flt.eq10~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">graphic 10 band equalizer</tr>
                <tr lang="ru">графический 10-полосный эквалайзер</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>graphic filter equalizer</keywords>
            <since>0.1</since>
            <also>
                <see>flt.eq_peak~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">One band per octave. 5th-order Butterworth filters</tr>
            </par>
        </info>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @f1000 -->
            <property name="@f1000" type="float" minvalue="-70" maxvalue="10" default="0"
            units="decibel">
                <tr lang="en">gain at 1000Hz</tr>
            </property>
            <!-- @f125 -->
            <property name="@f125" type="float" minvalue="-70" maxvalue="10" default="0"
            units="decibel">
                <tr lang="en">gain at 125Hz</tr>
            </property>
            <!-- @f16000 -->
            <property name="@f16000" type="float" minvalue="-70" maxvalue="10" default="0"
            units="decibel">
                <tr lang="en">gain at 16000Hz</tr>
            </property>
            <!-- @f2000 -->
            <property name="@f2000" type="float" minvalue="-70" maxvalue="10" default="0"
            units="decibel">
                <tr lang="en">gain at 2000Hz</tr>
            </property>
            <!-- @f250 -->
            <property name="@f250" type="float" minvalue="-70" maxvalue="10" default="0"
            units="decibel">
                <tr lang="en">gain at 250Hz</tr>
            </property>
            <!-- @f31 -->
            <property name="@f31" type="float" minvalue="-70" maxvalue="10" default="0"
            units="decibel">
                <tr lang="en">gain at 31.25Hz</tr>
            </property>
            <!-- @f4000 -->
            <property name="@f4000" type="float" minvalue="-70" maxvalue="10" default="0"
            units="decibel">
                <tr lang="en">gain at 4000Hz</tr>
            </property>
            <!-- @f500 -->
            <property name="@f500" type="float" minvalue="-70" maxvalue="10" default="0"
            units="decibel">
                <tr lang="en">gain at 500Hz</tr>
            </property>
            <!-- @f62 -->
            <property name="@f62" type="float" minvalue="-70" maxvalue="10" default="0"
            units="decibel">
                <tr lang="en">gain at 62.5Hz</tr>
            </property>
            <!-- @f8000 -->
            <property name="@f8000" type="float" minvalue="-70" maxvalue="10" default="0"
            units="decibel">
                <tr lang="en">gain at 8000Hz</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset filter state to default</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>input signal</xinfo>
                <xinfo on="list">sets equalizer coefficients</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[fill 0.5, bang(        [r~ ssc #a]
|                       |
[ui.sliders @count 10]  [ui.spectroscope~ @size 300 100 @log_scale 1]
|
|
|
|
|
|
|
[lin->lin 0 1 -10 10]
|
|
|                 [F]
|                 |
|  [noise.white~] [@f8000 $1(
|  |              |
[flt.eq10~        ]
|
[ui.gain~ @size 120 14]  [ui.dsp~]
|\     |
[dac~] [s~ ssc]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
