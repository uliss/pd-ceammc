<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flt.c_apf">
        <title>flt.c_apf</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">allpass filter coefficients calculator for [flt.biquad~] object</tr>
                <tr lang="ru">калькулятор коэффициентов всепропускающего фильтра для объекта
                [flt.biquad~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter biquad hpf allpass</keywords>
            <since>0.9.2</since>
            <also>
                <see>flt.c_lpf</see>
                <see>hilbert~</see>
            </also>
            <aliases>
                <alias>ceammc/apf-&gt;biquad</alias>
                <alias>apf-&gt;biquad</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">Allpass filter is a signal processing filter that passes all
                frequencies equally in gain, but changes the phase relationship among various
                frequencies.</tr>
                <tr lang="ru" finished="false">Фильтр Allpass представляет собой фильтр обработки
                сигналов, который проходит все частоты одинаково, но изменяет фазовое соотношение
                между различными частотами.</tr>
            </par>
            <par>
                <tr lang="en">Most types of filter reduce the amplitude (i.e. the magnitude) of the
                signal applied to it for some values of frequency, whereas the all-pass filter
                allows all frequencies through without changes in level.</tr>
                <tr lang="ru" finished="false">Большинство типов фильтров уменьшают амплитуду (т.е.
                величину) сигнала, приложенного к нему, для некоторых значений частоты, тогда как
                фильтр полного прохода позволяет всем частотам проходить без изменений уровня.</tr>
            </par>
            <par>
                <tr lang="en">Calculates coefficients for transfer function: H(z)=(b0 + b1*z⁻¹ +
                b2*z⁻²)/(1 + a1*z⁻¹ + a2*z⁻²)</tr>
                <tr lang="ru" finished="false">Расчет коэффициентов для функции переноса: H(z)=(b0
                + b1*z−1 + b2*z−2)/(1 + a1*z−1 + a2*z−2)</tr>
            </par>
            <wiki name="All-pass_filter">Allpass filter</wiki>
        </info>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="0" maxvalue="22050">
                <tr lang="en">center frequency</tr>
                <tr lang="ru" finished="false">центральная частота</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @freq -->
            <property name="@freq" type="float" minvalue="0" maxvalue="22050" default="0"
            units="hertz">
                <tr lang="en">center frequency</tr>
                <tr lang="ru" finished="false">центральная частота</tr>
            </property>
            <!-- @q -->
            <property name="@q" type="float" minvalue="0.01" maxvalue="100" default="0.7071">
                <tr lang="en">quality factor: @freq/BANDWIDTH</tr>
                <tr lang="ru" finished="false">Коэффициент качества: @freq/BANDWIDTH</tr>
            </property>
            <!-- @rad -->
            <property name="@rad" type="flag" access="initonly">
                <tr lang="en">use angular frequency</tr>
                <tr lang="ru" finished="false">использовать угловую частоту</tr>
            </property>
        </properties>
        <methods>
            <!-- bw -->
            <method name="bw">
                <info>
                    <tr lang="en">set bandwidth in octaves</tr>
                    <tr lang="ru" finished="false">установленная полоса пропускания в октавах</tr>
                </info>
                <param name="OCT" type="float" required="true">
                    <tr lang="en">bandwidth</tr>
                    <tr lang="ru" finished="false">пропускная способность</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">filter frequency</tr>
                    <tr lang="ru" finished="false">частота фильтров</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">list: b0 b1 b2 a1 a2</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.hsl]                         [ui.hsl]
|                                |
[F]                              [F]
|                                |
[math.* expr(sr/2)]              [math.* pi()]
|                                |
[flt.c_apf]                      [flt.c_apf @rad]
|                                |
[ui.dt @float_width 5]           [ui.dt @float_width 5]




[flt.c_apf-plot]
]]>
            </pdascii>
            <pdascii id="plot">
<![CDATA[
[ui.hsl]                       [array CAPF0 size=200 w=300 h=90]
|
[F]
|
[math.* pi()]
|
[flt.c_apf @rad]
|
[t b l ]                       [array CAPF1 size=200 w=300 h=90]
|     ^|
|    [msg biquad]
|    |
[flt.freqz]
|   ^|
|   [array.plot CAPF1]
|
[array.plot CAPF0 @nan 0]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
