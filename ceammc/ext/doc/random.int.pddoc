<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="random.int">
    <title>random.int</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">uniform random integer generator in the specified range</tr>
        <tr lang="ru">равномерный генератор случайных целых чисел в заданном диапазоне</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>random</category>
      <keywords>random int</keywords>
      <also>
        <see>random.float</see>
        <see>random.gauss</see>
      </also>
      <since>0.1</since>
      <aliases>
        <alias>random.i</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">generates a pseudo-random number in the specified closed interval</tr>
        <tr lang="ru">генерирует псевдослучайное число в заданном замкнутом интервале</tr>
      </par>
      <par>
        <tr lang="en">use the @seed property to get reproducible sequences. If @seed is not set
        explicitly, a generator initialized with the current time is used</tr>
        <tr lang="ru">используйте свойство @seed для получения воспроизводимых последовательностей.
        Если @seed не задан явно, используется генератор, инициализированный текущим временем</tr>
      </par>
      <par>
        <tr lang="en">algorithm: 32-bit Mersenne Twister by Matsumoto and Nishimura, 1998</tr>
        <tr lang="ru">алгоритм: 32-битный Mersenne Twister Мацумото и Нисимуры, 1998</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to pick random indices, notes or other integer values,
        for example to select a random sample from a list</tr>
        <tr lang="ru">объект можно использовать для выбора случайных индексов, нот или других целых
        значений, например чтобы выбрать случайный сэмпл из списка</tr>
      </par>
      <a href="https://en.wikipedia.org/wiki/Mersenne_Twister">wiki: Mersenne Twister</a>
    </info>
    <arguments>
      <argument name="ARG" type="list">
        <tr lang="en">@min=ARG[0], @max=ARG[1], in case of a single arg: @min=0, @max=ARG[0]</tr>
        <tr lang="ru">@min=ARG[0], @max=ARG[1], в случае одного аргумента: @min=0, @max=ARG[0]</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @max -->
      <property name="@max" type="int" default="255">
        <tr lang="en">random range upper bound</tr>
        <tr lang="ru">верхняя граница случайного диапазона</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="int" default="0">
        <tr lang="en">random range lower bound</tr>
        <tr lang="ru">нижняя граница случайного диапазона</tr>
      </property>
      <!-- @seed -->
      <property name="@seed" type="int" minvalue="0" default="0">
        <tr lang="en">generator seed</tr>
        <tr lang="ru">начальное значение генератора</tr>
      </property>
    </properties>
    <methods>
      <!-- gen -->
      <method name="gen">
        <info>
          <tr lang="en">generate a list of random integers with the specified length</tr>
          <tr lang="ru">генерирует список случайных целых чисел с заданной длиной</tr>
        </info>
        <param name="N" type="int" required="true" minvalue="1">
          <tr lang="en">list length</tr>
          <tr lang="ru">длина списка</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">generate new number</tr>
          <tr lang="ru">генерировать новое число</tr>
        </in>
      </inlet>
      <inlet>
        <in on="int">
          <tr lang="en">set @min property</tr>
          <tr lang="ru">задать свойство @min</tr>
        </in>
      </inlet>
      <inlet>
        <in on="int">
          <tr lang="en">set @max property</tr>
          <tr lang="ru">задать свойство @max</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">int or list: generated value</tr>
          <tr lang="ru">число или список: сгенерированное значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B] [@seed 0( [gen 5(
|   |         |
|   |         |
|   |         |
[random.int -10 10]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
