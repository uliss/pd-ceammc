<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="random.int">
        <title>random.int</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">uniform random integer generator in the specified range</tr>
                <tr lang="ru">равномерный генератор случайных целых чисел в заданном диапазоне</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>random</category>
            <keywords>random int</keywords>
            <also>
                <see>random.float</see>
                <see>random.gauss</see>
            </also>
            <since>0.1</since>
            <aliases>
                <alias>random.i</alias>
            </aliases>
        </meta>
        <info>
            <par>Generates pseudo-random number in specified closed interval.</par>
            <par>Use @seed property to get reproducible sequences. If @seed property was not
            explicitly set or specified, uses generator initialized with current time.</par>
            <par>Algorithm: 32-bit Mersenne Twister by Matsumoto and Nishimura, 1998</par>
            <a href="https://en.wikipedia.org/wiki/Mersenne_Twister">wiki: Mersenne Twister</a>
        </info>
        <arguments>
            <argument name="ARG" type="list">
                <tr lang="en">@min=ARG[0], @max=ARG[1], in case of signle arg: @min=0,
                @max=ARG[0]</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @max -->
            <property name="@max" type="int" default="255">
                <tr lang="en">random range upper bound</tr>
            </property>
            <!-- @min -->
            <property name="@min" type="int" default="0">
                <tr lang="en">random range lower bound</tr>
            </property>
            <!-- @seed -->
            <property name="@seed" type="int" minvalue="0" default="0">
                <tr lang="en">generator seed</tr>
            </property>
        </properties>
        <methods>
            <!-- gen -->
            <method name="gen">generate list of random integers with specified length 
            <param name="N" type="int" required="true" minvalue="1">
                <tr lang="en">list length</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">generate new number</xinfo>
            </inlet>
            <inlet>
                <xinfo on="int">set @min property</xinfo>
            </inlet>
            <inlet>
                <xinfo on="int">set @max property</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>int or list: generated value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B] [@seed 0( [gen 5(
|   |         |
|   |         |
|   |         |
[random.int -10 10]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
