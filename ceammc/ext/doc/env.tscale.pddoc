<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="env.tscale">
        <title>env.tscale</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">envelope timescale</tr>
                <tr lang="ru">растяжение огибающей во времени</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>env</category>
            <keywords>time scale</keywords>
            <since>0.5</since>
            <also>
                <see>env.tshift</see>
                <see>envelope</see>
            </also>
        </meta>
        <arguments>
            <argument name="SCALE" type="float" minvalue="0">
                <tr lang="en">time-scale</tr>
                <tr lang="ru" finished="false">временные рамки</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @scale -->
            <property name="@scale" type="float" default="1" minvalue="0">
                <tr lang="en">time-scale</tr>
                <tr lang="ru" finished="false">временные рамки</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="data">
                    <tr lang="en">input envelope</tr>
                    <tr lang="ru" finished="false">входной конверт</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">scaled output envelope</tr>
                    <tr lang="ru" finished="false">Масштабируемый выпускной конверт</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ar 20 30, bang(
|
[envelope] [@scale 0.5( [@scale 1.5(
|          |            |
|          |            |
|          |            |
[env.tscale            1]
|
[env->array tscale_array @raw]


[array tscale_array size=10000 w=300 h=100 yr=0..1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
