<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env.tscale">
    <title>env.tscale</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">envelope timescale</tr>
        <tr lang="ru">растяжение огибающей во времени</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>time scale</keywords>
      <since>0.5</since>
      <also>
        <see>env.tshift</see>
        <see>envelope</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Scales the timing of an envelope: multiplies all time values of the envelope
        by the given scale factor. A factor of 1 leaves the envelope unchanged, values less than 1
        make it shorter, values greater than 1 make it longer. The shape of the envelope (its
        values) is not affected — only its duration.</tr>
        <tr lang="ru">Масштабирует время огибающей: умножает все временные значения огибающей на
        заданный коэффициент. Коэффициент 1 оставляет огибающую неизменной, значения меньше 1
        делают её короче, а больше 1 — длиннее. Форма огибающей (её значения) не изменяется —
        меняется только её длительность.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Tempo-relative envelopes — scaling an envelope so that its duration matches
        the current tempo or note length, for example making a short envelope for staccato and a
        long one for legato from the same base shape.</tr>
        <tr lang="ru">• Огибающие, зависящие от темпа — масштабирование огибающей так, чтобы её
        длительность соответствовала текущему темпу или длительности ноты, например короткая
        огибающая для staccato и длинная для legato из одной и той же базовой формы.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Real-time duration control — changing the overall length of an envelope in
        real time by linking the scale to a knob, a slider, or a performance parameter such as key
        velocity.</tr>
        <tr lang="ru">• Управление длительностью в реальном времени — изменение общей длины
        огибающей на лету путём привязки коэффициента к крутилке, слайдеру или параметру
        исполнения, например к скорости нажатия клавиши.</tr>
      </par>
    </info>
    <arguments>
      <argument name="SCALE" type="float" minvalue="0">
        <tr lang="en">time-scale</tr>
        <tr lang="ru">коэффициент масштабирования времени</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @scale -->
      <property name="@scale" type="float" default="1" minvalue="0">
        <tr lang="en">time-scale</tr>
        <tr lang="ru">коэффициент масштабирования времени</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="data">
          <tr lang="en">input envelope</tr>
          <tr lang="ru">входная огибающая</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">scaled output envelope</tr>
          <tr lang="ru">масштабированная огибающая</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ar 20 30, bang(
|
[envelope] [@scale 0.5( [@scale 1.5(
|          |            |
|          |            |
|          |            |
[env.tscale            1]
|
[env->array tscale_array @raw]


[array tscale_array size=10000 w=300 h=100 yr=0..1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
