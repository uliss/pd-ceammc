<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.sync_and">
        <title>math.sync_and</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sync logical AND operation</tr>
                <tr lang="ru">синхронное логическое И</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math sync logical and</keywords>
            <aliases>
                <alias>math.&amp;&amp;'</alias>
                <alias>ceammc/&amp;&amp;'</alias>
                <alias>&amp;&amp;'</alias>
            </aliases>
            <since>0.8</since>
            <also>
                <see>math.||'</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Only 1 and 0 values are accepted. Any other number treat as 1, but
                print error to console.</tr>
                <!-- old: Принимаются только значения 1 и 0. Любое другое
                число рассматривается как 1, но ошибка печати для консоли. -->
                <tr lang="ru" finished="false">Принимаются только значения 1 и 0. Любое другое
                число рассматривается как 1, но ошибка печати для консоли.</tr>
            </par>
        </info>
        <arguments>
            <argument name="V" type="int" enum="0 1">
                <tr lang="en">second value</tr>
                <tr lang="ru" finished="false">второе значение</tr>
            </argument>
        </arguments>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">set first value, calculate and output result</tr>
                    <!-- old: установить первое значение, вычислить и получить
                    результат -->
                    <tr lang="ru" finished="false">установить первое значение, вычислить и получить
                    результат</tr>
                </in>
                <in on="list">
                    <tr lang="en">pair: set first and second values, calculate and output
                    result</tr>
                    <!-- old: пара: установить первое и второе значения,
                    вычислить и вывести результат -->
                    <tr lang="ru" finished="false">пара: установить первое и второе значения,
                    вычислить и вывести результат</tr>
                </in>
            </inlet>
            <inlet>
                <in on="float">
                    <tr lang="en">change second value, calculate and output result</tr>
                    <!-- old: изменение второго значения, вычисление и
                    выходной результат -->
                    <tr lang="ru" finished="false">изменение второго значения, вычисление и
                    выходной результат</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output 1 or 0, according logical AND operation</tr>
                    <tr lang="ru" finished="false">выход 1 или 0, согласно логической операции
                    И</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[_]   [_]   /*same as:*/ [_]  [_]      /*0 0 | 0*/
|     |                  |    |
|     |                  |    [t b f]  /*0 1 | 0*/
|     |.                 |    | ^|.
[&&'    ]                [&&      ]    /*1 0 | 0*/
|                        |
[_]                      [_]           /*1 1 | 1*/
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
