<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="ui.link" type="gui">
    <title>ui.link</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">hyperlink widget</tr>
        <tr lang="ru">виджет гиперссылки</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category view="link">ui</category>
      <keywords>ui link</keywords>
      <since>0.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Link allows opening external URLs, not only Pd patches but all kinds of URLs
        supported by your OS. If a relative file path is given, it is searched for in the current
        directory, then the Pd doc directory and Pd external directories.</tr>
        <tr lang="ru">Ссылка позволяет открывать внешние URL-адреса — не только патчи Pd, но и
        любые типы адресов, поддерживаемые вашей операционной системой. Если указан относительный
        путь к файлу, поиск выполняется сначала в текущем каталоге, затем в каталоге документации
        Pd и в каталогах внешних библиотек Pd.</tr>
      </par>
    </info>
    <mouse>
      <event type="left-click" editmode="false">open link target</event>
      <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
      <event type="right-click" editmode="false" keys="Shift">open object help</event>
      <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
      <event type="right-click" editmode="true" keys="Shift">open the object help</event>
      <event type="right-click" editmode="true">opens Pd popup menu</event>
    </mouse>
    <arguments>
      <argument name="URL" type="symbol">
        <tr lang="en">@url property value</tr>
        <tr lang="ru">значение свойства @url</tr>
      </argument>
      <argument name="TITLE" type="symbol">
        <tr lang="en">@title property value</tr>
        <tr lang="ru">значение свойства @title</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_fontname.xml" />
      <xi:include href="props_fontsize.xml" />
      <xi:include href="props_fontslant.xml" />
      <xi:include href="props_fontweight.xml" />
      <xi:include href="props_pinned.xml" />
      <!-- @hover_color -->
      <property name="@hover_color" type="list" default="1 0 0.5 1" minvalue="0" maxvalue="1">
        <tr lang="en">RGB color when mouse pointer is over the link</tr>
        <tr lang="ru">RGB цвет, когда указатель мыши находится над ссылкой</tr>
      </property>
      <!-- @link_color -->
      <property name="@link_color" type="list" default="0 0.625 0.75 1" minvalue="0" maxvalue="1">
        <tr lang="en">RGB link color</tr>
        <tr lang="ru">RGB цвет ссылки</tr>
      </property>
      <!-- @title -->
      <property name="@title" type="symbol" default="&lt;no title&gt;">
        <tr lang="en">link title</tr>
        <tr lang="ru">текст ссылки</tr>
      </property>
      <!-- @url -->
      <property name="@url" type="symbol" default="&lt;no url&gt;">
        <tr lang="en">destination url</tr>
        <tr lang="ru">адрес, на который указывает ссылка</tr>
      </property>
    </properties>
    <methods>
      <!-- pos -->
      <method name="pos">
        <info>
          <tr lang="en">set UI element position</tr>
          <tr lang="ru">устанавливает положение элемента UI</tr>
        </info>
        <param name="X" type="float" required="true">
          <tr lang="en">top left x-coord</tr>
          <tr lang="ru">X-координата верхнего левого угла</tr>
        </param>
        <param name="Y" type="float" required="true">
          <tr lang="en">top left y-coord</tr>
          <tr lang="ru">Y-координата верхнего левого угла</tr>
        </param>
      </method>
    </methods>
    <example>
      <pdascii>
<![CDATA[
/* [ui.link @url vu-help.pd @title VU-help] */

[ui.link @url=vu-help.pd @title=VU-help]

/* [ui.link @url http://puredata.info @title puredata.info] */

[ui.link @url=http://puredata.info @title=puredata.info]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
