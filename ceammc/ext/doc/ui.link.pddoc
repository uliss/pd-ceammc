<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.link" type="gui">
        <title>ui.link</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">hyperlink widget</tr>
                <tr lang="ru">виджет гиперссылки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui link</keywords>
            <since>0.1</since>
        </meta>
        <info>
            <par>Link allows to open external URLs, not only Pd patches but all kind of URL
            supported by your OS. If relative file path is given, it searched in current directory,
            then Pd doc directory and Pd external directories</par>
        </info>
        <mouse>
            <event type="left-click" editmode="false">open link target</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
        </mouse>
        <arguments>
            <argument name="URL" type="symbol">
                <tr lang="en">@url property value</tr>
            </argument>
            <argument name="TITLE" type="symbol">
                <tr lang="en">@title property value</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @fontname -->
            <property name="@fontname" type="symbol" default="Helvetica"
            enum="Courier DejaVu Helvetica Monaco Times">
                <tr lang="en">fontname</tr>
            </property>
            <!-- @fontsize -->
            <property name="@fontsize" type="int" minvalue="4" maxvalue="100" default="11">
                <tr lang="en">fontsize</tr>
            </property>
            <!-- @fontslant -->
            <property name="@fontslant" type="symbol" enum="roman italic" default="roman">
                <tr lang="en">font slant</tr>
            </property>
            <!-- @fontweight -->
            <property name="@fontweight" type="symbol" enum="normal bold" default="normal">
                <tr lang="en">font weight</tr>
            </property>
            <!-- @hover_color -->
            <property name="@hover_color" type="list" default="1 0 0.5 1">
                <tr lang="en">color when mouse pointer is over element (list of red, green, blue
                values in 0-1 range)</tr>
            </property>
            <!-- @link_color -->
            <property name="@link_color" type="list" default="0 0.625 0.75 1">
                <tr lang="en">link color (list of red, green, blue values in 0-1 range)</tr>
            </property>
            <!-- @pinned -->
            <property name="@pinned" type="bool" default="0">
                <tr lang="en">pin mode. if 1 - put element to the lowest level</tr>
            </property>
            <!-- @title -->
            <property name="@title" type="symbol" default="&lt;no title&gt;">
                <tr lang="en">link title</tr>
            </property>
            <!-- @url -->
            <property name="@url" type="symbol" default="&lt;no url&gt;">
                <tr lang="en">destination url</tr>
            </property>
        </properties>
        <methods>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">top left x-coord</param>
            <param name="Y" type="float" required="true">top right y-coord</param></method>
        </methods>
        <example>
            <pdascii>
<![CDATA[
/* [ui.link @url vu-help.pd @title VU-help] */

[ui.link @url=vu-help.pd @title=VU-help]

/* [ui.link @url http://puredata.info @title puredata.info] */

[ui.link @url=http://puredata.info @title=puredata.info]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
