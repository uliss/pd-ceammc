<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="is_float">
        <title>is_float</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks if the input message is a *float*</tr>
                <tr lang="ru">проверка, является ли входное сообщение числом с плавающей
                точкой</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>predicates</category>
            <keywords>predicate float</keywords>
            <also>
                <see>is_any</see>
                <see>is_bang</see>
                <see>is_symbol</see>
                <see>is_list</see>
            </also>
            <since>0.1</since>
        </meta>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">outputs '1' to 1st outlet, otherwise '0'</tr>
                    <tr lang="ru" finished="false">выходы "1" - 1-й выход, иначе "0"</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">0 or 1</tr>
                    <tr lang="ru" finished="false">0 или 1</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">passes *float* message</tr>
                    <tr lang="ru" finished="false">Сообщение *Float*</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[100(  [any( [symbol a(  [list a b c(
|      |     |        ___/
[is_float             ]
|     ^|
[tgl]  [print passed]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
