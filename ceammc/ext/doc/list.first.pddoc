<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.first">
        <title>list.first</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">output the first list element</tr>
                <tr lang="ru">выводит первый элемент списка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list first</keywords>
            <since>0.1</since>
            <also>
                <see>list.last</see>
                <see>list.at</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">input list</tr>
                    <tr lang="ru" finished="false">вводный список</tr>
                </in>
                <in on="data:mlist">
                    <tr lang="en">input mlist</tr>
                    <tr lang="ru" finished="false">входной млечный</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">first list element</tr>
                    <tr lang="ru" finished="false">Элемент первого списка</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[-11 60 12( [list a b( [F]
|           |          |
[list.first            ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
