<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="data.color">
    <title>data.color</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">color data type</tr>
        <tr lang="ru">тип данных «цвет»</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data color</keywords>
      <since>0.9.7</since>
      <aliases>
        <alias>color</alias>
        <alias>ceammc/color</alias>
      </aliases>
    </meta>
    <mouse>
      <event type="left-click" editmode="false">open color chooser popup</event>
    </mouse>
    <arguments>
      <argument name="VALUE" type="atom">
        <tr lang="en">initial value</tr>
        <tr lang="ru">начальное значение</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @value -->
      <property name="@value" type="atom">
        <tr lang="en">current color</tr>
        <tr lang="ru">текущий цвет</tr>
      </property>
    </properties>
    <methods>
      <!-- alpha -->
      <method name="alpha">
        <info>
          <tr lang="en">set the alpha channel value</tr>
          <tr lang="ru">установить значение альфа-канала</tr>
        </info>
        <param name="ALPHA" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- blue -->
      <method name="blue">
        <info>
          <tr lang="en">set the blue channel value</tr>
          <tr lang="ru">установить значение синего канала</tr>
        </info>
        <param name="BLUE" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- brighten -->
      <method name="brighten">
        <info>
          <tr lang="en">make the color brighter</tr>
          <tr lang="ru">сделать цвет ярче</tr>
        </info>
        <param name="V" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- darken -->
      <method name="darken">
        <info>
          <tr lang="en">make the color darker</tr>
          <tr lang="ru">сделать цвет темнее</tr>
        </info>
        <param name="V" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- desaturate -->
      <method name="desaturate">
        <info>
          <tr lang="en">decrease the color saturation</tr>
          <tr lang="ru">уменьшить насыщенность цвета</tr>
        </info>
        <param name="V" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- flip -->
      <method name="flip">
        <info>
          <tr lang="en">flip the color hue</tr>
          <tr lang="ru">инвертировать оттенок цвета</tr>
        </info>
        <param name="V" type="float" minvalue="0" maxvalue="1" required="false">
          <tr lang="en">v</tr>
          <tr lang="ru">v</tr>
        </param>
      </method>
      <!-- grayscale -->
      <method name="grayscale">
        <info>
          <tr lang="en">convert the color to grayscale</tr>
          <tr lang="ru">преобразовать цвет в оттенки серого</tr>
        </info>
      </method>
      <!-- green -->
      <method name="green">
        <info>
          <tr lang="en">set the green channel value</tr>
          <tr lang="ru">установить значение зелёного канала</tr>
        </info>
        <param name="GREEN" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- hex -->
      <method name="hex">
        <info>
          <tr lang="en">set the color using a hex value #RGB or #RRGGBB</tr>
          <tr lang="ru">установить цвет с помощью hex-значения #RGB или #RRGGBB</tr>
        </info>
        <param name="HEX" type="symbol" required="true">
          <tr lang="en">hex color value</tr>
          <tr lang="ru">hex-значение цвета</tr>
        </param>
      </method>
      <!-- hsl -->
      <method name="hsl">
        <info>
          <tr lang="en">set the color in the HSL colorspace</tr>
          <tr lang="ru">установить цвет в цветовом пространстве HSL</tr>
        </info>
        <param name="HUE" type="float" minvalue="0" maxvalue="360" required="true">
          <tr lang="en">hue value</tr>
          <tr lang="ru">значение оттенка</tr>
        </param>
        <param name="SATURATION" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">saturation value</tr>
          <tr lang="ru">значение насыщенности</tr>
        </param>
        <param name="LIGHTNESS" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">lightness value</tr>
          <tr lang="ru">значение светлоты</tr>
        </param>
        <param name="ALPHA" type="float" minvalue="0" maxvalue="1" required="false">
          <tr lang="en">alpha value</tr>
          <tr lang="ru">значение альфа-канала</tr>
        </param>
      </method>
      <!-- hwb -->
      <method name="hwb">
        <info>
          <tr lang="en">set the color in the HWB colorspace</tr>
          <tr lang="ru">установить цвет в цветовом пространстве HWB</tr>
        </info>
        <param name="HUE" type="float" minvalue="0" maxvalue="360" required="true">
          <tr lang="en">hue value</tr>
          <tr lang="ru">значение оттенка</tr>
        </param>
        <param name="WHITENESS" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">whiteness value</tr>
          <tr lang="ru">значение белизны</tr>
        </param>
        <param name="BLACKNESS" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">blackness value</tr>
          <tr lang="ru">значение черноты</tr>
        </param>
        <param name="ALPHA" type="float" minvalue="0" maxvalue="1" required="false">
          <tr lang="en">alpha value</tr>
          <tr lang="ru">значение альфа-канала</tr>
        </param>
      </method>
      <!-- invert -->
      <method name="invert">
        <info>
          <tr lang="en">invert the color in the RGB colorspace</tr>
          <tr lang="ru">инвертировать цвет в цветовом пространстве RGB</tr>
        </info>
      </method>
      <!-- mix -->
      <method name="mix">
        <info>
          <tr lang="en">mix with the specified color</tr>
          <tr lang="ru">смешать с заданным цветом</tr>
        </info>
        <param name="COLOR" type="data:color" required="true">
          <tr lang="en">color to mix with</tr>
          <tr lang="ru">цвет для смешивания</tr>
        </param>
        <param name="MIX" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">mix amount</tr>
          <tr lang="ru">доля смешивания</tr>
        </param>
      </method>
      <!-- oklab -->
      <method name="oklab">
        <info>
          <tr lang="en">set the color in the OkLab colorspace</tr>
          <tr lang="ru">установить цвет в цветовом пространстве OkLab</tr>
        </info>
        <param name="HUE" type="float" minvalue="0" maxvalue="360" required="true">
          <tr lang="en">hue value</tr>
          <tr lang="ru">значение оттенка</tr>
        </param>
        <param name="a" type="float" minvalue="-1" maxvalue="1" required="true">
          <tr lang="en">a value</tr>
          <tr lang="ru">значение a</tr>
        </param>
        <param name="b" type="float" minvalue="-1" maxvalue="1" required="true">
          <tr lang="en">b value</tr>
          <tr lang="ru">значение b</tr>
        </param>
        <param name="ALPHA" type="float" minvalue="0" maxvalue="1" required="false">
          <tr lang="en">alpha value</tr>
          <tr lang="ru">значение альфа-канала</tr>
        </param>
      </method>
      <!-- red -->
      <method name="red">
        <info>
          <tr lang="en">set the red channel value</tr>
          <tr lang="ru">установить значение красного канала</tr>
        </info>
        <param name="RED" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- rgb -->
      <method name="rgb">
        <info>
          <tr lang="en">set RGB using floats</tr>
          <tr lang="ru">установить RGB с помощью чисел с плавающей точкой</tr>
        </info>
        <param name="RED" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">red value</tr>
          <tr lang="ru">значение красного</tr>
        </param>
        <param name="GREEN" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">green value</tr>
          <tr lang="ru">значение зелёного</tr>
        </param>
        <param name="BLUE" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">blue value</tr>
          <tr lang="ru">значение синего</tr>
        </param>
        <param name="ALPHA" type="float" minvalue="0" maxvalue="1" required="false">
          <tr lang="en">alpha value</tr>
          <tr lang="ru">значение альфа-канала</tr>
        </param>
      </method>
      <!-- rgb8 -->
      <method name="rgb8">
        <info>
          <tr lang="en">set RGB using int values</tr>
          <tr lang="ru">установить RGB с помощью целочисленных значений</tr>
        </info>
        <param name="RED" type="int" minvalue="0" maxvalue="255" required="true">
          <tr lang="en">red value</tr>
          <tr lang="ru">значение красного</tr>
        </param>
        <param name="GREEN" type="int" minvalue="0" maxvalue="255" required="true">
          <tr lang="en">green value</tr>
          <tr lang="ru">значение зелёного</tr>
        </param>
        <param name="BLUE" type="int" minvalue="0" maxvalue="255" required="true">
          <tr lang="en">blue value</tr>
          <tr lang="ru">значение синего</tr>
        </param>
        <param name="ALPHA" type="int" minvalue="0" maxvalue="255" required="false">
          <tr lang="en">alpha value</tr>
          <tr lang="ru">значение альфа-канала</tr>
        </param>
      </method>
      <!-- rotate -->
      <method name="rotate">
        <info>
          <tr lang="en">rotate the color hue</tr>
          <tr lang="ru">повернуть оттенок цвета</tr>
        </info>
        <param name="V" type="float" minvalue="0" maxvalue="360" required="true">
          <tr lang="en">rotation angle</tr>
          <tr lang="ru">угол поворота</tr>
        </param>
      </method>
      <!-- saturate -->
      <method name="saturate">
        <info>
          <tr lang="en">increase the color saturation</tr>
          <tr lang="ru">увеличить насыщенность цвета</tr>
        </info>
        <param name="V" type="float" minvalue="0" maxvalue="1" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- set -->
      <method name="set">
        <info>
          <tr lang="en">set the color</tr>
          <tr lang="ru">установить цвет</tr>
        </info>
        <param name="COLOR" type="data:color" required="true">
          <tr lang="en">new color value</tr>
          <tr lang="ru">новое значение цвета</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="data:color">
          <tr lang="en">set the color and output</tr>
          <tr lang="ru">установить цвет и вывести</tr>
        </in>
      </inlet>
      <inlet>
        <in on="data:color">
          <tr lang="en">set the color without output</tr>
          <tr lang="ru">установить цвет без вывода</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">data:color output</tr>
          <tr lang="ru">вывод data:color</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[hex \#AA0055 #a( [darken 0.1 #b( [brighten 0.1 #c( [rgb8 10 255 100 #h(

[red 1 #d( [green 0.5 #e( [blue 0.5 #f( [grayscale #g( [invert #i(

[rotate 20 #j( [saturate 0.1 #k( [desaturate 0.1 #l(

[msg.after 0 bang #x] [loadbang]
|                     |
[data.color \#DEF     ]
|
[rgb->hex]
|
[color $1 -1 -1(
|
[hsl]

[X a->x] [X b->x]  [X c->x]  [X d->x]  [X e->x]  [X f->x]  [X g->x]  [X h->x]  [X i->x]
[X j->x] [X k->x]  [X l->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
