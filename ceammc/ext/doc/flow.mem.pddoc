<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.mem">
    <title>flow.mem</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">store into the memory or output the control flow messages</tr>
        <tr lang="ru">сохраняет сообщения потока управления в памяти или выводит их</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>memory store</keywords>
      <since>0.9.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">A small in-memory storage with N cells. Each incoming message is written
        into the corresponding memory cell and can later be read back by sending a cell index to
        the last inlet, or all cells at once with a bang. Each cell has its own TTL counter: if
        the @ttl property is greater than 0, every output of the cell decrements its individual
        counter, and once it reaches zero, the cell is cleared (when @free is on) or kept with a
        zero counter.</tr>
        <tr lang="ru">Небольшое хранилище в оперативной памяти на N ячеек. Каждое входящее
        сообщение записывается в соответствующую ячейку и может быть прочитано позже: для этого
        нужно подать индекс ячейки на последний вход или bang, чтобы вывести все ячейки. У каждой
        ячейки свой счётчик TTL: если свойство @ttl больше 0, при каждом выводе ячейки её
        индивидуальный счётчик уменьшается, и когда он достигает нуля, ячейка очищается (если
        включён @free) либо остаётся с нулевым счётчиком.</tr>
      </par>
    </info>
    <arguments>
      <argument name="N" type="int" minvalue="1" maxvalue="32">
        <tr lang="en">number of memory cells</tr>
        <tr lang="ru">число ячеек памяти</tr>
      </argument>
      <argument name="TTL" type="int" minvalue="0" maxvalue="1024">
        <tr lang="en">see the @ttl property</tr>
        <tr lang="ru">см. свойство @ttl</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @free -->
      <property name="@free" type="bool" default="1">
        <tr lang="en">clear cell mode. If on — clears the cell after zero is reached</tr>
        <tr lang="ru">режим очистки ячейки. Если включён — очищает ячейку после достижения
        нуля</tr>
      </property>
      <!-- @n -->
      <property name="@n" type="int" default="1" minvalue="1" maxvalue="32">
        <tr lang="en">number of memory cells</tr>
        <tr lang="ru">число ячеек памяти</tr>
      </property>
      <!-- @ttl -->
      <property name="@ttl" type="int" default="0" minvalue="0" maxvalue="1024">
        <tr lang="en">time-to-live counter. When a new value is set, the cell counter for that
        cell is set to this value. Every time the cell is output, its individual counter (not this
        property!) is decremented, until it reaches zero. After that, if @free is on, the cell is
        cleared. If this property equals zero, the cell never cleared.</tr>
        <tr lang="ru">счётчик времени жизни. При установке нового значения счётчик соответствующей
        ячейки устанавливается в это значение. При каждом выводе ячейки её индивидуальный счётчик
        (не это свойство!) уменьшается, пока не достигнет нуля. После этого, если включён @free,
        ячейка очищается. Если свойство равно нулю, ячейка никогда не очищается.</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet number="1">
        <in>
          <tr lang="en">input: store in the 1st memory cell</tr>
          <tr lang="ru">вход: запись в 1-ю ячейку памяти</tr>
        </in>
      </inlet>
      <inlet number="...">
        <in>
          <tr lang="en">input: store in the ... memory cell</tr>
          <tr lang="ru">вход: запись в ... ячейку памяти</tr>
        </in>
      </inlet>
      <inlet number="n">
        <in>
          <tr lang="en">input: store in the n-th memory cell</tr>
          <tr lang="ru">вход: запись в n-ю ячейку памяти</tr>
        </in>
      </inlet>
      <inlet number="n+1">
        <in on="bang">
          <tr lang="en">output all cells</tr>
          <tr lang="ru">вывести все ячейки</tr>
        </in>
        <in on="int">
          <tr lang="en">output the specified cell</tr>
          <tr lang="ru">вывести указанную ячейку</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet number="1">
        <out type="any">
          <tr lang="en">output the 1st cell</tr>
          <tr lang="ru">вывод 1-й ячейки</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="any">
          <tr lang="en">output the ... cell</tr>
          <tr lang="ru">вывод ... ячейки</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="any">
          <tr lang="en">output the n-th cell</tr>
          <tr lang="ru">вывод n-й ячейки</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii id="osc~">
<![CDATA[
[inlet]
|
[t b f]
|   ^|
|   [mtof]
|   |
|   [osc~]
|   |
[env.ar~ 5 60]
|
[outlet~]
]]>
      </pdascii>
      <pdascii id="main">
<![CDATA[
[ui.keyboard]
|
|
|
|
|            [T]        [F]
|            |          |
[stripnote]  [metro 65] [prop.set @ttl]
|            |.         |.
[flow.mem          @ttl 4]
|
[flow.mem-osc~]
|
[pan~ {i=1,o=2}]
*|*
[ui.hgain2~]        [ui.dsp~]
*|*
[dac~]

[flow.mem-more]
]]>
      </pdascii>
      <pdascii id="more">
<![CDATA[
[msg.onload 43.5 78 43 85]
|
[ui.sliders 4 @min 30 @max 90]
|
|                                               [T]    [F]
|                                               |      |.
|                                               [metro 100]
|                                               |  |
|                              [F]              |  [random.i 0 3] [ui.hrd 2]
|                              |                |  |.             |..
[unpack f f f f {i=1,o=4}]     [prop.set @ttl]  [flow.mux 2 1       ]
*|*                            |....            |....
[flow.mem 4                          {i=5,o=4,w=66} ]
|               ^|              ^^|             ^^^|
[flow.mem-osc~] [flow.mem-osc~] [flow.mem-osc~] [flow.mem-osc~]
|               |.              |..             |...
[pan.spread~ 4                       {i=4,o=2,w=66}]
*|*
[ui.hgain2~ {i=2,o=2}] [ui.dsp~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
