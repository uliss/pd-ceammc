<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="proto.ltc.in~">
        <title>proto.ltc.in~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">LTC decoder</tr>
                <tr lang="ru">LTC-декодер</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>proto</category>
            <keywords>parser ltc</keywords>
            <since>0.9.7</since>
            <aliases>
                <alias>ltc.in~</alias>
            </aliases>
            <also>
                <see>ltc.out~</see>
            </also>
        </meta>
        <properties>
            <!-- @fps -->
            <property name="@fps" type="int" default="25" access="readonly">
                <tr lang="en">current fpt rate</tr>
            </property>
            <!-- @use_date -->
            <property name="@use_date" type="bool" default="1">
                <tr lang="en">decode date</tr>
            </property>
            <!-- @volume -->
            <property name="@volume" type="float" default="0" minvalue="-60" maxvalue="0"
            units="decibel" access="readonly">
                <tr lang="en">input signal level</tr>
            </property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list: HOUR MINUTE SECOND FRAME</outlet>
            <outlet>list: YEAR MONTH DAY</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T] [date 83 1 11(   [ui.hsl 0.5 4]    [ui.dsp~]
|   |                |
|   | [time 0 4 15(  [@speed $1(
|   | |              |
[ltc.out~    {i=1,o=1}]
|
|        [T]
|        |
| [dump( [@use_date $1(
| |      |
[ltc.in~ #y]
|
[ui.dt]       [ui.dt #x]

[X y:1->x]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
