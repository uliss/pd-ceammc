<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="list.correlate">
        <title>list.correlate</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">lists cross-correlation</tr>
                <tr lang="ru">взаимная корреляция между списками</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list correlation cross</keywords>
            <since>0.9.4</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Note: may perform slowly in large lists because it does not use the
                FFT to compute the convolution</tr>
            </par>
        </info>
        <arguments>
            <argument name="B" type="list">
                <tr lang="en">second argument values</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @a -->
            <property name="@a" type="list" default="">
                <tr lang="en">first argument</tr>
            </property>
            <!-- @b -->
            <property name="@b" type="list" default="">
                <tr lang="en">second argument</tr>
            </property>
            <!-- @full -->
            <property name="@full" type="alias">
                <tr lang="en">alias to @mode full</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" enum="valid same full" default="valid">
                <tr lang="en">output mode. 'full' - output the cross-correlation at each point of
                overlap, with an output length of (M+N-1). At the end-points of the
                cross-correlation, the signals do not overlap completely, and boundary effects may
                be seen. 'valid' - output of length (max(M,N)-min(M,N)+1). The cross-correlation
                product is only given for points where the signals overlap completely. Values
                outside the signal boundary have no effect. 'same' - output of length max(M,N).
                Boundary effects are still visible</tr>
            </property>
            <!-- @same -->
            <property name="@same" type="alias">
                <tr lang="en">alias to @mode same</tr>
            </property>
            <!-- @valid -->
            <property name="@valid" type="alias">
                <tr lang="en">alias to @mode valid</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">calculate cross-correlation and output</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">set second argument (@b property)</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>list: output result</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 1 2 3 1 2 3(
|
|        [ui.hrd 4]
|        |.
[list.>> 0]
|
[list.correlate 2 4 6]
|
[list.normalize @range]
|
[ui.sliders @auto_count 1 #x]




/* ... */
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
