<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="math.inf">
        <title>math.inf</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">output infinity value in the IEEE 754 standard</tr>
                <tr lang="ru">выводит бесконечное значение в стандарте IEEE 754</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math inf</keywords>
            <also>
                <see>math.nan</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>IEEE 754 floating point numbers can represent positive or negative infinity, and
            NaN (not a number). These three values arise from calculations whose result is
            undefined or cannot be represented accurately.</par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="bang">outputs *inf* value</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[math.inf]
|
[F]

[math.inf-math]
]]>
            </pdascii>
            <pdascii id="math">
<![CDATA[
/*multiplication*/

[msg.onload]
|
[math.inf]
|     |
[* 2] [* -2]
|     |
[F]   [F]

/*division*/

[msg.onload]
|
[math.inf      ]
|      |       |
[/ 10] [/ -10] [/ 0]
|      |       |
[F]    [F]     [F]

/*compare*/

[msg.onload]
|
[math.inf      ]
|
[t f f]
| ^|.
[== ]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
