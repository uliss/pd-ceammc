<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.record">
    <title>flow.record</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">control flow record/play</tr>
        <tr lang="ru">запись и воспроизведение управляющего потока</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow record</keywords>
      <since>0.9</since>
      <aliases>
        <alias>flow.rec</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">the object records incoming messages and plays them back with the original timing</tr>
        <tr lang="ru">объект записывает входящие сообщения и воспроизводит их с исходным таймингом</tr>
      </par>
      <par>
        <tr lang="en">recording and playback are controlled by the [rec(, [play(, [stop(, [clear( and [flush( messages</tr>
        <tr lang="ru">запись и воспроизведение управляются сообщениями [rec(, [play(, [stop(, [clear( и [flush(</tr>
      </par>
      <par>
        <tr lang="en">@auto starts recording on the first input atom, @r sets the number of repeats, @speed sets the playback speed</tr>
        <tr lang="ru">@auto запускает запись при первом входном атоме, @r задаёт число повторов, @speed задаёт скорость воспроизведения</tr>
      </par>
      <par>
        <tr lang="en">@sync uses an external bang pulse to synchronize the recorded events</tr>
        <tr lang="ru">@sync использует внешний bang-импульс для синхронизации записанных событий</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to record a live performance gesture and loop it, for example to record a short keyboard phrase and play it back in a loop</tr>
        <tr lang="ru">объект можно использовать для записи живого жеста и его зацикливания, например чтобы записать короткую фразу с клавиатуры и воспроизводить её в петле</tr>
      </par>
    </info>
    <properties>
      <!-- @auto -->
      <property name="@auto" type="bool" default="0">
        <tr lang="en">autostart record on the first input atom</tr>
        <tr lang="ru">автозапуск записи при первом входном атоме</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="int" minvalue="0" default="256" maxvalue="65536">
        <tr lang="en">max number of events, if 0: no max size check. If @auto is set, playback starts when max size is reached</tr>
        <tr lang="ru">максимальное число событий, если 0 — без проверки размера. Если задан @auto, воспроизведение начинается при достижении максимального размера</tr>
      </property>
      <!-- @r -->
      <property name="@r" type="int" minvalue="-1" default="1">
        <tr lang="en">number of repeats in play mode. If -1: repeat infinitely</tr>
        <tr lang="ru">число повторов в режиме воспроизведения. Если -1 — повторять бесконечно</tr>
      </property>
      <!-- @speed -->
      <property name="@speed" type="float" minvalue="0.0156" default="1" maxvalue="64">
        <tr lang="en">play speed</tr>
        <tr lang="ru">скорость воспроизведения</tr>
      </property>
      <!-- @sync -->
      <property name="@sync" type="bool" default="0">
        <tr lang="en">use external bang pulse to sync recorded events with</tr>
        <tr lang="ru">использовать внешний bang-импульс для синхронизации записанных событий</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="any">
          <tr lang="en">input message</tr>
          <tr lang="ru">входное сообщение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">sync tick (when @sync 1)</tr>
          <tr lang="ru">такт синхронизации (при @sync 1)</tr>
        </in>
        <in>
          <tr lang="en">[rec (1|0)?( - start (stop) flow record</tr>
          <tr lang="ru">[rec (1|0)?( — начать (остановить) запись потока</tr>
        </in>
        <in>
          <tr lang="en">[play (1|0)?( - play (stop) recorded flow</tr>
          <tr lang="ru">[play (1|0)?( — воспроизвести (остановить) записанный поток</tr>
        </in>
        <in>
          <tr lang="en">[stop (1|0)?( - stop (play) recording</tr>
          <tr lang="ru">[stop (1|0)?( — остановить (воспроизвести) запись</tr>
        </in>
        <in>
          <tr lang="en">[clear( - remove all recorded messages</tr>
          <tr lang="ru">[clear( — удалить все записанные сообщения</tr>
        </in>
        <in>
          <tr lang="en">[flush( - output and remove all recorded messages</tr>
          <tr lang="ru">[flush( — вывести и удалить все записанные сообщения</tr>
        </in>
        <in>
          <tr lang="en">[qlist( - output to qlist object</tr>
          <tr lang="ru">[qlist( — вывести в объект qlist</tr>
        </in>
        <in>
          <tr lang="en">[length FLOAT|time( - resize recorded messages (remove after specified length)</tr>
          <tr lang="ru">[length FLOAT|time( — изменить размер записанных сообщений (удалять после указанной длины)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output message</tr>
          <tr lang="ru">выходное сообщение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.keyboard 24]
|
|
|
|
|     [stop( [play( [clear(
|     |.     |.     |.
[flow.record @auto 1 @r -1]
|
[ui.keyboard 24]







[ui.keyboard]
|
|
|
|
|     [stop( [play( [clear(
|     |.     |.     |.
[flow.record @auto 1 ]
|
[msg note]
|
| [notes_off(
| |
[fluid~]          [ui.dsp~]
*|*
[ui.hgain2~]
*|*
[dac~]

[flow.record-speed]    [flow.record-qlist]

[flow.record-sync]
]]>
      </pdascii>
      <pdascii id="speed">
<![CDATA[
[ui.keyboard 24 60]
|
|
|
|
[msg note]
|
|  [ui.hsl 0.25 4 @show_value 1]
|  |
|  [prop.set @speed] [clear(
|  |                 |.
[flow.record @auto 1 @max 8 @r -1]
|
| [notes_off(
| |
[fluid~]          [ui.dsp~]
*|*
[ui.hgain2~]
*|*
[dac~]
]]>
      </pdascii>
      <pdascii id="qlist">
<![CDATA[
[ui.keyboard 24 60]
|
|
|
|
[msg note]
|
|  [qlist( [clear(
|  |.      |.
[flow.record @auto 1 @max 16]
|
|  [clear( [bang(
|  |       |
[qlist     ]

[r note]
|
[print QLIST]
]]>
      </pdascii>
      <pdascii id="sync">
<![CDATA[
[bang(
|
[random.i 60 90]
|
[mtof]
|
[@freq $1(                  [T]  [F]
|                           |    |.
|  [stop( [play( [clear(    [metro 200]
|  |.     |.     |.         |.   |
[flow.rec @auto 1 @sync 1 @r -1] [B]
|
[t b a   ]
|       ^|
[click~] |
|        |
[flt.resonbp~]
|\
[ui.hgain2~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
