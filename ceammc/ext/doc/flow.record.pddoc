<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="flow.record">
        <title>flow.record</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">control flow record/play</tr>
                <tr lang="ru">запись/воспроизведение управляющего потока</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>flow record</keywords>
            <since>0.9</since>
            <aliases>
                <alias>flow.rec</alias>
            </aliases>
        </meta>
        <properties>
            <!-- @auto -->
            <property name="@auto" type="bool" default="0">
                <tr lang="en">autostart record on first input atom</tr>
            </property>
            <!-- @max -->
            <property name="@max" type="int" minvalue="0" default="256" maxvalue="65536">
                <tr lang="en">max number of events, if 0: no max size check. If @auto is set -
                starts playback when max size reached</tr>
            </property>
            <!-- @r -->
            <property name="@r" type="int" minvalue="-1" default="1">
                <tr lang="en">number of repeats in play mode. If -1: repeat infinitely</tr>
            </property>
            <!-- @speed -->
            <property name="@speed" type="float" minvalue="0.0156" default="1" maxvalue="64">
                <tr lang="en">play speed</tr>
            </property>
            <!-- @sync -->
            <property name="@sync" type="bool" default="0">
                <tr lang="en">use external bang pulse to sync recorded events with</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="any">
                    <tr lang="en">input message</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">sync tick (when @sync 1)</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">[rec (1|0)?( - start (stop) flow record</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">[play (1|0)?( - play (stop) recorded flow</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">[stop (1|0)?( - stop (play) recording</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">[clear( - remove all recorded messages</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">[flush( - output and remove all recorded messages</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">[qlist( - output to qlist object</tr>
                </xinfo>
                <xinfo>
                    <tr lang="en">[length FLOAT|time( - resize recorded messages (remove after
                    specified length)</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output message</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.keyboard 24]
|
|
|
|
|     [stop( [play( [clear(
|     |.     |.     |.
[flow.record @auto 1 @r -1]
|
[ui.keyboard 24]







[ui.keyboard]
|
|
|
|
|     [stop( [play( [clear(
|     |.     |.     |.
[flow.record @auto 1 ]
|
[msg note]
|
| [notes_off(
| |
[fluid~]          [ui.dsp~]
*|*
[ui.hgain2~]
*|*
[dac~]

[flow.record-speed]    [flow.record-qlist]

[flow.record-sync]
]]>
            </pdascii>
            <pdascii id="speed">
<![CDATA[
[ui.keyboard 24 60]
|
|
|
|
[msg note]
|
|  [ui.hsl 0.25 4 @show_value 1]
|  |
|  [prop.set @speed] [clear(
|  |                 |.
[flow.record @auto 1 @max 8 @r -1]
|
| [notes_off(
| |
[fluid~]          [ui.dsp~]
*|*
[ui.hgain2~]
*|*
[dac~]
]]>
            </pdascii>
            <pdascii id="qlist">
<![CDATA[
[ui.keyboard 24 60]
|
|
|
|
[msg note]
|
|  [qlist( [clear(
|  |.      |.
[flow.record @auto 1 @max 16]
|
|  [clear( [bang(
|  |       |
[qlist     ]

[r note]
|
[print QLIST]
]]>
            </pdascii>
            <pdascii id="sync">
<![CDATA[
[bang(
|
[random.i 60 90]
|
[mtof]
|
[@freq $1(                  [T]  [F]
|                           |    |.
|  [stop( [play( [clear(    [metro 200]
|  |.     |.     |.         |.   |
[flow.rec @auto 1 @sync 1 @r -1] [B]
|
[t b a   ]
|       ^|
[click~] |
|        |
[flt.resonbp~]
|\
[ui.hgain2~]
*|*
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
