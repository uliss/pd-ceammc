<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.record">
    <title>flow.record</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">control flow record/play</tr>
        <tr lang="ru">запись/воспроизведение управляющего потока</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow record</keywords>
      <since>0.9</since>
      <aliases>
        <alias>flow.rec</alias>
      </aliases>
    </meta>
    <properties>
      <!-- @auto -->
      <property name="@auto" type="bool" default="0">
        <tr lang="en">autostart record on first input atom</tr>
        <tr lang="ru" finished="false">запись автозапуска первого входного атома</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="int" minvalue="0" default="256" maxvalue="65536">
        <tr lang="en">max number of events, if 0: no max size check. If @auto is set - starts
        playback when max size reached</tr>
        <!-- old: Максимальное количество событий, если 0: без
                проверки максимального размера. Если установлен @auto - начинается воспроизведение,
                когда максимальный размер достигнут -->
        <tr lang="ru" finished="false">Максимальное количество событий, если 0: без проверки
        максимального размера. Если установлен @auto - начинается воспроизведение, когда
        максимальный размер достигнут</tr>
      </property>
      <!-- @r -->
      <property name="@r" type="int" minvalue="-1" default="1">
        <tr lang="en">number of repeats in play mode. If -1: repeat infinitely</tr>
        <!-- old: Количество повторов в игровом режиме. Если -1:
                повторять бесконечно -->
        <tr lang="ru" finished="false">Количество повторов в игровом режиме. Если -1: повторять
        бесконечно</tr>
      </property>
      <!-- @speed -->
      <property name="@speed" type="float" minvalue="0.0156" default="1" maxvalue="64">
        <tr lang="en">play speed</tr>
        <tr lang="ru" finished="false">скорость игры</tr>
      </property>
      <!-- @sync -->
      <property name="@sync" type="bool" default="0">
        <tr lang="en">use external bang pulse to sync recorded events with</tr>
        <!-- old: использовать внешний импульс взрыва для
                синхронизации записанных событий с -->
        <tr lang="ru" finished="false">использовать внешний импульс взрыва для синхронизации
        записанных событий с</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="any">
          <tr lang="en">input message</tr>
          <tr lang="ru" finished="false">вводное сообщение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">sync tick (when @sync 1)</tr>
          <tr lang="ru" finished="false">Синхронизация (когда @sync 1)</tr>
        </in>
        <in>
          <tr lang="en">[rec (1|0)?( - start (stop) flow record</tr>
          <!-- old: [rec (1 | 0)? ( - стартовая (стоп) запись
                    потока) -->
          <tr lang="ru" finished="false">[rec (1 | 0)? ( - стартовая (стоп) запись потока)</tr>
        </in>
        <in>
          <tr lang="en">[play (1|0)?( - play (stop) recorded flow</tr>
          <!-- old: [play (1 | 0)? ( - play (stop) записываемый
                    поток) -->
          <tr lang="ru" finished="false">[play (1 | 0)? ( - play (stop) записываемый поток)</tr>
        </in>
        <in>
          <tr lang="en">[stop (1|0)?( - stop (play) recording</tr>
          <tr lang="ru" finished="false">[стоп (1 | 0)? ( - стоп (игра) запись)</tr>
        </in>
        <in>
          <tr lang="en">[clear( - remove all recorded messages</tr>
          <tr lang="ru" finished="false">[Clear() - удалить все записанные сообщения</tr>
        </in>
        <in>
          <tr lang="en">[flush( - output and remove all recorded messages</tr>
          <!-- old: [flush( - вывод и удаление всех записанных
                    сообщений)] -->
          <tr lang="ru" finished="false">[flush( - вывод и удаление всех записанных
          сообщений)]</tr>
        </in>
        <in>
          <tr lang="en">[qlist( - output to qlist object</tr>
          <tr lang="ru" finished="false">[qlist( - вывод на объект qlist)</tr>
        </in>
        <in>
          <tr lang="en">[length FLOAT|time( - resize recorded messages (remove after specified
          length)</tr>
          <!-- old: [длина FLOAT | время ( - размер записанных
                    сообщений (удалить после указанной длины)] -->
          <tr lang="ru" finished="false">[длина FLOAT | время ( - размер записанных сообщений
          (удалить после указанной длины)]</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output message</tr>
          <tr lang="ru" finished="false">выходное сообщение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.keyboard 24]
|
|
|
|
|     [stop( [play( [clear(
|     |.     |.     |.
[flow.record @auto 1 @r -1]
|
[ui.keyboard 24]







[ui.keyboard]
|
|
|
|
|     [stop( [play( [clear(
|     |.     |.     |.
[flow.record @auto 1 ]
|
[msg note]
|
| [notes_off(
| |
[fluid~]          [ui.dsp~]
*|*
[ui.hgain2~]
*|*
[dac~]

[flow.record-speed]    [flow.record-qlist]

[flow.record-sync]
]]>
      </pdascii>
      <pdascii id="speed">
<![CDATA[
[ui.keyboard 24 60]
|
|
|
|
[msg note]
|
|  [ui.hsl 0.25 4 @show_value 1]
|  |
|  [prop.set @speed] [clear(
|  |                 |.
[flow.record @auto 1 @max 8 @r -1]
|
| [notes_off(
| |
[fluid~]          [ui.dsp~]
*|*
[ui.hgain2~]
*|*
[dac~]
]]>
      </pdascii>
      <pdascii id="qlist">
<![CDATA[
[ui.keyboard 24 60]
|
|
|
|
[msg note]
|
|  [qlist( [clear(
|  |.      |.
[flow.record @auto 1 @max 16]
|
|  [clear( [bang(
|  |       |
[qlist     ]

[r note]
|
[print QLIST]
]]>
      </pdascii>
      <pdascii id="sync">
<![CDATA[
[bang(
|
[random.i 60 90]
|
[mtof]
|
[@freq $1(                  [T]  [F]
|                           |    |.
|  [stop( [play( [clear(    [metro 200]
|  |.     |.     |.         |.   |
[flow.rec @auto 1 @sync 1 @r -1] [B]
|
[t b a   ]
|       ^|
[click~] |
|        |
[flt.resonbp~]
|\
[ui.hgain2~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
