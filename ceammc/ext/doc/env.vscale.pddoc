<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env.vscale">
    <title>env.vscale</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">envelope amplitude value-scale</tr>
        <tr lang="ru">масштабирование амплитудных значений огибающей</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>value scale</keywords>
      <since>0.5</since>
      <also>
        <see>env.tscale</see>
        <see>envelope</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Scales the amplitude values of an envelope: multiplies all value points of
        the envelope by the given scale factor. A factor of 1 leaves the envelope unchanged, values
        less than 1 make it quieter, values greater than 1 make it louder. The timing of the
        envelope (its segment lengths and positions) is not affected — only its vertical
        scale.</tr>
        <tr lang="ru">Масштабирует амплитудные значения огибающей: умножает все значения точек
        огибающей на заданный коэффициент. Коэффициент 1 оставляет огибающую неизменной, значения
        меньше 1 делают её тише, а больше 1 — громче. Тайминг огибающей (длины и положения её
        сегментов) не изменяется — меняется только её вертикальный масштаб.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Velocity-sensitive envelopes — scaling an envelope's overall amplitude
        according to MIDI velocity or key pressure, so that softer playing produces quieter
        envelopes and louder playing produces louder ones, without changing the shape.</tr>
        <tr lang="ru">• Огибающие, чувствительные к velocity — масштабирование общей амплитуды
        огибающей в соответствии с MIDI velocity или силой нажатия, чтобы более мягкая игра давала
        более тихие огибающие, а более громкая — более громкие, без изменения формы.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Balance between layers — matching the amplitude of one envelope to another
        so that two sound layers (for example, a pad and a lead) stay in a consistent ratio when
        combined.</tr>
        <tr lang="ru">• Баланс между слоями — согласование амплитуды одной огибающей с другой,
        чтобы два звуковых слоя (например, пэд и лид) сохраняли постоянное соотношение при
        совместном звучании.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Real-time amplitude control — linking the scale to a knob or an expression
        parameter to fade an envelope up or down during performance, or to fade it out completely
        by setting the scale to 0.</tr>
        <tr lang="ru">• Управление амплитудой в реальном времени — привязка коэффициента к крутилке
        или параметру экспрессии, чтобы плавно усиливать или ослаблять огибающую во время
        исполнения, вплоть до полного затухания при коэффициенте 0.</tr>
      </par>
    </info>
    <arguments>
      <argument name="SCALE" type="float">
        <tr lang="en">value-scale</tr>
        <tr lang="ru">коэффициент масштабирования значений</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @scale -->
      <property name="@scale" type="float" default="1">
        <tr lang="en">value-scale</tr>
        <tr lang="ru">коэффициент масштабирования значений</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="data">
          <tr lang="en">input envelope</tr>
          <tr lang="ru">входная огибающая</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">scaled output envelope</tr>
          <tr lang="ru">масштабированная огибающая</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ar 20 30, bang(
|
[envelope] [@scale 0.5( [@scale 1.5(
|          |            |
|          |            |
|          |            |
[env.vscale          0.9]
|
[env->array vscale_array @raw]


[array vscale_array size=10000 w=300 h=100 yr=0..1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
