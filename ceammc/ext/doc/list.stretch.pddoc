<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.stretch">
        <title>list.stretch</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">changes the length of the list by adjusting its values using linear
                interpolation</tr>
                <tr lang="ru">изменяет длину списка, изменяя его значения с помощью линейной
                интерполяции</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list</keywords>
            <since>0.1</since>
            <also>
                <see>list.shift</see>
            </also>
        </meta>
        <arguments>
            <argument name="SIZE" type="int" minvalue="0">
                <tr lang="en">New size of output list. Input list will be stretched to the new size
                with linear interpolation</tr>
                <tr lang="ru" finished="false">Новый размер выходного списка. Список входов будет
                растянут до нового размера с линейной интерполяцией</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @size -->
            <property name="@size" type="int" minvalue="0" default="1">
                <tr lang="en">new size</tr>
                <tr lang="ru" finished="false">Новый размер</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list.</tr>
                    <tr lang="ru" finished="false">Список входов.</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                    <tr lang="ru" finished="false">входной млечный</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo>
                    <tr lang="en">new length of output list</tr>
                    <tr lang="ru" finished="false">Новая длина списка выпуска</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">new modified list</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.sliders]
|
|
|
|
|
|
|
|            [F]
|            |.
[list.stretch 32]
|
[ui.sliders @count 32]
|
|
|
|
|
|
|
[print]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
