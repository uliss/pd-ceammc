<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flt.speaker~">
    <title>flt.speaker~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">speaker emulation band-pass filter</tr>
        <tr lang="ru">полосовой фильтр для эмуляции динамика</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flt</category>
      <keywords>filter speaker bandpass bpf</keywords>
      <since>0.9.7</since>
      <also>
        <see>flt.bpf24~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Low-frequency speaker model: +12 dB/octave slope breaking to flat near
        @f1.</tr>
        <tr lang="ru">Модель динамика в области низких частот: подъём +12 дБ/октава с выходом на равномерную АЧХ вблизи @f1.</tr>
      </par>
      <par>
        <tr lang="en">Implemented using two DC blockers in series.</tr>
        <tr lang="ru">Реализовано с помощью двух последовательных фильтров подавления постоянной составляющей.</tr>
      </par>
      <par>
        <tr lang="en">High-frequency model: -24 dB/octave slope implemented using a fourth-order
        Butterworth lowpass filter.</tr>
        <tr lang="ru">Модель динамика в области высоких частот: спад -24 дБ/октава, реализованный с помощью фильтра низких частот Баттерворта четвёртого порядка.</tr>
      </par>
    </info>
    <arguments>
      <argument name="F1" type="float" units="hertz" minvalue="20" maxvalue="1000">
        <tr lang="en">lower band frequency</tr>
        <tr lang="ru">нижняя граничная частота</tr>
      </argument>
      <argument name="F2" type="float" minvalue="1000" maxvalue="20000" units="hertz">
        <tr lang="en">high band frequency</tr>
        <tr lang="ru">верхняя граничная частота</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
        <tr lang="ru">флаг обхода обработки. Если true — сигнал проходит без изменений.</tr>
      </property>
      <!-- @drywet -->
      <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="1">
        <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet) signals. 0
        = dry signal, 1 = wet.</tr>
        <tr lang="ru">пропорция смеси между исходным (dry) и обработанным (wet) сигналами. 0 — сухой сигнал, 1 — влажный.</tr>
      </property>
      <!-- @f1 -->
      <property name="@f1" type="float" minvalue="20" maxvalue="1000" default="130" units="hertz">
        <tr lang="en">lower band frequency</tr>
        <tr lang="ru">нижняя граничная частота</tr>
      </property>
      <!-- @f2 -->
      <property name="@f2" type="float" minvalue="1000" maxvalue="20000" default="5000"
      units="hertz">
        <tr lang="en">high band frequency</tr>
        <tr lang="ru">верхняя граничная частота</tr>
      </property>
      <!-- @gain -->
      <property name="@gain" type="float" minvalue="-30" maxvalue="30" default="0" units="decibel">
        <tr lang="en">filter gain</tr>
        <tr lang="ru">усиление фильтра</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset filter state</tr>
          <tr lang="ru">сбросить состояние фильтра</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set @f1 property</tr>
          <tr lang="ru">установить свойство @f1</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set @f2 property</tr>
          <tr lang="ru">установить свойство @f2</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">filtered signal</tr>
          <tr lang="ru">отфильтрованный сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[L]
|                             [bang #a( /*plot response*/
|                             |
[@f1 $1, @f2 $2(              [click~]
|                             |
[flt.speaker~ 1000 4000       ]
|
[plot.response~ @sr 1 @db 1 #b]
|                          ^^|.
[ui.plot~ @xlabels 1 @ylabels 1 @ymin -60 @ymax 0 @ymin_ticks 0 @ymaj_ticks 0 @size 400 200]














[ui.dsp~]
[X a->b:1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
