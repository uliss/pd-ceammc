<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flt.speaker~">
        <title>flt.speaker~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">speaker emulation band-pass filter</tr>
                <tr lang="ru">полосовой фильтр-эмуляция динамика</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter speaker bandpass bpf</keywords>
            <since>0.9.7</since>
            <also>
                <see>flt.bpf24~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Low-frequency speaker model = +12 dB/octave slope breaking to flat
                near @f1.</tr>
                <!-- old: низкий - частотная динамиковая модель = +12
                дБ/октава наклона, разбивающегося на плоскость около @f1. -->
                <tr lang="ru" finished="false">низкий - частотная динамиковая модель = +12
                дБ/октава наклона, разбивающегося на плоскость около @f1.</tr>
            </par>
            <par>
                <tr lang="en">Implemented using two dc blockers in series.</tr>
                <!-- old: Реализуется с использованием двух блокировщиков dc
                последовательно. -->
                <tr lang="ru" finished="false">Реализуется с использованием двух блокировщиков dc
                последовательно.</tr>
            </par>
            <par>
                <tr lang="en">High-frequency model = -24 dB/octave slope implemented using a
                fourth-order Butterworth lowpass.</tr>
                <!-- old: высокий - частотная модель = -24 дБ/октава наклона,
                реализованная с использованием четвертого порядка Butterworth lowpass. -->
                <tr lang="ru" finished="false">высокий - частотная модель = -24 дБ/октава наклона,
                реализованная с использованием четвертого порядка Butterworth lowpass.</tr>
            </par>
        </info>
        <arguments>
            <argument name="F1" type="float" units="hertz" minvalue="20" maxvalue="1000">
                <tr lang="en">lower band frequency</tr>
                <tr lang="ru" finished="false">нижняя полоса частот</tr>
            </argument>
            <argument name="F2" type="float" minvalue="1000" maxvalue="20000" units="hertz">
                <tr lang="en">high band frequency</tr>
                <tr lang="ru" finished="false">высокая полоса частот</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
                <!-- old: Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал. -->
                <tr lang="ru" finished="false">Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал.</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="1">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet</tr>
                <!-- old: пропорция смеси между исходными (сухими) и
                "влажными" сигналами. 0 - сухой сигнал, 1 - влажный -->
                <tr lang="ru" finished="false">пропорция смеси между исходными (сухими) и
                "влажными" сигналами. 0 - сухой сигнал, 1 - влажный</tr>
            </property>
            <!-- @f1 -->
            <property name="@f1" type="float" minvalue="20" maxvalue="1000" default="130"
            units="hertz">
                <tr lang="en">lower band frequency</tr>
                <tr lang="ru" finished="false">нижняя полоса частот</tr>
            </property>
            <!-- @f2 -->
            <property name="@f2" type="float" minvalue="1000" maxvalue="20000" default="5000"
            units="hertz">
                <tr lang="en">high band frequency</tr>
                <tr lang="ru" finished="false">высокая полоса частот</tr>
            </property>
            <!-- @gain -->
            <property name="@gain" type="float" minvalue="-30" maxvalue="30" default="0"
            units="decibel">
                <tr lang="en">filter gain</tr>
                <tr lang="ru" finished="false">коэффициент усиления фильтра</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset filter state</tr>
                    <tr lang="ru" finished="false">состояние фильтра сброса</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">set @f1 property</tr>
                    <tr lang="ru" finished="false">@f1 Недвижимость</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">set @f2 property</tr>
                    <tr lang="ru" finished="false">Свойство @f2</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">filtered signal</tr>
                    <tr lang="ru" finished="false">фильтрованный сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[L]
|                             [bang #a( /*plot response*/
|                             |
[@f1 $1, @f2 $2(              [click~]
|                             |
[flt.speaker~ 1000 4000       ]
|
[plot.response~ @sr 1 @db 1 #b]
|                          ^^|.
[ui.plot~ @xlabels 1 @ylabels 1 @ymin -60 @ymax 0 @ymin_ticks 0 @ymaj_ticks 0 @size 400 200]














[ui.dsp~]
[X a->b:1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
