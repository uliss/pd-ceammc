<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.display">
    <title>hw.display</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">get/set display properties</tr>
        <tr lang="ru">получение и установка свойств дисплея</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>display brightness</keywords>
      <since>0.7.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Reads and sets the properties of the hardware display (currently brightness
        only). The current value can be queried with a bang or the @brightness? message, and
        changed with the @brightness message or by setting the @brightness property.</tr>
        <tr lang="ru">Читает и устанавливает свойства аппаратного дисплея (в настоящее время —
        только яркость). Текущее значение можно запросить по bang или сообщением @brightness?, а
        изменить — сообщением @brightness или установкой свойства @brightness.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Automatic brightness control — adjusting the display brightness from a
        patch, for example fading it down in the evening and up in the morning, or linking it to an
        ambient light sensor.</tr>
        <tr lang="ru">• Автоматическое управление яркостью — изменение яркости дисплея из патча,
        например затемнение вечером и увеличение яркости утром, или привязка к датчику
        освещённости.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Performance and installation scenarios — dimming the display during a
        concert or an art installation, so that the screen does not distract the audience, and
        restoring brightness when the piece ends.</tr>
        <tr lang="ru">• Сценарии выступлений и инсталляций — затемнение дисплея во время концерта
        или арт-инсталляции, чтобы экран не отвлекал публику, и восстановление яркости по окончании
        произведения.</tr>
      </par>
      <par style="warning">
        <tr lang="en">Note: currently supported on macOS only.</tr>
        <tr lang="ru">Примечание: в настоящее время поддерживается только на macOS.</tr>
      </par>
    </info>
    <properties>
      <!-- @brightness -->
      <property name="@brightness" type="float" minvalue="0" maxvalue="1" default="0.313477">
        <tr lang="en">display brightness</tr>
        <tr lang="ru">яркость дисплея</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input</tr>
          <tr lang="ru">вход</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">properties output</tr>
          <tr lang="ru">вывод свойств</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.slider @size 120 12]
|
[@brightness $1( [@brightness?(
|                |
[hw.display      ]
|
[ui.d]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
