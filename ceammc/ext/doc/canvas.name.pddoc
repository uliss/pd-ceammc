<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="canvas.name">
    <title>canvas.name</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">output the current canvas name of the object</tr>
        <tr lang="ru">выводит имя текущего холста объекта</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>patch</category>
      <keywords>canvas name</keywords>
      <also>
        <see>canvas.current</see>
      </also>
      <since>0.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object outputs the name of the canvas (window or subpatch) that contains
        it. On bang the name is sent out through the outlet as a symbol.</tr>
        <tr lang="ru">Объект выводит имя холста (окна или субпатча), который его содержит. По bang
        имя отправляется через выход в виде символа.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the current canvas name</tr>
          <tr lang="ru">выводит имя текущего холста</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="symbol">
          <tr lang="en">current canvas name</tr>
          <tr lang="ru">имя текущего холста</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[canvas.name]
|
[S digits=20]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
