<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="hoa.in">
        <title>hoa.in</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
                <author>Pierre Guillot</author>
                <author>Eliott Paris</author>
                <author>Thomas Le Meur</author>
            </authors>
            <description>
                <tr lang="en">message inlet for a patcher loaded by [hoa.process~] object</tr>
                <tr lang="ru">контрольный вход для патча, загружаемого объектом [hoa.process~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>hoa inlet</keywords>
            <since>0.8</since>
            <also>
                <see>hoa.in~</see>
                <see>hoa.out</see>
                <see>hoa.out~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">hoa.in defines a message inlet for a patcher loaded by a hoa.process~
                object.</tr>
                <!-- old: hoa.in определяет вход сообщения для патчера,
                загруженного hoa.process~ объектом. -->
                <tr lang="ru" finished="false">hoa.in определяет вход сообщения для патчера,
                загруженного hoa.process~ объектом.</tr>
            </par>
        </info>
        <arguments>
            <argument name="INDEX" type="int" minvalue="1">
                <tr lang="en">shortcut for @index property</tr>
                <tr lang="ru" finished="false">Скриншоты для @index Property</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @index -->
            <property name="@index" type="int" minvalue="1" default="1">
                <tr lang="en">Defines an inlet index</tr>
                <tr lang="ru" finished="false">Определяет входной индекс</tr>
            </property>
        </properties>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output messages received from a hoa.process~ input.</tr>
                    <tr lang="ru" finished="false">выходные сообщения, полученные от hoa.process~
                    input.</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open 0( [open 1(  [42( [\#0 43( [\#1 44(
|        |         |    |        |
|        |         |.   |.       |.
[hoa.process~ 2 hoa/hoa_in_example1 planewaves]
|
[print A]

[open 0(     [42( [\#0 43( [\#1 44( [45( [\#0 46( [\#1 47(
|            |    |        |        |    |        |
| [open 1(   |    |        |        |    |        |
| |          |.   |.       |.       |... |...     |...
[hoa.process~ 2 hoa/hoa_in_example2 planewaves       ]
|                                ^|
[print B]                        [print C]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
