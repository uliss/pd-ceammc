<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="ui.canvas" type="gui">
        <title>ui.canvas</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">canvas for drawing</tr>
                <tr lang="ru">холст для рисования</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui canvas draw</keywords>
            <since>0.9.7</since>
            <aliases>
                <alias view="link">ui.cnv</alias>
            </aliases>
        </meta>
        <info>
            <par>Canvas drawing methods are close to Cairo graphic library</par>
            <par>Basic drawing workflow is:</par>
            <par>- create line, shape or text</par>
            <par>- stroke or fill it with color</par>
            <par>- update image</par>
        </info>
        <mouse>
            <event type="double-click" editmode="false">outputs message [mouse double X Y MOD_CTL
            MOD_ALT MOD_SHIFT MOD_CMD(</event>
            <event type="left-click" editmode="false">outputs message [mouse down X Y MOD_CTL
            MOD_ALT MOD_SHIFT MOD_CMD(</event>
            <event type="drag" editmode="false">outputs message [mouse drag X Y MOD_CTL MOD_ALT
            MOD_SHIFT MOD_CMD(</event>
            <event type="right-click" editmode="false" keys="Shift">open object help</event>
            <event type="right-click" editmode="false" keys="Alt">open properties dialog</event>
            <event type="right-click" editmode="true">opens Pd popup menu</event>
            <event type="right-click" editmode="true" keys="Shift">open the object help</event>
            <event type="right-click" editmode="true" keys="Alt">open properties dialog</event>
        </mouse>
        <properties>
            <xi:include href="props_background_color.xml" />
            <xi:include href="props_border_color.xml" />
            <xi:include href="props_fontname.xml" />
            <xi:include href="props_fontsize.xml" />
            <xi:include href="props_fontslant.xml" />
            <xi:include href="props_fontweight.xml" />
            <xi:include href="props_label.xml" />
            <xi:include href="props_label_align.xml" />
            <xi:include href="props_label_color.xml" />
            <xi:include href="props_label_inner.xml" />
            <xi:include href="props_label_margins.xml" />
            <xi:include href="props_label_side.xml" />
            <xi:include href="props_label_valign.xml" />
            <xi:include href="props_pinned.xml" />
            <xi:include href="props_ui_receive.xml" />
            <xi:include href="props_ui_send.xml" />
            <!-- @size -->
            <property name="@size" type="list" default="120 60">
                <tr lang="en">object size (width, height pair)</tr>
                <tr lang="ru">размер объекта (пара: ШИРИНА ВЫСОТА)</tr>
            </property>
        </properties>
        <methods>
            <!-- abc -->
            <method name="abc">draw music in ABC notation. 
            <param name="X" type="atom" required="true">
                <tr lang="en">left-coord in pixel or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">top-coord in pixel or percents of height</tr>
            </param>
            <param name="MUSIC" type="list" required="true">
                <tr lang="en">ABC notation</tr>
            </param></method>
            <!-- arc -->
            <method name="arc">draw arc 
            <param name="XC" type="atom" required="true">
                <tr lang="en">x-center coord in pixel or percents of width</tr>
            </param>
            <param name="YC" type="atom" required="true">
                <tr lang="en">y-center coord in pixel or percents of height</tr>
            </param>
            <param name="RC" type="atom" required="true">
                <tr lang="en">radius in pixel or percents of width</tr>
            </param>
            <param name="A0" type="atom" required="true">
                <tr lang="en">start angle in degrees or radians</tr>
            </param>
            <param name="A1" type="atom" required="true">
                <tr lang="en">end angle in degrees or radians</tr>
            </param></method>
            <!-- arrow -->
            <method name="arrow">creates arrow shape 
            <param name="X0" type="atom" required="true">
                <tr lang="en">x-coord of start point in pixel or percents of width</tr>
            </param>
            <param name="Y0" type="atom" required="true">
                <tr lang="en">y-coord of start point in pixel or percents of height</tr>
            </param>
            <param name="X1" type="atom" required="true">
                <tr lang="en">x-coord of target point in pixel or percents of width</tr>
            </param>
            <param name="Y1" type="atom" required="true">
                <tr lang="en">y-coord of target point in pixel or percents of height</tr>
            </param>
            <param name="START" type="symbol" required="false" enum="A a V v X x T t O o n">
                <tr lang="en">start shape</tr>
            </param>
            <param name="END" type="symbol" required="false" enum="A a V v X x T t O o n">
                <tr lang="en">end shape</tr>
            </param></method>
            <!-- bg -->
            <method name="bg">draws background 
            <param name="COLOR" type="list" required="false">
                <tr lang="en">background color</tr>
            </param></method>
            <!-- circle -->
            <method name="circle">create circle shape 
            <param name="X" type="float" required="true">
                <tr lang="en">x-coord</tr>
            </param>
            <param name="Y" type="float" required="true">
                <tr lang="en">y-coord</tr>
            </param>
            <param name="RADIUS" type="float" required="true">
                <tr lang="en">radius</tr>
            </param></method>
            <!-- clear -->
            <method name="clear">clear image</method>
            <!-- close_path -->
            <method name="close_path">close path and its subpaths</method>
            <!-- color -->
            <method name="color">set current color 
            <param name="DATA" type="list" required="true">
                <tr lang="en">RGB, RGBA float list or hex or named color</tr>
            </param></method>
            <!-- crestore -->
            <method name="crestore">restore previously saved context (pen type, width, color,
            matrix etc.)</method>
            <!-- csave -->
            <method name="csave">save current drawing context (pen type, width, color, matrix
            etc.)</method>
            <!-- curve -->
            <method name="curve">create bezier-curve shape 
            <param name="X0" type="atom" required="true">
                <tr lang="en">x0-coord in pixels or percents of width</tr>
            </param>
            <param name="Y0" type="atom" required="true">
                <tr lang="en">y0-coord in pixels or percents of height</tr>
            </param>
            <param name="X1" type="atom" required="true">
                <tr lang="en">x1-coord in pixels or percents of width</tr>
            </param>
            <param name="Y1" type="atom" required="true">
                <tr lang="en">y1-coord in pixels or percents of height</tr>
            </param>
            <param name="X2" type="atom" required="true">
                <tr lang="en">x2-coord in pixels or percents of width</tr>
            </param>
            <param name="Y2" type="atom" required="true">
                <tr lang="en">y2-coord in pixels or percents of height</tr>
            </param>
            <param name="X3" type="atom" required="true">
                <tr lang="en">x3-coord in pixels or percents of width</tr>
            </param>
            <param name="Y4" type="atom" required="true">
                <tr lang="en">y3-coord in pixels or percents of height</tr>
            </param></method>
            <!-- dash -->
            <method name="dash">set line dash pattern 
            <param name="PATTERN" type="list" required="true">
                <tr lang="en">line dash pattern. If empty - reset to solid shape</tr>
            </param></method>
            <!-- dump -->
            <method name="dump">dumps all object info to Pd console window.</method>
            <!-- ellipse -->
            <method name="ellipse">draw ellipse 
            <param name="X" type="atom" required="true">
                <tr lang="en">left-coord in pixel or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">top-coord in pixel or percents of height</tr>
            </param>
            <param name="WIDTH" type="atom" required="true">
                <tr lang="en">width</tr>
            </param>
            <param name="HEIGHT" type="atom" required="true">
                <tr lang="en">height</tr>
            </param></method>
            <!-- fill -->
            <method name="fill">fill shape with color 
            <param name="COLOR" type="atom" required="true">
                <tr lang="en">fill color</tr>
            </param>
            <param name="PRESERVE" type="atom" required="false" enum="preserve 1">
                <tr lang="en">preserve path after fill. You can call stroke method after that</tr>
            </param></method>
            <!-- font -->
            <method name="font">set current font 
            <param name="FONT" type="symbol" required="true">
                <tr lang="en">font family</tr>
            </param>
            <param name="SIZE" type="float" required="false">
                <tr lang="en">font size</tr>
            </param></method>
            <!-- font_size -->
            <method name="font_size">set current font size 
            <param name="X" type="float" required="true">
                <tr lang="en">font size</tr>
            </param></method>
            <!-- icon -->
            <method name="icon">draw named icon. Pass ? as single argument to dump all icons to Pd
            window. 
            <param name="X" type="atom" required="true">
                <tr lang="en">left-coord in pixel or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">top-coord in pixel or percents of height</tr>
            </param>
            <param name="SIZE" type="float" required="true">
                <tr lang="en">font size</tr>
            </param>
            <param name="ICON" type="symbol" required="true">
                <tr lang="en">icon name. See https://fonts.google.com/icons for full list</tr>
            </param></method>
            <!-- image -->
            <method name="image">draws image. Note: only PNG images are supported! 
            <param name="X" type="atom" required="true">
                <tr lang="en">left-coord in pixel or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">top-coord in pixel or percents of height</tr>
            </param>
            <param name="PATH" type="symbol" required="true">
                <tr lang="en">path to image file, full or relative to patch</tr>
            </param>
            <param name="SCALE" type="float" required="false" minvalue="0">
                <tr lang="en">image scale</tr>
            </param></method>
            <!-- line -->
            <method name="line">create line shape 
            <param name="X0" type="atom" required="true">
                <tr lang="en">x0-coord in pixels or percents of width</tr>
            </param>
            <param name="Y0" type="atom" required="true">
                <tr lang="en">y0-coord in pixels or percents of height</tr>
            </param>
            <param name="X1" type="atom" required="true">
                <tr lang="en">x1-coord in pixels or percents of width</tr>
            </param>
            <param name="Y1" type="atom" required="true">
                <tr lang="en">y1-coord in pixels or percents of height</tr>
            </param></method>
            <!-- line_cap -->
            <method name="line_cap">set line cap 
            <param name="X" type="symbol" required="true" enum="butt round square">
                <tr lang="en">line cap</tr>
            </param></method>
            <!-- line_to -->
            <method name="line_to">add line segment to line shape 
            <param name="X" type="atom" required="true">
                <tr lang="en">x-coord in pixels or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">y-coord in pixels or percents of height</tr>
            </param></method>
            <!-- matrix -->
            <method name="matrix">set 2D transformation matrix 
            <param name="XX" type="atom" required="true">
                <tr lang="en">xx component of the affine transformation</tr>
            </param>
            <param name="YX" type="atom" required="true">
                <tr lang="en">yx component of the affine transformation</tr>
            </param>
            <param name="XY" type="atom" required="true">
                <tr lang="en">xy component of the affine transformation</tr>
            </param>
            <param name="YY" type="atom" required="true">
                <tr lang="en">yy component of the affine transformation</tr>
            </param>
            <param name="X0" type="atom" required="true">
                <tr lang="en">x component of the affine transformation</tr>
            </param>
            <param name="Y0" type="atom" required="true">
                <tr lang="en">y component of the affine transformation</tr>
            </param></method>
            <!-- move_by -->
            <method name="move_by">move current drawing point by relative offset 
            <param name="X" type="atom" required="true">
                <tr lang="en">x relative offset in pixels or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">y relative offset in pixels or percents of height</tr>
            </param></method>
            <!-- move_to -->
            <method name="move_to">move current drawing point to absolute position 
            <param name="X" type="atom" required="true">
                <tr lang="en">x-coord in pixels or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">y-coord in pixels or percents of height</tr>
            </param></method>
            <!-- musicxml -->
            <method name="musicxml">render MusicXML file 
            <param name="X" type="atom" required="true">
                <tr lang="en">x-coord in pixels or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">y-coord in pixels or percents of height</tr>
            </param>
            <param name="FILE" type="symbol" required="true">
                <tr lang="en">absolute or relative to patch filepath of MusicXML file</tr>
            </param></method>
            <!-- new_path -->
            <method name="new_path">starts new path</method>
            <!-- new_subpath -->
            <method name="new_subpath">starts new subpath, means no line connection between last
            point and new subpath shape</method>
            <!-- polar -->
            <method name="polar">creates polar grid 
            <param name="X" type="atom" required="true">
                <tr lang="en">x-coord of center in pixel or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">y-coord of center in pixel or percents of height</tr>
            </param>
            <param name="ADIV" type="int" required="false" minvalue="0">
                <tr lang="en">number of divisions of 90 degree angle</tr>
            </param>
            <param name="NC" type="int" required="false" minvalue="0">
                <tr lang="en">number of circles</tr>
            </param>
            <param name="CDIST" type="int" required="false" minvalue="1">
                <tr lang="en">circle distance</tr>
            </param></method>
            <!-- polygon -->
            <method name="polygon">create polygon shape 
            <param name="X0" type="atom" required="true">
                <tr lang="en">x0-coord in pixel or percents of width</tr>
            </param>
            <param name="Y0" type="atom" required="true">
                <tr lang="en">y0-coord in pixel or percents of height</tr>
            </param>
            <param name="X..." type="atom" required="true">
                <tr lang="en">x...-coord in pixel or percents of width</tr>
            </param>
            <param name="Y..." type="atom" required="true">
                <tr lang="en">y...-coord in pixel or percents of height</tr>
            </param>
            <param name="XN" type="atom" required="true">
                <tr lang="en">xn-coord in pixel or percents of width</tr>
            </param>
            <param name="YN" type="atom" required="true">
                <tr lang="en">yn-coord in pixel or percents of height</tr>
            </param></method>
            <!-- pos -->
            <method name="pos">set UI element position 
            <param name="X" type="float" required="true">
                <tr lang="en">top left x-coord</tr>
            </param>
            <param name="Y" type="float" required="true">
                <tr lang="en">top right y-coord</tr>
            </param></method>
            <!-- qrcode -->
            <method name="qrcode">create QR-code shape. 
            <param name="X" type="atom" required="true">
                <tr lang="en">left-coord in pixel or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">top-coord in pixel or percents of height</tr>
            </param>
            <param name="PIXEL" type="int" required="true" minvalue="1">
                <tr lang="en">pixel size</tr>
            </param>
            <param name="TEXT" type="symbol" required="true">
                <tr lang="en">message</tr>
            </param></method>
            <!-- rect -->
            <method name="rect">create rectangle shape 
            <param name="X" type="atom" required="true">
                <tr lang="en">x-coord in pixels or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">y-coord in pixels or percents of height</tr>
            </param>
            <param name="W" type="atom" required="true">
                <tr lang="en">width in pixels or percents of width</tr>
            </param>
            <param name="H" type="atom" required="true">
                <tr lang="en">height in pixels or percents of height</tr>
            </param></method>
            <!-- rotate -->
            <method name="rotate">clock-wise rotatation of draw origin 
            <param name="X" type="float" required="true" units="degree">
                <tr lang="en">rotation angle</tr>
            </param></method>
            <!-- rpolygon -->
            <method name="rpolygon">create polygon shape 
            <param name="X" type="atom" required="true">
                <tr lang="en">x-coord of center in pixel or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">y-coord of center in pixel or percents of height</tr>
            </param>
            <param name="N" type="int" required="true">
                <tr lang="en">number of vertexes</tr>
            </param>
            <param name="R" type="float" required="true">
                <tr lang="en">polygon radius</tr>
            </param></method>
            <!-- scale -->
            <method name="scale">scale current draw matrix 
            <param name="X" type="float" required="true">
                <tr lang="en">x</tr>
            </param>
            <param name="Y" type="float" required="false">
                <tr lang="en">y. If omitted, uses X-value to scale same in both directions</tr>
            </param></method>
            <!-- star -->
            <method name="star">create star shape 
            <param name="X" type="atom" required="true">
                <tr lang="en">x-coord of center in pixel or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">y-coord of center in pixel or percents of height</tr>
            </param>
            <param name="N" type="int" required="true">
                <tr lang="en">number of vertexes</tr>
            </param>
            <param name="R" type="float" required="false" minvalue="0">
                <tr lang="en">star radius</tr>
            </param>
            <param name="STEP" type="int" required="false" minvalue="1">
                <tr lang="en">connection step. If omitted step is auto-calculated</tr>
            </param></method>
            <!-- stroke -->
            <method name="stroke">stroke shape with color 
            <param name="COLOR" type="atom" required="true">
                <tr lang="en">stroke color</tr>
            </param>
            <param name="PRESERVE" type="atom" required="false" enum="preserve 1">
                <tr lang="en">preserve path after stroke</tr>
            </param></method>
            <!-- text -->
            <method name="text">set current text shape 
            <param name="X" type="atom" required="true">
                <tr lang="en">x-coord in pixels or percents of width</tr>
            </param>
            <param name="Y" type="atom" required="true">
                <tr lang="en">y-coord in pixels or percents of height</tr>
            </param>
            <param name="TXT" type="list" required="true">
                <tr lang="en">text content</tr>
            </param></method>
            <!-- translate -->
            <method name="translate">translate draw origin 
            <param name="X" type="float" required="true">
                <tr lang="en">x offset</tr>
            </param>
            <param name="Y" type="float" required="true">
                <tr lang="en">y offset</tr>
            </param></method>
            <!-- update -->
            <method name="update">updates drawed image</method>
            <!-- width -->
            <method name="width">set stroke width 
            <param name="WIDTH" type="float" required="true">
                <tr lang="en">line width</tr>
            </param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo>draw commands</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>message: mouse ACTION(down|up|drag) X Y MOD_CTL MOD_ALT MOD_SHIFT
            MOD_CMD</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[clear, matrix #a(             [image #i(

[line #b(                      [qrcode #j(

[circle #c(                    [star #k(

[rect #d(                      [abc #l(

[curve 0 0 30% 50% 70% 50% 100% 0, stroke \#FA0, update #e(

[polygon 20 90 40 70 100 70 90 190, fill lime!-30, update #f(

[csave, #g(


[bg gray!+75, update #h(

[ui.canvas @size 300 200 {h:200} #z]











[X a->z] [X b->z] [X c->z] [X d->z] [X e->z] [X f->z] [X g->z] [X h->z]
[X i->z] [X j->z] [X k->z] [X l->z]

[ui.canvas-line]  [ui.canvas-text]   [ui.canvas-music] [ui.canvas-matrix]

[ui.canvas-color] [ui.canvas-arrows] [ui.canvas-image] [ui.canvas-mouse]

#b 30 50 100% 100%, stroke red, update
#c 0 0 50, fill blue, update
#d 80% 90% 15% 10%, fill navy, update
#g translate 50% 50%, rotate 35, font_size 40, text 0 0 CEAM, fill gray, crestore, update
#i 150 10 img/puredata-ceammc.png 0.13, update
#j 220 40 3 message, fill black, update
#k 150 160 5 30, stroke red, update
#l 0 0 K:E L:1/4 =F4|, update
]]>
            </pdascii>
            <pdascii id="line">
<![CDATA[
[clear, line_cap butt, width 10, line 10% 10% 90% 90%, stroke blue, update #a(


[clear, line_cap square, width 10, line 10% 10% 90% 90%, stroke blue, update #b(


[clear, line_cap round, width 10, line 10% 10% 90% 90%, stroke red, update #c(


    [dash #e( [dash 5 5 12 #f(

[clear, width 10, line_cap round, move_to 10% 50%, line_to 90% 50%, line_to 50% 10%, line_to 50% 90%, stroke cyan, update #d(



[ui.canvas @size 300 200 {h:200} #z]











[X a->z] [X b->z] [X c->z] [X d->z] [X e->z] [X f->z]
]]>
            </pdascii>
            <pdascii id="text">
<![CDATA[
[clear, matrix, translate 50% 50% #a(

 [rotate 30, font Verdana, font_size 20, text 20 0 CEAM, fill random, update #b(


  [matrix, font Verdana bold, font_size 40, width 2, text 50 75 HELLO, fill gray preserve, stroke cyan, update #c(


   [clear, font Verdana italic, font_size 50, text 50 75 HELLO, fill black, update #d(


    [clear, font Verdana italic bold 60, text 25% 75 HELLO, fill black, update #e(


[ui.canvas @size 300 200 {h:200} #z]











[X a->z] [X b->z] [X c->z] [X d->z] [X e->z]
]]>
            </pdascii>
            <pdascii id="color">
<![CDATA[
[clear, bg \#FFAAFF, update #a( /*RGB*/

[bg \#DDAA33AA, update #b(      /*RGBA*/

[bg \#BEF, update #c(           /*short RGB*/

[bg \#30D5, update #d(          /*short RGBA*/

[bg navy, update #e(            /*named color*/

[bg navy!+50, update #f(        /*lighter named color*/

[bg gray!-50, update #g(        /*darker named color*/

[bg random, update #h(          /*random color*/

[ui.canvas #z]







[X a->z] [X b->z] [X c->z] [X d->z]
[X e->z] [X f->z] [X g->z] [X h->z]
]]>
            </pdascii>
            <pdascii id="arrows">
<![CDATA[
[width 1, arrow 30 30 130 160 A a, stroke red, update #a(

[arrow 60 30 160 160 O o, stroke blue, update #b(

[arrow 90 30 190 160 T t, stroke navy, update #c(

[arrow 120 30 220 160 V v, stroke orange, update #d(

[arrow 150 30 250 160 X x, stroke gray, update #e(

[arrow 180 30 280 160 n n, stroke green, update #f(


[ui.canvas @size 300 200 #z]







[X a->z] [X b->z] [X c->z] [X d->z]
[X e->z] [X f->z]
]]>
            </pdascii>
            <pdascii id="music">
<![CDATA[
[clear, musicxml -100 -20 music/simple.mxml 120, update #a(

  [B]
  |
  [openpanel]
  |
  [clear, musicxml 0 0 $1 50, update(
  |
[ui.canvas @size 500 400 #z]







[X a->z]
]]>
