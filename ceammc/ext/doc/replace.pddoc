<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="replace">
        <title>replace</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">replace atoms in data stream</tr>
                <tr lang="ru">замена атомов в потоке данных</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>replace test</keywords>
            <since>0.1</since>
            <also>
                <see>flow.pass</see>
            </also>
            <aliases>
                <alias>ceammc/replace</alias>
            </aliases>
        </meta>
        <info>
            <par>From/to values can be specified both as @from/@to properties or first and second
            arguments.</par>
        </info>
        <arguments>
            <argument name="FROM" type="atom">
                <tr lang="en">replace subject</tr>
            </argument>
            <argument name="TO" type="atom">
                <tr lang="en">replace value</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @from -->
            <property name="@from" type="atom" default="None">
                <tr lang="en">replace subject</tr>
            </property>
            <!-- @to -->
            <property name="@to" type="atom" default="None">
                <tr lang="en">replace value</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>input data stream</xinfo>
            </inlet>
            <inlet>
                <xinfo>@from property inlet</xinfo>
            </inlet>
            <inlet>
                <xinfo>@to property inlet</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output data stream</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]  [1 2 3(  [list a b c(
|    |        |
|    |        |
|    |        |
|    | [dump( | [symbol a( [symbol A(
|    | |      | |          |
|    | |      | |.         |..
[replace 3 33333              ]
|
|
[ui.display @auto_size 0 @size 120 17]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
