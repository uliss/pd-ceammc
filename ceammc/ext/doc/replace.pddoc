<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="replace">
    <title>replace</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">replace atoms in data stream</tr>
        <tr lang="ru">замена атомов в потоке данных</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>replace test</keywords>
      <since>0.1</since>
      <also>
        <see>flow.pass</see>
      </also>
      <aliases>
        <alias>ceammc/replace</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">From/to values can be specified both as @from/@to properties or first and
        second arguments.</tr>
        <tr lang="ru" finished="false">Значения от/к значениям могут быть указаны как @from/@to
        свойства, так и первый и второй аргументы.</tr>
      </par>
    </info>
    <arguments>
      <argument name="FROM" type="atom">
        <tr lang="en">replace subject</tr>
        <tr lang="ru" finished="false">Замена предмета</tr>
      </argument>
      <argument name="TO" type="atom">
        <tr lang="en">replace value</tr>
        <tr lang="ru" finished="false">заменить стоимость</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @from -->
      <property name="@from" type="atom" default="None">
        <tr lang="en">replace subject</tr>
        <tr lang="ru" finished="false">Замена предмета</tr>
      </property>
      <!-- @to -->
      <property name="@to" type="atom" default="None">
        <tr lang="en">replace value</tr>
        <tr lang="ru" finished="false">заменить стоимость</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input data stream</tr>
          <tr lang="ru" finished="false">поток входных данных</tr>
        </in>
      </inlet>
      <inlet>
        <in>
          <tr lang="en">@from property inlet</tr>
          <tr lang="ru" finished="false">@ from Property Inlet</tr>
        </in>
      </inlet>
      <inlet>
        <in>
          <tr lang="en">@to property inlet</tr>
          <tr lang="ru" finished="false">@to Property Inlet</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output data stream</tr>
          <tr lang="ru" finished="false">выходной поток данных</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]  [1 2 3(  [list a b c(
|    |        |
|    |        |
|    |        |
|    | [dump( | [symbol a( [symbol A(
|    | |      | |          |
|    | |      | |.         |..
[replace 3 33333              ]
|
|
[ui.display @auto_size 0 @size 120 17]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
