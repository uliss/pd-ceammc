<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="expand_env">
    <title>expand_env</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">substitutes environment variables in a data stream</tr>
        <tr lang="ru">подставляет значения переменных среды в поток данных</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>expand env substitute</keywords>
      <since>0.1</since>
      <also>
        <see>replace</see>
      </also>
      <aliases>
        <alias>ceammc/expand_env</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object substitutes environment variables in incoming symbols, lists or
        messages. Variables are written as %NAME% and are replaced with the corresponding value
        from the environment, for example %HOME% is replaced by the user's home directory under
        UNIX. Variables can appear anywhere inside a symbol, not just at the beginning: for
        example, "user:%USER%" becomes "user:alice".</tr>
        <tr lang="ru">Объект подставляет значения переменных среды во входящие символы, списки и
        сообщения. Переменные записываются как %NAME% и заменяются соответствующим значением из
        окружения: например, %HOME% заменяется каталогом домашних пользователей под UNIX.
        Переменные могут находиться в любом месте символа, а не только в начале: например,
        "user:%USER%" превратится в "user:alice".</tr>
      </par>
      <par>
        <tr lang="en">Some special variables are defined by the library: %DOC% — path to the
        PureData documentation directory, %CEAMMC% — path to the ceammc library directory.</tr>
        <tr lang="ru">Библиотека определяет несколько специальных переменных: %DOC% — путь к
        каталогу документации PureData, %CEAMMC% — путь к каталогу библиотеки ceammc.</tr>
      </par>
      <par>
        <tr lang="en">By default only the arguments (list elements or symbol parts) are expanded,
        not the message selector. With the @any flag, substitution is also performed in the message
        selector.</tr>
        <tr lang="ru">По умолчанию подстановка выполняется только в аргументах (элементах списка
        или частях символа), но не в селекторе сообщения. При флаге @any подстановка выполняется
        также и в селекторе сообщения.</tr>
      </par>
    </info>
    <properties>
      <!-- @any -->
      <property name="@any" type="flag" default="0" access="initonly">
        <tr lang="en">if specified — also perform substitution in the message selector</tr>
        <tr lang="ru">если указан — выполнять подстановку также в селекторе сообщения</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">passed through unchanged</tr>
          <tr lang="ru">передаётся без изменений</tr>
        </in>
        <in on="float">
          <tr lang="en">passed through unchanged</tr>
          <tr lang="ru">передаётся без изменений</tr>
        </in>
        <in on="symbol">
          <tr lang="en">expand variables inside the symbol string</tr>
          <tr lang="ru">подставляет переменные внутри символьной строки</tr>
        </in>
        <in on="list">
          <tr lang="en">expand variables inside each symbol of the list</tr>
          <tr lang="ru">подставляет переменные внутри каждого символа списка</tr>
        </in>
        <in on="any">
          <tr lang="en">expand variables inside each symbol of the message; if the @any flag was
          specified, also expand in the message selector</tr>
          <tr lang="ru">подставляет переменные внутри каждого символа сообщения; если указан флаг
          @any, то также и в селекторе сообщения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output data stream</tr>
          <tr lang="ru">выходной поток данных</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B] [F]  [symbol user:%USER%( [list current shell: %SHELL%(
|   |    |                    |
|   |    |  [doc: %DOC%(      |  [doc: %CEAMMC%(
|   |    |  |                 |  |
|   |    |  |  [%DOC%(        |  | [home: %HOME%(
|   |    |  |  |              |  | |
[expand_env                        ]
|
[ui.display @display_type 1]




[%CEAMMC%(
|
[expand_env @any]
|
[symbol]
|
[S digits=70]
|
[print]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
