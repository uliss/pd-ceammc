<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="data.set2list">
    <title>data.set2list</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">converts a set to a list</tr>
        <tr lang="ru">преобразует множество в список</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data set list</keywords>
      <since>0.3</since>
      <aliases>
        <alias>ceammc/set-&gt;list</alias>
        <alias>set-&gt;list</alias>
      </aliases>
      <also>
        <see>data.set</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Note: the output list is not sorted by default. You can use the @sort flag to
        get a sorted output</tr>
        <tr lang="ru">Примечание: выходной список по умолчанию не сортируется. Чтобы получить
        отсортированный вывод, используйте флаг @sort</tr>
      </par>
    </info>
    <properties>
      <!-- @sort -->
      <property name="@sort" type="flag" default="0" access="initonly">
        <tr lang="en">if specified - sort the output list</tr>
        <tr lang="ru">если указан — сортировать выходной список</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input set</tr>
          <tr lang="ru">входное множество</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output list</tr>
          <tr lang="ru">выходной список</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[dump(
|
| [B] [add a(   [remove a(
| |   |         |
| |   |         |
| |   |         |
[data.set a b c  d]
|           |
[set->list] [set->list @sort]
|           |
[ui.dt]     [ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
