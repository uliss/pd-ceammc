<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="data.set">
        <title>data.set</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">the set: container that store only unique elements</tr>
                <tr lang="ru">множество: контейнер, в котором хранятся только уникальные
                элементы</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data set</keywords>
            <since>0.3</since>
            <also>
                <see>set-&gt;list</see>
                <see>data.list</see>
            </also>
        </meta>
        <mouse>
            <event type="left-click" editmode="false">open data editor</event>
        </mouse>
        <arguments>
            <argument name="X" type="any">
                <tr lang="en">set elements</tr>
                <tr lang="ru" finished="false">заданные элементы</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @empty -->
            <property name="@empty" type="bool" access="readonly" default="1">
                <tr lang="en">1 if list is empty, otherwise 0</tr>
                <tr lang="ru" finished="false">1 если список пуст, в противном случае 0</tr>
            </property>
            <!-- @size -->
            <property name="@size" type="int" access="readonly" minvalue="0" default="0">
                <tr lang="en">number of elements in list</tr>
                <tr lang="ru" finished="false">Количество элементов в списке</tr>
            </property>
        </properties>
        <methods>
            <!-- add -->
            <method name="add">
                <info>
                    <tr lang="en">add values to the set</tr>
                    <tr lang="ru" finished="false">Добавить значения в набор</tr>
                </info>
                <param name="VAL" type="list" required="true">
                    <tr lang="en">added values</tr>
                    <tr lang="ru" finished="false">добавленные значения</tr>
                </param>
            </method>
            <!-- choose -->
            <method name="choose">
                <info>
                    <tr lang="en">choose random element and output it</tr>
                    <tr lang="ru" finished="false">Выберите случайный элемент и выведите его</tr>
                </info>
            </method>
            <!-- clear -->
            <method name="clear">
                <info>
                    <tr lang="en">removes all set elements</tr>
                    <tr lang="ru" finished="false">удаляет все заданные элементы</tr>
                </info>
            </method>
            <!-- remove -->
            <method name="remove">
                <info>
                    <tr lang="en">remove elements from the set</tr>
                    <tr lang="ru" finished="false">Удалить элементы из набора</tr>
                </info>
                <param name="VAL" type="list" required="true">
                    <tr lang="en">elements</tr>
                    <tr lang="ru" finished="false">элементы</tr>
                </param>
            </method>
            <!-- set -->
            <method name="set">
                <info>
                    <tr lang="en">sets new set content without output</tr>
                    <tr lang="ru" finished="false">устанавливает новый контент без вывода</tr>
                </info>
                <param name="LIST" type="list" required="true">
                    <tr lang="en">new set content</tr>
                    <tr lang="ru" finished="false">Новый контент</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">output set content</tr>
                    <tr lang="ru" finished="false">выходные значения</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">adds new element to set, no output</tr>
                    <tr lang="ru" finished="false">Добавление нового элемента в набор, отсутствие
                    выхода</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">adds new element to set, no output</tr>
                    <tr lang="ru" finished="false">Добавление нового элемента в набор, отсутствие
                    выхода</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">adds new elements to set, no output</tr>
                    <tr lang="ru" finished="false">Добавление новых элементов в набор, отсутствие
                    выхода</tr>
                </xinfo>
                <xinfo on="data:set">
                    <tr lang="en">set new set content and output</tr>
                    <tr lang="ru" finished="false">установить новый контент и выход</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">set output</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[$1, bang( [clear( [@size?(
|          |       |
[data.set          ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
