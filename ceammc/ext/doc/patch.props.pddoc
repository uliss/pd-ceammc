<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="patch.props">
    <title>patch.props</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">get or set the patch properties</tr>
        <tr lang="ru">получает или устанавливает свойства патча</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>property</category>
      <keywords>property</keywords>
      <since>0.7</since>
      <also>
        <see>prop.declare</see>
        <see>prop</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">a property should be declared with [prop.declare] before use</tr>
        <tr lang="ru">свойство должно быть объявлено через [prop.declare] перед использованием</tr>
      </par>
      <par>
        <tr lang="en">on bang, all patch properties are output as a list</tr>
        <tr lang="ru">по bang все свойства патча выводятся в виде списка</tr>
      </par>
      <par>
        <tr lang="en">the *default* method resets all properties to their default values and outputs them</tr>
        <tr lang="ru">метод *default* сбрасывает все свойства к значениям по умолчанию и выводит их</tr>
      </par>
    </info>
    <methods>
      <!-- @*? -->
      <method name="@*?">
        <info>
          <tr lang="en">output all patch properties as list</tr>
          <tr lang="ru">вывести все свойства патча в виде списка</tr>
        </info>
      </method>
      <!-- default -->
      <method name="default">
        <info>
          <tr lang="en">reset all props to default value and output</tr>
          <tr lang="ru">сбросить все свойства к значению по умолчанию и вывести</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output all properties in [prop] objects</tr>
          <tr lang="ru">вывести все свойства в объектах [prop]</tr>
        </in>
        <in on="any">
          <tr lang="en">get/set property value and output it</tr>
          <tr lang="ru">получить/установить значение свойства и вывести его</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output value</tr>
          <tr lang="ru">выходное значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[prop.declare freq @min 20 @max 20000 @default 1000]

[prop.declare gain @min -60 @max 12 @default -3]

[@*?( [@freq 100( [@freq?( [default(
|     |           |        |
[patch.props               ]
|
[ui.dt]

[F]          [F]
|            |
[prop @freq] [prop @gain]
|            |
[F]          [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
