<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="live.capture~">
        <title>live.capture~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">record up to 32 seconds of sound and playback the recorded sound in
                loop</tr>
                <tr lang="ru">запись до 32 секунд звука и его воспроизведение в петле</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>live</category>
            <keywords>live record</keywords>
            <since>0.1</since>
        </meta>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @attack -->
            <property name="@attack" type="float" units="millisecond" minvalue="0"
            maxvalue="100000" default="50">
                <tr lang="en">rec envelope attack time</tr>
            </property>
            <!-- @gain -->
            <property name="@gain" type="float" default="0" minvalue="-60" maxvalue="12"
            units="decibel">
                <tr lang="en">playing gain</tr>
            </property>
            <!-- @gate -->
            <property name="@gate" type="bool" default="0">
                <tr lang="en">start/stop recording</tr>
            </property>
            <!-- @release -->
            <property name="@release" type="float" units="millisecond" minvalue="0"
            maxvalue="100000" default="50">
                <tr lang="en">rec envelope release time</tr>
            </property>
            <!-- @sustain -->
            <property name="@sustain" type="float" units="percent" minvalue="0" maxvalue="100"
            default="100">
                <tr lang="en">rec envelope sustain level - percent from trigger signal</tr>
            </property>
        </properties>
        <methods>
            <!-- div -->
            <method name="div">set rec division 
            <param name="N" type="int" minvalue="1" maxvalue="8">
                <tr lang="en">value</tr>
            </param></method>
            <!-- record -->
            <method name="record">start record</method>
            <!-- reset -->
            <method name="reset">reset recorded data</method>
            <!-- stop -->
            <method name="stop">stop record</method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>source signal</xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">1/0 toggle signal</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">recorded signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[adc~]     [reset(
|          |
| [record( | [T]
| |        | |
| | [stop( | [@gate $1( [T]
| | |      | |          |.
[live.capture~             ]
|
[ui.gain~ @size 120 14] [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
