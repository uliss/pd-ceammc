<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="math.sinh~">
        <title>math.sinh~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">hyperbolic sine for signals</tr>
                <tr lang="ru">гиперболический синус для сигналов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math hyperbolic arc sine</keywords>
            <also>
                <see>math.asinh~</see>
                <see>math.sinh</see>
            </also>
            <since>0.9</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Outputs hyperbolic sine of input signal</tr>
            </par>
            <par>
                <tr lang="en">sinh x = (ℯˣ - ℯ⁻ˣ)/2</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Hyperbolic_functions">wiki: Hyperbolic
            functions</a>
        </info>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">result signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[plot.linspace~ -3 3  {w=37} #a]
|            |           |
|            |           [*~ -1]
|            |           |
[math.sinh~] [math.exp~] [math.exp~]
|            |.          |..
[ui.plot~ @xlabels 1 @ylabels 1 @ymin -10 @ymax 10 @size 250 200 @n 3 #b]














[ui.dsp~]
[X a:1->b:3]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
