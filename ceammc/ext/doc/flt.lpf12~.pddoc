<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flt.lpf12~">
        <title>flt.lpf12~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Low-pass second order Butterworth filter</tr>
                <tr lang="ru">ФНЧ Баттерворта второго порядка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter lowpass</keywords>
            <since>0.1</since>
            <also>
                <see>flt.lpf24~</see>
                <see>flt.hpf12~</see>
                <see>flt.c_lpf~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">A low-pass filter is a filter that passes signals with a frequency
                lower than a certain cutoff frequency and attenuates signals with frequencies
                higher than the cutoff frequency. A low-pass filter is the complement of a
                high-pass filter.</tr>
                <!-- old: Низкочастотный фильтр представляет собой фильтр,
                который передает сигналы с частотой ниже определенной частоты отсечки и ослабляет
                сигналы с частотами выше частоты отсечки. Фильтр с низким проходом является
                дополнением фильтра с высоким проходом. -->
                <tr lang="ru" finished="false">Низкочастотный фильтр представляет собой фильтр,
                который передает сигналы с частотой ниже определенной частоты отсечки и ослабляет
                сигналы с частотами выше частоты отсечки. Фильтр с низким проходом является
                дополнением фильтра с высоким проходом.</tr>
            </par>
            <par>
                <tr lang="en">Butterworth filter is a type of filter designed to have a frequency
                response as flat as possible in the passband.</tr>
                <!-- old: Фильтр Баттерворта — это тип фильтра,
                предназначенный для того, чтобы иметь как можно более плоскую частотную реакцию в
                полосе пропускания. -->
                <tr lang="ru" finished="false">Фильтр Баттерворта — это тип фильтра,
                предназначенный для того, чтобы иметь как можно более плоскую частотную реакцию в
                полосе пропускания.</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Butterworth_filter">wiki: Butterworth filter</a>
        </info>
        <arguments>
            <argument name="FREQ" type="float" minvalue="20" maxvalue="20000" units="hertz">
                <tr lang="en">cutoff frequency</tr>
                <tr lang="ru" finished="false">частота отключения</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @freq -->
            <property name="@freq" type="float" units="hertz" minvalue="20" maxvalue="20000"
            default="1000">
                <tr lang="en">cutoff frequency</tr>
                <tr lang="ru" finished="false">частота отключения</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset filter state</tr>
                    <tr lang="ru" finished="false">состояние фильтра сброса</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
            <inlet>
                <in on="float">
                    <tr lang="en">set frequency</tr>
                    <tr lang="ru" finished="false">установленная частота</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">filtered signal</tr>
                    <tr lang="ru" finished="false">фильтрованный сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 10] [ui.hsl]
|          |
[click~]   [lin->lin 0 1 500 15000]
|          |
[*~ 100]   [@freq $1(
|          |
[flt.lpf12~ 5000]
|
[ui.spectroscope~ @size 400 120]









[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
