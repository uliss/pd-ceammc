<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="fx.drone_box~">
        <title>fx.drone_box~</title>
        <meta>
            <authors>
                <author>Oliver Larkin</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">mono sympathetic resonance generator</tr>
                <tr lang="ru">одноканальный симпатический резонансный генератор</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>fx</category>
            <keywords>fx drone</keywords>
            <since>0.6</since>
        </meta>
        <arguments>
            <argument name="PITCH" type="float" minvalue="36" maxvalue="60">
                <tr lang="en">drone MIDI pitch</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @bypass -->
            <property name="@bypass" type="bool" default="0">
                <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
            </property>
            <!-- @decay -->
            <property name="@decay" type="float" minvalue="100" maxvalue="120000"
            units="millisecond" default="4000">
                <tr lang="en">drone pluck decay time</tr>
            </property>
            <!-- @drywet -->
            <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet)
                signals. 0 - dry signal, 1 - wet.</tr>
            </property>
            <!-- @pitch -->
            <property name="@pitch" type="float" minvalue="36" maxvalue="60" default="48">
                <tr lang="en">drone MIDI pitch</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset object</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">input signal</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">set drone pitch</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
[click~]
|
[flt.resonbp~ 100 10]
|
[*~ 20]      [adc~ 1] [T]
|            |        |.
|            [*~      0]
|            |
[fx.drone_box~ 48]
|
[ui.gain~ @size 120 16]  [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
