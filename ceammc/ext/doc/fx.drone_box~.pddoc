<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="fx.drone_box~">
    <title>fx.drone_box~</title>
    <meta>
      <authors>
        <author>Oliver Larkin</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">mono sympathetic resonance generator</tr>
        <tr lang="ru">одноканальный симпатический резонансный генератор</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>fx</category>
      <keywords>fx drone</keywords>
      <since>0.6</since>
    </meta>
    <arguments>
      <argument name="PITCH" type="float" minvalue="36" maxvalue="60">
        <tr lang="en">drone MIDI pitch</tr>
        <tr lang="ru" finished="false">дрон MIDI скачать</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @bypass -->
      <property name="@bypass" type="bool" default="0">
        <tr lang="en">bypass flag. If true: bypass 'effected' signal.</tr>
        <!-- old: Обходной флаг. Если это правда, обойдите
                «эффективный» сигнал. -->
        <tr lang="ru" finished="false">Обходной флаг. Если это правда, обойдите «эффективный»
        сигнал.</tr>
      </property>
      <!-- @decay -->
      <property name="@decay" type="float" minvalue="100" maxvalue="120000" units="millisecond"
      default="4000">
        <tr lang="en">drone pluck decay time</tr>
        <tr lang="ru" finished="false">Время распада дрона</tr>
      </property>
      <!-- @drywet -->
      <property name="@drywet" type="float" minvalue="0" maxvalue="1" default="0.5">
        <tr lang="en">proportion of mix between the original (dry) and 'effected' (wet) signals. 0
        - dry signal, 1 - wet.</tr>
        <!-- old: пропорция смеси между исходным (сухим) и «влажным»
                сигналами. 0 - сухой сигнал, 1 - влажный. -->
        <tr lang="ru" finished="false">пропорция смеси между исходным (сухим) и «влажным»
        сигналами. 0 - сухой сигнал, 1 - влажный.</tr>
      </property>
      <!-- @pitch -->
      <property name="@pitch" type="float" minvalue="36" maxvalue="60" default="48">
        <tr lang="en">drone MIDI pitch</tr>
        <tr lang="ru" finished="false">дрон MIDI скачать</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset object</tr>
          <tr lang="ru" finished="false">сбрасывать объект</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru" finished="false">входной сигнал</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set drone pitch</tr>
          <tr lang="ru" finished="false">Настройка дрона</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru" finished="false">выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[click~]
|
[flt.resonbp~ 100 10]
|
[*~ 20]      [adc~ 1] [T]
|            |        |.
|            [*~      0]
|            |
[fx.drone_box~ 48]
|
[ui.gain~ @size 120 16]  [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
