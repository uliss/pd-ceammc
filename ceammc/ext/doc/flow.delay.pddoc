<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.delay">
    <title>flow.delay</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">enhanced version of the vanilla [delay] object</tr>
        <tr lang="ru">расширенная версия стандартного объекта [delay]</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>flow delay</keywords>
      <since>0.9.1</since>
      <aliases>
        <alias>flow.del</alias>
      </aliases>
      <also>
        <see>delay</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Delays any incoming message by the specified time. With @block = 0 it acts
        like the vanilla [delay]: if a new message arrives while the delay time has not yet
        expired, the old message is discarded and the new delay time is set from the current
        moment.</tr>
        <tr lang="ru">Задерживает любое входящее сообщение на заданное время. При @block = 0
        ведёт себя как стандартный [delay]: если новое сообщение приходит, пока время задержки
        ещё не истекло, старое сообщение отбрасывается, а новое время задержки отсчитывается от
        текущего момента.</tr>
      </par>
      <par>
        <tr lang="en">A zero delay time means the message is output on the next Pd runloop
        iteration (as soon as possible).</tr>
        <tr lang="ru">Нулевое время задержки означает, что сообщение выводится на следующей
        итерации цикла Pd (как можно скорее).</tr>
      </par>
      <par>
        <tr lang="en">Note: the @delay property can only be set via the right inlet or with the
        [prop.set] object.</tr>
        <tr lang="ru">Примечание: свойство @delay можно задать только через правый вход или через
        объект [prop.set].</tr>
      </par>
    </info>
    <arguments>
      <argument name="DELAY" type="float" minvalue="0" units="millisecond">
        <tr lang="en">initial @delay value</tr>
        <tr lang="ru">начальное значение @delay</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @block -->
      <property name="@block" type="bool" default="0">
        <tr lang="en">blocking mode. If true, discards incoming messages until the scheduled
        message is output; after that, it is ready to accept a new one. Otherwise, acts like the
        vanilla [delay] object.</tr>
        <tr lang="ru">режим блокировки. Если истина, отбрасывает входящие сообщения до вывода
        запланированного сообщения; после этого готов принять новое. В остальном ведёт себя как
        стандартный [delay].</tr>
      </property>
      <!-- @delay -->
      <property name="@delay" type="float" minvalue="0" default="0" units="millisecond">
        <tr lang="en">delay time</tr>
        <tr lang="ru">время задержки</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="any">
          <tr lang="en">incoming message</tr>
          <tr lang="ru">входящее сообщение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">cancels the current delay if it was scheduled</tr>
          <tr lang="ru">отменяет текущую задержку, если она была запланирована</tr>
        </in>
        <in on="float" minvalue="0">
          <tr lang="en">set delay time</tr>
          <tr lang="ru">задать время задержки</tr>
        </in>
        <in on="any" selector="reset">
          <tr lang="en">cancels the current delay if it is scheduled</tr>
          <tr lang="ru">отменяет текущую задержку, если она запланирована</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">outputs delayed messages</tr>
          <tr lang="ru">выводит сообщения с задержкой</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[@freq 1000( [@freq 2000(
|            |
[t a         ]
| |
| [flow.del 100]
| |
[t b a     ]
|         ^|
[click~]   |
|          |
[flt.resonbp~]
|
[ui.hgain~]
|\
[dac~]

[@msg 400( [300(  [0(/*change delay time*/
|          |      |
|          [prop.set @delay] [F] /* the same*/
|          |                 |.
[flow.delay 1000              ]
|
[ui.display @display_type 1]

[1 2(/*zero time*/
|
[unpack f f]
|   ^|  ^|
|    |  [flow.del 0]
|    |  |
[print Z]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
