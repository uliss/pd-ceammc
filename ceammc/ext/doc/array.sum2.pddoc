<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.sum2">
    <title>array.sum2</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">calculates the sum of squares of array elements</tr>
        <tr lang="ru">вычисляет сумму квадратов элементов массива</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array sum</keywords>
      <since>0.8</since>
      <also>
        <see>array.sum</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">The object computes the sum of squares of all samples in the specified array
        and outputs it as a single float. This value is used, for example, when calculating the RMS
        and variance of the array.</tr>
        <tr lang="ru">Объект вычисляет сумму квадратов всех семплов указанного массива и выводит её
        одним числом с плавающей точкой. Это значение используется, например, при вычислении RMS
        и дисперсии массива.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">calculates the sum of squares and outputs it</tr>
          <tr lang="ru">вычисляет сумму квадратов и выводит её</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">sum of array squares</tr>
          <tr lang="ru">сумма квадратов массива</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                            [array asum2 size=100 w=180 h=130]
|
[array.sum2 asum2]
|
[F digits=16]

[sinesum 100 0.2 0.3(
|
[s asum2]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
