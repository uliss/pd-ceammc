<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.pol2car">
    <title>conv.pol2car</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">convert from polar coordinates to cartesian</tr>
        <tr lang="ru">преобразует полярные координаты в декартовы</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv polar cartesian</keywords>
      <since>0.8</since>
      <also>
        <see>conv.car2pol</see>
      </also>
      <aliases>
        <alias>ceammc/pol-&gt;car</alias>
        <alias>pol-&gt;car</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object converts polar coordinates (radius, angle) to Cartesian
        coordinates (x, y). The angle is given in radians. This is the inverse operation of
        [conv.car2pol].</tr>
        <tr lang="ru">Объект преобразует полярные координаты (радиус, угол) в декартовы координаты
        (x, y). Угол задаётся в радианах. Это операция, обратная [conv.car2pol].</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">radius and angle (in radians) pair</tr>
          <tr lang="ru">пара: радиус и угол (в радианах)</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">x, y coordinates pair</tr>
          <tr lang="ru">пара координат x, y</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.knob]
|
|
|
[F]
|
[phase->rad]
|
[1 $1(
|
[pol->car]
|
[ui.slider2d @size 100 100]




/*.*/
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
