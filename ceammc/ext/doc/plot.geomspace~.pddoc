<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.10">
    <object name="plot.geomspace~">
        <title>plot.geomspace~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">generates a sequence of numbers that are evenly distributed on a
                logarithmic scale (geometric progression)</tr>
                <tr lang="ru">выводит последовательность равномерно распределенных по
                логарифмической шкале чисел (геометрическая прогрессия)</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array geom log scale</keywords>
            <also>
                <see>plot.linspace~</see>
                <see>plot.logspace~</see>
            </also>
            <since>0.9</since>
        </meta>
        <arguments>
            <argument name="START" type="float" minvalue="0">
                <tr lang="en">@start property</tr>
            </argument>
            <argument name="STOP" type="float" minvalue="0">
                <tr lang="en">@stop property</tr>
            </argument>
            <argument name="N" type="int" minvalue="4" maxvalue="1024">
                <tr lang="en">@n property</tr>
            </argument>
            <argument name="BASE" type="atom" enum="10 2 e">
                <tr lang="en">x-axis scale base</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @10 -->
            <property name="@10" type="atom">alias to @base 10</property>
            <!-- @2 -->
            <property name="@2" type="atom">alias to @base 2</property>
            <!-- @base -->
            <property name="@base" type="atom" enum="10 2 e" default="10">x-axis scale
            base</property>
            <!-- @e -->
            <property name="@e" type="atom">alias to @base e</property>
            <!-- @endpoint -->
            <property name="@endpoint" type="bool" default="1">include @stop to interval</property>
            <!-- @n -->
            <property name="@n" type="int" minvalue="4" maxvalue="1024" default="100">number of
            points</property>
            <!-- @start -->
            <property name="@start" type="float" minvalue="0" default="0.1">the starting value of
            the sequence</property>
            <!-- @stop -->
            <property name="@stop" type="float" minvalue="0" default="100">the final value of the
            sequence, unless @endpoint is false. In that case, @n + 1 values are spaced over the
            interval in log-space, of which all but the last (a sequence of length @n) are
            returned.</property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">starts output</xinfo>
                <xinfo on="float">output specified number of values, change @n property
                valuue</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">signal output</outlet>
            <outlet>output to [array.plot~] or [ui.plot~]</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]
|
|
[plot.geomspace~ 2 1024]
|      ^|.
[ui.plot~ @size 400 150 @xlabels 1 @ylabels 1 @xmin_grid 1 @ymin_ticks 0 @xmin_ticks 0 @yauto 1]










[ui.dsp~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
