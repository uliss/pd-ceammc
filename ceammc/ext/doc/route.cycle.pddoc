<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="route.cycle">
        <title>route.cycle</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">cyclic message router</tr>
                <tr lang="ru">циклический маршрутизатор сообщений</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>route cycle round robin</keywords>
            <since>0.9.7</since>
            <also>
                <see>flow.ring</see>
                <see>route.random</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">NOTICE: to get properties use [prop.get] object, cause all messages
                (including property requests) are passed thru</tr>
                <tr lang="ru" finished="false">ПРИМЕЧАНИЕ: чтобы получить свойства использовать
                [prop.get] объект, причина все сообщения (включая запросы собственности) передаются
                через</tr>
            </par>
        </info>
        <arguments>
            <argument name="N" type="int" minvalue="1" maxvalue="64">
                <tr lang="en">number of outlets</tr>
                <tr lang="ru" finished="false">количество торговых точек</tr>
            </argument>
            <argument name="OFFSET" type="int" minvalue="-64" maxvalue="64">
                <tr lang="en">start position</tr>
                <tr lang="ru" finished="false">стартовая позиция</tr>
            </argument>
            <argument name="STEP" type="int">
                <tr lang="en">cycle step</tr>
                <tr lang="ru" finished="false">этап цикла</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @index -->
            <property name="@index" type="int" default="0">
                <tr lang="en">current outlet index</tr>
                <tr lang="ru" finished="false">Текущий индекс выхода</tr>
            </property>
            <!-- @n -->
            <property name="@n" type="int" default="2" minvalue="1" maxvalue="64"
            access="initonly">
                <tr lang="en">number of outlets</tr>
                <tr lang="ru" finished="false">количество торговых точек</tr>
            </property>
            <!-- @offset -->
            <property name="@offset" type="int" default="0" minvalue="-64" maxvalue="64">
                <tr lang="en">init cycle offset</tr>
                <tr lang="ru" finished="false">Смещение цикла init</tr>
            </property>
            <!-- @step -->
            <property name="@step" type="int" default="1">
                <tr lang="en">cycle step</tr>
                <tr lang="ru" finished="false">этап цикла</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="any">
                    <tr lang="en">any to current outlet, then move to next</tr>
                    <tr lang="ru" finished="false">любой к текущему выходу, затем перейти к
                    следующему</tr>
                </xinfo>
                <xinfo on="bang">
                    <tr lang="en">bang to current outlet, then move to next</tr>
                    <tr lang="ru" finished="false">Bang to current outlet, затем перейти к
                    следующему</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">float to current outlet, then move to next</tr>
                    <tr lang="ru" finished="false">Поплавать к текущей розетке, затем перейти к
                    следующей</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">list to to current outlet, then move to next</tr>
                    <tr lang="ru" finished="false">Перечислите текущий выход, затем перейдите к
                    следующему</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">symbol to current outlet, then move to next</tr>
                    <tr lang="ru" finished="false">символ к текущей розетке, затем перейти к
                    следующей</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">reset to initial outlet index</tr>
                    <tr lang="ru" finished="false">Сброс начального индекса выхода</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="any">
                    <tr lang="en">first output</tr>
                    <tr lang="ru" finished="false">первый выход</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">... output</tr>
                    <tr lang="ru" finished="false">... выход</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">nth output</tr>
                    <tr lang="ru" finished="false">выходной</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 150]
|
| [bang(
| |
[route.cycle 4 #r]



[click~ #ca] [click~ #cb] [click~ #cc] [click~ #cd]

[flt.resonlp~ 400 #a]

    [flt.resonlp~ 600 #b]

        [flt.resonlp~ 800 #c]

            [flt.resonlp~ 1200 #d]

[pan.spread~ 4 #p]
*|*
[ui.hgain2~]           [ui.dsp~]
*|*
[dac~]

[X a->p:0]
[X b->p:1]
[X c->p:2]
[X d->p:3]
[X r:0->ca]
[X r:1->cb]
[X r:2->cc]
[X r:3->cd]
[X ca->a]
[X cb->b]
[X cc->c]
[X cd->d]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
