<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="system.cursor">
        <title>system.cursor</title>
        <meta>
            <authors>
                <author>Hans-Christoph Steiner</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs the cursor motion, mousewheel and button clicks</tr>
                <tr lang="ru">выводит положение курсора, нажатия кнопок мыши и колеса
                прокрутки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>system</category>
            <keywords>cursor mouse mousewheel</keywords>
            <since>0.1</since>
        </meta>
        <properties>
            <!-- @clip -->
            <property name="@clip" type="bool" default="0">
                <tr lang="en">clip mode. If true clip a cursor XY values to the [0..1] range in
                normalized mode, to the window width/height relative mode, otherwise to the screen
                width/height</tr>
            </property>
            <!-- @norm -->
            <property name="@norm" type="bool" default="0">
                <tr lang="en">cursor x/y coordinates normalization by screen (or window)
                width/height</tr>
            </property>
            <!-- @relative -->
            <property name="@relative" type="bool" default="0">
                <tr lang="en">relative output mode: if on output coords relative to the root
                window, otherwise output screen coordinates</tr>
            </property>
        </properties>
        <methods>
            <!-- polltime -->
            <method name="polltime">sets global cursor polling time 
            <param name="T" type="float" units="millisecond" minvalue="10" maxvalue="1000"
            required="true">polling time</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">output cursor position</xinfo>
                <xinfo on="float">when 1 is received - turns on cursor polling (position and
                buttons), when 0 is received - turns it off</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>messages: motion X Y, mousewheel DELTA, button IDX STATE</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]       [T]            [T]        [T]         [system.cursor-abs]
|         |              |          |
|  [bang( [@relative $1( [@norm $1( [@clip $1(  [system.cursor-osc~]
|  |      |              |          |
|  |      |              |          |
|  |      |              |          |
[system.cursor                      ]
|
[route motion mousewheel button]
|        ^|   ^^|
|        [F]   [route 1 2 3]
|              |   ^|   ^^|
|              [T] [T]  [T]
|
[ui.dt]
]]>
            </pdascii>
            <pdascii id="1">
<![CDATA[
[inlet]
|
[system.cursor]
|
[outlet]
]]>
            </pdascii>
            <pdascii id="abs">
<![CDATA[
[T]       [T]            [T]        [T]
|         |              |          |
|  [bang( [@relative $1( [@norm $1( [@clip $1(
|  |      |              |          |
|  |      |              |          |
|  |      |              |          |
[system.cursor-1                    ]
|
[route motion mousewheel button]
|        ^|   ^^|
|        [F]   [route 1 2 3]
|              |   ^|   ^^|
|              [T] [T]  [T]
|
[ui.dt]
]]>
            </pdascii>
            <pdascii id="osc~">
<![CDATA[
[T]
|
[system.cursor @norm 1 @clip 1]
|
[route motion]
|
[lin->lin 0 1 100 5000]
|
[unpack f f]
|       ^|
[osc~]  [osc~]
|       |
[ui.hgain~]       [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
