<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="system.cursor">
    <title>system.cursor</title>
    <meta>
      <authors>
        <author>Hans-Christoph Steiner</author>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">outputs the cursor motion, mouse wheel and button clicks</tr>
        <tr lang="ru">выводит положение курсора, нажатия кнопок мыши и колеса прокрутки</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>system</category>
      <keywords>cursor mouse mousewheel</keywords>
      <since>0.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Outputs cursor movement, mouse wheel events and mouse button presses as
        control messages. Polling can be turned on and off from the inlet. The polling interval is
        set globally via the polltime method.</tr>
        <tr lang="ru">Выводит перемещение курсора, события колеса мыши и нажатия кнопок мыши в
        виде управляющих сообщений. Опрос можно включать и выключать, интервал опроса
        задаётся глобально через метод polltime.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Interactive patches driven by the mouse — using cursor position and mouse
        button presses to control sound parameters, trigger events or navigate a patch without a
        dedicated GUI element.</tr>
        <tr lang="ru">• Интерактивные патчи, управляемые мышью — использование положения курсора и
        нажатий кнопок мыши для управления звуковыми параметрами, запуска событий или навигации по
        патчу без специального GUI-элемента.</tr>
      </par>
    </info>
    <properties>
      <!-- @clip -->
      <property name="@clip" type="bool" default="0">
        <tr lang="en">clip mode. If true, clips cursor X/Y values to the [0..1] range in normalized
        mode, to the window width/height in relative mode, otherwise to the screen
        width/height</tr>
        <tr lang="ru">режим обрезки. Если истина, значения X/Y курсора ограничиваются диапазоном
        [0..1] в нормализованном режиме, размерами окна в относительном режиме и размерами экрана
        в остальных случаях</tr>
      </property>
      <!-- @norm -->
      <property name="@norm" type="bool" default="0">
        <tr lang="en">cursor x/y coordinates normalization by the screen (or window)
        width/height</tr>
        <tr lang="ru">нормализация координат курсора x/y по ширине и высоте экрана (или окна)</tr>
      </property>
      <!-- @relative -->
      <property name="@relative" type="bool" default="0">
        <tr lang="en">relative output mode. If on, outputs coordinates relative to the root window,
        otherwise outputs absolute screen coordinates</tr>
        <tr lang="ru">режим относительного вывода. Если включён, выводятся координаты относительно
        корневого окна, иначе выводятся абсолютные координаты экрана</tr>
      </property>
    </properties>
    <methods>
      <!-- polltime -->
      <method name="polltime">
        <info>
          <tr lang="en">sets the global cursor polling time</tr>
          <tr lang="ru">устанавливает глобальное время опроса курсора</tr>
        </info>
        <param name="T" type="float" units="millisecond" minvalue="10" maxvalue="1000"
        required="true">
          <tr lang="en">polling time</tr>
          <tr lang="ru">время опроса</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">outputs the cursor position</tr>
          <tr lang="ru">выводит положение курсора</tr>
        </in>
        <in on="float">
          <tr lang="en">when 1 is received, turns on cursor polling (position and buttons); when 0
          is received, turns it off</tr>
          <tr lang="ru">при получении 1 включается опрос курсора (позиция и кнопки); при получении
          0 — выключается</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">messages: motion X Y, mousewheel DELTA, button IDX STATE</tr>
          <tr lang="ru">сообщения: motion X Y, mousewheel DELTA, button IDX STATE</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]       [T]            [T]        [T]         [system.cursor-abs]
|         |              |          |
|  [bang( [@relative $1( [@norm $1( [@clip $1(  [system.cursor-osc~]
|  |      |              |          |
|  |      |              |          |
|  |      |              |          |
[system.cursor                      ]
|
[route motion mousewheel button]
|        ^|   ^^|
|        [F]   [route 1 2 3]
|              |   ^|   ^^|
|              [T] [T]  [T]
|
[ui.dt]
]]>
      </pdascii>
      <pdascii id="1">
<![CDATA[
[inlet]
|
[system.cursor]
|
[outlet]
]]>
      </pdascii>
      <pdascii id="abs">
<![CDATA[
[T]       [T]            [T]        [T]
|         |              |          |
|  [bang( [@relative $1( [@norm $1( [@clip $1(
|  |      |              |          |
|  |      |              |          |
|  |      |              |          |
[system.cursor-1                    ]
|
[route motion mousewheel button]
|        ^|   ^^|
|        [F]   [route 1 2 3]
|              |   ^|   ^^|
|              [T] [T]  [T]
|
[ui.dt]
]]>
      </pdascii>
      <pdascii id="osc~">
<![CDATA[
[T]
|
[system.cursor @norm 1 @clip 1]
|
[route motion]
|
[lin->lin 0 1 100 5000]
|
[unpack f f]
|       ^|
[osc~]  [osc~]
|       |
[ui.hgain~]       [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
