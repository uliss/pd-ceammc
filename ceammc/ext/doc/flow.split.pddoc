<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.split">
    <title>flow.split</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">splits control flow by external side-chain predicate</tr>
        <tr lang="ru">разделят управляющий поток внешним предикатом боковой цепи</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>pass functional</keywords>
      <since>0.3</since>
      <aliases>
        <alias>ceammc/split</alias>
        <alias>split</alias>
      </aliases>
      <also>
        <see>flow.pass</see>
        <see>flow.reject</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Predicate side chain should accept value and return 1 (true) or 0 (false). If
        true, input value is outputed to first outlet. Otherwise to second outlet.</tr>
        <!-- old: Побочная цепочка предикатов должна принимать
                значение и возвращать 1 (истинное) или 0 (ложное). Если это правда, входное
                значение выводится на первую розетку. В противном случае второй выход. -->
        <tr lang="ru" finished="false">Побочная цепочка предикатов должна принимать значение и
        возвращать 1 (истинное) или 0 (ложное). Если это правда, входное значение выводится на
        первую розетку. В противном случае второй выход.</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input value</tr>
          <tr lang="ru" finished="false">входная стоимость</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">input from predicate side chain. If 1 received - output for first outlet.
          If 0 - to second.</tr>
          <!-- old: Вход из предикатов боковой цепи. Если получено 1
                    - выход для первого выхода. Если 0 - в секунду. -->
          <tr lang="ru" finished="false">Вход из предикатов боковой цепи. Если получено 1 - выход
          для первого выхода. Если 0 - в секунду.</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">values for which predicate side-chain returned true</tr>
          <tr lang="ru" finished="false">значения, для которых предикатная боковая цепь вернулась
          истинной</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">values for which predicate side-chain returned false</tr>
          <tr lang="ru" finished="false">значения, для которых предикат боковой цепи возвращался
          ложным</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">value to predicate side-chain</tr>
          <tr lang="ru" finished="false">значение для предиката боковой цепи</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]                    [1 2( [2 1(        [flow.split-more]
|                      |     |
[flow.split]X[> 0]     [flow.split]X[<]   [flow.split-sound]
|    ^|                |     ^|
[F]  [F]               |     [ui.dt]
                       |
                       [ui.dt]
]]>
      </pdascii>
      <pdascii id="more">
<![CDATA[
[B]
|
[flow.split]X[T]
|   ^|
[B] [B]

[F]
|
[@abc $1( [F]
|         |
[flow.split]X[is_any]
|   ^|
|    [ui.dt]
|
[ui.dt]
]]>
      </pdascii>
      <pdascii id="sound">
<![CDATA[
[ui.keyboard]
|
|
|
|
[flow.split #a {w=50}]                [list.at 0 #b]
|                                     |
|                                     [< 60 #c]
|
[unpack   f f ]      [unpack   f f #d]
|           ^|       |           ^|
[mtof]     [> 0]     [mtof]     [> 0]
|          |.        |          |.
[pack f f    ]       [pack     f f]
|                    |
[@freq $1, @gate $2( [@freq $1, @gate $2(
|                    |
[synth.bee3~]        [synth.rhodey~]
|.                   |..
[pan.spread~ 4     {i=4,o=2}]
*|*
[ui.hgain2~ {i=2,o=2}]
*|*
[dac~ {i=2}]

[X a:1->d]
[X a:2->b]
[X c->a:1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
