<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.split">
    <title>flow.split</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">splits control flow by external side-chain predicate</tr>
        <tr lang="ru">разделяет управляющий поток внешним предикатом боковой цепи</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>pass functional</keywords>
      <since>0.3</since>
      <aliases>
        <alias>ceammc/split</alias>
        <alias>split</alias>
      </aliases>
      <also>
        <see>flow.pass</see>
        <see>flow.reject</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object routes the input value to the first or second outlet depending on
        the result of the predicate connected to the side-chain</tr>
        <tr lang="ru">объект направляет входное значение на первый или второй выход в зависимости
        от результата предиката, подключённого к боковой цепи</tr>
      </par>
      <par>
        <tr lang="en">the predicate should accept the value and return 1 (true) or 0 (false): if 1,
        the value goes to the first outlet, if 0 — to the second</tr>
        <tr lang="ru">предикат должен принимать значение и возвращать 1 (истина) или 0 (ложь): если
        1 — значение идёт на первый выход, если 0 — на второй</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to separate a stream by any condition, for example to
        split notes into low and high registers</tr>
        <tr lang="ru">объект можно использовать для разделения потока по любому условию, например
        чтобы разделить ноты на низкий и высокий регистры</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input value</tr>
          <tr lang="ru">входное значение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">input from the predicate side-chain. If 1 is received, output to the first
          outlet. If 0, to the second</tr>
          <tr lang="ru">вход от боковой цепи предиката. Если получено 1 — вывод на первый выход.
          Если 0 — на второй</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">values for which the predicate side-chain returned true</tr>
          <tr lang="ru">значения, для которых боковая цепь предиката вернула истину</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">values for which the predicate side-chain returned false</tr>
          <tr lang="ru">значения, для которых боковая цепь предиката вернула ложь</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">value to the predicate side-chain</tr>
          <tr lang="ru">значение для боковой цепи предиката</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]                    [1 2( [2 1(        [flow.split-more]
|                      |     |
[flow.split]X[> 0]     [flow.split]X[<]   [flow.split-sound]
|    ^|                |     ^|
[F]  [F]               |     [ui.dt]
                       |
                       [ui.dt]
]]>
      </pdascii>
      <pdascii id="more">
<![CDATA[
[B]
|
[flow.split]X[T]
|   ^|
[B] [B]

[F]
|
[@abc $1( [F]
|         |
[flow.split]X[is_any]
|   ^|
|    [ui.dt]
|
[ui.dt]
]]>
      </pdascii>
      <pdascii id="sound">
<![CDATA[
[ui.keyboard]
|
|
|
|
[flow.split #a {w=50}]                [list.at 0 #b]
|                                     |
|                                     [< 60 #c]
|
[unpack   f f ]      [unpack   f f #d]
|           ^|       |           ^|
[mtof]     [> 0]     [mtof]     [> 0]
|          |.        |          |.
[pack f f    ]       [pack     f f]
|                    |
[@freq $1, @gate $2( [@freq $1, @gate $2(
|                    |
[synth.bee3~]        [synth.rhodey~]
|.                   |..
[pan.spread~ 4     {i=4,o=2}]
*|*
[ui.hgain2~ {i=2,o=2}]
*|*
[dac~ {i=2}]

[X a:1->d]
[X a:2->b]
[X c->a:1]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
