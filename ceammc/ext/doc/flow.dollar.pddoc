<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="flow.dollar">
    <title>flow.dollar</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">substitude the $-values</tr>
        <tr lang="ru">подставляет $-значения</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>flow</category>
      <keywords>dollar</keywords>
      <since>0.9.3</since>
      <aliases>
        <alias>flow.$$</alias>
      </aliases>
    </meta>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">input message flow</tr>
          <tr lang="ru">входной поток сообщений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">outputs messages with substituted $-values</tr>
          <tr lang="ru">выводит сообщения с подставленными $-значениями</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[load file to \\\\$0-array @resize(
|
[flow.dollar]
|
[ui.dt]

[flow.dollar-args A B]
]]>
      </pdascii>
      <pdascii id="args">
<![CDATA[
[some args \\\\$0 \\\\$1 \\\\$2 \\\\$3(
|
[flow.dollar]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
