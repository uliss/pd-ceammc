<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="ui.mouse_route">
        <title>ui.mouse_route</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">routes mouse events from UI objects</tr>
                <tr lang="ru">маршрутизация событий мыши от UI объектов</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category view="link">ui</category>
            <keywords>ui mouse filter events</keywords>
            <since>0.8</since>
            <aliases>
                <alias>ui.mr</alias>
            </aliases>
            <also>
                <see>ui.mouse_filter</see>
                <see view="link">ui.rslider</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">routes only specified mouse events from ui.* objects</tr>
            </par>
        </info>
        <properties>
            <!-- @down -->
            <property name="@down" type="alias" default="0">
                <tr lang="en">alias to @mouse_down 1 property</tr>
            </property>
            <!-- @drag -->
            <property name="@drag" type="alias" default="0">
                <tr lang="en">alias to @mouse_drag 1 property</tr>
            </property>
            <!-- @enter -->
            <property name="@enter" type="alias" default="0">
                <tr lang="en">alias to @mouse_enter 1 property</tr>
            </property>
            <!-- @leave -->
            <property name="@leave" type="alias" default="0">
                <tr lang="en">alias to @mouse_leave 1 property</tr>
            </property>
            <!-- @mouse_down -->
            <property name="@mouse_down" type="bool" default="0">
                <tr lang="en">passing a @mouse_down events</tr>
            </property>
            <!-- @mouse_drag -->
            <property name="@mouse_drag" type="bool" default="0">
                <tr lang="en">passing a @mouse_drag events</tr>
            </property>
            <!-- @mouse_enter -->
            <property name="@mouse_enter" type="bool" default="0">
                <tr lang="en">passing a @mouse_enter events</tr>
            </property>
            <!-- @mouse_leave -->
            <property name="@mouse_leave" type="bool" default="0">
                <tr lang="en">passing a @mouse_leave events</tr>
            </property>
            <!-- @mouse_move -->
            <property name="@mouse_move" type="bool" default="0">
                <tr lang="en">passing a @mouse_move events</tr>
            </property>
            <!-- @mouse_up -->
            <property name="@mouse_up" type="bool" default="0">
                <tr lang="en">passing a @mouse_up events</tr>
            </property>
            <!-- @move -->
            <property name="@move" type="alias" default="0">
                <tr lang="en">alias to @mouse_move 1 property</tr>
            </property>
            <!-- @up -->
            <property name="@up" type="alias" default="0">
                <tr lang="en">alias to @mouse_up 1 property</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">input messages from ui object</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet number="1">
                <out type="any">
                    <tr lang="en">first mouse event type match output</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">... mouse event type match output</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">n-th mouse event type match output</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.hsl @mouse_events 1]
|
[ui.mouse_route @down @up @drag]
|         ^|         ^^|
[F]       [F]        [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
