<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="system.exec">
        <title>system.exec</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">run the external command in a separate process</tr>
                <tr lang="ru">запуск внешней команды в отдельном процессе</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>system</category>
            <keywords>system execute</keywords>
            <since>0.7</since>
        </meta>
        <properties>
            <!-- @is_running -->
            <property name="@is_running" type="bool" access="readonly" default="0">
                <tr lang="en">is process is running</tr>
                <tr lang="ru" finished="false">Процесс запущен</tr>
            </property>
            <!-- @low -->
            <property name="@low" type="alias">
                <tr lang="en">alias to @priority low</tr>
                <tr lang="ru" finished="false">Оригинальное название: @priority Low</tr>
            </property>
            <!-- @priority -->
            <property name="@priority" type="symbol" enum="normal low" default="normal">
                <tr lang="en">subprocess priority (not all platforms are supported)</tr>
                <tr lang="ru" finished="false">Приоритет субпроцессов (поддерживаются не все
                платформы)</tr>
            </property>
            <!-- @state -->
            <property name="@state" type="int" default="-1" access="readonly">
                <tr lang="en">running process state: -1 (no process), 0 (not started), 1 (running),
                2 (finished)</tr>
                <tr lang="ru" finished="false">Состояние запущенного процесса: -1 (без процесса), 0
                (не запущен), 1 (бег), 2 (завершен)</tr>
            </property>
        </properties>
        <methods>
            <!-- eof -->
            <method name="eof">
                <info>
                    <tr lang="en">send EOF to running processes</tr>
                    <tr lang="ru" finished="false">Отправить EOF в запущенные процессы</tr>
                </info>
            </method>
            <!-- stop -->
            <method name="stop">
                <info>
                    <tr lang="en">stop running process</tr>
                    <tr lang="ru" finished="false">Прекратить процесс запуска</tr>
                </info>
            </method>
            <!-- terminate -->
            <method name="terminate">
                <info>
                    <tr lang="en">terminate running process</tr>
                    <tr lang="ru" finished="false">Окончание рабочего процесса</tr>
                </info>
            </method>
            <!-- write -->
            <method name="write">
                <info>
                    <tr lang="en">write data to process stdin</tr>
                    <tr lang="ru" finished="false">записывать данные для обработки stdin</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="symbol">
                    <tr lang="en">run specified program</tr>
                    <tr lang="ru" finished="false">Запуск определенной программы</tr>
                </in>
                <in on="any">
                    <tr lang="en">run specified program with arguments</tr>
                    <tr lang="ru" finished="false">Запуск определенной программы с аргументами</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output process exit code</tr>
                    <tr lang="ru" finished="false">Выходной код выходного процесса</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">output list of strings</tr>
                    <tr lang="ru" finished="false">выходной список строк</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ls( [ls -l( [open #a(
|    |
|    | [top(      [winver.exe #c(
|    | |
[list  #b]  [terminate(
|           |
[system.exec ]
|           ^|
[F]         [print EXEC]
[X a->b] [X c->b]
#a /Applications/TextEdit.app
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
