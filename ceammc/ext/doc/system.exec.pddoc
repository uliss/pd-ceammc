<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="system.exec">
    <title>system.exec</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">run the external command in a separate process</tr>
        <tr lang="ru">запуск внешней команды в отдельном процессе</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>system</category>
      <keywords>system execute</keywords>
      <since>0.7</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Runs the given external command in a separate process and outputs its exit
        code and stdout as a list of strings. The process can be controlled via the eof, stop and
        terminate methods, and additional data can be sent to its stdin with the write
        method.</tr>
        <tr lang="ru">Запускает указанную внешнюю команду в отдельном процессе и выводит её код
        завершения и stdout в виде списка строк. Процессом можно управлять через методы eof, stop
        и terminate, а дополнительные данные можно отправлять в его stdin методом write.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Running scripts and tools from a patch — executing external programs
        (Python scripts, ffmpeg, custom utilities) directly from Pd and using their output to
        drive the patch or trigger further actions.</tr>
        <tr lang="ru">• Запуск сценариев и утилит из патча — выполнение внешних программ
        (Python-скриптов, ffmpeg, пользовательских утилит) прямо из Pd с использованием их вывода
        для управления патчем или запуска других действий.</tr>
      </par>
    </info>
    <properties>
      <!-- @is_running -->
      <property name="@is_running" type="bool" access="readonly" default="0">
        <tr lang="en">true if the process is running</tr>
        <tr lang="ru">истина, если процесс запущен</tr>
      </property>
      <!-- @low -->
      <property name="@low" type="alias">
        <tr lang="en">alias for @priority low</tr>
        <tr lang="ru">сокращение для @priority low</tr>
      </property>
      <!-- @priority -->
      <property name="@priority" type="symbol" enum="normal low" default="normal">
        <tr lang="en">subprocess priority (not all platforms are supported)</tr>
        <tr lang="ru">приоритет подпроцесса (поддерживаются не все платформы)</tr>
      </property>
      <!-- @state -->
      <property name="@state" type="int" default="-1" access="readonly">
        <tr lang="en">running process state: -1 (no process), 0 (not started), 1 (running), 2
        (finished)</tr>
        <tr lang="ru">состояние процесса: -1 (нет процесса), 0 (не запущен), 1 (выполняется), 2
        (завершён)</tr>
      </property>
    </properties>
    <methods>
      <!-- eof -->
      <method name="eof">
        <info>
          <tr lang="en">sends EOF to the running process</tr>
          <tr lang="ru">отправляет EOF запущенному процессу</tr>
        </info>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stops the running process</tr>
          <tr lang="ru">останавливает запущенный процесс</tr>
        </info>
      </method>
      <!-- terminate -->
      <method name="terminate">
        <info>
          <tr lang="en">terminates the running process</tr>
          <tr lang="ru">завершает запущенный процесс</tr>
        </info>
      </method>
      <!-- write -->
      <method name="write">
        <info>
          <tr lang="en">writes data to the process stdin</tr>
          <tr lang="ru">записывает данные в stdin процесса</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">runs the specified program</tr>
          <tr lang="ru">запускает указанную программу</tr>
        </in>
        <in on="any">
          <tr lang="en">runs the specified program with arguments</tr>
          <tr lang="ru">запускает указанную программу с аргументами</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">outputs the process exit code</tr>
          <tr lang="ru">выводит код завершения процесса</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">outputs a list of strings</tr>
          <tr lang="ru">выводит список строк</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ls( [ls -l( [open #a(
|    |
|    | [top(      [winver.exe #c(
|    | |
[list  #b]  [terminate(
|           |
[system.exec ]
|           ^|
[F]         [print EXEC]
[X a->b] [X c->b]
#a /System/Applications/TextEdit.app
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
