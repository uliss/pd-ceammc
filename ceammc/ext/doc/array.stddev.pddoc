<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="array.stddev">
        <title>array.stddev</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">calculates standard deviation for array values</tr>
                <tr lang="ru">вычисляет стандартное отклонение для значений массива</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array deviation</keywords>
            <since>0.7.1</since>
            <also>
                <see>array.variance</see>
            </also>
        </meta>
        <info>
            <wiki name="Standard_deviation">Standard deviation</wiki>
        </info>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="bang">calculates and outputs standard deviation</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>standard deviation value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]                            [array astddev size=200 w=200 h=100]
|
[array.stddev astddev]
|
[F digits=16]



[gauss 0 0.4( [sin 25 1( [fill 0(
|             |          |
[array.fill       astddev]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
