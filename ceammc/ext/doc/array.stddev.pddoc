<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.stddev">
    <title>array.stddev</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">calculates standard deviation for array values</tr>
        <tr lang="ru">вычисляет стандартное отклонение для значений массива</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array deviation</keywords>
      <since>0.7.1</since>
      <also>
        <see>array.variance</see>
      </also>
    </meta>
    <info>
      <wiki name="Standard_deviation">Standard deviation</wiki>
      <par>
        <tr lang="en">The object computes the standard deviation of all samples in the specified
        array and outputs it as a single float. The standard deviation shows how far the sample
        values typically deviate from their mean value.</tr>
        <tr lang="ru">Объект вычисляет стандартное отклонение всех семплов указанного массива и
        выводит его одним числом с плавающей точкой. Стандартное отклонение показывает, насколько
        значения семплов в среднем отклоняются от их среднего значения.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array to analyze</tr>
        <tr lang="ru">имя массива для анализа</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">calculates the standard deviation and outputs it</tr>
          <tr lang="ru">вычисляет стандартное отклонение и выводит его</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">standard deviation value</tr>
          <tr lang="ru">значение стандартного отклонения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]                            [array astddev size=200 w=200 h=100]
|
[array.stddev astddev]
|
[F digits=16]



[gauss 0 0.4( [sin 25 1( [fill 0(
|             |          |
[array.fill       astddev]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
