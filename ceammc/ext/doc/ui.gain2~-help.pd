#X msg 130 643 @amp;
#X text 270 643 Get/Set gain as amplitude ratio. Type: float. Default
value: 0\.;
#X msg 130 685 @db;
#X text 270 685 Get/Set gain in dbfs scale. Type: float. Units: 'db'.
Default value: -60\.;
#X msg 130 727 @max;
#X text 270 727 Get/Set maximum gain value. Type: int. Units: 'db'.
Default value: 0\. Range: -12\...12\.;
#X msg 130 769 @min;
#X text 270 769 Get/Set minimal gain value. Type: int. Units: 'db'.
Default value: -60\. Range: -90\...-15\.;
#X msg 130 811 @mouse_events;
#X text 270 811 Get/Set mouse events output mode. If on outputs @mouse_down
\, @mouse_up and @mouse_drag events. Type: bool. Default value: 0\.;
#X msg 130 868 @output_value;
#X text 270 868 Get/Set flag to output @db property after each knob
move. Type: bool. Default value: 0\.;
#X msg 130 910 @receive;
#X text 270 910 Get/Set source of message receive. Type: symbol. Default
value: (null).;
#X msg 130 952 @relative;
#X text 270 952 Get/Set relative input mode. When set do not jump to
value on click. Type: bool. Default value: 1\.;
#X msg 130 994 @send;
#X text 270 994 Get/Set address for sending messages. Type: symbol.
Default value: (null).;
#X msg 130 1036 @show_range;
#X text 270 1036 Get/Set if show slider range. Type: bool. Default
value: 1\.;
#X msg 130 1066 @midi_channel;
#X text 270 1066 Get/Set MIDI channel binding. If set to 0 \, it binds
to all channels. The values in the range [1\..16] are mapped to the
channels of the first Pd MIDI device \, [17\..32] to the channels of
the second \, and so on. Type: int. Default value: 0\. Range: 0\...255\.;
#X msg 130 1169 @midi_control;
#X text 270 1169 Get/Set binded MIDI controller number. -1 means not
binded to any controller. Type: int. Default value: -1\. Range: -1\...127\.;
#X msg 130 1226 @midi_pickup;
#X text 270 1226 Get/Set pickup current value. If slider is binded
to value \, first time you should pass over this value to make binding.
It prevents from sudden value change on first control change. Type:
bool. Default value: 1\.;
#X msg 130 1313 @background_color;
#X text 270 1313 Get/Set element background color (list of red \, green
\, blue values in 0-1 range). Type: list. Default value: 0.93 0.93
0.93 1\.;
#X msg 130 1370 @border_color;
#X text 270 1370 Get/Set border color (list of red \, green \, blue
values in 0-1 range). Type: list. Default value: 0.6 0.6 0.6 1\.;
#X msg 130 1412 @knob_color;
#X text 270 1412 Get/Set knob color (list of red \, green \, blue values
in 0-1 range). Type: list. Default value: 0 0.75 1 1\.;
#X msg 130 1454 @fontname;
#X text 270 1454 Get/Set font name. Type: symbol. Default value: Helvetica.
Allowed values: Courier \, DejaVu \, Helvetica \, Monaco \, Times.;
#X msg 130 1496 @fontsize;
#X text 270 1496 Get/Set font size. Type: int. Default value: 11\.
Range: 4\...100\.;
#X msg 130 1538 @fontslant;
#X text 270 1538 Get/Set font slant. Type: symbol. Default value: roman.
Allowed values: roman \, italic.;
#X msg 130 1580 @fontweight;
#X text 270 1580 Get/Set font weight. Type: symbol. Default value:
normal. Allowed values: normal \, bold.;
#X msg 130 1622 @pinned;
#X text 270 1622 Get/Set pin mode. If set to 1 \, it places the element
at the furthest level on the canvas behind other elements. Type: bool.
Default value: 0\.;
#X msg 130 1679 @presetname;
#X text 270 1679 Get/Set preset name for using with [ui.preset] or
[preset.storage] objects. Type: symbol. Default value: (null).;
#X msg 130 1736 @size;
#X text 270 1736 Get/Set object size (width \, height pair). Type:
list. Default value: 15 120\.;
