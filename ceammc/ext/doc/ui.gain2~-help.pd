#X msg 110 677 @amp;
#X text 245 677 Get/Set gain as amplitude ratio. Type: float. Default
value: 0\.;
#X msg 110 719 @db;
#X text 245 719 Get/Set gain in dbfs scale. Type: float. Units: 'db'.
Default value: -60\.;
#X msg 110 761 @max;
#X text 245 761 Get/Set maximum gain value. Type: int. Units: 'db'.
Default value: 0\. Range: -12\...12\.;
#X msg 110 803 @min;
#X text 245 803 Get/Set minimal gain value. Type: int. Units: 'db'.
Default value: -60\. Range: -90\...-15\.;
#X msg 110 845 @mouse_events;
#X text 245 845 Get/Set mouse events output mode. If on outputs @mouse_down
\, @mouse_up and @mouse_drag events. Type: bool. Default value: 0\.;
#X msg 110 902 @output_value;
#X text 245 902 Get/Set flag to output @db property after each knob
move. Type: bool. Default value: 0\.;
#X msg 110 944 @receive;
#X text 245 944 Get/Set source of message receive. Type: symbol. Default
value: (null).;
#X msg 110 986 @relative;
#X text 245 986 Get/Set relative input mode. When set do not jump to
value on click. Type: bool. Default value: 1\.;
#X msg 110 1028 @send;
#X text 245 1028 Get/Set address for sending messages. Type: symbol.
Default value: (null).;
#X msg 110 1070 @show_range;
#X text 245 1070 Get/Set if show slider range. Type: bool. Default
value: 1\.;
#X msg 110 1100 @midi_channel;
#X text 245 1100 Get/Set MIDI channel binding. If set to 0 \, it binds
to all channels. The values in the range [1\..16] are mapped to the
channels of the first Pd MIDI device \, [17\..32] to the channels of
the second \, and so on. Type: int. Default value: 0\. Range: 0\...255\.;
#X msg 110 1203 @midi_control;
#X text 245 1203 Get/Set binded MIDI controller number. -1 means not
binded to any controller. Type: int. Default value: -1\. Range: -1\...127\.;
#X msg 110 1260 @midi_pickup;
#X text 245 1260 Get/Set pickup current value. If slider is binded
to value \, first time you should pass over this value to make binding.
It prevents from sudden value change on first control change. Type:
bool. Default value: 1\.;
#X msg 110 1347 @background_color;
#X text 245 1347 Get/Set element background color (list of red \, green
\, blue values in 0-1 range). Type: list. Default value: 0.93 0.93
0.93 1\.;
#X msg 110 1404 @border_color;
#X text 245 1404 Get/Set border color (list of red \, green \, blue
values in 0-1 range). Type: list. Default value: 0.6 0.6 0.6 1\.;
#X msg 110 1446 @knob_color;
#X text 245 1446 Get/Set knob color (list of red \, green \, blue values
in 0-1 range). Type: list. Default value: 0 0.75 1 1\.;
#X msg 110 1488 @fontname;
#X text 245 1488 Get/Set font name. Type: symbol. Default value: Helvetica.
Allowed values: Courier \, DejaVu \, Helvetica \, Monaco \, Times.;
#X msg 110 1530 @fontsize;
#X text 245 1530 Get/Set font size. Type: int. Default value: 11\.
Range: 4\...100\.;
#X msg 110 1572 @fontslant;
#X text 245 1572 Get/Set font slant. Type: symbol. Default value: roman.
Allowed values: roman \, italic.;
#X msg 110 1614 @fontweight;
#X text 245 1614 Get/Set font weight. Type: symbol. Default value:
normal. Allowed values: normal \, bold.;
#X msg 110 1656 @pinned;
#X text 245 1656 Get/Set pin mode. If set to 1 \, it places the element
at the furthest level on the canvas behind other elements. Type: bool.
Default value: 0\.;
#X msg 110 1713 @presetname;
#X text 245 1713 Get/Set preset name for using with [ui.preset] or
[preset.storage] objects. Type: symbol. Default value: (null).;
#X msg 110 1770 @size;
#X text 245 1770 Get/Set object size (width \, height pair). Type:
list. Default value: 15 120\.;
