<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="list.append">
        <title>list.append</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">append elements to the end of a list</tr>
                <tr lang="ru">добавляет элементы в конец списка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list append</keywords>
            <since>0.6</since>
            <also>
                <see>list append</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Works with data atoms</tr>
                <tr lang="ru" finished="false">Работа с атомами данных</tr>
            </par>
        </info>
        <arguments>
            <argument name="VALUE" type="list">
                <tr lang="en">appended value</tr>
                <tr lang="ru" finished="false">добавленная стоимость</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @value -->
            <property name="@value" type="list" default="">
                <tr lang="en">append value</tr>
                <tr lang="ru" finished="false">добавленная стоимость</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">treated as empty input list</tr>
                    <tr lang="ru" finished="false">рассматривается как пустой входной список</tr>
                </in>
                <in on="float">
                    <tr lang="en">input float</tr>
                    <tr lang="ru" finished="false">входной поплавок</tr>
                </in>
                <in on="symbol">
                    <tr lang="en">input symbol</tr>
                    <tr lang="ru" finished="false">входной символ</tr>
                </in>
                <in on="list">
                    <tr lang="en">input list</tr>
                    <tr lang="ru" finished="false">вводный список</tr>
                </in>
                <in on="data">
                    <tr lang="en">input data</tr>
                    <tr lang="ru" finished="false">входные данные</tr>
                </in>
                <in on="data:mlist">
                    <tr lang="en">append to end of input list</tr>
                    <tr lang="ru" finished="false">Добавить в конец списка ввода</tr>
                </in>
            </inlet>
            <inlet>
                <in on="list">
                    <tr lang="en">set appended list</tr>
                    <tr lang="ru" finished="false">Добавленный список</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output concatenated list</tr>
                    <tr lang="ru" finished="false">выходной сцепленный список</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B] [F]  [B]    [1 2 3 4 5( [B]
|   |    |             |    |
|   |    [str test1]   |    [str ANOTHER STRING]
|   |    |             |    |
|   |    |             |    |.
[list.append "@prop" ABC     ]
|
[ui.display @display_type 1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
