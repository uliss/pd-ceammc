#X msg 130 706 @div;
#X text 270 706 Get/Set beat subdivision. Type: int. Default value:
1\. Range: 1\...64\.;
#X msg 130 748 @dur;
#X text 270 748 Get/Set whole sequence duration. (Recalculates @t property
accordingly). Type: float. Units: 'ms'. Default value: 0\. Min value:
0\.;
#X msg 130 805 @inf;
#X text 270 805 Alias to @r -1 \, repeats infinitely.;
#X msg 130 835 @length;
#X text 270 835 Get/Set event length. In case of float or float wuth
'ms' suffix - event length is fixed for any event duration. In case
of V% - @length expected to be in 0\..100 range and event length is
percent of duration. In case of negative @length event duration is
calculated as duration+@length \, but not less then 1\. Type: float.
Default value: 75\.;
#X msg 130 953 @mode;
#X text 270 953 Get/Set sequencer mode. 'inc': from first to last \,
'dec': from last to first \, 'tri': from first to last \, then back.
Type: symbol. Default value: inc. Allowed values: inc \, dec \, tri.;
#X msg 130 1040 @once;
#X text 270 1040 Alias to @r 1 \, play once.;
#X msg 130 1070 @p;
#X text 270 1070 Get/Set sequencer pattern in beat duration units.
Type: list.;
#X msg 130 1100 @r;
#X text 270 1100 Get/Set number of whole sequence repeats. If -1: repeat
infinitely. Type: int. Default value: 1\. Min value: -1\.;
#X msg 130 1142 @t;
#X text 270 1142 Get/Set time between beats. Unit values like 100ms
\, 240bpm or 60|4bpm also can be used. Type: float. Units: 'ms'. Default
value: 100\. Range: 1\...20000\.;
#X msg 130 1199 @upbeat;
#X text 270 1199 Get/Set wait specified number of beats before sequence
start. Type: float. Default value: 0\. Min value: 0\.;
#X msg 130 1241 @i?;
#X text 270 1241 (readonly) Get current sequence iteration. Type: int.
Default value: 0\.;
#X msg 130 1283 @ri?;
#X text 270 1283 (readonly) Get current repeat iteration. Type: int.
Default value: 0\.;
