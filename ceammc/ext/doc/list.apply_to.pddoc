<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="list.apply_to">
        <title>list.apply_to</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">modifies specified list elements via a side-chain</tr>
                <tr lang="ru">обрабатывает указанные элементы списка через боковую церь
                обработки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list functional apply</keywords>
            <since>0.1</since>
            <also>
                <see>list.each</see>
            </also>
        </meta>
        <arguments>
            <argument name="INDEXES" type="list">
                <tr lang="en">apply index(es) (starting from 0). Negative value means position from
                end of the list. For example: '-1' means last element.</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @indexes -->
            <property name="@indexes" type="list" default="">
                <tr lang="en">applied index(es)</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">Input list. If no element found by specified index - list passed
                without changes</xinfo>
            </inlet>
            <inlet>
                <xinfo on="list">set apply index(es)</xinfo>
            </inlet>
            <inlet>
                <xinfo>return value from applied object</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>new modified list</outlet>
            <outlet>element at given index. Should be passed to applied object</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 60 61 120(
|
[list.apply_to 1 -2] X [mtof]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
