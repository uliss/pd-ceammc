<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="conv.lin2exp">
        <title>conv.lin2exp</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">maps linear range to exponential range</tr>
                <tr lang="ru">отображает линейный диапазон в экспоненциальный</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>conv</category>
            <keywords>convert exponential</keywords>
            <also>
                <see>conv.lin2lin</see>
                <see>conv.lin2curve</see>
            </also>
            <since>0.1</since>
            <aliases>
                <alias>ceammc/lin-&gt;exp</alias>
                <alias>lin-&gt;exp</alias>
            </aliases>
        </meta>
        <info>
            <par>The output range must not include zero. If the input exceeds the input range, by
            default clip is applied.</par>
        </info>
        <arguments>
            <argument name="IN_FROM" type="float">
                <tr lang="en">begin of input range</tr>
                <tr lang="ru">начало входного диапазона</tr>
            </argument>
            <argument name="IN_TO" type="float">
                <tr lang="en">end of input range</tr>
                <tr lang="ru">конец входного диапазона</tr>
            </argument>
            <argument name="OUT_FROM" type="float">
                <tr lang="en">begin of output range</tr>
                <tr lang="ru">начало выходного диапазона</tr>
            </argument>
            <argument name="OUT_TO" type="float">
                <tr lang="en">end of output range</tr>
                <tr lang="ru">конец выходного диапазона</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @clip -->
            <property name="@clip" type="symbol" default="minmax" enum="noclip min max minmax">
                <tr lang="en">noclip (don't clip) max (clip ceiling) min (clip floor) minmax (clip
                both).</tr>
            </property>
            <!-- @in_from -->
            <property name="@in_from" type="float" default="0">
                <tr lang="en">begin of input range</tr>
            </property>
            <!-- @in_to -->
            <property name="@in_to" type="float" default="127">
                <tr lang="en">end of input range</tr>
            </property>
            <!-- @max -->
            <property name="@max" type="alias">
                <tr lang="en">alias to @clip max</tr>
            </property>
            <!-- @min -->
            <property name="@min" type="alias">
                <tr lang="en">alias to @clip min</tr>
            </property>
            <!-- @minmax -->
            <property name="@minmax" type="alias">
                <tr lang="en">alias to @clip minmax</tr>
            </property>
            <!-- @noclip -->
            <property name="@noclip" type="alias">
                <tr lang="en">alias to @clip noclip</tr>
            </property>
            <!-- @out_from -->
            <property name="@out_from" type="float" default="0.01">
                <tr lang="en">begin of output range</tr>
            </property>
            <!-- @out_to -->
            <property name="@out_to" type="float" default="1">
                <tr lang="en">end of output range</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">input value</xinfo>
                <xinfo on="list">input list</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>converted value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[0 1001(                            [array l2e size=1000 yr=0..1]
|
[list.seq]
|
[list.separate]
|
[t f f {w=12}             ]
|                         |
[lin->exp 0 1001 0.01 1]  |
|                         |.
[tabwrite               l2e]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
