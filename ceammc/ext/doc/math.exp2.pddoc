<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.exp2">
        <title>math.exp2</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">base-2 exponential function</tr>
                <tr lang="ru">экспоненциальная функция на основе 2</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math exp2</keywords>
            <also>
                <see>math.log</see>
                <see>math.exp</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The exp2() function computes 2**x, the base-2 exponential of x.</tr>
                <!-- old: Функция exp2() вычисляет 2**x, основание-2
                экспоненциально x. -->
                <tr lang="ru" finished="false">Функция exp2() вычисляет 2**x, основание-2
                экспоненциально x.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
                <tr lang="ru" finished="false">Особые ценности:</tr>
            </par>
            <par>
                <tr lang="en">exp(+-0) return 1.</tr>
                <tr lang="ru" finished="false">exp(+-0) Return 1.</tr>
            </par>
            <par>
                <tr lang="en">exp(-infinity) return +0.</tr>
                <tr lang="ru" finished="false">exp(-infinity) возврат +0.</tr>
            </par>
            <par>
                <tr lang="en">exp(+infinity) return +infinity.</tr>
                <tr lang="ru" finished="false">exp(+infinity) Возвращение +infinity.</tr>
            </par>
            <par>
                <tr lang="en">For all these functions, a range error occurs if the magnitude of x
                is too large.</tr>
                <!-- old: Для всех этих функций возникает ошибка диапазона,
                если величина x слишком велика. -->
                <tr lang="ru" finished="false">Для всех этих функций возникает ошибка диапазона,
                если величина x слишком велика.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">input value</tr>
                    <tr lang="ru" finished="false">входная стоимость</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">apply to all numeric values</tr>
                    <tr lang="ru" finished="false">применяется ко всем числовым значениям</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result value</tr>
                    <tr lang="ru" finished="false">значение результата</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[math.exp2]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
