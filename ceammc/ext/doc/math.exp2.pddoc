<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="math.exp2">
        <title>math.exp2</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">base-2 exponential function</tr>
                <tr lang="ru">экспоненциальная функция на основе 2</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math exp2</keywords>
            <also>
                <see>math.log</see>
                <see>math.exp</see>
            </also>
            <since>0.1</since>
        </meta>
        <info>
            <par>
                <tr lang="en">The exp2() function computes 2**x, the base-2 exponential of x.</tr>
            </par>
            <par>
                <tr lang="en">Special values:</tr>
            </par>
            <par>
                <tr lang="en">exp(+-0) return 1.</tr>
            </par>
            <par>
                <tr lang="en">exp(-infinity) return +0.</tr>
            </par>
            <par>
                <tr lang="en">exp(+infinity) return +infinity.</tr>
            </par>
            <par>
                <tr lang="en">For all these functions, a range error occurs if the magnitude of x
                is too large.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="float">input value</xinfo>
                <xinfo on="list">apply to all numeric values</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>result value</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[math.exp2]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
