<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="prop.declare">
    <title>prop.declare</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">declare the named property for a subpatch or an abstraction</tr>
        <tr lang="ru">объявляет именованное свойство для субпатча или абстракции</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>property</category>
      <keywords>property declare</keywords>
      <since>0.7</since>
      <also>
        <see>prop</see>
        <see>patch.props</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object declares a named property that belongs to the current subpatch or
        abstraction and can be accessed by name from other objects</tr>
        <tr lang="ru">объект объявляет именованное свойство, принадлежащее текущему субпатчу или
        абстракции и доступное по имени из других объектов</tr>
      </par>
      <par>
        <tr lang="en">the property name is set by the NAME argument, the type and constraints are
        set by the @type, @min, @max, @enum and @default properties</tr>
        <tr lang="ru">имя свойства задаётся аргументом NAME, тип и ограничения — свойствами @type,
        @min, @max, @enum и @default</tr>
      </par>
      <par>
        <tr lang="en">declared properties can be read and written with the [prop] and [prop.set]
        objects, or with [patch.props]</tr>
        <tr lang="ru">объявленные свойства можно читать и записывать объектами [prop] и [prop.set]
        или через [patch.props]</tr>
      </par>
    </info>
    <arguments>
      <argument name="NAME" type="symbol">
        <tr lang="en">property name without @ (should be unique for the current canvas)</tr>
        <tr lang="ru">имя свойства без @ (должно быть уникальным для текущего холста)</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @b -->
      <property name="@b" type="alias">
        <tr lang="en">alias to @type bool</tr>
        <tr lang="ru">псевдоним для @type bool</tr>
      </property>
      <!-- @default -->
      <property name="@default" type="list" access="initonly" default="">
        <tr lang="en">default property value</tr>
        <tr lang="ru">значение свойства по умолчанию</tr>
      </property>
      <!-- @enum -->
      <property name="@enum" type="list" access="initonly" default="">
        <tr lang="en">allowed values (without the default value) (for symbol properties only)</tr>
        <tr lang="ru">допустимые значения (без значения по умолчанию) (только для символьных
        свойств)</tr>
      </property>
      <!-- @f -->
      <property name="@f" type="alias">
        <tr lang="en">alias to @type float</tr>
        <tr lang="ru">псевдоним для @type float</tr>
      </property>
      <!-- @i -->
      <property name="@i" type="alias">
        <tr lang="en">alias to @type int</tr>
        <tr lang="ru">псевдоним для @type int</tr>
      </property>
      <!-- @l -->
      <property name="@l" type="alias">
        <tr lang="en">alias to @type list</tr>
        <tr lang="ru">псевдоним для @type list</tr>
      </property>
      <!-- @max -->
      <property name="@max" type="float" default="+inf" access="initonly">
        <tr lang="en">maximum value (for float and int properties only)</tr>
        <tr lang="ru">максимальное значение (только для свойств float и int)</tr>
      </property>
      <!-- @min -->
      <property name="@min" type="float" default="-inf" access="initonly">
        <tr lang="en">minimal value (for float and int properties only)</tr>
        <tr lang="ru">минимальное значение (только для свойств float и int)</tr>
      </property>
      <!-- @s -->
      <property name="@s" type="alias">
        <tr lang="en">alias to @type symbol</tr>
        <tr lang="ru">псевдоним для @type symbol</tr>
      </property>
      <!-- @type -->
      <property name="@type" type="symbol" enum="float int bool enum symbol list" default="float">
        <tr lang="en">property type</tr>
        <tr lang="ru">тип свойства</tr>
      </property>
    </properties>
    <example>
      <pdascii>
<![CDATA[
[prop.declare freq @min 20 @max 20000 @default 1000]

[prop.declare gain @min -60 @max 12 @default 3]

[prop @freq] [prop @gain]
|            |
[F]          [F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
