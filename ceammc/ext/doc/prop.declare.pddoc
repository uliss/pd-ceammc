<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.10">
    <object name="prop.declare">
        <title>prop.declare</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">declare the named property for a subpatch or an abstraction</tr>
                <tr lang="ru">объявляет именованное свойство для субпатча или абстракции</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>property</category>
            <keywords>property declare</keywords>
            <since>0.7</since>
            <also>
                <see>prop</see>
                <see>patch.props</see>
            </also>
        </meta>
        <arguments>
            <argument name="NAME" type="symbol">
                <tr lang="en">property name without @ (should be unique for current canvas)</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @b -->
            <property name="@b" type="alias">alias to @type bool</property>
            <!-- @default -->
            <property name="@default" type="list" access="initonly" default="">default property
            value</property>
            <!-- @enum -->
            <property name="@enum" type="list" access="initonly" default="">allowed values (without
            default value) (for symbol properties only)</property>
            <!-- @f -->
            <property name="@f" type="alias">alias to @type float</property>
            <!-- @i -->
            <property name="@i" type="alias">alias to @type int</property>
            <!-- @l -->
            <property name="@l" type="alias">alias to @type list</property>
            <!-- @max -->
            <property name="@max" type="float" default="+inf" access="initonly">maximum value (for
            float and int properties only)</property>
            <!-- @min -->
            <property name="@min" type="float" default="-inf" access="initonly">minimal value (for
            float and int properties only)</property>
            <!-- @s -->
            <property name="@s" type="alias">alias to @type symbol</property>
            <!-- @type -->
            <property name="@type" type="symbol" enum="float int bool enum symbol list"
            default="float">property type</property>
        </properties>
        <example>
            <pdascii>
<![CDATA[
[prop.declare freq @min 20 @max 20000 @default 1000]

[prop.declare gain @min -60 @max 12 @default 3]

[prop @freq] [prop @gain]
|            |
[F]          [F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
