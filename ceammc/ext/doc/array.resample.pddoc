<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.resample">
    <title>array.resample</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">resampling the array</tr>
        <tr lang="ru">пересемплирование массива</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array resample</keywords>
      <since>0.9</since>
      <aliases>
        <alias>array.r</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object resamples the source array and writes the result into the
        destination array. The resampling factor is set with the @ratio property (source size
        divided by destination size) and the quality of the resampling is controlled with the
        @quality property. When a bang is received, the resampling is started, and the number of
        samples in the resulting array is sent to the outlet.</tr>
        <tr lang="ru">Объект пересемплирует исходный массив и записывает результат в массив
        назначения. Коэффициент пересемплирования задаётся свойством @ratio (размер исходного
        массива, делённый на размер массива назначения), а качество пересемплирования — свойством
        @quality. По bang запускается пересемплирование, а в выход отправляется число семплов в
        результирующем массиве.</tr>
      </par>
    </info>
    <arguments>
      <argument name="SRC" type="symbol">
        <tr lang="en">name of the source array</tr>
        <tr lang="ru">имя исходного массива</tr>
      </argument>
      <argument name="DEST" type="symbol">
        <tr lang="en">name of the destination array</tr>
        <tr lang="ru">имя массива назначения</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @best -->
      <property name="@best" type="alias">
        <tr lang="en">alias to @quality best</tr>
        <tr lang="ru">сокращение для @quality best</tr>
      </property>
      <!-- @dest -->
      <property name="@dest" type="symbol" default="">
        <tr lang="en">name of the destination array</tr>
        <tr lang="ru">имя массива назначения</tr>
      </property>
      <!-- @fast -->
      <property name="@fast" type="alias">
        <tr lang="en">alias to @quality fast</tr>
        <tr lang="ru">сокращение для @quality fast</tr>
      </property>
      <!-- @high -->
      <property name="@high" type="alias">
        <tr lang="en">alias to @quality high</tr>
        <tr lang="ru">сокращение для @quality high</tr>
      </property>
      <!-- @low -->
      <property name="@low" type="alias">
        <tr lang="en">alias to @quality low</tr>
        <tr lang="ru">сокращение для @quality low</tr>
      </property>
      <!-- @medium -->
      <property name="@medium" type="alias">
        <tr lang="en">alias to @quality medium</tr>
        <tr lang="ru">сокращение для @quality medium</tr>
      </property>
      <!-- @quality -->
      <property name="@quality" type="symbol" enum="high fast low medium best" default="high">
        <tr lang="en">resampling quality</tr>
        <tr lang="ru">качество пересемплирования</tr>
      </property>
      <!-- @ratio -->
      <property name="@ratio" type="float" minvalue="0" default="0">
        <tr lang="en">resampling ratio (src/dest)</tr>
        <tr lang="ru">коэффициент пересемплирования (src/dest)</tr>
      </property>
      <!-- @src -->
      <property name="@src" type="symbol" default="">
        <tr lang="en">name of the source array</tr>
        <tr lang="ru">имя исходного массива</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">starts the resampling</tr>
          <tr lang="ru">запускает пересемплирование</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">number of samples after resampling</tr>
          <tr lang="ru">число семплов после пересемплирования</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[msg.onload]            [array ARS1 #a]     [array ARS2 #b]
|
[-1 0.2 0.7 0.1 -0.5 0.6 0.7(
|
[array set ARS1]

[bang(  [ui.hsl @min 1 @max 20]
|       |
|       [@ratio $1, bang(
|       |
[array.resample ARS1 ARS2 @ratio 4]
|
[F]

#a w=160 h=100 style=point size=7
#b w=160 h=100 style=point
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
