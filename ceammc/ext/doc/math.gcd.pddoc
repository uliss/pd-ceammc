<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="math.gcd">
    <title>math.gcd</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">calculate the greatest common divisor</tr>
        <tr lang="ru">вычисляет наибольший общий делитель</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>math</category>
      <keywords>math gcd</keywords>
      <also>
        <see>math.lcm</see>
      </also>
      <since>0.3</since>
    </meta>
    <arguments>
      <argument name="ARG2" type="int">
        <tr lang="en">second argument</tr>
        <tr lang="ru" finished="false">Второй аргумент</tr>
      </argument>
    </arguments>
    <inlets>
      <inlet>
        <in on="int">
          <tr lang="en">sets first argument and outputs calculated GCD value</tr>
          <!-- old: устанавливает первый аргумент и вычисляет
                    значение GCD -->
          <tr lang="ru" finished="false">устанавливает первый аргумент и вычисляет значение
          GCD</tr>
        </in>
        <in on="list">
          <tr lang="en">sets first argument and second arguments, then output calculated GCD
          value</tr>
          <!-- old: устанавливает первый аргумент и второй аргумент,
                    а затем вывод рассчитывает значение GCD -->
          <tr lang="ru" finished="false">устанавливает первый аргумент и второй аргумент, а затем
          вывод рассчитывает значение GCD</tr>
        </in>
      </inlet>
      <inlet>
        <in on="int">
          <tr lang="en">sets second value</tr>
          <tr lang="ru" finished="false">Устанавливает второе значение</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">GCD value</tr>
          <tr lang="ru" finished="false">Значение ГКД</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]   [14 28(
|     |
|     |
|     |
[math.gcd 12]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
