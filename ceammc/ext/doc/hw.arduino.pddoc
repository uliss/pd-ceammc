<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.arduino">
    <title>hw.arduino</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">Arduino device</tr>
        <tr lang="ru">устройство Arduino</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>arduino</keywords>
      <since>0.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Arduino serial port that supports reconnection and hotplug. If no properties
        are given, tries to connect to the first available device that is not already opened. If
        the @reconnect flag is set, waits for the device hotplug and reconnects to it.</tr>
        <tr lang="ru">Последовательный порт Arduino с поддержкой переподключения и «горячего
        подключения». Если свойства не заданы, объект пытается подключиться к первому доступному и
        ещё не открытому устройству. Если установлен флаг @reconnect, объект ждёт «горячего
        подключения» устройства и переподключается к нему.</tr>
      </par>
    </info>
    <arguments>
      <argument name="PORT" type="symbol">
        <tr lang="en">serial port name, e.g. COM3 on Windows, /dev/ttyACM0 on Linux and
        /dev/cu.usbmodem411 on macOS</tr>
        <tr lang="ru">имя последовательного порта, например COM3 в Windows, /dev/ttyACM0 в Linux и
        /dev/cu.usbmodem411 в macOS</tr>
      </argument>
      <argument name="RATE" type="int"
      enum="110 115200 1200 128000 14400 19200 2400 256000 300 38400 4800 56000 57600 600 9600">
        <tr lang="en">serial baud rate</tr>
        <tr lang="ru">скорость передачи данных (baud rate)</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @connected -->
      <property name="@connected" type="bool" access="readonly" default="0">
        <tr lang="en">state of connection to the device</tr>
        <tr lang="ru">состояние соединения с устройством</tr>
      </property>
      <!-- @devices -->
      <property name="@devices" type="list" default="" access="readonly">
        <tr lang="en">list of found Arduino devices</tr>
        <tr lang="ru">список найденных устройств Arduino</tr>
      </property>
      <!-- @on_connect -->
      <property name="@on_connect" type="symbol" default="">
        <tr lang="en">function called after each connection</tr>
        <tr lang="ru">функция, вызываемая после каждого подключения</tr>
      </property>
      <!-- @port -->
      <property name="@port" type="symbol" access="initonly" default="">
        <tr lang="en">name of the Arduino serial port or device, e.g. COM3 on Windows, /dev/ttyACM0
        on Linux and /dev/cu.usbmodem411 on macOS. If this property is specified, the object
        attempts to connect only to that device</tr>
        <tr lang="ru">имя последовательного порта или устройства Arduino, например COM3 в Windows,
        /dev/ttyACM0 в Linux и /dev/cu.usbmodem411 в macOS. Если свойство указано, объект пытается
        подключиться только к этому устройству</tr>
      </property>
      <!-- @product_id -->
      <property name="@product_id" type="int" default="0">
        <tr lang="en">USB device product ID. If the vendor and product identifiers are specified,
        the object attempts to connect only to devices with those characteristics. Note: to specify
        an identifier in hexadecimal format, remember to add the 0x prefix.</tr>
        <tr lang="ru">идентификатор продукта (Product ID) USB-устройства. Если указаны
        идентификаторы производителя и продукта, объект пытается подключиться только к устройствам
        с такими характеристиками. Примечание: чтобы указать идентификатор в шестнадцатеричном
        формате, не забудьте добавить префикс 0x.</tr>
      </property>
      <!-- @rate -->
      <property name="@rate" type="int" default="57600"
      enum="57600 110 300 600 1200 2400 4800 9600 14400 19200 38400 56000 115200 128000 256000">
        <tr lang="en">serial baud rate. Standard values supported by most serial ports: 110, 300,
        600, 1200, 2400, 4800, 9600, 14400, 19200, 28800, 38400, 56000, 57600, 115200</tr>
        <tr lang="ru">скорость передачи данных (baud rate). Стандартные значения, поддерживаемые
        большинством последовательных портов: 110, 300, 600, 1200, 2400, 4800, 9600, 14400, 19200,
        28800, 38400, 56000, 57600, 115200</tr>
      </property>
      <!-- @reconnect -->
      <property name="@reconnect" type="flag" default="0" access="initonly">
        <tr lang="en">reconnect to the device after the loss of connection</tr>
        <tr lang="ru">переподключаться к устройству после потери соединения</tr>
      </property>
      <!-- @serial -->
      <property name="@serial" type="symbol" default="">
        <tr lang="en">USB device serial number. If specified, the object tries to connect only to
        devices with this serial number</tr>
        <tr lang="ru">серийный номер USB-устройства. Если указан, объект пытается подключиться к
        устройствам только с таким серийным номером</tr>
      </property>
      <!-- @vendor_id -->
      <property name="@vendor_id" type="int" default="0">
        <tr lang="en">USB device vendor ID. If specified, the object tries to connect only to
        devices from this vendor. Note: to specify an identifier in hexadecimal format, remember to
        add the 0x prefix.</tr>
        <tr lang="ru">идентификатор производителя (Vendor ID) USB-устройства. Если указан, объект
        пытается подключиться к устройствам только от этого производителя. Примечание: чтобы
        указать идентификатор в шестнадцатеричном формате, не забудьте добавить префикс 0x.</tr>
      </property>
    </properties>
    <methods>
      <!-- connect -->
      <method name="connect">
        <info>
          <tr lang="en">manually connects to the device</tr>
          <tr lang="ru">вручную подключается к устройству</tr>
        </info>
      </method>
      <!-- disconnect -->
      <method name="disconnect">
        <info>
          <tr lang="en">disconnects from the device</tr>
          <tr lang="ru">отключается от устройства</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">sends a float value in the byte range [0, 255] to the Arduino device</tr>
          <tr lang="ru">отправляет числовое значение в байтовом диапазоне [0, 255] в устройство
          Arduino</tr>
        </in>
        <in on="list">
          <tr lang="en">sends a list of floats in the byte range [0, 255] to the Arduino
          device</tr>
          <tr lang="ru">отправляет список чисел в байтовом диапазоне [0, 255] в устройство
          Arduino</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">outputs the received byte from the Arduino</tr>
          <tr lang="ru">выводит полученный из Arduino байт</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[249(/ /*firmata version request*/
|
| [1 2 3 4 5( /*serial echo*/
| |
| | [@devices?(
| | |
| | |
[hw.arduino @reconnect @on_connect ardconn]
|
[print arduino]

[function ardconn]X[b]
|
[flow.count]
|
[F]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
