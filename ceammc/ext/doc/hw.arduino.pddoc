<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="hw.arduino">
        <title>hw.arduino</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Arduino device</tr>
                <tr lang="ru">устройство Arduino</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>arduino</keywords>
            <since>0.5</since>
        </meta>
        <info>
            <par>Arduino serial port that supports reconnect and hotplug. If no properties are
            given tries to connect to the first available and not opened device. If @reconnect flag
            is given, waits for device hotplug and reconnects to it.</par>
        </info>
        <arguments>
            <argument name="PORT" type="symbol">
                <tr lang="en">serial port name, eg.: COM3 on Windows, /dev/ttyACM0 on Linux and
                /dev/cu.usbmodem411 on MacOSX</tr>
                <tr lang="ru" finished="false">последовательное название порта, например: COM3 на
                Windows, /dev/ttyACM0 на Linux и /dev/cu.usbmodem411 на MacOSX</tr>
            </argument>
            <argument name="RATE" type="int"
            enum="110 115200 1200 128000 14400 19200 2400 256000 300 38400 4800 56000 57600 600 9600">

                <tr lang="en">serial baud rate</tr>
                <tr lang="ru" finished="false">серийный бауд</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @connected -->
            <property name="@connected" type="bool" access="readonly" default="0">
                <tr lang="en">state of connection to device</tr>
                <tr lang="ru" finished="false">Состояние соединения с устройством</tr>
            </property>
            <!-- @devices -->
            <property name="@devices" type="list" default="" access="readonly">
                <tr lang="en">list of found Arduino devices</tr>
                <tr lang="ru" finished="false">Список найденных устройств Arduino</tr>
            </property>
            <!-- @on_connect -->
            <property name="@on_connect" type="symbol" default="">
                <tr lang="en">function called every time on connect</tr>
                <tr lang="ru" finished="false">Функция вызывается каждый раз при подключении</tr>
            </property>
            <!-- @port -->
            <property name="@port" type="symbol" access="initonly" default="">
                <tr lang="en">name of arduino serial port, eg.: COM3 on Windows, /dev/ttyACM0 on
                Linux and /dev/cu.usbmodem411 on MacOSX. If specified on creation tries to connect
                to this device only</tr>
                <tr lang="ru" finished="false">COM3 на Windows, /dev/ttyACM0 на Linux и
                /dev/cu.usbmodem411 на MacOSX. Если указано на творении, пытается подключиться к
                этому устройству только</tr>
            </property>
            <!-- @product_id -->
            <property name="@product_id" type="int" default="0">
                <tr lang="en">USB device product id. If vendor and product ids are specified at
                creation, tries to connect to devices only with such properties. Note: product id
                is specified in decimal mode, not in hex</tr>
                <tr lang="ru" finished="false">Устройство USB Product ID. Если при создании указаны
                идентификаторы производителя и продукта, то к устройствам пытаются подключиться
                только с такими свойствами. Примечание: идентификатор продукта указывается в
                десятичном режиме, а не в шестнадцатеричном</tr>
            </property>
            <!-- @rate -->
            <property name="@rate" type="int" default="57600"
            enum="57600 110 300 600 1200 2400 4800 9600 14400 19200 38400 56000 115200 128000 256000">

                <tr lang="en">serial baud rate. Standard value supported by most serial ports: 110,
                300, 600, 1200, 2400, 4800, 9600, 14400, 19200, 28800, 38400, 56000, 57600,
                115200</tr>
                <tr lang="ru" finished="false">Серийная ставка бод. Стандартное значение,
                поддерживаемое большинством последовательных портов: 110, 300, 600, 1200, 2400,
                4800, 9600, 14400, 19200, 28800, 38400, 56000, 57600, 115200</tr>
            </property>
            <!-- @reconnect -->
            <property name="@reconnect" type="flag" default="0" access="initonly">
                <tr lang="en">enables hot-pluggin</tr>
                <tr lang="ru" finished="false">Позволяет горячий плагин</tr>
            </property>
            <!-- @serial -->
            <property name="@serial" type="symbol" default="">
                <tr lang="en">USB device serial number. If specified at creation, tries to connect
                to devices only with such serial number</tr>
                <tr lang="ru" finished="false">Серийный номер устройства USB. Если указано при
                создании, пытается подключиться к устройствам только с таким серийным номером.</tr>
            </property>
            <!-- @vendor_id -->
            <property name="@vendor_id" type="int" default="0">
                <tr lang="en">USB device vendor id. If specified at creation, tries to connect to
                devices only with such vendor. Note: vendor id is specified in decimal mode, not in
                hex</tr>
                <tr lang="ru" finished="false">Идентификатор поставщика USB-устройств. Если указано
                при создании, пытается подключиться к устройствам только с таким поставщиком.
                Примечание: идентификатор поставщика указывается в десятичном режиме, а не в
                шестнадцатеричном</tr>
            </property>
        </properties>
        <methods>
            <!-- connect -->
            <method name="connect">manually connect to device</method>
            <!-- disconnect -->
            <method name="disconnect">disconnect from device</method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="float">sends float value in byte range [0-255] to arduino device</xinfo>
                <xinfo on="list">sends list of floats in byte range [0-255] to arduino
                device</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>outputs received byte from arduino</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[249(/ /*firmata version request*/
|
| [1 2 3 4 5( /*serial echo*/
| |
| | [@devices?(
| | |
| | |
[hw.arduino @reconnect @on_connect ardconn]
|
[print arduino]

[function ardconn]X[b]
|
[flow.count]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
