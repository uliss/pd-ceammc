<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.mean">
        <title>list.mean</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">calculates the average value in a list</tr>
                <tr lang="ru">вычисляет среднее значение в списке</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list mean</keywords>
            <since>0.1</since>
            <also>
                <see>list.normalize</see>
            </also>
            <aliases>
                <alias>list.average</alias>
            </aliases>
        </meta>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">input list of floats. Non float values are just ignored. No
                    output if no floats in list</tr>
                    <!-- old: Список входных поплавков. Неподвижные ценности
                    просто игнорируются. Нет выхода, если нет поплавков в списке -->
                    <tr lang="ru" finished="false">Список входных поплавков. Неподвижные ценности
                    просто игнорируются. Нет выхода, если нет поплавков в списке</tr>
                </in>
                <in on="data:mlist">
                    <tr lang="en">same as list</tr>
                    <tr lang="ru" finished="false">Тот же список</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">average (float)</tr>
                    <tr lang="ru" finished="false">Средний (плавающий)</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 4 5( [1 2 a b c(
|           |
|           |
[list.mean  ]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
