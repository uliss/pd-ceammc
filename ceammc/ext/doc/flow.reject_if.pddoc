<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flow.reject_if">
        <title>flow.reject_if</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">reject the message, accepted by the predicate side-chain</tr>
                <tr lang="ru">не пропускает значение, принятое предикатом боковой цепи
                обработки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flow</category>
            <keywords>reject functional</keywords>
            <since>0.3</since>
            <aliases>
                <alias>ceammc/reject_if</alias>
                <alias>reject_if</alias>
            </aliases>
            <also>
                <see>flow.pass_if</see>
                <see>flow.reject</see>
                <see>is_even</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">conditional value reject according to *predicate* object. *predicate*
                should accept value and ouput 0 or 1, for value passing.</tr>
            </par>
            <par>
                <tr lang="en">[&lt;] [is_even] [is_list] - examples of predicates.</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <xinfo>
                    <tr lang="en">input value</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="int">
                    <tr lang="en">value from predicate (0 or 1). If *1* reject value, if *0* -
                    pass.</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>passed values</outlet>
            <outlet>output value to predicate</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]
|
[flow.reject_if] X [< 10]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
