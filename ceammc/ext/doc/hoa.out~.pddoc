<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="hoa.out~">
        <title>hoa.out~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
                <author>Pierre Guillot</author>
                <author>Eliott Paris</author>
                <author>Thomas Le Meur</author>
            </authors>
            <description>
                <tr lang="en">signal inlet for a patcher loaded by hoa.process~</tr>
                <tr lang="ru">сигнальный выход для патча, загружаемого объектом [hoa.process~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>spat</category>
            <keywords>hoa outlet</keywords>
            <since>0.8</since>
            <also>
                <see>hoa.out</see>
                <see>hoa.in</see>
                <see>hoa.in~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">defines a signal outlet for a patcher loaded by a hoa.process~
                object</tr>
                <tr lang="ru" finished="false">определяет выход сигнала для пластыря, загруженного
                объектом hoa.process~</tr>
            </par>
        </info>
        <arguments>
            <argument name="EXTRA" type="int" minvalue="0">
                <tr lang="en">shortcut for @extra property</tr>
                <tr lang="ru" finished="false">Скриншоты для @extra Property</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @extra -->
            <property name="@extra" type="int" minvalue="0" default="0">
                <tr lang="en">extra inlet. Extra inlet are added to the "normal" instance inlet and
                can be used to send signal to all instances</tr>
                <tr lang="ru" finished="false">дополнительный вход. Дополнительный вход добавляется
                к входу «нормального» экземпляра и может использоваться для отправки сигнала во все
                экземпляры.</tr>
            </property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">output signal in the corresponding hoa.process~ object's signal
                    outlet</tr>
                    <tr lang="ru" finished="false">выходной сигнал в соответствующем hoa.process~
                    выходной сигнал объекта</tr>
                </xinfo>
            </inlet>
        </inlets>
        <example>
            <pdascii>
<![CDATA[
[open 0 #a( [open 1 #b(

[sig~ 0.5]                       [sig~ 1]
|                                |.
[hoa.process~ 2 hoa/hoa_out_example3 planewaves #z]
|               ^|               ^^|
[ui.n~]         [ui.n~]          [ui.n~]

[X a->z]
[X b->z]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
