<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="hw.rpi.adc.ads1115">
        <title>hw.rpi.adc.ads1115</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">driver for 16-bit ADC on ads1115 chip for Raspberry Pi</tr>
                <tr lang="ru">драйвер для 16-битного АЦП на чипе ads1115 для Raspberry Pi</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>display rpi ads1115 adc</keywords>
            <since>0.9.8</since>
        </meta>
        <info>
            <par>Full-scale range settings:</par>
            <par>- @fsr 6144mv, range +-6.144V, 1-bit: 0.1875mV</par>
            <par>- @fsr 4096mv, range +-4.096V, 1-bit: 0.125mV</par>
            <par>- @fsr 2048mv, range +-2.048V, 1-bit: 0.0625mV</par>
            <par>- @fsr 1024mv, range +-1.024V, 1-bit: 0.03125mV</par>
            <par>- @fsr 512mv, range +-0.512V, 1-bit: 0.015625mV</par>
            <par>- @fsr 256mv, range +-0.256V, 1-bit: 0.0078125mV</par>
        </info>
        <arguments>
            <argument name="MODE" type="symbol" enum="diff single">
                <tr lang="en">See @mode</tr>
                <tr lang="ru" finished="false">См. @mode</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @fsr -->
            <property name="@fsr" type="symbol" default="6144mv" access="initonly"
            enum="1024mv 2048mv 256mv 4096mv 512mv 6144mv">
                <tr lang="en">full-scale input range</tr>
                <tr lang="ru" finished="false">Полномасштабный диапазон ввода</tr>
            </property>
            <!-- @i2c_addr -->
            <property name="@i2c_addr" type="int" default="-1" access="initonly" minvalue="-4"
            maxvalue="119">
                <tr lang="en">I²C address. Also 'default' value is accepted (for addr ???) and
                'alt' (for addr ???)</tr>
                <tr lang="ru" finished="false">Адрес I2C. Также принимается значение «по умолчанию»
                (для добавления ???) и «alt» (для добавления ????)</tr>
            </property>
            <!-- @i2c_bus -->
            <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none"
            access="initonly">
                <tr lang="en">I²C bus</tr>
                <tr lang="ru" finished="false">I2C автобус</tr>
            </property>
            <!-- @in_max -->
            <property name="@in_max" type="float" minvalue="0.0" maxvalue="6144.0" default="5000.0"
            access="readwrite">
                <tr lang="en">input maximum value in millivolts</tr>
                <tr lang="ru" finished="false">Максимальное входное значение в милливольтах</tr>
            </property>
            <!-- @in_min -->
            <property name="@in_min" type="float" minvalue="0.0" maxvalue="6144.0" default="0.0"
            access="readwrite">
                <tr lang="en">input minimal value in millivolts</tr>
                <tr lang="ru" finished="false">минимальное значение в милливольтах</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" default="single" enum="diff single"
            access="initonly">
                <tr lang="en">measure mode. If 'single' - measure level between A0, A1, A2, A3 and
                GND. If 'diff' - diff measure between A0 and A1, A0 and A3, A1 and A3, A2 and
                A3.</tr>
                <tr lang="ru" finished="false">Режим измерения. Если "один" - уровень измерения
                между A0, A1, A2, A3 и GND. Если "дифф" - дифф мера между А0 и А1, А0 и А3, А1 и
                А3, А2 и А3.</tr>
            </property>
            <!-- @norm -->
            <property name="@norm" type="bool" default="0" access="readwrite">
                <tr lang="en">normalization. If 1: normalize output into specified by @out_min
                @out_max range.</tr>
                <tr lang="ru" finished="false">нормализация. Если 1: нормализовать выход в заданном
                @out_min @out_max диапазоне.</tr>
            </property>
            <!-- @out_max -->
            <property name="@out_max" type="float" default="1.0" access="readwrite">
                <tr lang="en">output max value</tr>
                <tr lang="ru" finished="false">выходное максимальное значение</tr>
            </property>
            <!-- @out_min -->
            <property name="@out_min" type="float" default="0.0" access="readwrite">
                <tr lang="en">output minimum value</tr>
                <tr lang="ru" finished="false">выходное минимальное значение</tr>
            </property>
            <!-- @poll_time -->
            <property name="@poll_time" type="float" minvalue="5.0" maxvalue="250.0" default="20.0"
            units="millisecond" access="initonly">
                <tr lang="en">polling measure time</tr>
                <tr lang="ru" finished="false">Время проведения опроса</tr>
            </property>
        </properties>
        <methods>
            <!-- measure -->
            <method name="measure">single measure request 
            <param name="CHAN" type="int" minvalue="0" maxvalue="3">the channel to measure. If
            omitted: perform measure on all channels</param></method>
            <!-- poll -->
            <method name="poll">set polling turn on/off 
            <param name="STATE" type="bool" required="true">poll state</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang" />
            </inlet>
        </inlets>
        <outlets>
            <outlet>[ch CHANNEL VALUE( messages</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[poll $1(
|
| [measure 0(
| |
| | [measure(
| | |
[hw.rpi.adc.ads1115 #x]
|
|
|
[route ch]
|
[route 0 1 2 3 {w=30} #a]
|
[ui.hsl #a1]

    [ui.hsl #b]

        [ui.hsl #c]

            [ui.hsl #d]

[ui.link @url=ceammc://img/conn_ads1115.png @title='Connection_Scheme']
[X a:1->b] [X a:2->c] [X a:3->d]
#x @i2c_bus default @i2c_addr default @mode single @fsr 4096mv @norm 1 @in_min 0 @in_max 3300 @out_min 0 @out_max 1
#a1 @show_value 1
#b @show_value 1
#c @show_value 1
#d @show_value 1
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
