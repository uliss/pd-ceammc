<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.adc.ads1115">
    <title>hw.rpi.adc.ads1115</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">driver for 16-bit ADC on ADS1115 chip for Raspberry Pi</tr>
        <tr lang="ru">драйвер для 16-битного АЦП на чипе ADS1115 для Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>display rpi ads1115 adc</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Full-scale range settings:</tr>
        <tr lang="ru">Настройки полного диапазона значений:</tr>
      </par>
      <par>
        <tr lang="en">- @fsr 6144mV, range ±6.144V, 1 bit: 0.1875mV</tr>
        <tr lang="ru">- @fsr 6144мВ, диапазон ±6.144В, 1 бит: 0.1875мВ</tr>
      </par>
      <par>
        <tr lang="en">- @fsr 4096mV, range ±4.096V, 1 bit: 0.125mV</tr>
        <tr lang="ru">- @fsr 4096мВ, диапазон ±4.096В, 1 бит: 0.125мВ</tr>
      </par>
      <par>
        <tr lang="en">- @fsr 2048mV, range ±2.048V, 1 bit: 0.0625mV</tr>
        <tr lang="ru">- @fsr 2048мВ, диапазон ±2.048В, 1 бит: 0.0625мВ</tr>
      </par>
      <par>
        <tr lang="en">- @fsr 1024mV, range ±1.024V, 1 bit: 0.03125mV</tr>
        <tr lang="ru">- @fsr 1024мВ, диапазон ±1.024В, 1 бит: 0.03125мВ</tr>
      </par>
      <par>
        <tr lang="en">- @fsr 512mV, range ±0.512V, 1 bit: 0.015625mV</tr>
        <tr lang="ru">- @fsr 512мВ, диапазон ±0.512В, 1 бит: 0.015625мВ</tr>
      </par>
      <par>
        <tr lang="en">- @fsr 256mV, range ±0.256V, 1 bit: 0.0078125mV</tr>
        <tr lang="ru">- @fsr 256мВ, диапазон ±0.256В, 1 бит: 0.0078125мВ</tr>
      </par>
    </info>
    <arguments>
      <argument name="MODE" type="symbol" enum="diff single">
        <tr lang="en">See @mode</tr>
        <tr lang="ru">См. @mode</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @fsr -->
      <property name="@fsr" type="symbol" default="6144mv" access="initonly"
      enum="1024mv 2048mv 256mv 4096mv 512mv 6144mv">
        <tr lang="en">full-scale input range</tr>
        <tr lang="ru">полный входной диапазон</tr>
      </property>
      <!-- @i2c_addr -->
      <property name="@i2c_addr" type="int" default="-1" access="initonly" minvalue="-4"
      maxvalue="119">
        <tr lang="en">I²C address. Also the 'default' value is accepted (for address 0x48) and
        'alt' (for address 0x49)</tr>
        <tr lang="ru">Адрес I²C. Также принимается значение «default» (для адреса 0x48) и «alt»
        (для адреса 0x49)</tr>
      </property>
      <!-- @i2c_bus -->
      <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none"
      access="initonly">
        <tr lang="en">I²C bus</tr>
        <tr lang="ru">шина I²C</tr>
      </property>
      <!-- @in_max -->
      <property name="@in_max" type="float" minvalue="0.0" maxvalue="6144.0" default="5000.0"
      access="readwrite">
        <tr lang="en">input maximum value in millivolts</tr>
        <tr lang="ru">максимальное входное значение в милливольтах</tr>
      </property>
      <!-- @in_min -->
      <property name="@in_min" type="float" minvalue="0.0" maxvalue="6144.0" default="0.0"
      access="readwrite">
        <tr lang="en">input minimum value in millivolts</tr>
        <tr lang="ru">минимальное входное значение в милливольтах</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" default="single" enum="diff single" access="initonly">
        <tr lang="en">measurement mode. If 'single' - measures the level between A0, A1, A2, A3 and
        GND. If 'diff' - differential measurement between A0 and A1, A0 and A3, A1 and A3, A2 and
        A3.</tr>
        <tr lang="ru">режим измерения. Если "single" — измеряет уровень между A0, A1, A2, A3 и GND.
        Если "diff" — дифференциальное измерение между A0 и A1, A0 и A3, A1 и A3, A2 и A3.</tr>
      </property>
      <!-- @norm -->
      <property name="@norm" type="bool" default="0" access="readwrite">
        <tr lang="en">normalization. If 1: normalizes output into the range specified by the
        @out_min and @out_max properties.</tr>
        <tr lang="ru">нормализация. Если 1: нормализует выходные значения в диапазон, заданный
        свойствами @out_min и @out_max.</tr>
      </property>
      <!-- @out_max -->
      <property name="@out_max" type="float" default="1.0" access="readwrite">
        <tr lang="en">output maximum value</tr>
        <tr lang="ru">выходное максимальное значение</tr>
      </property>
      <!-- @out_min -->
      <property name="@out_min" type="float" default="0.0" access="readwrite">
        <tr lang="en">output minimum value</tr>
        <tr lang="ru">выходное минимальное значение</tr>
      </property>
      <!-- @poll_time -->
      <property name="@poll_time" type="float" minvalue="5.0" maxvalue="250.0" default="20.0"
      units="millisecond" access="initonly">
        <tr lang="en">polling measurement time</tr>
        <tr lang="ru">время между измерениями</tr>
      </property>
    </properties>
    <methods>
      <!-- measure -->
      <method name="measure">
        <info>
          <tr lang="en">single measurement request</tr>
          <tr lang="ru">запрос однократного измерения</tr>
        </info>
        <param name="CHAN" type="int" minvalue="0" maxvalue="3">
          <tr lang="en">channel to measure. If omitted: performs measurements on all channels</tr>
          <tr lang="ru">канал измерения. Если пропущено: выполнить измерения по всем каналам</tr>
        </param>
      </method>
      <!-- poll -->
      <method name="poll">
        <info>
          <tr lang="en">turn on/off automatic polling mode</tr>
          <tr lang="ru">включить/выключить режим автоматического опроса</tr>
        </info>
        <param name="STATE" type="bool" required="true">
          <tr lang="en">polling mode</tr>
          <tr lang="ru">режим опроса</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en" />
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out name="ch" type="any">
          <tr lang="en">CHANNEL VALUE</tr>
          <tr lang="ru">КАНАЛ ЗНАЧЕНИЕ</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[poll $1(
|
| [measure 0(
| |
| | [measure(
| | |
[hw.rpi.adc.ads1115 #x]
|
|
|
[route ch]
|
[route 0 1 2 3 {w=30} #a]
|
[ui.hsl #a1]

    [ui.hsl #b]

        [ui.hsl #c]

            [ui.hsl #d]

[ui.link @url=ceammc://img/conn_ads1115.png @title='Connection_Scheme']
[X a:1->b] [X a:2->c] [X a:3->d]
#x @i2c_bus default @i2c_addr default @mode single @fsr 4096mv @norm 1 @in_min 0 @in_max 3300 @out_min 0 @out_max 1
#a1 @show_value 1
#b @show_value 1
#c @show_value 1
#d @show_value 1
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
