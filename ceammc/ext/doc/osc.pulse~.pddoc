<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="osc.pulse~">
        <title>osc.pulse~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">bandlimited pulse train oscillator</tr>
                <tr lang="ru">осциллятор прямоугольной волны с ограниченным спектром</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>osc</category>
            <keywords>oscillator band-limited</keywords>
            <since>0.1</since>
            <also>
                <see>osc.impulse~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" minvalue="0.0" maxvalue="22050.0" units="hertz">
                <tr lang="en">See @freq</tr>
                <tr lang="ru" finished="false">См. @freq</tr>
            </argument>
            <argument name="DUTY" type="float" minvalue="0" maxvalue="1">
                <tr lang="en">duty cycle</tr>
                <tr lang="ru" finished="false">дежурный цикл</tr>
            </argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <xi:include href="props_active.xml" />
            <!-- @duty -->
            <property name="@duty" type="float" minvalue="0" maxvalue="1" default="0.5">
                <tr lang="en">duty cycle</tr>
                <tr lang="ru" finished="false">дежурный цикл</tr>
            </property>
            <!-- @freq -->
            <property name="@freq" type="float" default="0" minvalue="0" maxvalue="22050"
            units="hertz">
                <tr lang="en">frequency</tr>
                <tr lang="ru" finished="false">частота</tr>
            </property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo on="float">
                    <tr lang="en">frequency in Hz</tr>
                    <tr lang="ru" finished="false">частота в Гц</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">reset phase</tr>
                    <tr lang="ru" finished="false">фаза сброса</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">output signal</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]      [ui.knob]   [ui.dsp~]
|        |
|        |
|        |
|        [@duty $1(
|        |
[osc.pulse~ 220 0.5]
|
[ui.gain~ @size 120 14]
|\     |
[dac~] [ui.scope~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
