<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="osc.pulse~">
    <title>osc.pulse~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">bandlimited pulse train oscillator</tr>
        <tr lang="ru">осциллятор прямоугольной волны с ограниченным спектром</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>osc</category>
      <keywords>oscillator band-limited</keywords>
      <since>0.1</since>
      <also>
        <see>osc.impulse~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">generates a bandlimited rectangular wave with a controllable duty cycle, free of aliasing artifacts</tr>
        <tr lang="ru">генерирует прямоугольную волну с ограниченным спектром и управляемой скважностью без артефактов алиасинга</tr>
      </par>
      <par>
        <tr lang="en">the duty cycle sets the ratio of the high part of the period, 0.5 gives a square wave</tr>
        <tr lang="ru">скважность задаёт долю высокого уровня в периоде, при 0.5 получается меандр</tr>
      </par>
      <par>
        <tr lang="en">the left inlet receives the frequency in Hz, a bang on the right inlet resets the phase</tr>
        <tr lang="ru">левый вход принимает частоту в Гц, bang на правом входе сбрасывает фазу</tr>
      </par>
    </info>
    <arguments>
      <argument name="FREQ" type="float" minvalue="0.0" maxvalue="22050.0" units="hertz">
        <tr lang="en">see @freq</tr>
        <tr lang="ru">см. @freq</tr>
      </argument>
      <argument name="DUTY" type="float" minvalue="0" maxvalue="1">
        <tr lang="en">duty cycle</tr>
        <tr lang="ru">скважность</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @duty -->
      <property name="@duty" type="float" minvalue="0" maxvalue="1" default="0.5">
        <tr lang="en">duty cycle</tr>
        <tr lang="ru">скважность</tr>
      </property>
      <!-- @freq -->
      <property name="@freq" type="float" default="0" minvalue="0" maxvalue="22050" units="hertz">
        <tr lang="en">frequency</tr>
        <tr lang="ru">частота</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in on="float">
          <tr lang="en">frequency in Hz</tr>
          <tr lang="ru">частота в Гц</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">reset phase</tr>
          <tr lang="ru">сбросить фазу</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">output signal</tr>
          <tr lang="ru">выходной сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]      [ui.knob]   [ui.dsp~]
|        |
|        |
|        |
|        [@duty $1(
|        |
[osc.pulse~ 220 0.5]
|
[ui.gain~ @size 120 14]
|\     |
[dac~] [ui.scope~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
