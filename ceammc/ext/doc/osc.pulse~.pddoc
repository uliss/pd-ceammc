<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <object name="osc.pulse~">
        <title>osc.pulse~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">bandlimited pulse train oscillator</tr>
                <tr lang="ru">осциллятор прямоугольной волны с ограниченным спектром</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>osc</category>
            <keywords>oscillator band-limited</keywords>
            <since>0.1</since>
            <also>
                <see>osc.impulse~</see>
            </also>
        </meta>
        <arguments>
            <argument name="FREQ" type="float" units="hertz" minvalue="20">frequency</argument>
            <argument name="DUTY" type="float" minvalue="0" maxvalue="1">duty cycle</argument>
        </arguments>
        <properties>
            <xi:include href="props_osc.xml" />
            <xi:include href="props_id.xml" />
            <!-- @active -->
            <property name="@active" type="bool" default="1">on/off dsp processing</property>
            <!-- @duty -->
            <property name="@duty" type="float" minvalue="0" maxvalue="1" default="0.5">duty
            cycle</property>
        </properties>
        <inlets>
            <inlet type="audio">
                <xinfo on="float">frequency in Hz</xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">reset phase</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">output signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]      [ui.knob]   [ui.dsp~]
|        |
|        |
|        |
|        [@duty $1(
|        |
[osc.pulse~ 220 0.5]
|
[ui.gain~ @size 120 14]
|\     |
[dac~] [ui.scope~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
