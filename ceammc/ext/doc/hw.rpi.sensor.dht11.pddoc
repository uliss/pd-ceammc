<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.sensor.dht11">
    <title>hw.rpi.sensor.dht11</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">digital humidity and temperature sensor (DHT11) for Raspberry Pi</tr>
        <tr lang="ru">цифровой датчик влажности и температуры (DHT11) для Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>raspberry sensor humidity temperature dht11</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Temperature range: 0..+50°C ±2°C</tr>
        <tr lang="ru">Диапазон температур: 0..+50°C ±2°C</tr>
      </par>
      <par>
        <tr lang="en">Humidity range: 20-90%RH ±5%RH</tr>
        <tr lang="ru">Диапазон влажности: 20-90%RH ±5%RH</tr>
      </par>
      <par style="important">
        <tr lang="en">When using a 3.5V voltage supply cable length shall not be greater than 20cm.
        Otherwise, the line voltage drop will cause the sensor power supply shortage, caused by
        measurement error</tr>
        <tr lang="ru">При использовании кабеля питания напряжением 3.5В его длина не должна
        превышать 20см. В противном случае падение напряжения на линии приведет к недостаточному
        питанию датчика и вызовет ошибки измерения.</tr>
      </par>
      <par style="important">
        <tr lang="ru">При создании объект забирает в эксклюзивное владение GPIO контакт @pin:
        использовать его в других объектах одновременно с этим *невозможно*.</tr>
        <tr lang="en">When created, the object takes exclusive ownership of the GPIO pin @pin,
         - it is *impossible* to use them in other objects simultaneously with this
        one.</tr>
      </par>
      <par style="info">
        <tr lang="en">To connect to the device, set the @connect property to 1</tr>
        <tr lang="ru">Для подключения к устройству установите свойство @connect равным 1</tr>
      </par>
    </info>
    <arguments>
      <argument name="PIN" type="int" minvalue="-1" maxvalue="127">
        <tr lang="en">GPIO pin to connect. See @pin</tr>
        <tr lang="ru">GPIO пин для подключения. См. @pin</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @pin -->
      <property name="@pin" type="int" default="-1" minvalue="-1" maxvalue="127" access="initonly">
        <tr lang="en">GPIO connection pin</tr>
        <tr lang="ru">пин соединения GPIO</tr>
      </property>
    </properties>
    <methods>
      <!-- poll -->
      <method name="poll">
        <info>
          <tr lang="en">turn the sensor polling on/off</tr>
          <tr lang="ru">включить/выключить автоматический опрос сенсора</tr>
        </info>
        <param name="STATE" type="bool" required="true">
          <tr lang="en">poll state</tr>
          <tr lang="ru">состояние опроса</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">take a single measurement</tr>
          <tr lang="ru">произвести однократное измерение</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">TEMPERATURE(in Celsius) HUMIDITY</tr>
          <tr lang="ru">ТЕМПЕРАТУРА (в Цельсиях) ВЛАЖНОСТЬ</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[@connect $1(    [T]/*<- poll sensor data*/
|                |
|                [poll $1(
|                |
|                |  [B]/*<- single measurement*/
|                |  |
[hw.rpi.sensor.dht11 @pin 17]
|
[print]


[ui.link @url=ceammc://img/conn_dht11.png @title=Connection_Scheme]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
