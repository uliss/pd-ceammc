<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="hw.rpi.sensor.dht11">
        <title>hw.rpi.sensor.dht11</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">digital humidity and temperature sensor (DHT11) for Raspberry Pi</tr>
                <tr lang="ru">цифровой датчик влажности и температуры (DHT11) для Raspberry Pi</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>raspberry sensor humidity temperature dht11</keywords>
            <since>0.9.8</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Temperature range: 0..+50°C ±2°C</tr>
                <tr lang="ru" finished="false">Диапазон температур: 0..+50°C ±2°C</tr>
            </par>
            <par>
                <tr lang="en">Humidity range: 20-90%RH ±5%RH</tr>
                <tr lang="ru" finished="false">Диапазон влажности: 20-90%RH ±5%RH</tr>
            </par>
            <par>
                <tr lang="en">When using a 3.5V voltage supply cable length shall not be greater
                than 20cm. Otherwise, the line voltage drop will cause the sensor power supply
                shortage, caused by measurement error</tr>
                <!-- old: При использовании кабеля питания напряжением 3,5 В
                длина не должна превышать 20 см. В противном случае падение напряжения линии
                вызовет дефицит питания датчика, вызванный ошибкой измерения. -->
                <tr lang="ru" finished="false">При использовании кабеля питания напряжением 3,5 В
                длина не должна превышать 20 см. В противном случае падение напряжения линии
                вызовет дефицит питания датчика, вызванный ошибкой измерения.</tr>
            </par>
        </info>
        <arguments>
            <argument name="PIN" type="int" minvalue="-1" maxvalue="127">
                <tr lang="en">GPIO pin to connect. See @pin</tr>
                <tr lang="ru">GPIO пин для подключения. См. @pin</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @pin -->
            <property name="@pin" type="int" default="-1" minvalue="-1" maxvalue="127"
            access="initonly">
                <tr lang="en">GPIO connection pin</tr>
                <tr lang="ru">пин соединения GPIO</tr>
            </property>
        </properties>
        <methods>
            <!-- poll -->
            <method name="poll">
                <info>
                    <tr lang="en">turn the sensor polling on/off</tr>
                    <tr lang="ru" finished="false">Включить / выключить сенсорный опрос</tr>
                </info>
                <param name="STATE" type="bool" required="true">
                    <tr lang="en">poll state</tr>
                    <tr lang="ru" finished="false">государство</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">single distance measure</tr>
                    <tr lang="ru" finished="false">одномерное расстояние</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">list: TEMPERATURE(in Celsius) HUMIDITY</tr>
                    <tr lang="ru" finished="false">Список: ТЕМПЕРАТУРА (в Цельсиях)</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[poll $1(
|
|  [B]
|  |
[hw.rpi.sensor.dht11 @pin 17]
|
[print]


[ui.link @url=ceammc://img/conn_dht11.png @title=Connection_Scheme]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
