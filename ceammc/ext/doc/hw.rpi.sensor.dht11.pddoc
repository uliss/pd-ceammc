<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.sensor.dht11">
    <title>hw.rpi.sensor.dht11</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">digital humidity and temperature sensor (DHT11) for Raspberry Pi</tr>
        <tr lang="ru">цифровой датчик влажности и температуры (DHT11) для Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>raspberry sensor humidity temperature dht11</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Temperature range: 0..+50°C ±2°C</tr>
        <tr lang="ru">Диапазон температур: 0..+50 °C ±2 °C</tr>
      </par>
      <par>
        <tr lang="en">Humidity range: 20–90% RH ±5% RH</tr>
        <tr lang="ru">Диапазон влажности: 20–90 % RH ±5 % RH</tr>
      </par>
      <par style="important">
        <tr lang="en">When using a 3.5 V power supply, the cable length should not exceed 20 cm.
        Otherwise, the voltage drop across the line will cause insufficient power to the sensor,
        resulting in measurement errors.</tr>
        <tr lang="ru">При использовании источника питания напряжением 3.5 В длина кабеля не должна
        превышать 20 см. В противном случае падение напряжения на линии приведёт к недостаточному
        питанию датчика и вызовет ошибки измерения.</tr>
      </par>
      <par style="important">
        <tr lang="en">When created, the object takes exclusive ownership of the GPIO pin @pin — it
        is *impossible* to use it in other objects simultaneously with this one.</tr>
        <tr lang="ru">При создании объект забирает в эксклюзивное владение контакт GPIO @pin —
        использовать его в других объектах одновременно с этим *невозможно*.</tr>
      </par>
      <par style="warning">
        <tr lang="en">Before connecting, carefully check the sensor pins: some sensors have a
        different pin layout than the one shown in the wiring diagram!</tr>
        <tr lang="ru">Перед подключением внимательно изучите выводы датчика: некоторые датчики
        имеют другую распиновку, чем на схеме подключения!</tr>
      </par>
      <par style="info">
        <tr lang="en">To connect to the device, set the @connect property to 1.</tr>
        <tr lang="ru">Для подключения к устройству установите свойство @connect равным 1.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Environment monitoring — reading temperature and humidity in a room,
        studio or installation, for example to log the climate or to trigger an alarm when
        conditions exceed the configured range.</tr>
        <tr lang="ru">• Мониторинг окружающей среды — измерение температуры и влажности в комнате,
        студии или инсталляции, например для ведения журнала климата или запуска сигнала при
        выходе условий за заданный диапазон.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Sonification and interactive installations — mapping temperature and
        humidity to sound parameters, so that the music reacts to the physical environment in real
        time, for example in weather-driven compositions or data sonification projects.</tr>
        <tr lang="ru">• Сонификация и интерактивные инсталляции — преобразование температуры и
        влажности в звуковые параметры, чтобы музыка реагировала на физическое окружение в
        реальном времени, например в композициях, зависящих от погоды, или в проектах
        сонификации данных.</tr>
      </par>
    </info>
    <arguments>
      <argument name="PIN" type="int" minvalue="-1" maxvalue="127">
        <tr lang="en">GPIO pin to connect. See @pin.</tr>
        <tr lang="ru">контакт GPIO для подключения. См. @pin</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @connect -->
      <property name="@connect" type="bool" default="0" access="readwrite">
        <tr lang="en">When set to 1: tries to connect to the device. When set to 0: disconnects
        from the device.</tr>
        <tr lang="ru">при значении 1: пытается подключиться к устройству. При значении 0:
        отключается от устройства</tr>
      </property>
      <!-- @pin -->
      <property name="@pin" type="int" default="-1" minvalue="-1" maxvalue="127" access="initonly">
        <tr lang="en">GPIO connection pin</tr>
        <tr lang="ru">контакт GPIO для подключения</tr>
      </property>
    </properties>
    <methods>
      <!-- poll -->
      <method name="poll">
        <info>
          <tr lang="en">turns sensor polling on or off</tr>
          <tr lang="ru">включает или выключает автоматический опрос датчика</tr>
        </info>
        <param name="STATE" type="bool" required="true">
          <tr lang="en">poll state</tr>
          <tr lang="ru">состояние опроса</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">take a single measurement</tr>
          <tr lang="ru">выполнить однократное измерение</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="list">
          <tr lang="en">TEMPERATURE (in Celsius) HUMIDITY</tr>
          <tr lang="ru">TEMPERATURE (в градусах Цельсия) HUMIDITY</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[@connect $1(    [T]/*<- poll sensor data*/
|                |
|                [poll $1(
|                |
|                |  [B]/*<- single measurement*/
|                |  |
[hw.rpi.sensor.dht11 @pin 17]
|
[print]


[ui.link @url=ceammc://img/conn_dht11.png @title=Connection_Scheme]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
