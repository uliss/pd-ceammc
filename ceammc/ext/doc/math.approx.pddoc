<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="math.approx">
        <title>math.approx</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks if the input value is approximately equal to the pattern</tr>
                <tr lang="ru">проверить, если входное значение приблизительно равно образцу</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>equal compare approx</keywords>
            <since>0.1</since>
            <aliases>
                <alias>ceammc/approx</alias>
                <alias>approx</alias>
            </aliases>
        </meta>
        <info>
            <par>
                <tr lang="en">checks if |x - pattern| &lt;= |epsilon|</tr>
            </par>
        </info>
        <arguments>
            <argument name="VALUE" type="float">
                <tr lang="en">compare pattern</tr>
            </argument>
            <argument name="EPSILON" type="float">
                <tr lang="en">compare epsilon</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @epsilon -->
            <property name="@epsilon" type="float" default="0.01">
                <tr lang="en">compare epsilon</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="float" default="0">
                <tr lang="en">compare pattern</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">input value</xinfo>
                <xinfo on="list">list values are spreaded among three inlets</xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">pattern value</xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">epsilon</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>output 1 if input value is approximately equal to pattern, 0 0
            otherwise</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[HS]
|
|   [1.99 2 0.01(
|   |
[F] |
|   |
[math.approx 50 10] /* 40 <= x <= 60 */
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
