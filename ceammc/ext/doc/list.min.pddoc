<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="list.min">
        <title>list.min</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">returns a smallest list element</tr>
                <tr lang="ru">возвращает наименьший элемент в списке</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list min compare</keywords>
            <since>0.1</since>
            <also>
                <see>list.max</see>
                <see>list.range</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">By default returns smallest float in list, this equal to using @float
                property.</tr>
                <!-- old: По умолчанию возвращает наименьший поплавок в
                списке, это равно использованию свойства @float. -->
                <tr lang="ru" finished="false">По умолчанию возвращает наименьший поплавок в
                списке, это равно использованию свойства @float.</tr>
            </par>
            <par>
                <tr lang="en">Also you can choose smallest symbol from list by using @symbol
                property.</tr>
                <!-- old: Также вы можете выбрать наименьший символ из списка,
                используя свойство символа. -->
                <tr lang="ru" finished="false">Также вы можете выбрать наименьший символ из списка,
                используя свойство символа.</tr>
            </par>
        </info>
        <properties>
            <!-- @any -->
            <property name="@any" type="alias">
                <tr lang="en">alias for @type any. Find greatest atom of any type. Note: symbols
                are greater then numbers</tr>
                <!-- old: Фамилия для @type any. Найдите самый большой атом
                любого типа. Примечание: символы больше, чем числа -->
                <tr lang="ru" finished="false">Фамилия для @type any. Найдите самый большой атом
                любого типа. Примечание: символы больше, чем числа</tr>
            </property>
            <!-- @float -->
            <property name="@float" type="alias">
                <tr lang="en">alias for @type float. Find max float element in list</tr>
                <!-- old: Оригинальное название: @type float. Найти элемент
                max float в списке -->
                <tr lang="ru" finished="false">Оригинальное название: @type float. Найти элемент
                max float в списке</tr>
            </property>
            <!-- @symbol -->
            <property name="@symbol" type="alias">
                <tr lang="en">alias for @type symbol. Find greatest symbol element</tr>
                <!-- old: Фамилия для символа @type. Найдите самый большой
                элемент символа -->
                <tr lang="ru" finished="false">Фамилия для символа @type. Найдите самый большой
                элемент символа</tr>
            </property>
            <!-- @type -->
            <property name="@type" type="symbol" enum="float symbol any" default="float">
                <tr lang="en">type of largest element</tr>
                <tr lang="ru" finished="false">Тип самого большого элемента</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">input list</tr>
                    <tr lang="ru" finished="false">вводный список</tr>
                </in>
                <in on="data:mlist">
                    <tr lang="en">input mlist</tr>
                    <tr lang="ru" finished="false">входной млечный</tr>
                </in>
                <in on="float">
                    <tr lang="en">passed thru in @float or @any mode</tr>
                    <tr lang="ru" finished="false">@float или любой режим</tr>
                </in>
                <in on="symbol">
                    <tr lang="en">passed thru in @symbol or @any mode</tr>
                    <tr lang="ru" finished="false">@symbol или любой режим</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">smallest element</tr>
                    <tr lang="ru" finished="false">наименьший элемент</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 a b(  [list a b c(  [1 2 3 a b(  [list aa ab ac(
|            |             |            |
|            |             |            |
[list.min @float]          [list.min @symbol]
|                          |
[F]                        [S digits=10]

[1 a 2 b 3 c( [F]    [S digits=8]
|             |      |
|             |      |
[list.min @any       ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
