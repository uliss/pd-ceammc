<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="array.circular~">
        <title>array.circular~</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">read/write the signal into the array like in a circular buffer</tr>
                <tr lang="ru">чтение/запись сигнала в массив, как в кольцевой буфер</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array circular ring</keywords>
            <since>0.9.4</since>
        </meta>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
            <argument name="ON" type="bool">
                <tr lang="en">write control: if true, the signal is written to the array</tr>
                <tr lang="ru">управление записью: если истинно, производится запись сигнала в
                массив</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </property>
            <!-- @interp -->
            <property name="@interp" type="int" enum="0 1 3" default="0">
                <tr lang="en">interpolation mode</tr>
                <tr lang="ru">режим интерполяции</tr>
            </property>
            <!-- @on -->
            <property name="@on" type="bool" default="1">
                <tr lang="en">write mode</tr>
                <tr lang="ru">режим записи</tr>
            </property>
        </properties>
        <methods>
            <!-- resize -->
            <method name="resize">
                <info>
                    <tr lang="en">resize target array</tr>
                    <tr lang="ru">изменить размер целевого массива</tr>
                </info>
                <param name="SZ" type="int" minvalue="10" units="sample" required="true">
                    <tr lang="en">new size</tr>
                    <tr lang="ru">новый размер</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">write delay</tr>
                </xinfo>
            </inlet>
            <inlet type="audio">
                <xinfo>
                    <tr lang="en">read delay</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="bang">
                    <tr lang="en">reset write position to zero</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">set write position</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">read signal</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[open guitar1.wav, 1(    [table AC1 44100]
|
|
[readsf~ ]   [lfo.+tri~ 5]
| |          |
| |          [*~ 100]
| |          |.
| [array.circular~ AC1]  [ui.dsp~]
| |.
[ui.hgain2~]
*|*
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
