<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="array.circular~">
    <title>array.circular~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">read/write the signal into the array like in a circular buffer</tr>
        <tr lang="ru">чтение/запись сигнала в массив как в кольцевой буфер</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>array</category>
      <keywords>array circular ring</keywords>
      <since>0.9.4</since>
    </meta>
    <info>
      <par>
        <tr lang="en">The object treats the specified array as a circular (ring) buffer for audio
        signals. The signal on the first (left) audio inlet is written into the array at the current
        write position, while the signal on the second audio inlet controls the read offset (delay)
        relative to the write position and is output through the audio outlet. The @on property
        enables or disables writing, when writing is off, the array keeps its contents and only
        reading is performed.</tr>
        <tr lang="ru">Объект рассматривает указанный массив как кольцевой (циклический) буфер для
        аудиосигналов. Сигнал с первого (левого) звукового входа записывается в массив в текущую
        позицию записи, а сигнал со второго звукового входа управляет смещением чтения (задержкой)
        относительно позиции записи и выводится через звуковой выход. Свойство @on включает или
        отключает запись, когда запись выключена, массив сохраняет своё содержимое, и выполняется
        только чтение.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ARRAY" type="symbol">
        <tr lang="en">name of the array used as a circular buffer</tr>
        <tr lang="ru">имя массива, используемого как кольцевой буфер</tr>
      </argument>
      <argument name="ON" type="bool">
        <tr lang="en">write control: if true, the signal is written to the array</tr>
        <tr lang="ru">управление записью: если истинно, производится запись сигнала в массив</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @array -->
      <property name="@array" type="symbol" default="">
        <tr lang="en">name of the array used as a circular buffer</tr>
        <tr lang="ru">имя массива, используемого как кольцевой буфер</tr>
      </property>
      <!-- @interp -->
      <property name="@interp" type="int" enum="0 1 3" default="0">
        <tr lang="en">interpolation mode for reading from the buffer</tr>
        <tr lang="ru">режим интерполяции при чтении из буфера</tr>
      </property>
      <!-- @on -->
      <property name="@on" type="bool" default="1">
        <tr lang="en">write mode: if true, incoming signal is written to the array</tr>
        <tr lang="ru">режим записи: если истинно, входящий сигнал записывается в массив</tr>
      </property>
    </properties>
    <methods>
      <!-- resize -->
      <method name="resize">
        <info>
          <tr lang="en">resize the target array</tr>
          <tr lang="ru">изменить размер целевого массива</tr>
        </info>
        <param name="SZ" type="int" minvalue="10" units="sample" required="true">
          <tr lang="en">new size in samples</tr>
          <tr lang="ru">новый размер в отсчётах</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">signal to write into the buffer</tr>
          <tr lang="ru">сигнал для записи в буфер</tr>
        </in>
      </inlet>
      <inlet type="audio">
        <in>
          <tr lang="en">read delay: controls the read offset relative to the write position</tr>
          <tr lang="ru">задержка чтения: управляет смещением чтения относительно позиции
          записи</tr>
        </in>
      </inlet>
      <inlet>
        <in on="bang">
          <tr lang="en">reset write position to zero</tr>
          <tr lang="ru">сбросить позицию записи в ноль</tr>
        </in>
        <in on="float">
          <tr lang="en">set write position</tr>
          <tr lang="ru">установить позицию записи</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">read signal</tr>
          <tr lang="ru">прочитанный сигнал</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[open guitar1.wav, 1(    [table AC1 44100]
|
|
[readsf~ ]   [lfo.+tri~ 5]
| |          |
| |          [*~ 100]
| |          |.
| [array.circular~ AC1]  [ui.dsp~]
| |.
[ui.hgain2~]
*|*
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
