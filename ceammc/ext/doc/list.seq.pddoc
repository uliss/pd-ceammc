<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.seq">
        <title>list.seq</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">generates a sequence of numbers in the form of a list</tr>
                <tr lang="ru">генерирует последовательноть чисел в виде списка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list sequence generate</keywords>
            <since>0.1</since>
            <also>
                <see>list.gen</see>
            </also>
        </meta>
        <arguments>
            <argument name="FROM" type="float">
                <tr lang="en">start value</tr>
                <tr lang="ru" finished="false">стартовая стоимость</tr>
            </argument>
            <argument name="TO" type="float">
                <tr lang="en">end value</tr>
                <tr lang="ru" finished="false">конечная стоимость</tr>
            </argument>
            <argument name="STEP" type="float">
                <tr lang="en">sequence step</tr>
                <tr lang="ru" finished="false">шаг последовательности</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @closed -->
            <property name="@closed" type="flag" default="0" access="initonly">
                <tr lang="en">generate closed range sequence</tr>
                <tr lang="ru" finished="false">генерировать замкнутую последовательность</tr>
            </property>
            <!-- @from -->
            <property name="@from" type="float" default="0">
                <tr lang="en">start value</tr>
                <tr lang="ru" finished="false">стартовая стоимость</tr>
            </property>
            <!-- @step -->
            <property name="@step" type="float" default="1">
                <tr lang="en">sequence step (always positive)</tr>
                <tr lang="ru" finished="false">Шаг последовательности (всегда положительный)</tr>
            </property>
            <!-- @to -->
            <property name="@to" type="float" default="1">
                <tr lang="en">end value</tr>
                <tr lang="ru" finished="false">конечная стоимость</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">outputs generated list</tr>
                    <tr lang="ru" finished="false">сгенерированный список</tr>
                </in>
                <in on="float">
                    <tr lang="en">sets @from=0, @to=X and outputs generated sequence</tr>
                    <!-- old: Устанавливает @from=0, @to=X и выводит
                    генерируемую последовательность -->
                    <tr lang="ru" finished="false">Устанавливает @from=0, @to=X и выводит
                    генерируемую последовательность</tr>
                </in>
                <in on="list">
                    <tr lang="en">if 3 arguments are given: they are set to @from, @to and @step
                    accordingly. If 2 args are given: they are set to @from, @to and @step is set
                    to *1*. If 1 arg given, @from is set to 0, @to sets to given value and @step is
                    set to *1*</tr>
                    <!-- old: Если дано 3 аргумента: они установлены на @from,
                    @to и @step соответственно. Если дано 2 args: они установлены на @from, @to и
                    @step установлены на *1*. Если дано 1 arg, @from установлен на 0, @to
                    установлен на заданное значение и @step установлен на *1* -->
                    <tr lang="ru" finished="false">Если дано 3 аргумента: они установлены на @from,
                    @to и @step соответственно. Если дано 2 args: они установлены на @from, @to и
                    @step установлены на *1*. Если дано 1 arg, @from установлен на 0, @to
                    установлен на заданное значение и @step установлен на *1*</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">generated sequence</tr>
                    <tr lang="ru" finished="false">генерируемая последовательность</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[B]            [1 -1 0.1(
|       [2 10( |
|  [F]  |      |
|  |    |      |
[list.seq 3 10 2]
|
[m set]
|
[ (
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
