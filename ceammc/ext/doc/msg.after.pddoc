<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="msg.after">
    <title>msg.after</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">sends the specified message following the forwarded incoming message</tr>
        <tr lang="ru">отправляет указанное сообщение после пересланного входящего сообщения</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>msg</category>
      <keywords>message after onload</keywords>
      <since>0.7</since>
      <also>
        <see>msg</see>
      </also>
    </meta>
    <info>
      <par style="info">
        <tr lang="en">Upon receiving a new incoming message, if the previously
        added message has not yet been sent: its sending is canceled.
        The sending of the added message will then be scheduled only for this new message.</tr>
        <tr lang="ru">При получении нового входящего сообщения, если предыдущее добавленное
        сообщение еще не  было отправлено: его отправка отменяется.
        Далее будет запланирована отправка добавленного сообщения только для этого
        нового сообщения.</tr>
      </par>
    </info>
    <arguments>
      <argument name="DELAY" type="float" minvalue="0" units="millisecond">
        <tr lang="en">delay in sending the added message</tr>
        <tr lang="ru">задержка отправки добавленного сообщения</tr>
      </argument>
      <argument name="MSG" type="list">
        <tr lang="en">message sent after the incoming one</tr>
        <tr lang="ru">сообщение отправляемое после входного</tr>
      </argument>
    </arguments>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">any input message</tr>
          <tr lang="ru">любое входящее сообщение</tr>
        </in>
      </inlet>
      <inlet>
        <in on="float">
          <tr lang="en">set the delay time for sending the added message</tr>
          <tr lang="ru">установить время задержки оправки добавленного сообщения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output messages</tr>
          <tr lang="ru">выходные сообщения</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
            [1(
            |
[osc~ 500]  [msg.after 500 0]
|           |
|           [@gate $1(
|           |
[env.adsr~ 20 100 30 500]
|
[ui.gain~ @size 120 14] [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
