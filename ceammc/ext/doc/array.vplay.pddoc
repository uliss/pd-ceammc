<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.14">
    <object name="array.vplay">
        <title>array.vplay</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">simple array player for using with the [vline~] object</tr>
                <tr lang="ru">простой плеер массивов для использования с объектом [vline~]</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>array</category>
            <keywords>array play vline</keywords>
            <also>
                <see>list.each</see>
            </also>
            <since>0.5</since>
        </meta>
        <arguments>
            <argument name="ARRAY" type="symbol">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @abs_begin -->
            <property name="@abs_begin" type="int" units="sample" access="readonly" default="0">
                <tr lang="en">absolute start position</tr>
                <tr lang="ru">абсолютное начальное положение</tr>
            </property>
            <!-- @abs_end -->
            <property name="@abs_end" type="int" units="sample" access="readonly" default="0">
                <tr lang="en">absolute stop position</tr>
                <tr lang="ru">абсолютное конечное положение</tr>
            </property>
            <!-- @array -->
            <property name="@array" type="symbol" default="">
                <tr lang="en">array name</tr>
                <tr lang="ru">имя массива</tr>
            </property>
            <!-- @begin -->
            <property name="@begin" type="int" default="0" units="sample">
                <tr lang="en">begin position</tr>
                <tr lang="ru">начальное положение</tr>
            </property>
            <!-- @end -->
            <property name="@end" type="int" default="-1" units="sample">
                <tr lang="en">end position</tr>
                <tr lang="ru">конечное положение</tr>
            </property>
            <!-- @reversed -->
            <property name="@reversed" type="bool" default="0">
                <tr lang="en">playing backwards</tr>
                <tr lang="ru">играть в обратном направлении</tr>
            </property>
            <!-- @speed -->
            <property name="@speed" type="float" minvalue="0.1" default="1">
                <tr lang="en">play speed</tr>
                <tr lang="ru">скорость воспроизведения</tr>
            </property>
            <!-- @state -->
            <property name="@state" type="symbol" enum="play stop" access="readonly"
            default="stop">
                <tr lang="en">player state</tr>
                <tr lang="ru">состояние воспроизведения</tr>
            </property>
        </properties>
        <methods>
            <!-- play -->
            <method name="play">
                <info>
                    <tr lang="en">start playing</tr>
                </info>
            </method>
            <!-- range -->
            <method name="range">
                <info>
                    <tr lang="en">set play range.</tr>
                </info>
                <param name="VALUE" type="float" required="true">
                    <tr lang="en">start value. Negative values (offset from end) are supported for
                    ms, sec and sample units. *-1 sample* means last sample.</tr>
                    <tr lang="ru">начальное значение. Отрицательные значения (смещение с конца)
                    поддерживаются для ms, sec и семплов. *-1 семпл* означает последний семпл</tr>
                </param>
                <param name="UNIT" type="symbol" required="true" enum="ms sec phase sample">
                    <tr lang="en">value unit</tr>
                    <tr lang="ru">единица времени</tr>
                </param>
                <param name="VALUE" type="float" required="false">
                    <tr lang="en">end value</tr>
                    <tr lang="ru">конечное значение</tr>
                </param>
                <param name="UNIT" type="symbol" required="true" enum="ms sec phase sample">
                    <tr lang="en">value unit</tr>
                    <tr lang="ru">единица времени</tr>
                </param>
            </method>
            <!-- stop -->
            <method name="stop">
                <info>
                    <tr lang="en">stop playing</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">start playing from the beginning</xinfo>
                <xinfo on="float">1 - play, 0 - stop</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>message to vline~ object</outlet>
            <outlet>bang after playing finished</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[load %DOC%/sound/voice.wav @to vplay @resize(
|                                        [array vplay size=100 w=120 h=80]
[expand_env]  [0.3( [1( [1.7(
|             |     |   |
[snd.file]    [F        ] [T]
              |           |
              |           |
[stop, play(  [@speed $1( [@reversed $1( [ui.rslider @mouse_events 1]
|             |           |              |
| [r pos] [B] |           |              [ui.mouse_filter @up]
| |       |   |           |              |
[array.vplay @array vplay ]              [range $1 phase $2 phase(
|                    ^|                  |
[vline~]             [B]                 | [@begin 0( [@end -1(
|                                        | |          |
[tabread4~ vplay]                        [s        pos]
|
[ui.gain~ @size 120 16]      [ui.dsp~]
| \
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
