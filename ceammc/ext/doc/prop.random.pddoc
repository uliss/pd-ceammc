<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="prop.random">
    <title>prop.random</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">property value randomizer</tr>
        <tr lang="ru">рандомизатор значений свойств</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>property</category>
      <keywords>property random</keywords>
      <since>0.9.4</since>
      <also>
        <see>prop</see>
        <see>prop.declare</see>
        <see>patch.props</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object sets a random value to the specified properties of the connected object, subpatch or abstraction</tr>
        <tr lang="ru">объект присваивает случайное значение указанным свойствам подключённого объекта, субпатча или абстракции</tr>
      </par>
      <par>
        <tr lang="en">the properties must be declared with [prop.declare] first; the random value is chosen within the property's @min and @max limits</tr>
        <tr lang="ru">свойства должны быть предварительно объявлены через [prop.declare]; случайное значение выбирается в пределах @min и @max свойства</tr>
      </par>
      <par>
        <tr lang="en">use @seed for reproducible sequences. If @seed is not set explicitly, a generator initialized with the current time is used</tr>
        <tr lang="ru">используйте @seed для воспроизводимых последовательностей. Если @seed не задан явно, используется генератор, инициализированный текущим временем</tr>
      </par>
    </info>
    <arguments>
      <argument name="SEED" type="int">
        <tr lang="en">initial random seed</tr>
        <tr lang="ru">начальное значение генератора случайных чисел</tr>
      </argument>
      <argument name="PROPS" type="list">
        <tr lang="en">property names</tr>
        <tr lang="ru">имена свойств</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @seed -->
      <property name="@seed" type="int" default="0">
        <tr lang="en">random seed</tr>
        <tr lang="ru">начальное значение генератора случайных чисел</tr>
      </property>
    </properties>
    <inlets dynamic="true">
      <inlet number="1">
        <in>
          <tr lang="en">first specified property</tr>
          <tr lang="ru">первое указанное свойство</tr>
        </in>
      </inlet>
      <inlet number="...">
        <in>
          <tr lang="en">... specified property</tr>
          <tr lang="ru">... указанное свойство</tr>
        </in>
      </inlet>
      <inlet number="n">
        <in>
          <tr lang="en">n-th specified property</tr>
          <tr lang="ru">N-е указанное свойство</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">connect to the target object</tr>
          <tr lang="ru">подключить к целевому объекту</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">atom: new random value</tr>
          <tr lang="ru">атом: новое случайное значение</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[B]
|
[prop.random @feedback]
|              ^|
| [sig~ 50]    [F]
| |
[osc.sinfb~]   [ui.dsp~]
|
[ui.hgain~]
|\
[dac~]

[prop.random-1]   [prop.random-2]

[prop.random-3]
]]>
      </pdascii>
      <pdascii id="1">
<![CDATA[
[B]
|
[prop.random @wave]
|              ^|
| [sig~ 50]    [S]
| |
[lfo.mosc~]    [ui.dsp~]
|
[ui.hgain~]
|\
[dac~]
]]>
      </pdascii>
      <pdascii id="2">
<![CDATA[
[F]                         [B]
|                           |
[phasor~ 50] [lfo.+tri~ 1]  [prop.random @res]
|            |              |              ^|
|            [*~ 7000]      |              [F]
|            |.             |.
[flt.moog_vcf~      0.6      ]
|
[ui.gain~ @size 120 16] [ui.dsp~]
|\
[dac~]
]]>
      </pdascii>
      <pdascii id="abs">
<![CDATA[
[inlet]

[prop.declare freq @f @min 50 @max 200 @default 50]

[prop @freq]
|
[F]
|
[osc~]
|
[outlet~]
]]>
      </pdascii>
      <pdascii id="3">
<![CDATA[
[B]
|
[prop.random @freq]
|             ^|
|             [F]
|
[prop.random-abs]
|
[ui.hgain~]
|\
[dac~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
