<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="noise.stein">
        <title>noise.stein</title>
        <meta>
            <authors>
                <author>André Sier</author>
            </authors>
            <description>
                <tr lang="en">Stein distribution</tr>
                <tr lang="ru">распределение Штейна</tr>
            </description>
            <license>%</license>
            <library>ceammc</library>
            <category>noise</category>
            <keywords>noise</keywords>
            <since>0.5</since>
        </meta>
        <info>
            <par>
                <tr lang="en">Stein distribution</tr>
                <tr lang="ru" finished="false">Распределение Stein</tr>
            </par>
        </info>
        <arguments>
            <argument name="ARG0" type="float">
                <tr lang="en">a value (optional)</tr>
                <tr lang="ru" finished="false">значение (факультативно)</tr>
            </argument>
            <argument name="ARG1" type="float">
                <tr lang="en">b value (optional)</tr>
                <tr lang="ru" finished="false">b значение (факультативно)</tr>
            </argument>
            <argument name="ARG2" type="float">
                <tr lang="en">x value (optional)</tr>
                <tr lang="ru" finished="false">x значение (необязательно)</tr>
            </argument>
            <argument name="ARG3" type="float">
                <tr lang="en">y value (optional)</tr>
                <tr lang="ru" finished="false">y значение (факультативно)</tr>
            </argument>
        </arguments>
        <methods>
            <!-- lambda -->
            <method name="lambda">
                <param name="LAMBDA" type="float" required="true">
                    <tr lang="en">lambda value</tr>
                    <tr lang="ru" finished="false">значение лямбда</tr>
                </param>
            </method>
            <!-- om -->
            <method name="om">
                <param name="OM" type="int" required="true">
                    <tr lang="en">enables output when cut or fold value is changed</tr>
                    <!-- old: позволяет вывод при изменении значения разреза
                    или сгиба -->
                    <tr lang="ru" finished="false">позволяет вывод при изменении значения разреза
                    или сгиба</tr>
                </param>
            </method>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset state</tr>
                    <tr lang="ru" finished="false">состояние сброса</tr>
                </info>
            </method>
            <!-- seed -->
            <method name="seed">
                <param name="SEED" type="float" required="true">
                    <tr lang="en">seed value</tr>
                    <tr lang="ru" finished="false">ценность</tr>
                </param>
            </method>
            <!-- set -->
            <method name="set">
                <param name="SET" type="float" required="true">
                    <tr lang="en">set to value</tr>
                    <tr lang="ru" finished="false">установить ценность</tr>
                </param>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="bang">
                    <tr lang="en">output value</tr>
                    <tr lang="ru" finished="false">выходная стоимость</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">main outlet</tr>
                    <tr lang="ru" finished="false">главный выход</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[metro 50 #metro]


  [T]         [F]
  |           |
  [om $1 #om( [set $1 #set( [reset #reset(

 [F]                     [F]
 |                       |
 [lambda $1 #lambda(     [seed $1 #seed(    

[noise.stein #noise-obj]
|
[ui.display {i=1,o=0}]

[X lambda:0->noise-obj:0]  
[X seed:0->noise-obj:0] 

[X om:0->noise-obj:0]
[X set:0->noise-obj:0]
[X reset:0->noise-obj:0]

[X metro->noise-obj]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
