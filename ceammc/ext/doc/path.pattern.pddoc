<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="path.pattern">
    <title>path.pattern</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">pattern filename generator</tr>
        <tr lang="ru">генерирует имя файла по заданному шаблону</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>path</category>
      <keywords>path environment pattern filename</keywords>
      <since>0.9.5</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object generates a new filename from a pattern, checking that the
        generated filename does not already exist</tr>
        <tr lang="ru">объект генерирует новое имя файла по шаблону и проверяет, что сгенерированное
        имя ещё не существует</tr>
      </par>
      <par>
        <tr lang="en">### in the pattern is replaced with a number</tr>
        <tr lang="ru">### в шаблоне заменяется числом</tr>
      </par>
      <par>
        <tr lang="en">the following variables in the pattern are expanded:</tr>
        <tr lang="ru">следующие переменные в шаблоне раскрываются:</tr>
      </par>
      <par>
        <tr lang="en">• %YEAR% — current year (4 digits)</tr>
        <tr lang="ru">• %YEAR% — текущий год (4 цифры)</tr>
      </par>
      <par>
        <tr lang="en">• %MONTH% — current month (2 digits)</tr>
        <tr lang="ru">• %MONTH% — текущий месяц (2 цифры)</tr>
      </par>
      <par>
        <tr lang="en">• %DAY% — current day (2 digits)</tr>
        <tr lang="ru">• %DAY% — текущий день (2 цифры)</tr>
      </par>
      <par>
        <tr lang="en">• %HOUR% — current hour (2 digits)</tr>
        <tr lang="ru">• %HOUR% — текущий час (2 цифры)</tr>
      </par>
      <par>
        <tr lang="en">• %MIN% — current minute (2 digits)</tr>
        <tr lang="ru">• %MIN% — текущая минута (2 цифры)</tr>
      </par>
      <par>
        <tr lang="en">• %SEC% — current second (2 digits)</tr>
        <tr lang="ru">• %SEC% — текущая секунда (2 цифры)</tr>
      </par>
      <par>
        <tr lang="en">• %TIME% — current time: %HOUR%-%MIN%-%SEC%</tr>
        <tr lang="ru">• %TIME% — текущее время: %HOUR%-%MIN%-%SEC%</tr>
      </par>
      <par>
        <tr lang="en">• %DATE% — current date: %YEAR%-%MONTH%-%DAY%</tr>
        <tr lang="ru">• %DATE% — текущая дата: %YEAR%-%MONTH%-%DAY%</tr>
      </par>
      <par>
        <tr lang="en">• %NOW% — current datetime: %DATE%_%TIME%</tr>
        <tr lang="ru">• %NOW% — текущие дата и время: %DATE%_%TIME%</tr>
      </par>
    </info>
    <arguments>
      <argument name="PATTERN" type="symbol">
        <tr lang="en">filename generation pattern</tr>
        <tr lang="ru">шаблон генерации имени файла</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @pattern -->
      <property name="@pattern" type="symbol" default="">
        <tr lang="en">filename pattern</tr>
        <tr lang="ru">шаблон имени файла</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output generated filename</tr>
          <tr lang="ru">вывести сгенерированное имя файла</tr>
        </in>
        <in on="symbol">
          <tr lang="en">set a new pattern and generate the filename</tr>
          <tr lang="ru">задать новый шаблон и сгенерировать имя файла</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="symbol">
          <tr lang="en">filename</tr>
          <tr lang="ru">имя файла</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[symbol file-###.wav(
|
|  [symbol ~/test-%NOW%.wav(
|  |
|  |  [bang(
|  |  |
[path.pattern]
|
[ui.dt @auto_size 0 @size 400 40]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
