<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="proto.morse">
        <title>proto.morse</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">Morse encoder</tr>
                <tr lang="ru">Морзе энкодер</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>proto</category>
            <keywords>morse proto</keywords>
            <since>0.9.7</since>
        </meta>
        <arguments>
            <argument name="DOT" type="float" units="millisecond" minvalue="5" maxvalue="1000">
                <tr lang="en">dot length</tr>
                <tr lang="ru" finished="false">длина точки</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @dot -->
            <property name="@dot" type="float" default="100" minvalue="5" maxvalue="1000"
            units="millisecond">
                <tr lang="en">dot length</tr>
                <tr lang="ru" finished="false">длина точки</tr>
            </property>
            <!-- @external -->
            <property name="@external" type="bool" default="0">
                <tr lang="en">use external clock</tr>
                <tr lang="ru" finished="false">Использование внешних часов</tr>
            </property>
            <!-- @letter -->
            <property name="@letter" type="int" default="3" minvalue="2" maxvalue="20">
                <tr lang="en">space between letters in dot units</tr>
                <tr lang="ru" finished="false">Пространство между буквами в точках</tr>
            </property>
            <!-- @word -->
            <property name="@word" type="int" default="5" minvalue="2" maxvalue="20">
                <tr lang="en">space between words in dot units</tr>
                <tr lang="ru" finished="false">Пространство между словами в точках</tr>
            </property>
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset encoder</tr>
                    <tr lang="ru" finished="false">кодировщик сброса</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">add words to encoder</tr>
                    <tr lang="ru" finished="false">Добавить слова в кодировку</tr>
                </in>
            </inlet>
            <inlet>
                <in on="bang">
                    <tr lang="en">external clock</tr>
                    <tr lang="ru" finished="false">Внешние часы</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">float: 1 or 0</tr>
                    <tr lang="ru" finished="false">Поплавок: 1 или 0</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[L]
|
| [reset(
| |
[proto.morse]
|
[lop~ 10] [osc~ 1000]
|         |.
[*~        ]
|
[ui.hgain~]      [ui.dsp~]
|\
[dac~]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
