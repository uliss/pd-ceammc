<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="math.sync_lt">
        <title>math.sync_lt</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">sync less than numbers compare</tr>
                <tr lang="ru">синхронная проверка на меньшее значение</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>math</category>
            <keywords>math sync less than</keywords>
            <aliases>
                <alias>math.&lt;'</alias>
                <alias>ceammc/&lt;'</alias>
                <alias>&lt;'</alias>
            </aliases>
            <since>0.8</since>
            <also>
                <see>math.&gt;'</see>
            </also>
        </meta>
        <arguments>
            <argument name="F" type="float">
                <tr lang="en">second number</tr>
                <tr lang="ru" finished="false">второе число</tr>
            </argument>
        </arguments>
        <inlets>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">set first number, calculate and output result</tr>
                    <!-- old: установить первое число, вычислить и получить
                    результат -->
                    <tr lang="ru" finished="false">установить первое число, вычислить и получить
                    результат</tr>
                </xinfo>
                <xinfo on="list">
                    <tr lang="en">pair: set first and second numbers, calculate and output
                    result</tr>
                    <!-- old: пара: установить первое и второе числа,
                    вычислить и вывести результат -->
                    <tr lang="ru" finished="false">пара: установить первое и второе числа,
                    вычислить и вывести результат</tr>
                </xinfo>
            </inlet>
            <inlet>
                <xinfo on="float">
                    <tr lang="en">change second number, calculate and output result</tr>
                    <!-- old: изменить второе число, вычислить и получить
                    результат -->
                    <tr lang="ru" finished="false">изменить второе число, вычислить и получить
                    результат</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">result output: 1 if first number is less then second, otherwise
                    0</tr>
                    <tr lang="ru" finished="false">выходной результат: 1 если первое число меньше
                    второго, то 0</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]   [F]   /*same as:*/ [F]  [F]
|     |                  |    |
|     |                  |    [t b f]
|     |.                 |    | ^|.
[<'    ]                 [<      ]
|                        |
[_]                      [_]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
