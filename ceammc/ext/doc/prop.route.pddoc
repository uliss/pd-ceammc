<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="prop.route">
    <title>prop.route</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">separates properties from the dataflow</tr>
        <tr lang="ru">отделяет свойства от основного потока данных</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>property</category>
      <keywords>property</keywords>
      <since>0.9</since>
      <aliases>
        <alias>prop-&gt;</alias>
        <alias>@-&gt;</alias>
        <alias>ceammc/prop-&gt;</alias>
        <alias>ceammc/@-&gt;</alias>
        <alias deprecated="true">prop.split</alias>
      </aliases>
      <also>
        <see>prop&lt;-</see>
        <see>prop.route~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object extracts properties from the data stream by matching. Non-property
        values are passed through untouched to the first outlet</tr>
        <tr lang="ru">объект извлекает свойства из потока данных по совпадению. Значения, не
        являющиеся свойствами, проходят без изменений на первый выход</tr>
      </par>
      <par>
        <tr lang="en">each matched property is output from its own outlet without the property
        selector, unmatched properties are output from the last outlet with the selector
        preserved</tr>
        <tr lang="ru">каждое совпавшее свойство выводится со своего выхода без селектора свойства,
        несовпавшие свойства выводятся с последнего выхода с сохранением селектора</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="any">
          <tr lang="en">input values</tr>
          <tr lang="ru">входные значения</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet>
        <out type="any">
          <tr lang="en">passed values</tr>
          <tr lang="ru">переданные значения</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">first matched property value (without the property selector)</tr>
          <tr lang="ru">значение первого совпавшего свойства (без селектора свойства)</tr>
        </out>
      </outlet>
      <outlet number="...">
        <out type="any">
          <tr lang="en">other matched property values</tr>
          <tr lang="ru">значения других совпавших свойств</tr>
        </out>
      </outlet>
      <outlet number="n">
        <out type="any">
          <tr lang="en">unmatched property output (with selector)</tr>
          <tr lang="ru">выход несовпавших свойств (с селектором)</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
          [any value(
          |
[F]       |   [@prop1 a b c(   [@oth 1 2 3 4(
|         |   |                |
|  [B]    |   | [@prop1 2(     |
|  |      |   | |              |
|  |      |   | |              |
|  |      |   | |              |
[prop-> @prop1                  ]
|     ^|   ^^|
|     |      [ui.dt]
|     |
|    [ui.dt]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
