<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
    <object name="prop.route">
        <title>prop.route</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">separates properties from the dataflow</tr>
                <tr lang="ru">отделяет свойства от основного потока данных</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>property</category>
            <keywords>property</keywords>
            <since>0.9</since>
            <aliases>
                <alias>prop-&gt;</alias>
                <alias>@-&gt;</alias>
                <alias>ceammc/prop-&gt;</alias>
                <alias>ceammc/@-&gt;</alias>
                <alias deprecated="true">prop.split</alias>
            </aliases>
            <also>
                <see>prop&lt;-</see>
                <see>prop.route~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Extracts properties from data stream with matching. Non property
                values are passed untouched</tr>
                <tr lang="ru" finished="false">Извлекает свойства из потока данных с помощью
                сопоставления. Неимущественные ценности передаются нетронутым</tr>
            </par>
        </info>
        <inlets>
            <inlet>
                <in on="any">
                    <tr lang="en">input values</tr>
                    <tr lang="ru" finished="false">входные значения</tr>
                </in>
            </inlet>
        </inlets>
        <outlets dynamic="true">
            <outlet>
                <out type="any">
                    <tr lang="en">passed values</tr>
                    <tr lang="ru" finished="false">переданные значения</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">first matched property value (without property selector)</tr>
                    <tr lang="ru" finished="false">первая соответствующая стоимость недвижимости
                    (без выбора недвижимости)</tr>
                </out>
            </outlet>
            <outlet number="...">
                <out type="any">
                    <tr lang="en">others matched property value</tr>
                    <tr lang="ru" finished="false">Другие соответствуют стоимости недвижимости</tr>
                </out>
            </outlet>
            <outlet number="n">
                <out type="any">
                    <tr lang="en">unmatched property output (with selector)</tr>
                    <tr lang="ru" finished="false">непревзойденный выход свойств (с
                    селектором)</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
          [any value(
          |
[F]       |   [@prop1 a b c(   [@oth 1 2 3 4(
|         |   |                |
|  [B]    |   | [@prop1 2(     |
|  |      |   | |              |
|  |      |   | |              |
|  |      |   | |              |
[prop-> @prop1                  ]
|     ^|   ^^|
|     |      [ui.dt]
|     |
|    [ui.dt]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
