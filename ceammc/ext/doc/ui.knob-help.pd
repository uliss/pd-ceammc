#X msg 130 684 @active_scale;
#X text 270 684 Get/Set if should draw active scale. Type: bool. Default
value: 0\.;
#X msg 130 726 @max;
#X text 270 726 Get/Set maximum knob value. Type: float. Default value:
1\.;
#X msg 130 756 @min;
#X text 270 756 Get/Set minimum knob value. Type: float. Default value:
0\.;
#X msg 130 786 @mouse_events;
#X text 270 786 Get/Set mouse events output mode. If on outputs @mouse_down
\, @mouse_up and @mouse_drag events. Type: bool. Default value: 0\.;
#X msg 130 843 @receive;
#X text 270 843 Get/Set source of message receive. Type: symbol. Default
value: (null).;
#X msg 130 885 @scale;
#X text 270 885 Get/Set scale mode. Linear or logarithmic. Type: symbol.
Default value: linear. Allowed values: linear \, log.;
#X msg 130 927 @send;
#X text 270 927 Get/Set address for sending messages. Type: symbol.
Default value: (null).;
#X msg 130 969 @show_range;
#X text 270 969 Get/Set show knob range. Type: bool. Default value:
0\.;
#X msg 130 999 @show_value;
#X text 270 999 Get/Set show value. Type: bool. Default value: 0\.;
#X msg 130 1029 @value;
#X text 270 1029 Get/Set current value. Type: float. Default value:
0\.;
#X msg 130 1059 @midi_channel;
#X text 270 1059 Get/Set MIDI channel binding. If set to 0 \, it binds
to all channels. The values in the range [1\..16] are mapped to the
channels of the first Pd MIDI device \, [17\..32] to the channels of
the second \, and so on. Type: int. Default value: 0\. Range: 0\...255\.;
#X msg 130 1162 @midi_control;
#X text 270 1162 Get/Set binded MIDI controller number. -1 means not
binded to any controller. Type: int. Default value: -1\. Range: -1\...127\.;
#X msg 130 1219 @midi_pickup;
#X text 270 1219 Get/Set pickup current value. If slider is binded
to value \, first time you should pass over this value to make binding.
It prevents from sudden value change on first control change. Type:
bool. Default value: 1\.;
#X msg 130 1306 @background_color;
#X text 270 1306 Get/Set element background color (list of red \, green
\, blue values in 0-1 range). Type: list. Default value: 0.93 0.93
0.93 1\.;
#X msg 130 1363 @border_color;
#X text 270 1363 Get/Set border color (list of red \, green \, blue
values in 0-1 range). Type: list. Default value: 0.6 0.6 0.6 1\.;
#X msg 130 1405 @knob_color;
#X text 270 1405 Get/Set knob color (list of red \, green \, blue values
in 0-1 range). Type: list. Default value: 0 0.75 1 1\.;
#X msg 130 1447 @scale_color;
#X text 270 1447 Get/Set scale color (list of red \, green \, blue
values in 0-1 range). Type: list. Default value: 0.6 0.6 0.6 1\.;
#X msg 130 1489 @label;
#X text 270 1489 Get/Set label text. Type: symbol. Default value: (null).;
#X msg 130 1519 @label_align;
#X text 270 1519 Get/Set label horizontal align. Type: symbol. Default
value: left. Allowed values: left \, center \, right.;
#X msg 130 1561 @label_inner;
#X text 270 1561 Get/Set label position (1 - inner \, 0 - outer). Type:
bool. Default value: 0\.;
#X msg 130 1603 @label_margins;
#X text 270 1603 Get/Set label X Y offset in pixels. Type: list. Default
value: 0 0\.;
#X msg 130 1645 @label_side;
#X text 270 1645 Get/Set label attachment side. Type: symbol. Default
value: top. Allowed values: left \, top \, right \, bottom.;
#X msg 130 1687 @label_valign;
#X text 270 1687 Get/Set label vertical align. Type: symbol. Default
value: top. Allowed values: top \, center \, bottom.;
#X msg 130 1729 @fontname;
#X text 270 1729 Get/Set font name. Type: symbol. Default value: Helvetica.
Allowed values: Courier \, DejaVu \, Helvetica \, Monaco \, Times.;
#X msg 130 1771 @fontsize;
#X text 270 1771 Get/Set font size. Type: int. Default value: 11\.
