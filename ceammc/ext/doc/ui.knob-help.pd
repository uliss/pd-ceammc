#X msg 110 772 @active_scale;
#X text 245 772 Get/Set if should draw active scale. Type: bool. Default
value: 0\.;
#X msg 110 814 @max;
#X text 245 814 Get/Set maximum knob value. Type: float. Default value:
1\.;
#X msg 110 844 @min;
#X text 245 844 Get/Set minimum knob value. Type: float. Default value:
0\.;
#X msg 110 874 @mouse_events;
#X text 245 874 Get/Set mouse events output mode. If on outputs @mouse_down
\, @mouse_up and @mouse_drag events. Type: bool. Default value: 0\.;
#X msg 110 931 @receive;
#X text 245 931 Get/Set source of message receive. Type: symbol. Default
value: (null).;
#X msg 110 973 @scale;
#X text 245 973 Get/Set scale mode. Linear or logarithmic. Type: symbol.
Default value: linear. Allowed values: linear \, log.;
#X msg 110 1015 @send;
#X text 245 1015 Get/Set address for sending messages. Type: symbol.
Default value: (null).;
#X msg 110 1057 @show_range;
#X text 245 1057 Get/Set show knob range. Type: bool. Default value:
0\.;
#X msg 110 1087 @show_value;
#X text 245 1087 Get/Set show value. Type: bool. Default value: 0\.;
#X msg 110 1117 @value;
#X text 245 1117 Get/Set current value. Type: float. Default value:
0\.;
#X msg 110 1147 @midi_channel;
#X text 245 1147 Get/Set MIDI channel binding. If set to 0 \, it binds
to all channels. The values in the range [1\..16] are mapped to the
channels of the first Pd MIDI device \, [17\..32] to the channels of
the second \, and so on. Type: int. Default value: 0\. Range: 0\...255\.;
#X msg 110 1250 @midi_control;
#X text 245 1250 Get/Set binded MIDI controller number. -1 means not
binded to any controller. Type: int. Default value: -1\. Range: -1\...127\.;
#X msg 110 1307 @midi_pickup;
#X text 245 1307 Get/Set pickup current value. If slider is binded
to value \, first time you should pass over this value to make binding.
It prevents from sudden value change on first control change. Type:
bool. Default value: 1\.;
#X msg 110 1394 @background_color;
#X text 245 1394 Get/Set element background color (list of red \, green
\, blue values in 0-1 range). Type: list. Default value: 0.93 0.93
0.93 1\.;
#X msg 110 1451 @border_color;
#X text 245 1451 Get/Set border color (list of red \, green \, blue
values in 0-1 range). Type: list. Default value: 0.6 0.6 0.6 1\.;
#X msg 110 1493 @knob_color;
#X text 245 1493 Get/Set knob color (list of red \, green \, blue values
in 0-1 range). Type: list. Default value: 0 0.75 1 1\.;
#X msg 110 1535 @scale_color;
#X text 245 1535 Get/Set scale color (list of red \, green \, blue
values in 0-1 range). Type: list. Default value: 0.6 0.6 0.6 1\.;
#X msg 110 1577 @label;
#X text 245 1577 Get/Set label text. Type: symbol. Default value: (null).;
#X msg 110 1607 @label_align;
#X text 245 1607 Get/Set label horizontal align. Type: symbol. Default
value: left. Allowed values: left \, center \, right.;
#X msg 110 1649 @label_inner;
#X text 245 1649 Get/Set label position (1 - inner \, 0 - outer). Type:
bool. Default value: 0\.;
#X msg 110 1691 @label_margins;
#X text 245 1691 Get/Set label X Y offset in pixels. Type: list. Default
value: 0 0\.;
#X msg 110 1733 @label_side;
#X text 245 1733 Get/Set label attachment side. Type: symbol. Default
value: top. Allowed values: left \, top \, right \, bottom.;
#X msg 110 1775 @label_valign;
#X text 245 1775 Get/Set label vertical align. Type: symbol. Default
value: top. Allowed values: top \, center \, bottom.;
#X msg 110 1817 @fontname;
#X text 245 1817 Get/Set font name. Type: symbol. Default value: Helvetica.
Allowed values: Courier \, DejaVu \, Helvetica \, Monaco \, Times.;
#X msg 110 1859 @fontsize;
#X text 245 1859 Get/Set font size. Type: int. Default value: 11\.
Range: 4\...100\.;
#X msg 110 1901 @fontslant;
#X text 245 1901 Get/Set font slant. Type: symbol. Default value: roman.
Allowed values: roman \, italic.;
#X msg 110 1943 @fontweight;
#X text 245 1943 Get/Set font weight. Type: symbol. Default value:
normal. Allowed values: normal \, bold.;
#X msg 110 1985 @pinned;
#X text 245 1985 Get/Set pin mode. If set to 1 \, it places the element
at the furthest level on the canvas behind other elements. Type: bool.
Default value: 0\.;
#X msg 110 2042 @presetname;
#X text 245 2042 Get/Set preset name for using with [ui.preset] or
[preset.storage] objects. Type: symbol. Default value: (null).;
#X msg 110 2099 @size;
#X text 245 2099 Get/Set object size (width \, height pair). Type:
list. Default value: 40 40\.;
