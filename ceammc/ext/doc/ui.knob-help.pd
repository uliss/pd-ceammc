#X msg 110 1286 @border_color;
#X text 245 1286 Get/Set border color (list of red \, green \, blue
values in 0-1 range). Type: list. Default value: 0.6 0.6 0.6 1\.;
#X msg 110 1328 @knob_color;
#X text 245 1328 Get/Set knob color (list of red \, green \, blue values
