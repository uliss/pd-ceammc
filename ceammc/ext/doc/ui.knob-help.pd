#X msg 110 1881 @fontslant;
#X text 245 1881 Get/Set font slant. Type: symbol. Default value: roman.
Allowed values: roman \, italic.;
#X msg 110 1923 @fontweight;
#X text 245 1923 Get/Set font weight. Type: symbol. Default value:
