#X msg 110 752 @active_scale;
#X text 245 752 Get/Set if should draw active scale. Type: bool. Default
value: 0\.;
#X msg 110 794 @max;
#X text 245 794 Get/Set maximum knob value. Type: float. Default value:
1\.;
#X msg 110 824 @min;
#X text 245 824 Get/Set minimum knob value. Type: float. Default value:
0\.;
#X msg 110 854 @mouse_events;
#X text 245 854 Get/Set mouse events output mode. If on outputs @mouse_down
\, @mouse_up and @mouse_drag events. Type: bool. Default value: 0\.;
#X msg 110 911 @receive;
#X text 245 911 Get/Set source of message receive. Type: symbol. Default
value: (null).;
#X msg 110 953 @scale;
#X text 245 953 Get/Set scale mode. Linear or logarithmic. Type: symbol.
Default value: linear. Allowed values: linear \, log.;
#X msg 110 995 @send;
#X text 245 995 Get/Set address for sending messages. Type: symbol.
Default value: (null).;
#X msg 110 1037 @show_range;
#X text 245 1037 Get/Set show knob range. Type: bool. Default value:
0\.;
#X msg 110 1067 @show_value;
#X text 245 1067 Get/Set show value. Type: bool. Default value: 0\.;
#X msg 110 1097 @value;
#X text 245 1097 Get/Set current value. Type: float. Default value:
0\.;
#X msg 110 1127 @midi_channel;
#X text 245 1127 Get/Set MIDI channel binding. If set to 0 \, it binds
to all channels. The values in the range [1\..16] are mapped to the
channels of the first Pd MIDI device \, [17\..32] to the channels of
the second \, and so on. Type: int. Default value: 0\. Range: 0\...255\.;
#X msg 110 1230 @midi_control;
#X text 245 1230 Get/Set binded MIDI controller number. -1 means not
binded to any controller. Type: int. Default value: -1\. Range: -1\...127\.;
#X msg 110 1287 @midi_pickup;
#X text 245 1287 Get/Set pickup current value. If slider is binded
to value \, first time you should pass over this value to make binding.
It prevents from sudden value change on first control change. Type:
bool. Default value: 1\.;
#X msg 110 1374 @background_color;
#X text 245 1374 Get/Set element background color (list of red \, green
\, blue values in 0-1 range). Type: list. Default value: 0.93 0.93
0.93 1\.;
#X msg 110 1431 @border_color;
#X text 245 1431 Get/Set border color (list of red \, green \, blue
values in 0-1 range). Type: list. Default value: 0.6 0.6 0.6 1\.;
#X msg 110 1473 @knob_color;
#X text 245 1473 Get/Set knob color (list of red \, green \, blue values
in 0-1 range). Type: list. Default value: 0 0.75 1 1\.;
#X msg 110 1515 @scale_color;
#X text 245 1515 Get/Set scale color (list of red \, green \, blue
values in 0-1 range). Type: list. Default value: 0.6 0.6 0.6 1\.;
#X msg 110 1557 @label;
#X text 245 1557 Get/Set label text. Type: symbol. Default value: (null).;
#X msg 110 1587 @label_align;
#X text 245 1587 Get/Set label horizontal align. Type: symbol. Default
value: left. Allowed values: left \, center \, right.;
#X msg 110 1629 @label_inner;
#X text 245 1629 Get/Set label position (1 - inner \, 0 - outer). Type:
