#X msg 110 1965 @pinned;
#X text 245 1965 Get/Set pin mode. If set to 1 \, it places the element
at the furthest level on the canvas behind other elements. Type: bool.
Default value: 0\.;
#X msg 110 2022 @presetname;
#X text 245 2022 Get/Set preset name for using with [ui.preset] or
