<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="flt.biquad~">
        <title>flt.biquad~</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">second order IIR filter</tr>
                <tr lang="ru">БИХ фильтр второго порядка</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>flt</category>
            <keywords>filter biquad</keywords>
            <since>0.1</since>
            <also>
                <see>flt.c_bpf~</see>
                <see>flt.c_hpf~</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Digital biquad filter is a second-order recursive linear filter,
                containing two poles and two zeros.</tr>
                <!-- old: Цифровой биквад-фильтр представляет собой
                рекурсивный линейный фильтр второго порядка, содержащий два полюса и два нуля. -->
                <tr lang="ru" finished="false">Цифровой биквад-фильтр представляет собой
                рекурсивный линейный фильтр второго порядка, содержащий два полюса и два нуля.</tr>
            </par>
            <par>
                <tr lang="en">transfer function: H(z)=(b0 + b1*z⁻¹ + b2*z⁻²)/(1 + a1*z⁻¹ +
                a2*z⁻²)</tr>
                <!-- old: передаточная функция: H(z)=(b0 + b1*z−1 + b2*z−2)/(1
                + a1*z−1 + a2*z−2) -->
                <tr lang="ru" finished="false">передаточная функция: H(z)=(b0 + b1*z−1 + b2*z−2)/(1
                + a1*z−1 + a2*z−2)</tr>
            </par>
            <a href="https://en.wikipedia.org/wiki/Digital_biquad_filter">wiki: Digital biquad
            filter</a>
        </info>
        <properties>
            <xi:include href="props_active.xml" />
        </properties>
        <methods>
            <!-- reset -->
            <method name="reset">
                <info>
                    <tr lang="en">reset filter state</tr>
                    <tr lang="ru" finished="false">состояние фильтра сброса</tr>
                </info>
            </method>
        </methods>
        <inlets>
            <inlet type="audio">
                <in>
                    <tr lang="en">input signal</tr>
                    <tr lang="ru" finished="false">входной сигнал</tr>
                </in>
            </inlet>
            <inlet type="audio">
                <in>
                    <tr lang="en">b0</tr>
                    <tr lang="ru" finished="false">b0</tr>
                </in>
            </inlet>
            <inlet type="audio">
                <in>
                    <tr lang="en">b1</tr>
                    <tr lang="ru" finished="false">b1</tr>
                </in>
            </inlet>
            <inlet type="audio">
                <in>
                    <tr lang="en">b2</tr>
                    <tr lang="ru" finished="false">b2</tr>
                </in>
            </inlet>
            <inlet type="audio">
                <in>
                    <tr lang="en">a1</tr>
                    <tr lang="ru" finished="false">а1</tr>
                </in>
            </inlet>
            <inlet type="audio">
                <in>
                    <tr lang="en">a2</tr>
                    <tr lang="ru" finished="false">а2</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet type="audio">
                <out type="any">
                    <tr lang="en">filtered signal</tr>
                    <tr lang="ru" finished="false">фильтрованный сигнал</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[bang #z( [0.5 0 0.5( [0.5 0 0 -0.5 0.25( [0.5 0.5(
|         |           |                   |
[click~]  [nsig~ 5 #a {i=1,o=5}           ]
|
|
|
[flt.biquad~ #b]
|
[plot.response~ #r]
|  ^|.        ^^|..
[ui.plot~ @size 400 165 @n 2 #p]











[ui.dsp~]
[X a:0->b:1] [X a:1->b:2] [X a:2->b:3] [X a:3->b:4] [X a:4->b:5]
[X z->r:1]
#a 0.5 0.5
#p @ymin -1.6 @ymax 1.6 @ylabels 1 @xlabels 1 @ymin_ticks 0
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
