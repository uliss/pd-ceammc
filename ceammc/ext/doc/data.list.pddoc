<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="data.list">
    <title>data.list</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">the list container</tr>
        <tr lang="ru">список</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>data</category>
      <keywords>data list</keywords>
      <since>0.1</since>
      <also>
        <see>data.fifo</see>
      </also>
    </meta>
    <mouse>
      <event type="left-click" editmode="false">open data editor</event>
    </mouse>
    <arguments>
      <argument name="VALUE" type="list">
        <tr lang="en">initial list values</tr>
        <tr lang="ru">начальные значения списка</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @empty -->
      <property name="@empty" type="bool" access="readonly" default="1">
        <tr lang="en">1 if the list is empty, otherwise 0</tr>
        <tr lang="ru">1, если список пуст, иначе 0</tr>
      </property>
      <!-- @size -->
      <property name="@size" type="int" access="readonly" minvalue="0" default="0">
        <tr lang="en">number of elements in the list</tr>
        <tr lang="ru">количество элементов в списке</tr>
      </property>
      <!-- @value -->
      <property name="@value" type="list" default="">
        <tr lang="en">current value</tr>
        <tr lang="ru">текущее значение</tr>
      </property>
    </properties>
    <methods>
      <!-- append -->
      <method name="append">
        <info>
          <tr lang="en">adds values to the end of the list</tr>
          <tr lang="ru">добавляет значения в конец списка</tr>
        </info>
        <param name="VAL" type="atom" required="true">
          <tr lang="en">appended value</tr>
          <tr lang="ru">добавляемое значение</tr>
        </param>
      </method>
      <!-- at -->
      <method name="at">
        <info>
          <tr lang="en">outputs the atom at the specified position</tr>
          <tr lang="ru">выводит атом в указанной позиции</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">position (negative indexes are supported: -1 means the last element)</tr>
          <tr lang="ru">позиция (поддерживаются отрицательные индексы: -1 означает последний
          элемент)</tr>
        </param>
      </method>
      <!-- back -->
      <method name="back">
        <info>
          <tr lang="en">output the last list element</tr>
          <tr lang="ru">вывести последний элемент списка</tr>
        </info>
      </method>
      <!-- choose -->
      <method name="choose">
        <info>
          <tr lang="en">choose a random element in the list and output it</tr>
          <tr lang="ru">выбрать случайный элемент списка и вывести его</tr>
        </info>
      </method>
      <!-- clear -->
      <method name="clear">
        <info>
          <tr lang="en">removes all list elements</tr>
          <tr lang="ru">удаляет все элементы списка</tr>
        </info>
      </method>
      <!-- dump -->
      <method name="dump">
        <info>
          <tr lang="en">dump object info to the Pd window</tr>
          <tr lang="ru">вывести информацию об объекте в окно Pd</tr>
        </info>
      </method>
      <!-- fill -->
      <method name="fill">
        <info>
          <tr lang="en">fills the list with the specified value</tr>
          <tr lang="ru">заполняет список заданным значением</tr>
        </info>
        <param name="VAL" type="atom" required="true">
          <tr lang="en">fill value</tr>
          <tr lang="ru">значение для заполнения</tr>
        </param>
      </method>
      <!-- front -->
      <method name="front">
        <info>
          <tr lang="en">output the first list element</tr>
          <tr lang="ru">вывести первый элемент списка</tr>
        </info>
      </method>
      <!-- insert -->
      <method name="insert">
        <info>
          <tr lang="en">inserts values at the specified position</tr>
          <tr lang="ru">вставляет значения в указанную позицию</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">insert position</tr>
          <tr lang="ru">позиция вставки</tr>
        </param>
        <param name="VAL" type="atom" required="true">
          <tr lang="en">value</tr>
          <tr lang="ru">значение</tr>
        </param>
      </method>
      <!-- pop -->
      <method name="pop">
        <info>
          <tr lang="en">removes the last list element</tr>
          <tr lang="ru">удаляет последний элемент списка</tr>
        </info>
      </method>
      <!-- prepend -->
      <method name="prepend">
        <info>
          <tr lang="en">inserts values at the beginning of the list</tr>
          <tr lang="ru">вставляет значения в начало списка</tr>
        </info>
        <param name="VAL" type="atom" required="true">
          <tr lang="en">prepended value</tr>
          <tr lang="ru">добавляемое значение</tr>
        </param>
      </method>
      <!-- remove -->
      <method name="remove">
        <info>
          <tr lang="en">removes the specified element</tr>
          <tr lang="ru">удаляет указанный элемент</tr>
        </info>
        <param name="IDX" type="int" required="true">
          <tr lang="en">element index</tr>
          <tr lang="ru">индекс элемента</tr>
        </param>
      </method>
      <!-- reverse -->
      <method name="reverse">
        <info>
          <tr lang="en">reverses the list</tr>
          <tr lang="ru">обращает порядок элементов списка</tr>
        </info>
      </method>
      <!-- set -->
      <method name="set">
        <info>
          <tr lang="en">sets a new list without output</tr>
          <tr lang="ru">устанавливает новый список без вывода</tr>
        </info>
        <param name="LIST" type="list" required="true">
          <tr lang="en">new list content</tr>
          <tr lang="ru">новое содержимое списка</tr>
        </param>
      </method>
      <!-- shuffle -->
      <method name="shuffle">
        <info>
          <tr lang="en">puts elements in random order</tr>
          <tr lang="ru">располагает элементы в случайном порядке</tr>
        </info>
      </method>
      <!-- sort -->
      <method name="sort">
        <info>
          <tr lang="en">sorts the list</tr>
          <tr lang="ru">сортирует список</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">output list content</tr>
          <tr lang="ru">вывести содержимое списка</tr>
        </in>
        <in on="float">
          <tr lang="en">outputs the list element at the specified position. Negative indexes are
          supported</tr>
          <tr lang="ru">выводит элемент списка в указанной позиции. Поддерживаются отрицательные
          индексы</tr>
        </in>
        <in on="symbol">
          <tr lang="en">set a new list with a single symbol element and output</tr>
          <tr lang="ru">установить новый список с одним символьным элементом и вывести</tr>
        </in>
        <in on="list">
          <tr lang="en">set new list content and output</tr>
          <tr lang="ru">установить новое содержимое списка и вывести</tr>
        </in>
        <in on="data:mlist">
          <tr lang="en">same as list</tr>
          <tr lang="ru">то же, что и list</tr>
        </in>
      </inlet>
      <inlet>
        <in on="list">
          <tr lang="en">sets a new list without output</tr>
          <tr lang="ru">устанавливает новый список без вывода</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output list or list elements</tr>
          <tr lang="ru">вывод списка или элементов списка</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[dump( [list a b c(  [F]        [10 11(
|      |             |          |
| [B]  |  [pop(      [m append] [m insert 1]
| |    |  |          |          |
| |    |  |          |          |
| |    |  |          |          |
[data.list                  1 2 3]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
