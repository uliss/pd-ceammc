<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="color.scale">
        <title>color.scale</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">creation of the color scale</tr>
                <tr lang="ru">создание цветовой шкалы</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>data</category>
            <keywords>data color scale</keywords>
            <since>0.9.7</since>
        </meta>
        <arguments>
            <argument name="SCALE" type="list">
                <tr lang="en">color list</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @color -->
            <property name="@color" type="alias">
                <tr lang="en">alias to @mode color</tr>
            </property>
            <!-- @hex -->
            <property name="@hex" type="alias">
                <tr lang="en">alias to @mode hex</tr>
            </property>
            <!-- @interp -->
            <property name="@interp" type="symbol" default="none" enum="none short long inc dec">
                <tr lang="en">hue interpolation strategy</tr>
            </property>
            <!-- @mode -->
            <property name="@mode" type="symbol" default="color" enum="color hex rgb">
                <tr lang="en">output mode: if 'color' - output as data:color type, if 'hex' -
                output as hex value, if 'rgb' - RGB list</tr>
            </property>
            <!-- @rgb -->
            <property name="@rgb" type="alias">
                <tr lang="en">alias to @mode rgb</tr>
            </property>
            <!-- @scale -->
            <property name="@scale" type="list" default="">
                <tr lang="en">color list</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float" minvalue="0" maxvalue="1">calculate color scale hue and
                output</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>data:color output</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[ui.hsl @show_value 1]     [ui.tab none short long inc dec @size 200 15]
|                          |
|                          [@interp $2(
|                          |
[color.scale Color(red) Color(blue) Color(yellow)]
|
[color->rgba @pack @float]
|
[@background_color $1 $2 $3(
|
[ui.hsl @nosave 1]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
