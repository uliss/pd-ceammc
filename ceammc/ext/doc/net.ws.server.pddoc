<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="net.ws.server">
    <title>net.ws.server</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">WebSocket server</tr>
        <tr lang="ru">WebSocket-сервер</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>net</category>
      <keywords>websocket net server</keywords>
      <since>0.9.8</since>
      <also>
        <see>net.ws.client</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">WebSocket is a protocol that provides full-duplex communication channels over
        a single TCP connection, widely used in web applications for real-time data exchange</tr>
        <tr lang="ru">WebSocket — протокол, обеспечивающий полнодуплексную передачу данных по
        одному TCP-соединению, широко используется в веб-приложениях для обмена данными в реальном
        времени</tr>
      </par>
      <par>
        <tr lang="en">the object starts a WebSocket server, accepts client connections and
        exchanges text, binary or JSON messages with them</tr>
        <tr lang="ru">объект запускает WebSocket-сервер, принимает подключения клиентов и
        обменивается с ними текстовыми, бинарными или JSON-сообщениями</tr>
      </par>
      <par>
        <tr lang="en">the second outlet outputs the list CLIENT_ID CLIENT_ADDR when a client
        connects or disconnects</tr>
        <tr lang="ru">второй выход выдаёт список CLIENT_ID CLIENT_ADDR при подключении или
        отключении клиента</tr>
      </par>
      <par>
        <tr lang="en">most methods take a TARGET selector to address one, all or a subset of
        clients</tr>
        <tr lang="ru">большинство методов принимают селектор TARGET для адресации одного, всех или
        части клиентов</tr>
      </par>
    </info>
    <properties>
      <!-- @mode -->
      <property name="@mode" type="symbol" default="fudi" enum="data fudi json sym">
        <tr lang="en">parsing mode for incoming client messages. If "fudi" — interpret incoming
        websocket data as Pd messages, if "sym" — always interpret as symbols, "data" — parse
        ceammc data, "json" — convert JSON values to ceammc data</tr>
        <tr lang="ru">режим разбора входящих сообщений клиента. Если "fudi" — интерпретировать
        входящие данные websocket как Pd-сообщения, если "sym" — всегда интерпретировать как
        символы, "data" — разбирать данные ceammc, "json" — преобразовывать значения JSON в данные
        ceammc</tr>
      </property>
    </properties>
    <methods>
      <!-- clients -->
      <method name="clients">
        <info>
          <tr lang="en">output connected clients as list CLIENT_ID CLIENT_ADDR... etc.</tr>
          <tr lang="ru">вывести подключённых клиентов в виде списка CLIENT_ID CLIENT_ADDR и
          т.д.</tr>
        </info>
      </method>
      <!-- close -->
      <method name="close">
        <info>
          <tr lang="en">gracefully close connection with specified client(s)</tr>
          <tr lang="ru">корректно закрыть соединение с указанным клиентом (клиентами)</tr>
        </info>
        <param name="TARGET" type="symbol" required="true" enum="* all first last id == != except">
          <tr lang="en">client selector. If '*' or 'all' — send message to all clients. If 'first'
          — send message to the first connected client. If 'last' — send message to the last
          connected client. If 'id' or '==' — send message to the client with the specified ID. If
          'except' or '!=' — send message to all clients except the specified one.</tr>
          <tr lang="ru">селектор клиента. Если '*' или 'all' — отправить сообщение всем клиентам.
          Если 'first' — отправить сообщение первому подключённому клиенту. Если 'last' — отправить
          сообщение последнему подключённому клиенту. Если 'id' или '==' — отправить сообщение
          клиенту с указанным ID. Если 'except' или '!=' — отправить сообщение всем клиентам, кроме
          указанного.</tr>
        </param>
        <param name="ID" type="int" required="false">
          <tr lang="en">client ID. Required, if client selector is one of: 'id', '==', '!=' or
          'except'.</tr>
          <tr lang="ru">ID клиента. Требуется, если селектор клиента — один из: 'id', '==', '!='
          или 'except'.</tr>
        </param>
      </method>
      <!-- listen -->
      <method name="listen">
        <info>
          <tr lang="en">start/stop websocket server</tr>
          <tr lang="ru">запустить/остановить websocket-сервер</tr>
        </info>
        <param name="PORT" type="int" minvalue="0" required="true">
          <tr lang="en">listening port. If 0 — stops the server.</tr>
          <tr lang="ru">порт прослушивания. Если 0 — останавливает сервер.</tr>
        </param>
        <param name="ADDR" type="symbol" required="false">
          <tr lang="en">listening address. If not specified — using 0.0.0.0 (all network
          interfaces)</tr>
          <tr lang="ru">адрес прослушивания. Если не указан — используется 0.0.0.0 (все сетевые
          интерфейсы)</tr>
        </param>
      </method>
      <!-- ping -->
      <method name="ping">
        <info>
          <tr lang="en">send ping message to specified client(s)</tr>
          <tr lang="ru">отправить ping-сообщение указанному клиенту (клиентам)</tr>
        </info>
        <param name="TARGET" type="symbol" required="true" enum="* all first last id == != except">
          <tr lang="en">client selector. If '*' or 'all' — send message to all clients. If 'first'
          — send message to the first connected client. If 'last' — send message to the last
          connected client. If 'id' or '==' — send message to the client with the specified ID. If
          'except' or '!=' — send message to all clients except the specified one.</tr>
          <tr lang="ru">селектор клиента. Если '*' или 'all' — отправить сообщение всем клиентам.
          Если 'first' — отправить сообщение первому подключённому клиенту. Если 'last' — отправить
          сообщение последнему подключённому клиенту. Если 'id' или '==' — отправить сообщение
          клиенту с указанным ID. Если 'except' или '!=' — отправить сообщение всем клиентам, кроме
          указанного.</tr>
        </param>
        <param name="ID" type="int" required="false">
          <tr lang="en">client ID. Required, if client selector is one of: 'id', '==', '!=' or
          'except'.</tr>
          <tr lang="ru">ID клиента. Требуется, если селектор клиента — один из: 'id', '==', '!='
          или 'except'.</tr>
        </param>
        <param name="DATA" type="list" required="false">
          <tr lang="en">list of integers in [0..255] range</tr>
          <tr lang="ru">список целых чисел в диапазоне [0..255]</tr>
        </param>
      </method>
      <!-- send -->
      <method name="send">
        <info>
          <tr lang="en">send as text message to specified client(s)</tr>
          <tr lang="ru">отправить как текстовое сообщение указанному клиенту (клиентам)</tr>
        </info>
        <param name="TARGET" type="symbol" required="true" enum="* all first last id == != except">
          <tr lang="en">client selector. If '*' or 'all' — send message to all clients. If 'first'
          — send message to the first connected client. If 'last' — send message to the last
          connected client. If 'id' or '==' — send message to the client with the specified ID. If
          'except' or '!=' — send message to all clients except the specified one.</tr>
          <tr lang="ru">селектор клиента. Если '*' или 'all' — отправить сообщение всем клиентам.
          Если 'first' — отправить сообщение первому подключённому клиенту. Если 'last' — отправить
          сообщение последнему подключённому клиенту. Если 'id' или '==' — отправить сообщение
          клиенту с указанным ID. Если 'except' или '!=' — отправить сообщение всем клиентам, кроме
          указанного.</tr>
        </param>
        <param name="ID" type="int" required="false">
          <tr lang="en">client ID. Required, if client selector is one of: 'id', '==', '!=' or
          'except'.</tr>
          <tr lang="ru">ID клиента. Требуется, если селектор клиента — один из: 'id', '==', '!='
          или 'except'.</tr>
        </param>
        <param name="ARGS" type="list" required="false">
          <tr lang="en">arguments</tr>
          <tr lang="ru">аргументы</tr>
        </param>
      </method>
      <!-- send_binary -->
      <method name="send_binary">
        <info>
          <tr lang="en">send as binary bytes to specified client(s)</tr>
          <tr lang="ru">отправить как бинарные байты указанному клиенту (клиентам)</tr>
        </info>
        <param name="TARGET" type="symbol" required="true" enum="* all first last id == != except">
          <tr lang="en">client selector. If '*' or 'all' — send message to all clients. If 'first'
          — send message to the first connected client. If 'last' — send message to the last
          connected client. If 'id' or '==' — send message to the client with the specified ID. If
          'except' or '!=' — send message to all clients except the specified one.</tr>
          <tr lang="ru">селектор клиента. Если '*' или 'all' — отправить сообщение всем клиентам.
          Если 'first' — отправить сообщение первому подключённому клиенту. Если 'last' — отправить
          сообщение последнему подключённому клиенту. Если 'id' или '==' — отправить сообщение
          клиенту с указанным ID. Если 'except' или '!=' — отправить сообщение всем клиентам, кроме
          указанного.</tr>
        </param>
        <param name="ID" type="int" required="false">
          <tr lang="en">client ID. Required, if client selector is one of: 'id', '==', '!=' or
          'except'.</tr>
          <tr lang="ru">ID клиента. Требуется, если селектор клиента — один из: 'id', '==', '!='
          или 'except'.</tr>
        </param>
        <param name="DATA" type="list" required="false">
          <tr lang="en">list of integers in [0..255] range</tr>
          <tr lang="ru">список целых чисел в диапазоне [0..255]</tr>
        </param>
      </method>
      <!-- send_json -->
      <method name="send_json">
        <info>
          <tr lang="en">send as encoded JSON to specified client(s)</tr>
          <tr lang="ru">отправить как закодированный JSON указанному клиенту (клиентам)</tr>
        </info>
        <param name="TARGET" type="symbol" required="true" enum="* all first last id == != except">
          <tr lang="en">client selector. If '*' or 'all' — send message to all clients. If 'first'
          — send message to the first connected client. If 'last' — send message to the last
          connected client. If 'id' or '==' — send message to the client with the specified ID. If
          'except' or '!=' — send message to all clients except the specified one.</tr>
          <tr lang="ru">селектор клиента. Если '*' или 'all' — отправить сообщение всем клиентам.
          Если 'first' — отправить сообщение первому подключённому клиенту. Если 'last' — отправить
          сообщение последнему подключённому клиенту. Если 'id' или '==' — отправить сообщение
          клиенту с указанным ID. Если 'except' или '!=' — отправить сообщение всем клиентам, кроме
          указанного.</tr>
        </param>
        <param name="ID" type="int" required="false">
          <tr lang="en">client ID. Required, if client selector is one of: 'id', '==', '!=' or
          'except'.</tr>
          <tr lang="ru">ID клиента. Требуется, если селектор клиента — один из: 'id', '==', '!='
          или 'except'.</tr>
        </param>
        <param name="ARGS" type="list" required="false">
          <tr lang="en">arguments</tr>
          <tr lang="ru">аргументы</tr>
        </param>
      </method>
      <!-- shutdown -->
      <method name="shutdown">
        <info>
          <tr lang="en">abort connection with specified client(s)</tr>
          <tr lang="ru">прервать соединение с указанным клиентом (клиентами)</tr>
        </info>
        <param name="TARGET" type="symbol" required="true" enum="* all first last id == != except">
          <tr lang="en">client selector. If '*' or 'all' — send message to all clients. If 'first'
          — send message to the first connected client. If 'last' — send message to the last
          connected client. If 'id' or '==' — send message to the client with the specified ID. If
          'except' or '!=' — send message to all clients except the specified one.</tr>
          <tr lang="ru">селектор клиента. Если '*' или 'all' — отправить сообщение всем клиентам.
          Если 'first' — отправить сообщение первому подключённому клиенту. Если 'last' — отправить
          сообщение последнему подключённому клиенту. Если 'id' или '==' — отправить сообщение
          клиенту с указанным ID. Если 'except' или '!=' — отправить сообщение всем клиентам, кроме
          указанного.</tr>
        </param>
        <param name="ID" type="int" required="false">
          <tr lang="en">client ID. Required, if client selector is one of: 'id', '==', '!=' or
          'except'.</tr>
          <tr lang="ru">ID клиента. Требуется, если селектор клиента — один из: 'id', '==', '!='
          или 'except'.</tr>
        </param>
      </method>
      <!-- stop -->
      <method name="stop">
        <info>
          <tr lang="en">stops server, equal to the [listen 0( message</tr>
          <tr lang="ru">останавливает сервер, эквивалентно сообщению [listen 0(</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">message input</tr>
          <tr lang="ru">вход сообщений</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">[connected( when client is connected, [closed( when client closed, [text(
          on text message, [ping( on ping message from client, [binary( on binary message</tr>
          <tr lang="ru">[connected( — при подключении клиента, [closed( — при отключении клиента,
          [text( — при текстовом сообщении, [ping( — при ping-сообщении от клиента, [binary( — при
          бинарном сообщении</tr>
        </out>
      </outlet>
      <outlet>
        <out type="list">
          <tr lang="en">CLIENT_ID CLIENT_ADDR</tr>
          <tr lang="ru">CLIENT_ID CLIENT_ADDR</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
/*you can start testing websocket client with command: 'websocat ws://127.0.0.1:8000'*/


[listen 8000(   [stop #a(             [send CLI #i( [send_binary 1 2 3 #j(
|
| [ping all #b( [close * #e(          [connect ws://127.0.0.1:8000 #f(
|
| [send last MSG #c(                  [close #g( [ping #h(
|
| [send != 2 MSG #d(                  [net.ws.client #xx]
|                                     |
|  [clients #k(                       [ui.dt]
|
|   [send_json all 1 2 3 #l(
|
|
[net.ws.server #x]
|
[ui.dt]          [ui.dt #z]

[print SRV #y]

[X x->y] [X x:1->z]
[X a->x] [X b->x] [X c->x] [X d->x] [X e->x] [X k->x] [X l->x]
[X f->xx] [X g->xx] [X h->xx] [X i->xx] [X j->xx]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
