#X obj 631 8 conv.pitch2midi;
#X obj 230 78 cnv 1 535 136 empty empty empty 17 7 0 10 -237178 -1 0;
#X text 240 83 Объект преобразует ноту в научной нотации (SPN) в MIDI-номер
ноты. SPN состоит из класса высоты (C \, C# \, D \, Eb и т. д.) и номера
октавы (0–9). Например \, C4 — это средняя до (middle C) \, соответствующая
MIDI-номеру 60\. Диезы записываются как '#' \, а бемоли — как 'b'.
Двойные диезы — '##' (или 'x') \, двойные бемоли — 'bb'. Символ паузы
'R' преобразуется в значение -1\.;
