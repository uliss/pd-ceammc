#X obj 675 8 flow.sync;
#X obj 230 78 cnv 1 535 270 empty empty empty 17 7 0 10 -237178 -1 0;
#X text 240 83 объект хранит последнее полученное значение с каждого
входа и при поступлении нового значения выводит все сохранённые значения
со всех выходов справа налево;
#X text 240 138 в отличие от [flow.sync_pack] \, который упаковывает
все «горячие» входы в один список на одном выходе \, [flow.sync] хранит
отдельное значение для каждого входа и при каждом новом входе выводит
все их параллельно с N выходов;
#X text 240 223 все входы «горячие» \, поэтому любое число \, символ
или список запускает вывод;
#X text 240 263 объект можно использовать для синхронизации параллельных
управляющих потоков \, например чтобы вывести несколько значений параметров
вместе при изменении любого из них;
