#X text 240 323 #1 — отправить второму экземпляру;
#X text 240 348 #<2 — отправить экземплярам #0 и #1;
#X text 240 373 #>2 — отправить экземплярам с id > 2;
#X text 240 398 #2-4 — отправить экземплярам с id в диапазоне [2 \,
4];
