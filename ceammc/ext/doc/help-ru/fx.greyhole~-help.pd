#X obj 560 50 cnv 1 205 23 empty empty empty 17 7 0 10 -245760 -1 0;
#X text 565 50 сложный эхоподобный эффект;
#X obj 1 1 cnv 5 765 40 empty empty fx.greyhole~ 20 20 0 20 -104026
-4096 0;
#X obj 652 11 fx.greyhole~;
#X obj 230 78 cnv 1 535 320 empty empty empty 17 7 0 10 -237178 -1 0;
#X text 240 83 сложный эхоподобный эффект \, вдохновлённый классическим
эффектом Eventide с похожим названием \, который состоит из диффузора
(как мини-реверберация \, структурно похожая на используемую в JPverb)
\, соединённого в системе обратной связи с длинной модулированной линией
задержки;
#X text 240 168 эффект отлично подходит для создания пространственных
звуковых «волн»;
#X text 240 208 @feedback задаёт величину обратной связи в линии задержки
\, @delaytime задаёт примерное время задержки;
#X text 240 248 @size \, @diffusion и @damping формируют диффузионный
блок \, @moddepth и @modfreq управляют модуляцией линии задержки;
#X text 240 303 @drywet управляет балансом между исходным (сухим) и
обработанным сигналом \, @bypass полностью отключает обработку;
#X text 240 358 разработан в рамках проекта DEIND;
#X msg 50 446 1000 1000 0 \, 300 300 1000 \, 3000 500 1300 \, 0 100 1400;
#X obj 50 475 vline~;
