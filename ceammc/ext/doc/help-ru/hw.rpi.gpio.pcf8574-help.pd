#X obj 300 1392 cnv 1 29 21 empty empty empty 17 7 0 10 -245695 -1 0;
#X text 300 1392 PIN: индекс вывода. Тип: int. Диапазон: [0\..7].;
#X obj 250 1425 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
