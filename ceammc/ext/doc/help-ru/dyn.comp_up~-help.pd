#X msg 130 941 @id;
#X text 270 941 (при инициализации) Идентификатор для OSC адреса. Если
установлен \, все свойства объекта привязываются к OSC адресам вида:
/ИДЕНТИФИКАТОР/dyn_comp_up/ИМЯ_СВОЙСТВА \, в противном случае к /dyn_comp_up/ИМЯ_СВОЙСТВА.
Тип: symbol.;
#X obj 250 1028 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 1028 @osc;
#X text 270 1028 (при инициализации) Имя OSC сервера. Тип: symbol.;
#X obj 250 1058 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 1058 @active;
