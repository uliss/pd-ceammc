#X msg 110 752 @active_scale;
#X text 245 752 Получить/Установить if should draw active scale. Тип:
bool. Значение по умолчанию: 0\.;
#X msg 110 794 @max;
#X text 245 794 Получить/Установить maximum knob value. Тип: float.
Значение по умолчанию: 1\.;
#X msg 110 836 @min;
#X text 245 836 Получить/Установить minimum knob value. Тип: float.
Значение по умолчанию: 0\.;
#X msg 110 878 @mouse_events;
#X text 245 878 Получить/Установить mouse events output mode. If on
outputs @mouse_down \, @mouse_up and @mouse_drag events. Тип: bool.
Значение по умолчанию: 0\.;
#X msg 110 935 @receive;
#X text 245 935 Получить/Установить источник получения сообщений. Тип:
symbol. Значение по умолчанию: (null).;
#X msg 110 977 @scale;
#X text 245 977 Получить/Установить scale mode. Linear or logarithmic.
Тип: symbol. Значение по умолчанию: linear. Разрешённые значения: linear
\, log.;
#X msg 110 1034 @send;
#X text 245 1034 Получить/Установить адрес отправки сообщений. Тип:
symbol. Значение по умолчанию: (null).;
#X msg 110 1076 @show_range;
#X text 245 1076 Получить/Установить show knob range. Тип: bool. Значение
по умолчанию: 0\.;
#X msg 110 1118 @show_value;
#X text 245 1118 Получить/Установить show value. Тип: bool. Значение
по умолчанию: 0\.;
#X msg 110 1160 @value;
#X text 245 1160 Получить/Установить current value. Тип: float. Значение
по умолчанию: 0\.;
#X msg 110 1202 @midi_channel;
#X text 245 1202 Получить/Установить привязанный канал MIDI. Если установлен
в 0 - привязка ко всем каналам. Значения в диапазоне [1\..16] привязываются
к каналам первого Pd MIDI устройства \, [17\..32] - к каналам второго
и т.д. Тип: int. Значение по умолчанию: 0\. Диапазон: 0\...255\.;
#X msg 110 1305 @midi_control;
#X text 245 1305 Получить/Установить binded MIDI controller number.
-1 means not binded to any controller. Тип: int. Значение по умолчанию:
-1\. Диапазон: -1\...127\.;
#X msg 110 1362 @midi_pickup;
#X text 245 1362 Получить/Установить pickup current value. If slider
is binded to value \, first time you should pass over this value to
make binding. It prevents from sudden value change on first control
change. Тип: bool. Значение по умолчанию: 1\.;
#X msg 110 1449 @background_color;
#X text 245 1449 Получить/Установить цвета фона у объекта (список из
красного \, зеленого и синего значений в диапазоне [0\..1]). Тип: list.
Значение по умолчанию: 0.93 0.93 0.93 1\.;
#X msg 110 1506 @border_color;
#X text 245 1506 Получить/Установить цвет границы объекта (список из
красного \, зеленого и синего цветов в [0\..1] диапазоне). Тип: list.
Значение по умолчанию: 0.6 0.6 0.6 1\.;
#X msg 110 1563 @knob_color;
#X text 245 1563 Получить/Установить knob color (list of red \, green
\, blue values in 0-1 range). Тип: list. Значение по умолчанию: 0 0.75
1 1\.;
#X msg 110 1620 @scale_color;
#X text 245 1620 Получить/Установить scale color (list of red \, green
\, blue values in 0-1 range). Тип: list. Значение по умолчанию: 0.6
0.6 0.6 1\.;
#X msg 110 1677 @label;
#X text 245 1677 Получить/Установить текст ярлыка. Тип: symbol. Значение
по умолчанию: (null).;
#X msg 110 1719 @label_align;
#X text 245 1719 Получить/Установить горизонтальное выравнивание ярлыка.
Тип: symbol. Значение по умолчанию: left. Разрешённые значения: left
\, center \, right.;
#X msg 110 1776 @label_inner;
#X text 245 1776 Получить/Установить положение ярлыка (1 - внутри \,
0 - снаружи объекта). Тип: bool. Значение по умолчанию: 0\.;
#X msg 110 1818 @label_margins;
#X text 245 1818 Получить/Установить отступы ярлыка в пикселях по осям
X и Y. Тип: list. Значение по умолчанию: 0 0\.;
#X msg 110 1860 @label_side;
#X text 245 1860 Получить/Установить сторона прикрепления ярлыка. Тип:
symbol. Значение по умолчанию: top. Разрешённые значения: left \, top
\, right \, bottom.;
#X msg 110 1917 @label_valign;
#X text 245 1917 Получить/Установить вертикальное выравнивание ярлыка.
Тип: symbol. Значение по умолчанию: top. Разрешённые значения: top
\, center \, bottom.;
#X msg 110 1974 @fontname;
#X text 245 1974 Получить/Установить имя шрифта. Тип: symbol. Значение
по умолчанию: Helvetica. Разрешённые значения: Courier \, DejaVu \,
Helvetica \, Monaco \, Times.;
#X msg 110 2031 @fontsize;
#X text 245 2031 Получить/Установить размер шрифта. Тип: int. Значение
по умолчанию: 11\. Диапазон: 4\...100\.;
#X msg 110 2073 @fontslant;
#X text 245 2073 Получить/Установить наклон шрифта. Тип: symbol. Значение
по умолчанию: roman. Разрешённые значения: roman \, italic.;
#X msg 110 2115 @fontweight;
#X text 245 2115 Получить/Установить толщину шрифта. Тип: symbol. Значение
по умолчанию: normal. Разрешённые значения: normal \, bold.;
#X msg 110 2157 @pinned;
#X text 245 2157 Получить/Установить режим закрепления. Если 1 - помещает
элемент на самый дальний уровень на холсте за другими элементам. Тип:
bool. Значение по умолчанию: 0\.;
#X msg 110 2214 @presetname;
#X text 245 2214 Получить/Установить имя пресета для использования
с объектами [ui.preset] или [preset.storage]. Тип: symbol. Значение
по умолчанию: (null).;
