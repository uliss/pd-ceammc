#X msg 130 736 @max;
#X text 270 736 Maximum knob value. Тип: float. Значение по умолчанию:
1\.;
#X msg 130 766 @min;
#X text 270 766 Minimum knob value. Тип: float. Значение по умолчанию:
0\.;
#X msg 130 796 @mouse_events;
#X text 270 796 Mouse events output mode. If on outputs @mouse_down
\, @mouse_up and @mouse_drag events. Тип: bool. Значение по умолчанию:
0\.;
#X msg 130 853 @receive;
#X text 270 853 Источник получения сообщений. Тип: symbol. Значение
по умолчанию: (null).;
#X msg 130 895 @scale;
#X text 270 895 Scale mode. Linear or logarithmic. Тип: symbol. Значение
по умолчанию: linear. Разрешённые значения: linear \, log.;
#X msg 130 952 @send;
#X text 270 952 Адрес отправки сообщений. Тип: symbol. Значение по
умолчанию: (null).;
#X msg 130 994 @show_range;
#X text 270 994 Show knob range. Тип: bool. Значение по умолчанию:
0\.;
#X msg 130 1024 @show_value;
#X text 270 1024 Show value. Тип: bool. Значение по умолчанию: 0\.;
#X msg 130 1054 @value;
#X text 270 1054 Current value. Тип: float. Значение по умолчанию:
0\.;
#X msg 130 1084 @midi_channel;
#X text 270 1084 Привязанный канал MIDI. Если установлен в 0 - привязка
ко всем каналам. Значения в диапазоне [1\..16] привязываются к каналам
первого Pd MIDI устройства \, [17\..32] - к каналам второго и т.д.
Тип: int. Значение по умолчанию: 0\. Диапазон: 0\...255\.;
#X msg 130 1171 @midi_control;
#X text 270 1171 Binded MIDI controller number. -1 means not binded
to any controller. Тип: int. Значение по умолчанию: -1\. Диапазон:
-1\...127\.;
#X msg 130 1228 @midi_pickup;
#X text 270 1228 Pickup current value. If slider is binded to value
\, first time you should pass over this value to make binding. It prevents
from sudden value change on first control change. Тип: bool. Значение
по умолчанию: 1\.;
#X msg 130 1300 @background_color;
#X text 270 1300 Цвета фона у объекта (список из красного \, зеленого
и синего значений в диапазоне [0\..1]). Тип: list. Значение по умолчанию:
0.93 0.93 0.93 1\.;
#X msg 130 1357 @border_color;
#X text 270 1357 Цвет границы объекта (список из красного \, зеленого
и синего цветов в [0\..1] диапазоне). Тип: list. Значение по умолчанию:
0.6 0.6 0.6 1\.;
#X msg 130 1414 @knob_color;
#X text 270 1414 Knob color (list of red \, green \, blue values in
0-1 range). Тип: list. Значение по умолчанию: 0 0.75 1 1\.;
#X msg 130 1456 @scale_color;
#X text 270 1456 Scale color (list of red \, green \, blue values in
0-1 range). Тип: list. Значение по умолчанию: 0.6 0.6 0.6 1\.;
#X msg 130 1498 @label;
#X text 270 1498 Текст ярлыка. Тип: symbol. Значение по умолчанию:
(null).;
#X msg 130 1528 @label_align;
#X text 270 1528 Горизонтальное выравнивание ярлыка. Тип: symbol. Значение
по умолчанию: left. Разрешённые значения: left \, center \, right.;
#X msg 130 1585 @label_inner;
#X text 270 1585 Положение ярлыка (1 - внутри \, 0 - снаружи объекта).
Тип: bool. Значение по умолчанию: 0\.;
#X msg 130 1627 @label_margins;
#X text 270 1627 Отступы ярлыка в пикселях по осям X и Y. Тип: list.
Значение по умолчанию: 0 0\.;
#X msg 130 1669 @label_side;
#X text 270 1669 Сторона прикрепления ярлыка. Тип: symbol. Значение
по умолчанию: top. Разрешённые значения: left \, top \, right \, bottom.;
#X msg 130 1726 @label_valign;
#X text 270 1726 Вертикальное выравнивание ярлыка. Тип: symbol. Значение
по умолчанию: top. Разрешённые значения: top \, center \, bottom.;
#X msg 130 1783 @fontname;
#X text 270 1783 Имя шрифта. Тип: symbol. Значение по умолчанию: Helvetica.
Разрешённые значения: Courier \, DejaVu \, Helvetica \, Monaco \, Times.;
#X msg 130 1840 @fontsize;
#X text 270 1840 Размер шрифта. Тип: int. Значение по умолчанию: 11\.
Диапазон: 4\...100\.;
#X msg 130 1882 @fontslant;
#X text 270 1882 Наклон шрифта. Тип: symbol. Значение по умолчанию:
roman. Разрешённые значения: roman \, italic.;
#X msg 130 1924 @fontweight;
#X text 270 1924 Толщину шрифта. Тип: symbol. Значение по умолчанию:
normal. Разрешённые значения: normal \, bold.;
#X msg 130 1966 @pinned;
#X text 270 1966 Режим закрепления. Если 1 - помещает элемент на самый
дальний уровень на холсте за другими элементам. Тип: bool. Значение
