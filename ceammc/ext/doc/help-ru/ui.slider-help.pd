#X msg 130 805 @active_scale;
#X text 270 805 Получить/Установить if should draw active scale. Тип:
bool. Значение по умолчанию: 0\.;
#X msg 130 847 @max;
#X text 270 847 Получить/Установить maximum slider value. Тип: float.
Значение по умолчанию: 1\.;
#X msg 130 889 @min;
#X text 270 889 Получить/Установить minimum slider value. Тип: float.
Значение по умолчанию: 0\.;
#X msg 130 931 @mode;
#X text 270 931 Получить/Установить relative mode. Do not jump on click
to value. Тип: bool. Значение по умолчанию: 0\.;
#X msg 130 973 @mouse_events;
#X text 270 973 Получить/Установить mouse events output mode. If on
outputs @mouse_down \, @mouse_up and @mouse_drag events. Тип: bool.
Значение по умолчанию: 0\.;
#X msg 130 1030 @receive;
#X text 270 1030 Получить/Установить источник получения сообщений.
Тип: symbol. Значение по умолчанию: (null).;
#X msg 130 1072 @scale;
#X text 270 1072 Получить/Установить scale mode. Linear or logarithmic.
Тип: symbol. Значение по умолчанию: linear. Разрешённые значения: linear
\, log.;
#X msg 130 1129 @send;
#X text 270 1129 Получить/Установить адрес отправки сообщений. Тип:
symbol. Значение по умолчанию: (null).;
#X msg 130 1171 @show_value;
#X text 270 1171 Получить/Установить show value (in horizontal mode
only). Тип: bool. Значение по умолчанию: 0\.;
#X msg 130 1213 @value;
#X text 270 1213 Получить/Установить current value. Тип: float. Значение
по умолчанию: 0\.;
#X msg 130 1255 @value_pos;
#X text 270 1255 Получить/Установить value position. Тип: symbol. Значение
по умолчанию: center. Разрешённые значения: left \, center \, right.;
#X msg 130 1297 @value_precision;
#X text 270 1297 Получить/Установить number of digits shown after decimal
point. Тип: int. Значение по умолчанию: 2\. Диапазон: 0\...7\.;
#X msg 130 1354 @midi_channel;
#X text 270 1354 Получить/Установить привязанный канал MIDI. Если установлен
в 0 - привязка ко всем каналам. Значения в диапазоне [1\..16] привязываются
к каналам первого Pd MIDI устройства \, [17\..32] - к каналам второго
и т.д. Тип: int. Значение по умолчанию: 0\. Диапазон: 0\...255\.;
#X msg 130 1457 @midi_control;
#X text 270 1457 Получить/Установить binded MIDI controller number.
-1 means not binded to any controller. Тип: int. Значение по умолчанию:
-1\. Диапазон: -1\...127\.;
#X msg 130 1514 @midi_pickup;
#X text 270 1514 Получить/Установить pickup current value. If slider
is binded to value \, first time you should pass over this value to
make binding. It prevents from sudden value change on first control
change. Тип: bool. Значение по умолчанию: 1\.;
#X msg 130 1601 @background_color;
#X text 270 1601 Получить/Установить цвета фона у объекта (список из
красного \, зеленого и синего значений в диапазоне [0\..1]). Тип: list.
Значение по умолчанию: 0.93 0.93 0.93 1\.;
#X msg 130 1658 @border_color;
#X text 270 1658 Получить/Установить цвет границы объекта (список из
красного \, зеленого и синего цветов в [0\..1] диапазоне). Тип: list.
Значение по умолчанию: 0.6 0.6 0.6 1\.;
#X msg 130 1715 @knob_color;
#X text 270 1715 Получить/Установить knob color (list of red \, green
\, blue values in 0-1 range). Тип: list. Значение по умолчанию: 0 0.75
1 1\.;
#X msg 130 1772 @text_color;
#X text 270 1772 Получить/Установить value text color (list of red
\, green \, blue values in 0-1 range). Тип: list. Значение по умолчанию:
0 0 0 1\.;
#X msg 130 1829 @label;
#X text 270 1829 Получить/Установить текст ярлыка. Тип: symbol. Значение
по умолчанию: (null).;
#X msg 130 1871 @label_align;
#X text 270 1871 Получить/Установить горизонтальное выравнивание ярлыка.
Тип: symbol. Значение по умолчанию: left. Разрешённые значения: left
\, center \, right.;
#X msg 130 1928 @label_inner;
#X text 270 1928 Получить/Установить положение ярлыка (1 - внутри \,
0 - снаружи объекта). Тип: bool. Значение по умолчанию: 0\.;
#X msg 130 1970 @label_margins;
#X text 270 1970 Получить/Установить отступы ярлыка в пикселях по осям
X и Y. Тип: list. Значение по умолчанию: 0 0\.;
#X msg 130 2012 @label_side;
#X text 270 2012 Получить/Установить сторона прикрепления ярлыка. Тип:
symbol. Значение по умолчанию: top. Разрешённые значения: left \, top
\, right \, bottom.;
#X msg 130 2069 @label_valign;
#X text 270 2069 Получить/Установить вертикальное выравнивание ярлыка.
Тип: symbol. Значение по умолчанию: top. Разрешённые значения: top
\, center \, bottom.;
#X msg 130 2126 @fontname;
#X text 270 2126 Получить/Установить имя шрифта. Тип: symbol. Значение
