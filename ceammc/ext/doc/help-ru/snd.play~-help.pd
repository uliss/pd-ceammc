#X obj 250 1346 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 1346 @sync;
#X text 270 1346 Режим синхронизации. 'now': немедленно начинает воспроизведение
(прерывая предыдущее) после получения сообщения о старте. 'defer':
подождать \, пока предыдущее воспроизведение завершится \, затем начать
новое. 'wait': не воспроизводить \, пока предыдущее воспроизведение
не завершится. Тип: symbol. Значение по умолчанию: now. Разрешённые
значения: now \, defer \, wait.;
