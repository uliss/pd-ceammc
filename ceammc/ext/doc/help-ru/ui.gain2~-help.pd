#X msg 130 643 @amp;
#X text 270 643 Получить/Установить gain as amplitude ratio. Тип: float.
Значение по умолчанию: 0\.;
#X msg 130 685 @db;
#X text 270 685 Получить/Установить gain in dbfs scale. Тип: float.
Единицы: 'db'. Значение по умолчанию: -60\.;
#X msg 130 727 @max;
#X text 270 727 Получить/Установить maximum gain value. Тип: int. Единицы:
'db'. Значение по умолчанию: 0\. Диапазон: -12\...12\.;
#X msg 130 769 @min;
#X text 270 769 Получить/Установить minimal gain value. Тип: int. Единицы:
'db'. Значение по умолчанию: -60\. Диапазон: -90\...-15\.;
#X msg 130 811 @mouse_events;
#X text 270 811 Получить/Установить mouse events output mode. If on
outputs @mouse_down \, @mouse_up and @mouse_drag events. Тип: bool.
Значение по умолчанию: 0\.;
#X msg 130 868 @output_value;
#X text 270 868 Получить/Установить flag to output @db property after
each knob move. Тип: bool. Значение по умолчанию: 0\.;
#X msg 130 910 @receive;
#X text 270 910 Получить/Установить источник получения сообщений. Тип:
symbol. Значение по умолчанию: (null).;
#X msg 130 952 @relative;
#X text 270 952 Получить/Установить relative input mode. When set do
not jump to value on click. Тип: bool. Значение по умолчанию: 1\.;
#X msg 130 994 @send;
#X text 270 994 Получить/Установить адрес отправки сообщений. Тип:
symbol. Значение по умолчанию: (null).;
#X msg 130 1036 @show_range;
#X text 270 1036 Получить/Установить if show slider range. Тип: bool.
Значение по умолчанию: 1\.;
#X msg 130 1078 @midi_channel;
#X text 270 1078 Получить/Установить привязанный канал MIDI. Если установлен
в 0 - привязка ко всем каналам. Значения в диапазоне [1\..16] привязываются
к каналам первого Pd MIDI устройства \, [17\..32] - к каналам второго
и т.д. Тип: int. Значение по умолчанию: 0\. Диапазон: 0\...255\.;
#X msg 130 1181 @midi_control;
#X text 270 1181 Получить/Установить binded MIDI controller number.
-1 means not binded to any controller. Тип: int. Значение по умолчанию:
-1\. Диапазон: -1\...127\.;
#X msg 130 1238 @midi_pickup;
#X text 270 1238 Получить/Установить pickup current value. If slider
is binded to value \, first time you should pass over this value to
make binding. It prevents from sudden value change on first control
change. Тип: bool. Значение по умолчанию: 1\.;
#X msg 130 1325 @background_color;
#X text 270 1325 Получить/Установить цвета фона у объекта (список из
красного \, зеленого и синего значений в диапазоне [0\..1]). Тип: list.
Значение по умолчанию: 0.93 0.93 0.93 1\.;
#X msg 130 1382 @border_color;
#X text 270 1382 Получить/Установить цвет границы объекта (список из
красного \, зеленого и синего цветов в [0\..1] диапазоне). Тип: list.
Значение по умолчанию: 0.6 0.6 0.6 1\.;
#X msg 130 1439 @knob_color;
#X text 270 1439 Получить/Установить knob color (list of red \, green
\, blue values in 0-1 range). Тип: list. Значение по умолчанию: 0 0.75
1 1\.;
#X msg 130 1496 @fontname;
#X text 270 1496 Получить/Установить имя шрифта. Тип: symbol. Значение
по умолчанию: Helvetica. Разрешённые значения: Courier \, DejaVu \,
Helvetica \, Monaco \, Times.;
#X msg 130 1553 @fontsize;
#X text 270 1553 Получить/Установить размер шрифта. Тип: int. Значение
по умолчанию: 11\. Диапазон: 4\...100\.;
#X msg 130 1595 @fontslant;
#X text 270 1595 Получить/Установить наклон шрифта. Тип: symbol. Значение
по умолчанию: roman. Разрешённые значения: roman \, italic.;
#X msg 130 1637 @fontweight;
#X text 270 1637 Получить/Установить толщину шрифта. Тип: symbol. Значение
по умолчанию: normal. Разрешённые значения: normal \, bold.;
#X msg 130 1679 @pinned;
#X text 270 1679 Получить/Установить режим закрепления. Если 1 - помещает
элемент на самый дальний уровень на холсте за другими элементам. Тип:
bool. Значение по умолчанию: 0\.;
#X msg 130 1736 @presetname;
#X text 270 1736 Получить/Установить имя пресета для использования
с объектами [ui.preset] или [preset.storage]. Тип: symbol. Значение
по умолчанию: (null).;
#X msg 130 1793 @size;
#X text 270 1793 Получить/Установить размер объекта (пара: ШИРИНА ВЫСОТА).
Тип: list. Значение по умолчанию: 15 120\.;
