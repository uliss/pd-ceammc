#X msg 110 677 @amp;
#X text 245 677 Получить/Установить gain as amplitude ratio. Тип: float.
Значение по умолчанию: 0\.;
#X msg 110 719 @db;
#X text 245 719 Получить/Установить gain in dbfs scale. Тип: float.
Единицы: 'db'. Значение по умолчанию: -60\.;
#X msg 110 761 @max;
#X text 245 761 Получить/Установить maximum gain value. Тип: int. Единицы:
'db'. Значение по умолчанию: 0\. Диапазон: -12\...12\.;
#X msg 110 803 @min;
#X text 245 803 Получить/Установить minimal gain value. Тип: int. Единицы:
'db'. Значение по умолчанию: -60\. Диапазон: -90\...-15\.;
#X msg 110 845 @mouse_events;
#X text 245 845 Получить/Установить mouse events output mode. If on
outputs @mouse_down \, @mouse_up and @mouse_drag events. Тип: bool.
Значение по умолчанию: 0\.;
#X msg 110 902 @output_value;
#X text 245 902 Получить/Установить flag to output @db property after
each knob move. Тип: bool. Значение по умолчанию: 0\.;
#X msg 110 944 @receive;
#X text 245 944 Получить/Установить receive source. Тип: symbol. Значение
по умолчанию: (null).;
#X msg 110 986 @relative;
#X text 245 986 Получить/Установить relative input mode. When set do
not jump to value on click. Тип: bool. Значение по умолчанию: 1\.;
#X msg 110 1028 @send;
#X text 245 1028 Получить/Установить send destination. Тип: symbol.
Значение по умолчанию: (null).;
#X msg 110 1070 @show_range;
#X text 245 1070 Получить/Установить if show slider range. Тип: bool.
Значение по умолчанию: 1\.;
#X msg 110 1112 @midi_channel;
#X text 245 1112 Получить/Установить binded MIDI channel. 0 means listen
to all channels. Тип: int. Значение по умолчанию: 0\. Диапазон: 0\...255\.;
#X msg 110 1169 @midi_control;
#X text 245 1169 Получить/Установить binded MIDI controller number.
-1 means not binded to any controller. Тип: int. Значение по умолчанию:
-1\. Диапазон: -1\...127\.;
#X msg 110 1226 @midi_pickup;
#X text 245 1226 Получить/Установить pickup current value. If slider
is binded to value \, first time you should pass over this value to
make binding. It prevents from sudden value change on first control
change. Тип: bool. Значение по умолчанию: 1\.;
#X msg 110 1313 @background_color;
#X text 245 1313 Получить/Установить цвета фона у объекта (список из
красного \, зеленого и синего значений в диапазоне [0\..1]). Тип: list.
Значение по умолчанию: 0.93 0.93 0.93 1\.;
#X msg 110 1370 @border_color;
#X text 245 1370 Получить/Установить цвет границы объекта (список из
красного \, зеленого и синего цветов в [0\..1] диапазоне). Тип: list.
Значение по умолчанию: 0.6 0.6 0.6 1\.;
#X msg 110 1427 @knob_color;
#X text 245 1427 Получить/Установить knob color (list of red \, green
\, blue values in 0-1 range). Тип: list. Значение по умолчанию: 0 0.75
1 1\.;
#X msg 110 1484 @fontname;
#X text 245 1484 Получить/Установить имя шрифта. Тип: symbol. Значение
по умолчанию: Helvetica. Разрешённые значения: Courier \, DejaVu \,
Helvetica \, Monaco \, Times.;
#X msg 110 1541 @fontsize;
#X text 245 1541 Получить/Установить размер шрифта. Тип: int. Значение
по умолчанию: 11\. Диапазон: 4\...100\.;
#X msg 110 1583 @fontslant;
#X text 245 1583 Получить/Установить font slant. Тип: symbol. Значение
по умолчанию: roman. Разрешённые значения: roman \, italic.;
#X msg 110 1625 @fontweight;
#X text 245 1625 Получить/Установить font weight. Тип: symbol. Значение
по умолчанию: normal. Разрешённые значения: normal \, bold.;
#X msg 110 1667 @pinned;
#X text 245 1667 Получить/Установить pin mode. if 1 - put element to
