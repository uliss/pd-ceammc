#X msg 130 643 @amp;
#X text 270 643 Gain as amplitude ratio. Тип: float. Значение по умолчанию:
0\.;
#X msg 130 685 @db;
#X text 270 685 Gain in dbfs scale. Тип: float. Единицы: 'db'. Значение
по умолчанию: -60\.;
#X msg 130 727 @max;
#X text 270 727 Maximum gain value. Тип: int. Единицы: 'db'. Значение
по умолчанию: 0\. Диапазон: -12\...12\.;
#X msg 130 769 @min;
#X text 270 769 Minimal gain value. Тип: int. Единицы: 'db'. Значение
по умолчанию: -60\. Диапазон: -90\...-15\.;
#X msg 130 811 @mouse_events;
#X text 270 811 Mouse events output mode. If on outputs @mouse_down
\, @mouse_up and @mouse_drag events. Тип: bool. Значение по умолчанию:
0\.;
#X msg 130 868 @output_value;
#X text 270 868 Flag to output @db property after each knob move. Тип:
bool. Значение по умолчанию: 0\.;
#X msg 130 910 @receive;
#X text 270 910 Источник получения сообщений. Тип: symbol. Значение
по умолчанию: (null).;
#X msg 130 952 @relative;
#X text 270 952 Relative input mode. When set do not jump to value
on click. Тип: bool. Значение по умолчанию: 1\.;
#X msg 130 994 @send;
#X text 270 994 Адрес отправки сообщений. Тип: symbol. Значение по
умолчанию: (null).;
#X msg 130 1036 @show_range;
#X text 270 1036 If show slider range. Тип: bool. Значение по умолчанию:
1\.;
#X msg 130 1066 @midi_channel;
#X text 270 1066 Привязанный канал MIDI. Если установлен в 0 - привязка
ко всем каналам. Значения в диапазоне [1\..16] привязываются к каналам
первого Pd MIDI устройства \, [17\..32] - к каналам второго и т.д.
Тип: int. Значение по умолчанию: 0\. Диапазон: 0\...255\.;
#X msg 130 1153 @midi_control;
#X text 270 1153 Binded MIDI controller number. -1 means not binded
to any controller. Тип: int. Значение по умолчанию: -1\. Диапазон:
-1\...127\.;
#X msg 130 1210 @midi_pickup;
#X text 270 1210 Pickup current value. If slider is binded to value
\, first time you should pass over this value to make binding. It prevents
from sudden value change on first control change. Тип: bool. Значение
по умолчанию: 1\.;
#X msg 130 1282 @background_color;
#X text 270 1282 Цвета фона у объекта (список из красного \, зеленого
и синего значений в диапазоне [0\..1]). Тип: list. Значение по умолчанию:
0.93 0.93 0.93 1\.;
#X msg 130 1339 @border_color;
#X text 270 1339 Цвет границы объекта (список из красного \, зеленого
и синего цветов в [0\..1] диапазоне). Тип: list. Значение по умолчанию:
0.6 0.6 0.6 1\.;
#X msg 130 1396 @knob_color;
#X text 270 1396 Knob color (list of red \, green \, blue values in
0-1 range). Тип: list. Значение по умолчанию: 0 0.75 1 1\.;
#X msg 130 1438 @fontname;
#X text 270 1438 Имя шрифта. Тип: symbol. Значение по умолчанию: Helvetica.
Разрешённые значения: Courier \, DejaVu \, Helvetica \, Monaco \, Times.;
#X msg 130 1495 @fontsize;
#X text 270 1495 Размер шрифта. Тип: int. Значение по умолчанию: 11\.
Диапазон: 4\...100\.;
#X msg 130 1537 @fontslant;
#X text 270 1537 Наклон шрифта. Тип: symbol. Значение по умолчанию:
roman. Разрешённые значения: roman \, italic.;
#X msg 130 1579 @fontweight;
#X text 270 1579 Толщину шрифта. Тип: symbol. Значение по умолчанию:
normal. Разрешённые значения: normal \, bold.;
#X msg 130 1621 @pinned;
#X text 270 1621 Режим закрепления. Если 1 - помещает элемент на самый
дальний уровень на холсте за другими элементам. Тип: bool. Значение
по умолчанию: 0\.;
#X msg 130 1678 @presetname;
