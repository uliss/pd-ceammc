#X obj 323 50 cnv 1 442 38 empty empty empty 17 7 0 10 -245760 -1 0;
#X text 328 50 простой формантный/вокальный синтезатор с банком фильтров
FOF-цикла.;
#X obj 1 1 cnv 5 765 40 empty empty synth.voice_fofc~ 20 20 0 20
