#X obj 653 8 conv.hsl2rgb;
#X obj 230 78 cnv 1 535 196 empty empty empty 17 7 0 10 -237178 -1 0;
#X text 240 83 Объект преобразует цветовые значения HSL (тон \, насыщенность
\, светлота) в значения RGB. Тон задаётся в диапазоне [0 \, 360] (в
градусах) \, а насыщенность и светлота — в диапазоне [0 \, 1]. По умолчанию
значения RGB выводятся как целые числа в диапазоне [0 \, 255] \, при
флаге @float они выводятся как числа с плавающей точкой в диапазоне
[0 \, 1]. По умолчанию три значения каналов отправляются на три отдельных
выхода \, если установлен флаг @pack \, они упаковываются в один список
и отправляются на первый выход. При флаге @sync объект выводит новое
значение при любом изменении на любом входе.;
#X obj 50 322 ui.hsl 0 360 @label HUE @label_inner 1 @show_value 1
@label_color 0.1 0.25 1;
