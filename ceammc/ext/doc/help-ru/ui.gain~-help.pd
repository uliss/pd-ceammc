#X msg 110 836 @amp;
#X text 245 836 Получить/Установить gain as amplitude ratio. Тип: float.
Значение по умолчанию: 0\.;
#X msg 110 878 @db;
#X text 245 878 Получить/Установить gain in dbfs scale. Тип: float.
Единицы: 'db'. Значение по умолчанию: -60\.;
#X msg 110 920 @max;
#X text 245 920 Получить/Установить maximum gain value. Тип: int. Единицы:
'db'. Значение по умолчанию: 0\. Диапазон: -12\...12\.;
#X msg 110 962 @min;
#X text 245 962 Получить/Установить minimal gain value. Тип: int. Единицы:
'db'. Значение по умолчанию: -60\. Диапазон: -90\...-15\.;
#X msg 110 1004 @mouse_events;
#X text 245 1004 Получить/Установить mouse events output mode. If on
outputs @mouse_down \, @mouse_up and @mouse_drag events. Тип: bool.
Значение по умолчанию: 0\.;
#X msg 110 1061 @output_value;
#X text 245 1061 Получить/Установить flag to output @db property after
each knob move. Тип: bool. Значение по умолчанию: 0\.;
#X msg 110 1103 @receive;
#X text 245 1103 Получить/Установить источник получения сообщений.
Тип: symbol. Значение по умолчанию: (null).;
#X msg 110 1145 @relative;
#X text 245 1145 Получить/Установить relative input mode. When set
do not jump to value on click. Тип: bool. Значение по умолчанию: 1\.;
#X msg 110 1187 @send;
#X text 245 1187 Получить/Установить адрес отправки сообщений. Тип:
symbol. Значение по умолчанию: (null).;
#X msg 110 1229 @show_range;
#X text 245 1229 Получить/Установить if show slider range. Тип: bool.
Значение по умолчанию: 1\.;
#X msg 110 1271 @midi_channel;
#X text 245 1271 Получить/Установить привязанный канал MIDI. Если установлен
в 0 - привязка ко всем каналам. Значения в диапазоне [1\..16] привязываются
к каналам первого Pd MIDI устройства \, [17\..32] - к каналам второго
и т.д. Тип: int. Значение по умолчанию: 0\. Диапазон: 0\...255\.;
#X msg 110 1374 @midi_control;
#X text 245 1374 Получить/Установить binded MIDI controller number.
-1 means not binded to any controller. Тип: int. Значение по умолчанию:
-1\. Диапазон: -1\...127\.;
#X msg 110 1431 @midi_pickup;
#X text 245 1431 Получить/Установить pickup current value. If slider
is binded to value \, first time you should pass over this value to
make binding. It prevents from sudden value change on first control
change. Тип: bool. Значение по умолчанию: 1\.;
#X msg 110 1518 @background_color;
#X text 245 1518 Получить/Установить цвета фона у объекта (список из
красного \, зеленого и синего значений в диапазоне [0\..1]). Тип: list.
Значение по умолчанию: 0.93 0.93 0.93 1\.;
#X msg 110 1575 @border_color;
#X text 245 1575 Получить/Установить цвет границы объекта (список из
красного \, зеленого и синего цветов в [0\..1] диапазоне). Тип: list.
Значение по умолчанию: 0.6 0.6 0.6 1\.;
#X msg 110 1632 @knob_color;
#X text 245 1632 Получить/Установить knob color (list of red \, green
\, blue values in 0-1 range). Тип: list. Значение по умолчанию: 0 0.75
1 1\.;
#X msg 110 1689 @fontname;
#X text 245 1689 Получить/Установить имя шрифта. Тип: symbol. Значение
