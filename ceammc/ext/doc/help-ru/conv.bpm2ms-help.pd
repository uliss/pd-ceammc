#X obj 660 8 conv.bpm2ms;
#X obj 230 93 cnv 1 535 136 empty empty empty 17 7 0 10 -237178 -1 0;
#X text 240 98 Объект преобразует значение темпа в BPM (удары в минуту)
в период между ударными долями в миллисекундах. Преобразование сводится
к (60 / BPM) * 1000 \, но объект делает патч более читаемым и самодокументируемым.
Результат можно использовать \, например \, для управления метрономом
или линией задержки \, синхронизированной с музыкальным темпом.;
