#X obj 681 8 envelope;
#X obj 230 78 cnv 1 535 215 empty empty empty 17 7 0 10 -237178 -1 0;
#X text 240 83 Тип данных для звуковой огибающей. Содержит точки \,
заданные временем и значением. Точка может иметь свойство «стоп» —
в этом случае выполнение огибающей останавливается на этой точке \,
что позволяет создавать многосегментные огибающие.;
#X text 240 168 Точка также имеет свойство типа сегмента \, которое
определяет кривую следующего сегмента. Это может быть *step* \, *line*
(по умолчанию) или *exp* (экспоненциальная).;
#X text 240 223 Экспоненциальный сегмент также имеет свойство кривизны:
0 (линейная) \, <0 (вогнутая \, отрицательная кривизна) \, >0 (выпуклая
\, положительная кривизна).;
#X msg 50 341 ar 100 200 \, bang;
#X msg 232 341 exp 0 30 -2 1 100 -4 0 40 4 0.5 30 2 0 \, bang;
#X msg 69 370 adsr 10 30 60 150 \, bang;
#X msg 318 370 line 0.1 40 0.9 20 0.3 60 0 \, bang;
#X msg 88 399 ear 10 -2 60 -2 \, bang;
#X msg 318 399 sigmoid 0 40 14 1 100 8 0 \, bang;
#X msg 107 428 eadsr 20 -5 70 -12 30 100 -7 \, bang;
#X msg 462 428 sin2 0 80 1 80 0 \, bang;
