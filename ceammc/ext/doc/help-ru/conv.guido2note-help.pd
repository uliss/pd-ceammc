#X obj 631 8 conv.guido2note;
#X obj 230 78 cnv 1 535 160 empty empty empty 17 7 0 10 -237178 -1 0;
#X text 240 83 Объект преобразует ноту \, записанную в нотации GUIDO
\, в MIDI-номер и длительность ноты в миллисекундах. На выход подаются
два значения: целочисленный MIDI-номер (из первого выхода) и длительность
в миллисекундах (из второго выхода). Длительность зависит от текущего
темпа \, который можно задать аргументом TEMPO или свойством @tempo.;
#X obj 240 202 ui.link @background_color 0.90196 0.90196 0.90196
