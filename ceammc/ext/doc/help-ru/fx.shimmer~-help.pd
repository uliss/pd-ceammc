#X msg 110 559 @id;
#X text 245 559 (при инициализации) Получить/Установить идентификатор
для OSC адреса. Если установлен \, все свойства объекта привязываются
к OSC адресам вида: /ИДЕНТИФИКАТОР/fx_shimmer/ИМЯ_СВОЙСТВА \, в противном
случае к /fx_shimmer/ИМЯ_СВОЙСТВА. Тип: symbol.;
#X msg 110 646 @osc;
#X text 245 646 (при инициализации) Получить/Установить имя OSC сервера.
Тип: symbol.;
#X msg 110 688 @active;
#X text 245 688 Turn вкл/выкл. обработку сигнала объектом. Тип: bool.
Значение по умолчанию: 1\.;
#X msg 110 730 @bypass;
#X text 245 730 Получить/Установить bypass flag. If true: bypass 'effected'
signal. Тип: bool. Значение по умолчанию: 0\.;
#X msg 110 772 @control;
#X text 245 772 Получить/Установить envelope follower to pitch shifter
influence coefficient. Тип: float. Значение по умолчанию: 0.5\. Диапазон:
0\...1\.;
#X msg 110 829 @damp_hf;
#X text 245 829 Получить/Установить Frequency (Hz) at which the high-frequency
T60 is half the middle-band's T60\. Тип: float. Единицы: 'Hz'. Значение
по умолчанию: 6000\. Диапазон: 1500\...47040\.;
#X msg 110 916 @decay_low;
#X text 245 916 Получить/Установить time (in seconds) to decay 60dB
in low-frequency band. Тип: float. Единицы: 'sec'. Значение по умолчанию:
3\. Диапазон: 1\...8\.;
#X msg 110 973 @decay_mid;
#X text 245 973 Получить/Установить time (in seconds) to decay 60dB
in mid-frequency band. Тип: float. Единицы: 'sec'. Значение по умолчанию:
2\. Диапазон: 1\...8\.;
#X msg 110 1030 @depth;
#X text 245 1030 Получить/Установить pitchshift modulation amplitude.
Тип: float. Значение по умолчанию: 0\. Диапазон: 0\...1\.;
#X msg 110 1072 @drywet;
#X text 245 1072 Получить/Установить proportion of mix between the
original (dry) and 'effected' (wet) signals. 0 - dry signal \, 1 -
wet. Тип: float. Значение по умолчанию: 0.5\. Диапазон: 0\...1\.;
#X msg 110 1129 @envelope;
#X text 245 1129 Получить/Установить amplitude-envelope time-constant
