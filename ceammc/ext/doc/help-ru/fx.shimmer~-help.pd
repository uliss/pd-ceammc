#X msg 130 501 @id;
#X text 270 501 (при инициализации) Идентификатор для OSC адреса. Если
установлен \, все свойства объекта привязываются к OSC адресам вида:
/ИДЕНТИФИКАТОР/fx_shimmer/ИМЯ_СВОЙСТВА \, в противном случае к /fx_shimmer/ИМЯ_СВОЙСТВА.
Тип: symbol.;
#X msg 130 588 @osc;
#X text 270 588 (при инициализации) Имя OSC сервера. Тип: symbol.;
#X msg 130 618 @active;
#X text 270 618 Вкл/выкл. обработку сигнала объектом. Тип: bool. Значение
по умолчанию: 1\.;
#X msg 130 660 @bypass;
#X text 270 660 Bypass flag. If true: bypass 'effected' signal. Тип:
bool. Значение по умолчанию: 0\.;
#X msg 130 702 @control;
#X text 270 702 Envelope follower to pitch shifter influence coefficient.
Тип: float. Значение по умолчанию: 0.5\. Диапазон: 0\...1\.;
#X msg 130 759 @damp_hf;
#X text 270 759 Frequency (Hz) at which the high-frequency T60 is half
the middle-band's T60\. Тип: float. Единицы: 'Hz'. Значение по умолчанию:
6000\. Диапазон: 1500\...47040\.;
#X msg 130 816 @decay_low;
#X text 270 816 Time (in seconds) to decay 60dB in low-frequency band.
Тип: float. Единицы: 'sec'. Значение по умолчанию: 3\. Диапазон: 1\...8\.;
#X msg 130 873 @decay_mid;
#X text 270 873 Time (in seconds) to decay 60dB in mid-frequency band.
Тип: float. Единицы: 'sec'. Значение по умолчанию: 2\. Диапазон: 1\...8\.;
#X msg 130 930 @depth;
#X text 270 930 Pitchshift modulation amplitude. Тип: float. Значение
по умолчанию: 0\. Диапазон: 0\...1\.;
#X msg 130 972 @drywet;
#X text 270 972 Proportion of mix between the original (dry) and 'effected'
(wet) signals. 0 - dry signal \, 1 - wet. Тип: float. Значение по умолчанию:
0.5\. Диапазон: 0\...1\.;
#X msg 130 1029 @envelope;
#X text 270 1029 Amplitude-envelope time-constant going down. Тип:
float. Единицы: 'sec'. Значение по умолчанию: 1\. Диапазон: 0.1\...3\.;
#X msg 130 1086 @freq_low;
#X text 270 1086 Crossover frequency (Hz) separating low and middle
frequencies. Тип: float. Единицы: 'Hz'. Значение по умолчанию: 200\.
Диапазон: 50\...1000\.;
#X msg 130 1143 @mode;
#X text 270 1143 Correlation between pitchshift. Тип: int. Значение
по умолчанию: 0\. Диапазон: -3\...3\.;
#X msg 130 1185 @ps_drywet;
#X text 270 1185 Proportion of mix between original and pitchshift
signal in shimmer feedback. Тип: float. Значение по умолчанию: 0.5\.
Диапазон: 0\...1\.;
#X msg 130 1242 @shift;
#X text 270 1242 Frequency shifting. Тип: float. Единицы: 'semitone'.
Значение по умолчанию: 12\. Диапазон: -12\...12\.;
#X msg 130 1284 @speed;
#X text 270 1284 Pitchshift modulation frequency. Тип: float. Единицы:
'Hz'. Значение по умолчанию: 0.1\. Диапазон: 0.1\...10\.;
