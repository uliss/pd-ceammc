#X obj 250 1077 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 1077 @spi_cs;
#X text 270 1077 (при инициализации) Индекс SPI CS (Chip Select/Enable).
