\, STEPPER \, ENCODER \, SERIAL \, PULLUP.;
#X obj 250 999 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 999 pin_state?;
#X text 270 999 query pin state. The pin state is any data written
to the pin (it is important to note that pin state != pin value). For
output modes (digital output \, PWM \, and Servo) \, the state is any
value that has been previously written to the pin. For input modes
\, typically the state is zero. However \, for digital inputs \, the
state is the status of the pull-up resistor which is 1 if enabled \,
0 if disabled. Returns message like [pin_state PIN# MODE state( \,
where # is pin number. Аргументы:;
#X obj 300 1145 cnv 1 37 21 empty empty empty 17 7 0 10 -245695 -1 0;
#X text 300 1145 PIN#: pin number. Тип: int.;
#X obj 250 1178 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
#X msg 130 1178 report_apin;
#X text 270 1178 turns on/off analog pin (A0-A6) value reporting. Аргументы:;
#X obj 300 1203 cnv 1 83 21 empty empty empty 17 7 0 10 -245695 -1 0;
#X text 300 1203 ANALOG_PIN: analog pin number. Тип: int.;
#X obj 300 1226 cnv 1 45 21 empty empty empty 17 7 0 10 -245695 -1 0;
#X text 300 1226 VALUE: value. If 1 - activates analog reporting \,
messages like [apin PIN# value( are returned every sampling interval
(by default 19ms). Тип: int. Разрешённые значения: 0 \, 1\.;
#X obj 250 1304 cnv 1 515 1 empty empty empty 17 7 0 10 -216373 -1 0;
