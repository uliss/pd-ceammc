#X text 412 50 преобразует номер ступени лада в номер клавиши;
#X obj 1 1 cnv 5 765 40 empty empty conv.degree2key 20 20 0 20 -104026
-4096 0;
#X obj 365 11 ui.link @background_color 0.39216 0.39216 0.39216 @title
[ceammc/degree->key] @url conv.degree2key-help.pd;
