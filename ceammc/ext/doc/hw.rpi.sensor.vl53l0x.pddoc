<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="hw.rpi.sensor.vl53l0x">
        <title>hw.rpi.sensor.vl53l0x</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">time-of-flight (ToF) laser-ranging sensor on VL53L0X chip for
                Raspberry Pi</tr>
                <tr lang="ru">лазерный дальномер на чипе VL53L0X для Raspberry Pi</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>hw</category>
            <keywords>raspberry tof sensor laser</keywords>
            <since>0.9.8</since>
        </meta>
        <info>
            <par>It can measure absolute distances up to 2m</par>
        </info>
        <properties>
            <!-- @i2c_addr -->
            <property name="@i2c_addr" type="int" default="-1" access="initonly" minvalue="-4"
            maxvalue="119">
                <tr lang="en">I²C address. The value 'default' means default device I²C address
                (0x29)</tr>
            </property>
            <!-- @i2c_bus -->
            <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none"
            access="initonly">
                <tr lang="en">I²C bus</tr>
            </property>
        </properties>
        <methods>
            <!-- address -->
            <method name="address">set sensor i2c address. Note that the address resets when the
            device is powered off 
            <param name="ADDR" type="int" minvalue="8" maxvalue="119" required="true">new i2c
            address</param></method>
            <!-- poll -->
            <method name="poll">turn the sensor polling on/off 
            <param name="STATE" type="bool" required="true">poll state</param></method>
        </methods>
        <inlets>
            <inlet>
                <xinfo on="bang">single distance measure</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>float: distance in mm</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[T]
|
[poll $1(
|
|  [B]
|  |
[hw.rpi.sensor.vl53l0x @i2c_bus default]
|
[print]


[ui.link @url=ceammc://img/conn_vl53l0x.png @title=Connection_Scheme]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
