<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="hw.rpi.sensor.vl53l0x">
    <title>hw.rpi.sensor.vl53l0x</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">time-of-flight (ToF) laser-ranging sensor on VL53L0X chip for Raspberry
        Pi</tr>
        <tr lang="ru">лазерный дальномер на чипе VL53L0X для Raspberry Pi</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>hw</category>
      <keywords>raspberry tof sensor laser</keywords>
      <since>0.9.8</since>
    </meta>
    <info>
      <par>
        <tr lang="en">It can measure absolute distances up to 2m</tr>
        <tr lang="ru" finished="false">Он может измерять абсолютные расстояния до 2 м.</tr>
      </par>
    </info>
    <properties>
      <!-- @i2c_addr -->
      <property name="@i2c_addr" type="int" default="-1" access="initonly" minvalue="-4"
      maxvalue="119">
        <tr lang="en">I²C address. The value 'default' means default device I²C address (0x29)</tr>
        <!-- old: Адрес I²C. Значение «default» означает адрес I²C
                устройства по умолчанию (0x29) -->
        <!-- old: Адрес I2C. Значение «по умолчанию» означает адрес
                I2C устройства по умолчанию (0x29) -->
        <tr lang="ru" finished="false">Адрес I2C. Значение «по умолчанию» означает адрес I2C
        устройства по умолчанию (0x29)</tr>
      </property>
      <!-- @i2c_bus -->
      <property name="@i2c_bus" type="atom" default="none" enum="1 2 3 4 5 6 default none"
      access="initonly">
        <tr lang="en">I²C bus</tr>
        <tr lang="ru">шина I²C</tr>
      </property>
    </properties>
    <methods>
      <!-- address -->
      <method name="address">
        <info>
          <tr lang="en">set sensor i2c address. Note that the address resets when the device is
          powered off</tr>
          <!-- old: Настройка датчика i2c адреса. Обратите внимание,
                    что адрес сбрасывается, когда устройство выключено -->
          <tr lang="ru" finished="false">Настройка датчика i2c адреса. Обратите внимание, что адрес
          сбрасывается, когда устройство выключено</tr>
        </info>
        <param name="ADDR" type="int" minvalue="8" maxvalue="119" required="true">
          <tr lang="en">new i2c address</tr>
          <tr lang="ru" finished="false">Новый i2c адрес</tr>
        </param>
      </method>
      <!-- poll -->
      <method name="poll">
        <info>
          <tr lang="en">turn the sensor polling on/off</tr>
          <tr lang="ru" finished="false">Включить / выключить сенсорный опрос</tr>
        </info>
        <param name="STATE" type="bool" required="true">
          <tr lang="en">poll state</tr>
          <tr lang="ru" finished="false">государство</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in on="bang">
          <tr lang="en">single distance measure</tr>
          <tr lang="ru" finished="false">одномерное расстояние</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">float: distance in mm</tr>
          <tr lang="ru" finished="false">Поплавок: расстояние в мм</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[T]
|
[poll $1(
|
|  [B]
|  |
[hw.rpi.sensor.vl53l0x @i2c_bus default]
|
[print]


[ui.link @url=ceammc://img/conn_vl53l0x.png @title=Connection_Scheme]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
