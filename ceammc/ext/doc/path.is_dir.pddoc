<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="path.is_dir">
    <title>path.is_dir</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">checks if the path is a directory</tr>
        <tr lang="ru">проверяет, является ли путь каталогом</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>path</category>
      <keywords>path dir</keywords>
      <since>0.9</since>
    </meta>
    <info>
      <par>
        <tr lang="en">the object checks whether the given path exists and is a directory</tr>
        <tr lang="ru">объект проверяет, существует ли заданный путь и является ли он каталогом</tr>
      </par>
      <par>
        <tr lang="en">the first outlet outputs 1 if the path is a directory, otherwise 0</tr>
        <tr lang="ru">первый выход выдаёт 1, если путь является каталогом, иначе 0</tr>
      </par>
      <par>
        <tr lang="en">the second outlet outputs the path itself if it is a directory</tr>
        <tr lang="ru">второй выход выдаёт сам путь, если он является каталогом</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to validate a directory path before reading or writing
        files in it</tr>
        <tr lang="ru">объект можно использовать для проверки пути к каталогу перед чтением или
        записью файлов в нём</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="symbol">
          <tr lang="en">output 1 if the given path is found and is a directory, otherwise 0</tr>
          <tr lang="ru">выдаёт 1, если заданный путь найден и является каталогом, иначе 0</tr>
        </in>
        <in on="data:string">
          <tr lang="en">same as for symbol</tr>
          <tr lang="ru">то же, что для символа</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="int">
          <tr lang="en">1 or 0</tr>
          <tr lang="ru">1 или 0</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">output path if it is a directory</tr>
          <tr lang="ru">вывести путь, если это каталог</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[symbol ~( [symbol abc(
|          |
[path.is_dir #x]
|
[ui.dt]

          [ui.dt #a]
[X x:1->a]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
