<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.12">
    <object name="list.any_of">
        <title>list.any_of</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">checks whether at least one list element has been accepted by the
                processing sidechain</tr>
                <tr lang="ru">проверяет, был ли принят хотя бы один элемент списка предикатом
                боковой цепи обработки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list predicate any</keywords>
            <since>0.1</since>
            <also>
                <see>list.all_of</see>
                <see>list.none_of</see>
            </also>
        </meta>
        <info>
            <par>Note: also data.mlist</par>
        </info>
        <inlets>
            <inlet>
                <xinfo on="list">Input list</xinfo>
                <xinfo on="data">Input mlist</xinfo>
            </inlet>
            <inlet>
                <xinfo on="float" minvalue="0" maxvalue="1">input value from predicate. "1" means
                accepted. "0" means reject.</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>1 - if predicate object returns true for all the elements or list is empty or 0
            otherwise.</outlet>
            <outlet>atom to predicate</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2( [1 2 3 4( [\(1 2 3 5), bang(
|     |         |
|     |         [ml]
|     |         |
[list.any_of    ] X [> 3]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
