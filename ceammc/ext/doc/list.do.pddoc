<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="list.do">
    <title>list.do</title>
    <meta>
      <authors>
        <author>Alex Nadzharov</author>
      </authors>
      <description>
        <tr lang="en">iterate and modify the list contents via a side-chain</tr>
        <tr lang="ru">итерирует и изменяет содержимое списка через боковую цепь</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>list</category>
      <keywords>list iterate</keywords>
      <since>0.5</since>
      <also>
        <see>list.each</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">the object passes each element of the input list through the side-chain one by one and collects the processed values into a new list</tr>
        <tr lang="ru">объект поочерёдно передаёт каждый элемент входного списка через боковую цепь и собирает обработанные значения в новый список</tr>
      </par>
      <par>
        <tr lang="en">the second outlet outputs for each element: ATOM INDEX TOTAL, which can be used in the side-chain to compute a new value for the element</tr>
        <tr lang="ru">второй выход для каждого элемента выдаёт ATOM INDEX TOTAL — эти данные можно использовать в боковой цепи, чтобы вычислить новое значение элемента</tr>
      </par>
      <par>
        <tr lang="en">the object can be used to apply a formula to each list element, for example to normalize a list or to transform note numbers</tr>
        <tr lang="ru">объект можно использовать для применения формулы к каждому элементу списка, например чтобы нормализовать список или преобразовать номера нот</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">input list</tr>
          <tr lang="ru">входной список</tr>
        </in>
        <in on="data">
          <tr lang="en">input MList</tr>
          <tr lang="ru">входной MList</tr>
        </in>
      </inlet>
      <inlet>
        <in on="atom">
          <tr lang="en">processed atom from the side-chain</tr>
          <tr lang="ru">обработанный атом из боковой цепи</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">output processed list</tr>
          <tr lang="ru">выход обработанного списка</tr>
        </out>
      </outlet>
      <outlet>
        <out type="any">
          <tr lang="en">output for each list element: ATOM INDEX TOTAL</tr>
          <tr lang="ru">выход для каждого элемента списка: ATOM INDEX TOTAL</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[1 1 1 1 1(
|
[list.do #x1] X [expr $f1 - ($f2 / $f3)]
|
[ui.dt]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
