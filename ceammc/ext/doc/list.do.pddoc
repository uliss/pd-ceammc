<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.do">
        <title>list.do</title>
        <meta>
            <authors>
                <author>Alex Nadzharov</author>
            </authors>
            <description>
                <tr lang="en">iterate and modify the list contents via a side-chain</tr>
                <tr lang="ru">итерирование и изменение содержимого списка через боковую цепь
                обработки</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list iterate</keywords>
            <since>0.5</since>
            <also>
                <see>list.each</see>
            </also>
        </meta>
        <inlets>
            <inlet>
                <in on="list">
                    <tr lang="en">input list</tr>
                    <tr lang="ru" finished="false">вводный список</tr>
                </in>
                <in on="data">
                    <tr lang="en">input mlist</tr>
                    <tr lang="ru" finished="false">входной млечный</tr>
                </in>
            </inlet>
            <inlet>
                <in on="atom">
                    <tr lang="en">processed atom from side-chain</tr>
                    <tr lang="ru" finished="false">Обработанный атом из боковой цепи</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">output processed list</tr>
                    <tr lang="ru" finished="false">Перечень обработанных данных</tr>
                </out>
            </outlet>
            <outlet>
                <out type="any">
                    <tr lang="en">output per each list element: ATOM INDEX TOTAL</tr>
                    <tr lang="ru" finished="false">выход для каждого элемента списка: ATOM INDEX
                    TOTAL</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 1 1 1 1(
|
[list.do #x1] X [expr $f1 - ($f2 / $f3)]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
