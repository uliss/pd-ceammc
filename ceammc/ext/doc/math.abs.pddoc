<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="math.abs">
    <title>math.abs</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">absolute value function</tr>
        <tr lang="ru">абсолютное значение</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>math</category>
      <keywords>math abs</keywords>
      <also>
        <see>math.floor</see>
      </also>
      <since>0.1</since>
    </meta>
    <info>
      <par>
        <tr lang="en">computes the absolute value of the float number input</tr>
        <tr lang="ru">вычисляет абсолютное значение входных чисел</tr>
      </par>
    </info>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input value</tr>
          <tr lang="ru">входное значение</tr>
        </in>
        <in on="list">
          <tr lang="en">list of numeric input values, non-numeric values are replaced with 0</tr>
          <tr lang="ru">список числовых входных значений, нечисловые значения заменяются на 0</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="float">
          <tr lang="en">the result</tr>
          <tr lang="ru">результат</tr>
        </out>
        <out type="list">
          <tr lang="en">the result list</tr>
          <tr lang="ru">список результатов</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F]                  [array \$0-abs yr=0..1 w=320]
|
[math.abs]
|
[ui.dt]

[bang(
|
[list.seq -1 1 0.025]
|
[math.abs]
|
[list->array \$0-abs]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
