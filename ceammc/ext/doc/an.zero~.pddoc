<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="an.zero~">
    <title>an.zero~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">calculate the signal zero crossing count/rate/freq</tr>
        <tr lang="ru">вычисляет число, скорость или частоту пересечений сигналом нуля</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>an</category>
      <keywords>zero crossing rate count freq</keywords>
      <since>0.9.5</since>
      <also>
        <see>an.pitchtrack~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">Analyzes the incoming audio signal and outputs how often it crosses zero. The
        result depends on the @mode property: 'count' outputs the raw number of zero crossings per
        analysis block, 'rate' outputs the zero crossing rate (number of crossings divided by block
        size) and 'freq' outputs the zero crossing frequency in hertz. In the special @clock mode
        the object outputs a short impulse at each zero crossing, which can be used as a
        trigger.</tr>
        <tr lang="ru">Анализирует входящий аудиосигнал и выводит, как часто он пересекает ноль.
        Результат зависит от свойства @mode: 'count' выводит «сырое» число пересечений нуля за блок
        анализа, 'rate' — скорость пересечения нуля (число пересечений, делённое на размер блока),
        'freq' — частоту пересечения нуля в герцах. В специальном режиме @clock объект выдаёт
        короткий импульс на каждом пересечении нуля, который можно использовать как триггер.</tr>
      </par>
    </info>
    <properties>
      <!-- @bs -->
      <property name="@bs" type="int" minvalue="1" default="1024" maxvalue="65536" units="sample"
      access="initonly">
        <tr lang="en">buffer size</tr>
        <tr lang="ru">размер буфера</tr>
      </property>
      <!-- @clock -->
      <property name="@clock" type="list" default="0" access="initonly">
        <tr lang="en">alias for @mode count @bs 1. Outputs an impulse at each zero crossing</tr>
        <tr lang="ru">сокращение для @mode count @bs 1. Выводит импульс при каждом пересечении
        нуля</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" enum="count rate freq" default="count">
        <tr lang="en">calculation mode: 'count' — outputs the number of zero crossings that
        occurred within the current block size, 'rate' — outputs the zero crossing rate (number of
        crossings divided by block size), 'freq' — outputs the zero crossing frequency in
        hertz</tr>
        <tr lang="ru">режим вычисления: 'count' — выводит число пересечений нуля в пределах
        текущего размера блока, 'rate' — выводит скорость пересечения нуля (число пересечений,
        делённое на размер блока), 'freq' — выводит частоту пересечения нуля в герцах</tr>
      </property>
    </properties>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal for analysis</tr>
          <tr lang="ru">входной сигнал для анализа</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out>
          <tr lang="en">zero crossing count/freq/rate depending on the @mode property</tr>
          <tr lang="ru">число, частота или скорость пересечения нуля в зависимости от свойства
          @mode</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[F digit=8]     [ui.dsp~]
|
|
[osc~     ]
|    |    |
|    |    [an.zero~ #c]
|    |    |
|    |    [ui.n~]
|    |
|    [an.zero~ #b]
|    |
|    [ui.n~]
|
[an.zero~ #a]
|
[ui.n~]

[F digit=8]
|
[osc~]
|
[an.zero~ @clock]
|
[ui.hgain~]
|\
[dac~]
#a @mode count
#b @mode rate
#c @mode freq
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
