<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env.follow~">
    <title>env.follow~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">envelope follower with independent attack and release times</tr>
        <tr lang="ru">детектор огибающей с независимой атакой и временем отпускания</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>envelope amplitude follower</keywords>
      <since>0.1</since>
      <also>
        <see>env.adsr~</see>
      </also>
    </meta>
    <arguments>
      <argument name="ATTACK" type="float" units="millisecond" minvalue="1" maxvalue="1000">
        <tr lang="en">attack time</tr>
        <tr lang="ru" finished="false">Время атаки</tr>
      </argument>
      <argument name="RELEASE" type="float" units="millisecond" minvalue="1" maxvalue="1000">
        <tr lang="en">release time</tr>
        <tr lang="ru" finished="false">Время освобождения</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @attack -->
      <property name="@attack" type="float" minvalue="1" maxvalue="1000" default="200"
      units="millisecond">
        <tr lang="en">attack time</tr>
        <tr lang="ru" finished="false">Время атаки</tr>
      </property>
      <!-- @release -->
      <property name="@release" type="float" minvalue="1" maxvalue="1000" default="200"
      units="millisecond">
        <tr lang="en">release time</tr>
        <tr lang="ru" finished="false">Время освобождения</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">reset envelope follower to initial state</tr>
          <!-- old: Перезагрузить конверт последователя начального
                    состояния -->
          <tr lang="ru" finished="false">Перезагрузить конверт последователя начального
          состояния</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru" finished="false">входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">amplitude envelope that follows the absolute value going up/down</tr>
          <tr lang="ru" finished="false">амплитудная оболочка, которая следует за абсолютным
          значением, идущим вверх/вниз</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[osc~ 440] [F]
|          |    [F]
| [dbtorms ]    |
| |.            [@attack $1(
[*~]            |
|               |
[env.follow~ 50 200]
|
[ui.n~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
