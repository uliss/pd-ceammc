<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="env.follow~">
    <title>env.follow~</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">envelope follower with independent attack and release times</tr>
        <tr lang="ru">детектор огибающей с независимыми временами атаки и восстановления</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>env</category>
      <keywords>envelope amplitude follower</keywords>
      <since>0.1</since>
      <also>
        <see>env.adsr~</see>
      </also>
    </meta>
    <info>
      <par>
        <tr lang="en">An envelope follower: tracks the amplitude of the incoming audio signal and
        outputs a smooth control signal representing its current level. The follower uses
        independent attack and release times, so rising and falling portions of the signal can be
        smoothed at different rates.</tr>
        <tr lang="ru">Детектор огибающей: отслеживает амплитуду входящего аудиосигнала и выводит
        сглаженный управляющий сигнал, отражающий её текущий уровень. Детектор использует
        независимые времена атаки и восстановления, поэтому нарастающие и затухающие участки
        сигнала могут сглаживаться с разной скоростью.</tr>
      </par>
      <par>
        <tr lang="en">Typical use cases:</tr>
        <tr lang="ru">Типичные сценарии применения:</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Envelope-controlled effects — driving the amount of distortion, filter
        cutoff, or modulation depth from the current level of the input signal, so that the effect
        reacts to the music.</tr>
        <tr lang="ru">• Эффекты, управляемые огибающей — управление степенью дисторшна, срезом
        фильтра или глубиной модуляции по текущему уровню входного сигнала, чтобы эффект реагировал
        на музыку.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Side-chain compression and gating — using the follower output as a control
        signal for a compressor or gate, so that another signal is reduced or opened based on the
        level of the source.</tr>
        <tr lang="ru">• Сайдчейн-компрессия и гейтирование — использование выхода детектора в
        качестве управляющего сигнала для компрессора или гейта, чтобы другой сигнал снижался или
        открывался в зависимости от уровня источника.</tr>
      </par>
      <par indent="1">
        <tr lang="en">• Automatic gain control — keeping the output level of a signal roughly
        constant by adjusting gain according to the follower output.</tr>
        <tr lang="ru">• Автоматическая регулировка усиления — поддержание примерно постоянного
        уровня выходного сигнала путём изменения усиления в соответствии с выходом детектора.</tr>
      </par>
    </info>
    <arguments>
      <argument name="ATTACK" type="float" units="millisecond" minvalue="1" maxvalue="1000">
        <tr lang="en">attack time</tr>
        <tr lang="ru">время атаки</tr>
      </argument>
      <argument name="RELEASE" type="float" units="millisecond" minvalue="1" maxvalue="1000">
        <tr lang="en">release time</tr>
        <tr lang="ru">время восстановления</tr>
      </argument>
    </arguments>
    <properties>
      <xi:include href="props_osc.xml" />
      <xi:include href="props_id.xml" />
      <xi:include href="props_active.xml" />
      <!-- @attack -->
      <property name="@attack" type="float" minvalue="1" maxvalue="1000" default="200"
      units="millisecond">
        <tr lang="en">attack time</tr>
        <tr lang="ru">время атаки</tr>
      </property>
      <!-- @release -->
      <property name="@release" type="float" minvalue="1" maxvalue="1000" default="200"
      units="millisecond">
        <tr lang="en">release time</tr>
        <tr lang="ru">время восстановления</tr>
      </property>
    </properties>
    <methods>
      <!-- reset -->
      <method name="reset">
        <info>
          <tr lang="en">resets the envelope follower to its initial state</tr>
          <tr lang="ru">возвращает детектор огибающей в начальное состояние</tr>
        </info>
      </method>
    </methods>
    <inlets>
      <inlet type="audio">
        <in>
          <tr lang="en">input signal</tr>
          <tr lang="ru">входной сигнал</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet type="audio">
        <out type="any">
          <tr lang="en">amplitude envelope that follows the absolute value as it rises and
          falls</tr>
          <tr lang="ru">амплитудная огибающая, следующая за абсолютным значением при его
          возрастании и убывании</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[osc~ 440] [F]
|          |    [F]
| [dbtorms ]    |
| |.            [@attack $1(
[*~]            |
|               |
[env.follow~ 50 200]
|
[ui.n~]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
