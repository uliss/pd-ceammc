<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.bits2note">
    <title>conv.bits2note</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">convert list of bits into note, velocity pairs</tr>
        <tr lang="ru">преобразует список битов в пары «номер ноты, сила нажатия»</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv bits note poly</keywords>
      <since>0.9.2</since>
      <aliases>
        <alias>ceammc/bits-&gt;note</alias>
        <alias>bits-&gt;note</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object takes a list of bits (0s and 1s) and turns each bit into a note
        event, using the note numbers provided in the KEYS argument (or the @keys property). In the
        default mode each bit corresponds to its own outlet, and a pair (NOTE VEL) is sent to that
        outlet. If the bit is 1, the velocity is @vel, if the bit is 0, the velocity is 0 (note
        off).</tr>
        <tr lang="ru">Объект принимает список битов (0 и 1) и превращает каждый бит в событие ноты,
        используя номера нот из аргумента KEYS (или свойства @keys). В режиме по умолчанию каждому
        биту соответствует отдельный выход, и на этот выход отправляется пара (NOTE VEL). Если бит
        равен 1, скорость равна @vel, если бит равен 0, скорость равна 0 (выключение ноты).</tr>
      </par>
      <par>
        <tr lang="en">In @poly mode a single outlet is used, and instead of a (NOTE VEL) pair a
        (VOICE NOTE VEL) triplet is sent — this is convenient for use with the [clone] object,
        where VOICE identifies the clone instance.</tr>
        <tr lang="ru">В режиме @poly используется один выход, и вместо пары (NOTE VEL) отправляется
        триплет (VOICE NOTE VEL) — это удобно при работе с объектом [clone], где VOICE
        идентифицирует экземпляр клона.</tr>
      </par>
    </info>
    <arguments>
      <argument name="KEYS" type="list">
        <tr lang="en">list of note numbers to assign to bits</tr>
        <tr lang="ru">список номеров нот, привязанных к битам</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @keys -->
      <property name="@keys" type="list" default="" access="initonly">
        <tr lang="en">list of note numbers to assign to bits</tr>
        <tr lang="ru">список номеров нот, привязанных к битам</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" default="off" enum="off tie raw">
        <tr lang="en">mode for repeated notes. If 'off': send note off before retriggering. If
        'tie': ignore repeated events. If 'raw': always send on/off events</tr>
        <tr lang="ru">режим для повторяющихся нот. Если 'off': перед повторным запуском
        отправляется событие выключения ноты. Если 'tie': повторяющиеся события игнорируются. Если
        'raw': всегда отправляются события включения и выключения</tr>
      </property>
      <!-- @poly -->
      <property name="@poly" type="flag" default="0" access="initonly">
        <tr lang="en">polyphonic mode for using with the [clone] object</tr>
        <tr lang="ru">полифонический режим для использования с объектом [clone]</tr>
      </property>
      <!-- @vel -->
      <property name="@vel" type="float" minvalue="0" maxvalue="127" default="90">
        <tr lang="en">output velocity</tr>
        <tr lang="ru">сила нажатия ноты на выходе</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="list">
          <tr lang="en">input bit list</tr>
          <tr lang="ru">входной список битов</tr>
        </in>
      </inlet>
    </inlets>
    <outlets dynamic="true">
      <outlet>
        <out type="any">
          <tr lang="en">output</tr>
          <tr lang="ru">выход</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[bang(
|
[ui.hrd* 4]  [ui.tab tie off raw]
|            |
|            [@mode $2(
|            |
[bits->note 60 70 80 90 @vel 100]
|         ^|        ^^|       ^^^|
[ui.d #a] [ui.d #a] [ui.d #a] [ui.d #a]


[bang(
|
[ui.hrd* 4]  [ui.tab tie off raw]
|            |
|            [@mode $2(
|            |
[bits->note 60 70 80 90 @vel 100 @poly]
|
[ui.dt]

#a @auto_size 0 @size 50 18
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
