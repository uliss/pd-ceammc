<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.max">
        <title>list.max</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">output the largest list element</tr>
                <tr lang="ru">выводит самый большой элемент в списке</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list max compare</keywords>
            <since>0.1</since>
            <also>
                <see>list.min</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">By default returns largest float in list, this equal to using @float
                property.</tr>
            </par>
            <par>
                <tr lang="en">Also you can choose largest symbol from list, using @symbol
                property.</tr>
            </par>
        </info>
        <properties>
            <!-- @any -->
            <property name="@any" type="alias">
                <tr lang="en">alias for @type any. Find greatest atom of any type. Note: symbols
                are greater then numbers</tr>
            </property>
            <!-- @float -->
            <property name="@float" type="alias">
                <tr lang="en">alias for @type float. Find max float element in list</tr>
            </property>
            <!-- @symbol -->
            <property name="@symbol" type="alias">
                <tr lang="en">alias for @type symbol. Find greatest symbol element</tr>
            </property>
            <!-- @type -->
            <property name="@type" type="symbol" enum="float symbol any" default="float">
                <tr lang="en">type of largest element</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="list">
                    <tr lang="en">input list</tr>
                </xinfo>
                <xinfo on="data:mlist">
                    <tr lang="en">input mlist</tr>
                </xinfo>
                <xinfo on="float">
                    <tr lang="en">passed thru in @float or @any mode</tr>
                </xinfo>
                <xinfo on="symbol">
                    <tr lang="en">passed thru in @symbol or @any mode</tr>
                </xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>largest element</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[1 2 3 a b(  [list a b c(  [1 2 3 a b(  [list a aa ab ac(
|            |             |            |
|            |             |            |
[list.max @float]          [list.max @symbol]
|                          |
[F]                        [S digits=10]

[1 a 2 b 3 c( [F]    [S digits=8]
|             |      |
|             |      |
[list.max @any       ]
|
[ui.dt]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
