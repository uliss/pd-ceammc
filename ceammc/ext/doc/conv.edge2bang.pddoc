<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="conv.edge2bang">
    <title>conv.edge2bang</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">edge detector for numeric stream</tr>
        <tr lang="ru">детектор перехода для числового потока</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>conv</category>
      <keywords>conv edge detector</keywords>
      <since>0.9.4</since>
      <aliases>
        <alias>ceammc/edge-&gt;bang</alias>
        <alias>edge-&gt;bang</alias>
      </aliases>
    </meta>
    <info>
      <par>
        <tr lang="en">The object detects edges (transitions) in a stream of numeric values: when
        the input changes from a low value to a high value, from a high value to a low value, or
        both. On a detected edge a bang is sent to the outlet. The behavior is controlled by the
        @mode property: 'up' — only rising edges, 'down' — only falling edges, 'both' — both
        types.</tr>
        <tr lang="ru">Объект обнаруживает переходы (фронты) в потоке числовых значений: когда
        входное значение меняется с низкого на высокое, с высокого на низкое, или и то и другое.
        При обнаружении перехода на выход отправляется bang. Поведение управляется свойством
        @mode: 'up' — только восходящие фронты, 'down' — только нисходящие, 'both' — оба
        типа.</tr>
      </par>
    </info>
    <properties>
      <!-- @both -->
      <property name="@both" type="alias">
        <tr lang="en">alias to @mode both</tr>
        <tr lang="ru">сокращение для @mode both</tr>
      </property>
      <!-- @down -->
      <property name="@down" type="alias">
        <tr lang="en">alias to @mode down</tr>
        <tr lang="ru">сокращение для @mode down</tr>
      </property>
      <!-- @mode -->
      <property name="@mode" type="symbol" enum="up down both" default="up">
        <tr lang="en">edge detection mode. If 'up': outputs a bang when the input value changes
        from low to high. If 'down': from high to low. If 'both': in both cases</tr>
        <tr lang="ru">режим обнаружения фронта. Если 'up': выводит bang при изменении входного
        значения с низкого на высокое. Если 'down': с высокого на низкое. Если 'both': в обоих
        случаях</tr>
      </property>
      <!-- @up -->
      <property name="@up" type="alias">
        <tr lang="en">alias to @mode up</tr>
        <tr lang="ru">сокращение для @mode up</tr>
      </property>
    </properties>
    <inlets>
      <inlet>
        <in on="float">
          <tr lang="en">input value</tr>
          <tr lang="ru">входное значение</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">bang on edge</tr>
          <tr lang="ru">bang при обнаружении фронта</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[phasor~ 0.5]      [phasor~ 0.5]     [lfo.tri~ 0.5]
|                  |                 |
[s->f~]            [*~ -1]           [s->f~]
|                  |                 |
[F]                [s->f~]           [F]
|                  |                 |
[edge->bang @down] [F]               [edge->bang @both]
|                  |                 |
[B]                [edge->bang @up]  [B]
                   |
[ui.dsp~]          [B]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
