<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.16">
  <object name="midi.kbd">
    <title>midi.kbd</title>
    <meta>
      <authors>
        <author>Serge Poltavsky</author>
      </authors>
      <description>
        <tr lang="en">computer keyboard MIDI emulator</tr>
        <tr lang="ru">эмулятор MIDI-клавиатуры с помощью клавиатуры компьютера</tr>
      </description>
      <license>GPL3 or later</license>
      <library>ceammc</library>
      <category>midi</category>
      <keywords>midi keyboard</keywords>
      <since>0.9.3</since>
    </meta>
    <info>
      <par>
        <tr lang="en">Default keyboard layout is QWERTY, but you can specify a custom one</tr>
        <tr lang="ru">раскладка клавиатуры по умолчанию — QWERTY, но можно указать собственную</tr>
      </par>
    </info>
    <arguments>
      <argument name="LAYOUT" type="symbol" enum="qwerty names custom">
        <tr lang="en">layout name</tr>
        <tr lang="ru">название раскладки</tr>
      </argument>
      <argument name="ON" type="bool">
        <tr lang="en">initial on/off state</tr>
        <tr lang="ru">начальное состояние вкл/выкл</tr>
      </argument>
    </arguments>
    <properties>
      <!-- @custom -->
      <property name="@custom" type="atom" default="[]">
        <tr lang="en">custom layout (Dict data type)</tr>
        <tr lang="ru">пользовательская раскладка (тип данных Dict)</tr>
      </property>
      <!-- @layout -->
      <property name="@layout" type="symbol" enum="qwerty names custom" default="qwerty">
        <tr lang="en">current layout</tr>
        <tr lang="ru">текущая раскладка</tr>
      </property>
      <!-- @octave -->
      <property name="@octave" type="int" default="4" minvalue="0" maxvalue="8">
        <tr lang="en">output octave</tr>
        <tr lang="ru">выходная октава</tr>
      </property>
      <!-- @on -->
      <property name="@on" type="bool" default="1">
        <tr lang="en">on/off state</tr>
        <tr lang="ru">состояние вкл/выкл</tr>
      </property>
      <!-- @vel -->
      <property name="@vel" type="float" minvalue="0" maxvalue="127" default="100">
        <tr lang="en">output velocity</tr>
        <tr lang="ru">выходная скорость (velocity)</tr>
      </property>
    </properties>
    <methods>
      <!-- custom -->
      <method name="custom">
        <info>
          <tr lang="en">set custom layout</tr>
          <tr lang="ru">задать пользовательскую раскладку</tr>
        </info>
        <param name="KEYSTR" type="symbol" required="true">
          <tr lang="en">key string</tr>
          <tr lang="ru">строка клавиш</tr>
        </param>
      </method>
    </methods>
    <inlets>
      <inlet>
        <in>
          <tr lang="en">control input</tr>
          <tr lang="ru">вход управления</tr>
        </in>
      </inlet>
      <inlet>
        <in on="int">
          <tr lang="en">1 or 0: turn on/off</tr>
          <tr lang="ru">1 или 0: включить/выключить</tr>
        </in>
      </inlet>
    </inlets>
    <outlets>
      <outlet>
        <out type="any">
          <tr lang="en">MIDI output: NOTE VEL</tr>
          <tr lang="ru">вывод MIDI: НОТА СКОРОСТЬ</tr>
        </out>
      </outlet>
    </outlets>
    <example>
      <pdascii>
<![CDATA[
[ui.tab qwerty names custom @size 200 15]
|
|            [F]                 [custom zxcvbnmasdfghjklqwertyuiop #a(
|            |
[@layout $1( [@octave $1(        [T]
|            |                   |.
[midi.kbd qwerty @custom \[a:0 s:2 d:4 f:5 g:7\] #x]
|
[ui.hk]
| |
| |
| |
| |
| [print]
|
[ui.dt]
[X a->x]
]]>
      </pdascii>
    </example>
  </object>
</pddoc>
