<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.11">
    <object name="list.^search">
        <title>list.^search</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs the indices of the found input elements in a predefined
                list</tr>
                <tr lang="ru">выводит индексы найденных входных элементов в предварительно заданном
                списке</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list search index find</keywords>
            <since>0.6</since>
            <also>
                <see>list.search</see>
                <see>list.contains</see>
                <see>list.^contains</see>
            </also>
        </meta>
        <info>
            <par>Outputs index or -1 if not found</par>
        </info>
        <arguments>
            <argument name="VALUE" type="list">
                <tr lang="en">list contents</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @end -->
            <property name="@end" type="int" minvalue="-1" default="-1">
                <tr lang="en">search end index position (-1 means end of list)</tr>
            </property>
            <!-- @start -->
            <property name="@start" type="int" minvalue="0" default="0">
                <tr lang="en">search start index position</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="list" default="">
                <tr lang="en">list contents</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <xinfo on="float">output float index in searched list</xinfo>
                <xinfo on="symbol">output symbol index in searched list</xinfo>
                <xinfo on="list">output position of given list in searched list</xinfo>
                <xinfo on="data">output data index in searched list</xinfo>
            </inlet>
            <inlet>
                <xinfo on="list">set searched list</xinfo>
            </inlet>
        </inlets>
        <outlets>
            <outlet>1 on success, otherwise 0</outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]  [S]    [20 30(
|    |      |
|    |      | [F]
|    |      | |
|    |      | [@start $1(
|    |      | |
|    |      | | [F]
|    |      | | |
|    |      | | [@end $1( [1 2 3 4(  [list a b c d(
|    |      | | |         |.         |.
[list.^search        10 20 30 40 50 A B C]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
