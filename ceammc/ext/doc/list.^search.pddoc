<?xml version="1.0" encoding="utf-8"?>
<pddoc xmlns:xi="http://www.w3.org/2001/XInclude" version="1.15">
    <object name="list.^search">
        <title>list.^search</title>
        <meta>
            <authors>
                <author>Serge Poltavsky</author>
            </authors>
            <description>
                <tr lang="en">outputs the indices of the found input elements in a predefined
                list</tr>
                <tr lang="ru">выводит индексы найденных входных элементов в предварительно заданном
                списке</tr>
            </description>
            <license>GPL3 or later</license>
            <library>ceammc</library>
            <category>list</category>
            <keywords>list search index find</keywords>
            <since>0.6</since>
            <also>
                <see>list.search</see>
                <see>list.contains</see>
                <see>list.^contains</see>
            </also>
        </meta>
        <info>
            <par>
                <tr lang="en">Outputs index or -1 if not found</tr>
                <tr lang="ru" finished="false">Индекс выхода или -1, если не найден</tr>
            </par>
        </info>
        <arguments>
            <argument name="VALUE" type="list">
                <tr lang="en">list contents</tr>
                <tr lang="ru" finished="false">список содержимого</tr>
            </argument>
        </arguments>
        <properties>
            <!-- @end -->
            <property name="@end" type="int" minvalue="-1" default="-1">
                <tr lang="en">search end index position (-1 means end of list)</tr>
                <!-- old: Положение индекса конца поиска (-1 означает конец
                списка) -->
                <tr lang="ru" finished="false">Положение индекса конца поиска (-1 означает конец
                списка)</tr>
            </property>
            <!-- @start -->
            <property name="@start" type="int" minvalue="0" default="0">
                <tr lang="en">search start index position</tr>
                <tr lang="ru" finished="false">Поисковая позиция индекса</tr>
            </property>
            <!-- @value -->
            <property name="@value" type="list" default="">
                <tr lang="en">list contents</tr>
                <tr lang="ru" finished="false">список содержимого</tr>
            </property>
        </properties>
        <inlets>
            <inlet>
                <in on="float">
                    <tr lang="en">output float index in searched list</tr>
                    <tr lang="ru" finished="false">Индекс Float в списке поиска</tr>
                </in>
                <in on="symbol">
                    <tr lang="en">output symbol index in searched list</tr>
                    <tr lang="ru" finished="false">Индекс символов вывода в списке поиска</tr>
                </in>
                <in on="list">
                    <tr lang="en">output position of given list in searched list</tr>
                    <!-- old: выходная позиция данного списка в списке
                    поиска -->
                    <tr lang="ru" finished="false">выходная позиция данного списка в списке
                    поиска</tr>
                </in>
                <in on="data">
                    <tr lang="en">output data index in searched list</tr>
                    <tr lang="ru" finished="false">Индекс выходных данных в списке поиска</tr>
                </in>
            </inlet>
            <inlet>
                <in on="list">
                    <tr lang="en">set searched list</tr>
                    <tr lang="ru" finished="false">Настройка Searched List</tr>
                </in>
            </inlet>
        </inlets>
        <outlets>
            <outlet>
                <out type="any">
                    <tr lang="en">1 on success, otherwise 0</tr>
                    <tr lang="ru" finished="false">1 на успех, в противном случае 0</tr>
                </out>
            </outlet>
        </outlets>
        <example>
            <pdascii>
<![CDATA[
[F]  [S]    [20 30(
|    |      |
|    |      | [F]
|    |      | |
|    |      | [@start $1(
|    |      | |
|    |      | | [F]
|    |      | | |
|    |      | | [@end $1( [1 2 3 4(  [list a b c d(
|    |      | | |         |.         |.
[list.^search        10 20 30 40 50 A B C]
|
[F]
]]>
            </pdascii>
        </example>
    </object>
</pddoc>
